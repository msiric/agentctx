test('unit option forces the output unit', t => {
	t.is(prettyBytes(1337, {unit: 'MB'}), '0.00134 MB');
	t.is(prettyBytes(1337, {unit: 'B'}), '1337 B');
	t.is(prettyBytes(1337, {unit: 'kB'}), '1.34 kB');
	t.is(prettyBytes(1_000_000, {unit: 'kB'}), '1000 kB');
	t.is(prettyBytes(1_000_000, {unit: 'B'}), '1000000 B');
	t.is(prettyBytes(-1337, {unit: 'B', signed: true}), '-1337 B');
	t.is(prettyBytes(0, {unit: 'GB'}), '0 GB');
	t.is(prettyBytes(2048, {unit: 'KiB', binary: true}), '2 KiB');
	t.is(prettyBytes(2048, {unit: 'B', binary: true}), '2048 B');
	t.is(prettyBytes(1337, {unit: 'kbit', bits: true}), '1.34 kbit');
	t.is(prettyBytes(1337, {unit: 'Mbit', bits: true}), '0.00134 Mbit');
	t.is(prettyBytes(2048, {unit: 'kibit', bits: true, binary: true}), '2 kibit');
	t.is(prettyBytes(1337, {unit: 'kB', minimumFractionDigits: 3}), '1.337 kB');
	t.is(prettyBytes(1337, {unit: 'MB', locale: 'de'}), '0,00134 MB');
	t.is(prettyBytes(1337n, {unit: 'MB'}), '0.00134 MB');
	t.is(prettyBytes(10n ** 30n, {unit: 'B'}), `1${'0'.repeat(30)} B`);
	t.is(prettyBytes(1337, {unit: 'MB', space: false}), '0.00134MB');
});

test('unit option must belong to the active unit system', t => {
	const invalid = [
		[{unit: 'KiB'}],
		[{unit: 'Mbit'}],
		[{unit: 'kB', binary: true}],
		[{unit: 'kB', bits: true}],
		[{unit: 'KiB', bits: true}],
		[{unit: 'B', bits: true}],
		[{unit: 'b'}],
		[{unit: 'kb'}],
		[{unit: ''}],
		[{unit: 5}],
		[{unit: null}],
		[{unit: 'toString'}],
	];
	for (const [options] of invalid) {
		t.throws(() => {
			prettyBytes(1337, options);
		}, {instanceOf: TypeError}, JSON.stringify(options));
	}

	t.throws(() => {
		prettyBytes(10n ** 400n, {unit: 'KiB'});
	}, {instanceOf: TypeError});
});
""")
EOF
