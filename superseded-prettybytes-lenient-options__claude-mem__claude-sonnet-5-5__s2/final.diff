 ```
 
+##### significantDigits
+
+Type: `number`\
+Default: `3`
+
+The number of significant digits to round to. Only applies when neither `minimumFractionDigits` nor `maximumFractionDigits` is set.
+
+Must be an integer between 1 and 100. Any other value is ignored and the default is used. The integer part of the number is never cut short, so `1337000` bytes with `significantDigits: 2` is still `1.3 MB`, but `123` bytes keeps all three digits.
+
+```js
+import prettyBytes from 'pretty-bytes';
+
+prettyBytes(1337, {significantDigits: 2});
+//=> '1.3 kB'
+
+prettyBytes(1337, {significantDigits: 4});
+//=> '1.337 kB'
+```
+
 ##### space
 
 Type: `boolean`\
diff --git a/test.js b/test.js
index df7ba6c..d0f1caa 100644
--- a/test.js
+++ b/test.js
@@ -1194,3 +1194,27 @@ test('unit option must belong to the active unit system', t => {
 		prettyBytes(10n ** 400n, {unit: 'KiB'});
 	}, {instanceOf: TypeError});
 });
+
+test('significantDigits option', t => {
+	t.is(prettyBytes(1337, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 3}), '1.34 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4}), '1.337 kB');
+	t.is(prettyBytes(1337n, {significantDigits: 4}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 1}), '1 kB');
+	t.is(prettyBytes(123, {significantDigits: 1}), '123 B');
+	t.is(prettyBytes(999_900, {significantDigits: 2}), '1 MB');
+	t.is(prettyBytes(1337, {significantDigits: 2, bits: true}), '1.3 kbit');
+	t.is(prettyBytes(1337, {significantDigits: 2, locale: 'de'}), '1,3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 2, unit: 'B'}), '1337 B');
+});
+
+test('significantDigits option does not apply with fraction digit options', t => {
+	t.is(prettyBytes(1337, {significantDigits: 2, maximumFractionDigits: 3}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 2, minimumFractionDigits: 1}), '1.337 kB');
+});
+
+test('significantDigits option ignores invalid values', t => {
+	for (const value of [0, -1, 1.5, 101, Number.NaN, Number.POSITIVE_INFINITY, '2', null, undefined, {}]) {
+		t.is(prettyBytes(1337, {significantDigits: value}), '1.34 kB');
+	}
+});
