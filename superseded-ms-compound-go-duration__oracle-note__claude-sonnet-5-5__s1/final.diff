+describe('format(number, { compound: true })', () => {
+  it('should combine units, largest first', () => {
+    expect(format(5400000, { compound: true })).toBe('1h30m');
+    expect(format(90061000, { compound: true })).toBe('25h1m1s');
+  });
+
+  it('should skip zero parts', () => {
+    expect(format(3601000, { compound: true })).toBe('1h1s');
+    expect(format(86400000, { compound: true })).toBe('24h');
+  });
+
+  it('should drop leftover milliseconds', () => {
+    expect(format(1999, { compound: true })).toBe('1s');
+    expect(format(500, { compound: true })).toBe('0s');
+  });
+
+  it('should use hours as the largest unit', () => {
+    expect(format(8 * 86400000, { compound: true })).toBe('192h');
+  });
+
+  it('should support negative values', () => {
+    expect(format(-5400000, { compound: true })).toBe('-1h30m');
+  });
+
+  it('should produce Go time.ParseDuration-compatible output', () => {
+    expect(format(25 * 3600000 + 30 * 60000, { compound: true })).toBe(
+      '25h30m',
+    );
+    expect(format(90061000, { compound: true })).toMatch(
+      /^-?(\d+h)?(\d+m)?(\d+s)?$/,
+    );
+  });
+});
+
+describe('format(number, { compound: true, long: true })', () => {
+  it('should let long take precedence', () => {
+    expect(format(5400000, { compound: true, long: true })).toBe('2 hours');
+  });
+});
+
+describe('format(number, { compound: false })', () => {
+  it('should use the default short format', () => {
+    expect(format(5400000, { compound: false })).toBe('2h');
+  });
