+/**
+ * Compound short format for `ms`, e.g. `1h30m`.
+ * Output is compatible with Go's time.ParseDuration: no separators,
+ * hours are the largest unit (`25h30m`, never days).
+ */
+function fmtCompound(ms: number): string {
+  let rest = Math.floor(Math.abs(ms) / s);
+  const parts: string[] = [];
+  for (const [unit, size] of [
+    ['h', h / s],
+    ['m', m / s],
+    ['s', 1],
+  ] as const) {
+    const count = Math.floor(rest / size);
+    rest -= count * size;
+    if (count > 0) {
+      parts.push(`${count}${unit}`);
+    }
+  }
+  if (parts.length === 0) {
+    return '0s';
+  }
+  return `${ms < 0 ? '-' : ''}${parts.join('')}`;
+}
