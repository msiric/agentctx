+
+describe('format(number, { compound: true }) edge cases', () => {
+  it('should handle zero and negative sub-second values', () => {
+    expect(format(0, { compound: true })).toBe('0s');
+    expect(format(-500, { compound: true })).toBe('0s');
+  });
+
+  it('should handle exact unit boundaries', () => {
+    expect(format(60000, { compound: true })).toBe('1m');
+    expect(format(3599000, { compound: true })).toBe('59m59s');
+    expect(format(-90061000, { compound: true })).toBe('-25h1m1s');
