diff --git a/test/same-origin.test.ts b/test/same-origin.test.ts
new file mode 100644
index 0000000..fb29466
--- /dev/null
+++ b/test/same-origin.test.ts
@@ -0,0 +1,119 @@
+import { describe, expect, test } from "vitest";
+import { isSameOrigin } from "../src";
+
+describe("isSameOrigin", () => {
+  describe("same origin", () => {
+    const cases: [string, string][] = [
+      // identical
+      ["https://example.com", "https://example.com"],
+      // path, query and hash are ignored
+      ["https://example.com/a?x=1#h", "https://example.com/b?y=2#g"],
+      ["https://example.com", "https://example.com/"],
+      // userinfo is not part of the origin
+      ["https://user:pass@example.com/a", "https://example.com/b"],
+      // scheme and host are case-insensitive
+      ["HTTPS://EXAMPLE.COM/a", "https://example.com/b"],
+      // default ports are normalized
+      ["https://example.com", "https://example.com:443"],
+      ["http://example.com", "http://example.com:80"],
+      // identical explicit ports
+      ["https://example.com:443/a", "https://example.com:443/b"],
+      // explicit non-default port
+      ["http://localhost:3000/a", "http://localhost:3000/b"],
+      // IPv6 hosts
+      ["http://[::1]:3000/a", "http://[::1]:3000/b"],
+    ];
+    for (const [a, b] of cases) {
+      test(`${a} === ${b}`, () => {
+        expect(isSameOrigin(a, b)).toBe(true);
+        expect(isSameOrigin(b, a)).toBe(true);
+      });
+    }
+  });
+
+  describe("different origin", () => {
+    const cases: [string, string][] = [
+      // scheme
+      ["http://example.com", "https://example.com"],
+      // host
+      ["https://example.com", "https://example.org"],
+      // subdomains are different origins
+      ["https://example.com", "https://www.example.com"],
+      ["https://a.example.com", "https://b.example.com"],
+      // port
+      ["http://localhost:3000", "http://localhost:4000"],
+      ["http://localhost:3000", "http://localhost"],
+      ["https://example.com:443", "https://example.com:8443"],
+      // default port of one scheme is not the default of another
+      ["http://example.com:443", "http://example.com"],
+      ["https://example.com:80", "https://example.com"],
+      // userinfo trick: host is what follows the last "@"
+      ["https://example.com@evil.com", "https://example.com"],
+      // lookalike suffix / prefix
+      ["https://example.com", "https://example.com.evil.com"],
+      ["https://example.com", "https://evilexample.com"],
+    ];
+    for (const [a, b] of cases) {
+      test(`${a} !== ${b}`, () => {
+        expect(isSameOrigin(a, b)).toBe(false);
+        expect(isSameOrigin(b, a)).toBe(false);
+      });
+    }
+  });
+
+  describe("inputs without an origin", () => {
+    // Relative and protocol-relative URLs have no origin of their own,
+    // so they are never considered same-origin (even with each other).
+    const cases: [string | undefined, string | undefined][] = [
+      ["/a", "/a"],
+      ["a/b", "a/b"],
+      ["./a", "./a"],
+      ["?x=1", "?x=1"],
+      ["#hash", "#hash"],
+      ["//example.com/a", "//example.com/a"],
+      ["//example.com", "https://example.com"],
+      ["/a", "https://example.com/a"],
+      ["", ""],
+      ["", "https://example.com"],
+      [undefined, "https://example.com"],
+      [undefined, undefined],
+    ];
+    for (const [a, b] of cases) {
+      test(`${JSON.stringify(a)} vs ${JSON.stringify(b)}`, () => {
+        expect(isSameOrigin(a as any, b as any)).toBe(false);
+        expect(isSameOrigin(b as any, a as any)).toBe(false);
+      });
+    }
+  });
+
+  describe("opaque / non-hierarchical schemes", () => {
+    // Opaque origins are never equal, even to themselves.
+    test.each([
+      ["data:text/plain,hi", "data:text/plain,hi"],
+      ["javascript:void(0)", "javascript:void(0)"],
+      ["mailto:a@example.com", "mailto:a@example.com"],
+    ])("%s vs %s", (a, b) => {
+      expect(isSameOrigin(a, b)).toBe(false);
+    });
+  });
+
+  describe("other schemes", () => {
+    test("ws/wss are compared like http/https", () => {
+      expect(isSameOrigin("wss://example.com/a", "wss://example.com/b")).toBe(
+        true,
+      );
+      expect(isSameOrigin("ws://example.com", "wss://example.com")).toBe(false);
+      expect(isSameOrigin("wss://example.com:443", "wss://example.com")).toBe(
+        true,
+      );
+    });
+  });
+
+  describe("internationalized hosts", () => {
+    test("unicode and punycode forms are equal", () => {
+      expect(isSameOrigin("https://münchen.de", "https://xn--mnchen-3ya.de")).toBe(
+        true,
+      );
+    });
+  });
+});
