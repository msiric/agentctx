+/**
+ * Checks if two URLs have the same origin (scheme, host and port).
+ *
+ * Default ports are normalized (`https://a.com` equals `https://a.com:443`).
+ * Relative URLs and opaque origins (`data:`, `javascript:`, ...) are never same-origin.
+ *
+ * @example
+ * ```js
+ * isSameOrigin("https://a.com/x", "https://a.com:443/y"); // true
+ * isSameOrigin("https://a.com", "http://a.com"); // false
+ * ```
+ *
+ * @group utils
+ */
+export function isSameOrigin(a: string, b: string): boolean {
+  if (typeof a !== "string" || typeof b !== "string") {
+    return false;
+  }
+  try {
+    const originA = new URL(a).origin;
+    const originB = new URL(b).origin;
+    return originA !== "null" && originA === originB;
+  } catch {
+    return false;
+  }
+}
