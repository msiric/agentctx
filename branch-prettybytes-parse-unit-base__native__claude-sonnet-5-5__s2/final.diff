@@ -216,3 +216,30 @@ export default function prettyBytes(
 	number: number | bigint,
 	options?: Options
 ): string;
+
+/**
+Parse a string like `'1.5 KiB'` or `'1.5 MB'` into a number of bytes. The reverse of `prettyBytes`.
+
+Supported units are the binary `B`, `KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`, `ZiB`, and `YiB` (powers of 1024), and the decimal `B`, `kB` (or `KB`), `MB`, `GB`, `TB`, `PB`, `EB`, `ZB`, and `YB` (powers of 1000). Units are case-sensitive. A missing unit means bytes. Whitespace between the number and the unit is optional, and a leading `+` or `-` is allowed. The result is not rounded, so `'1.5 B'` is `1.5`.
+
+Bit units such as `kbit` are not supported and are rejected like any other unknown unit.
+
+@param string - The string to parse.
+@returns The number of bytes.
+@throws A `TypeError` if the input is not a string, and a `SyntaxError` if it cannot be parsed or the unit is not supported.
+
+@example
+```
+import {parseBytes} from 'pretty-bytes';
+
+parseBytes('512');
+//=> 512
+
+parseBytes('1.5 KiB');
+//=> 1536
+
+parseBytes('1.5 MB');
+//=> 1500000
+```
+*/
+export function parseBytes(string: string): number;
diff --git a/index.js b/index.js
index c5f37ab..8ab3c0f 100644
--- a/index.js
+++ b/index.js
@@ -285,3 +285,36 @@ export default function prettyBytes(number, options) {
 	const result = prefix + numberString + separator + UNITS[exponent];
 	return result.padStart(options.fixedWidth ?? 0);
 }
+
+// Binary units (`KiB`, …) are powers of 1024 and decimal units (`kB`, `MB`, …) are powers of 1000, matching what `prettyBytes` emits. `KB` is also accepted as `kB`.
+const PARSE_UNITS = new Map([
+	...BIBYTE_UNITS.map((unit, exponent) => [unit, {base: 1024, exponent}]),
+	...BYTE_UNITS.map((unit, exponent) => [unit, {base: 1000, exponent}]),
+	['KB', {base: 1000, exponent: 1}],
+]);
+
+// Optional sign, then digits with an optional fraction, then an optional unit. Whitespace between the number and the unit may be a regular or a non-breaking space, as `prettyBytes` can emit either.
+const PARSE_PATTERN = /^([+-]?)(\d+(?:\.\d+)?|\.\d+)(?:[\s\u00A0]*([A-Za-z]+))?$/;
+
+export function parseBytes(string) {
+	if (typeof string !== 'string') {
+		throw new TypeError(`Expected a string, got ${typeof string}`);
+	}
+
+	const match = PARSE_PATTERN.exec(string.trim());
+
+	if (!match) {
+		throw new SyntaxError(`Cannot parse bytes from: ${JSON.stringify(string)}`);
+	}
+
+	const [, sign, digits, unit = 'B'] = match;
+	const parsedUnit = PARSE_UNITS.get(unit);
+
+	if (parsedUnit === undefined) {
+		throw new SyntaxError(`Unsupported unit ${JSON.stringify(unit)} in: ${JSON.stringify(string)}`);
+	}
+
+	const bytes = Number(digits) * (parsedUnit.base ** parsedUnit.exponent);
+
+	return sign === '-' ? -bytes : bytes;
+}
