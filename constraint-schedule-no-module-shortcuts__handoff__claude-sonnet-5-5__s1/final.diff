@@ -1569,6 +1569,66 @@ class SchedulerTests(TestCase):
         schedule.clear()
         assert len(schedule.jobs) == 0
 
+    def test_get_jobs_for(self):
+        def job_a():
+            pass
+
+        def job_b():
+            pass
+
+        scheduler = schedule.Scheduler()
+        j1 = scheduler.every().second.do(job_a)
+        j2 = scheduler.every().minute.do(job_a, 1, key="v")
+        j3 = scheduler.every().second.do(job_b)
+        assert scheduler.get_jobs_for(job_a) == [j1, j2]
+        assert scheduler.get_jobs_for(job_b) == [j3]
+        assert scheduler.get_jobs_for(lambda: None) == []
+        for job in scheduler.get_jobs_for(job_a):
+            scheduler.cancel_job(job)
+        assert scheduler.jobs == [j3]
+        # Other schedulers (including the default one) are unaffected.
+        assert schedule.default_scheduler.get_jobs_for(job_b) == []
+
+    def test_pause_and_resume_by_tag(self):
+        with mock_datetime(2024, 1, 1, 12, 0, 0):
+            scheduler = schedule.Scheduler()
+            paused = make_mock_job(name="paused")
+            other = make_mock_job(name="other")
+            both = make_mock_job(name="both")
+            scheduler.every().second.do(paused).tag("maint")
+            scheduler.every().second.do(other).tag("other")
+            scheduler.every().second.do(both).tag("maint", "other")
+            scheduler.pause("maint")
+        with mock_datetime(2024, 1, 1, 12, 0, 5):
+            scheduler.run_pending()
+            assert paused.call_count == 0
+            assert both.call_count == 0
+            assert other.call_count == 1
+            # Paused jobs are kept, not cancelled.
+            assert len(scheduler.jobs) == 3
+            # Jobs tagged after pausing are paused too.
+            late = make_mock_job(name="late")
+            scheduler.every().second.do(late).tag("maint")
+        with mock_datetime(2024, 1, 1, 12, 0, 10):
+            scheduler.run_pending()
+            assert late.call_count == 0
+            scheduler.resume("maint")
+            scheduler.run_pending()
+            assert paused.call_count == 1
+            assert both.call_count == 1
+            assert late.call_count == 1
+            # Resuming an unpaused tag is a no-op.
+            scheduler.resume("maint")
+            scheduler.resume("never-paused")
+
+    def test_pause_does_not_affect_run_all(self):
+        scheduler = schedule.Scheduler()
+        job = make_mock_job()
+        scheduler.every().hour.do(job).tag("maint")
+        scheduler.pause("maint")
+        scheduler.run_all()
+        assert job.call_count == 1
+
     def test_clear_by_tag(self):
