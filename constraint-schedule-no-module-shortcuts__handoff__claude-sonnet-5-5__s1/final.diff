+    def get_jobs_for(self, func: Callable) -> List["Job"]:
+        """
+        Gets scheduled jobs that run the given function, so they can be
+        inspected or cancelled without keeping a reference to each job.
+
+        Arguments bound with ``do(func, *args, **kwargs)`` are ignored:
+        every job scheduled with ``func`` is returned.
+
+        :param func: The function that was passed to
+                     :meth:`Job.do <Job.do>`
+        """
+        return [
+            job
+            for job in self.jobs
+            if job.job_func is not None and job.job_func.func == func
+        ]
+
+    def pause(self, tag: Hashable) -> None:
+        """
+        Pause all jobs marked with the given tag, including jobs that
+        are tagged later. Paused jobs are skipped by :meth:`run_pending`
+        until :meth:`resume` is called; they are not cancelled and keep
+        their schedule. :meth:`run_all` ignores pausing.
+
+        Jobs that became due while paused run once on the first
+        ``run_pending()`` after resuming (missed runs are not replayed).
+
+        :param tag: An identifier used to identify a subset of jobs to pause
+        """
+        logger.debug('Pausing all jobs tagged "%s"', tag)
+        self._paused_tags.add(tag)
+
+    def resume(self, tag: Hashable) -> None:
+        """
+        Resume jobs paused with :meth:`pause`. Does nothing if the tag
+        is not paused.
+
+        :param tag: The tag passed to :meth:`pause`
+        """
+        logger.debug('Resuming all jobs tagged "%s"', tag)
+        self._paused_tags.discard(tag)
+
