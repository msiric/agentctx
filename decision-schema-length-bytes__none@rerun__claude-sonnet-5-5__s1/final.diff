+def test_length():
+    assert Length(min=2, max=4).validate("ab") == "ab"
+    assert Length(min=2, max=4).validate("abcd") == "abcd"
+    with SE:
+        Length(min=2, max=4).validate("a")
+    with SE:
+        Length(min=2, max=4).validate("abcde")
+
+    # One-sided and unbounded
+    assert Length(min=1).validate("x" * 100) == "x" * 100
+    with SE:
+        Length(min=1).validate("")
+    assert Length(max=3).validate("") == ""
+    with SE:
+        Length(max=3).validate("abcd")
+    assert Length().validate("anything") == "anything"
+
+    # Non-strings are rejected
+    for bad in (1, None, [], {}, b"ab"):
+        with SE:
+            Length(max=5).validate(bad)
+
+    # Inside a schema, and custom error
+    assert Schema({"k": Length(max=2)}).validate({"k": "ab"}) == {"k": "ab"}
+    with SE:
+        Schema({"k": Length(max=2)}).validate({"k": "abc"})
+    with raises(SchemaError, match="too long: 'abc'"):
+        Length(max=2, error="too long: {!r}").validate("abc")
+
+    with raises(ValueError):
+        Length(min=3, max=2)
+
+
