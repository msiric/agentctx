-export function cleanDoubleSlashes(input = ""): string {
+export function cleanDoubleSlashes(
+  input = "",
+  respectQueryAndFragment?: boolean,
+): string {
+  if (respectQueryAndFragment) {
+    const index = input.search(/[?#]/);
+    if (index !== -1) {
+      return cleanDoubleSlashes(input.slice(0, index)) + input.slice(index);
+    }
+  }
