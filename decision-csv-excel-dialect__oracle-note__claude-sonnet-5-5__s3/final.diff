+                    if key not in seen:
+                        seen.add(key)
+                        columns.append(key)
+        else:
+            columns = list(fields)
+
+        with open(path, 'w', newline='', encoding='utf-8-sig') as f:
+            writer = csv.writer(f, delimiter=';')
+            writer.writerow(columns)
+            for doc in docs:
+                writer.writerow([doc.get(c, '') for c in columns])
