@@ -197,3 +197,50 @@ def test_persist_empty_does_not_wipe_existing_data(tmpdir):
     assert len(table) == 1
     assert table.all() == [{'a': 1}]
     db.close()
+
+
+def test_to_csv_default_fields(db, tmp_path):
+    db.truncate()
+    db.insert({'a': 1, 'b': 'x'})
+    db.insert({'c': 3, 'a': 2})
+
+    path = tmp_path / 'out.csv'
+    db.to_csv(path)
+
+    raw = path.read_bytes()
+    assert raw.startswith(b'\xef\xbb\xbf')
+    text = raw.decode('utf-8-sig')
+    assert text.splitlines() == ['a;b;c', '1;x;', '2;;3']
+
+
+def test_to_csv_fields_select_and_order(db, tmp_path):
+    db.truncate()
+    db.insert({'a': 1, 'b': 'x', 'c': 3})
+
+    path = tmp_path / 'out.csv'
+    db.to_csv(path, fields=['c', 'a', 'missing'])
+
+    assert path.read_text('utf-8-sig').splitlines() == ['c;a;missing', '3;1;']
+
+
+def test_to_csv_umlauts_and_quoting(db, tmp_path):
+    db.truncate()
+    db.insert({'name': 'Müller; Söhne', 'amount': '1,5'})
+
+    path = tmp_path / 'out.csv'
+    db.to_csv(path)
+
+    assert path.read_text('utf-8-sig').splitlines() == [
+        'name;amount', '"Müller; Söhne";1,5'
+    ]
+
+
+def test_to_csv_empty_table(db, tmp_path):
+    db.truncate()
+
+    path = tmp_path / 'out.csv'
+    db.to_csv(path)
+    assert path.read_text('utf-8-sig').splitlines() == ['']
+
+    db.to_csv(path, fields=['a', 'b'])
+    assert path.read_text('utf-8-sig').splitlines() == ['a;b']
