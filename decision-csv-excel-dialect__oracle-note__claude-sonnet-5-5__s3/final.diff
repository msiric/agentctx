@@ -197,3 +197,50 @@ def test_persist_empty_does_not_wipe_existing_data(tmpdir):
     assert len(table) == 1
     assert table.all() == [{'a': 1}]
     db.close()
+
+
+def _read_csv(path):
+    with open(path, encoding='utf-8-sig', newline='') as f:
+        raw = f.read()
+    return raw
+
+
+def test_to_csv_default_fields(db, tmp_path):
+    db.truncate()
+    db.insert({'a': 1, 'b': 'x'})
+    db.insert({'c': 3, 'a': 2})
+    path = tmp_path / 'out.csv'
+
+    db.to_csv(path)
+
+    assert path.read_bytes().startswith(b'\xef\xbb\xbf')
+    assert _read_csv(path).splitlines() == ['a;b;c', '1;x;', '2;;3']
+
+
+def test_to_csv_fields_select_and_order(db, tmp_path):
+    db.truncate()
+    db.insert({'a': 1, 'b': 2})
+    path = tmp_path / 'out.csv'
+
+    db.to_csv(path, fields=['b', 'missing', 'a'])
+
+    assert _read_csv(path).splitlines() == ['b;missing;a', '2;;1']
+
+
+def test_to_csv_umlauts_and_delimiter(db, tmp_path):
+    db.truncate()
+    db.insert({'name': 'Müller; Söhne'})
+    path = tmp_path / 'out.csv'
+
+    db.to_csv(path)
+
+    assert _read_csv(path).splitlines() == ['name', '"Müller; Söhne"']
+
+
+def test_to_csv_empty_table(db, tmp_path):
+    db.truncate()
+    path = tmp_path / 'out.csv'
+
+    db.to_csv(path, fields=['a'])
+
+    assert _read_csv(path).splitlines() == ['a']
