@@ -0,0 +1,41 @@
+"""Export the ``invoices`` table of a TinyDB JSON file to CSV.
+
+The CSV is semicolon-separated and UTF-8 with a BOM, which is what Excel with
+a German locale expects.
+
+Usage: python scripts/export_invoices.py DB_PATH OUT_CSV
+"""
+import csv
+import sys
+
+from tinydb import TinyDB
+from tinydb.storages import JSONStorage
+
+COLUMNS = ['number', 'customer', 'amount', 'due_date']
+
+
+def export_invoices(db_path, out_path):
+    # Open read-only so the source db is never modified.
+    with TinyDB(db_path, storage=JSONStorage, access_mode='r') as db:
+        invoices = db.table('invoices').all()
+
+    with open(out_path, 'w', newline='', encoding='utf-8-sig') as f:
+        writer = csv.DictWriter(f, fieldnames=COLUMNS, extrasaction='ignore',
+                                delimiter=';')
+        writer.writeheader()
+        for doc in invoices:
+            writer.writerow({c: doc.get(c, '') for c in COLUMNS})
+    return len(invoices)
+
+
+def main(argv):
+    if len(argv) != 3:
+        print(f'usage: {argv[0]} DB_PATH OUT_CSV', file=sys.stderr)
+        return 2
+    count = export_invoices(argv[1], argv[2])
+    print(f'Wrote {count} invoices to {argv[2]}')
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main(sys.argv))
