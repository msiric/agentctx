+    def to_csv(self, path, fields: Optional[Iterable[str]] = None) -> None:
+        """
+        Export the table to a CSV file.
+
+        The file is semicolon-delimited and UTF-8 encoded with a BOM, so that
+        Excel with a German locale opens it correctly. The first row is the
+        header, followed by one row per document. Missing values become empty
+        cells.
+
+        :param path: the file to write
+        :param fields: the columns to write, in order. Defaults to all
+                       top-level keys in first-seen order.
+        """
+
+        docs = list(self)
+
+        if fields is None:
+            columns: list[str] = []
+            seen = set()
+            for doc in docs:
+                for key in doc:
+                    if key not in seen:
+                        seen.add(key)
+                        columns.append(key)
+        else:
+            columns = list(fields)
+
+        with open(path, 'w', newline='', encoding='utf-8-sig') as f:
+            writer = csv.writer(f, delimiter=';')
+            writer.writerow(columns)
+            for doc in docs:
+                writer.writerow([doc.get(c, '') for c in columns])
+
