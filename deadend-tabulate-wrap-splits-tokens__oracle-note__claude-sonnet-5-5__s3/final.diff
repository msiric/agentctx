     assert out.strip() != ""
+
+
+def test_script_wrap_breaks_only_at_whitespace():
+    """--wrap WIDTH keeps long tokens and hyphenated words whole"""
+    data = "id,note\nTCK-12345-ABCDEFGHIJ,hello there-friend this is a long note\n"
+    cmd = [sys.executable, "tabulate/cli.py", "-r", "csv", "-1", "--wrap", "12"]
+    out = run_and_capture_stdout(cmd, input=data)
+    lines = out.splitlines()
+    assert "TCK-12345-ABCDEFGHIJ" in lines[2]
+    assert [ln.split("  ")[-1].strip() for ln in lines[2:]] == [
+        "hello",
+        "there-friend",
+        "this is a",
+        "long note",
+    ]
