+
+test('parseBytes - plain numbers and bytes', t => {
+	t.is(parseBytes('512'), 512);
+	t.is(parseBytes('512 B'), 512);
+	t.is(parseBytes('512B'), 512);
+	t.is(parseBytes('0'), 0);
+	t.is(parseBytes('  42 B  '), 42);
+	t.is(parseBytes('0.5'), 0.5);
+});
+
+test('parseBytes - binary units', t => {
+	for (const [exponent, unit] of BINARY_UNITS.entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1024 ** exponent);
+		t.is(parseBytes(`2${unit}`), 2 * (1024 ** exponent));
+	}
+});
+
+test('parseBytes - fractional values', t => {
+	t.is(parseBytes('1.5 KiB'), 1536);
+	t.is(parseBytes('0.5 MiB'), 524_288);
+	t.is(parseBytes('2.25 GiB'), 2.25 * (1024 ** 3));
+});
+
+test('parseBytes - signs', t => {
+	t.is(parseBytes('-1 KiB'), -1024);
+	t.is(parseBytes('+1 KiB'), 1024);
+	t.true(Object.is(parseBytes('-0'), 0));
+});
+
+test('parseBytes - round trips binary prettyBytes output', t => {
+	t.is(parseBytes(prettyBytes(1536, {binary: true})), 1536);
+	t.is(parseBytes(prettyBytes(1536, {binary: true, space: false})), 1536);
+});
+
+test('parseBytes - units are case-sensitive', t => {
+	for (const input of ['1 kib', '1 KIB', '1 kiB', '1 b', '1 mib']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError});
+	}
+});
+
+test('parseBytes - units without the i are powers of 1024', t => {
+	const units = ['kB', 'MB', 'GB', 'TB', 'PB', 'EB', 'ZB', 'YB'];
+	for (const [index, unit] of units.entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1024 ** (index + 1));
+		t.is(parseBytes(`2${unit}`), 2 * (1024 ** (index + 1)));
+	}
+
+	t.is(parseBytes('1 KB'), 1024);
+	t.is(parseBytes('1.5 kB'), 1536);
+	t.is(parseBytes('1 MB'), 1_048_576);
+	t.is(parseBytes('-1 GB'), -(1024 ** 3));
+});
+
+test('parseBytes - wrong-case non-i units are rejected', t => {
+	for (const input of ['1 kb', '1 mb', '1 Mb', '1 gB', '1 Kb']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError});
+	}
+});
+
+test('parseBytes - invalid input', t => {
+	for (const input of ['', ' ', 'KiB', 'abc', '1..5 KiB', '.5 KiB', '1. KiB', '1e3', '1 2 KiB', '1,5 KiB', '1 KiB B', 'NaN', 'Infinity']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError});
+	}
+
+	for (const input of [undefined, null, 5, 5n, {}]) {
+		t.throws(() => parseBytes(input), {instanceOf: TypeError});
+	}
+});
