 	number: number | bigint,
 	options?: Options
 ): string;
+
+/**
+Parse a human readable byte string, the reverse of `prettyBytes`, into a number of bytes.
+
+Supports plain numbers, `B`, the binary units `KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`, `ZiB` and `YiB`, and the units without the `i` (`kB` or `KB`, `MB`, `GB`, `TB`, `PB`, `EB`, `ZB` and `YB`). Fractional values are allowed and units are case-sensitive.
+
+Note that units without the `i` are read as powers of 1024, not 1000, to match sizes shown by Windows Explorer. So `1 kB` is `1024` bytes and `1 MB` is `1048576` bytes.
+
+@throws A `TypeError` if the input is not a string, and a `SyntaxError` if it cannot be parsed or has an unsupported unit.
+
+@example
+```
+import {parseBytes} from 'pretty-bytes';
+
+parseBytes('512');
+//=> 512
+
+parseBytes('1.5 KiB');
+//=> 1536
+
+parseBytes('1 MB');
+//=> 1048576
+```
+*/
+export function parseBytes(string: string): number;
diff --git a/index.js b/index.js
index c5f37ab..0600cce 100644
--- a/index.js
+++ b/index.js
@@ -285,3 +285,35 @@ export default function prettyBytes(number, options) {
 	const result = prefix + numberString + separator + UNITS[exponent];
 	return result.padStart(options.fixedWidth ?? 0);
 }
+
+const BINARY_MULTIPLIERS = new Map([
+	...BIBYTE_UNITS.map((unit, exponent) => [unit, 1024 ** exponent]),
+	// Non-`i` units are read as powers of 1024, matching what Windows Explorer shows.
+	...BYTE_UNITS.map((unit, exponent) => [unit, 1024 ** exponent]),
+	['KB', 1024],
+]);
+
+// Units are case-sensitive.
+const BYTES_PATTERN = /^(?<sign>[+-]?)(?<value>\d+(?:\.\d+)?)\s*(?<unit>[A-Za-z]+)?$/;
+
+export function parseBytes(string) {
+	if (typeof string !== 'string') {
+		throw new TypeError(`Expected a string, got ${typeof string}: ${string}`);
+	}
+
+	const match = BYTES_PATTERN.exec(string.trim());
+
+	if (!match) {
+		throw new SyntaxError(`Unable to parse bytes from: ${JSON.stringify(string)}`);
+	}
+
+	const {sign, value, unit = 'B'} = match.groups;
+	const multiplier = BINARY_MULTIPLIERS.get(unit);
+
+	if (multiplier === undefined) {
+		throw new SyntaxError(`Unsupported unit ${JSON.stringify(unit)} in: ${JSON.stringify(string)}`);
+	}
+
+	const result = Number(value) * multiplier;
+	return sign === '-' && result !== 0 ? -result : result;
+}
