+test('largestUnit', () => {
+	const milliseconds = (26 * 3_600_000) + (5 * 60_000) + 7000 + 8;
+	const zero = {
+		days: 0,
+		hours: 0,
+		minutes: 0,
+		seconds: 0,
+		milliseconds: 8,
+		microseconds: 0,
+		nanoseconds: 0,
+	};
+	const cases = {
+		days: {
+			...zero,
+			days: 1,
+			hours: 2,
+			minutes: 5,
+			seconds: 7,
+		},
+		hours: {
+			...zero,
+			hours: 26,
+			minutes: 5,
+			seconds: 7,
+		},
+		minutes: {
+			...zero,
+			minutes: (26 * 60) + 5,
+			seconds: 7,
+		},
+		seconds: {
+			...zero,
+			seconds: (26 * 3600) + (5 * 60) + 7,
+		},
+	};
+
+	for (const [largestUnit, expected] of Object.entries(cases)) {
+		assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit}), expected, largestUnit);
+		assert.deepStrictEqual(
+			parseMilliseconds(BigInt(milliseconds), {largestUnit}),
+			Object.fromEntries(Object.entries(expected).map(([unit, value]) => [unit, BigInt(value)])),
+			`${largestUnit} bigint`,
+		);
+	}
+
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {}), cases.days);
+	assert.strictEqual(parseMilliseconds(milliseconds, {largestUnit: 'hours'}).hours, 26);
+	assert.strictEqual(parseMilliseconds(-milliseconds, {largestUnit: 'hours'}).hours, -26);
+	assert.strictEqual(parseMilliseconds(-BigInt(milliseconds), {largestUnit: 'hours'}).hours, -26n);
+	assert.strictEqual(parseMilliseconds(1e21, {largestUnit: 'hours'}).hours, Math.trunc(1e21 / 3_600_000));
+});
+
+test('largestUnit errors', () => {
+	for (const largestUnit of ['weeks', 'Days', '', null, 5]) {
+		assert.throws(() => {
+			parseMilliseconds(1000, {largestUnit});
