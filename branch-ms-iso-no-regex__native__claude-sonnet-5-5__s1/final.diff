+/**
+ * Parse an ISO 8601 duration string and return milliseconds. This is the
+ * inverse of `formatISO`, e.g. `parseISO("PT1H30M")` is `5400000`.
+ *
+ * Supported designators are `W`, `D` (date part) and `H`, `M`, `S` (time
+ * part), in that order. Years and months are ambiguous and are not supported.
+ * Components may have a decimal fraction (`.` or `,`), and the whole duration
+ * may be prefixed with `-` or `+`. The result is rounded to the nearest
+ * millisecond.
+ *
+ * Implemented as a hand-written scanner (no regular expressions).
+ *
+ * @param str - An ISO 8601 duration string
+ * @returns The parsed value in milliseconds, or `NaN` if the string is not a
+ * valid (supported) ISO 8601 duration
+ * @throws Error if `str` is not a string with length between 1 and 99
+ */
+export function parseISO(str: string): number {
+  if (typeof str !== "string" || str.length === 0 || str.length > 100) {
+    throw new Error(
+      `Value provided to ms.parseISO() must be a string with length between 1 and 99. value=${JSON.stringify(str)}`,
+    );
+  }
+
+  let i = 0;
+  let sign = 1;
+  if (str[i] === "-" || str[i] === "+") {
+    sign = str[i] === "-" ? -1 : 1;
+    i++;
+  }
+  if (str[i] !== "P" && str[i] !== "p") {
+    return NaN;
+  }
+  i++;
+
+  // Designators in the order they must appear. `T` switches to the time part.
+  const dateUnits = ["W", "D"];
+  const timeUnits = ["H", "M", "S"];
+  const unitMs: Record<string, number> = { W: w, D: d, H: h, M: m, S: s };
+
+  let inTime = false;
+  let unitIndex = 0; // next allowed index in the current part's unit list
+  let components = 0;
+  let timeComponents = 0;
+  let total = 0;
+
+  while (i < str.length) {
+    const c = str[i];
+    if (c === "T" || c === "t") {
+      if (inTime) return NaN;
+      inTime = true;
+      unitIndex = 0;
+      i++;
+      if (i >= str.length) return NaN; // "T" must be followed by a component
+      continue;
+    }
+
+    // Number: digits, optionally followed by a separator and more digits.
+    const start = i;
+    let digits = 0;
+    while (i < str.length && isDigit(str.charCodeAt(i))) {
+      i++;
+      digits++;
+    }
+    if (digits === 0) return NaN;
+    if (str[i] === "." || str[i] === ",") {
+      i++;
+      let fracDigits = 0;
+      while (i < str.length && isDigit(str.charCodeAt(i))) {
+        i++;
+        fracDigits++;
+      }
+      if (fracDigits === 0) return NaN;
+    }
+    const n = parseFloat(str.slice(start, i).replace(",", "."));
+
+    if (i >= str.length) return NaN; // number without a designator
+    const unit = str[i].toUpperCase();
+    i++;
+    const units = inTime ? timeUnits : dateUnits;
+    const idx = units.indexOf(unit, unitIndex);
+    if (idx === -1) return NaN; // unsupported, repeated, or out of order
+    unitIndex = idx + 1;
+
+    total += n * unitMs[unit];
+    components++;
+    if (inTime) timeComponents++;
+  }
+
+  if (components === 0 || (inTime && timeComponents === 0)) {
+    return NaN;
+  }
+
+  // `+ 0` normalizes -0 to 0.
+  return Math.round(sign * total) + 0;
 }
