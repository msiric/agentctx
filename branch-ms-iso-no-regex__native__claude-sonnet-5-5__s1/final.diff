@@ -0,0 +1,98 @@
+import { describe, expect, it } from "@jest/globals";
+import { formatISO, parseISO } from "./index";
+
+describe("parseISO(string)", () => {
+  it("should parse the documented examples", () => {
+    expect(parseISO("PT1H30M")).toBe(5400000);
+    expect(parseISO("P1DT1H1M1S")).toBe(90061000);
+  });
+
+  it("should parse zero", () => {
+    expect(parseISO("PT0S")).toBe(0);
+    expect(parseISO("-PT0S")).toBe(0);
+    expect(Object.is(parseISO("-PT0S"), 0)).toBe(true);
+  });
+
+  it("should parse single units", () => {
+    expect(parseISO("PT1S")).toBe(1000);
+    expect(parseISO("PT1M")).toBe(60000);
+    expect(parseISO("PT1H")).toBe(3600000);
+    expect(parseISO("P1D")).toBe(86400000);
+    expect(parseISO("P1W")).toBe(7 * 86400000);
+  });
+
+  it("should parse fractional seconds", () => {
+    expect(parseISO("PT1.5S")).toBe(1500);
+    expect(parseISO("PT1,5S")).toBe(1500);
+    expect(parseISO("PT0.001S")).toBe(1);
+    expect(parseISO("PT1.1S")).toBe(1100);
+  });
+
+  it("should parse signs", () => {
+    expect(parseISO("-PT1H")).toBe(-3600000);
+    expect(parseISO("+PT1H")).toBe(3600000);
+  });
+
+  it("should be case-insensitive", () => {
+    expect(parseISO("pt1h30m")).toBe(5400000);
+  });
+
+  it("should be the inverse of formatISO", () => {
+    for (const v of [
+      0,
+      1,
+      999,
+      1000,
+      1500,
+      60000,
+      5400000,
+      90061001,
+      -5400000,
+      400 * 86400000,
+    ]) {
+      expect(parseISO(formatISO(v))).toBe(v);
+    }
+  });
+
+  it("should return NaN for invalid input", () => {
+    for (const bad of [
+      "P",
+      "PT",
+      "P1DT",
+      "PT1",
+      "1H",
+      "T1H",
+      "PT1H1H",
+      "PT30M1H",
+      "P1D2W",
+      "P1H",
+      "PT1D",
+      "PT.5S",
+      "PT1.S",
+      "PT1X",
+      "PTT1H",
+      "P1Y",
+      "P1M",
+      "P1DT1H ",
+      " P1D",
+      "--PT1H",
+      "PT-1H",
+      "PT1H-",
+    ]) {
+      expect(parseISO(bad)).toBeNaN();
+    }
+  });
+
+  it("should throw for non-strings and bad lengths", () => {
+    expect(() => parseISO("")).toThrow();
+    expect(() => parseISO("P" + "1".repeat(100) + "D")).toThrow();
+    // @ts-expect-error testing runtime behavior
+    expect(() => parseISO(5)).toThrow();
+  });
+
+  it("should be linear on long adversarial input", () => {
+    const start = Date.now();
+    parseISO("PT" + "1".repeat(90) + "X");
+    expect(Date.now() - start).toBeLessThan(100);
+  });
+});
