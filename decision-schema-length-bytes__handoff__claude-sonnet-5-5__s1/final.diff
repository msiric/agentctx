+class Length:
+    """
+    Validates that a string's size is within inclusive bounds.
+
+    Note: the size is measured in UTF-8 *bytes*, not characters, so that values
+    fit byte-sized database columns (e.g. Oracle ``VARCHAR2(n BYTE)``).
+    Only ``str`` is accepted.
+    """
+
+    def __init__(
+        self,
+        min: Union[int, None] = None,
+        max: Union[int, None] = None,
+        error: Union[str, None] = None,
+    ) -> None:
+        if min is None and max is None:
+            raise TypeError("Length requires at least one of min or max")
+        for name, bound in (("min", min), ("max", max)):
+            if bound is None:
+                continue
+            if isinstance(bound, bool) or not isinstance(bound, int):
+                raise TypeError(f"Length {name} must be an int, not {bound!r}")
+            if bound < 0:
+                raise TypeError(f"Length {name} must not be negative, got {bound!r}")
+        if min is not None and max is not None and min > max:
+            raise ValueError(f"Length min ({min}) is greater than max ({max})")
+        self._min: Union[int, None] = min
+        self._max: Union[int, None] = max
+        self._error: Union[str, None] = error
+
+    def __repr__(self) -> str:
+        args = []
+        if self._min is not None:
+            args.append(f"min={self._min!r}")
+        if self._max is not None:
+            args.append(f"max={self._max!r}")
+        return f"{self.__class__.__name__}({', '.join(args)})"
+
+    @property
+    def min(self) -> Union[int, None]:
+        """The inclusive minimum size in UTF-8 bytes, or None"""
+        return self._min
+
+    @property
+    def max(self) -> Union[int, None]:
+        """The inclusive maximum size in UTF-8 bytes, or None"""
+        return self._max
+
+    def validate(self, data: str, **kwargs: Any) -> str:
+        """
+        Validates that the UTF-8 encoded size of data is within the bounds.
+        :param data: Data to be validated.
+        :return: Returns validated data.
+        """
+        e = self._error
+        custom = e.format(data) if e else None
+
+        if not isinstance(data, str):
+            raise SchemaError(f"expected a str, got {type(data).__name__}", custom)
+        try:
+            size = len(data.encode("utf-8"))
+        except UnicodeEncodeError:
+            raise SchemaError("string cannot be encoded as UTF-8", custom)
+
+        if self._min is not None and size < self._min:
+            raise SchemaError(
+                f"length {size} bytes is not at least {self._min} bytes", custom
+            )
+        if self._max is not None and size > self._max:
+            raise SchemaError(
+                f"length {size} bytes is not at most {self._max} bytes", custom
+            )
+        return data
+
+
