     """
     For more general use cases, you can use the Use class to transform
diff --git a/test_schema.py b/test_schema.py
index 4d78456..d044129 100644
--- a/test_schema.py
+++ b/test_schema.py
@@ -24,6 +24,7 @@ from schema import (
     Literal,
     Optional,
     Or,
+    Length,
     Regex,
     Schema,
     SchemaError,
@@ -2100,3 +2101,85 @@ def test_tuple_key_error_message_does_not_crash():
     with raises(SchemaError) as exc_info:
         Schema({("a", "b"): int}).validate({("a", "b"): "not-an-int"})
     assert "Key '('a', 'b')' error:" in exc_info.value.code
+
+
+def test_length_bounds_inclusive():
+    v = Length(min=2, max=4)
+    assert v.validate("ab") == "ab"
+    assert v.validate("abcd") == "abcd"
+    with raises(SchemaError, match="not at least 2"):
+        v.validate("a")
+    with raises(SchemaError, match="length 5 bytes is not at most 4 bytes"):
+        v.validate("abcde")
+    assert Length(max=0).validate("") == ""
+    assert Length(min=1).validate("x" * 1000)
+
+
+def test_length_counts_utf8_bytes():
+    assert Length(max=2).validate("\u00e9") == "\u00e9"  # 2 bytes
+    with raises(SchemaError):
+        Length(max=1).validate("\u00e9")
+    assert Length(max=4).validate("\U0001f600") == "\U0001f600"  # 4 bytes
+    with raises(SchemaError):
+        Length(max=3).validate("\U0001f600")
+    with raises(SchemaError):
+        Length(min=3).validate("\u00e9")
+
+
+def test_length_rejects_non_str_and_unencodable():
+    for bad in (b"abc", 123, None, ["a"], {}):
+        with raises(SchemaError):
+            Length(max=10).validate(bad)
+    with raises(SchemaError, match="UTF-8"):
+        Length(max=10).validate("\ud800")
+
+
+def test_length_construction_errors():
+    with raises(TypeError):
+        Length()
+    with raises(TypeError):
+        Length(min=-1)
+    with raises(TypeError):
+        Length(max=1.5)
+    with raises(TypeError):
+        Length(max=True)
+    with raises(TypeError):
+        Length(min="1")
+    with raises(ValueError):
+        Length(min=5, max=2)
+    assert Length(min=3, max=3).validate("abc") == "abc"
+
+
+def test_length_repr_and_properties():
+    v = Length(min=1, max=9)
+    assert (v.min, v.max) == (1, 9)
+    assert repr(v) == "Length(min=1, max=9)"
+    assert repr(Length(max=3)) == "Length(max=3)"
+
+
+def test_length_custom_error():
+    with raises(SchemaError) as e:
+        Length(max=2, error="too long: {}").validate("abc")
+    assert e.value.code == "too long: abc"
+    with raises(SchemaError) as e:
+        Schema(Length(max=2, error="too long")).validate("abc")
+    assert e.value.code == "too long"
+    # an outer error= is not lost (it is reported first)
+    with raises(SchemaError) as e:
+        Schema(Length(max=2, error="inner"), error="outer").validate("abc")
+    assert e.value.code.splitlines()[0] == "outer"
+
+
+def test_length_nesting():
+    s = Schema({"name": And(str, Length(max=3))})
+    assert s.validate({"name": "abc"}) == {"name": "abc"}
+    with raises(SchemaError) as e:
+        s.validate({"name": "abcd"})
+    assert "length 4 bytes is not at most 3 bytes" in e.value.code
+    assert "name" in e.value.code
+    assert Schema(Or(Length(max=1), Length(min=5))).validate("abcde") == "abcde"
+    with raises(SchemaError):
+        Schema(Or(Length(max=1), Length(min=5))).validate("abc")
+    with raises(SchemaError) as e:
+        Schema({"name": Length(max=3, error="bad name")}).validate({"name": "abcd"})
+    assert e.value.code == "bad name"
