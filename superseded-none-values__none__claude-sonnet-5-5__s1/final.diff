diff --git a/tests/test_valid.py b/tests/test_valid.py
index 5413ac9..b1dc81b 100644
--- a/tests/test_valid.py
+++ b/tests/test_valid.py
@@ -58,3 +58,70 @@ def replace_nans(cont: dict | list) -> dict | list:
 )
 def test_obj_to_str_mapping(obj, expected_str, multiline_strings):
     assert tomli_w.dumps(obj, multiline_strings=multiline_strings) == expected_str
+
+
+def test_none_values_skipped():
+    obj = {
+        "a": None,
+        "b": 1,
+        "tbl": {"x": None, "y": 2},
+        "empty": {"z": None},
+        "inline": {"p": None, "q": {"r": None, "s": 3}},
+        "aot": [{"k": None, "v": 1}, {"k": 2}],
+    }
+    assert tomli_w.dumps(obj) == (
+        "b = 1\n"
+        "aot = [\n"
+        "    { v = 1 },\n"
+        "    { k = 2 },\n"
+        "]\n"
+        "\n[tbl]\ny = 2\n"
+        "\n[empty]\n"
+        "\n[inline.q]\ns = 3\n"
+    )
+
+
+def test_none_values_skipped_inline_table():
+    assert tomli_w.dumps({"l": [{"a": None, "b": 1}, {"c": None}]}) == (
+        "l = [\n    { b = 1 },\n    {},\n]\n"
+    )
+    assert tomli_w.dumps({"a": None}) == ""
+
+
+def test_none_values_skipped_dump():
+    import io
+
+    fp = io.BytesIO()
+    tomli_w.dump({"a": None, "b": 1}, fp)
+    assert fp.getvalue() == b"b = 1\n"
+
+
+def test_pathlib_values():
+    import pathlib
+
+    p = pathlib.PurePosixPath("/usr/local/bin")
+    obj = {"p": p, "arr": [p], "tbl": {"q": p}, "aot": [{"r": p}]}
+    assert tomli_w.dumps(obj) == (
+        'p = "/usr/local/bin"\n'
+        'arr = [\n    "/usr/local/bin",\n]\n'
+        'aot = [\n    { r = "/usr/local/bin" },\n]\n'
+        '\n[tbl]\nq = "/usr/local/bin"\n'
+    )
+    assert tomli_w.dumps({"p": pathlib.Path("a/b")}) == f'p = "{pathlib.Path("a/b")}"\n'
+    assert tomli_w.dumps({"w": pathlib.PureWindowsPath("C:/x/y")}) == (
+        'w = "C:\\\\x\\\\y"\n'
+    )
+
+
+def test_none_in_array_skipped():
+    assert tomli_w.dumps({"a": [1, None, 2]}) == "a = [\n    1,\n    2,\n]\n"
+    assert tomli_w.dumps({"a": [None], "b": (None, None)}) == "a = []\nb = []\n"
+    assert tomli_w.dumps({"a": [[None, 1], [None]]}) == (
+        "a = [\n    [\n        1,\n    ],\n    [],\n]\n"
+    )
+    assert tomli_w.dumps({"a": [{"x": 1}, None]}) == (
+        "a = [\n    { x = 1 },\n]\n"
+    )
+    assert tomli_w.dumps({"t": {"a": [None, "s"]}}) == (
+        "[t]\na = [\n    \"s\",\n]\n"
+    )
