 ```
 
+##### significantDigits
+
+Type: `number`\
+Default: `3`
+
+Round to this many significant digits instead of the default of 3.
+
+Only applies when neither [`minimumFractionDigits`](#minimumfractiondigits) nor [`maximumFractionDigits`](#maximumfractiondigits) is set. Must be an integer between 1 and 100; any other value is ignored and the default of 3 is used.
+
+```js
+import prettyBytes from 'pretty-bytes';
+
+prettyBytes(1337, {significantDigits: 2});
+//=> '1.3 kB'
+
+prettyBytes(1337, {significantDigits: 4});
+//=> '1.337 kB'
+```
+
 ##### locale
 
 Type: `boolean | string | string[]`\
diff --git a/test.js b/test.js
index 95b9b42..ff8c4d9 100644
--- a/test.js
+++ b/test.js
@@ -1189,3 +1189,24 @@ test('unit option must belong to the active unit system', t => {
 		prettyBytes(10n ** 400n, {unit: 'KiB'});
 	}, {instanceOf: TypeError});
 });
+
+test('significantDigits option changes the default rounding', t => {
+	t.is(prettyBytes(1337, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 3}), '1.34 kB');
+	t.is(prettyBytes(1337n, {significantDigits: 4}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4, locale: 'de'}), '1,337 kB');
+	t.is(prettyBytes(999_999, {significantDigits: 1}), '1 MB');
+	t.is(prettyBytes(1337, {significantDigits: 4, unit: 'MB'}), '0.001337 MB');
+});
+
+test('significantDigits option is ignored when fraction digits are set', t => {
+	t.is(prettyBytes(1337, {significantDigits: 4, maximumFractionDigits: 1}), '1.3 kB');
+	t.is(prettyBytes(1900, {significantDigits: 1, minimumFractionDigits: 3}), '1.900 kB');
+});
+
+test('significantDigits option ignores invalid values', t => {
+	for (const significantDigits of [0, -1, 1.5, 101, Number.NaN, Number.POSITIVE_INFINITY, '4', null, undefined, {}]) {
+		t.is(prettyBytes(1337, {significantDigits}), '1.34 kB');
+	}
+});
