+
+/**
+ * Checks if two URLs have the same origin (scheme, host and port).
+ *
+ * - Path, query, hash and userinfo are ignored.
+ * - Scheme and host are case-insensitive; IDN hosts are compared in punycode.
+ * - Ports are compared as written (`example.com` and `example.com:443` differ).
+ * - Relative URLs resolve against the current origin, so they match anything.
+ * - Protocol-relative URLs inherit the scheme of the other URL.
+ * - Opaque origins (`javascript:`, `data:`, `mailto:`, ...) never match.
+ *
+ * @example
+ * ```js
+ * isSameOrigin("https://example.com/a", "https://example.com/b?q=1"); // true
+ *
+ * isSameOrigin("https://example.com", "https://evil.com"); // false
+ * ```
+ *
+ * @group utils
+ */
+export function isSameOrigin(a: string, b: string): boolean {
+  const isOpaque = (input: string) =>
+    hasProtocol(input) && !hasProtocol(input, { strict: true });
+  if (isOpaque(a) || isOpaque(b)) {
+    return false;
+  }
+  const pa = parseURL(a);
+  const pb = parseURL(b);
+  // Relative URLs (no host) resolve against the current origin
+  if (!pa.host && !pa.protocol) {
+    return true;
+  }
+  if (!pb.host && !pb.protocol) {
+    return true;
+  }
+  if (pa.protocol && pb.protocol && pa.protocol !== pb.protocol) {
+    return false;
+  }
+  return (
+    encodeHost(pa.host!.toLowerCase()) === encodeHost(pb.host!.toLowerCase())
+  );
+}
