diff --git a/test/same-origin.test.ts b/test/same-origin.test.ts
new file mode 100644
index 0000000..f5c110c
--- /dev/null
+++ b/test/same-origin.test.ts
@@ -0,0 +1,100 @@
+import { describe, expect, test } from "vitest";
+import { isSameOrigin } from "../src";
+
+describe("isSameOrigin", () => {
+  const sameOrigin = [
+    // Identical
+    ["https://example.com", "https://example.com"],
+    // Path, query, and fragment are ignored
+    ["https://example.com/foo", "https://example.com/bar"],
+    ["https://example.com/?a=1", "https://example.com/?b=2#hash"],
+    ["https://example.com", "https://example.com/"],
+    // Scheme and host are case-insensitive
+    ["HTTPS://EXAMPLE.COM", "https://example.com"],
+    ["https://Example.com/foo", "https://example.COM/bar"],
+    // Identical explicit ports match
+    ["http://localhost:3000/a", "http://localhost:3000/b"],
+    ["https://example.com:443/a", "https://example.com:443/b"],
+    // Userinfo is not part of the origin
+    ["https://user:pass@example.com/foo", "https://example.com/foo"],
+    // IDN / punycode hosts are equivalent
+    ["https://тест.рф", "https://xn--e1aybc.xn--p1ai"],
+    // Protocol-relative URLs inherit the scheme of the other URL
+    ["https://example.com/a", "//example.com/b"],
+    ["//example.com/a", "https://example.com/b"],
+    // Relative URLs have no origin of their own: they are same-origin
+    // with anything (they resolve against the current origin)
+    ["/foo", "/bar"],
+    ["foo/bar", "?q=1"],
+    ["/foo", "https://example.com/foo"],
+  ];
+
+  const differentOrigin = [
+    // Different host
+    ["https://example.com", "https://example.org"],
+    // Subdomains are different origins
+    ["https://example.com", "https://www.example.com"],
+    ["https://a.example.com", "https://b.example.com"],
+    // Different scheme
+    ["http://example.com", "https://example.com"],
+    // Different port
+    ["https://example.com:8443", "https://example.com"],
+    ["http://localhost:3000", "http://localhost:4000"],
+    // No port normalization: an explicit default port is NOT the same
+    // origin as an omitted port (strict string comparison of the port)
+    ["https://example.com", "https://example.com:443"],
+    ["http://example.com", "http://example.com:80"],
+    ["https://example.com:443/foo", "https://example.com/bar"],
+    // Default port of one scheme is not the default of the other
+    ["http://example.com:443", "http://example.com"],
+    ["https://example.com:80", "https://example.com"],
+    // Look-alike hosts (userinfo / suffix tricks)
+    ["https://example.com@evil.com", "https://example.com"],
+    ["https://example.com.evil.com", "https://example.com"],
+    ["https://example.com", "https://example.com.evil.com"],
+    // Protocol-relative URL with a different host
+    ["https://example.com/a", "//evil.com/a"],
+    // Backslash is treated as slash by browsers for special schemes
+    ["https://example.com", "https:\\\\evil.com"],
+  ];
+
+  for (const [a, b] of sameOrigin) {
+    test(`${a} == ${b}`, () => {
+      expect(isSameOrigin(a, b)).toBe(true);
+      // Symmetric
+      expect(isSameOrigin(b, a)).toBe(true);
+    });
+  }
+
+  for (const [a, b] of differentOrigin) {
+    test(`${a} != ${b}`, () => {
+      expect(isSameOrigin(a, b)).toBe(false);
+      // Symmetric
+      expect(isSameOrigin(b, a)).toBe(false);
+    });
+  }
+
+  describe("opaque / non-hierarchical origins", () => {
+    // Per the WHATWG spec these have an opaque origin, which is never
+    // same-origin with anything (not even itself).
+    const opaque = [
+      ["javascript:alert(1)", "javascript:alert(1)"],
+      ["data:text/plain,hi", "data:text/plain,hi"],
+      ["mailto:a@example.com", "mailto:a@example.com"],
+      ["javascript:alert(1)", "https://example.com"],
+    ];
+    for (const [a, b] of opaque) {
+      test(`${a} != ${b}`, () => {
+        expect(isSameOrigin(a, b)).toBe(false);
+        expect(isSameOrigin(b, a)).toBe(false);
+      });
+    }
+  });
+
+  describe("empty input", () => {
+    test("empty strings are relative, hence same-origin", () => {
+      expect(isSameOrigin("", "")).toBe(true);
+      expect(isSameOrigin("", "https://example.com")).toBe(true);
+    });
+  });
+});
