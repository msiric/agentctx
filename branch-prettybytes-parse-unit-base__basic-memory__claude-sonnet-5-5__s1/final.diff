diff --git a/index.d.ts b/index.d.ts
index 4fac6e9..5d77e51 100644
--- a/index.d.ts
+++ b/index.d.ts
@@ -216,3 +216,22 @@ export default function prettyBytes(
 	number: number | bigint,
 	options?: Options
 ): string;
+
+/**
+Convert a human readable byte string back to a number of bytes. The reverse of `prettyBytes()`.
+
+Accepts a plain number (`'512'`), or a number with the `B` unit, one of the decimal units `kB`, `MB`, `GB`, `TB`, `PB`, `EB`, `ZB`, `YB` (powers of 1000; `KB` is an alias of `kB`), or one of the binary units `KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`, `ZiB`, `YiB` (powers of 1024). Fractional values are allowed and a space between the number and the unit is optional. Units are case-sensitive.
+
+@param string - The string to parse.
+@returns The number of bytes.
+@throws A `TypeError` if the input is not a string, and a `SyntaxError` if it cannot be parsed or uses an unsupported unit.
+
+@example
+```
+import {parseBytes} from 'pretty-bytes';
+
+parseBytes('1.5 KiB');
+//=> 1536
+```
+*/
+export function parseBytes(string: string): number;
diff --git a/index.js b/index.js
index c5f37ab..9e31ce3 100644
--- a/index.js
+++ b/index.js
@@ -285,3 +285,36 @@ export default function prettyBytes(number, options) {
 	const result = prefix + numberString + separator + UNITS[exponent];
 	return result.padStart(options.fixedWidth ?? 0);
 }
+
+// Maps each accepted unit to its multiplier. Units with `i` are powers of 1024; the ones without are SI powers of 1000, the same as `prettyBytes` writes them. `KB` is accepted as an alias of `kB`.
+const PARSE_UNIT_MULTIPLIERS = new Map([
+	...BIBYTE_UNITS.map((unit, index) => [unit, 1024 ** index]),
+	...BYTE_UNITS.map((unit, index) => [unit, 1000 ** index]),
+	['KB', 1000],
+]);
+
+// Optional sign, a plain decimal number, and an optional unit that may be separated by whitespace (including the non-breaking space `prettyBytes` can emit).
+const PARSE_PATTERN = /^(?<sign>[+-])?(?<number>\d+(?:\.\d+)?|\.\d+)(?:\s*(?<unit>[A-Za-z]+))?$/;
+
+export function parseBytes(string) {
+	if (typeof string !== 'string') {
+		throw new TypeError(`Expected a string, got ${typeof string}`);
+	}
+
+	const match = PARSE_PATTERN.exec(string.trim());
+
+	if (!match) {
+		throw new SyntaxError(`Unable to parse bytes from: ${JSON.stringify(string)}`);
+	}
+
+	const {sign, number, unit = 'B'} = match.groups;
+	const multiplier = PARSE_UNIT_MULTIPLIERS.get(unit);
+
+	if (multiplier === undefined) {
+		throw new SyntaxError(`Unsupported unit ${JSON.stringify(unit)}, expected one of: ${[...PARSE_UNIT_MULTIPLIERS.keys()].join(', ')}`);
+	}
+
+	const bytes = Number(number) * multiplier;
+
+	return sign === '-' ? -bytes : bytes;
+}
