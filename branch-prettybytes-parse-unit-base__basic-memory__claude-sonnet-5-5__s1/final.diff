+
+test('parseBytes: plain numbers and bytes', t => {
+	t.is(parseBytes('0'), 0);
+	t.is(parseBytes('512'), 512);
+	t.is(parseBytes('512 B'), 512);
+	t.is(parseBytes('512B'), 512);
+	t.is(parseBytes('  512 B  '), 512);
+	t.is(parseBytes('1.5'), 1.5);
+	t.is(parseBytes('.5 B'), 0.5);
+	t.is(parseBytes('-512 B'), -512);
+	t.is(parseBytes('+512 B'), 512);
+});
+
+test('parseBytes: binary units', t => {
+	for (const [index, unit] of BINARY_UNITS.entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1024 ** index);
+		t.is(parseBytes(`1${unit}`), 1024 ** index);
+		t.is(parseBytes(`1\u00A0${unit}`), 1024 ** index);
+		t.is(parseBytes(`2 ${unit}`), 2 * (1024 ** index));
+	}
+
+	t.is(parseBytes('1.5 KiB'), 1536);
+	t.is(parseBytes('0.5 MiB'), 524_288);
+	t.is(parseBytes('-1.5 KiB'), -1536);
+});
+
+test('parseBytes: round-trips prettyBytes binary output', t => {
+	for (const value of [0, 1, 512, 1024, 1536, 1024 ** 3, 3 * (1024 ** 5)]) {
+		t.is(parseBytes(prettyBytes(value, {binary: true})), value);
+	}
+});
+
+test('parseBytes: units are case-sensitive', t => {
+	for (const input of ['1 kib', '1 KIB', '1 kiB', '1 b', '1 mib', '1 Kib']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError}, `input: ${input}`);
+	}
+});
+
+test('parseBytes: decimal units', t => {
+	for (const [index, unit] of DECIMAL_UNITS.entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1000 ** index);
+		t.is(parseBytes(`1${unit}`), 1000 ** index);
+		t.is(parseBytes(`2 ${unit}`), 2 * (1000 ** index));
+	}
+
+	t.is(parseBytes('1.5 kB'), 1500);
+	t.is(parseBytes('1 KB'), 1000);
+	t.is(parseBytes('-2.5 MB'), -2_500_000);
+});
+
+test('parseBytes: round-trips prettyBytes decimal output', t => {
+	for (const value of [0, 1, 999, 1000, 1500, 1e6, 3e12, 2e24]) {
+		t.is(parseBytes(prettyBytes(value)), value);
+	}
+});
+
+test('parseBytes: decimal units are case-sensitive apart from KB', t => {
+	for (const input of ['1 kb', '1 mb', '1 Kb', '1 mB', '1 gb', '1 Mb']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError}, `input: ${input}`);
+	}
+});
+
+test('parseBytes: throws on invalid input', t => {
+	for (const input of ['', ' ', 'KiB', 'abc', '1 2 KiB', '1..5', '1.', '1,5 KiB', '1e3', 'NaN', 'Infinity', '--1', '1 KiB B', '1 bit']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError}, `input: ${input}`);
+	}
+
+	for (const input of [1, undefined, null, {}, 1n]) {
+		t.throws(() => parseBytes(input), {instanceOf: TypeError});
+	}
