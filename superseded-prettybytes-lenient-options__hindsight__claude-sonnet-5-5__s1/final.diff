+##### significantDigits
+
+Type: `number`\
+Default: `3`
+
+The number of significant digits to round to when neither `minimumFractionDigits` nor `maximumFractionDigits` is set. Ignored when either of them is set.
+
+Must be an integer between 1 and 100. Throws a `TypeError` for invalid values.
+
+The integer part of the number is never rounded away, so `999` bytes stays `999 B` whatever the value.
+
+```js
+import prettyBytes from 'pretty-bytes';
+
+prettyBytes(1337, {significantDigits: 2});
+//=> '1.3 kB'
+
+prettyBytes(1337, {significantDigits: 4});
+//=> '1.337 kB'
+```
+
 ##### space
 
 Type: `boolean`\
diff --git a/test.js b/test.js
index 1e99531..8504790 100644
--- a/test.js
+++ b/test.js
@@ -1200,3 +1200,32 @@ test('unit must belong to the active unit system', t => {
 		}, {instanceOf: TypeError});
 	}
 });
+
+test('significantDigits changes the default rounding', t => {
+	t.is(prettyBytes(1337, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 3}), '1.34 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 1}), '1 kB');
+	t.is(prettyBytes(1337, {significantDigits: 10}), '1.337 kB');
+	t.is(prettyBytes(999, {significantDigits: 1}), '999 B');
+	t.is(prettyBytes(999_999, {significantDigits: 1}), '1 MB');
+	t.is(prettyBytes(12_345, {significantDigits: 5}), '12.345 kB');
+	t.is(prettyBytes(1337n, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 2, binary: true}), '1.3 KiB');
+	t.is(prettyBytes(1337, {significantDigits: 4, locale: 'de'}), '1,337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 2, unit: 'MB'}), '0.0013 MB');
+	t.is(prettyBytes(1337, {significantDigits: undefined}), '1.34 kB');
+});
+
+test('significantDigits is ignored when fraction digit options are set', t => {
+	t.is(prettyBytes(1337, {significantDigits: 2, maximumFractionDigits: 2}), '1.33 kB');
+	t.is(prettyBytes(1900, {significantDigits: 2, minimumFractionDigits: 3}), '1.900 kB');
+});
+
+test('significantDigits must be an integer between 1 and 100', t => {
+	for (const value of [0, -1, 1.5, 101, Number.NaN, '3', null]) {
+		t.throws(() => {
+			prettyBytes(1337, {significantDigits: value});
+		}, {instanceOf: TypeError});
+	}
+});
