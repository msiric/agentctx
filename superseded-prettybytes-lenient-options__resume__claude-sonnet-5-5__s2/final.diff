+test('significantDigits', t => {
+	t.is(prettyBytes(1337, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 3}), prettyBytes(1337));
+	t.is(prettyBytes(1337, {significantDigits: 1}), '1 kB');
+	t.is(prettyBytes(123_456, {significantDigits: 2}), '123 kB');
+	t.is(prettyBytes(1337n, {significantDigits: 4}), '1.337 kB');
+	t.is(prettyBytes(-1337, {significantDigits: 2}), '-1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 2, locale: 'de'}), '1,3 kB');
+	// Rounding up onto a unit boundary still carries.
+	t.is(prettyBytes(999_999, {significantDigits: 2}), '1 MB');
+	// The fraction digit options take precedence.
+	t.is(prettyBytes(1337, {significantDigits: 4, maximumFractionDigits: 1}), '1.3 kB');
+	t.is(prettyBytes(1900, {significantDigits: 1, minimumFractionDigits: 3}), '1.900 kB');
+});
+
+test('invalid significantDigits is ignored instead of throwing', t => {
+	for (const value of [0, -1, 1.5, 101, Number.NaN, Number.POSITIVE_INFINITY, '2', null, undefined, true, {}, [], 2n]) {
+		t.notThrows(() => prettyBytes(1337, {significantDigits: value}));
+		t.is(prettyBytes(1337, {significantDigits: value}), '1.34 kB');
+	}
+});
+
