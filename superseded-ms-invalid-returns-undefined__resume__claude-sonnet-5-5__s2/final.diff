+import { describe, expect, it } from '@jest/globals';
+import { parseClock } from './index';
+
+describe('parseClock(string)', () => {
+  it('should parse m:ss', () => {
+    expect(parseClock('1:30')).toBe(90000);
+    expect(parseClock('0:05')).toBe(5000);
+    expect(parseClock('00:00')).toBe(0);
+  });
+
+  it('should parse h:mm:ss', () => {
+    expect(parseClock('01:02:03')).toBe(3723000);
+    expect(parseClock('1:00:00')).toBe(3600000);
+  });
+
+  it('should allow more than two digits in the leading part', () => {
+    expect(parseClock('90:00')).toBe(5400000);
+    expect(parseClock('100:00:00')).toBe(360000000);
+  });
+
+  it('should return undefined instead of throwing for bad input', () => {
+    for (const bad of [
+      '',
+      '90',
+      '1:5',
+      '1:60',
+      '1:02:60',
+      '1:60:00',
+      '1:2:03',
+      ':30',
+      '1:30:',
+      '1:30:00:00',
+      '-1:30',
+      '1:30.5',
+      ' 1:30',
+      'a:bc',
+      '1h',
+    ]) {
+      expect(parseClock(bad)).toBeUndefined();
+    }
+  });
+
+  it('should return undefined for non-string or overly long input', () => {
+    // @ts-expect-error testing runtime behavior
+    expect(parseClock(130)).toBeUndefined();
+    // @ts-expect-error testing runtime behavior
+    expect(parseClock(undefined)).toBeUndefined();
+    expect(parseClock('1:30'.padStart(101, '0'))).toBeUndefined();
+  });
+});
