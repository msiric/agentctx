+import { describe, expect, it } from '@jest/globals';
+import { parseCompound } from './index';
+
+describe('parseCompound(string)', () => {
+  it('should parse short units', () => {
+    expect(parseCompound('1h 30m')).toBe(5400000);
+  });
+
+  it('should parse long units with spaces', () => {
+    expect(parseCompound('2 days 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
+  });
+
+  it('should parse a single piece like parse', () => {
+    expect(parseCompound('5s')).toBe(5000);
+  });
+
+  it('should parse pieces without whitespace between them', () => {
+    expect(parseCompound('1h30m')).toBe(5400000);
+  });
+
+  it('should accept commas and extra whitespace', () => {
+    expect(parseCompound(' 1h,  30m 15s ')).toBe(5415000);
+  });
+
+  it('should be case-insensitive', () => {
+    expect(parseCompound('1H 30M')).toBe(5400000);
+  });
+
+  it('should support decimals and negatives', () => {
+    expect(parseCompound('1.5h 30m')).toBe(7200000);
+    expect(parseCompound('1h -30m')).toBe(1800000);
+  });
+
+  it('should throw a TypeError including the input for pieces without a unit', () => {
+    expect(() => parseCompound('1h 30')).toThrow(TypeError);
+    expect(() => parseCompound('100')).toThrow('"100"');
+  });
+
+  it('should throw a TypeError including the input for bad input', () => {
+    for (const bad of ['abc', '1h foo', '1h 30x', '1h and 30m', '1h -']) {
+      expect(() => parseCompound(bad)).toThrow(TypeError);
+      expect(() => parseCompound(bad)).toThrow(JSON.stringify(bad));
+    }
+  });
+
+  it('should throw a TypeError for empty, non-string, or overly long input', () => {
+    expect(() => parseCompound('')).toThrow(TypeError);
+    expect(() => parseCompound('')).toThrow('""');
+    // @ts-expect-error testing runtime behavior
+    expect(() => parseCompound(1)).toThrow(TypeError);
+    expect(() => parseCompound('1h '.repeat(40))).toThrow(TypeError);
+  });
+});
