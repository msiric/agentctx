+const COMPOUND_PIECE = '-?\\d*\\.?\\d+ *[a-z]+';
+
+/**
+ * Parse a compound duration such as `"1h 30m"` or `"2 days 4 hours"` and
+ * return the total in milliseconds. Each piece is parsed with `parse`.
+ *
+ * Every piece must include a unit. Pieces may be separated by whitespace
+ * and/or commas.
+ *
+ * @param str - A compound duration string
+ * @returns The total in milliseconds (never `NaN`)
+ * @throws TypeError if `str` is not a string, is empty or longer than 99
+ * characters, or contains anything that isn't a valid `<number><unit>` piece
+ */
+export function parseCompound(str: string): number {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw new TypeError(
+      `Value provided to ms.parseCompound() must be a string with length between 1 and 99. value=${JSON.stringify(str)}`,
+    );
+  }
+  const invalid = () =>
+    new TypeError(
+      `Invalid compound duration provided to ms.parseCompound(). value=${JSON.stringify(str)}`,
+    );
+  const valid = new RegExp(
+    `^\\s*${COMPOUND_PIECE}(?:[\\s,]*${COMPOUND_PIECE})*\\s*$`,
+    'i',
+  );
+  if (!valid.test(str)) {
+    throw invalid();
+  }
+  const pieces = str.match(new RegExp(COMPOUND_PIECE, 'gi')) as string[];
+  const total = pieces.reduce((sum, piece) => sum + parse(piece), 0);
+  // An unknown unit (e.g. "30x") makes `parse` return NaN.
+  if (Number.isNaN(total)) {
+    throw invalid();
+  }
+  return total;
+}
+
+const CLOCK = /^(?:(\d+):([0-5]\d)|(\d+):([0-5]\d):([0-5]\d))$/;
+
+/**
+ * Parse a timer-style string and return the total in milliseconds.
+ * `"m:ss"` (e.g. `"1:30"`) and `"h:mm:ss"` (e.g. `"01:02:03"`) are supported.
+ * The leading part may have any number of digits; minutes (in the `h:mm:ss`
+ * form) and seconds must be two digits between `00` and `59`.
+ *
+ * Unlike `parseCompound`, this never throws.
+ *
+ * @param str - A timer-style string
+ * @returns The total in milliseconds, or `undefined` if `str` isn't a valid
+ * clock string
+ */
+export function parseClock(str: string): number | undefined {
+  if (typeof str !== 'string' || str.length > 100) {
+    return undefined;
+  }
+  const match = CLOCK.exec(str);
+  if (!match) {
+    return undefined;
+  }
+  const [h, m, s] =
+    match[1] !== undefined
+      ? [0, match[1], match[2]]
+      : [match[3], match[4], match[5]];
+  return (Number(h) * 3600 + Number(m) * 60 + Number(s)) * 1000;
+}
+
 /**
  * Short format for `ms`.
  */
