+##### significantDigits
+
+Type: `number`\
+Default: `3`
+
+The number of significant digits to round to.
+
+Only applies when neither `minimumFractionDigits` nor `maximumFractionDigits` is set. The integer part of the number is never cut short.
+
+Must be an integer between 1 and 100. Any other value is ignored and the default is used.
+
+```js
+import prettyBytes from 'pretty-bytes';
+
+prettyBytes(1337, {significantDigits: 2});
+//=> '1.3 kB'
+
+prettyBytes(1337, {significantDigits: 4});
+//=> '1.337 kB'
+```
+
 ##### space
 
 Type: `boolean`\
diff --git a/test.js b/test.js
index 9d6eb60..4b557df 100644
--- a/test.js
+++ b/test.js
@@ -1198,3 +1198,26 @@ test('the options shape the output as documented', t => {
 		t.is(prettyBytes(value, {signed: true}), prefix + prettyBytes(Math.abs(value)));
 	}
 });
+
+test('significantDigits', t => {
+	t.is(prettyBytes(1337, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 1}), '1 kB');
+	t.is(prettyBytes(1337, {significantDigits: 3}), prettyBytes(1337));
+	t.is(prettyBytes(999, {significantDigits: 1}), '999 B');
+	t.is(prettyBytes(999_999, {significantDigits: 1}), '1 MB');
+	t.is(prettyBytes(1337n, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 2, locale: 'de'}), '1,3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 5, binary: true}), '1.3057 KiB');
+});
+
+test('significantDigits is ignored when fraction digits are set', t => {
+	t.is(prettyBytes(1337, {significantDigits: 2, maximumFractionDigits: 2}), '1.33 kB');
+	t.is(prettyBytes(1900, {significantDigits: 1, minimumFractionDigits: 3}), '1.900 kB');
+});
+
+test('an invalid significantDigits is ignored instead of throwing', t => {
+	for (const value of [0, -1, 1.5, 101, Number.NaN, Number.POSITIVE_INFINITY, '2', null, {}, undefined]) {
+		t.is(prettyBytes(1337, {significantDigits: value}), '1.34 kB');
+	}
+});
