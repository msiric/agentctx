+/**
+ * Removes the query string from the URL, keeping the hash.
+ *
+ * @example
+ *
+ * ```js
+ * withoutQuery("/foo?bar=1#baz"); // "/foo#baz"
+ * ```
+ *
+ * @group utils
+ */
+export function withoutQuery(input: string): string {
+  return stringifyParsedURL({ ...parseURL(input), search: "" });
+}
+
 /**
  * Removes the query section of the URL.
  *
@@ -773,3 +788,42 @@ export function withoutHost(input: string) {
   const parsed = parseURL(input);
   return (parsed.pathname || "/") + parsed.search + parsed.hash;
 }
+
+/**
+ * Parses a `data:` URL (RFC 2397) into its MIME type, base64 flag and raw payload.
+ *
+ * - `mimeType` includes any parameters (e.g. `text/plain;charset=utf-8`) and defaults to `text/plain`.
+ * - `data` is the payload exactly as written in the URL (not percent- or base64-decoded).
+ *
+ * Throws a `TypeError` if the input is not a valid `data:` URL.
+ *
+ * @example
+ *
+ * ```js
+ * parseDataURL("data:text/plain;base64,SGVsbG8=");
+ * // { mimeType: "text/plain", base64: true, data: "SGVsbG8=" }
+ * ```
+ *
+ * @group utils
+ */
+export function parseDataURL(input: string): {
+  mimeType: string;
+  base64: boolean;
+  data: string;
+} {
+  const match = /^data:([^,]*),([\S\s]*)$/i.exec(input.trim());
+  if (!match) {
+    throw new TypeError(`Invalid data URL: ${input}`);
+  }
+  let meta = match[1]!;
+  let base64 = false;
+  const b64 = /;\s*base64$/i.exec(meta);
+  if (b64) {
+    base64 = true;
+    meta = meta.slice(0, b64.index);
+  }
+  meta = meta.trim();
+  // Meta with only parameters (e.g. ";charset=utf-8") implies text/plain
+  const mimeType = !meta || meta.startsWith(";") ? `text/plain${meta}` : meta;
+  return { mimeType, base64, data: match[2]! };
+}
