+describe("parseDataURL", () => {
+  const tests = [
+    {
+      input: "data:text/plain;base64,SGVsbG8=",
+      out: { mimeType: "text/plain", base64: true, data: "SGVsbG8=" },
+    },
+    {
+      input: "data:text/html,<h1>Hi</h1>",
+      out: { mimeType: "text/html", base64: false, data: "<h1>Hi</h1>" },
+    },
+    {
+      input: "data:,Hello%20World",
+      out: { mimeType: "text/plain", base64: false, data: "Hello%20World" },
+    },
+    {
+      input: "data:;base64,SGVsbG8=",
+      out: { mimeType: "text/plain", base64: true, data: "SGVsbG8=" },
+    },
+    {
+      input: "data:;charset=utf-8,hi",
+      out: {
+        mimeType: "text/plain;charset=utf-8",
+        base64: false,
+        data: "hi",
+      },
+    },
+    {
+      input: "data:text/plain;charset=utf-8;base64,aGk=",
+      out: {
+        mimeType: "text/plain;charset=utf-8",
+        base64: true,
+        data: "aGk=",
+      },
+    },
+    {
+      input: "DATA:image/png;BASE64,AAA=",
+      out: { mimeType: "image/png", base64: true, data: "AAA=" },
+    },
+    {
+      input: "data:text/plain,a,b",
+      out: { mimeType: "text/plain", base64: false, data: "a,b" },
+    },
+    {
+      input: "data:text/plain,",
+      out: { mimeType: "text/plain", base64: false, data: "" },
+    },
+  ];
+  for (const t of tests) {
+    test(t.input, () => {
+      expect(parseDataURL(t.input)).toEqual(t.out);
+    });
+  }
+
+  test("throws on invalid input", () => {
+    expect(() => parseDataURL("http://example.com")).toThrow(TypeError);
+    expect(() => parseDataURL("data:text/plain")).toThrow(TypeError);
+    expect(() => parseDataURL("")).toThrow(TypeError);
+  });
+});
