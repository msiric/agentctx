        mock_job = make_mock_job()
        other_job = make_mock_job(name="other")
        with mock_datetime(2024, 1, 1, 10, 0, 0):
            every().minute.do(mock_job).tag("maint")
            every().minute.do(other_job).tag("other")
            schedule.pause("maint")
        with mock_datetime(2024, 1, 1, 10, 1, 0):
            schedule.run_pending()
            assert mock_job.call_count == 0
            assert other_job.call_count == 1
            schedule.resume("maint")
            schedule.run_pending()
            assert mock_job.call_count == 1
            # Does not run again until next due
            schedule.run_pending()
            assert mock_job.call_count == 1
        schedule.clear()

    def test_pause_applies_to_jobs_added_later_and_multi_tag(self):
        mock_job = make_mock_job()
        schedule.pause("maint")
        with mock_datetime(2024, 1, 1, 10, 0, 0):
            every().minute.do(mock_job).tag("a", "maint")
        with mock_datetime(2024, 1, 1, 10, 1, 0):
            schedule.run_pending()
            assert mock_job.call_count == 0
        schedule.clear()

    def test_pause_unknown_tag_and_double_resume(self):
        schedule.pause("nothing")
        schedule.resume("nothing")
        schedule.resume("nothing")
        schedule.resume("never-paused")
        schedule.clear()

    def test_paused_jobs_ignored_by_next_run_and_run_all(self):
        mock_job = make_mock_job()
        with mock_datetime(2024, 1, 1, 10, 0, 0):
            every().minute.do(mock_job).tag("maint")
            assert schedule.next_run() is not None
            schedule.pause("maint")
            assert schedule.next_run() is None
            assert schedule.next_run("maint") is None
            assert schedule.idle_seconds() is None
            schedule.run_all()
            assert mock_job.call_count == 1
            schedule.resume("maint")
            assert schedule.next_run() is not None
        schedule.clear()

    def test_clear_resets_pause(self):
        mock_job = make_mock_job()
        schedule.pause("maint")
        schedule.clear("maint")
        with mock_datetime(2024, 1, 1, 10, 0, 0):
            every().minute.do(mock_job).tag("maint")
        with mock_datetime(2024, 1, 1, 10, 1, 0):
            schedule.run_pending()
            assert mock_job.call_count == 1
        schedule.clear()

    def test_misconfigured_job_wont_break""",1)
