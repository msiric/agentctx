@@ -285,3 +285,76 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def test_json_write_is_atomic_on_crash(tmpdir, monkeypatch):
+    """A crash while writing must leave the old, readable database behind."""
+    path = str(tmpdir.join('test.db'))
+
+    db = TinyDB(path)
+    db.insert({'a': 1})
+    db.close()
+
+    # Simulate the process dying mid-write: the temp file is only partially
+    # written when the "crash" happens.
+    def crash(fd):
+        raise KeyboardInterrupt('simulated kill')
+
+    monkeypatch.setattr(os, 'fsync', crash)
+    db = TinyDB(path)
+    with pytest.raises(KeyboardInterrupt):
+        db.insert({'b': 2})
+    monkeypatch.undo()
+
+    # Database file is still the complete old state, and no temp files leak
+    assert json.load(open(path)) == {'_default': {'1': {'a': 1}}}
+    assert os.listdir(str(tmpdir)) == ['test.db']
+
+    db = TinyDB(path)
+    assert db.all() == [{'a': 1}]
+    db.close()
+
+
+def test_json_crash_before_replace_keeps_old_state(tmpdir, monkeypatch):
+    path = str(tmpdir.join('test.db'))
+    db = TinyDB(path)
+    db.insert({'a': 1})
+    db.close()
+
+    def crash(src, dst):
+        raise SystemExit('simulated kill')
+
+    monkeypatch.setattr(os, 'replace', crash)
+    db = TinyDB(path)
+    with pytest.raises(SystemExit):
+        db.insert({'b': 2})
+    monkeypatch.undo()
+
+    assert TinyDB(path).all() == [{'a': 1}]
+
+
+def test_json_serialization_error_keeps_data(tmpdir):
+    path = str(tmpdir.join('test.db'))
+    db = TinyDB(path)
+    db.insert({'a': 1})
+    with pytest.raises(TypeError):
+        db.insert({'b': object()})
+    db.close()
+
+    assert TinyDB(path).all() == [{'a': 1}]
+
+
+def test_json_multiple_writes_and_permissions(tmpdir):
+    path = str(tmpdir.join('test.db'))
+    db = TinyDB(path)
+    db.insert({'a': 1})
+    os.chmod(path, 0o640)
+    for i in range(5):
+        db.insert({'i': i})
+    assert len(db) == 6
+    db.close()
+
+    assert len(TinyDB(path)) == 6
+    assert os.listdir(str(tmpdir)) == ['test.db']
+    if os.name == 'posix':
+        assert os.stat(path).st_mode & 0o777 == 0o640
