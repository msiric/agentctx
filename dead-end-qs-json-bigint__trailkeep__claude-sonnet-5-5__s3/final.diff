+- `'json'`: Parse `filter` as JSON. A value that is not valid JSON stays a string:
+
+```js
+import queryString from 'query-string';
+
+queryString.parse('?filter=%7B%22status%22%3A%22open%22%7D&other=%7B', {
+	types: {
+		filter: 'json',
+		other: 'json',
+	}
+});
+//=> {filter: {status: 'open'}, other: '{'}
+```
+
+Note: The `'json'` type uses `JSON.parse()`, so an integer beyond `Number.MAX_SAFE_INTEGER`, like a 64-bit ID, is silently rounded. Write such IDs as strings. A valueless key (e.g. `?filter`) stays `null`, and with an array format, each item is parsed separately.
+
 - `'string[]'`:  Parse `items` as an array of strings (overriding the `parseNumbers` option):
 
 ```js
diff --git a/test/parse.js b/test/parse.js
index 00a1abf..e775325 100644
--- a/test/parse.js
+++ b/test/parse.js
@@ -1492,3 +1492,27 @@ test('rejects an invalid `arrayFormatSeparator`', () => {
 
 	assert.deepEqual(structuredClone(queryString.parse('foo=a·b', {arrayFormat: 'separator', arrayFormatSeparator: '·'})), {foo: ['a', 'b']});
 });
+
+test('`types` with `json` parses the value as JSON', () => {
+	const parse = query => structuredClone(queryString.parse(query, {types: {filter: 'json'}}));
+	assert.deepEqual(parse('filter=%7B%22status%22%3A%22open%22%2C%22ids%22%3A%5B1%2C2%5D%7D'), {filter: {status: 'open', ids: [1, 2]}});
+	assert.deepEqual(parse('filter=%5B1%2C%22a%22%5D'), {filter: [1, 'a']});
+	assert.deepEqual(parse('filter=12'), {filter: 12});
+	assert.deepEqual(parse('filter=true'), {filter: true});
+	assert.deepEqual(parse('filter=null'), {filter: null});
+	assert.deepEqual(parse('filter=%22a%22'), {filter: 'a'});
+});
+
+test('`types` with `json` leaves a value that is not valid JSON as a string', () => {
+	const parse = query => structuredClone(queryString.parse(query, {types: {filter: 'json'}}));
+	assert.deepEqual(parse('filter=%7B'), {filter: '{'});
+	assert.deepEqual(parse('filter=abc'), {filter: 'abc'});
+	assert.deepEqual(parse('filter='), {filter: ''});
+	assert.deepEqual(parse('filter'), {filter: null});
+});
+
+test('`types` with `json` takes precedence over `parseNumbers` and `parseBooleans`, and applies to each repeated item', () => {
+	assert.deepEqual(structuredClone(queryString.parse('filter=1&other=1', {parseNumbers: true, types: {filter: 'json'}})), {filter: 1, other: 1});
+	assert.deepEqual(structuredClone(queryString.parse('filter=%7B%22a%22%3A1%7D&filter=x', {types: {filter: 'json'}})), {filter: [{a: 1}, 'x']});
+	assert.deepEqual(structuredClone(queryString.parse('filter=%5B1%5D,%5B2%5D', {arrayFormat: 'comma', types: {filter: 'json'}})), {filter: [[1], [2]]});
+});
