@@ -242,3 +242,110 @@ function plural(
   const isPlural = msAbs >= n * 1.5;
   return `${Math.round(ms / n)} ${name}${isPlural ? 's' : ''}` as StringValue;
 }
+
+/**
+ * Format the given milliseconds as an ISO 8601 duration string.
+ *
+ * Days are the largest unit used, since months and years are ambiguous.
+ * Sub-second precision is emitted as fractional seconds. Negative values are
+ * prefixed with `-` (an ISO 8601-2 extension).
+ *
+ * @example
+ * formatISO(5400000); // "PT1H30M"
+ * formatISO(90061000); // "P1DT1H1M1S"
+ *
+ * @param ms - milliseconds
+ * @returns The ISO 8601 duration string
+ */
+export function formatISO(ms: number): string {
+  if (typeof ms !== 'number' || !Number.isFinite(ms)) {
+    throw new Error('Value provided to ms.formatISO() must be of type number.');
+  }
+
+  let rest = Math.round(Math.abs(ms));
+  const days = Math.floor(rest / d);
+  rest -= days * d;
+  const hours = Math.floor(rest / h);
+  rest -= hours * h;
+  const minutes = Math.floor(rest / m);
+  rest -= minutes * m;
+  const seconds = Math.floor(rest / s);
+  const millis = rest - seconds * s;
+
+  let date = '';
+  if (days) {
+    date = `${days}D`;
+  }
+
+  let time = '';
+  if (hours) {
+    time += `${hours}H`;
+  }
+  if (minutes) {
+    time += `${minutes}M`;
+  }
+  if (seconds || millis) {
+    const frac = millis
+      ? `.${String(millis).padStart(3, '0').replace(/0+$/, '')}`
+      : '';
+    time += `${seconds}${frac}S`;
+  }
+
+  if (!date && !time) {
+    return 'PT0S';
+  }
+
+  const sign = ms < 0 ? '-' : '';
+  return `${sign}P${date}${time ? `T${time}` : ''}`;
+}
+
+const isoNum = '\\d+(?:[.,]\\d+)?';
+const ISO_DURATION = new RegExp(
+  `^(?<sign>[-+])?P(?!$)` +
+    `(?:(?<years>${isoNum})Y)?(?:(?<months>${isoNum})M)?` +
+    `(?:(?<weeks>${isoNum})W)?(?:(?<days>${isoNum})D)?` +
+    `(?:T(?!$)(?:(?<hours>${isoNum})H)?(?:(?<minutes>${isoNum})M)?(?:(?<seconds>${isoNum})S)?)?$`,
+);
+
+/**
+ * Parse an ISO 8601 duration string and return milliseconds. This is the
+ * inverse of `formatISO`.
+ *
+ * Supports `PnYnMnWnDTnHnMnS` with optional fractional values (`.` or `,`) and
+ * an optional leading `-` or `+`. Years and months use the same average
+ * lengths as `parse` (365.25 days and 1/12 of that).
+ *
+ * @example
+ * parseISO('PT1H30M'); // 5400000
+ * parseISO('P1DT1H1M1S'); // 90061000
+ *
+ * @param str - An ISO 8601 duration string
+ * @returns The parsed value in milliseconds, or `NaN` if the string isn't a
+ * valid ISO 8601 duration
+ * @throws Error if `str` is not a string with length between 1 and 99
+ */
+export function parseISO(str: string): number {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw new Error(
+      `Value provided to ms.parseISO() must be a string with length between 1 and 99. value=${JSON.stringify(str)}`,
+    );
+  }
+  const groups = ISO_DURATION.exec(str)?.groups;
+  if (!groups) {
+    return NaN;
+  }
+
+  const num = (v: string | undefined) =>
+    v === undefined ? 0 : parseFloat(v.replace(',', '.'));
+
+  const total =
+    num(groups.years) * y +
+    num(groups.months) * mo +
+    num(groups.weeks) * w +
+    num(groups.days) * d +
+    num(groups.hours) * h +
+    num(groups.minutes) * m +
+    num(groups.seconds) * s;
+
+  return groups.sign === '-' ? -total : total;
+}
