@@ -0,0 +1,86 @@
+import { describe, expect, it } from '@jest/globals';
+import { formatISO, parseISO } from './index';
+
+describe('parseISO(string)', () => {
+  it('should parse the documented examples', () => {
+    expect(parseISO('PT1H30M')).toBe(5400000);
+    expect(parseISO('P1DT1H1M1S')).toBe(90061000);
+  });
+
+  it('should parse zero', () => {
+    expect(parseISO('PT0S')).toBe(0);
+    expect(parseISO('P0D')).toBe(0);
+  });
+
+  it('should parse single units', () => {
+    expect(parseISO('PT1S')).toBe(1000);
+    expect(parseISO('PT1M')).toBe(60000);
+    expect(parseISO('PT1H')).toBe(3600000);
+    expect(parseISO('P1D')).toBe(86400000);
+    expect(parseISO('P1W')).toBe(7 * 86400000);
+  });
+
+  it('should distinguish months from minutes', () => {
+    expect(parseISO('P1M')).toBeCloseTo((365.25 * 86400000) / 12);
+    expect(parseISO('PT1M')).toBe(60000);
+  });
+
+  it('should parse years', () => {
+    expect(parseISO('P1Y')).toBe(365.25 * 86400000);
+  });
+
+  it('should parse fractional values', () => {
+    expect(parseISO('PT0.5S')).toBe(500);
+    expect(parseISO('PT1,5S')).toBe(1500);
+    expect(parseISO('PT1.5H')).toBe(5400000);
+    expect(parseISO('P0.5D')).toBe(43200000);
+  });
+
+  it('should support signs', () => {
+    expect(parseISO('-PT1H30M')).toBe(-5400000);
+    expect(parseISO('+PT1H30M')).toBe(5400000);
+  });
+
+  it('should return NaN for invalid durations', () => {
+    for (const bad of [
+      'P',
+      'PT',
+      'P1DT',
+      '1H30M',
+      'PT1H30',
+      'PT30M1H',
+      'P1D1Y',
+      'PT1X',
+      'P-1D',
+      'PT1.S',
+      'pt1h',
+      ' PT1H',
+      'PT1H ',
+      'hello',
+    ]) {
+      expect(parseISO(bad)).toBeNaN();
+    }
+  });
+
+  it('should throw on empty, overlong or non-string values', () => {
+    expect(() => parseISO('')).toThrow();
+    expect(() => parseISO(`P${'1'.repeat(100)}D`)).toThrow();
+    // @ts-expect-error testing invalid input
+    expect(() => parseISO(5400000)).toThrow();
+  });
+
+  it('should round-trip with formatISO', () => {
+    for (const v of [
+      0,
+      1,
+      500,
+      1050,
+      5400000,
+      90061000,
+      400 * 86400000,
+      -5400000,
+    ]) {
+      expect(parseISO(formatISO(v))).toBe(v);
+    }
+  });
+});
