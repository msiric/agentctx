+
+
+def test_statement_types():
+    assert sqlparse.statement_types(
+        'select 1; insert into t values (1); create table x (a int);'
+    ) == ['SELECT', 'INSERT', 'CREATE']
+    assert sqlparse.statement_types('') == []
+    assert sqlparse.statement_types('-- c\nupdate t set a = 1') == ['UPDATE']
