+class NonEmpty:
+    """
+    Validates that a string, list or dict is not empty. Strings consisting
+    only of whitespace are considered empty. Other data is returned unchanged.
+    """
+
+    def __init__(self, error: Union[str, None] = None) -> None:
+        self._error: Union[str, None] = error
+
+    def __repr__(self) -> str:
+        return f"{self.__class__.__name__}()"
+
+    def validate(self, data: Any, **kwargs: Any) -> Any:
+        """
+        Validates that data is not empty.
+        :param data: Data to be validated.
+        :return: Returns validated data, unchanged.
+        """
+        if isinstance(data, str):
+            empty = not data.strip()
+        elif isinstance(data, (list, dict)):
+            empty = len(data) == 0
+        else:
+            empty = False
+        if empty:
+            # Never include the validated value: it may be sensitive data.
+            raise SchemaError(self._error or "value must not be empty")
+        return data
+
+
+class Range:
+    """
+    Validates that a number lies within inclusive bounds. Only int and float
+    are accepted (bool and NaN are rejected). Either bound may be None.
+    """
+
+    def __init__(
+        self,
+        min: Union[int, float, None] = None,
+        max: Union[int, float, None] = None,
+        error: Union[str, None] = None,
+    ) -> None:
+        if min is not None and max is not None and min > max:
+            raise ValueError("min must not be greater than max")
+        self._min = min
+        self._max = max
+        self._error: Union[str, None] = error
+
+    def __repr__(self) -> str:
+        return f"{self.__class__.__name__}(min={self._min!r}, max={self._max!r})"
+
+    def validate(self, data: Any, **kwargs: Any) -> Any:
+        """
+        Validates that data is a number within the bounds.
+        :param data: Data to be validated.
+        :return: Returns validated data, unchanged.
+        """
+        # Never include the validated value in messages: it may be sensitive.
+        if (
+            isinstance(data, bool)
+            or not isinstance(data, (int, float))
+            or data != data  # NaN
+        ):
+            raise SchemaError(self._error or "value must be an int or float")
+        if (self._min is not None and data < self._min) or (
+            self._max is not None and data > self._max
+        ):
+            raise SchemaError(
+                self._error
+                or f"value must be within range (min={self._min!r}, max={self._max!r})"
+            )
+        return data
+
+
+class OneOf:
+    """
+    Validates that data is equal to one of the given choices.
+    """
+
+    def __init__(self, *choices: Any, error: Union[str, None] = None) -> None:
+        self._choices = choices
+        self._error: Union[str, None] = error
+
+    def __repr__(self) -> str:
+        return f"{self.__class__.__name__}({', '.join(map(repr, self._choices))})"
+
+    def validate(self, data: Any, **kwargs: Any) -> Any:
+        """
+        Validates that data is one of the choices.
+        :param data: Data to be validated.
+        :return: Returns validated data, unchanged.
+        """
+        if not any(data == c for c in self._choices):
+            # Never include the validated value: it may be sensitive data.
+            raise SchemaError(
+                self._error
+                or f"value must be one of {', '.join(map(repr, self._choices))}"
+            )
+        return data
+
+
