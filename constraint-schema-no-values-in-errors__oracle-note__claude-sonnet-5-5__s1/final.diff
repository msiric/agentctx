+def test_nonempty():
+    assert NonEmpty().validate("a") == "a"
+    assert NonEmpty().validate("  a  ") == "  a  "
+    assert NonEmpty().validate([0]) == [0]
+    assert NonEmpty().validate({"a": 1}) == {"a": 1}
+    # other types are returned unchanged
+    assert NonEmpty().validate(0) == 0
+    assert NonEmpty().validate(None) is None
+
+    for empty in ["", " ", " \t\n", [], {}]:
+        with raises(SchemaError):
+            NonEmpty().validate(empty)
+
+    # custom error is used verbatim
+    with raises(SchemaError) as e:
+        NonEmpty(error="must not be empty").validate("  ")
+    assert e.value.autos[-1] == "must not be empty"
+
+    # error messages never contain the validated value
+    with raises(SchemaError) as e:
+        NonEmpty().validate("   ")
+    assert repr("   ") not in str(e.value)
+    assert str(e.value) == "value must not be empty"
+    with raises(SchemaError) as e:
+        Schema({"email": NonEmpty()}).validate({"email": "  "})
+    assert "'  '" not in str(e.value)
+
+    # usage within a Schema
+    assert Schema({"name": NonEmpty()}).validate({"name": "x"}) == {"name": "x"}
+    with raises(SchemaError):
+        Schema({"name": NonEmpty()}).validate({"name": ""})
+    assert Schema(And(list, NonEmpty())).validate([1]) == [1]
+    with raises(SchemaError):
+        Schema(And(list, NonEmpty())).validate([])
+
+
+def test_range():
+    assert Range(min=1, max=3).validate(1) == 1
+    assert Range(min=1, max=3).validate(3) == 3
+    assert Range(min=1, max=3).validate(2.5) == 2.5
+    assert Range(min=1).validate(10**9) == 10**9
+    assert Range(max=1).validate(-5) == -5
+    assert Range().validate(0) == 0
+
+    for bad in [0, 4, 0.99, 3.01]:
+        with raises(SchemaError):
+            Range(min=1, max=3).validate(bad)
+    with raises(SchemaError):
+        Range(min=1).validate(0)
+    with raises(SchemaError):
+        Range(max=1).validate(2)
+
+    # non-numbers, bools and NaN are rejected
+    for bad in ["2", None, [2], True, False, float("nan")]:
+        with raises(SchemaError):
+            Range(min=0, max=3).validate(bad)
+        with raises(SchemaError):
+            Range().validate(bad)
+
+    with raises(ValueError):
+        Range(min=3, max=1)
+
+    with raises(SchemaError) as e:
+        Range(min=1, max=3, error="bad number").validate(99)
+    assert e.value.autos[-1] == "bad number"
+
+    # error messages never contain the validated value
+    with raises(SchemaError) as e:
+        Range(min=1, max=3).validate(123456789)
+    assert "123456789" not in str(e.value)
+    with raises(SchemaError) as e:
+        Range(min=1, max=3).validate("secret@example.com")
+    assert "secret" not in str(e.value)
+
+    assert Schema({"n": Range(min=1)}).validate({"n": 2}) == {"n": 2}
+    with raises(SchemaError):
+        Schema({"n": Range(min=1)}).validate({"n": 0})
+
+
+def test_oneof():
+    assert OneOf("a", "b").validate("a") == "a"
+    assert OneOf("a", 1, None).validate(1) == 1
+    assert OneOf("a", 1, None).validate(None) is None
+    assert OneOf((1, 2), [3]).validate([3]) == [3]
+    for bad in ["c", "", 2, []]:
+        with raises(SchemaError):
+            OneOf("a", "b", 1).validate(bad)
+    with raises(SchemaError):
+        OneOf().validate("a")
+
+    with raises(SchemaError) as e:
+        OneOf("a", "b", error="pick one").validate("zzz")
+    assert e.value.autos[-1] == "pick one"
+
+    # error messages never contain the validated value
+    with raises(SchemaError) as e:
+        OneOf("active", "closed").validate("secret@example.com")
+    assert "secret" not in str(e.value)
+    assert "'active'" in str(e.value)
+
+    assert Schema({"s": OneOf("x", "y")}).validate({"s": "y"}) == {"s": "y"}
+    with raises(SchemaError):
+        Schema({"s": OneOf("x", "y")}).validate({"s": "z"})
+
