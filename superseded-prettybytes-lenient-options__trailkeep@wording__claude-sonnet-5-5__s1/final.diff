--- a/test.js
+++ b/test.js
@@ -1171,3 +1171,17 @@ test('unit', t => {
 	t.throws(() => prettyBytes(1337, {unit: 'nope'}), {instanceOf: TypeError});
 	t.throws(() => prettyBytes(1337, {unit: 5}), {instanceOf: TypeError});
 });
+
+test('significantDigits', t => {
+	t.is(prettyBytes(1337, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 1}), '1 kB');
+	t.is(prettyBytes(1337, {significantDigits: 3}), '1.34 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4, locale: 'de'}), '1,337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4, maximumFractionDigits: 1}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4, minimumFractionDigits: 3}), '1.337 kB');
+	// Invalid values are ignored instead of throwing
+	for (const value of [0, -1, 1.5, 101, Number.NaN, '4', null, {}]) {
+		t.is(prettyBytes(1337, {significantDigits: value}), '1.34 kB');
+	}
+});
