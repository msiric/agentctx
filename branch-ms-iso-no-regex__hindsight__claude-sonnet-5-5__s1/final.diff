@@ -242,3 +242,102 @@ function plural(
   const isPlural = msAbs >= n * 1.5;
   return `${Math.round(ms / n)} ${name}${isPlural ? 's' : ''}` as StringValue;
 }
+
+/**
+ * Format the given milliseconds as an ISO 8601 duration, e.g. `PT1H30M`.
+ *
+ * Days are the largest unit used, since months and years are ambiguous.
+ * Sub-second precision is emitted as fractional seconds (`PT0.5S`), and
+ * negative values get a leading `-` (`-PT1H`).
+ *
+ * @param ms - milliseconds
+ * @returns The ISO 8601 duration string
+ * @throws Error if `ms` is not a finite number
+ */
+export function formatISO(ms: number): string {
+  if (typeof ms !== 'number' || !Number.isFinite(ms)) {
+    throw new Error('Value provided to ms.formatISO() must be of type number.');
+  }
+
+  // Work in whole milliseconds to avoid floating point drift.
+  let rest = Math.round(Math.abs(ms));
+  const days = Math.floor(rest / d);
+  rest -= days * d;
+  const hours = Math.floor(rest / h);
+  rest -= hours * h;
+  const minutes = Math.floor(rest / m);
+  rest -= minutes * m;
+  const seconds = Math.floor(rest / s);
+  const millis = rest - seconds * s;
+
+  let secStr = '';
+  if (millis > 0) {
+    let frac = String(millis).padStart(3, '0');
+    while (frac.endsWith('0')) {
+      frac = frac.slice(0, -1);
+    }
+    secStr = `${seconds}.${frac}S`;
+  } else if (seconds > 0) {
+    secStr = `${seconds}S`;
+  }
+
+  const time =
+    (hours ? `${hours}H` : '') + (minutes ? `${minutes}M` : '') + secStr;
+
+  if (!days && !time) {
+    return 'PT0S';
+  }
+
+  return `${ms < 0 ? '-' : ''}P${days ? `${days}D` : ''}${time ? `T${time}` : ''}`;
+}
+
+const isoNum = '(\\d+(?:[.,]\\d+)?)';
+const isoRegex = new RegExp(
+  `^([+-])?P(?:${isoNum}Y)?(?:${isoNum}M)?(?:${isoNum}W)?(?:${isoNum}D)?(?:T(?:${isoNum}H)?(?:${isoNum}M)?(?:${isoNum}S)?)?$`,
+);
+
+/**
+ * Parse an ISO 8601 duration, e.g. `PT1H30M`, and return milliseconds. This is
+ * the inverse of `formatISO`.
+ *
+ * Supports years, months, weeks, days, hours, minutes and seconds, decimal
+ * values (`.` or `,`) and a leading `+` or `-`. Years and months use the same
+ * average lengths as `parse` (365.25 days and 1/12 of that). The result is
+ * rounded to whole milliseconds.
+ *
+ * @param str - An ISO 8601 duration string
+ * @returns The parsed value in milliseconds, or `NaN` if the string is not a
+ * valid ISO 8601 duration
+ * @throws Error if `str` is not a string with length between 1 and 99
+ */
+export function parseISO(str: string): number {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw new Error(
+      `Value provided to ms.parseISO() must be a string with length between 1 and 99. value=${JSON.stringify(str)}`,
+    );
+  }
+
+  const match = isoRegex.exec(str);
+  if (!match) {
+    return NaN;
+  }
+
+  const [, sign, years, months, weeks, days, hours, minutes, seconds] = match;
+  const parts = [years, months, weeks, days, hours, minutes, seconds];
+
+  // "P", "PT", "P1YT" etc. have no components, or a dangling "T".
+  if (parts.every((p) => p === undefined) || str.endsWith('T')) {
+    return NaN;
+  }
+
+  const units = [y, mo, w, d, h, m, s];
+  let total = 0;
+  parts.forEach((p, i) => {
+    if (p !== undefined) {
+      total += parseFloat(p.replace(',', '.')) * units[i];
+    }
+  });
+
+  const result = Math.round(total);
+  return sign === '-' ? -result : result;
+}
