+++ b/src/parse-iso.test.ts
@@ -0,0 +1,80 @@
+import { describe, expect, it } from '@jest/globals';
+import { formatISO, parse, parseISO } from './index';
+
+describe('parseISO(string)', () => {
+  it('should parse examples', () => {
+    expect(parseISO('PT1H30M')).toBe(5400000);
+    expect(parseISO('P1DT1H1M1S')).toBe(90061000);
+  });
+
+  it('should parse single components', () => {
+    expect(parseISO('PT1S')).toBe(1000);
+    expect(parseISO('PT1M')).toBe(60 * 1000);
+    expect(parseISO('PT1H')).toBe(3600 * 1000);
+    expect(parseISO('P1D')).toBe(86400 * 1000);
+    expect(parseISO('P1W')).toBe(7 * 86400 * 1000);
+    expect(parseISO('P1DT1S')).toBe(86400 * 1000 + 1000);
+    expect(parseISO('P400D')).toBe(400 * 86400 * 1000);
+  });
+
+  it('should distinguish months from minutes', () => {
+    expect(parseISO('P1M')).toBe(parse('1mo'));
+    expect(parseISO('PT1M')).toBe(60000);
+  });
+
+  it('should parse years and months using average lengths', () => {
+    expect(parseISO('P1Y')).toBe(parse('1y'));
+    expect(parseISO('P1Y2M')).toBe(Math.round(parse('1y') + parse('2mo')));
+  });
+
+  it('should parse fractional values', () => {
+    expect(parseISO('PT0.5S')).toBe(500);
+    expect(parseISO('PT0,5S')).toBe(500);
+    expect(parseISO('PT0.001S')).toBe(1);
+    expect(parseISO('PT1.005S')).toBe(1005);
+    expect(parseISO('PT1.5H')).toBe(5400000);
+    expect(parseISO('PT0S')).toBe(0);
+  });
+
+  it('should parse signs', () => {
+    expect(parseISO('-PT1H30M')).toBe(-5400000);
+    expect(parseISO('+PT1H')).toBe(3600000);
+    expect(parseISO('-PT0.5S')).toBe(-500);
+  });
+
+  it('should return NaN for invalid input', () => {
+    for (const bad of [
+      'P',
+      'PT',
+      'P1DT',
+      '1H',
+      'PT1',
+      'PT1H1H',
+      'PT1M1H',
+      'P1H',
+      'P1DT1D',
+      'PT-1H',
+      'pt1h',
+      'PT.5S',
+      'PT1H ',
+      'hello',
+    ]) {
+      expect(parseISO(bad)).toBeNaN();
+    }
+  });
+
+  it('should throw on empty, too long or non-string values', () => {
+    expect(() => parseISO('')).toThrow();
+    expect(() => parseISO(`PT${'1'.repeat(100)}S`)).toThrow();
+    // @ts-expect-error testing runtime behavior
+    expect(() => parseISO(1)).toThrow();
+  });
+
+  it('should round-trip with formatISO', () => {
+    for (const value of [
+      0, 1, 500, 1250, 61005, 5400000, 90061000, -5400000, -500,
+    ]) {
+      expect(parseISO(formatISO(value))).toBe(value);
+    }
+  });
+});
