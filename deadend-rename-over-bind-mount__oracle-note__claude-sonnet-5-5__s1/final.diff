+        # Crash safety: the database file is overwritten in place (it may be a
+        # bind-mounted single file that can't be renamed over), so every write
+        # is first saved to a checksummed journal file. If we were killed
+        # mid-write, finish the interrupted write now.
+        self._journal_path = str(path) + '.journal'
+        if any(c in self._mode for c in ('+', 'w', 'a')):
+            self._recover()
+
+    def _read_journal(self) -> Optional[str]:
+        """Return the journal payload, or ``None`` if missing/incomplete."""
+        try:
+            with open(self._journal_path, 'rb') as f:
+                raw = f.read()
+        except FileNotFoundError:
+            return None
+
+        digest, sep, payload = raw.partition(b'\n')
+        if not sep or hashlib.sha256(payload).hexdigest().encode() != digest:
+            return None  # torn journal: main file was not touched yet
+        try:
+            return payload.decode('utf-8')
+        except UnicodeDecodeError:
+            return None
+
+    def _remove_journal(self) -> None:
+        try:
+            os.remove(self._journal_path)
+        except FileNotFoundError:
+            pass
+
+    def _recover(self) -> None:
+        payload = self._read_journal()
+        if payload is not None:
+            self._write_in_place(payload)
+        self._remove_journal()
+
+    def _write_in_place(self, serialized: str) -> None:
+        # Move the cursor to the beginning of the file just in case
+        self._handle.seek(0)
+
+        try:
+            self._handle.write(serialized)
+        except io.UnsupportedOperation:
+            raise IOError('Cannot write to the database. Access mode is "{0}"'.format(self._mode))
+
+        # Remove data that is behind the new cursor in case the file has
+        # gotten shorter
+        self._handle.truncate()
+
+        # Ensure the file has been written
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+
     def close(self) -> None:
         self._handle.close()
 
