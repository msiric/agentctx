--- a/tests/test_storages.py
+++ b/tests/test_storages.py
@@ -285,3 +285,70 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def test_crash_during_in_place_write_is_recovered(tmpdir, monkeypatch):
+    path = str(tmpdir.join('db.json'))
+    db = TinyDB(path)
+    db.insert({'a': 1})
+    db.close()
+
+    # Simulate dying after the journal is durable and the db file is half-written
+    real = JSONStorage._write_in_place
+
+    def crash(self, serialized):
+        self._handle.seek(0)
+        self._handle.write(serialized[:5])
+        self._handle.truncate()
+        self._handle.flush()
+        raise KeyboardInterrupt
+
+    storage = JSONStorage(path)
+    monkeypatch.setattr(JSONStorage, '_write_in_place', crash)
+    with pytest.raises(KeyboardInterrupt):
+        storage.write({'_default': {'1': {'a': 1}, '2': {'a': 2}}})
+    monkeypatch.setattr(JSONStorage, '_write_in_place', real)
+    storage._handle.close()
+
+    with open(path) as f:
+        with pytest.raises(ValueError):
+            json.load(f)  # truncated, as after the OOM kill
+
+    db = TinyDB(path)
+    assert db.all() == [{'a': 1}, {'a': 2}]
+    db.close()
+    assert not os.path.exists(path + '.journal')
+
+
+def test_crash_during_journal_write_keeps_old_state(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    db = TinyDB(path)
+    db.insert({'a': 1})
+    db.close()
+
+    # Torn journal (checksum doesn't match) and an untouched database file
+    with open(path + '.journal', 'wb') as f:
+        f.write(b'deadbeef\n{"_default": {"1": {"a"')
+
+    db = TinyDB(path)
+    assert db.all() == [{'a': 1}]
+    db.close()
+    assert not os.path.exists(path + '.journal')
+
+
+def test_journal_removed_after_normal_write(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    db = TinyDB(path)
+    db.insert({'a': 1})
+    assert not os.path.exists(path + '.journal')
+    db.close()
+
+
+def test_write_never_renames_over_database(tmpdir, monkeypatch):
+    def boom(*a, **k):
+        raise AssertionError('rename used')
+    monkeypatch.setattr(os, 'rename', boom)
+    monkeypatch.setattr(os, 'replace', boom)
+    db = TinyDB(str(tmpdir.join('db.json')))
+    db.insert({'a': 1})
+    db.close()
