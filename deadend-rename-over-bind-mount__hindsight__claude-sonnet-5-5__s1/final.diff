+        # Crash safety: write the new state to a temporary file in the same
+        # directory, fsync it and atomically swap it in with ``os.replace``.
+        # If the process dies at any point, the target is either the complete
+        # old file or the complete new file, never a truncated one.
+        target = os.path.realpath(self._path)
+        directory = os.path.dirname(target)
+        fd, tmp_path = tempfile.mkstemp(
+            dir=directory, prefix=os.path.basename(target) + '.', suffix='.tmp'
+        )
+        try:
+            with open(fd, 'w', encoding=self._encoding) as tmp:
+                tmp.write(serialized)
+                tmp.flush()
+                os.fsync(tmp.fileno())
+
+            # mkstemp creates the file with mode 0600, keep the original mode
+            try:
+                shutil.copymode(target, tmp_path)
+            except OSError:
+                pass
+
+            os.replace(tmp_path, target)
+        except BaseException:
+            try:
+                os.unlink(tmp_path)
+            except OSError:
+                pass
+            raise
+
+        # Persist the rename itself (not possible on all platforms)
+        try:
+            dir_fd = os.open(directory, os.O_RDONLY)
+        except OSError:
+            pass
+        else:
+            try:
+                os.fsync(dir_fd)
+            except OSError:
+                pass
+            finally:
+                os.close(dir_fd)
+
+        # The open handle still refers to the replaced (old) file, so reopen
+        # it on the new one.
+        self._handle.close()
+        reopen_mode = self._mode.replace('w', 'r').replace('a', 'r')
+        self._handle = open(target, mode=reopen_mode, encoding=self._encoding)
 
 
