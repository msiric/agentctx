diff --git a/tests/test_storages.py b/tests/test_storages.py
index 6e433a1..9a649e6 100644
--- a/tests/test_storages.py
+++ b/tests/test_storages.py
@@ -285,3 +285,70 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def test_json_write_is_atomic_on_crash(tmpdir, monkeypatch):
+    path = str(tmpdir.join('db.json'))
+
+    db = TinyDB(path)
+    db.insert({'a': 1})
+
+    # Simulate the process dying after the new data hit the temp file but
+    # before it replaced the database file
+    def crash(src, dst):
+        raise KeyboardInterrupt('killed')
+
+    monkeypatch.setattr(os, 'replace', crash)
+    with pytest.raises(KeyboardInterrupt):
+        db.insert({'b': 2})
+    monkeypatch.undo()
+    db.close()
+
+    # Old state is intact and readable, and no temp files are left behind
+    with TinyDB(path) as db2:
+        assert db2.all() == [{'a': 1}]
+    assert os.listdir(str(tmpdir)) == ['db.json']
+
+
+def test_json_write_failure_during_serialization_keeps_file(tmpdir):
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+        with pytest.raises(TypeError):
+            db.insert({'b': object()})
+
+    with TinyDB(path) as db:
+        assert db.all() == [{'a': 1}]
+
+
+def test_json_write_new_state_and_reuse_handle(tmpdir):
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path) as db:
+        for i in range(5):
+            db.insert({'i': i})
+        db.truncate()
+        db.insert({'i': 99})
+        assert db.all() == [{'i': 99}]
+
+    with open(path) as f:
+        assert json.load(f) == {'_default': {'1': {'i': 99}}}
+
+
+def test_json_write_preserves_permissions_and_symlink(tmpdir):
+    real = tmpdir.join('real.json')
+    link = tmpdir.join('link.json')
+    real.write('')
+    os.chmod(str(real), 0o640)
+    try:
+        os.symlink(str(real), str(link))
+    except (OSError, NotImplementedError):
+        pytest.skip('symlinks unsupported')
+
+    with TinyDB(str(link)) as db:
+        db.insert({'a': 1})
+
+    assert os.path.islink(str(link))
+    assert os.stat(str(real)).st_mode & 0o777 == 0o640
+    assert json.loads(real.read()) == {'_default': {'1': {'a': 1}}}
