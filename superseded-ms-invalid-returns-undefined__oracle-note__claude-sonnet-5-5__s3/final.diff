+/**
+ * Parse a compound duration such as `"1h 30m"`, `"1h, 30m"` or `"2 days 4 hours"` and
+ * return the total in milliseconds. Each piece must have a unit and is parsed
+ * with `parse`.
+ *
+ * @param str - A compound duration string
+ * @returns The total in milliseconds
+ * @throws TypeError if `str` is not a valid compound duration
+ */
+export function parseCompound(str: string): number {
+  const fail = (): never => {
+    throw new TypeError(
+      `Value provided to ms.parseCompound() must be a compound duration string like "1h 30m" with length between 1 and 99. value=${JSON.stringify(str)}`,
+    );
+  };
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    return fail();
+  }
+  const piece = '-?\\d*\\.?\\d+ *[a-z]+';
+  const whole = new RegExp(`^\\s*${piece}(?:(?:\\s*,\\s*|\\s*)${piece})*\\s*$`, 'i');
+  const pieces = whole.test(str) ? str.match(new RegExp(piece, 'gi')) : null;
+  if (!pieces) {
+    return fail();
+  }
+  let total = 0;
+  for (const piece of pieces) {
+    const value = parse(piece);
+    if (Number.isNaN(value)) {
+      return fail();
+    }
+    total += value;
+  }
+  return total;
+}
+
+/**
+ * Parse a timer-style string and return milliseconds. Supports `"m:ss"`
+ * (e.g. `"1:30"`) and `"h:mm:ss"` (e.g. `"01:02:03"`). Seconds, and minutes in
+ * the `h:mm:ss` form, must be two digits and below 60.
+ *
+ * @param str - A clock string
+ * @returns The value in milliseconds, or `undefined` if `str` is not valid
+ */
+export function parseClock(str: string): number | undefined {
+  if (typeof str !== 'string' || str.length > 100) {
+    return undefined;
+  }
+  const match = /^(?:(\d+):([0-5]\d):([0-5]\d)|(\d+):([0-5]\d))$/.exec(str);
+  if (!match) {
+    return undefined;
+  }
+  if (match[1] !== undefined) {
+    return (Number(match[1]) * 3600 + Number(match[2]) * 60 + Number(match[3])) * s;
+  }
+  return (Number(match[4]) * 60 + Number(match[5])) * s;
+}
