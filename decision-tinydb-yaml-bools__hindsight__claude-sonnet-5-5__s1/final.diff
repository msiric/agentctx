+def test_yaml_storage(tmpdir):
+    pytest.importorskip('yaml')
+    from tinydb.storages import YAMLStorage
+
+    path = str(tmpdir.join('test.yaml'))
+
+    with TinyDB(path, storage=YAMLStorage) as db:
+        assert db.all() == []
+        db.insert({'name': 'a', 'tags': [1, 2]})
+        db.insert({'name': 'b'})
+        db.update({'name': 'c'}, where('name') == 'b')
+        db.table('other').insert({'x': 1})
+
+    assert '!' not in tmpdir.join('test.yaml').read()
+
+    # Data persists across instances
+    with TinyDB(path, storage=YAMLStorage) as db:
+        assert db.all() == [{'name': 'a', 'tags': [1, 2]}, {'name': 'c'}]
+        assert db.get(doc_id=2) == {'name': 'c'}
+        assert db.table('other').all() == [{'x': 1}]
+        db.remove(where('name') == 'a')
+
+    # File shrinks properly (truncate)
+    with TinyDB(path, storage=YAMLStorage) as db:
+        assert db.all() == [{'name': 'c'}]
+
+
+def test_yaml_storage_readonly(tmpdir):
+    pytest.importorskip('yaml')
+    from tinydb.storages import YAMLStorage
+
+    path = str(tmpdir.join('test.yaml'))
+    with TinyDB(path, storage=YAMLStorage) as db:
+        db.insert({'a': 1})
+
+    with TinyDB(path, storage=YAMLStorage, access_mode='r') as db:
+        assert db.all() == [{'a': 1}]
+        with pytest.raises(IOError):
+            db.insert({'b': 2})
+
+
