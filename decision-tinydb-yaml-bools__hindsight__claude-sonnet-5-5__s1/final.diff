+class YAMLStorage(FileStorage):
+    """
+    Store the data in a YAML file.
+
+    Requires the optional `PyYAML <https://pyyaml.org>`_ package. Data is read
+    with ``yaml.safe_load`` and written with a safe dumper, so no arbitrary
+    Python objects are (de)serialized.
+    """
+
+    def __init__(self, path: str, create_dirs=False, encoding=None, access_mode='r+', **kwargs):
+        """
+        Create a new instance.
+
+        :param path: Where to store the YAML data.
+        :param kwargs: Extra arguments passed to ``yaml.dump`` on every write
+                       (e.g. ``default_flow_style``). **Never** pass
+                       untrusted values here.
+        """
+
+        try:
+            import yaml
+        except ImportError as e:  # pragma: no cover
+            raise ImportError('YAMLStorage requires PyYAML (pip install pyyaml)') from e
+
+        super().__init__(path, create_dirs=create_dirs, encoding=encoding, access_mode=access_mode)
+
+        self.kwargs = kwargs
+
+        class _Dumper(yaml.SafeDumper):
+            pass
+
+        # `Document` (and any other dict subclass) is dumped as a plain dict
+        _Dumper.add_multi_representer(dict, lambda d, data: d.represent_dict(dict(data)))
+        self._dumper = _Dumper
+        self._yaml = yaml
+
+    def read(self) -> Optional[dict[str, dict[str, Any]]]:
+        self._handle.seek(0, os.SEEK_END)
+        if not self._handle.tell():
+            # Empty file: let TinyDB initialize the database
+            return None
+
+        self._handle.seek(0)
+        data = self._yaml.safe_load(self._handle)
+
+        # A file containing only whitespace/comments loads as ``None``
+        return data
+
+    def write(self, data: dict[str, dict[str, Any]]):
+        self._handle.seek(0)
+
+        kwargs = {'default_flow_style': False, **self.kwargs}
+        serialized = self._yaml.dump(data, Dumper=self._dumper, **kwargs)
+
+        try:
+            self._handle.write(serialized)
+        except io.UnsupportedOperation:
+            raise IOError('Cannot write to the database. Access mode is "{0}"'.format(self._mode))
+
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+        self._handle.truncate()
+
+
