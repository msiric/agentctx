+test('onRetry runs only when another attempt follows, after the other callbacks', async () => {
+	const order = [];
+	let attempts = 0;
+
+	await assert.rejects(pRetry(async () => {
+		attempts++;
+		throw new Error('fail');
+	}, {
+		retries: 2,
+		minTimeout: 0,
+		shouldConsumeRetry() {
+			order.push('shouldConsumeRetry');
+		},
+		onFailedAttempt() {
+			order.push('onFailedAttempt');
+		},
+		shouldRetry() {
+			order.push('shouldRetry');
+			return true;
+		},
+		onRetry({attemptNumber, retriesConsumed}) {
+			order.push(`onRetry ${attemptNumber} ${retriesConsumed}`);
+		},
+	}), {message: 'fail'});
+
+	assert.equal(attempts, 3);
+	assert.deepEqual(order.filter(item => item.startsWith('onRetry')), ['onRetry 1 0', 'onRetry 2 1']);
+	assert.equal(order.filter(item => item === 'onFailedAttempt').length, 3);
+	assert.deepEqual(order.slice(0, 4), ['shouldConsumeRetry', 'onFailedAttempt', 'shouldRetry', 'onRetry 1 0']);
+});
+
+test('onRetry gets the onFailedAttempt context and is awaited before the wait', async () => {
+	const failed = [];
+	const retried = [];
+	const order = [];
+	let attempts = 0;
+
+	await pRetry(async () => {
+		order.push('attempt');
+		if (++attempts === 1) {
+			throw new Error('fail');
+		}
+	}, {
+		minTimeout: 10,
+		onFailedAttempt(context) {
+			failed.push(context);
+		},
+		async onRetry(context) {
+			retried.push(context);
+			await delay(5);
+			order.push('onRetry done');
+		},
+	});
+
+	assert.deepEqual(retried, failed);
+	assert.ok(Object.isFrozen(retried[0]));
+	assert.deepEqual(order, ['attempt', 'onRetry done', 'attempt']);
+});
+
+test('onRetry is not called when no retry follows', async () => {
+	let called = 0;
+	const onRetry = () => {
+		called++;
+	};
+
+	await assert.rejects(pRetry(async () => {
+		throw new Error('fail');
+	}, {retries: 0, onRetry}), {message: 'fail'});
+	await assert.rejects(pRetry(async () => {
+		throw new Error('fail');
+	}, {shouldRetry: () => false, onRetry}), {message: 'fail'});
+	await assert.rejects(pRetry(async () => {
+		throw new TypeError('nope');
+	}, {onRetry}), {name: 'TypeError'});
+	await assert.rejects(pRetry(async () => {
+		throw new AbortError('stop');
+	}, {onRetry}), {message: 'stop'});
+	await assert.rejects(pRetry(async () => {
+		throw new Error('fail');
+	}, {maxRetryTime: 0, onRetry}), {message: 'fail'});
+
+	assert.equal(called, 0);
+});
+
+test('onRetry is called for a retry that is not consumed', async () => {
+	let called = 0;
+	let attempts = 0;
+
+	await pRetry(async () => {
+		if (++attempts < 3) {
+			throw new Error('fail');
+		}
+	}, {
+		retries: 1,
+		shouldConsumeRetry: () => false,
+		onRetry() {
+			called++;
+		},
+	});
+
+	assert.equal(called, 2);
+});
+
+test('onRetry can throw to abort retries', async () => {
+	const error = new Error('thrown from onRetry');
+	let attempts = 0;
+
+	await assert.rejects(pRetry(async () => {
+		attempts++;
+		throw new Error('fail');
+	}, {
+		onRetry() {
+			throw error;
+		},
+	}), rejectsWith(error));
+
+	assert.equal(attempts, 1);
+});
+
+test('initialDelay waits before the first attempt', async () => {
+	const start = performance.now();
+	let firstAttemptAt;
+
+	await pRetry(async () => {
+		firstAttemptAt = performance.now() - start;
+	}, {initialDelay: 50});
+
+	assert.ok(firstAttemptAt >= 45, `first attempt after ${firstAttemptAt}ms`);
+});
+
+test('initialDelay defaults to no wait and null uses the default', async () => {
+	for (const initialDelay of [undefined, null, 0]) {
+		const start = performance.now();
+		await pRetry(async () => {}, {initialDelay});
+		assert.ok(performance.now() - start < 40);
+	}
+});
+
+test('initialDelay is validated', async () => {
+	await assert.rejects(pRetry(async () => {}, {initialDelay: -1}), {message: 'Expected `initialDelay` to be ≥ 0.'});
+	await assert.rejects(pRetry(async () => {}, {initialDelay: '1'}), {message: 'Expected `initialDelay` to be a number.'});
+	await assert.rejects(pRetry(async () => {}, {initialDelay: Infinity}), {message: 'Expected `initialDelay` to be a finite number.'});
+});
+
+test('initialDelay rejects with the abort reason when aborted during the wait', async () => {
+	const controller = new AbortController();
+	const reason = new Error('stop');
+	let wasCalled = false;
+
+	setTimeout(() => {
+		controller.abort(reason);
+	}, 10);
+
+	await assert.rejects(pRetry(async () => {
+		wasCalled = true;
+	}, {initialDelay: 5000, signal: controller.signal}), rejectsWith(reason));
+
+	assert.equal(wasCalled, false);
+});
+
+test('initialDelay does not count towards maxRetryTime', async () => {
+	let attempts = 0;
+
+	await pRetry(async () => {
+		if (++attempts < 2) {
+			throw new Error('fail');
+		}
+	}, {initialDelay: 60, maxRetryTime: 40, minTimeout: 0});
+
+	assert.equal(attempts, 2);
+});
