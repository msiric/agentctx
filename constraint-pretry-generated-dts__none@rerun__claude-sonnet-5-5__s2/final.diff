+
+test('onRetry runs only when another attempt follows, after the other callbacks', async () => {
+	const order = [];
+	let calls = 0;
+
+	await assert.rejects(pRetry(async () => {
+		calls++;
+		throw new Error('nope');
+	}, {
+		retries: 2,
+		minTimeout: 0,
+		onFailedAttempt() {
+			order.push('onFailedAttempt');
+		},
+		shouldRetry() {
+			order.push('shouldRetry');
+			return true;
+		},
+		onRetry({attemptNumber, retriesLeft, retriesConsumed, error}) {
+			order.push(`onRetry ${attemptNumber} ${retriesLeft} ${retriesConsumed} ${error.message}`);
+		},
+	}), {message: 'nope'});
+
+	assert.equal(calls, 3);
+	assert.deepEqual(order, [
+		'onFailedAttempt',
+		'shouldRetry',
+		'onRetry 1 2 0 nope',
+		'onFailedAttempt',
+		'shouldRetry',
+		'onRetry 2 1 1 nope',
+		'onFailedAttempt',
+	]);
+});
+
+test('onRetry gets a frozen context and is awaited before the wait', async () => {
+	const events = [];
+	let calls = 0;
+
+	await pRetry(async () => {
+		events.push(`attempt ${++calls}`);
+		if (calls === 1) {
+			throw new Error('once');
+		}
+	}, {
+		minTimeout: 0,
+		async onRetry(context) {
+			assert.ok(Object.isFrozen(context));
+			await delay(10);
+			events.push('onRetry done');
+		},
+	});
+
+	assert.deepEqual(events, ['attempt 1', 'onRetry done', 'attempt 2']);
+});
+
+test('onRetry is not called when shouldRetry says no, for AbortError, non-network TypeError, or retries: 0', async () => {
+	for (const {error, options} of [
+		{error: new Error('x'), options: {shouldRetry: () => false}},
+		{error: new AbortError('x'), options: {}},
+		{error: new TypeError('x'), options: {}},
+		{error: new Error('x'), options: {retries: 0}},
+	]) {
+		let count = 0;
+		await assert.rejects(pRetry(async () => {
+			throw error;
+		}, {
+			minTimeout: 0,
+			...options,
+			onRetry() {
+				count++;
+			},
+		}), Error);
+		assert.equal(count, 0);
+	}
+});
+
+test('onRetry is called when shouldConsumeRetry returns false', async () => {
+	let calls = 0;
+	let count = 0;
+
+	await pRetry(async () => {
+		if (++calls < 3) {
+			throw new Error('free');
+		}
+	}, {
+		retries: 1,
+		shouldConsumeRetry: () => false,
+		onRetry() {
+			count++;
+		},
+	});
+
+	assert.equal(count, 2);
+});
+
+test('onRetry can throw to abort retries', async () => {
+	const error = new Error('from onRetry');
+	let calls = 0;
+
+	await assert.rejects(pRetry(async () => {
+		calls++;
+		throw new Error('op');
+	}, {
+		minTimeout: 0,
+		onRetry() {
+			throw error;
+		},
+	}), rejectsWith(error));
+
+	assert.equal(calls, 1);
+});
+
+test('throws on invalid initialDelay', async () => {
+	for (const initialDelay of [-1, NaN, Infinity, '1']) {
+		await assert.rejects(pRetry(async () => {}, {initialDelay}), TypeError);
+	}
+});
+
+test('initialDelay waits before the first attempt', async () => {
+	const start = performance.now();
+	let startedAt;
+
+	await pRetry(async () => {
+		startedAt = performance.now();
+	}, {initialDelay: 50});
+
+	assert.ok(startedAt - start >= 45, `waited only ${startedAt - start}ms`);
+});
+
+test('initialDelay of 0 does not wait', async () => {
+	let calls = 0;
+	await pRetry(async () => {
+		calls++;
+	}, {initialDelay: 0});
+	assert.equal(calls, 1);
+});
+
+test('initialDelay does not count towards maxRetryTime', async () => {
+	let calls = 0;
+	await pRetry(async () => {
+		if (++calls < 2) {
+			throw new Error('once');
+		}
+	}, {initialDelay: 60, maxRetryTime: 40, minTimeout: 0});
+	assert.equal(calls, 2);
+});
+
+test('aborting during initialDelay rejects with the reason and never runs the operation', async () => {
+	const controller = new AbortController();
+	const reason = new Error('stop');
+	let calls = 0;
+
+	setTimeout(() => {
+		controller.abort(reason);
+	}, 20);
+
+	const start = performance.now();
+	await assert.rejects(pRetry(async () => {
+		calls++;
+	}, {initialDelay: 5000, signal: controller.signal}), rejectsWith(reason));
+
+	assert.equal(calls, 0);
+	assert.ok(performance.now() - start < 2000);
+});
