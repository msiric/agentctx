@@ -216,3 +216,28 @@ export default function prettyBytes(
 	number: number | bigint,
 	options?: Options
 ): string;
+
+/**
+Convert a human readable size string to a number of bytes, the reverse of `prettyBytes`: `'1.5 kB'` → `1500`, `'1.5 KiB'` → `1536`.
+
+Accepts a plain number (`'512'`), or a number followed by `B` or a unit: the SI units `kB`, `MB`, `GB`, `TB`, `PB`, `EB`, `ZB`, `YB` (powers of 1000, with `KB` accepted as an alias for `kB`), or the binary units `KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`, `ZiB`, `YiB` (powers of 1024). Fractional values are allowed, the space before the unit is optional, and units are case-sensitive.
+
+@param string - The string to parse.
+@returns The number of bytes.
+@throws A `TypeError` if the input is not a string, a `SyntaxError` if it cannot be parsed or the unit is unsupported, and a `RangeError` if the result is not finite.
+
+@example
+```
+import {parseBytes} from 'pretty-bytes';
+
+parseBytes('512');
+//=> 512
+
+parseBytes('1.5 kB');
+//=> 1500
+
+parseBytes('1.5 KiB');
+//=> 1536
+```
+*/
+export function parseBytes(string: string): number;
diff --git a/index.js b/index.js
index c5f37ab..5b8a09c 100644
--- a/index.js
+++ b/index.js
@@ -285,3 +285,41 @@ export default function prettyBytes(number, options) {
 	const result = prefix + numberString + separator + UNITS[exponent];
 	return result.padStart(options.fixedWidth ?? 0);
 }
+
+// Units are case-sensitive, the same as the output of `prettyBytes`. The SI units are powers of 1000 and the binary units powers of 1024. `KB` is accepted as an alias for `kB`.
+const PARSE_UNITS = new Map([
+	...BYTE_UNITS.map((unit, exponent) => [unit, 1000 ** exponent]),
+	...BIBYTE_UNITS.map((unit, exponent) => [unit, 1024 ** exponent]),
+	['KB', 1000],
+]);
+
+// `\s` also covers the non-breaking space that `prettyBytes` can output. The space is optional because `prettyBytes` can omit it.
+const BYTES_PATTERN = /^\s*([+-]?(?:\d+\.?\d*|\.\d+))\s*([A-Za-z]*)\s*$/;
+
+export function parseBytes(string) {
+	if (typeof string !== 'string') {
+		throw new TypeError(`Expected a string, got ${typeof string}: ${string}`);
+	}
+
+	const match = BYTES_PATTERN.exec(string);
+
+	if (!match) {
+		throw new SyntaxError(`Unable to parse bytes from: ${JSON.stringify(string)}`);
+	}
+
+	const [, value, unit] = match;
+	const multiplier = PARSE_UNITS.get(unit === '' ? 'B' : unit);
+
+	if (multiplier === undefined) {
+		throw new SyntaxError(`Unsupported unit: ${JSON.stringify(unit)}`);
+	}
+
+	const result = Number(value) * multiplier;
+
+	if (!Number.isFinite(result)) {
+		throw new RangeError(`Value is too large: ${JSON.stringify(string)}`);
+	}
+
+	// Normalize `-0` to `0`, like `prettyBytes` does.
+	return result === 0 ? 0 : result;
+}
