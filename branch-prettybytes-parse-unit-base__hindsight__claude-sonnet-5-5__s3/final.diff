+
+test('parseBytes: plain numbers and bytes', t => {
+	t.is(parseBytes('0'), 0);
+	t.is(parseBytes('512'), 512);
+	t.is(parseBytes('512 B'), 512);
+	t.is(parseBytes('512B'), 512);
+	t.is(parseBytes('  512  B  '), 512);
+	t.is(parseBytes('1.5'), 1.5);
+	t.is(parseBytes('.5 KiB'), 512);
+});
+
+test('parseBytes: binary units', t => {
+	for (const [exponent, unit] of BINARY_UNITS.entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1024 ** exponent);
+		t.is(parseBytes(`2${unit}`), 2 * (1024 ** exponent));
+	}
+
+	t.is(parseBytes('1.5 KiB'), 1536);
+	t.is(parseBytes('0.25 MiB'), 262_144);
+	t.is(parseBytes('1 KiB'), 1024);
+});
+
+test('parseBytes: signs and negative zero', t => {
+	t.is(parseBytes('-1 KiB'), -1024);
+	t.is(parseBytes('+1 KiB'), 1024);
+	t.true(Object.is(parseBytes('-0'), 0));
+});
+
+test('parseBytes: round-trips prettyBytes binary output', t => {
+	for (const bytes of [0, 1, 512, 1024, 1536, 10_240, 5_242_880]) {
+		t.is(parseBytes(prettyBytes(bytes, {binary: true})), bytes);
+	}
+});
+
+test('parseBytes: units are case-sensitive', t => {
+	for (const input of ['1 kib', '1 KIB', '1 kiB', '1 b', '1 mib', '1 Kib']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError});
+	}
+});
+
+test('parseBytes: SI units', t => {
+	for (const [exponent, unit] of DECIMAL_UNITS.entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1000 ** exponent);
+		t.is(parseBytes(`2${unit}`), 2 * (1000 ** exponent));
+	}
+
+	t.is(parseBytes('1 KB'), 1000);
+	t.is(parseBytes('1.5 KB'), 1500);
+	t.is(parseBytes('1.5 kB'), 1500);
+	t.is(parseBytes('1 MB'), 1_000_000);
+});
+
+test('parseBytes: round-trips prettyBytes SI output', t => {
+	for (const bytes of [0, 1, 512, 1000, 1500, 10_000, 5_000_000]) {
+		t.is(parseBytes(prettyBytes(bytes)), bytes);
+	}
+});
+
+test('parseBytes: unknown SI casings are rejected', t => {
+	for (const input of ['1 kb', '1 Kb', '1 mb', '1 gB', '1 Mb', '1 kbit']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError, message: /Unsupported unit/});
+	}
+});
+
+test('parseBytes: throws on invalid input', t => {
+	for (const input of ['', ' ', 'KiB', 'abc', '1..5 KiB', '1.5.5', '1 2 KiB', '1,5 KiB', '1e3', '--1', '1 KiB extra', '1 bits']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError});
+	}
+
+	for (const input of [1, null, undefined, {}, 10n]) {
+		t.throws(() => parseBytes(input), {instanceOf: TypeError});
+	}
+
+	t.throws(() => parseBytes(`1${'0'.repeat(400)}`), {instanceOf: RangeError});
+});
