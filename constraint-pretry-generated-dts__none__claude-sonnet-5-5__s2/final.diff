+	await assert.rejects(pRetry(async () => {
+		index++;
+		throw new Error(`fail ${index}`);
+	}, {
+		retries: 2,
+		minTimeout: 0,
+		onFailedAttempt({attemptNumber}) {
+			calls.push(`failed ${attemptNumber}`);
+		},
+		onRetry({attemptNumber, retriesLeft}) {
+			calls.push(`retry ${attemptNumber} ${retriesLeft}`);
+		},
+	}), {message: 'fail 3'});
+
+	assert.deepEqual(calls, ['failed 1', 'retry 1 2', 'failed 2', 'retry 2 1', 'failed 3']);
+});
+
+test('onRetry runs after shouldRetry and is awaited before the next attempt', async () => {
+	const order = [];
+
+	await pRetry(async attemptNumber => {
+		order.push(`attempt ${attemptNumber}`);
+		if (attemptNumber === 1) {
+			throw new Error('once');
+		}
+	}, {
+		minTimeout: 0,
+		shouldRetry() {
+			order.push('shouldRetry');
+			return true;
+		},
+		async onRetry() {
+			await delay(10);
+			order.push('onRetry');
+		},
+	});
+
+	assert.deepEqual(order, ['attempt 1', 'shouldRetry', 'onRetry', 'attempt 2']);
+});
+
+test('onRetry gets the same context as onFailedAttempt', async () => {
+	let failedContext;
+	let retryContext;
+
+	await pRetry(async attemptNumber => {
+		if (attemptNumber === 1) {
+			throw new Error('once');
+		}
+	}, {
+		minTimeout: 0,
+		onFailedAttempt(context) {
+			failedContext = context;
+		},
+		onRetry(context) {
+			retryContext = context;
+		},
+	});
+
+	assert.equal(retryContext, failedContext);
+	assert.ok(Object.isFrozen(retryContext));
+});
+
