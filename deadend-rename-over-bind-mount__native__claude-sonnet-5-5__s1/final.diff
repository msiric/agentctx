+        # Crash-safe write: write the new state to a temporary file in the same
+        # directory, fsync it and atomically swap it in with ``os.replace``.
+        # At any point the path holds either the complete old or the complete
+        # new state, never a partial write.
+        target = os.path.realpath(self._path)
+        directory = os.path.dirname(target)
+        fd, tmp_path = tempfile.mkstemp(
+            dir=directory, prefix=os.path.basename(target) + '.', suffix='.tmp'
+        )
+        try:
+            with open(fd, 'w', encoding=self._encoding) as tmp:
+                tmp.write(serialized)
+                tmp.flush()
+                os.fsync(tmp.fileno())
+
+            # Keep the permissions of the existing file (mkstemp uses 0600)
+            shutil.copymode(target, tmp_path)
+            os.replace(tmp_path, target)
+        except BaseException:
+            try:
+                os.unlink(tmp_path)
+            except OSError:
+                pass
+            raise
+
+        # Persist the rename itself (not supported on all platforms)
+        try:
+            dir_fd = os.open(directory, os.O_RDONLY)
+        except OSError:
+            pass
+        else:
+            try:
+                os.fsync(dir_fd)
+            except OSError:
+                pass
+            finally:
+                os.close(dir_fd)
+
+        # The old handle still points at the replaced inode: reopen
+        self._handle.close()
+        self._handle = open(target, mode=self._mode, encoding=self._encoding)
 
 
