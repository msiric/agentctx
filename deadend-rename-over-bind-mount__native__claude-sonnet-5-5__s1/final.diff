diff --git a/tests/test_storages.py b/tests/test_storages.py
index 6e433a1..3caea10 100644
--- a/tests/test_storages.py
+++ b/tests/test_storages.py
@@ -285,3 +285,85 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def test_json_write_crash_leaves_old_state(tmpdir, monkeypatch):
+    path = str(tmpdir.join('crash.json'))
+    db = TinyDB(path)
+    db.insert({'a': 1})
+
+    # Simulate the process dying mid-write: the temp file is partially
+    # written and the swap never happens
+    def boom(*args, **kwargs):
+        raise KeyboardInterrupt
+
+    monkeypatch.setattr(os, 'replace', boom)
+    with pytest.raises(KeyboardInterrupt):
+        db.insert({'b': 2})
+    monkeypatch.undo()
+    db.close()
+
+    db = TinyDB(path)
+    assert db.all() == [{'a': 1}]
+    db.close()
+    # no temp files left behind
+    assert os.listdir(str(tmpdir)) == ['crash.json']
+
+
+def test_json_hard_crash_leftover_tmp_file(tmpdir):
+    path = str(tmpdir.join('crash.json'))
+    db = TinyDB(path)
+    db.insert({'a': 1})
+    db.close()
+
+    # A killed process leaves a truncated temp file next to the database
+    with open(path + '.partial.tmp', 'w') as f:
+        f.write('{"_default": {"2": {"b"')
+
+    db = TinyDB(path)
+    assert db.all() == [{'a': 1}]
+    db.close()
+
+
+def test_json_write_failure_during_fsync(tmpdir, monkeypatch):
+    path = str(tmpdir.join('crash.json'))
+    db = TinyDB(path)
+    db.insert({'a': 1})
+
+    def fail(fd):
+        raise OSError('disk full')
+
+    monkeypatch.setattr(os, 'fsync', fail)
+    with pytest.raises(OSError):
+        db.insert({'b': 2})
+    monkeypatch.undo()
+    db.close()
+
+    assert TinyDB(path).all() == [{'a': 1}]
+
+
+def test_json_serialization_error_keeps_file(tmpdir):
+    path = str(tmpdir.join('crash.json'))
+    db = TinyDB(path)
+    db.insert({'a': 1})
+    with pytest.raises(TypeError):
+        db.insert({'b': object()})
+    db.close()
+    assert TinyDB(path).all() == [{'a': 1}]
+
+
+def test_json_write_preserves_permissions_and_symlink(tmpdir):
+    real = tmpdir.join('real.json')
+    link = tmpdir.join('link.json')
+    real.write('')
+    os.chmod(str(real), 0o640)
+    os.symlink(str(real), str(link))
+
+    db = TinyDB(str(link))
+    db.insert({'a': 1})
+    db.insert({'b': 2})
+    db.close()
+
+    assert os.path.islink(str(link))
+    assert os.stat(str(real)).st_mode & 0o777 == 0o640
+    assert len(json.loads(real.read())['_default']) == 2
