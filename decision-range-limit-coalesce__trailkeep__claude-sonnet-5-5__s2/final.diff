@@ -139,6 +145,28 @@ function combineRanges (ranges) {
   return combined
 }
 
+/**
+ * Collapse all ranges into one spanning the lowest start to the highest end.
+ * @private
+ */
+
+function coalesceRanges (ranges) {
+  var start = ranges[0].start
+  var end = ranges[0].end
+
+  for (var i = 1; i < ranges.length; i++) {
+    if (ranges[i].start < start) start = ranges[i].start
+    if (ranges[i].end > end) end = ranges[i].end
+  }
+
+  var coalesced = [{ start: start, end: end }]
+
+  // copy ranges type
+  coalesced.type = ranges.type
+
+  return coalesced
+}
