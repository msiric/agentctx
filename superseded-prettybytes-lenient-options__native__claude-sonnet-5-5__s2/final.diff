 ```
 
+##### significantDigits
+
+Type: `number`\
+Default: `3`
+
+The number of significant digits to round to.
+
+Only applies when neither `minimumFractionDigits` nor `maximumFractionDigits` is set. The integer part is never rounded away, so `123456` bytes with `significantDigits: 2` is still `123 kB`.
+
+Must be an integer between 1 and 100. Any other value is ignored and the default is used.
+
+```js
+import prettyBytes from 'pretty-bytes';
+
+prettyBytes(1337, {significantDigits: 2});
+//=> '1.3 kB'
+
+prettyBytes(1337, {significantDigits: 4});
+//=> '1.337 kB'
+```
+
 ##### space
 
 Type: `boolean`\
diff --git a/test.js b/test.js
index ad268df..dae7e87 100644
--- a/test.js
+++ b/test.js
@@ -1189,3 +1189,25 @@ test('unit option must belong to the active unit system', t => {
 		prettyBytes(10n ** 400n, {unit: 'KiB'});
 	}, {instanceOf: TypeError});
 });
+
+test('significantDigits changes the default rounding', t => {
+	t.is(prettyBytes(1337, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 3}), '1.34 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 1}), '1 kB');
+	t.is(prettyBytes(123_456, {significantDigits: 2}), '123 kB');
+	t.is(prettyBytes(999_999, {significantDigits: 2}), '1 MB');
+	t.is(prettyBytes(1337n, {significantDigits: 4}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4, locale: 'de'}), '1,337 kB');
+});
+
+test('significantDigits is ignored when fraction digit options are set', t => {
+	t.is(prettyBytes(1337, {significantDigits: 2, maximumFractionDigits: 3}), '1.337 kB');
+	t.is(prettyBytes(1900, {significantDigits: 5, minimumFractionDigits: 1}), '1.9 kB');
+});
+
+test('invalid significantDigits is ignored instead of throwing', t => {
+	for (const significantDigits of [0, -1, 1.5, 101, Number.NaN, Number.POSITIVE_INFINITY, '2', null, {}]) {
+		t.is(prettyBytes(1337, {significantDigits}), '1.34 kB');
+	}
+});
