diff --git a/test.js b/test.js
index 7ce0230..aecb1f3 100644
--- a/test.js
+++ b/test.js
@@ -1189,3 +1189,26 @@ test('unit option must belong to the active unit system', t => {
 		prettyBytes(10n ** 400n, {unit: 'KiB'});
 	}, {instanceOf: TypeError});
 });
+
+test('significantDigits option', t => {
+	t.is(prettyBytes(1337, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 3}), '1.34 kB');
+	t.is(prettyBytes(1337, {significantDigits: 1}), '1 kB');
+	t.is(prettyBytes(999_999, {significantDigits: 2}), '1 MB');
+	t.is(prettyBytes(123_456, {significantDigits: 2}), '123 kB');
+	t.is(prettyBytes(1337, {significantDigits: 2, locale: 'de'}), '1,3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 2, bits: true}), '1.3 kbit');
+	t.is(prettyBytes(1337, {significantDigits: 2, unit: 'MB'}), '0.0013 MB');
+});
+
+test('significantDigits is ignored when fraction digits are set', t => {
+	t.is(prettyBytes(1337, {significantDigits: 4, maximumFractionDigits: 1}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 1, minimumFractionDigits: 3}), '1.337 kB');
+});
+
+test('invalid significantDigits falls back to the default', t => {
+	for (const significantDigits of [0, -1, 1.5, 101, Number.NaN, '2', null]) {
+		t.is(prettyBytes(1337, {significantDigits}), '1.34 kB', `${significantDigits}`);
+	}
+});
