+    def pause(self, tag: Hashable) -> None:
+        """
+        Pause all jobs marked with the given tag. Paused jobs are skipped
+        by :meth:`run_pending` until :meth:`resume` is called. Jobs stay
+        registered, and :meth:`run_all` still runs them.
+
+        :param tag: An identifier used to identify a subset of jobs to pause
+        """
+        logger.debug('Pausing jobs with tag: "%s"', tag)
+        for job in self.get_jobs(tag):
+            job.paused = True
+
+    def resume(self, tag: Hashable) -> None:
+        """
+        Resume all paused jobs marked with the given tag. Their next run time
+        is not recomputed, so a job that became due while paused runs on the
+        next :meth:`run_pending` call.
+
+        :param tag: An identifier used to identify a subset of jobs to resume
+        """
+        logger.debug('Resuming jobs with tag: "%s"', tag)
+        for job in self.get_jobs(tag):
+            job.paused = False
