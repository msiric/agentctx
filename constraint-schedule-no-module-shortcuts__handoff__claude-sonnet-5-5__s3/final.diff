diff --git a/test_schedule.py b/test_schedule.py
index f497826..b8e9a20 100644
--- a/test_schedule.py
+++ b/test_schedule.py
@@ -1569,6 +1569,47 @@ class SchedulerTests(TestCase):
         schedule.clear()
         assert len(schedule.jobs) == 0
 
+    def test_get_jobs_for(self):
+        def foo(*args):
+            pass
+
+        def bar():
+            pass
+
+        scheduler = schedule.Scheduler()
+        j1 = scheduler.every().second.do(foo)
+        j2 = scheduler.every().minute.do(foo, 1, 2)
+        j3 = scheduler.every().hour.do(bar)
+
+        assert scheduler.get_jobs_for(foo) == [j1, j2]
+        assert scheduler.get_jobs_for(bar) == [j3]
+        assert scheduler.get_jobs_for(lambda: None) == []
+
+        scheduler.cancel_job(j1)
+        assert scheduler.get_jobs_for(foo) == [j2]
+
+    def test_pause_resume(self):
+        scheduler = schedule.Scheduler()
+        mock_a, mock_b = make_mock_job(name="a"), make_mock_job(name="b")
+        with mock_datetime(2024, 1, 1, 0, 0, 0):
+            scheduler.every().second.do(mock_a).tag("maint")
+            scheduler.every().second.do(mock_b).tag("other")
+            scheduler.pause("maint")
+            assert len(scheduler.jobs) == 2
+        with mock_datetime(2024, 1, 1, 0, 0, 5):
+            scheduler.run_pending()
+            assert mock_a.call_count == 0
+            assert mock_b.call_count == 1
+            scheduler.resume("maint")
+            scheduler.run_pending()
+            assert mock_a.call_count == 1
+            assert mock_b.call_count == 1
+
+    def test_pause_unknown_tag(self):
+        scheduler = schedule.Scheduler()
+        scheduler.pause("nope")
+        scheduler.resume("nope")
+
     def test_clear_by_tag(self):
         every().second.do(make_mock_job(name="job1")).tag("tag1")
         every().second.do(make_mock_job(name="job2")).tag("tag1", "tag2")
