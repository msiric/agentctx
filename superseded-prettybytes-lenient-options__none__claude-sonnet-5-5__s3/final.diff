 //=> '1.92 kB'
 ```
 
+##### significantDigits
+
+Type: `number`\
+Default: `3`
+
+The number of significant digits to round to. Only applies when neither [`minimumFractionDigits`](#minimumfractiondigits) nor [`maximumFractionDigits`](#maximumfractiondigits) is set, as those take over the rounding.
+
+Must be an integer between 1 and 100. Throws a `TypeError` for invalid values. An integer part with more digits than this is never cut short, so `123456` bytes stays `123 kB`.
+
+```js
+import prettyBytes from 'pretty-bytes';
+
+prettyBytes(1337, {significantDigits: 2});
+//=> '1.3 kB'
+
+prettyBytes(1337, {significantDigits: 4});
+//=> '1.337 kB'
+```
+
 ##### space
 
 Type: `boolean`\
diff --git a/test.js b/test.js
index 00d8e96..6d0fd6c 100644
--- a/test.js
+++ b/test.js
@@ -1183,3 +1183,27 @@ test('unit option rejects units outside the active system', t => {
 		t.throws(() => prettyBytes(1, {unit, ...options}), {instanceOf: TypeError}, `${String(unit)} ${JSON.stringify(options)}`);
 	}
 });
+
+test('significantDigits option', t => {
+	t.is(prettyBytes(1337, {significantDigits: 1}), '1 kB');
+	t.is(prettyBytes(1337, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 3}), '1.34 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 10}), '1.337 kB');
+	t.is(prettyBytes(123_456, {significantDigits: 1}), '123 kB');
+	t.is(prettyBytes(999_900, {significantDigits: 2}), '1 MB');
+	t.is(prettyBytes(1337n, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 2, locale: 'de'}), '1,3 kB');
+	t.is(prettyBytes(1337, {significantDigits: undefined}), '1.34 kB');
+});
+
+test('significantDigits option is ignored when fraction digits are set', t => {
+	t.is(prettyBytes(1337, {significantDigits: 2, maximumFractionDigits: 3}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4, minimumFractionDigits: 1, maximumFractionDigits: 1}), '1.3 kB');
+});
+
+test('significantDigits option is validated', t => {
+	for (const significantDigits of [0, -1, 1.5, 101, '3', null, Number.NaN]) {
+		t.throws(() => prettyBytes(1, {significantDigits}), {instanceOf: TypeError}, `${String(significantDigits)}`);
+	}
+});
