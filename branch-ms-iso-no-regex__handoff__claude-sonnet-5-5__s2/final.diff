@@ -0,0 +1,105 @@
+import { describe, expect, it } from '@jest/globals';
+import { formatISO, parseISO } from './index';
+
+describe('parseISO(string)', () => {
+  it('should parse the documented examples', () => {
+    expect(parseISO('PT1H30M')).toBe(5400000);
+    expect(parseISO('P1DT1H1M1S')).toBe(90061000);
+  });
+
+  it('should parse single components', () => {
+    expect(parseISO('PT1S')).toBe(1000);
+    expect(parseISO('PT1M')).toBe(60000);
+    expect(parseISO('PT1H')).toBe(3600000);
+    expect(parseISO('P1D')).toBe(86400000);
+    expect(parseISO('P1W')).toBe(7 * 86400000);
+    expect(parseISO('P1DT1M')).toBe(86400000 + 60000);
+    expect(parseISO('PT0S')).toBe(0);
+  });
+
+  it('should distinguish M in the date and time sections', () => {
+    expect(() => parseISO('P1M')).toThrow();
+    expect(parseISO('PT1M')).toBe(60000);
+  });
+
+  it('should parse fractional seconds', () => {
+    expect(parseISO('PT0.5S')).toBe(500);
+    expect(parseISO('PT0.001S')).toBe(1);
+    expect(parseISO('PT1,5S')).toBe(1500);
+    expect(parseISO('PT1M1.05S')).toBe(61050);
+    expect(parseISO('PT0.5H')).toBe(1800000);
+  });
+
+  it('should round to the nearest millisecond', () => {
+    expect(parseISO('PT0.0004S')).toBe(0);
+    expect(parseISO('PT0.0006S')).toBe(1);
+  });
+
+  it('should support signs', () => {
+    expect(parseISO('-PT1H30M')).toBe(-5400000);
+    expect(parseISO('+PT1H30M')).toBe(5400000);
+    expect(Object.is(parseISO('-PT0S'), 0)).toBe(true);
+  });
+
+  it('should be the inverse of formatISO', () => {
+    for (const n of [
+      0,
+      1,
+      999,
+      1000,
+      1500,
+      61050,
+      5400000,
+      90061001,
+      400 * 86400000,
+      -5400000,
+    ]) {
+      expect(parseISO(formatISO(n))).toBe(n);
+    }
+  });
+
+  it('should reject years and months', () => {
+    expect(() => parseISO('P1Y')).toThrow();
+    expect(() => parseISO('P1M')).toThrow();
+  });
+
+  it('should reject malformed input', () => {
+    for (const bad of [
+      'P',
+      'PT',
+      'P1DT',
+      '1H',
+      'PT1',
+      'PT1X',
+      'pt1h',
+      'PT1H1H',
+      'PT30M1H',
+      'P1D1W',
+      'P1DTT1H',
+      'PT.5S',
+      'PT1.S',
+      'PT-1H',
+      'PT1H ',
+      ' PT1H',
+      'P1H',
+      'PT1D',
+      '--PT1H',
+    ]) {
+      expect(() => parseISO(bad)).toThrow();
+    }
+  });
+
+  it('should throw on empty, overlong or non-string input', () => {
+    expect(() => parseISO('')).toThrow();
+    expect(() => parseISO(`PT${'1'.repeat(100)}S`)).toThrow();
+    // @ts-expect-error testing runtime validation
+    expect(() => parseISO(5)).toThrow();
+  });
+
+  it('should handle pathological input in linear time', () => {
+    const start = Date.now();
+    expect(() => parseISO(`PT${'1'.repeat(90)}`)).toThrow();
+    expect(() => parseISO(`P${'T'.repeat(90)}`)).toThrow();
+    expect(Date.now() - start).toBeLessThan(100);
+  });
+});
