+
+/**
+ * Format the given milliseconds as an ISO 8601 duration string.
+ *
+ * Days are the largest unit used, since months and years are ambiguous.
+ * Sub-second precision is written as a decimal fraction of the seconds
+ * component. Negative values get a leading `-`, and zero is `PT0S`.
+ *
+ * @example formatISO(5400000) // "PT1H30M"
+ * @example formatISO(90061000) // "P1DT1H1M1S"
+ *
+ * @param ms - milliseconds (rounded to the nearest millisecond)
+ * @returns The ISO 8601 duration string
+ */
+export function formatISO(ms: number): string {
+  if (typeof ms !== 'number' || !Number.isFinite(ms)) {
+    throw new Error('Value provided to ms.formatISO() must be of type number.');
+  }
+
+  let rest = Math.round(Math.abs(ms));
+  if (rest === 0) {
+    return 'PT0S';
+  }
+
+  const days = Math.floor(rest / d);
+  rest -= days * d;
+  const hours = Math.floor(rest / h);
+  rest -= hours * h;
+  const minutes = Math.floor(rest / m);
+  rest -= minutes * m;
+  const seconds = Math.floor(rest / s);
+  const millis = rest - seconds * s;
+
+  let time = '';
+  if (hours) time += `${hours}H`;
+  if (minutes) time += `${minutes}M`;
+  if (seconds || millis) {
+    let frac = '';
+    if (millis) {
+      let digits = String(millis).padStart(3, '0');
+      while (digits.endsWith('0')) digits = digits.slice(0, -1);
+      frac = `.${digits}`;
+    }
+    time += `${seconds}${frac}S`;
+  }
+
+  return `${ms < 0 ? '-' : ''}P${days ? `${days}D` : ''}${time ? `T${time}` : ''}`;
+}
+
+/**
+ * Parse an ISO 8601 duration string and return milliseconds. The inverse of
+ * `formatISO`.
+ *
+ * Supports weeks (`W`), days (`D`), hours (`H`), minutes (`M`) and seconds
+ * (`S`), each optionally with a decimal fraction (`.` or `,`), and an optional
+ * leading `+` or `-`. Years and months are rejected because their length is
+ * ambiguous. The result is rounded to the nearest millisecond.
+ *
+ * Implemented as a character scanner (no regular expressions).
+ *
+ * @example parseISO("PT1H30M") // 5400000
+ * @example parseISO("P1DT1H1M1S") // 90061000
+ *
+ * @param str - An ISO 8601 duration
+ * @throws Error if `str` is not a valid (supported) ISO 8601 duration
+ */
+export function parseISO(str: string): number {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw new Error(
+      `Value provided to ms.parseISO() must be a string with length between 1 and 99. value=${JSON.stringify(str)}`,
+    );
+  }
+  const fail = (): never => {
+    throw new Error(
+      `Invalid ISO 8601 duration passed to ms.parseISO(). value=${JSON.stringify(str)}`,
+    );
+  };
+  const isDigit = (c: string) => c >= '0' && c <= '9';
+
+  let i = 0;
+  let sign = 1;
+  if (str[i] === '-' || str[i] === '+') {
+    if (str[i] === '-') sign = -1;
+    i++;
+  }
+  if (str[i] !== 'P') return fail();
+  i++;
+
+  const dateUnits: Record<string, number> = { W: w, D: d };
+  const timeUnits: Record<string, number> = { H: h, M: m, S: s };
+  const dateOrder = ['W', 'D'];
+  const timeOrder = ['H', 'M', 'S'];
+
+  let inTime = false;
+  let total = 0;
+  let components = 0;
+  let lastIndex = -1; // position of the last designator seen in this section
+
+  while (i < str.length) {
+    if (str[i] === 'T') {
+      if (inTime) return fail();
+      inTime = true;
+      lastIndex = -1;
+      i++;
+      // 'T' must be followed by at least one component
+      if (i >= str.length) return fail();
+      continue;
+    }
+
+    // number: digits, optionally followed by a separator and more digits
+    const start = i;
+    let intDigits = 0;
+    while (i < str.length && isDigit(str[i])) {
+      i++;
+      intDigits++;
+    }
+    let fracDigits = 0;
+    if (i < str.length && (str[i] === '.' || str[i] === ',')) {
+      i++;
+      while (i < str.length && isDigit(str[i])) {
+        i++;
+        fracDigits++;
+      }
+      if (fracDigits === 0) return fail();
+    }
+    if (intDigits === 0) return fail();
+    const numStr = str.slice(start, i).replace(',', '.');
+    const value = Number(numStr);
+
+    const designator = str[i];
+    if (designator === undefined) return fail();
+    const units = inTime ? timeUnits : dateUnits;
+    const order = inTime ? timeOrder : dateOrder;
+    const idx = order.indexOf(designator);
+    if (idx === -1 || idx <= lastIndex) return fail(); // unknown or out of order
+    lastIndex = idx;
+    i++;
+
+    total += value * units[designator];
+    components++;
+  }
+
+  if (components === 0) return fail();
+  const result = Math.round(total);
+  return sign * result || 0;
+}
