+
+function _getOrigin(input: unknown): string | undefined {
+  if (typeof input !== "string" || input.includes("\\")) {
+    return undefined;
+  }
+  try {
+    // WHATWG normalizes case and default ports (https://a.com:443 -> https://a.com)
+    const { origin } = new URL(input);
+    return origin === "null" ? undefined : origin;
+  } catch {
+    return undefined;
+  }
+}
+
+/**
+ * Checks if two URLs have the same origin (protocol, hostname and port).
+ *
+ * Default ports are normalized (`https://a.com` equals `https://a.com:443`).
+ * Inputs without an origin (relative, protocol-relative or opaque) never match.
+ *
+ * @group utils
+ */
+export function isSameOrigin(a: string, b: string): boolean {
+  const originA = _getOrigin(a);
+  return originA !== undefined && originA === _getOrigin(b);
+}
