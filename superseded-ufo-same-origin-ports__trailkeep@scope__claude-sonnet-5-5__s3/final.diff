diff --git a/test/same-origin.test.ts b/test/same-origin.test.ts
new file mode 100644
index 0000000..79aec71
--- /dev/null
+++ b/test/same-origin.test.ts
@@ -0,0 +1,119 @@
+import { describe, expect, test } from "vitest";
+import { isSameOrigin } from "../src";
+
+// Proposed semantics (to be agreed before implementing):
+// - origin = protocol + hostname + port (WHATWG-like)
+// - protocol and hostname are case-insensitive
+// - ports are compared strictly as written: no default-port normalization,
+//   so `https://a.com` and `https://a.com:443` are NOT the same origin
+// - path, query, hash and userinfo are ignored
+// - inputs without an origin (relative paths, opaque schemes) never match,
+//   not even against themselves
+
+describe("isSameOrigin", () => {
+  describe("same origin", () => {
+    const cases: [string, string][] = [
+      ["https://example.com", "https://example.com"],
+      ["https://example.com", "https://example.com/"],
+      ["https://example.com/a", "https://example.com/b"],
+      ["https://example.com/a?x=1#h", "https://example.com/b?y=2#g"],
+      ["https://example.com", "https://user:pass@example.com"],
+      ["http://localhost:3000/a", "http://localhost:3000/b"],
+      ["http://[::1]:8080/a", "http://[::1]:8080/b"],
+    ];
+    for (const [a, b] of cases) {
+      test(`${a} ~ ${b}`, () => {
+        expect(isSameOrigin(a, b)).toBe(true);
+        expect(isSameOrigin(b, a)).toBe(true);
+      });
+    }
+  });
+
+  describe("normalization", () => {
+    const cases: [string, string][] = [
+      ["HTTPS://EXAMPLE.COM", "https://example.com"],
+      ["https://Example.com", "https://eXample.COM/path"],
+      ["https://example.com:443", "https://EXAMPLE.com:443/path"],
+    ];
+    for (const [a, b] of cases) {
+      test(`${a} ~ ${b}`, () => {
+        expect(isSameOrigin(a, b)).toBe(true);
+        expect(isSameOrigin(b, a)).toBe(true);
+      });
+    }
+  });
+
+  describe("different origin", () => {
+    const cases: [string, string][] = [
+      // protocol
+      ["http://example.com", "https://example.com"],
+      ["ws://example.com", "http://example.com"],
+      // host
+      ["https://example.com", "https://example.org"],
+      ["https://example.com", "https://www.example.com"],
+      ["https://example.com", "https://example.com.evil.com"],
+      ["https://example.com", "https://evil.com/https://example.com"],
+      // port
+      ["https://example.com", "https://example.com:8443"],
+      // no default-port normalization (explicit port !== omitted port)
+      ["https://example.com", "https://example.com:443"],
+      ["http://example.com", "http://example.com:80"],
+      ["wss://example.com", "wss://example.com:443"],
+      ["ws://example.com", "ws://example.com:80"],
+      ["http://example.com", "https://example.com:80"],
+      ["https://example.com:3000", "https://example.com:3001"],
+      // userinfo trick: real host is evil.com
+      ["https://example.com", "https://example.com@evil.com"],
+      ["https://example.com", "https://example.com:443@evil.com"],
+    ];
+    for (const [a, b] of cases) {
+      test(`${a} !~ ${b}`, () => {
+        expect(isSameOrigin(a, b)).toBe(false);
+        expect(isSameOrigin(b, a)).toBe(false);
+      });
+    }
+  });
+
+  describe("no origin (never same)", () => {
+    const cases: [string, string][] = [
+      // relative / path-only
+      ["/a", "/a"],
+      ["a/b", "a/b"],
+      ["", ""],
+      ["/a", "https://example.com/a"],
+      ["https://example.com/a", "/a"],
+      // opaque origins
+      ["data:text/plain,hi", "data:text/plain,hi"],
+      ["javascript:void(0)", "javascript:void(0)"],
+      ["mailto:a@example.com", "mailto:a@example.com"],
+    ];
+    for (const [a, b] of cases) {
+      test(`${JSON.stringify(a)} !~ ${JSON.stringify(b)}`, () => {
+        expect(isSameOrigin(a, b)).toBe(false);
+      });
+    }
+  });
+
+  describe("protocol-relative", () => {
+    // Open question: no protocol means origin is undetermined, so we say false.
+    test("//example.com vs //example.com", () => {
+      expect(isSameOrigin("//example.com", "//example.com")).toBe(false);
+    });
+    test("//example.com vs https://example.com", () => {
+      expect(isSameOrigin("//example.com", "https://example.com")).toBe(false);
+    });
+  });
+
+  describe("edge cases", () => {
+    test("backslashes are not treated as slashes in the host", () => {
+      expect(isSameOrigin("https://example.com", "https:\\\\example.com")).toBe(
+        false,
+      );
+    });
+    test("undefined / nullish input is false", () => {
+      expect(isSameOrigin(undefined as any, "https://example.com")).toBe(false);
+      expect(isSameOrigin("https://example.com", undefined as any)).toBe(false);
+      expect(isSameOrigin(undefined as any, undefined as any)).toBe(false);
+    });
+  });
+});
