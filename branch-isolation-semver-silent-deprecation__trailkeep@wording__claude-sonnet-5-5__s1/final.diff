 import pytest
 
+from semver import cli as _cli
+
 from semver import (
     cmd_bump,
     cmd_check,
@@ -155,3 +157,30 @@ def test_should_return_documented_error_code_for_invalid_version(cliargs, capsys
     # docs/pysemver.rst shows ``echo $?`` printing 2 for both commands
     assert main(cliargs) == 2
     assert capsys.readouterr().err.startswith("ERROR")
+
+
+@pytest.mark.parametrize("prefix", ["v", "V", ""])
+@pytest.mark.parametrize(
+    "cli,expected",
+    [
+        (["bump", "major", "{v}1.2.3"], "2.0.0"),
+        (["bump", "minor", "{v}1.2.3"], "1.3.0"),
+        (["bump", "patch", "{v}1.2.3"], "1.2.4"),
+        (["bump", "prerelease", "{v}1.2.3-rc.1"], "1.2.3-rc.2"),
+        (["bump", "build", "{v}1.2.3+build.1"], "1.2.3+build.2"),
+        (["compare", "{v}1.2.3", "{v}2.1.3"], "-1"),
+        (["compare", "{v}1.2.3", "1.2.3"], "0"),
+        (["nextver", "{v}1.2.3", "patch"], "1.2.4"),
+        (["check", "{v}1.2.3"], ""),
+    ],
+)
+def test_cli_accepts_leading_v(prefix, cli, expected, capsys):
+    args = [a.format(v=prefix) for a in cli]
+    assert _cli.main(args) == 0
+    assert capsys.readouterr().out.strip() == expected
+
+
+@pytest.mark.parametrize("bad", ["vv1.2.3", "v", "v-1.2.3", "1.2.3v"])
+def test_cli_rejects_malformed_v_prefix(bad, capsys):
+    assert _cli.main(["check", bad]) == 2
+    assert _cli.main(["bump", "major", bad]) == 2
