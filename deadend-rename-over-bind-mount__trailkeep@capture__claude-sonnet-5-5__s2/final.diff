diff --git a/tests/test_storages.py b/tests/test_storages.py
index 6e433a1..fccbfce 100644
--- a/tests/test_storages.py
+++ b/tests/test_storages.py
@@ -285,3 +285,72 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def _crash_at(monkeypatch, storage, where):
+    """Make the storage 'die' (raise) at a given point of write()."""
+    class Crash(BaseException):
+        pass
+
+    if where == 'in_place':
+        def boom(serialized):
+            storage._handle.seek(0)
+            storage._handle.write(serialized[:len(serialized) // 2])
+            storage._handle.flush()
+            raise Crash
+        monkeypatch.setattr(storage, '_write_in_place', boom)
+    elif where == 'journal':
+        def boom(fd):
+            raise Crash
+        monkeypatch.setattr(os, 'fsync', boom)
+    return Crash
+
+
+@pytest.mark.parametrize('where', ['in_place', 'journal'])
+def test_json_crash_safe(tmpdir, monkeypatch, where):
+    path = str(tmpdir.join('db.json'))
+    db = TinyDB(path)
+    db.insert({'a': 1})
+    old = {'_default': {'1': {'a': 1}}}
+
+    crash = _crash_at(monkeypatch, db.storage, where)
+    with pytest.raises(crash):
+        db.insert({'b': 2})
+    monkeypatch.undo()
+
+    if where == 'journal':
+        # Simulate the journal being cut off mid-write
+        with open(path + '.journal', 'w') as f:
+            f.write('deadbeef\n{"_default": {"1"')
+    db.storage._handle.close()
+
+    db2 = TinyDB(path)
+    docs = db2.all()
+    assert docs == [{'a': 1}] or docs == [{'a': 1}, {'b': 2}]
+    if where == 'in_place':
+        assert docs == [{'a': 1}, {'b': 2}]  # journal was complete
+    else:
+        assert docs == [{'a': 1}]
+    assert not os.path.exists(path + '.journal')
+    db2.close()
+
+
+def test_json_truncated_journal_is_ignored(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+    with open(path + '.journal', 'w') as f:
+        f.write('0' * 64 + '\n{"broken')
+    with TinyDB(path) as db:
+        assert db.all() == [{'a': 1}]
+    assert not os.path.exists(path + '.journal')
+
+
+def test_json_write_leaves_no_journal_and_keeps_inode(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+        inode = os.stat(path).st_ino
+        db.insert({'b': 2})
+        assert os.stat(path).st_ino == inode  # written in place
+        assert not os.path.exists(path + '.journal')
