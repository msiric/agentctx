         self._handle = open(path, mode=self._mode, encoding=encoding)
 
+        # Finish or discard a write that was interrupted by a crash
+        self._journal_path = str(path) + '.journal'
+        if self._handle.writable():
+            self._recover()
+
+    def _read_journal(self) -> Optional[str]:
+        """
+        Return the payload of a complete journal, or ``None`` if there is no
+        journal or it was only partially written.
+        """
+        try:
+            with open(self._journal_path, 'r', encoding=self._handle.encoding) as f:
+                content = f.read()
+        except (FileNotFoundError, UnicodeDecodeError):
+            return None
+
+        digest, sep, payload = content.partition('\n')
+        if sep and digest == hashlib.sha256(payload.encode('utf-8')).hexdigest():
+            return payload
+        return None
+
+    def _remove_journal(self) -> None:
+        with contextlib.suppress(FileNotFoundError):
+            os.remove(self._journal_path)
+
+    def _recover(self) -> None:
+        if not os.path.exists(self._journal_path):
+            return
+
+        payload = self._read_journal()
+        if payload is not None:
+            # The journal is complete but the in-place write may not be:
+            # replay it (idempotent)
+            self._write_in_place(payload)
+        # Otherwise the crash happened while the journal was being written,
+        # so the database file is still the untouched old state.
+        self._remove_journal()
+
+    def _write_in_place(self, serialized: str) -> None:
+        self._handle.seek(0)
+        self._handle.write(serialized)
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+
+        # Remove data that is behind the new cursor in case the file has
+        # gotten shorter
+        self._handle.truncate()
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+
     def close(self) -> None:
         self._handle.close()
 
