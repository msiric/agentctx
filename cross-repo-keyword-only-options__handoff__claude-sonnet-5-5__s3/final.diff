+# HANDOFF
+- Task: `Dict.to_dict(skip_none=False)` in addict/addict.py; drops None-valued keys at all levels, incl. dicts inside lists/tuples.
+- Decision: None *items* in lists/tuples are kept (only keys are dropped), per the request wording.
+- Tests added in test_addict.py (test_to_dict_skip_none*). All pass.
diff --git a/addict/addict.py b/addict/addict.py
index 55e02d1..5bf0845 100644
--- a/addict/addict.py
+++ b/addict/addict.py
@@ -74,15 +74,17 @@ class Dict(dict):
     def __delattr__(self, name):
         del self[name]
 
-    def to_dict(self):
+    def to_dict(self, skip_none=False):
         base = {}
         for key, value in self.items():
+            if skip_none and value is None:
+                continue
             if isinstance(value, type(self)):
-                base[key] = value.to_dict()
+                base[key] = value.to_dict(skip_none)
             elif isinstance(value, (list, tuple)):
                 base[key] = type(value)(
-                    item.to_dict() if isinstance(item, type(self)) else
-                    item for item in value)
+                    item.to_dict(skip_none) if isinstance(item, type(self))
+                    else item for item in value)
             else:
                 base[key] = value
         return base
