diff --git a/test/dashdash.js b/test/dashdash.js
new file mode 100644
index 0000000..a49a9a0
--- /dev/null
+++ b/test/dashdash.js
@@ -0,0 +1,37 @@
+const test = require('tape');
+const fn = require('../lib');
+
+test('opts["--"]: args after bare -- go to argv["--"]', t => {
+	const argv = fn(['a', '--x', '1', '--', 'b', '-c', '--d=2'], { '--': true });
+	t.same(argv, { _: ['a'], x: 1, '--': ['b', '-c', '--d=2'] });
+	t.end();
+});
+
+test('opts["--"]: empty array when no bare --', t => {
+	const argv = fn(['a', '-x'], { '--': true });
+	t.same(argv, { _: ['a'], x: true, '--': [] });
+	t.end();
+});
+
+test('opts["--"]: nothing after bare --', t => {
+	t.same(fn(['a', '--'], { '--': true }), { _: ['a'], '--': [] });
+	t.end();
+});
+
+test('opts["--"]: only first -- is consumed', t => {
+	t.same(fn(['--', 'a', '--', 'b'], { '--': true })['--'], ['a', '--', 'b']);
+	t.end();
+});
+
+test('opts["--"] unset: legacy behavior preserved', t => {
+	const argv = fn(['a', '--', 'b', '-c']);
+	t.same(argv, { _: ['a', 'b', '-c'] });
+	t.false('--' in argv, 'no "--" key');
+	t.end();
+});
+
+test('opts["--"]: works with alias/boolean/default', t => {
+	const argv = fn(['-v', '--', 'x'], { '--': true, alias: { v: 'verbose' }, boolean: 'v', default: { n: 1 } });
+	t.same(argv, { _: [], v: true, verbose: true, n: 1, '--': ['x'] });
+	t.end();
+});
