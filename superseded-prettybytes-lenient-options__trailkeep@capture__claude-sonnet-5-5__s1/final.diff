 ```
 
+##### significantDigits
+
+Type: `number`\
+Default: `3`
+
+The number of significant digits to round to.
+
+Only applies when neither [`minimumFractionDigits`](#minimumfractiondigits) nor [`maximumFractionDigits`](#maximumfractiondigits) is set. Must be an integer between 1 and 100; any other value is ignored and the default of 3 is used. A value always keeps its integer digits, so `123456` bytes is still `123 kB` with `significantDigits: 2`.
+
+```js
+import prettyBytes from 'pretty-bytes';
+
+prettyBytes(1337, {significantDigits: 2});
+//=> '1.3 kB'
+
+prettyBytes(1337, {significantDigits: 4});
+//=> '1.337 kB'
+```
+
 ##### minimumFractionDigits
 
 Type: `number`\
diff --git a/test.js b/test.js
index b83f5d2..a9a3b4b 100644
--- a/test.js
+++ b/test.js
@@ -1179,3 +1179,26 @@ test('unit must belong to the active unit system', t => {
 		t.throws(() => prettyBytes(1337, options), {instanceOf: TypeError});
 	}
 });
+
+test('significantDigits', t => {
+	t.is(prettyBytes(1337, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 3}), '1.34 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4}), '1.337 kB');
+	t.is(prettyBytes(1337n, {significantDigits: 4}), '1.337 kB');
+	t.is(prettyBytes(123_456, {significantDigits: 2}), '123 kB');
+	t.is(prettyBytes(999_999, {significantDigits: 1}), '1 MB');
+	t.is(prettyBytes(1337, {significantDigits: 4, binary: true}), '1.306 KiB');
+	t.is(prettyBytes(1337, {significantDigits: 2, locale: 'de'}), '1,3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 1, unit: 'MB'}), '0.001 MB');
+});
+
+test('significantDigits is ignored with fraction digit options', t => {
+	t.is(prettyBytes(1337, {significantDigits: 1, maximumFractionDigits: 2}), '1.33 kB');
+	t.is(prettyBytes(1900, {significantDigits: 5, minimumFractionDigits: 1}), '1.9 kB');
+});
+
+test('invalid significantDigits is ignored', t => {
+	for (const significantDigits of [0, -1, 1.5, 101, Number.NaN, Number.POSITIVE_INFINITY, '4', null, {}, 4n]) {
+		t.is(prettyBytes(1337, {significantDigits}), '1.34 kB');
+	}
+});
