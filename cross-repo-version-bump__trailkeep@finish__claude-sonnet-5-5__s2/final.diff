diff --git a/test/count.js b/test/count.js
new file mode 100644
index 0000000..a87cfe4
--- /dev/null
+++ b/test/count.js
@@ -0,0 +1,41 @@
+const test = require('tape');
+const fn = require('../lib');
+
+test('count :: short group', t => {
+	t.deepEqual(fn(['-vvv'], { count: 'v' }), { _: [], v: 3 });
+	t.deepEqual(fn(['-v'], { count: ['v'] }), { _: [], v: 1 });
+	t.end();
+});
+
+test('count :: repeated long', t => {
+	t.deepEqual(fn(['--verbose', '--verbose'], { count: 'verbose' }), { _: [], verbose: 2 });
+	t.end();
+});
+
+test('count :: does not consume values', t => {
+	t.deepEqual(fn(['-v', 'foo', '-v'], { count: 'v' }), { _: ['foo'], v: 2 });
+	t.end();
+});
+
+test('count :: absent, negated, default', t => {
+	t.deepEqual(fn(['a'], { count: 'v' }), { _: ['a'] });
+	t.deepEqual(fn(['--no-v'], { count: 'v' }), { _: [], v: 0 });
+	t.deepEqual(fn([], { count: 'v', default: { v: 0 } }), { _: [], v: 0 });
+	t.end();
+});
+
+test('count :: alias', t => {
+	const res = fn(['-vv', '--verbose'], { count: 'v', alias: { v: 'verbose' } });
+	t.deepEqual(res, { _: [], v: 3, verbose: 3 });
+	const res2 = fn(['--verbose', '-v'], { count: 'verbose', alias: { v: 'verbose' } });
+	t.deepEqual(res2, { _: [], v: 2, verbose: 2 });
+	t.end();
+});
+
+test('count :: mixed with other flags', t => {
+	t.deepEqual(
+		fn(['-vvx', '--name=a', '-v'], { count: 'v' }),
+		{ _: [], v: 3, x: true, name: 'a' }
+	);
+	t.end();
+});
