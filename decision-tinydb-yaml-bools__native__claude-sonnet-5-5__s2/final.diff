+def test_yaml_storage(tmpdir):
+    pytest.importorskip('yaml')
+
+    path = str(tmpdir.join('test.yaml'))
+    with TinyDB(path, storage=YAMLStorage) as db:
+        assert db.all() == []
+        db.insert(doc)
+        db.insert({'a': 1})
+        db.update({'name': 'foo'}, where('a') == 1)
+        db.remove(where('a') == 1)
+        assert db.all() == [dict(doc)]
+
+    text = tmpdir.join('test.yaml').read()
+    assert '!' not in text
+
+    # Data persists across instances
+    with TinyDB(path, storage=YAMLStorage) as db:
+        assert db.all() == [doc]
+        assert db.get(doc_id=1) == doc
+
+
+def test_yaml_storage_raw(tmpdir):
+    pytest.importorskip('yaml')
+
+    path = str(tmpdir.join('sub', 'test.yaml'))
+    storage = YAMLStorage(path, create_dirs=True)
+    assert storage.read() is None
+    storage.write(doc)
+    assert storage.read() == doc
+    storage.close()
+
+
+def test_yaml_storage_readonly(tmpdir):
+    pytest.importorskip('yaml')
+
+    path = str(tmpdir.join('test.yaml'))
+    YAMLStorage(path).close()
+    storage = YAMLStorage(path, access_mode='r')
+    with pytest.raises(IOError):
+        storage.write(doc)
+    storage.close()
+
