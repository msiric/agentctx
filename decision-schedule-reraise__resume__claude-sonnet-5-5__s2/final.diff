+    def test_run_pending_runs_all_jobs_then_raises_first_exception(self):
+        calls = []
+
+        def failing(name):
+            def job():
+                calls.append(name)
+                raise ValueError(name)
+
+            return job
+
+        with mock_datetime(2010, 1, 6, 12, 15, 0):
+            every().second.do(failing("a"))
+            every().second.do(lambda: calls.append("ok"))
+            every().second.do(failing("b"))
+        with mock_datetime(2010, 1, 6, 12, 15, 1):
+            with self.assertRaisesRegex(ValueError, "a"):
+                schedule.run_pending()
+        assert sorted(calls) == ["a", "b", "ok"]
+
+    def test_failed_job_is_rescheduled(self):
+        def failing():
+            raise ValueError()
+
+        job = every().minute.do(failing)
+        with mock_datetime(2010, 1, 6, 12, 15, 0):
+            job._schedule_next_run()
+        with mock_datetime(2010, 1, 6, 12, 16, 0):
+            with self.assertRaises(ValueError):
+                schedule.run_pending()
+            assert not job.should_run
+            assert job.next_run == datetime.datetime(2010, 1, 6, 12, 17, 0)
+
+    def test_run_all_runs_all_jobs_then_raises(self):
+        mock_job = make_mock_job()
+        every().minute.do(mock_job)
+        every().minute.do(lambda: 1 / 0)
+        every().minute.do(mock_job)
+        with self.assertRaises(ZeroDivisionError):
+            schedule.run_all()
+        assert mock_job.call_count == 2
