+/**
+ * Parse a compound duration such as `"1h 30m"`, `"1h, 30m"` or `"2 days 4 hours"` and
+ * return the total in milliseconds. Each piece is parsed with `parse`.
+ *
+ * @param str - A string made of one or more `<number><unit>` pieces
+ * @returns The summed value in milliseconds
+ * @throws TypeError if `str` is not a string of length 1-99 or any piece can't
+ * be parsed. Never returns `NaN`.
+ */
+export function parseCompound(str: string): number {
+  const invalid = () =>
+    new TypeError(
+      `Value provided to ms.parseCompound() must be a compound duration string such as "1h 30m" with length between 1 and 99. value=${JSON.stringify(str)}`,
+    );
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw invalid();
+  }
+  const first = /\s*(-?\d*\.?\d+ *[a-z]*)/iy;
+  // After the first piece, an optional single comma may separate parts.
+  const rest = /\s*,?\s*(-?\d*\.?\d+ *[a-z]*)/iy;
+  const pieces: string[] = [];
+  let pos = 0;
+  const trimmedEnd = str.trimEnd().length;
+  while (pos < trimmedEnd) {
+    const piece = pieces.length === 0 ? first : rest;
+    piece.lastIndex = pos;
+    const match = piece.exec(str);
+    if (!match) {
+      throw invalid();
+    }
+    pieces.push(match[1] as string);
+    pos = piece.lastIndex;
+  }
+  if (pieces.length === 0) {
+    throw invalid();
+  }
+  let total = 0;
+  for (const p of pieces) {
+    // Unitless pieces are only meaningful on their own (e.g. "100").
+    if (pieces.length > 1 && /\d$/.test(p)) {
+      throw invalid();
+    }
+    const value = parse(p);
+    if (Number.isNaN(value)) {
+      throw invalid();
+    }
+    total += value;
+  }
+  return total;
+}
+
+/**
+ * Parse a timer-style string and return milliseconds. `"m:ss"` (e.g. `"1:30"`)
+ * and `"h:mm:ss"` (e.g. `"01:02:03"`) are supported. Seconds may have a
+ * fractional part (`"1:30.5"`).
+ *
+ * In the `h:mm:ss` form minutes must be 0-59; in both forms seconds must be
+ * 0-59. The leading field (minutes or hours) may be any number of digits.
+ *
+ * @param str - A clock string such as `"1:30"` or `"01:02:03"`
+ * @returns The value in milliseconds
+ * @throws TypeError if `str` is not a valid clock string. Never returns `NaN`.
+ */
+export function parseClock(str: string): number {
+  const invalid = () =>
+    new TypeError(
+      `Value provided to ms.parseClock() must be a string like "m:ss" or "h:mm:ss" with length between 1 and 99. value=${JSON.stringify(str)}`,
+    );
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw invalid();
+  }
+  const match =
+    /^(?:(?<a>\d+):)?(?<b>\d{1,2}):(?<sec>\d{2}(?:\.\d+)?)$/.exec(str);
+  if (!match?.groups) {
+    throw invalid();
+  }
+  const { a, b, sec } = match.groups as {
+    a?: string;
+    b: string;
+    sec: string;
+  };
+  const second = Number(sec);
+  if (second >= 60) {
+    throw invalid();
+  }
+  if (a === undefined) {
+    // m:ss
+    return Number(b) * m + second * s;
+  }
+  // h:mm:ss
+  if (b.length !== 2 || Number(b) >= 60) {
+    throw invalid();
+  }
+  return Number(a) * h + Number(b) * m + second * s;
+}
+
