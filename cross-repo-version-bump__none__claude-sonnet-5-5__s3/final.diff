diff --git a/test/count.js b/test/count.js
new file mode 100644
index 0000000..bdb30da
--- /dev/null
+++ b/test/count.js
@@ -0,0 +1,31 @@
+const test = require('tape');
+const fn = require('../lib');
+
+test('count: short flags', t => {
+	t.same(fn(['-vvv'], { count: 'v' }), { v: 3, _: [] });
+	t.same(fn(['-v', '-v'], { count: ['v'] }), { v: 2, _: [] });
+	t.end();
+});
+
+test('count: long flags', t => {
+	t.same(fn(['--verbose', '--verbose'], { count: 'verbose' }), { verbose: 2, _: [] });
+	t.same(fn(['--verbose'], { count: 'verbose' }), { verbose: 1, _: [] });
+	t.end();
+});
+
+test('count: mixed with other flags and positionals', t => {
+	t.same(fn(['-vxv', '--name', 'bar'], { count: 'v' }), { v: 2, x: true, name: 'bar', _: [] });
+	t.same(fn(['-v', 'foo', '-v'], { count: 'v' }), { v: 2, _: ['foo'] }, 'does not consume next arg');
+	t.end();
+});
+
+test('count: aliases', t => {
+	const argv = fn(['-v', '--verbose', '-vv'], { count: 'v', alias: { v: 'verbose' } });
+	t.same(argv, { v: 4, verbose: 4, _: [] });
+	t.end();
+});
+
+test('count: absent flag is not set', t => {
+	t.same(fn(['a'], { count: 'v' }), { _: ['a'] });
+	t.end();
+});
