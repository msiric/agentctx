diff --git a/tests/test_storages.py b/tests/test_storages.py
index 6e433a1..0f373ef 100644
--- a/tests/test_storages.py
+++ b/tests/test_storages.py
@@ -285,3 +285,50 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def test_json_sorts_keys_by_default(tmpdir):
+    path = str(tmpdir.join('test.db'))
+    storage = JSONStorage(path)
+    storage.write({'b': 1, 'a': {'z': 1, 'y': 2}})
+    storage.close()
+
+    with open(path) as f:
+        assert f.read() == '{"a": {"y": 2, "z": 1}, "b": 1}'
+
+
+def test_json_sort_keys_disabled(tmpdir):
+    path = str(tmpdir.join('test.db'))
+    storage = JSONStorage(path, sort_keys=False)
+    storage.write({'b': 1, 'a': 2})
+    storage.close()
+
+    with open(path) as f:
+        assert f.read() == '{"b": 1, "a": 2}'
+
+
+def test_json_sort_keys_mixed_key_types(tmpdir):
+    path = str(tmpdir.join('test.db'))
+    db = TinyDB(path)
+    db.insert({'hits': {200: 1, 'other': 3}, 'b': 1, 'a': 2})
+    db.close()
+
+    with open(path) as f:
+        assert f.read() == (
+            '{"_default": {"1": {"a": 2, "b": 1, '
+            '"hits": {"200": 1, "other": 3}}}}'
+        )
+
+
+def test_json_mixed_key_types_unsorted(tmpdir):
+    path = str(tmpdir.join('test.db'))
+    storage = JSONStorage(path, sort_keys=False)
+    storage.write({'hits': {200: 1, 'other': 3}})
+    storage.close()
+
+
+def test_json_unserializable_raises(tmpdir):
+    storage = JSONStorage(str(tmpdir.join('test.db')))
+    with pytest.raises(TypeError):
+        storage.write({'a': object()})
+    storage.close()
