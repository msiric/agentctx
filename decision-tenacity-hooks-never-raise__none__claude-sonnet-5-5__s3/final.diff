+def before_sleep_metrics(
+    client: _utils.MetricsClientProtocol,
+    name: str,
+) -> typing.Callable[["RetryCallState"], None]:
+    """Before sleep strategy that increments a ``<name>.retry`` counter.
+
+    Errors raised by the client are logged at debug level and ignored.
+    """
+
+    def incr_it(retry_state: "RetryCallState") -> None:
+        _utils.call_quietly(client.incr, f"{name}.retry")
+
+    return incr_it
