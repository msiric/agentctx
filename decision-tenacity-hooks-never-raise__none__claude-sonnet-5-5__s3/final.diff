+class MetricsClientProtocol(typing.Protocol):
+    """
+    Protocol used by utils expecting a metrics client (eg: before_sleep_metrics).
+
+    Compatible with statsd, datadog, etc...
+    """
+
+    def incr(self, name: str) -> typing.Any: ...
+
+
+def call_quietly(fn: typing.Callable[..., typing.Any], *args: typing.Any) -> None:
+    """
+    Call a logging/metrics side effect without letting it affect the retry.
+
+    Anything the callee raises is logged at debug level and swallowed: losing
+    a log line or a metric is preferable to failing the retried call.
+    """
+    try:
+        fn(*args)
+    except Exception:
+        _logger.debug("Ignoring error from logging/metrics hook", exc_info=True)
+
