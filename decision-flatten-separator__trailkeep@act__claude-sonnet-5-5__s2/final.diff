diff --git a/addict/addict.py b/addict/addict.py
index 55e02d1..409fdb1 100644
--- a/addict/addict.py
+++ b/addict/addict.py
@@ -77,16 +77,32 @@ class Dict(dict):
     def to_dict(self):
         base = {}
         for key, value in self.items():
-            if isinstance(value, type(self)):
-                base[key] = value.to_dict()
-            elif isinstance(value, (list, tuple)):
-                base[key] = type(value)(
-                    item.to_dict() if isinstance(item, type(self)) else
-                    item for item in value)
-            else:
-                base[key] = value
+            base[key] = self._to_plain(value)
         return base
 
+    @classmethod
+    def _to_plain(cls, value):
+        if isinstance(value, cls):
+            return value.to_dict()
+        if isinstance(value, (list, tuple)):
+            return type(value)(cls._to_plain(item) for item in value)
+        return value
+
+    def flatten(self, separator='__'):
+        """Return a plain dict with one entry per leaf value, keyed by the
+        nested keys joined with `separator`. Lists and other non-dict values
+        are leaves. Empty nested dicts have no leaves and are omitted."""
+        flat = {}
+        for key, value in self.items():
+            key = str(key)
+            if isinstance(value, dict):
+                for sub_key, sub_value in type(self)(value).flatten(
+                        separator).items():
+                    flat[key + separator + sub_key] = sub_value
+            else:
+                flat[key] = value
+        return flat
+
     def copy(self):
         return copy.copy(self)
 
diff --git a/test_addict.py b/test_addict.py
