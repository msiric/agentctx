@@ -218,6 +218,32 @@ class AbstractTestsClass(object):
         self.assertIsInstance(regular['a'], tuple)
         self.assertNotIsInstance(regular['a'][0], self.dict_class)
 
+    def test_to_dict_with_nested_sequences(self):
+        prop = self.dict_class(a=[[{'b': 1}]], c=({'d': [({'e': 2},)]},))
+        regular = prop.to_dict()
+        self.assertIsInstance(regular['a'][0], list)
+        self.assertNotIsInstance(regular['a'][0][0], self.dict_class)
+        self.assertIsInstance(regular['c'][0]['d'][0], tuple)
+        self.assertNotIsInstance(regular['c'][0]['d'][0][0], self.dict_class)
+        self.assertEqual(regular, {'a': [[{'b': 1}]],
+                                   'c': ({'d': [({'e': 2},)]},)})
+
+    def test_flatten(self):
+        d = self.dict_class({'db': {'host': 'x', 'port': 1}, 'name': 'n'})
+        flat = d.flatten()
+        self.assertEqual(flat, {'db__host': 'x', 'db__port': 1, 'name': 'n'})
+        self.assertIs(type(flat), dict)
+
+    def test_flatten_deep_and_lists_are_leaves(self):
+        d = self.dict_class(a={'b': {'c': [{'d': 1}, 2]}}, t=(1, 2))
+        self.assertEqual(d.flatten(),
+                         {'a__b__c': [{'d': 1}, 2], 't': (1, 2)})
+
+    def test_flatten_empty_and_custom_separator(self):
+        self.assertEqual(self.dict_class().flatten(), {})
+        d = self.dict_class(a={'b': 1}, e={})
+        self.assertEqual(d.flatten(separator='.'), {'a.b': 1})
+
     def test_update(self):
         old = self.dict_class()
         old.child.a = 'a'
