s=s.rstrip()[:-3].rstrip()+'''

  describe("respectQueryAndFragment", () => {
    const respectTests = {
      "/foo//bar?redirect=//baz": "/foo/bar?redirect=//baz",
      "//foo//bar//?a=//b#//c": "/foo/bar/?a=//b#//c",
      "/foo//bar#//baz?x=//y": "/foo/bar#//baz?x=//y",
      "http://foo.com//a?u=http://x//y":
        "http://foo.com/a?u=http://x//y",
      "?a=//b": "?a=//b",
      "#//a": "#//a",
      "//foo//bar//": "/foo/bar/",
    };

    for (const input in respectTests) {
      test(input, () => {
        expect(cleanDoubleSlashes(input, true)).toBe(respectTests[input]);
      });
    }

    test("default still cleans query and fragment", () => {
      expect(cleanDoubleSlashes("/foo//bar?redirect=//baz#//x")).toBe(
        "/foo/bar?redirect=/baz#/x",
      );
      expect(cleanDoubleSlashes("/foo//bar?redirect=//baz", false)).toBe(
        "/foo/bar?redirect=/baz",
      );
    });
  });
});
'''
open(p,'w').write(s)
E
