+class RunPendingErrorTest:
+    def setup_method(self):
+        schedule.clear()
+
+    def test_other_jobs_run_and_first_error_reraised(self):
+        calls = []
+
+        def bad(n):
+            calls.append(n)
+            raise ValueError(n)
+
+        def good():
+            calls.append("good")
+
+        with mock_datetime(2010, 1, 6, 12, 15):
+            schedule.every().minute.do(bad, 1)
+            schedule.every().minute.do(good)
+            schedule.every().minute.do(bad, 2)
+        with mock_datetime(2010, 1, 6, 12, 17):
+            with pytest.raises(ValueError) as cm:
+                schedule.run_pending()
+        assert cm.value.args == (1,)
+        assert sorted(map(str, calls)) == ["1", "2", "good"]
