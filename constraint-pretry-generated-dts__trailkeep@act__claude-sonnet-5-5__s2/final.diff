@@ -906,3 +906,86 @@ test('unref is not applied unless the option is set', {timeout: 30_000}, async t
 
 	assert.ok(!isUnrefCalled);
 });
+
+test('initialDelay waits before the first attempt only', async t => {
+	const delays = collapseDelays(t);
+	const events = [];
+
+	await assert.rejects(pRetry(async () => {
+		events.push(`attempt:${delays.length}`);
+		throw new Error('fail');
+	}, {
+		retries: 1,
+		minTimeout: 5,
+		initialDelay: 123,
+	}), {message: 'fail'});
+
+	// The initial wait is scheduled before attempt 1, and the retry delay before attempt 2.
+	assert.deepEqual(delays, [123, 5]);
+	assert.deepEqual(events, ['attempt:1', 'attempt:2']);
+});
+
+test('initialDelay of 0 schedules no timer', async t => {
+	const delays = collapseDelays(t);
+
+	assert.equal(await pRetry(async () => 'ok'), 'ok');
+	assert.equal(await pRetry(async () => 'ok', {initialDelay: 0}), 'ok');
+	assert.deepEqual(delays, []);
+});
+
+test('initialDelay does not count toward maxRetryTime', async t => {
+	const originalPerformanceNow = performance.now;
+	const originalSetTimeout = setTimeout;
+	let now = 0;
+
+	// The clock moves by every wait that is scheduled, so a wait counted toward `maxRetryTime` would exhaust it.
+	performance.now = () => now;
+	globalThis.setTimeout = (function_, ms, ...arguments_) => {
+		now += ms;
+		return originalSetTimeout(function_, 0, ...arguments_);
+	};
+
+	t.after(() => {
+		performance.now = originalPerformanceNow;
+		globalThis.setTimeout = originalSetTimeout;
+	});
+
+	let attempts = 0;
+	await pRetry(async () => {
+		attempts++;
+		if (attempts === 1) {
+			throw new Error('fail');
+		}
+	}, {
+		minTimeout: 0,
+		maxRetryTime: 10,
+		initialDelay: 1000,
+	});
+
+	assert.equal(attempts, 2);
+});
+
+test('initialDelay is clamped to the setTimeout maximum', async t => {
+	const delays = collapseDelays(t);
+
+	await pRetry(async () => {}, {initialDelay: 2 ** 40});
+
+	assert.deepEqual(delays, [(2 ** 31) - 1]);
+});
+
+test('signal abort during initialDelay rejects with the reason and never calls input', {timeout: 20_000}, async () => {
+	const controller = new AbortController();
+	let calls = 0;
+
+	setTimeout(() => controller.abort(fixtureError), 50);
+
+	await assert.rejects(pRetry(async () => {
+		calls++;
+	}, {
+		signal: controller.signal,
+		initialDelay: 60_000,
+		unref: true,
+	}), rejectsWith(fixtureError));
+
+	assert.equal(calls, 0);
+});
