@@ -285,3 +285,35 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def test_json_sorts_keys_by_default(tmpdir):
+    path = str(tmpdir.join('test.db'))
+    storage = JSONStorage(path)
+    storage.write({'b': 1, 'a': 2})
+    storage.close()
+    assert open(path).read() == '{"a": 2, "b": 1}'
+
+
+def test_json_sort_keys_can_be_disabled(tmpdir):
+    path = str(tmpdir.join('test.db'))
+    storage = JSONStorage(path, sort_keys=False)
+    storage.write({'b': 1, 'a': 2})
+    storage.close()
+    assert open(path).read() == '{"b": 1, "a": 2}'
+
+
+def test_json_default_sort_tolerates_mixed_key_types(tmpdir):
+    path = str(tmpdir.join('test.db'))
+    storage = JSONStorage(path)
+    storage.write({'t': {200: 'x', 'other': 'y'}})
+    assert storage.read() == {'t': {'200': 'x', 'other': 'y'}}
+    storage.close()
+
+
+def test_json_explicit_sort_keys_mixed_types_raises(tmpdir):
+    path = str(tmpdir.join('test.db'))
+    storage = JSONStorage(path, sort_keys=True)
+    with pytest.raises(TypeError):
+        storage.write({200: 'x', 'other': 'y'})
+    storage.close()
