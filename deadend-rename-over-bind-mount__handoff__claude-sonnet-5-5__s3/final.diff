--- a/tests/test_storages.py
+++ b/tests/test_storages.py
@@ -285,3 +285,84 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def _journal(path):
+    return str(path) + '.journal'
+
+
+def test_json_write_removes_journal(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+        assert not os.path.exists(_journal(path))
+
+
+def test_crash_during_inplace_write_recovers_new_state(tmpdir, monkeypatch):
+    path = str(tmpdir.join('db.json'))
+    db = TinyDB(path)
+    db.insert({'a': 1})
+
+    # Simulate dying mid in-place write: only a prefix reaches the file
+    def torn(self, serialized):
+        self._handle.seek(0)
+        self._handle.write(serialized[:5])
+        self._handle.truncate()
+        self._handle.flush()
+        raise KeyboardInterrupt
+
+    monkeypatch.setattr(JSONStorage, '_write_in_place', torn)
+    with pytest.raises(KeyboardInterrupt):
+        db.insert({'a': 2})
+    monkeypatch.undo()
+    db.storage._handle.close()
+
+    with pytest.raises(ValueError):
+        json.load(open(path))  # main file really is corrupt
+
+    with TinyDB(path) as db2:
+        assert db2.all() == [{'a': 1}, {'a': 2}]
+    assert not os.path.exists(_journal(path))
+
+
+def test_crash_during_journal_write_keeps_old_state(tmpdir, monkeypatch):
+    path = str(tmpdir.join('db.json'))
+    db = TinyDB(path)
+    db.insert({'a': 1})
+
+    def torn(self, serialized):
+        with open(self._journal_path, 'w') as f:
+            f.write(serialized[:5])
+        raise KeyboardInterrupt
+
+    monkeypatch.setattr(JSONStorage, '_write_journal', torn)
+    with pytest.raises(KeyboardInterrupt):
+        db.insert({'a': 2})
+    monkeypatch.undo()
+    db.storage._handle.close()
+
+    with TinyDB(path) as db2:
+        assert db2.all() == [{'a': 1}]
+    assert not os.path.exists(_journal(path))
+
+
+def test_custom_journal_path(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    jp = str(tmpdir.join('elsewhere.wal'))
+    with open(path, 'w') as f:
+        f.write('{"_default": {"1": {"a": 1')  # truncated
+    with open(jp, 'w') as f:
+        json.dump({'_default': {'1': {'a': 1}}}, f)
+
+    with TinyDB(path, journal_path=jp) as db:
+        assert db.all() == [{'a': 1}]
+    assert not os.path.exists(jp)
+
+
+def test_write_does_not_replace_inode(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+        before = os.stat(path).st_ino
+        db.insert({'a': 2})
+        assert os.stat(path).st_ino == before
