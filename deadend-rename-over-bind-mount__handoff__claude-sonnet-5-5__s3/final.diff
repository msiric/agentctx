         # Open the file for reading/writing
         self._handle = open(path, mode=self._mode, encoding=encoding)
 
+        self._encoding = encoding
+        self._journal_path = journal_path if journal_path is not None else os.fspath(path) + '.journal'
+
+        if '+' in self._mode:
+            self._recover()
+
+    def _recover(self) -> None:
+        """
+        Replay a leftover journal from an interrupted write.
+
+        The journal is fully fsynced before the main file is touched, so a
+        journal that parses is the newest complete state. A journal that does
+        not parse was torn while being written, which means the main file was
+        not yet modified and is still intact.
+        """
+        try:
+            with open(self._journal_path, encoding=self._encoding) as journal:
+                content = journal.read()
+        except FileNotFoundError:
+            return
+
+        try:
+            json.loads(content)
+        except ValueError:
+            content = None
+
+        if content is not None:
+            self._write_in_place(content)
+
+        os.remove(self._journal_path)
+
+    def _write_journal(self, serialized: str) -> None:
+        with open(self._journal_path, 'w', encoding=self._encoding) as journal:
+            journal.write(serialized)
+            journal.flush()
+            os.fsync(journal.fileno())
+
+        # Make the journal's directory entry durable (best effort)
+        try:
+            fd = os.open(os.path.dirname(os.path.abspath(self._journal_path)), os.O_RDONLY)
+        except OSError:
+            return
+        try:
+            os.fsync(fd)
+        except OSError:
+            pass
+        finally:
+            os.close(fd)
+
+    def _write_in_place(self, serialized: str) -> None:
+        self._handle.seek(0)
+        self._handle.write(serialized)
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+        self._handle.truncate()
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+
     def close(self) -> None:
         self._handle.close()
 
