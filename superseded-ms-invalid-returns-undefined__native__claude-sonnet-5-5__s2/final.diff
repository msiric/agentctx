+import { describe, expect, it } from '@jest/globals';
+import { parseCompound } from './index';
+
+describe('parseCompound(string)', () => {
+  it('should parse compound short units', () => {
+    expect(parseCompound('1h 30m')).toBe(90 * 60 * 1000);
+    expect(parseCompound('1h30m')).toBe(90 * 60 * 1000);
+  });
+
+  it('should accept commas between pieces', () => {
+    expect(parseCompound('1h, 30m')).toBe(90 * 60 * 1000);
+    expect(parseCompound('1h,30m')).toBe(90 * 60 * 1000);
+    expect(parseCompound('2 days , 4 hours, 1s')).toBe(52 * 3600000 + 1000);
+  });
+
+  it('should parse compound long units', () => {
+    expect(parseCompound('2 days 4 hours')).toBe(52 * 60 * 60 * 1000);
+  });
+
+  it('should handle three or more pieces, decimals and case', () => {
+    expect(parseCompound('1d 2H 3.5s')).toBe(24 * 3600000 + 2 * 3600000 + 3500);
+  });
+
+  it('should behave like parse for a single piece', () => {
+    expect(parseCompound('100')).toBe(100);
+    expect(parseCompound('1m')).toBe(60000);
+  });
+
+  it('should support negative pieces', () => {
+    expect(parseCompound('1h -30m')).toBe(30 * 60 * 1000);
+  });
+
+  it('should throw a TypeError including the input on bad input', () => {
+    for (const bad of [
+      '',
+      'abc',
+      '1h foo',
+      '1h 30m x',
+      '1h 30',
+      '1 30m',
+      '1h 30zz',
+      ',1h',
+      '1h,',
+      '1h,,30m',
+      '1h, 30',
+      '1m '.repeat(40),
+    ]) {
+      expect(() => parseCompound(bad)).toThrow(TypeError);
+      expect(() => parseCompound(bad)).toThrow(JSON.stringify(bad));
+    }
+  });
+
+  it('should throw a TypeError for non-strings', () => {
+    // biome-ignore lint/suspicious/noExplicitAny: testing invalid input
+    expect(() => parseCompound(5 as any)).toThrow(TypeError);
+  });
+});
