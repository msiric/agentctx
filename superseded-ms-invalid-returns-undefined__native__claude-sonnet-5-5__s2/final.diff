+/**
+ * Parse a compound duration such as `"1h 30m"`, `"1h, 30m"` or `"2 days 4 hours"` and
+ * return the total in milliseconds. Each piece is parsed with `parse`.
+ *
+ * Every piece must have a unit, unless the string is a single piece (in which
+ * case this behaves like `parse`).
+ *
+ * @param str - A string of one or more number/unit pieces
+ * @returns The total in milliseconds (never `NaN`)
+ * @throws TypeError if `str` is not a string of 1 to 99 characters or can't be
+ * parsed as a compound duration
+ */
+export function parseCompound(str: string): number {
+  const fail = (): never => {
+    throw new TypeError(
+      `Value provided to ms.parseCompound() must be a valid compound duration string (1 to 99 characters), e.g. "1h 30m". value=${JSON.stringify(str)}`,
+    );
+  };
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    return fail();
+  }
+  // Sticky matching consumes pieces left to right without backtracking.
+  // Pieces may be separated by whitespace and/or a single comma.
+  const first = /\s*(-?\d*\.?\d+ *([a-z]*))/iy;
+  const rest = /\s*,?\s*(-?\d*\.?\d+ *([a-z]*))/iy;
+  const pieces: { text: string; hasUnit: boolean }[] = [];
+  let end = 0;
+  for (;;) {
+    const piece = pieces.length === 0 ? first : rest;
+    piece.lastIndex = end;
+    const match = piece.exec(str);
+    if (!match) {
+      break;
+    }
+    pieces.push({ text: match[1] as string, hasUnit: match[2] !== '' });
+    end = piece.lastIndex;
+  }
+  if (
+    pieces.length === 0 ||
+    str.slice(end).trim() !== '' ||
+    (pieces.length > 1 && pieces.some((p) => !p.hasUnit))
+  ) {
+    return fail();
+  }
+  const total = pieces.reduce((sum, p) => sum + parse(p.text), 0);
+  return Number.isNaN(total) ? fail() : total;
+}
+
+/**
+ * Parse a timer-style clock string and return milliseconds.
+ *
+ * Accepts `m:ss` (e.g. `"1:30"`) and `h:mm:ss` (e.g. `"01:02:03"`). Seconds and
+ * minutes (when preceded by hours) must be two digits and below 60. Seconds may
+ * have a fractional part (e.g. `"1:30.5"`).
+ *
+ * Unlike `parseCompound`, this returns `undefined` on invalid input instead of throwing.
+ *
+ * @param str - A clock string
+ * @returns The duration in milliseconds, or `undefined` if `str` is invalid
+ */
+export function parseClock(str: string): number | undefined {
+  if (typeof str !== 'string' || str.length > 100) {
+    return undefined;
+  }
+  const match = /^(?:(\d+):([0-5]\d)|(\d+)):([0-5]\d(?:\.\d+)?)$/.exec(str.trim());
+  if (!match) {
+    return undefined;
+  }
+  const hours = match[2] !== undefined ? Number(match[1]) : 0;
+  const minutes = match[2] !== undefined ? Number(match[2]) : Number(match[3]);
+  const seconds = Number(match[4]);
+  return ((hours * 60 + minutes) * 60 + seconds) * 1000;
+}
