+import { describe, expect, it } from '@jest/globals';
+import { parseClock } from './index';
+
+describe('parseClock(string)', () => {
+  it('should parse m:ss', () => {
+    expect(parseClock('1:30')).toBe(90000);
+    expect(parseClock('0:05')).toBe(5000);
+    expect(parseClock('75:00')).toBe(75 * 60000);
+  });
+
+  it('should parse h:mm:ss', () => {
+    expect(parseClock('01:02:03')).toBe(3723000);
+    expect(parseClock('1:00:00')).toBe(3600000);
+  });
+
+  it('should parse fractional seconds', () => {
+    expect(parseClock('1:30.5')).toBe(90500);
+  });
+
+  it('should ignore surrounding whitespace', () => {
+    expect(parseClock(' 1:30 ')).toBe(90000);
+  });
+
+  it('should return undefined for invalid input', () => {
+    expect(parseClock('')).toBeUndefined();
+    expect(parseClock('90')).toBeUndefined();
+    expect(parseClock('1:5')).toBeUndefined();
+    expect(parseClock('1:60')).toBeUndefined();
+    expect(parseClock('1:60:00')).toBeUndefined();
+    expect(parseClock('1:2:3:4')).toBeUndefined();
+    expect(parseClock('-1:30')).toBeUndefined();
+    expect(parseClock('a:bc')).toBeUndefined();
+    expect(parseClock('1h')).toBeUndefined();
+  });
+
+  it('should return undefined for non-strings and overlong input', () => {
+    expect(parseClock(undefined as any)).toBeUndefined();
+    expect(parseClock(130 as any)).toBeUndefined();
+    expect(parseClock('1:' + '0'.repeat(100))).toBeUndefined();
+  });
+});
