+def percent(value: NumberOrString, precision: int = 1) -> str:
+    """Format a fraction as a percentage.
+
+    Examples:
+        ```pycon
+        >>> percent(0.125)
+        '12.5%'
+        >>> percent(0.5)
+        '50.0%'
+        >>> percent(1)
+        '100.0%'
+        >>> percent(0.12345, 2)
+        '12.35%'
+        >>> percent(0.5, 0)
+        '50%'
+        >>> percent(0.0625)
+        '6.3%'
+        >>> percent("0.25")
+        '25.0%'
+        >>> percent("foo")
+        'foo'
+        >>> percent(None)
+        'None'
+
+        ```
+
+    Args:
+        value (int, float, str): Fraction to format, where 1 means 100%.
+        precision (int): Number of digits after the decimal point.
+
+    Returns:
+        str: The percentage with a trailing "%". Non-numeric input is returned
+            as a string; NaN and infinities give "NaN", "+Inf" and "-Inf".
+    """
+    import math
+
+    try:
+        value = float(value)
+        if not math.isfinite(value):
+            return _format_not_finite(value)
+    except (ValueError, TypeError):
+        return str(value)
+    # Round half up on the decimal representation, not half-even on the binary
+    # float, so 0.0625 gives "6.3%" rather than "6.2%".
+    from decimal import ROUND_HALF_UP, Decimal
+
+    exact = Decimal(repr(value)) * 100
+    rounded = exact.quantize(Decimal(1).scaleb(-int(precision)), ROUND_HALF_UP)
+    return f"{rounded:f}%"
+
