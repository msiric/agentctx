diff --git a/test/same-origin.test.ts b/test/same-origin.test.ts
new file mode 100644
index 0000000..4d7bdf8
--- /dev/null
+++ b/test/same-origin.test.ts
@@ -0,0 +1,108 @@
+import { describe, expect, test } from "vitest";
+import { isSameOrigin } from "../src";
+
+// Proposed semantics:
+// - Origin = protocol + hostname + port (userinfo, path, query, hash ignored).
+// - Protocol and hostname are compared case-insensitively.
+// - Ports are compared strictly as written: no default-port normalization, so
+//   "https://example.com" and "https://example.com:443" are different origins.
+// - Protocol-relative ("//host") inputs inherit nothing: they have no protocol,
+//   so they only match other protocol-relative inputs with the same host/port.
+// - Inputs without a host (relative paths, "", undefined) never have an origin,
+//   so the result is always false (even when comparing two relative paths).
+// - Opaque origins (mailto:, data:, javascript:, file: without host) are never same-origin.
+
+describe("isSameOrigin", () => {
+  const sameOrigin: [string, string][] = [
+    // Identical
+    ["https://example.com", "https://example.com"],
+    // Path, query, hash are ignored
+    ["https://example.com/foo", "https://example.com/bar"],
+    ["https://example.com/?a=1", "https://example.com/?b=2"],
+    ["https://example.com/#a", "https://example.com/#b"],
+    ["https://example.com", "https://example.com/"],
+    // Userinfo is ignored
+    ["https://user:pass@example.com", "https://example.com"],
+    // Case-insensitive protocol and host
+    ["HTTPS://EXAMPLE.com", "https://example.COM"],
+    // Identical explicit ports (including default ones, written the same way)
+    ["https://example.com:443/a", "https://example.com:443/b"],
+    ["http://example.com:80", "http://example.com:80"],
+    // Explicit non-default ports
+    ["http://localhost:3000", "http://localhost:3000/api"],
+    // Punycode / unicode host
+    ["https://münchen.de", "https://xn--mnchen-3ya.de"],
+    // IPv6
+    ["http://[::1]:8080/a", "http://[::1]:8080/b"],
+    // Protocol-relative on both sides
+    ["//example.com/foo", "//example.com/bar"],
+  ];
+
+  const differentOrigin: [string, string][] = [
+    // Protocol
+    ["http://example.com", "https://example.com"],
+    ["ws://example.com", "wss://example.com"],
+    // Host
+    ["https://example.com", "https://example.org"],
+    // Subdomains are different origins
+    ["https://example.com", "https://www.example.com"],
+    ["https://a.example.com", "https://b.example.com"],
+    // Port
+    ["http://localhost:3000", "http://localhost:4000"],
+    ["http://localhost:3000", "http://localhost"],
+    // Strict ports: no default-port normalization
+    ["https://example.com", "https://example.com:443"],
+    ["http://example.com", "http://example.com:80"],
+    ["http://example.com:80/foo", "http://example.com/bar"],
+    ["wss://example.com", "wss://example.com:443"],
+    ["ws://example.com", "ws://example.com:80"],
+    // Non-default port for the scheme
+    ["http://example.com:443", "http://example.com"],
+    ["https://example.com:80", "https://example.com"],
+    // Userinfo trick must not fool the host comparison
+    ["https://example.com@evil.com", "https://example.com"],
+    // Lookalike suffix
+    ["https://example.com", "https://example.com.evil.com"],
+    // Protocol-relative vs absolute: no protocol to compare
+    ["//example.com", "https://example.com"],
+  ];
+
+  const noOrigin: [string | undefined, string | undefined][] = [
+    // Relative paths have no origin, even if equal
+    ["/foo", "/foo"],
+    ["foo", "foo"],
+    ["", ""],
+    [undefined, undefined],
+    // Relative vs absolute
+    ["/foo", "https://example.com/foo"],
+    ["https://example.com", ""],
+    ["https://example.com", undefined],
+    // Opaque origins
+    ["mailto:a@example.com", "mailto:a@example.com"],
+    ["data:text/plain,hi", "data:text/plain,hi"],
+    ["javascript:alert(1)", "javascript:alert(1)"],
+    ["file:///a", "file:///a"],
+  ];
+
+  for (const [a, b] of sameOrigin) {
+    test(`${a} == ${b}`, () => {
+      expect(isSameOrigin(a, b)).toBe(true);
+      // Symmetric
+      expect(isSameOrigin(b, a)).toBe(true);
+    });
+  }
+
+  for (const [a, b] of differentOrigin) {
+    test(`${a} != ${b}`, () => {
+      expect(isSameOrigin(a, b)).toBe(false);
+      expect(isSameOrigin(b, a)).toBe(false);
+    });
+  }
+
+  for (const [a, b] of noOrigin) {
+    test(`no origin: ${JSON.stringify(a)} vs ${JSON.stringify(b)}`, () => {
+      expect(isSameOrigin(a as any, b as any)).toBe(false);
+      expect(isSameOrigin(b as any, a as any)).toBe(false);
+    });
+  }
+});
