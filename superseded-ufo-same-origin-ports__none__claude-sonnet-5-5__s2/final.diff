+
+const ORIGIN_RE = /^([a-z][\d+.a-z-]*:)?\/\/([^#/?]*)/i;
+
+function _getOrigin(input?: string): string | undefined {
+  if (typeof input !== "string") {
+    return undefined;
+  }
+  const match = input.trim().replace(/\\/g, "/").match(ORIGIN_RE);
+  if (!match) {
+    return undefined;
+  }
+  const protocol = (match[1] || "").toLowerCase();
+  // Strip userinfo (everything up to the last "@")
+  const authority = match[2].slice(match[2].lastIndexOf("@") + 1);
+  const hostMatch =
+    authority.match(/^(\[[^\]]*\])(?::(\d*))?$/) ||
+    authority.match(/^([^:[\]]+)(?::(\d*))?$/);
+  if (!hostMatch) {
+    return undefined;
+  }
+  const rawHost = hostMatch[1].toLowerCase();
+  const hostname = rawHost.startsWith("[") ? rawHost : encodeHost(rawHost);
+  if (!hostname || protocol === "file:") {
+    return undefined;
+  }
+  return `${protocol}//${hostname}${hostMatch[2] ? ":" + hostMatch[2] : ""}`;
+}
+
+/**
+ * Checks whether two URLs have the same origin (protocol, hostname and port).
+ *
+ * Ports are compared as written (no default-port normalization). Inputs without
+ * a host (relative paths, opaque schemes like `mailto:`, `file:`) never match.
+ *
+ * @group utils
+ *
+ * @example
+ *
+ * ```js
+ * isSameOrigin("https://example.com/a", "https://example.com/b"); // true
+ * isSameOrigin("https://example.com", "https://example.com:443"); // false
+ * ```
+ */
+export function isSameOrigin(a?: string, b?: string): boolean {
+  const originA = _getOrigin(a);
+  return originA !== undefined && originA === _getOrigin(b);
+}
