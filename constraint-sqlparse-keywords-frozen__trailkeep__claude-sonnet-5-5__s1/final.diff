diff --git a/tests/test_cli.py b/tests/test_cli.py
index f33b534..522c643 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -235,3 +235,41 @@ def test_cli_outfile_keeps_file_on_format_error(tmpdir, capsys):
     assert out_file.read() == "select 1"
     _, err = capsys.readouterr()
     assert err.startswith("[ERROR] Failed to format")
+
+
+def test_cli_check_reports_files_that_would_change(tmpdir, capsys):
+    changed = tmpdir.join("changed.sql")
+    changed.write("select 1\n")
+    clean = tmpdir.join("clean.sql")
+    clean.write("SELECT 1\n")
+
+    result = sqlparse.cli.main(
+        ['--check', '-k', 'upper', str(changed), str(clean)])
+
+    assert result == 1
+    out, _ = capsys.readouterr()
+    assert out == f"{changed}\n"
+    assert changed.read() == "select 1\n"
+
+
+def test_cli_check_clean_files_exit_zero(tmpdir, capsys):
+    clean = tmpdir.join("clean.sql")
+    clean.write("SELECT 1\n")
+
+    result = sqlparse.cli.main(['--check', '-k', 'upper', str(clean)])
+
+    assert result == 0
+    out, _ = capsys.readouterr()
+    assert out == ""
+
+
+@pytest.mark.parametrize('extra', [['--in-place'], ['-o', 'out.sql']])
+def test_cli_check_rejects_write_options(tmpdir, capsys, extra):
+    test_file = tmpdir.join("test.sql")
+    test_file.write("select 1\n")
+
+    result = sqlparse.cli.main(['--check', str(test_file)] + extra)
+
+    assert result == 1
+    _, err = capsys.readouterr()
+    assert err.startswith("[ERROR] Cannot use --check")
