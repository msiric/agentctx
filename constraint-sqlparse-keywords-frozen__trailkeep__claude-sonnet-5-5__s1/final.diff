@@ -0,0 +1,18 @@
+#
+# This module is part of python-sqlparse and is released under
+# the BSD License: https://opensource.org/licenses/BSD-3-Clause
+
+"""Local keyword additions.
+
+Kept apart from ``keywords.py`` so that file can stay identical to upstream.
+The lexer registers these via ``Lexer.add_keywords()``.
+"""
+
+from sqlparse import tokens
+
+KEYWORDS_LOCAL = {
+    'ASOF': tokens.Keyword,
+    'EXCLUDE': tokens.Keyword,
+    'MATCH_CONDITION': tokens.Keyword,
+    'MATCH_RECOGNIZE': tokens.Keyword,
+}
