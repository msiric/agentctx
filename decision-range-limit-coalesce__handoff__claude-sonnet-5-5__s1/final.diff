index ad2b6cc..5991f5c 100644
--- a/index.js
+++ b/index.js
@@ -90,9 +90,46 @@ function rangeParser (size, str, options) {
     return valid ? -1 : -2
   }
 
-  return options && options.combine
-    ? combineRanges(ranges)
-    : ranges
+  if (options && options.combine) {
+    ranges = combineRanges(ranges)
+  }
+
+  if (options && isValidLimit(options.limit) && ranges.length > options.limit) {
+    ranges = collapseRanges(ranges)
+  }
+
+  return ranges
+}
+
+/**
+ * Check if the limit option is a positive number.
+ * @private
+ */
+
+function isValidLimit (limit) {
+  return typeof limit === 'number' && limit >= 1
+}
+
+/**
+ * Collapse all ranges into one, lowest start to highest end.
+ * @private
+ */
+
+function collapseRanges (ranges) {
+  var start = ranges[0].start
+  var end = ranges[0].end
+
+  for (var i = 1; i < ranges.length; i++) {
+    if (ranges[i].start < start) start = ranges[i].start
+    if (ranges[i].end > end) end = ranges[i].end
+  }
+
+  var collapsed = [{ start: start, end: end }]
+
+  // copy ranges type
+  collapsed.type = ranges.type
+
+  return collapsed
 }
 
