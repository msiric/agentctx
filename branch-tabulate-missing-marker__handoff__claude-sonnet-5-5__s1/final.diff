--- a/test/test_cli.py
+++ b/test/test_cli.py
@@ -256,6 +256,30 @@ SAMPLE_GRID_FORMAT = "\n".join(
 )
 
 
+def test_inprocess_jsonl_skips_blank_lines():
+    """In-process: blank lines in JSONL input are ignored"""
+    text = SAMPLE_INPUT_JSONL.replace("\n", "\n\n") + "\n\n\n"
+    out = run_main_in_process(["-r", "jsonl", "-f", "grid"], input_text=text)
+    assert_equal(out.splitlines(), SAMPLE_GRID_FORMAT.splitlines())
+
+
+def test_inprocess_jsonl_missing_values_default_to_dot():
+    """In-process: absent jsonl keys render as "." (SAS) without extra flags"""
+    text = '{"a": 1, "b": "x"}\n{"a": 2}\n'
+    out = run_main_in_process(["-r", "jsonl", "-f", "tsv"], input_text=text)
+    rows = [[c.strip() for c in line.split("\t")] for line in out.splitlines()]
+    assert_equal(rows, [["a", "b"], ["1", "x"], ["2", "."]])
+
+
+def test_inprocess_jsonl_missingval_option():
+    """In-process: --missingval overrides the jsonl default"""
+    text = '{"a": 1, "b": "x"}\n{"a": 2}\n'
+    out = run_main_in_process(
+        ["-r", "jsonl", "-f", "tsv", "--missingval", "NA"], input_text=text
+    )
+    assert_equal(out.splitlines()[-1].split("\t")[1].strip(), "NA")
+
+
