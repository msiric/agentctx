+/**
+ * Parse a compound duration such as `"1h 30m"`, `"1h, 30m"` or `"2 days 4 hours"` and
+ * return the total in milliseconds. Each piece is parsed with `parse`.
+ *
+ * @param str - A string made of one or more `<number><unit>` pieces
+ * @returns The summed value in milliseconds
+ * @throws TypeError if `str` is not a string of 1 to 99 characters or any part
+ * of it can't be parsed
+ */
+export function parseCompound(str: string): number {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw new TypeError(
+      `Value provided to ms.parseCompound() must be a string with length between 1 and 99. value=${JSON.stringify(str)}`,
+    );
+  }
+  const invalid = () =>
+    new TypeError(
+      `Invalid compound duration provided to ms.parseCompound(). value=${JSON.stringify(str)}`,
+    );
+  // Allow a single comma between parts, e.g. "1h, 30m".
+  const normalized = str.replace(/([a-z])\s*,\s*(?=[-\d.])/gi, '$1 ');
+  const pieces = normalized.match(/-?\d*\.?\d+ *[a-z]*/gi);
+  // Make sure the pieces account for everything but whitespace.
+  if (
+    !pieces ||
+    pieces.join('').replace(/ /g, '') !== normalized.replace(/\s/g, '')
+  ) {
+    throw invalid();
+  }
+  let total = 0;
+  for (const piece of pieces) {
+    const n = parse(piece.trim());
+    if (Number.isNaN(n)) {
+      throw invalid();
+    }
+    total += n;
+  }
+  return total;
+}
+
+/**
+ * Parse a timer-style string and return milliseconds. `"m:ss"` (e.g. `"1:30"`)
+ * and `"h:mm:ss"` (e.g. `"01:02:03"`) are supported. Seconds may have a
+ * fractional part (e.g. `"1:30.5"`).
+ *
+ * @param str - A clock string such as `"1:30"` or `"01:02:03"`
+ * @returns The value in milliseconds
+ * @throws TypeError if `str` is not a string of 1 to 99 characters or isn't a
+ * valid clock string (minutes and seconds must be below 60 when preceded by a
+ * larger unit / in the seconds position)
+ */
+export function parseClock(str: string): number {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw new TypeError(
+      `Value provided to ms.parseClock() must be a string with length between 1 and 99. value=${JSON.stringify(str)}`,
+    );
+  }
+  const match = /^(?:(\d+):)?(\d+):(\d{2}(?:\.\d+)?)$/.exec(str);
+  if (!match) {
+    throw new TypeError(
+      `Invalid clock duration provided to ms.parseClock(). value=${JSON.stringify(str)}`,
+    );
+  }
+  const hours = match[1] === undefined ? 0 : Number(match[1]);
+  const minutes = Number(match[2]);
+  const seconds = Number(match[3]);
+  if (
+    seconds >= 60 ||
+    (match[1] !== undefined && match[2].length !== 2) ||
+    (match[1] !== undefined && minutes >= 60)
+  ) {
+    throw new TypeError(
+      `Invalid clock duration provided to ms.parseClock(). value=${JSON.stringify(str)}`,
+    );
+  }
+  return hours * h + minutes * m + seconds * s;
+}
