+import { describe, expect, it } from '@jest/globals';
+import { parseClock } from './index';
+
+describe('parseClock(string)', () => {
+  it('should parse m:ss', () => {
+    expect(parseClock('1:30')).toBe(90000);
+    expect(parseClock('0:05')).toBe(5000);
+    expect(parseClock('00:45')).toBe(45000);
+  });
+
+  it('should allow minutes above 59 in m:ss', () => {
+    expect(parseClock('90:00')).toBe(5400000);
+  });
+
+  it('should parse h:mm:ss', () => {
+    expect(parseClock('01:02:03')).toBe(3723000);
+    expect(parseClock('1:02:03')).toBe(3723000);
+    expect(parseClock('100:00:00')).toBe(360000000);
+  });
+
+  it('should support fractional seconds', () => {
+    expect(parseClock('1:30.5')).toBe(90500);
+    expect(parseClock('0:00:01.25')).toBe(1250);
+  });
+
+  it('should throw a TypeError including the input for invalid input', () => {
+    for (const bad of [
+      '',
+      '90',
+      '1:3',
+      '1:60',
+      '1:02:60',
+      '1:60:00',
+      '1:2:03',
+      '1:02:03:04',
+      ':30',
+      '1:',
+      '-1:30',
+      '1:30 ',
+      'a:bc',
+    ]) {
+      expect(() => parseClock(bad)).toThrow(TypeError);
+      expect(() => parseClock(bad)).toThrow(JSON.stringify(bad));
+    }
+  });
+
+  it('should throw a TypeError for non-strings and overly long strings', () => {
+    expect(() => parseClock(undefined as any)).toThrow(TypeError);
+    expect(() => parseClock(90 as any)).toThrow(TypeError);
+    expect(() => parseClock('1:' + '0'.repeat(100))).toThrow(TypeError);
+  });
+});
