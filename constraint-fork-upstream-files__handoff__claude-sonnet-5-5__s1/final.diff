diff --git a/test/dashdash.js b/test/dashdash.js
new file mode 100644
index 0000000..8a8c98f
--- /dev/null
+++ b/test/dashdash.js
@@ -0,0 +1,48 @@
+const test = require('tape');
+const fn = require('../lib');
+
+test('opts["--"] :: args after bare -- go to argv["--"]', t => {
+	const out = fn(['foo', '-a', '--', 'bar', '--baz', '-x'], { '--': true });
+	t.same(out._, ['foo']);
+	t.same(out['--'], ['bar', '--baz', '-x']);
+	t.is(out.a, true);
+	t.false('baz' in out);
+	t.end();
+});
+
+test('opts["--"] :: argv["--"] is empty array when no bare --', t => {
+	const out = fn(['foo', '--a', 'b'], { '--': true });
+	t.same(out._, ['foo']);
+	t.same(out['--'], []);
+	t.is(out.a, 'b');
+	t.end();
+});
+
+test('opts["--"] :: unset keeps legacy behavior', t => {
+	const out = fn(['foo', '--', 'bar', '--baz']);
+	t.same(out._, ['foo', 'bar', '--baz']);
+	t.false('--' in out);
+	t.end();
+});
+
+test('opts["--"] :: only first bare -- is consumed', t => {
+	const out = fn(['--', 'a', '--', 'b'], { '--': true });
+	t.same(out._, []);
+	t.same(out['--'], ['a', '--', 'b']);
+	t.end();
+});
+
+test('opts["--"] :: works with alias, boolean, default', t => {
+	const out = fn(['-v', 'x', '--', 'y'], {
+		'--': true,
+		alias: { v: 'verbose' },
+		boolean: 'verbose',
+		default: { n: 1 }
+	});
+	t.is(out.verbose, true);
+	t.is(out.v, true);
+	t.is(out.n, 1);
+	t.same(out._, ['x']);
+	t.same(out['--'], ['y']);
+	t.end();
+});
