+
+test('opts.count', t => {
+	t.deepEqual(fn(['-vvv'], { count: 'v' }), { v: 3, _: [] }, 'short repeated');
+	t.deepEqual(fn(['--verbose', '--verbose'], { count: ['verbose'] }), { verbose: 2, _: [] }, 'long repeated');
+	t.deepEqual(fn(['-v', '-vv', 'foo'], { count: 'v' }), { v: 3, _: ['foo'] }, 'does not consume next arg');
+	t.deepEqual(fn(['-vvx', 'a'], { count: 'v' }), { v: 2, x: 'a', _: [] }, 'mixed with other flags');
+	t.deepEqual(fn(['-vv', '--verbose'], { count: 'v', alias: { v: 'verbose' } }), { v: 3, verbose: 3, _: [] }, 'aliases');
+	t.deepEqual(fn(['--no-verbose'], { count: 'verbose' }), { verbose: 0, _: [] }, 'negated');
+	t.end();
+});
