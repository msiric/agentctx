+    def test_ttl_setter(self):
+        cache = TTLCache[int, int, int](maxsize=4, ttl=10, timer=Timer())
+        cache[1] = 1  # expires at 10
+        cache.ttl = 2
+        self.assertEqual(2, cache.ttl)
+        cache[2] = 2  # expires at 2
+        cache.timer.tick()
+        cache.timer.tick()
+        self.assertEqual(1, cache[1])  # existing item keeps old expiry
+        self.assertNotIn(2, cache)
+        self.assertEqual([(2, 2)], cache.expire())  # not stuck behind key 1
+        self.assertEqual({1}, set(cache))
+        cache.ttl = 20
+        cache[3] = 3  # expires at 22
+        for _ in range(9):
+            cache.timer.tick()
+        self.assertEqual(3, cache[3])
+        self.assertNotIn(1, cache)
