diff --git a/test/same-origin.test.ts b/test/same-origin.test.ts
new file mode 100644
index 0000000..5f0b9a2
--- /dev/null
+++ b/test/same-origin.test.ts
@@ -0,0 +1,116 @@
+import { describe, expect, test } from "vitest";
+import { isSameOrigin } from "../src";
+
+// Proposed semantics: two URLs are same-origin when protocol, hostname and
+// port all match (path, query, hash and credentials are ignored).
+// Default ports are normalized (our CDN rewrites links with an explicit :443):
+// `https://example.com` and `https://example.com:443` ARE same-origin, same for
+// :80 on http.
+// Relative / path-only inputs have no origin, so they are never same-origin
+// with anything (including each other) to stay safe for security checks.
+
+describe("isSameOrigin", () => {
+  describe("same origin", () => {
+    const cases: [string, string][] = [
+      ["https://example.com", "https://example.com"],
+      ["https://example.com", "https://example.com/"],
+      ["https://example.com/a", "https://example.com/b"],
+      ["https://example.com/a?x=1#h", "https://example.com/b?y=2#g"],
+      ["http://example.com:8080/a", "http://example.com:8080/b"],
+      // Default ports are normalized
+      ["https://example.com:443", "https://example.com"],
+      ["http://example.com:80", "http://example.com"],
+      ["https://example.com:443/a", "https://example.com/b"],
+      // Case-insensitive protocol and host
+      ["HTTPS://EXAMPLE.com", "https://example.com"],
+      // Credentials are not part of the origin
+      ["https://user:pass@example.com", "https://example.com"],
+      // Punycode / unicode hosts
+      ["https://münchen.de", "https://xn--mnchen-3ya.de"],
+    ];
+    for (const [a, b] of cases) {
+      test(`${a} ~ ${b}`, () => {
+        expect(isSameOrigin(a, b)).toBe(true);
+        expect(isSameOrigin(b, a)).toBe(true);
+      });
+    }
+  });
+
+  describe("different origin", () => {
+    const cases: [string, string][] = [
+      // Protocol
+      ["http://example.com", "https://example.com"],
+      // Host
+      ["https://example.com", "https://example.org"],
+      // Subdomains are different origins
+      ["https://example.com", "https://www.example.com"],
+      ["https://a.example.com", "https://b.example.com"],
+      // Lookalike hosts
+      ["https://example.com", "https://example.com.evil.com"],
+      ["https://example.com", "https://evilexample.com"],
+      // Port
+      ["https://example.com:8080", "https://example.com"],
+      ["https://example.com:8080", "https://example.com:8081"],
+      ["http://example.com:443", "https://example.com:443"],
+      // A default port only normalizes for its own protocol
+      ["https://example.com:80", "https://example.com"],
+      ["http://example.com:443", "http://example.com"],
+      // Userinfo tricks must not confuse host detection
+      ["https://example.com@evil.com", "https://example.com"],
+      ["https://example.com", "https://evil.com\\@example.com"],
+    ];
+    for (const [a, b] of cases) {
+      test(`${a} !~ ${b}`, () => {
+        expect(isSameOrigin(a, b)).toBe(false);
+        expect(isSameOrigin(b, a)).toBe(false);
+      });
+    }
+  });
+
+  describe("protocol-relative URLs", () => {
+    test("have a host but no protocol: not same-origin with absolute URLs", () => {
+      expect(isSameOrigin("//example.com", "https://example.com")).toBe(false);
+    });
+    test("equal protocol-relative URLs are same-origin", () => {
+      expect(isSameOrigin("//example.com/a", "//example.com/b")).toBe(true);
+    });
+    test("different hosts", () => {
+      expect(isSameOrigin("//example.com", "//example.org")).toBe(false);
+    });
+  });
+
+  describe("relative / path-only inputs", () => {
+    test("two relative paths are not same-origin", () => {
+      expect(isSameOrigin("/a", "/a")).toBe(false);
+      expect(isSameOrigin("a/b", "a/b")).toBe(false);
+    });
+    test("relative vs absolute is not same-origin", () => {
+      expect(isSameOrigin("/a", "https://example.com/a")).toBe(false);
+    });
+  });
+
+  describe("opaque origins", () => {
+    test("non-hierarchical protocols are never same-origin", () => {
+      expect(isSameOrigin("data:text/plain,a", "data:text/plain,a")).toBe(
+        false,
+      );
+      expect(isSameOrigin("javascript:alert(1)", "javascript:alert(1)")).toBe(
+        false,
+      );
+      expect(isSameOrigin("mailto:a@example.com", "mailto:a@example.com")).toBe(
+        false,
+      );
+    });
+  });
+
+  describe("empty / invalid input", () => {
+    test("empty strings", () => {
+      expect(isSameOrigin("", "")).toBe(false);
+      expect(isSameOrigin("", "https://example.com")).toBe(false);
+    });
+    test("undefined / null", () => {
+      expect(isSameOrigin(undefined as any, undefined as any)).toBe(false);
+      expect(isSameOrigin(null as any, "https://example.com")).toBe(false);
+    });
+  });
+});
