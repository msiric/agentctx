+
+/**
+ * Checks whether two URLs have the same origin (protocol, hostname and port).
+ *
+ * Path, query, hash and credentials are ignored. Default ports are normalized
+ * (`https://example.com` and `https://example.com:443` match, same for `:80` on `http:`).
+ *
+ * Inputs without an origin (relative paths, empty values, `data:`, `javascript:`,
+ * `mailto:`, ...) are never same-origin with anything. Protocol-relative URLs
+ * (`//example.com`) are only same-origin with other protocol-relative URLs.
+ *
+ * @example
+ *
+ * ```js
+ * isSameOrigin("https://example.com/a", "https://example.com:443/b"); // true
+ * isSameOrigin("https://example.com", "https://www.example.com"); // false
+ * ```
+ *
+ * @group utils
+ */
+export function isSameOrigin(a: string, b: string): boolean {
+  const originA = _getOrigin(a);
+  const originB = _getOrigin(b);
+  return !!originA && originA === originB;
+}
+
+function _getOrigin(input: string): string | undefined {
+  if (typeof input !== "string" || !input) {
+    return undefined;
+  }
+  try {
+    // Protocol-relative: parse with a placeholder protocol, keep it distinct from absolute URLs
+    const isRelative = PROTOCOL_RELATIVE_REGEX.test(input);
+    const { origin } = new URL(isRelative ? "https:" + input : input);
+    if (!origin || origin === "null") {
+      return undefined;
+    }
+    return isRelative ? "//" + origin.replace(/^https:\/\//, "") : origin;
+  } catch {
+    return undefined;
+  }
+}
