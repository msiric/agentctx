+class TestBeforeSleepMetrics(unittest.TestCase):
+    def test_incr_on_each_retry(self) -> None:
+        class FakeClient:
+            def __init__(self) -> None:
+                self.calls: list[str] = []
+
+            def incr(self, name: str) -> None:
+                self.calls.append(name)
+
+        client = FakeClient()
+
+        @retry(
+            wait=tenacity.wait_none(),
+            stop=tenacity.stop_after_attempt(3),
+            before_sleep=tenacity.before_sleep_metrics(client, "myapp.fetch"),
+            reraise=True,
+        )
+        def _fail() -> None:
+            raise ValueError("boom")
+
+        self.assertRaises(ValueError, _fail)
+        # 3 attempts -> 2 sleeps -> 2 increments
+        self.assertEqual(["myapp.fetch.retry"] * 2, client.calls)
+
+
+class TestHookErrorsAreSwallowed(unittest.TestCase):
+    class Broken:
+        def incr(self, name: str) -> None:
+            raise ConnectionError("agent down")
+
+        def log(self, level: int, msg: str, *args: typing.Any) -> None:
+            raise OSError("log sink down")
+
+    def _run(self, **hooks: typing.Any) -> list[int]:
+        calls: list[int] = []
+
+        @retry(
+            wait=tenacity.wait_none(),
+            stop=tenacity.stop_after_attempt(3),
+            **hooks,
+        )
+        def _flaky() -> str:
+            calls.append(1)
+            if len(calls) < 3:
+                raise ValueError("blip")
+            return "ok"
+
+        self.assertEqual("ok", _flaky())
+        return calls
+
+    def test_metrics_client_errors_do_not_affect_retry(self) -> None:
+        hook = tenacity.before_sleep_metrics(self.Broken(), "payments")
+        with self.assertLogs("tenacity", level="DEBUG") as logs:
+            self.assertEqual(3, len(self._run(before_sleep=hook)))
+        self.assertEqual(2, len(logs.records))
+
+    def test_logger_errors_do_not_affect_retry(self) -> None:
+        broken = self.Broken()
+        self._run(
+            before=tenacity.before_log(broken, logging.INFO),
+            after=tenacity.after_log(broken, logging.INFO),
+            before_sleep=tenacity.before_sleep_log(broken, logging.INFO),
+        )
+
