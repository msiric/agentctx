+@contextlib.contextmanager
+def swallow_hook_errors(hook: str) -> typing.Iterator[None]:
+    """
+    Keep a failing logging/metrics hook from affecting the retried call.
+
+    Anything the hook raises (``Exception`` only, so ``KeyboardInterrupt`` and
+    friends still propagate) is logged at debug level and dropped: losing a log
+    line or a metric is better than turning a retryable error into a failure.
+    """
+    try:
+        yield
+    except Exception:
+        _logger.debug("Ignoring error raised by %s", hook, exc_info=True)
+
