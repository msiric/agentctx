+def before_sleep_metrics(
+    client: _utils.MetricsClientProtocol,
+    name: str,
+) -> typing.Callable[["RetryCallState"], None]:
+    """
+    Before sleep strategy that increments the ``<name>.retry`` counter.
+
+    Errors raised by the client are logged at debug level and ignored, so a
+    broken metrics backend never affects the retried call.
+    """
+
+    def incr_it(retry_state: "RetryCallState") -> None:
+        with _utils.swallow_hook_errors("before_sleep_metrics"):
+            client.incr(f"{name}.retry")
+
+    return incr_it
