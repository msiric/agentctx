+class TestStatsHook(unittest.TestCase):
+    def _flaky(self, **kw: typing.Any) -> tuple[list[dict[str, typing.Any]], str]:
+        seen: list[dict[str, typing.Any]] = []
+        calls: list[int] = []
+
+        @retry(wait=tenacity.wait_none(), stats_hook=seen.append, **kw)
+        def f() -> str:
+            calls.append(1)
