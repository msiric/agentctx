+def test_yaml_hand_edited_bools_are_strings(tmpdir):
+    path = tmpdir.join('test.yaml')
+    path.write('_default:\n  1: {a: NO, b: yes, c: off, d: On, e: true, f: false, g: y}\n')
+    storage = YAMLStorage(str(path))
+    assert storage.read() == {
+        '_default': {1: {'a': 'NO', 'b': 'yes', 'c': 'off', 'd': 'On',
+                         'e': True, 'f': False, 'g': 'y'}}
+    }
+    storage.close()
+
+
+def test_yaml_string_bools_roundtrip(tmpdir):
+    path = str(tmpdir.join('test.yaml'))
+    data = {'_default': {'1': {'a': 'NO', 'b': 'yes', 'c': 'true', 'd': True}}}
+    storage = YAMLStorage(path)
+    storage.write(data)
+    assert storage.read() == data
+    storage.close()
+
