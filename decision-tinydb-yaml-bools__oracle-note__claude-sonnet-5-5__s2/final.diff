+class YAMLStorage(_FileStorage):
+    """
+    Store the data in a YAML file.
+
+    Requires PyYAML. Only ``true`` and ``false`` are read as booleans, so
+    hand-edited values like ``NO``, ``yes``, ``off`` or ``On`` stay strings.
+    """
+
+    def __init__(self, path: str, create_dirs=False, encoding=None, access_mode='r+', **kwargs):
+        """
+        Create a new instance.
+
+        See :class:`_FileStorage` for the file handling arguments.
+
+        :param path: Where to store the YAML data.
+        :param kwargs: Passed to ``yaml.safe_dump`` on every write.
+        """
+
+        try:
+            import yaml
+        except ImportError as e:  # pragma: no cover
+            raise ImportError('YAMLStorage requires PyYAML (pip install pyyaml)') from e
+
+        super().__init__(path, create_dirs=create_dirs, encoding=encoding, access_mode=access_mode)
+
+        self._yaml = yaml
+        self._loader = _strict_bool_loader(yaml)
+        self.kwargs = kwargs
+
+    def read(self) -> Optional[dict[str, dict[str, Any]]]:
+        self._handle.seek(0)
+        data = self._yaml.load(self._handle, Loader=self._loader)
+
+        # Empty file (or only comments/whitespace): let TinyDB initialize
+        return data if data else None
+
+    def write(self, data: dict[str, dict[str, Any]]):
+        self._handle.seek(0)
+
+        kwargs = {'default_flow_style': False, 'allow_unicode': True, **self.kwargs}
+        serialized = self._yaml.safe_dump(data, **kwargs)
+
+        try:
+            self._handle.write(serialized)
+        except io.UnsupportedOperation:
+            raise IOError('Cannot write to the database. Access mode is "{0}"'.format(self._mode))
+
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+        self._handle.truncate()
+
+
+def _strict_bool_loader(yaml):
+    """
+    Build a ``SafeLoader`` subclass where only ``true``/``false`` are booleans.
+    """
+
+    import re
+
+    class StrictBoolLoader(yaml.SafeLoader):
+        pass
+
+    # Copy the resolver table so we don't modify ``SafeLoader`` itself
+    StrictBoolLoader.yaml_implicit_resolvers = {
+        ch: [(tag, rx) for tag, rx in resolvers if tag != 'tag:yaml.org,2002:bool']
+        for ch, resolvers in yaml.SafeLoader.yaml_implicit_resolvers.items()
+    }
+    StrictBoolLoader.add_implicit_resolver(
+        'tag:yaml.org,2002:bool', re.compile(r'^(?:true|false)$'), list('tf')
+    )
+
+    return StrictBoolLoader
+
