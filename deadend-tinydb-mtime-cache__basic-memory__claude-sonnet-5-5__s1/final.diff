@@ -119,10 +119,32 @@ class JSONStorage(Storage):
         # Open the file for reading/writing
         self._handle = open(path, mode=self._mode, encoding=encoding)
 
+        # Parsed contents of the file together with the file signature they
+        # were parsed from. Lets repeated reads skip re-parsing the JSON as
+        # long as the file hasn't been modified (by us or another process).
+        self._cache: Optional[tuple[tuple, Any]] = None
+
+    def _signature(self) -> tuple:
+        # Taken from the open handle, so it describes the file we read from.
+        # Any write by another process changes mtime and/or size.
+        st = os.fstat(self._handle.fileno())
+        return st.st_mtime_ns, st.st_ctime_ns, st.st_size, st.st_ino
+
+    def invalidate_cache(self) -> None:
+        """
+        Drop the cached file contents so the next read parses the file again.
+        """
+        self._cache = None
+
     def close(self) -> None:
         self._handle.close()
 
     def read(self) -> Optional[dict[str, dict[str, Any]]]:
+        signature = self._signature()
+
+        if self._cache is not None and self._cache[0] == signature:
+            return self._cache[1]
+
         # Get the file size by moving the cursor to the file end and reading
         # its location
         self._handle.seek(0, os.SEEK_END)
@@ -131,15 +153,22 @@ class JSONStorage(Storage):
         if not size:
             # File is empty, so we return ``None`` so TinyDB can properly
             # initialize the database
+            self._cache = None
             return None
         else:
             # Return the cursor to the beginning of the file
             self._handle.seek(0)
 
             # Load the JSON contents of the file
-            return json.load(self._handle)
+            data = json.load(self._handle)
+            self._cache = (signature, data)
+            return data
 
     def write(self, data: dict[str, dict[str, Any]]):
+        # The caller still holds (and may keep mutating) ``data``, so don't
+        # keep it as the cache; the next read re-parses once.
+        self._cache = None
+
         # Move the cursor to the beginning of the file just in case
         self._handle.seek(0)
 
