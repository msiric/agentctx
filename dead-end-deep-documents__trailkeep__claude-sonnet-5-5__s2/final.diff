--- a/xmltodict.py
+++ b/xmltodict.py
@@ -558,6 +558,31 @@ def _emit(key, value, content_handler,
             content_handler.ignorableWhitespace(newl)
 
 
+def drop_keys(doc, names):
+    """Return a copy of ``doc`` with every key in ``names`` removed at any depth.
+
+    Keys are matched exactly, so attribute keys must include their prefix
+    (e.g. ``'@id'``). Dicts nested in lists are handled too. The input is
+    never mutated; containers are rebuilt, leaf values are shared.
+    """
+    if isinstance(names, str):
+        names = (names,)
+    names = frozenset(names)
+
+    def walk(node):
+        if isinstance(node, dict):
+            items = [(k, walk(v)) for k, v in node.items() if k not in names]
+            try:
+                return type(node)(items)
+            except TypeError:  # e.g. defaultdict needs a factory
+                return dict(items)
+        if isinstance(node, list):
+            return [walk(v) for v in node]
+        return node
+
+    return walk(doc)
+
+
 class _XMLGenerator(XMLGenerator):
     def comment(self, text):
         text = _validate_comment(text)
