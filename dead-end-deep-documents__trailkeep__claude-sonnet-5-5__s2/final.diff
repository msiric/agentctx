new file mode 100644
index 0000000..b6a4332
--- /dev/null
+++ b/tests/test_drop_keys.py
@@ -0,0 +1,66 @@
+import copy
+from collections import OrderedDict
+
+from xmltodict import drop_keys, parse
+
+
+def test_drops_top_level_and_nested_keys():
+    doc = {"a": {"b": "1", "c": {"b": "2", "d": "3"}}, "b": "4"}
+    assert drop_keys(doc, ["b"]) == {"a": {"c": {"d": "3"}}}
+
+
+def test_drops_attribute_keys():
+    doc = parse('<r id="1"><i id="2" n="x">t</i><i id="3"/></r>')
+    assert drop_keys(doc, ["@id"]) == {"r": {"i": [{"@n": "x", "#text": "t"}, {}]}}
+
+
+def test_recurses_into_lists_of_dicts_and_nested_lists():
+    doc = {"a": [{"x": 1, "y": 2}, [{"x": 3, "z": 4}], "s"]}
+    assert drop_keys(doc, {"x"}) == {"a": [{"y": 2}, [{"z": 4}], "s"]}
+
+
+def test_does_not_mutate_input():
+    doc = {"a": {"@id": "1", "b": [{"@id": "2", "c": "x"}]}}
+    snapshot = copy.deepcopy(doc)
+    result = drop_keys(doc, ["@id"])
+    assert doc == snapshot
+    assert result is not doc
+    assert result["a"] is not doc["a"]
+    assert result["a"]["b"] is not doc["a"]["b"]
+
+
+def test_no_matching_names_returns_equal_copy():
+    doc = {"a": [{"b": "1"}]}
+    result = drop_keys(doc, ["zzz"])
+    assert result == doc and result is not doc
+
+
+def test_empty_names_and_empty_doc():
+    assert drop_keys({"a": "1"}, []) == {"a": "1"}
+    assert drop_keys({}, ["a"]) == {}
+
+
+def test_string_names_is_single_name_not_characters():
+    doc = {"id": "1", "i": "2", "d": "3"}
+    assert drop_keys(doc, "id") == {"i": "2", "d": "3"}
+
+
+def test_matching_is_exact_and_prefix_sensitive():
+    doc = {"@id": "1", "id": "2"}
+    assert drop_keys(doc, ["id"]) == {"@id": "1"}
+
+
+def test_values_are_not_matched_only_keys():
+    assert drop_keys({"a": "b"}, ["b"]) == {"a": "b"}
+
+
+def test_non_container_input_returned_as_is():
+    assert drop_keys("text", ["a"]) == "text"
+    assert drop_keys(None, ["a"]) is None
+
+
+def test_preserves_dict_subclass_and_order():
+    doc = OrderedDict([("a", OrderedDict([("x", 1), ("b", 2), ("c", 3)]))])
+    result = drop_keys(doc, ["x"])
+    assert isinstance(result, OrderedDict)
+    assert list(result["a"].items()) == [("b", 2), ("c", 3)]
