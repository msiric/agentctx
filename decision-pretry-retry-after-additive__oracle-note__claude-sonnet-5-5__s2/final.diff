+
+test('context has elapsedTime in all callbacks', async () => {
+	const seen = {shouldConsumeRetry: [], onFailedAttempt: [], shouldRetry: []};
+	const record = name => ({elapsedTime}) => {
+		seen[name].push(elapsedTime);
+		return true;
+	};
+
+	await assert.rejects(pRetry(async () => {
+		await delay(20);
+		throw new Error('fail');
+	}, {
+		retries: 2,
+		minTimeout: 30,
+		factor: 1,
+		shouldConsumeRetry: record('shouldConsumeRetry'),
+		onFailedAttempt: record('onFailedAttempt'),
+		shouldRetry: record('shouldRetry'),
+	}), {message: 'fail'});
+
+	assert.equal(seen.shouldConsumeRetry.length, 3);
+	assert.equal(seen.onFailedAttempt.length, 3);
+	assert.equal(seen.shouldRetry.length, 2);
+
+	for (const values of Object.values(seen)) {
+		for (const value of values) {
+			assert.equal(typeof value, 'number');
+		}
+
+		// Each attempt takes at least 20ms, and every retry waits at least 30ms. Timers can fire a little early, hence the slack.
+		assert.ok(values[0] >= 15);
+		assert.ok(values.every((value, index) => index === 0 || value > values[index - 1]));
+	}
+
+	assert.ok(seen.onFailedAttempt[2] >= 120);
+});
+
+test('elapsedTime is measured from when pRetry was called', async () => {
+	const originalPerformanceNow = performance.now;
+	let now = 1000;
+	performance.now = () => now;
+
+	try {
+		let elapsed;
+		await assert.rejects(pRetry(async () => {
+			now += 50;
+			throw new Error('fail');
+		}, {
+			retries: 0,
+			onFailedAttempt({elapsedTime}) {
+				elapsed = elapsedTime;
+			},
+		}), {message: 'fail'});
+
+		assert.equal(elapsed, 50);
+	} finally {
+		performance.now = originalPerformanceNow;
+	}
+});
+
+test('retryAfter (seconds) is added to the backoff', async () => {
+	const delays = [];
+	const starts = [];
+	await pRetry(async attempt => {
+		starts.push(performance.now());
+		if (attempt === 1) {
+			throw Object.assign(new Error('rate limited'), {retryAfter: 0.1});
+		}
+	}, {
+		retries: 1,
+		minTimeout: 30,
+		onFailedAttempt({retryDelay}) {
+			delays.push(retryDelay);
+		},
+	});
+
+	// 100ms from `retryAfter` plus 30ms of backoff. Not max(), which would be 100ms.
+	assert.deepEqual(delays, [130]);
+	assert.ok(starts[1] - starts[0] >= 125);
+});
+
+test('retryAfter is added to the backoff on later retries too', async () => {
+	const delays = [];
+	await assert.rejects(pRetry(async () => {
+		throw Object.assign(new Error('rate limited'), {retryAfter: 0.01});
+	}, {
+		retries: 2,
+		minTimeout: 10,
+		factor: 2,
+		onFailedAttempt({retryDelay}) {
+			delays.push(retryDelay);
+		},
+	}), {message: 'rate limited'});
+
+	assert.deepEqual(delays, [20, 30, 0]);
+});
+
+test('retryAfter is not capped by maxTimeout, which only bounds the backoff', async () => {
+	const delays = [];
+	await assert.rejects(pRetry(async () => {
+		throw Object.assign(new Error('rate limited'), {retryAfter: 0.05});
+	}, {
+		retries: 1,
+		minTimeout: 10,
+		maxTimeout: 10,
+		onFailedAttempt({retryDelay}) {
+			delays.push(retryDelay);
+		},
+	}), {message: /fail|rate limited/v});
+
+	assert.deepEqual(delays, [60, 0]);
+});
+
+test('retryAfter applies even when minTimeout is 0', async () => {
+	const delays = [];
+	await assert.rejects(pRetry(async () => {
+		throw Object.assign(new Error('rate limited'), {retryAfter: 0.02});
+	}, {
+		retries: 1,
+		minTimeout: 0,
+		onFailedAttempt({retryDelay}) {
+			delays.push(retryDelay);
+		},
+	}), {message: /fail|rate limited/v});
+
+	assert.deepEqual(delays, [20, 0]);
+});
+
+test('an invalid retryAfter is ignored', async () => {
+	for (const retryAfter of ['5', NaN, -1, 0, Infinity, null, undefined, {}]) {
+		const delays = [];
+
+		await assert.rejects(pRetry(async () => {
+			throw Object.assign(new Error('fail'), {retryAfter});
+		}, {
+			retries: 1,
+			minTimeout: 5,
+			onFailedAttempt({retryDelay}) {
+				delays.push(retryDelay);
+			},
+		}), {message: 'fail'});
+
+		assert.deepEqual(delays, [5, 0], `retryAfter: ${String(retryAfter)}`);
+	}
+});
+
+test('retryAfter is clipped by maxRetryTime', async () => {
+	const start = performance.now();
+	await assert.rejects(pRetry(async () => {
+		throw Object.assign(new Error('rate limited'), {retryAfter: 60});
+	}, {
+		retries: 5,
+		minTimeout: 10,
+		maxRetryTime: 150,
+	}), {message: 'rate limited'});
+
+	assert.ok(performance.now() - start < 2000);
+});
+
+test('a huge retryAfter does not overflow the timer', async () => {
+	const delays = [];
+	const controller = new AbortController();
+	await assert.rejects(pRetry(async () => {
+		throw Object.assign(new Error('rate limited'), {retryAfter: 1e12});
+	}, {
+		retries: 1,
+		minTimeout: 0,
+		signal: controller.signal,
+		onFailedAttempt({retryDelay}) {
+			delays.push(retryDelay);
+			controller.abort();
+		},
+	}), {name: 'AbortError'});
+
+	assert.deepEqual(delays, [(2 ** 31) - 1]);
+});
+
+test('retryAfter on an error wrapped by AbortError does not cause a retry', async () => {
+	let calls = 0;
+	await assert.rejects(pRetry(async () => {
+		calls++;
+		throw new AbortError(Object.assign(new Error('stop'), {retryAfter: 1}));
+	}, {retries: 3, minTimeout: 0}), {message: 'stop'});
+
+	assert.equal(calls, 1);
+});
