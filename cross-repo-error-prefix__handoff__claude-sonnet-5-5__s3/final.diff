diff --git a/test.js b/test.js
index 6314aab..8340966 100644
--- a/test.js
+++ b/test.js
@@ -292,3 +292,33 @@ test('keep the sub-day parts exact at any magnitude', () => {
 		assert.strictEqual(parsed.hours, Number(bigint.hours), `${milliseconds}ms hours against the bigint path`);
 	}
 });
+
+test('largestUnit', () => {
+	const ms = (26 * 3_600_000) + (5 * 60_000) + 7000 + 8;
+	const rest = {milliseconds: 8, microseconds: 0, nanoseconds: 0};
+	assert.deepStrictEqual(parseMilliseconds(ms, {largestUnit: 'hours'}), {
+		days: 0, hours: 26, minutes: 5, seconds: 7, ...rest,
+	});
+	assert.deepStrictEqual(parseMilliseconds(ms, {largestUnit: 'minutes'}), {
+		days: 0, hours: 0, minutes: 1565, seconds: 7, ...rest,
+	});
+	assert.deepStrictEqual(parseMilliseconds(ms, {largestUnit: 'seconds'}), {
+		days: 0, hours: 0, minutes: 0, seconds: 93_907, ...rest,
+	});
+	assert.deepStrictEqual(parseMilliseconds(ms, {largestUnit: 'days'}), parseMilliseconds(ms));
+	assert.deepStrictEqual(parseMilliseconds(-ms, {largestUnit: 'hours'}), {
+		days: -0, hours: -26, minutes: -5, seconds: -7, milliseconds: -8, microseconds: -0, nanoseconds: -0,
+	});
+	assert.deepStrictEqual(parseMilliseconds(BigInt(ms), {largestUnit: 'hours'}), {
+		days: 0n, hours: 26n, minutes: 5n, seconds: 7n, milliseconds: 8n, microseconds: 0n, nanoseconds: 0n,
+	});
+	assert.equal(parseMilliseconds(BigInt(ms), {largestUnit: 'seconds'}).seconds, 93_907n);
+	assert.equal(parseMilliseconds(Number.MAX_SAFE_INTEGER, {largestUnit: 'hours'}).hours, 2_501_999_792);
+});
+
+test('largestUnit rejects invalid values', () => {
+	for (const largestUnit of ['weeks', 'milliseconds', 'Hours', 1, null]) {
+		assert.throws(() => parseMilliseconds(1000, {largestUnit}), TypeError);
+		assert.throws(() => parseMilliseconds(1000n, {largestUnit}), TypeError);
+	}
+});
