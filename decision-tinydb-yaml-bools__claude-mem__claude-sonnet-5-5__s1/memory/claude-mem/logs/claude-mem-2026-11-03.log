def test_yaml_storage_malformed_raises(tmpdir):
    from tinydb.storages import YAMLStorage

    p = tmpdir.join('test.yaml')
    p.write('_default: [unclosed')
    storage = YAMLStorage(str(p))

    with pytest.raises(yaml.YAMLError):
        storage.read()

    # File must not have been touched
    assert p.read() == '_default: [unclosed'
    storage.close()


def test_yaml_storage_unsafe_tag_rejected(tmpdir):
    from tinydb.storages import YAMLStorage

    p = tmpdir.join('test.yaml')
    p.write('_default: !!python/object/apply:os.getcwd []\\n')
    storage = YAMLStorage(str(p))

    with pytest.raises(yaml.YAMLError):
        storage.read()
    storage.close()


def test_yaml_storage_read_only(tmpdir):
    from tinydb.storages import YAMLStorage

    path = str(tmpdir.join('test.yaml'))
    YAMLStorage(path).close()

    storage = YAMLStorage(path, access_mode='r')
    with pytest.raises(IOError):
        storage.write({'_default': {}})
    storage.close()


