+_yaml_classes: Optional[tuple] = None
+
+
+def _get_yaml():
+    """
+    Import PyYAML lazily and build the loader/dumper classes used by
+    :class:`YAMLStorage` (cached after the first call).
+
+    Custom subclasses are used so PyYAML's global state is never modified.
+    """
+    global _yaml_classes
+
+    if _yaml_classes is None:
+        try:
+            import yaml
+        except ImportError:
+            raise ImportError(
+                'YAMLStorage requires PyYAML. Install it with `pip install pyyaml`.'
+            ) from None
+
+        class Loader(yaml.SafeLoader):
+            pass
+
+        # Only `true`/`false` are booleans. YAML 1.1 would also turn values
+        # like `no`, `off` or `y` into booleans, which is a trap when the
+        # file is edited by hand (e.g. the country code ``no`` for Norway).
+        Loader.yaml_implicit_resolvers = {
+            first: [(tag, regexp) for tag, regexp in resolvers
+                    if tag != 'tag:yaml.org,2002:bool']
+            for first, resolvers in yaml.SafeLoader.yaml_implicit_resolvers.items()
+        }
+        Loader.add_implicit_resolver(
+            'tag:yaml.org,2002:bool',
+            re.compile(r'^(?:true|false)$'),
+            list('tf'),
+        )
+
+        class Dumper(yaml.SafeDumper):
+            pass
+
+        # Serialize dict subclasses (e.g. ``Document``) as plain mappings.
+        # The dumper keeps the default resolvers, so strings such as "no"
+        # are quoted and stay strings for any YAML 1.1 reader.
+        Dumper.add_multi_representer(
+            dict, lambda dumper, data: dumper.represent_dict(dict(data))
+        )
+
+        _yaml_classes = (yaml, Loader, Dumper)
+
+    return _yaml_classes
+
+
+class YAMLStorage(_FileStorage):
+    """
+    Store the data in a human-editable YAML file.
+
+    Requires `PyYAML <https://pyyaml.org>`_. Data is read with a safe loader
+    (no arbitrary Python objects). A malformed file raises
+    :class:`yaml.YAMLError` instead of being treated as empty, so the next
+    write cannot silently overwrite data.
+
+    Comments in the file are **not** preserved when TinyDB rewrites it.
+    """
+
+    def __init__(self, path: str, create_dirs=False, encoding=None, access_mode='r+', **kwargs):
+        """
+        Create a new instance.
+
+        :param path: Where to store the YAML data.
+        :param access_mode: mode in which the file is opened (r, r+)
+        :param kwargs: Passed to :func:`yaml.dump` on every write. **Never**
+                       pass untrusted values (e.g. ``Dumper``).
+        """
+
+        _get_yaml()  # Fail early if PyYAML is missing
+
+        super().__init__(path, create_dirs=create_dirs, encoding=encoding, access_mode=access_mode)
+
+        self.kwargs = kwargs
+
+    def read(self) -> Optional[dict[str, dict[str, Any]]]:
+        yaml, loader, _ = _get_yaml()
+
+        self._handle.seek(0)
+
+        # An empty (or comment-only) file loads as ``None``: empty storage
+        return yaml.load(self._handle, Loader=loader)
+
+    def write(self, data: dict[str, dict[str, Any]]):
+        yaml, _, dumper = _get_yaml()
+
+        self._handle.seek(0)
+
+        options = {'default_flow_style': False, 'allow_unicode': True, 'sort_keys': False}
+        options.update(self.kwargs)
+        options['Dumper'] = dumper
+        serialized = yaml.dump(data, **options)
+
+        try:
+            self._handle.write(serialized)
+        except io.UnsupportedOperation:
+            raise IOError('Cannot write to the database. Access mode is "{0}"'.format(self._mode))
+
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+        self._handle.truncate()
+
+
