+def test_yaml_storage_roundtrip(tmpdir):
+    from tinydb.storages import YAMLStorage
+
+    path = str(tmpdir.join('test.yaml'))
+    storage = YAMLStorage(path)
+    assert storage.read() is None
+
+    storage.write({'_default': {'1': doc}})
+    assert storage.read() == {'_default': {'1': doc}}
+
+    # Shrinking the data truncates the file
+    storage.write({'_default': {}})
+    assert storage.read() == {'_default': {}}
+    storage.close()
+
+
+def test_yaml_storage_with_tinydb(tmpdir):
+    from tinydb.storages import YAMLStorage
+
+    path = str(tmpdir.join('test.yaml'))
+    with TinyDB(path, storage=YAMLStorage) as db:
+        db.insert(doc)
+        db.update({'name': 'foo'})
+        assert db.all() == [dict(doc, name='foo')]
+
+    assert '!' not in tmpdir.join('test.yaml').read()
+
+    with TinyDB(path, storage=YAMLStorage) as db:
+        assert db.contains(where('name') == 'foo')
+        assert len(db) == 1
+
+
+def test_yaml_storage_hand_edited_file(tmpdir):
+    from tinydb.storages import YAMLStorage
+
+    p = tmpdir.join('test.yaml')
+    p.write('# edited by ops\n_default:\n  1:\n    country: no\n    on: off\n    flag: true\n')
+
+    with TinyDB(str(p), storage=YAMLStorage) as db:
+        # `no`/`off` stay strings, only true/false are booleans
+        assert db.all() == [{'country': 'no', 'on': 'off', 'flag': True}]
+
+
+def test_yaml_storage_string_stays_string(tmpdir):
+    from tinydb.storages import YAMLStorage
+
+    path = str(tmpdir.join('test.yaml'))
+    data = {'_default': {'1': {'a': 'no', 'b': 'true', 'c': '42', 'd': 'ü'}}}
+    storage = YAMLStorage(path, encoding='utf-8')
+    storage.write(data)
+    assert storage.read() == data
+    storage.close()
+
+
+def test_yaml_storage_malformed_raises(tmpdir):
+    from tinydb.storages import YAMLStorage
+
+    p = tmpdir.join('test.yaml')
+    p.write('_default: [unclosed')
+    storage = YAMLStorage(str(p))
+
+    with pytest.raises(yaml.YAMLError):
+        storage.read()
+
+    # File must not have been touched
+    assert p.read() == '_default: [unclosed'
+    storage.close()
+
+
+def test_yaml_storage_unsafe_tag_rejected(tmpdir):
+    from tinydb.storages import YAMLStorage
+
+    p = tmpdir.join('test.yaml')
+    p.write('_default: !!python/object/apply:os.getcwd []\n')
+    storage = YAMLStorage(str(p))
+
+    with pytest.raises(yaml.YAMLError):
+        storage.read()
+    storage.close()
+
+
+def test_yaml_storage_read_only(tmpdir):
+    from tinydb.storages import YAMLStorage
+
+    path = str(tmpdir.join('test.yaml'))
+    YAMLStorage(path).close()
+
+    storage = YAMLStorage(path, access_mode='r')
+    with pytest.raises(IOError):
+        storage.write({'_default': {}})
+    storage.close()
+
