+def gigabytes(num_bytes: float | str, precision: int = 1) -> str:
+    """Format a number of bytes as decimal gigabytes (10**9 bytes), e.g. '1.5 GB'.
+
+    Always uses the GB unit, regardless of magnitude. Ties round half up on the
+    decimal value, like `percent`.
+
+    Examples:
+        ```pycon
+        >>> gigabytes(1500000000)
+        '1.5 GB'
+        >>> gigabytes(2 * 10**9, 0)
+        '2 GB'
+        >>> gigabytes(1250000000)
+        '1.3 GB'
+        >>> gigabytes(500000000, 2)
+        '0.50 GB'
+
+        ```
+
+    Args:
+        num_bytes (int, float, str): Number of bytes.
+        precision (int): Number of decimal places.
+
+    Returns:
+        str: The size in gigabytes.
+    """
+    import decimal
+    import math
+
+    try:
+        value = float(num_bytes)
+        if not math.isfinite(value):
+            return f"{value} GB"
+    except (ValueError, TypeError):
+        return str(num_bytes)
+    with decimal.localcontext() as ctx:
+        ctx.prec = 1000
+        exp = decimal.Decimal(1).scaleb(-int(precision))
+        gb = (decimal.Decimal(repr(value)) / 10**9).quantize(
+            exp, rounding=decimal.ROUND_HALF_UP
+        )
+        return f"{gb:f} GB"
