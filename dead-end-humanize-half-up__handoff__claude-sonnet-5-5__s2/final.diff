+def percent(value: NumberOrString, precision: int = 1) -> str:
+    """Return a fraction formatted as a percentage.
+
+    Examples:
+        ```pycon
+        >>> percent(0.125)
+        '12.5%'
+        >>> percent(0.5)
+        '50.0%'
+        >>> percent(1, 0)
+        '100%'
+        >>> percent(0.12345, 2)
+        '12.35%'
+        >>> percent(0.0625)
+        '6.3%'
+        >>> percent("foo")
+        'foo'
+
+        ```
+
+    Args:
+        value (int, float, str): Fraction to format, where 1 is 100%.
+        precision (int): Number of decimal places. Ties round half up.
+
+    Returns:
+        str: The percentage, or the input as a string if it is not a number.
+    """
+    import decimal
+    import math
+
+    try:
+        value = float(value)
+        if not math.isfinite(value):
+            return _format_not_finite(value)
+    except (ValueError, TypeError):
+        return str(value)
+    # Round half up on the decimal value as written (repr gives the shortest
+    # round-tripping form), to match billing's invoices. Float formatting
+    # would round ties to even: 0.0625 -> '6.2%' instead of '6.3%'.
+    with decimal.localcontext() as ctx:
+        ctx.prec = 1000
+        exp = decimal.Decimal(1).scaleb(-int(precision))
+        pct = (decimal.Decimal(repr(value)) * 100).quantize(
+            exp, rounding=decimal.ROUND_HALF_UP
+        )
+        return f"{pct:f}%"
+
