     assert humanize.naturalsize(*test_args) == "-" + expected
+
+
+@pytest.mark.parametrize(
+    "test_args, expected",
+    [
+        ([1500000000], "1.5 GB"),
+        ([10**9], "1.0 GB"),
+        ([0], "0.0 GB"),
+        ([1250000000], "1.3 GB"),
+        ([1250000000, 0], "1 GB"),
+        ([1500000000, 0], "2 GB"),
+        ([500000000, 2], "0.50 GB"),
+        ([123456789, 3], "0.123 GB"),
+        ([10**12], "1000.0 GB"),
+        ([1.5 * 10**9], "1.5 GB"),
+        (["1500000000"], "1.5 GB"),
+    ],
+)
+def test_gigabytes(test_args: list[int], expected: str) -> None:
+    assert humanize.gigabytes(*test_args) == expected
+
+    # Negative input mirrors the positive result
+    first = test_args[0]
+    neg = f"-{first}" if isinstance(first, str) else -first
+    expected_neg = f"-{expected}" if first else expected
+    assert humanize.gigabytes(neg, *test_args[1:]) == expected_neg
+
+
+def test_gigabytes_non_numeric() -> None:
+    assert humanize.gigabytes("foo") == "foo"
+    assert humanize.gigabytes(None) == "None"  # type: ignore[arg-type]
+    assert humanize.gigabytes(float("inf")) == "inf GB"
