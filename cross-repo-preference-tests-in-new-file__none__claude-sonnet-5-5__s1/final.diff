 export default function decamelize(string: string, options?: Options): string;
+
+/**
+Decamelize each own enumerable string key of a plain object. The operation is shallow and values are left untouched.
+
+@param object - The plain object whose keys will be decamelized.
+@param options - Options passed through to `decamelize`.
+@returns A new object.
+
+@example
+```
+import {decamelizeKeys} from 'decamelize';
+
+decamelizeKeys({unicornRainbow: 1, fooBar: {bazQux: 2}});
+//=> {unicorn_rainbow: 1, foo_bar: {bazQux: 2}}
+
+decamelizeKeys({unicornRainbow: 1}, {separator: '-'});
+//=> {'unicorn-rainbow': 1}
+```
+*/
+export function decamelizeKeys(object: Record<string, unknown>, options?: Options): Record<string, unknown>;
