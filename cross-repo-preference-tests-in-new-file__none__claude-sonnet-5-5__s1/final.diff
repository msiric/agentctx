@@ -0,0 +1,38 @@
+/* eslint-disable camelcase -- Expected output keys are snake case. */
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import {decamelizeKeys} from './index.js';
+
+test('decamelizeKeys decamelizes keys shallowly', () => {
+	const nested = {innerKey: 1};
+	const input = {fooBar: nested, baz: 2, already_snake: 3};
+	const result = decamelizeKeys(input);
+	assert.deepEqual(result, {foo_bar: nested, baz: 2, already_snake: 3});
+	assert.equal(result.foo_bar, nested);
+	assert.deepEqual(Object.keys(nested), ['innerKey']);
+});
+
+test('decamelizeKeys returns a new object and does not mutate', () => {
+	const input = {fooBar: 1};
+	const result = decamelizeKeys(input);
+	assert.notEqual(result, input);
+	assert.deepEqual(input, {fooBar: 1});
+});
+
+test('decamelizeKeys passes options through', () => {
+	assert.deepEqual(decamelizeKeys({fooBar: 1}, {separator: '-'}), {'foo-bar': 1});
+	assert.deepEqual(decamelizeKeys({testGUILabel: 1}, {preserveConsecutiveUppercase: true}), {test_GUI_label: 1});
+});
+
+test('decamelizeKeys handles empty and null-prototype objects', () => {
+	assert.deepEqual(decamelizeKeys({}), {});
+	const object = Object.create(null);
+	object.fooBar = 1;
+	assert.deepEqual(decamelizeKeys(object), {foo_bar: 1});
+});
+
+test('decamelizeKeys throws for non-plain objects', () => {
+	for (const value of [null, undefined, 'a', 1, [], new Map(), Object.create({inheritedKey: 1}), () => {}]) {
+		assert.throws(() => decamelizeKeys(value), TypeError);
+	}
+});
