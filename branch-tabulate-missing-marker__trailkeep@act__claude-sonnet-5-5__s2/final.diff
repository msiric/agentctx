+def test_inprocess_jsonl_skips_blank_lines():
+    """In-process: blank lines in JSONL input are ignored"""
+    out = run_main_in_process(
+        ["-r", "jsonl", "-f", "grid"],
+        input_text="\n" + SAMPLE_INPUT_JSONL.replace("\n", "\n\n") + "\n\n\n",
+    )
+    assert_equal(out.splitlines(), SAMPLE_GRID_FORMAT.splitlines())
+
+
+def test_inprocess_jsonl_missing_keys_use_dot():
+    """In-process: a record lacking a key gets '.' as missing-value marker"""
+    out = run_main_in_process(
+        ["-r", "jsonl", "-f", "tsv"],
+        input_text='{"a": 1, "b": 2}\n{"a": 3}\n',
+    )
+    assert_equal(out.splitlines(), ["  a\t  b", "  1\t  2", "  3\t  ."])
+
+
