@@ -285,3 +285,69 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def _crash_after(monkeypatch, storage, stage):
+    """Make the storage "die" (raise) at the given point of a write."""
+    class Crash(BaseException):
+        pass
+
+    if stage == 'before_overwrite':
+        def boom(serialized):
+            raise Crash()
+        monkeypatch.setattr(storage, '_overwrite', boom)
+    elif stage == 'mid_overwrite':
+        def partial(serialized):
+            storage._handle.seek(0)
+            storage._handle.write(serialized[:len(serialized) // 2])
+            storage._handle.flush()
+            storage._handle.truncate()
+            raise Crash()
+        monkeypatch.setattr(storage, '_overwrite', partial)
+    elif stage == 'mid_journal':
+        def partial_journal(serialized):
+            with open(storage._journal_path, 'w') as f:
+                f.write('deadbeef\n' + serialized[:5])
+            raise Crash()
+        monkeypatch.setattr(storage, '_write_journal', partial_journal)
+    return Crash
+
+
+@pytest.mark.parametrize('stage', ['mid_journal', 'before_overwrite', 'mid_overwrite'])
+def test_crash_during_write_is_recoverable(tmp_path, monkeypatch, stage):
+    import json
+    from tinydb import TinyDB
+
+    path = str(tmp_path / 'db.json')
+    db = TinyDB(path)
+    db.insert({'a': 1})
+    old = {'_default': {'1': {'a': 1}}}
+    new = {'_default': {'1': {'a': 1}, '2': {'b': 2}}}
+
+    Crash = _crash_after(monkeypatch, db.storage, stage)
+    with pytest.raises(Crash):
+        db.insert({'b': 2})
+    db.storage._handle.close()  # simulate process death
+
+    db2 = TinyDB(path)
+    try:
+        assert db2.storage.read() in (old, new)
+        assert len(db2.all()) in (1, 2)
+        if stage == 'mid_journal':
+            assert db2.storage.read() == old
+        else:
+            assert db2.storage.read() == new
+    finally:
+        db2.close()
+    assert not os.path.exists(path + '.journal')
+    json.load(open(path))
+
+
+def test_write_leaves_no_journal(tmp_path):
+    from tinydb import TinyDB
+
+    path = str(tmp_path / 'db.json')
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+        assert not os.path.exists(path + '.journal')
+    assert os.stat(path).st_ino  # same file, updated in place
