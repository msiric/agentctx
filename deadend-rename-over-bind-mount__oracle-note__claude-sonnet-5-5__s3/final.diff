+
+    # Crash safety: the database file is updated in place (it can't be
+    # replaced via rename, e.g. when it is a bind-mounted single file). To make
+    # that safe, every write first stores the complete new state in a journal
+    # file next to the database and fsyncs it. Only then is the database
+    # overwritten, and the journal removed afterwards. A journal carries a
+    # checksum, so after a crash:
+    #   * incomplete journal -> database wasn't touched yet, drop the journal
+    #   * complete journal   -> database may be half-written, replay journal
+    # Either way the next open sees the old or the new state.
+
+    def _write_journal(self, serialized: str) -> None:
+        digest = hashlib.sha256(serialized.encode('utf-8')).hexdigest()
+        with open(self._journal_path, 'w', encoding='utf-8', newline='') as f:
+            f.write(digest + '\n' + serialized)
+            f.flush()
+            os.fsync(f.fileno())
+
+    def _remove_journal(self) -> None:
+        try:
+            os.remove(self._journal_path)
+        except FileNotFoundError:
+            pass
+
+    def _recover(self) -> None:
+        try:
+            with open(self._journal_path, 'r', encoding='utf-8', newline='') as f:
+                content = f.read()
+        except FileNotFoundError:
+            return
+        except (OSError, UnicodeDecodeError):
+            content = ''
+
+        digest, sep, serialized = content.partition('\n')
+        valid = (
+            bool(sep)
+            and hashlib.sha256(serialized.encode('utf-8')).hexdigest() == digest
+        )
+        if valid:
+            self._overwrite(serialized)
+        self._remove_journal()
+
+    def _overwrite(self, serialized: str) -> None:
+        self._handle.seek(0)
+        self._handle.write(serialized)
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+        self._handle.truncate()
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
 
     def close(self) -> None:
         self._handle.close()
