+def statement_types(sql: str, encoding: str | None = None) -> list[str]:
+    """Return the statement type of each statement in *sql*.
+
+    Each entry is what :meth:`~sqlparse.sql.Statement.get_type` returns for
+    the corresponding statement found by :func:`parse`, e.g.
+    ``['SELECT', 'INSERT']``.
+
+    :param sql: A string containing one or more SQL statements.
+    :param encoding: The encoding of the statement (optional).
+    :returns: A list of strings, in statement order.
+    """
+    return [stmt.get_type() for stmt in parsestream(sql, encoding)]
