diff --git a/src/index.js b/src/index.js
index 3ea001b..fd1f58d 100644
--- a/src/index.js
+++ b/src/index.js
@@ -7,6 +7,16 @@ var MAP = {
 		return d.getMonth() + 1;
 	},
 	DD: 'getDate',
+	DDD: function (d) {
+		// UTC math so DST shifts can't skew the day count
+		return (Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()) - Date.UTC(d.getFullYear(), 0, 0)) / 864e5;
+	},
+	WW: function (d) {
+		// matches Excel WEEKNUM(date, 2): weeks start Monday, week 1 contains Jan 1 (not ISO 8601)
+		var jan1 = new Date(d.getFullYear(), 0, 1).getDay(); // 0=Sun
+		var doy = (Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()) - Date.UTC(d.getFullYear(), 0, 0)) / 864e5;
+		return Math.floor((doy - 1 + (jan1 + 6) % 7) / 7) + 1;
+	},
 	HH: 'getHours',
 	mm: 'getMinutes',
 	ss: 'getSeconds',
