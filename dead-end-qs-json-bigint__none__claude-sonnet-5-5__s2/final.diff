+
+test('`json` type decodes the value as JSON and leaves invalid JSON as a string', () => {
+	const types = {filter: 'json'};
+	assert.deepEqual(structuredClone(queryString.parse('filter=%7B%22a%22%3A%5B1%2C2%5D%7D', {types})), {filter: {a: [1, 2]}});
+	assert.deepEqual(structuredClone(queryString.parse('filter=%5B1%2C%22x%22%5D', {types})), {filter: [1, 'x']});
+	assert.deepEqual(structuredClone(queryString.parse('filter=1', {types})), {filter: 1});
+	assert.deepEqual(structuredClone(queryString.parse('filter=true', {types})), {filter: true});
+	assert.deepEqual(structuredClone(queryString.parse('filter=null', {types})), {filter: null});
+	assert.deepEqual(structuredClone(queryString.parse('filter=%7B', {types})), {filter: '{'});
+	assert.deepEqual(structuredClone(queryString.parse('filter=abc', {types, parseNumbers: true})), {filter: 'abc'});
+	assert.deepEqual(structuredClone(queryString.parse('filter=', {types})), {filter: ''});
+	assert.deepEqual(structuredClone(queryString.parse('filter', {types})), {filter: null});
+	assert.deepEqual(structuredClone(queryString.parse('filter=1&filter=%7B', {types})), {filter: [1, '{']});
+	assert.deepEqual(structuredClone(queryString.parse('filter=1&other=1', {types, parseNumbers: true})), {filter: 1, other: 1});
+});
