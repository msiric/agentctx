+/* eslint-disable camelcase -- Expected output keys are snake_case. */
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import {decamelizeKeys} from './index.js';
+
+test('decamelizes keys and leaves values untouched', () => {
+	const nested = {innerKey: 1};
+	const result = decamelizeKeys({unicornRainbow: nested, fooBar: 'bazQux'});
+	assert.deepEqual(result, {unicorn_rainbow: {innerKey: 1}, foo_bar: 'bazQux'});
+	assert.equal(result.unicorn_rainbow, nested);
+});
+
+test('returns a new object without mutating the input', () => {
+	const input = {fooBar: 1};
+	const result = decamelizeKeys(input);
+	assert.notEqual(result, input);
+	assert.deepEqual(input, {fooBar: 1});
+});
+
+test('passes options through', () => {
+	assert.deepEqual(decamelizeKeys({fooBar: 1}, {separator: '-'}), {'foo-bar': 1});
+	assert.deepEqual(
+		decamelizeKeys({testGUILabel: 1}, {preserveConsecutiveUppercase: true}),
+		{test_GUI_label: 1},
+	);
+});
+
+test('only own enumerable string keys are used', () => {
+	const symbol = Symbol('fooBar');
+	const input = {ownKey: 2, [symbol]: 3};
+	Object.defineProperty(input, 'hiddenKey', {value: 4});
+	assert.deepEqual(decamelizeKeys(input), {own_key: 2});
+});
+
+test('handles empty objects, null-prototype objects, and __proto__ keys', () => {
+	assert.deepEqual(decamelizeKeys({}), {});
+	const bare = Object.assign(Object.create(null), {fooBar: 1});
+	assert.deepEqual(decamelizeKeys(bare), {foo_bar: 1});
+	const result = decamelizeKeys(JSON.parse('{"__proto__": 1}'));
+	assert.equal(Object.getPrototypeOf(result), Object.prototype);
+	assert.equal(Object.keys(result)[0], '__proto__');
+});
+
+test('later keys win on collisions', () => {
+	assert.deepEqual(decamelizeKeys({fooBar: 1, foo_bar: 2}), {foo_bar: 2});
+});
+
+test('throws for non-plain objects', () => {
+	for (const value of [undefined, null, 'foo', 1, [], new Map(), new Date(), () => {}]) {
+		assert.throws(() => decamelizeKeys(value), TypeError);
+	}
+});
