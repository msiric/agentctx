diff --git a/test/test_cli.py b/test/test_cli.py
index 154f1a2..5c1ebd4 100644
--- a/test/test_cli.py
+++ b/test/test_cli.py
@@ -483,3 +483,23 @@ def test_inprocess_jsonl_malformed_headers():
     )
     # output should still be produced (graceful fallback), with raw keys as headers
     assert out.strip() != ""
+
+
+def test_inprocess_wrap_option():
+    """In-process: -w / --wrap wraps on whitespace only, never splitting words"""
+    data = "id,text\nT-1,hello world https://example.com/a-very-long-url\n"
+    for opt in ["-w", "--wrap"]:
+        out = run_main_in_process(["-r", "csv", "-1", opt, "8"], input_text=data)
+        assert "https://example.com/a-very-long-url" in out
+        assert "hello" in out.splitlines()[2]
+        assert "world" not in out.splitlines()[2]
+
+
+def test_inprocess_wrap_invalid_width():
+    """In-process: invalid --wrap width exits with code 3"""
+    import pytest
+
+    for bad in ["0", "-3", "abc"]:
+        with pytest.raises(SystemExit) as exc_info:
+            run_main_in_process(["--wrap", bad], input_text="a b\n")
+        assert exc_info.value.code == 3
