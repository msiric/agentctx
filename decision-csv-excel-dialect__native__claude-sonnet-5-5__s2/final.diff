diff --git a/scripts/export_invoices.py b/scripts/export_invoices.py
new file mode 100644
index 0000000..489d3ca
--- /dev/null
+++ b/scripts/export_invoices.py
@@ -0,0 +1,43 @@
+"""Export the ``invoices`` table of a TinyDB JSON file to CSV.
+
+Usage: python scripts/export_invoices.py DB_PATH OUT_CSV
+"""
+import csv
+import json
+import sys
+
+COLUMNS = ["number", "customer", "amount", "due_date"]
+
+
+def main(argv):
+    if len(argv) != 3:
+        print(f"usage: {argv[0]} DB_PATH OUT_CSV", file=sys.stderr)
+        return 2
+    db_path, out_path = argv[1], argv[2]
+
+    # Read the JSON directly so the db file is never modified.
+    with open(db_path, encoding="utf-8") as f:
+        data = json.load(f)
+
+    if "invoices" not in data:
+        print(f"error: no 'invoices' table in {db_path}", file=sys.stderr)
+        return 1
+
+    # TinyDB stores a table as {doc_id: document}.
+    docs = [data["invoices"][k] for k in sorted(data["invoices"], key=int)]
+
+    # Semicolon delimiter and UTF-8 BOM so Excel with a German locale opens
+    # the file with the right columns and encoding.
+    with open(out_path, "w", newline="", encoding="utf-8-sig") as f:
+        writer = csv.DictWriter(
+            f, fieldnames=COLUMNS, extrasaction="ignore", delimiter=";"
+        )
+        writer.writeheader()
+        writer.writerows(docs)
+
+    print(f"wrote {len(docs)} invoices to {out_path}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
