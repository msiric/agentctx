     db.close()
+
+
+def test_to_csv_default_fields(db, tmp_path):
+    import csv
+    table = db.table('csv')
+    table.insert({'a': 1, 'b': 'x'})
+    table.insert({'b': 'y', 'c': 'z,w'})
+
+    out = tmp_path / 'out.csv'
+    table.to_csv(out)
+
+    with open(out, newline='', encoding='utf-8') as f:
+        rows = list(csv.reader(f))
+
+    assert rows == [['a', 'b', 'c'], ['1', 'x', ''], ['', 'y', 'z,w']]
+
+
+def test_to_csv_fields_select_and_order(db, tmp_path):
+    table = db.table('csv')
+    table.insert({'a': 1, 'b': 2, 'c': 3})
+
+    out = tmp_path / 'out.csv'
+    table.to_csv(out, fields=['c', 'a', 'missing'])
+
+    assert out.read_text(encoding='utf-8').splitlines() == ['c,a,missing', '3,1,']
+
+
+def test_to_csv_empty_table(db, tmp_path):
+    out = tmp_path / 'out.csv'
+    db.table('empty').to_csv(out, fields=['a', 'b'])
+    assert out.read_text(encoding='utf-8').splitlines() == ['a,b']
+
+    db.table('empty').to_csv(out)
+    assert out.read_text(encoding='utf-8').strip() == ''
