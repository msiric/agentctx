+import { describe, expect, it } from '@jest/globals';
+import { parseCompound } from './index';
+
+describe('parseCompound(string)', () => {
+  it('should sum hours and minutes', () => {
+    expect(parseCompound('1h 30m')).toBe(5400000);
+  });
+
+  it('should support long unit names', () => {
+    expect(parseCompound('2 days 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
+  });
+
+  it('should support pieces without spaces', () => {
+    expect(parseCompound('1h30m15s')).toBe(3600000 + 1800000 + 15000);
+  });
+
+  it('should support commas between pieces', () => {
+    expect(parseCompound('1h, 30m')).toBe(5400000);
+    expect(parseCompound('1h,30m')).toBe(5400000);
+    expect(parseCompound('1h , 30m , 15s')).toBe(5415000);
+  });
+
+  it('should support a single piece', () => {
+    expect(parseCompound('5s')).toBe(5000);
+  });
+
+  it('should support decimals and negatives', () => {
+    expect(parseCompound('1.5h -30m')).toBe(3600000);
+  });
+
+  it('should be case insensitive', () => {
+    expect(parseCompound('1H 1M')).toBe(3660000);
+  });
+
+  it.each([
+    '',
+    'abc',
+    'foo',
+    '100',
+    '1h 30',
+    '1h 30x',
+    '1h foo',
+    '1h and 30m',
+    ',1h',
+    '1h,',
+    '1h,,30m',
+    '1h, , 30m',
+    ',',
+    '1h '.repeat(40),
+  ])('should throw a TypeError including the input for %j', (input) => {
+    expect(() => parseCompound(input)).toThrow(TypeError);
+    expect(() => parseCompound(input)).toThrow(JSON.stringify(input));
+  });
+
+  it('should throw a TypeError for non-strings', () => {
+    // @ts-expect-error testing runtime behavior
+    expect(() => parseCompound(1)).toThrow(TypeError);
+    // @ts-expect-error testing runtime behavior
+    expect(() => parseCompound(undefined)).toThrow(TypeError);
+  });
+});
