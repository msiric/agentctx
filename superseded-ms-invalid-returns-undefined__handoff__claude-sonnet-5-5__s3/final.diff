+/**
+ * Parse a compound duration such as `"1h 30m"`, `"1h, 30m"` or `"2 days 4 hours"` and
+ * return the total in milliseconds. Each piece is parsed with `parse`.
+ *
+ * @param str - A string made of one or more `<number><unit>` pieces
+ * @returns The summed value in milliseconds
+ * @throws TypeError if `str` is not a non-empty string made up entirely of
+ * valid `<number><unit>` pieces
+ */
+export function parseCompound(str: string): number {
+  const invalid = () =>
+    new TypeError(
+      `Value provided to ms.parseCompound() must be a string of one or more <number><unit> pieces, like "1h 30m". value=${JSON.stringify(str)}`,
+    );
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw invalid();
+  }
+  // Pieces may be separated by whitespace, a comma, or nothing at all.
+  const whole = /^\s*-?\d*\.?\d+ *[a-z]+(?:\s*,?\s*-?\d*\.?\d+ *[a-z]+)*\s*$/i;
+  const pieces = whole.test(str) ? str.match(/-?\d*\.?\d+ *[a-z]+/gi) : null;
+  if (!pieces) {
+    throw invalid();
+  }
+  let total = 0;
+  for (const p of pieces) {
+    const n = parse(p);
+    if (Number.isNaN(n)) {
+      throw invalid();
+    }
+    total += n;
+  }
+  return total;
+}
+
+/**
+ * Parse a timer-style clock string and return milliseconds. `"m:ss"` (e.g. `"1:30"`)
+ * and `"h:mm:ss"` (e.g. `"01:02:03"`) are supported. Seconds, and minutes in the
+ * `h:mm:ss` form, must be two digits and below 60.
+ *
+ * @param str - The clock string
+ * @returns The value in milliseconds, or `undefined` if the input is invalid
+ */
+export function parseClock(str: string): number | undefined {
+  if (typeof str !== 'string' || str.length > 100) {
+    return undefined;
+  }
+  const match = /^(?:(\d+):([0-5]\d)|(\d+):([0-5]\d):([0-5]\d))$/.exec(str);
+  if (!match) {
+    return undefined;
+  }
+  const [h, m, s] =
+    match[3] === undefined
+      ? [0, Number(match[1]), Number(match[2])]
+      : [Number(match[3]), Number(match[4]), Number(match[5])];
+  return ((h * 60 + m) * 60 + s) * 1000;
+}
