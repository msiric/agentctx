   const isPlural = msAbs >= n * 1.5;
   return `${Math.round(ms / n)} ${name}${isPlural ? 's' : ''}` as StringValue;
 }
+
+/**
+ * Format the given milliseconds as an ISO 8601 duration string.
+ *
+ * Days are the largest unit used, since months and years are ambiguous.
+ * Negative values are prefixed with `-` (a widely supported extension to
+ * ISO 8601). Sub-second precision is emitted as a decimal fraction of the
+ * seconds, and the value is rounded to the nearest millisecond.
+ *
+ * @example
+ * formatISO(5400000); // "PT1H30M"
+ * formatISO(90061000); // "P1DT1H1M1S"
+ *
+ * @param ms - milliseconds
+ * @returns The ISO 8601 duration string
+ */
+export function formatISO(ms: number): string {
+  if (typeof ms !== 'number' || !Number.isFinite(ms)) {
+    throw new Error('Value provided to ms.formatISO() must be of type number.');
+  }
+
+  let rest = Math.round(Math.abs(ms));
+  const days = Math.floor(rest / d);
+  rest %= d;
+  const hours = Math.floor(rest / h);
+  rest %= h;
+  const minutes = Math.floor(rest / m);
+  rest %= m;
+  const seconds = Math.floor(rest / s);
+  const millis = rest % s;
+
+  let time = '';
+  if (hours) time += `${hours}H`;
+  if (minutes) time += `${minutes}M`;
+  if (seconds || millis) {
+    let fraction = '';
+    if (millis) {
+      // Digits of the fraction, without trailing zeros (e.g. 50 -> ".05").
+      let digits = String(millis).padStart(3, '0');
+      while (digits.endsWith('0')) {
+        digits = digits.slice(0, -1);
+      }
+      fraction = `.${digits}`;
+    }
+    time += `${seconds}${fraction}S`;
+  }
+
+  if (!days && !time) {
+    return 'PT0S';
+  }
+
+  const sign = ms < 0 ? '-' : '';
+  return `${sign}P${days ? `${days}D` : ''}${time ? `T${time}` : ''}`;
+}
+
+/**
+ * Parse an ISO 8601 duration string and return milliseconds. This is the
+ * inverse of `formatISO`.
+ *
+ * Supported designators are weeks (`W`), days (`D`), hours (`H`), minutes
+ * (`M`, after the `T`) and seconds (`S`). Years and months are ambiguous and
+ * are not supported. Components may have a decimal fraction (`.` or `,`), and
+ * the string may be prefixed with `-` or `+`. The result is rounded to the
+ * nearest millisecond.
+ *
+ * @example
+ * parseISO("PT1H30M"); // 5400000
+ * parseISO("P1DT1H1M1S"); // 90061000
+ *
+ * @param str - An ISO 8601 duration string
+ * @returns The parsed value in milliseconds, or `NaN` if the string is not a
+ * supported ISO 8601 duration
+ */
+export function parseISO(str: string): number {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw new Error(
+      `Value provided to ms.parseISO() must be a string with length between 1 and 99. value=${JSON.stringify(str)}`,
+    );
+  }
+
+  let i = 0;
+  let sign = 1;
+  if (str[i] === '-' || str[i] === '+') {
+    sign = str[i] === '-' ? -1 : 1;
+    i++;
+  }
+  if (str[i] !== 'P') {
+    return NaN;
+  }
+  i++;
+
+  // Designators in the order they must appear, per section.
+  const dateUnits: Record<string, number> = { W: w, D: d };
+  const timeUnits: Record<string, number> = { H: h, M: m, S: s };
+
+  let units = dateUnits;
+  let order = ['W', 'D'];
+  let total = 0;
+  let components = 0;
+  let inTime = false;
+  let sawTimeComponent = false;
+  let num = '';
+
+  for (; i < str.length; i++) {
+    const c = str[i] as string;
+    if (c === 'T') {
+      if (inTime || num !== '') {
+        return NaN;
+      }
+      inTime = true;
+      units = timeUnits;
+      order = ['H', 'M', 'S'];
+      continue;
+    }
+    if ((c >= '0' && c <= '9') || c === '.' || c === ',') {
+      num += c;
+      continue;
+    }
+    const idx = order.indexOf(c);
+    if (idx === -1 || !isDecimal(num)) {
+      return NaN;
+    }
+    total += parseFloat(num.replace(',', '.')) * (units[c] as number);
+    // Drop this designator and all earlier ones: each may appear only once,
+    // in descending order.
+    order = order.slice(idx + 1);
+    components++;
+    if (inTime) sawTimeComponent = true;
+    num = '';
+  }
+
+  // Trailing number without a designator, no components, or a dangling "T".
+  if (num !== '' || components === 0 || (inTime && !sawTimeComponent)) {
+    return NaN;
+  }
+
+  const result = Math.round(total) * sign;
+  // Avoid returning -0 for "-PT0S".
+  return result === 0 ? 0 : result;
+}
+
+/**
+ * Whether `s` is digits with an optional single fractional part, e.g. `1`,
+ * `1.5`, `0,25`.
+ */
+function isDecimal(s: string): boolean {
+  let digitsBefore = 0;
+  let digitsAfter = 0;
+  let seenSeparator = false;
+  for (const c of s) {
+    if (c === '.' || c === ',') {
+      if (seenSeparator) return false;
+      seenSeparator = true;
+    } else if (seenSeparator) {
+      digitsAfter++;
+    } else {
+      digitsBefore++;
+    }
+  }
+  return digitsBefore > 0 && (!seenSeparator || digitsAfter > 0);
+}
