   const parsed = parseURL(input);
   return (parsed.pathname || "/") + parsed.search + parsed.hash;
 }
+
+function _resolveOrigin(input: unknown): string | undefined {
+  if (typeof input !== "string") {
+    return undefined;
+  }
+  // WHATWG URL strips tabs/newlines anywhere and trims control/space edges
+  const str = input.replace(/[\t\n\r]/g, "").trim();
+  let url: URL;
+  try {
+    url = new URL(str);
+  } catch {
+    return undefined;
+  }
+  // Opaque origins (data:, blob:, file:, javascript:, ...) never match
+  if (url.origin === "null" || !url.hostname) {
+    return undefined;
+  }
+  // `URL` drops default ports, so read the port as written from the authority
+  const authority = str
+    .slice(str.indexOf(":") + 1)
+    .replace(/^[/\\]+/, "")
+    .split(/[/\\?#]/, 1)[0]!;
+  const port =
+    /:(\d*)$/.exec(authority.slice(authority.lastIndexOf("@") + 1))?.[1] ?? "";
+  return `${url.protocol}//${url.hostname}${port ? `:${port}` : ""}`;
+}
+
+/**
+ * Check if two URLs have the same origin (protocol, hostname and port).
+ *
+ * Path, query, hash and credentials are ignored. Protocol and hostname are
+ * case-insensitive. Ports are compared as written (`https://a.com` and
+ * `https://a.com:443` are different). Relative, protocol-relative, empty or
+ * opaque (`data:`, `file:`, ...) inputs never match.
+ *
+ * @example
+ * ```js
+ * isSameOrigin("https://example.com/a", "https://example.com/b"); // true
+ * isSameOrigin("https://example.com", "https://example.com.evil.com"); // false
+ * ```
+ *
+ * @group utils
+ */
+export function isSameOrigin(a: string, b: string): boolean {
+  const originA = _resolveOrigin(a);
+  return originA !== undefined && originA === _resolveOrigin(b);
+}
