diff --git a/test_schema.py b/test_schema.py
index 4d78456..2e9a2b3 100644
--- a/test_schema.py
+++ b/test_schema.py
@@ -25,6 +25,7 @@ from schema import (
     Optional,
     Or,
     Regex,
+    Length,
     Schema,
     SchemaError,
     SchemaForbiddenKeyError,
@@ -2100,3 +2101,40 @@ def test_tuple_key_error_message_does_not_crash():
     with raises(SchemaError) as exc_info:
         Schema({("a", "b"): int}).validate({("a", "b"): "not-an-int"})
     assert "Key '('a', 'b')' error:" in exc_info.value.code
+
+
+def test_length_counts_utf8_bytes():
+    assert Length(min=1, max=3).validate("abc") == "abc"
+    assert Length(max=3).validate("") == ""
+    assert Length(min=2).validate("é") == "é"  # 2 bytes
+    with raises(SchemaError):
+        Length(max=3).validate("abcd")
+    with raises(SchemaError):
+        Length(max=3).validate("éé")  # 2 chars, 4 bytes
+    with raises(SchemaError):
+        Length(min=3).validate("é")
+    assert Length().validate("anything") == "anything"
+
+
+def test_length_errors_and_types():
+    with raises(SchemaError) as e:
+        Length(max=2).validate("secret")
+    assert "secret" not in str(e.value)
+    with raises(SchemaError):
+        Length(max=2).validate(1)
+    with raises(SchemaError):
+        Length(max=2).validate("\ud800")
+    with raises(ValueError):
+        Length(min=3, max=2)
+    with raises(SchemaError) as e:
+        Schema({"a": Length(max=1, error="too long")}).validate({"a": "xx"})
+    assert "too long" in str(e.value)
+
+
+def test_length_in_schema_and_json_schema():
+    assert Schema({"a": Length(1, 4)}).validate({"a": "ab"}) == {"a": "ab"}
+    assert Schema({"a": Length(2, 8)}).json_schema("x")["properties"]["a"] == {
+        "type": "string",
+        "minLength": 1,
+        "maxLength": 8,
+    }
