+class Length:
+    """
+    Validates that a string's size is within inclusive bounds.
+
+    Bounds count UTF-8 encoded bytes, not characters, because the values end up
+    in byte-sized columns (e.g. Oracle VARCHAR2(n BYTE)) where accented
+    characters take more than one byte.
+    """
+
+    def __init__(
+        self,
+        min: Union[int, None] = None,
+        max: Union[int, None] = None,
+        error: Union[str, None] = None,
+    ) -> None:
+        if min is not None and max is not None and min > max:
+            raise ValueError("min (%r) must not be greater than max (%r)" % (min, max))
+        self._min: Union[int, None] = min
+        self._max: Union[int, None] = max
+        self._error: Union[str, None] = error
+
+    def __repr__(self) -> str:
+        return f"{self.__class__.__name__}(min={self._min!r}, max={self._max!r})"
+
+    @property
+    def min(self) -> Union[int, None]:
+        return self._min
+
+    @property
+    def max(self) -> Union[int, None]:
+        return self._max
+
+    def validate(self, data: str, **kwargs: Any) -> str:
+        """
+        Validates that the UTF-8 byte length of data is within the bounds.
+        :param data: String to be validated.
+        :return: Returns validated data.
+        """
+        e = self._error
+        if not isinstance(data, str):
+            raise SchemaError(e.format(data) if e else "value is not a string")
+        try:
+            size = len(data.encode("utf-8"))
+        except UnicodeEncodeError:
+            # e.g. lone surrogates cannot be stored as UTF-8
+            raise SchemaError(e.format(data) if e else "string is not valid UTF-8")
+        if (self._min is not None and size < self._min) or (
+            self._max is not None and size > self._max
+        ):
+            # Deliberately do not echo the value: it may be sensitive or huge.
+            raise SchemaError(
+                e.format(data)
+                if e
+                else "string of %d UTF-8 bytes is not within %r" % (size, self)
+            )
+        return data
+
+
