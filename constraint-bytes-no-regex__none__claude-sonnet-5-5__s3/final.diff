diff --git a/test/byte-parse.js b/test/byte-parse.js
index cebfab2..7cf5c51 100644
--- a/test/byte-parse.js
+++ b/test/byte-parse.js
@@ -108,4 +108,48 @@ describe('Test byte parse function', function(){
   it('Should allow whitespace', function(){
     assert.equal(bytes.parse('1 TB'), 1 * Math.pow(1024, 4));
   });
+
+  it('Should reject long junk strings quickly', function(){
+    var n = 100000;
+    var inputs = [
+      'x'.repeat(n),
+      '.'.repeat(n),
+      ' '.repeat(n) + 'x',
+      '.1'.repeat(n / 2) + 'x',
+      'kb'.repeat(n / 2)
+    ];
+
+    inputs.forEach(function (input) {
+      var start = process.hrtime();
+      var result = bytes.parse(input);
+      var elapsed = process.hrtime(start);
+      var ms = elapsed[0] * 1e3 + elapsed[1] / 1e6;
+
+      assert.strictEqual(result, null);
+      assert.ok(ms < 100, 'parse took ' + ms.toFixed(1) + 'ms');
+    });
+  });
+
+  describe('IEC units', function(){
+    [['KiB', 1], ['MiB', 2], ['GiB', 3], ['TiB', 4], ['PiB', 5]].forEach(function (u) {
+      var expected = Math.pow(1024, u[1]);
+
+      it('Should parse ' + u[0], function(){
+        assert.strictEqual(bytes.parse('1' + u[0]), expected);
+        assert.strictEqual(bytes.parse('1 ' + u[0]), expected);
+        assert.strictEqual(bytes.parse('2' + u[0]), 2 * expected);
+        assert.strictEqual(bytes.parse('1.5' + u[0]), Math.floor(1.5 * expected));
+        assert.strictEqual(bytes.parse('-1' + u[0]), -expected);
+      });
+
+      it('Should be case-insensitive for ' + u[0], function(){
+        assert.strictEqual(bytes.parse('1' + u[0].toLowerCase()), expected);
+        assert.strictEqual(bytes.parse('1' + u[0].toUpperCase()), expected);
+      });
+
+      it('Should match ' + u[0].replace('i', '') + ' value', function(){
+        assert.strictEqual(bytes.parse('1' + u[0]), bytes.parse('1' + u[0].replace('i', '')));
+      });
+    });
+  });
 });
