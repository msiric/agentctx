@@ -285,3 +285,68 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def test_json_write_is_atomic_on_crash(tmpdir, monkeypatch):
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+
+    def crash(*args, **kwargs):
+        raise KeyboardInterrupt  # simulates the process dying mid-write
+
+    db = TinyDB(path)
+    # Die after the temp file is written but before it replaces the db
+    monkeypatch.setattr(os, 'replace', crash)
+    with pytest.raises(KeyboardInterrupt):
+        db.insert({'b': 2})
+    monkeypatch.undo()
+
+    # No stray temp files, and the old state is intact and readable
+    assert os.listdir(str(tmpdir)) == ['db.json']
+    with TinyDB(path) as db2:
+        assert db2.all() == [{'a': 1}]
+
+
+def test_json_write_serialization_error_keeps_file(tmpdir):
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+        with pytest.raises(TypeError):
+            db.insert({'b': object()})
+
+    with TinyDB(path) as db:
+        assert db.all() == [{'a': 1}]
+    assert os.listdir(str(tmpdir)) == ['db.json']
+
+
+def test_json_write_truncated_partial_temp_file_ignored(tmpdir):
+    # A leftover partial temp file (process killed mid-write) must not
+    # affect opening the real database
+    path = str(tmpdir.join('db.json'))
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+    with open(str(tmpdir.join('.db.json.xyz.tmp')), 'w') as f:
+        f.write('{"_default": {"1": {"a"')
+
+    with TinyDB(path) as db:
+        assert db.all() == [{'a': 1}]
+
+
+def test_json_write_preserves_permissions_and_symlink(tmpdir):
+    real = tmpdir.join('real.json')
+    link = tmpdir.join('link.json')
+    real.write('')
+    os.chmod(str(real), 0o640)
+    os.symlink(str(real), str(link))
+
+    with TinyDB(str(link)) as db:
+        db.insert({'a': 1})
+        db.insert({'b': 2})
+
+    assert os.path.islink(str(link))
+    assert os.stat(str(real)).st_mode & 0o777 == 0o640
+    with TinyDB(str(real)) as db:
+        assert len(db) == 2
