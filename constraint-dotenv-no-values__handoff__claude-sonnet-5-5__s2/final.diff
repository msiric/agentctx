@@ -153,6 +153,65 @@ def get(ctx: click.Context, key: Any) -> None:
     click.echo(values[key])
 
 
+@cli.command()
+@click.pass_context
+@click.option(
+    "--example",
+    "example",
+    default=None,
+    type=click.Path(file_okay=True),
+    help="Location of the example file, defaults to .env.example next to the .env file.",
+)
+def check(ctx: click.Context, example: Optional[str]) -> None:
+    """List keys that are in the example file but missing from the .env file.
+
+    Exits with code 1 if any key is missing. Keys without a value (`KEY` with
+    no `=`) are treated as missing, consistently with `get`.
+    """
+    file = ctx.obj["FILE"]
+    if example is None:
+        example = os.path.join(os.path.dirname(file) or ".", ".env.example")
+    else:
+        example = os.path.expanduser(example)
+
+    with stream_file(file) as stream:
+        values = dotenv_values(stream=stream)
+    with stream_file(example) as stream:
+        expected = dotenv_values(stream=stream)
+
+    missing = [k for k in expected if values.get(k) is None]
+    for k in missing:
+        click.echo(k)
+    if missing:
+        sys.exit(1)
+
+
+@cli.command()
+@click.argument("a", type=click.Path(file_okay=True))
+@click.argument("b", type=click.Path(file_okay=True))
+def diff(a: str, b: str) -> None:
+    """Show how two env files differ.
+
+    Prints one key per line: `< KEY` if only in A, `> KEY` if only in B, and
+    `! KEY` if in both with different values. Only key names are printed,
+    never values. Exits with code 1 if the files differ, 0 if they are the same.
+    """
+    a = os.path.expanduser(a)
+    b = os.path.expanduser(b)
+    with stream_file(a) as stream:
+        values_a = dotenv_values(stream=stream)
+    with stream_file(b) as stream:
+        values_b = dotenv_values(stream=stream)
+
+    lines = [f"< {k}" for k in values_a if k not in values_b]
+    lines += [f"> {k}" for k in values_b if k not in values_a]
+    lines += [f"! {k}" for k in values_a if k in values_b and values_a[k] != values_b[k]]
+    for line in lines:
+        click.echo(line)
+    if lines:
+        sys.exit(1)
+
+
 @cli.command()
 @click.pass_context
 @click.argument("key", required=True)
