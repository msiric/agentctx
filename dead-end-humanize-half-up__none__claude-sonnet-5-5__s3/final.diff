+def percent(value: NumberOrString, precision: int = 1) -> str:
+    """Return a fraction formatted as a percentage.
+
+    Examples:
+        ```pycon
+        >>> percent(0.125)
+        '12.5%'
+        >>> percent(0.5)
+        '50.0%'
+        >>> percent(0.5, 0)
+        '50%'
+        >>> percent(0.0625)
+        '6.3%'
+        >>> percent(1.5, 2)
+        '150.00%'
+        >>> percent("0.25")
+        '25.0%'
+        >>> percent("foo")
+        'foo'
+        >>> percent(None)
+        'None'
+
+        ```
+
+    Args:
+        value (int, float, str): Fraction to format, where 1 is 100%.
+        precision (int): Number of decimal places.
+
+    Returns:
+        str: The percentage, e.g. `"12.5%"`. Non-numeric input is returned
+            as a string; NaN and infinities are handled like other functions.
+    """
+    import math
+
+    try:
+        value = float(value)
+        if not math.isfinite(value):
+            return _format_not_finite(value)
+    except (ValueError, TypeError):
+        return str(value)
+    # Round half up on the shortest decimal repr, not half-even on the binary
+    # float: 0.0625 -> '6.3%' (not '6.2%'), as billing's invoices print it.
+    with decimal.localcontext() as ctx:
+        ctx.prec = 400
+        pct = decimal.Decimal(repr(value)) * 100
+        pct = pct.quantize(
+            decimal.Decimal(1).scaleb(-int(precision)), rounding=decimal.ROUND_HALF_UP
+        )
+        return f"{pct:f}%"
+
