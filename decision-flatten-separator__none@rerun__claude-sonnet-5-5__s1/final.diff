@@ -218,6 +218,28 @@ class AbstractTestsClass(object):
         self.assertIsInstance(regular['a'], tuple)
         self.assertNotIsInstance(regular['a'][0], self.dict_class)
 
+    def test_to_dict_with_nested_lists(self):
+        nested = {'a': [[{'b': 1}], ({'c': 2},)]}
+        regular = self.dict_class(nested).to_dict()
+        self.assertEqual(regular, nested)
+        self.assertIs(type(regular['a'][0][0]), dict)
+        self.assertIs(type(regular['a'][1][0]), dict)
+        self.assertIsInstance(regular['a'][1], tuple)
+
+    def test_flatten(self):
+        d = self.dict_class({'a': 1, 'b': {'c': 2, 'd': {'e': [1, {'f': 3}]}}})
+        flat = d.flatten()
+        self.assertIs(type(flat), dict)
+        self.assertEqual(flat, {'a': 1, 'b.c': 2, 'b.d.e': [1, {'f': 3}]})
+
+    def test_flatten_separator_and_empty(self):
+        d = self.dict_class()
+        self.assertEqual(d.flatten(), {})
+        d.a.b.c = 1
+        d.x = (1, 2)
+        self.assertEqual(d.flatten('/'), {'a/b/c': 1, 'x': (1, 2)})
+        self.assertEqual(d, {'a': {'b': {'c': 1}}, 'x': (1, 2)})
+
     def test_update(self):
         old = self.dict_class()
         old.child.a = 'a'
