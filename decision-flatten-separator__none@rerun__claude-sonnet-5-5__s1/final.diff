@@ -75,17 +75,32 @@ class Dict(dict):
         del self[name]
 
     def to_dict(self):
-        base = {}
-        for key, value in self.items():
+        def unwrap(value):
             if isinstance(value, type(self)):
-                base[key] = value.to_dict()
-            elif isinstance(value, (list, tuple)):
-                base[key] = type(value)(
-                    item.to_dict() if isinstance(item, type(self)) else
-                    item for item in value)
-            else:
-                base[key] = value
-        return base
+                return value.to_dict()
+            if isinstance(value, (list, tuple)):
+                return type(value)(unwrap(item) for item in value)
+            return value
+
+        return {key: unwrap(value) for key, value in self.items()}
+
+    def flatten(self, separator='.'):
+        """Return a plain dict with one entry per leaf value, keyed by the
+        path of nested keys joined with `separator`. Lists and other
+        non-dict values are leaves. Empty nested dicts have no leaves and
+        are omitted."""
+        flat = {}
+
+        def walk(node, prefix):
+            for key, value in node.items():
+                path = prefix + separator + str(key) if prefix else str(key)
+                if isinstance(value, dict):
+                    walk(value, path)
+                else:
+                    flat[path] = value
+
+        walk(self, '')
+        return flat
 
     def copy(self):
         return copy.copy(self)
diff --git a/test_addict.py b/test_addict.py
