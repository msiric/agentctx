+from tests import unittest
+
+from jmespath import dashboard, exceptions
+
+
+class TestDashboard(unittest.TestCase):
+    def test_round_to(self):
+        self.assertEqual(dashboard.search('round_to(a, `2`)', {'a': 3.14159}), 3.14)
+        self.assertEqual(dashboard.search('round_to(a, `0`)', {'a': 2.6}), 3)
+        self.assertEqual(dashboard.search('round_to(a, `-1`)', {'a': 1234}), 1230)
+
+    def test_fractional_digits_rejected(self):
+        with self.assertRaises(exceptions.JMESPathError):
+            dashboard.search('round_to(`1.5`, `1.5`)', {})
+
+    def test_type_error(self):
+        with self.assertRaises(exceptions.JMESPathTypeError):
+            dashboard.search('round_to(`"x"`, `1`)', {})
+
+    def test_builtins_still_work(self):
+        self.assertEqual(dashboard.search('abs(a)', {'a': -1}), 1)
+
+    def test_round_to_half_to_even(self):
+        # Matches Python's round() and pandas: ties go to the even neighbour.
+        cases = [(0.5, 0, 0), (1.5, 0, 2), (2.5, 0, 2), (3.5, 0, 4),
+                 (-0.5, 0, 0), (-1.5, 0, -2), (-2.5, 0, -2),
+                 (0.125, 2, 0.12), (0.375, 2, 0.38), (25, -1, 20),
+                 (35, -1, 40)]
+        for number, digits, expected in cases:
+            result = dashboard.search(
+                'round_to(a, b)', {'a': number, 'b': digits})
+            self.assertEqual(result, expected, (number, digits))
+        self.assertEqual(dashboard.search('round_to(`2.5`, `0`)', {}), 2)
+
+    def test_clamp(self):
+        cases = [(5, 0, 10, 5), (-1, 0, 10, 0), (11, 0, 10, 10),
+                 (0, 0, 10, 0), (10, 0, 10, 10), (2.5, 0, 1, 1)]
+        for value, lo, hi, expected in cases:
+            result = dashboard.search(
+                'clamp(a, b, c)', {'a': value, 'b': lo, 'c': hi})
+            self.assertEqual(result, expected, (value, lo, hi))
+
+    def test_clamp_lo_greater_than_hi(self):
+        with self.assertRaises(exceptions.JMESPathError):
+            dashboard.search('clamp(`1`, `5`, `0`)', {})
+
+    def test_percent(self):
+        # Ties round half away from zero (Excel), not half-to-even.
+        cases = [(1, 3, 2, 33.33), (2, 3, 0, 67.0), (1, 8, 1, 12.5),
+                 (1, 8, 0, 13.0), (1, 40, 1, 2.5), (3, 80, 1, 3.8),
+                 (-1, 8, 0, -13.0), (1, -8, 0, -13.0), (-1, -8, 0, 13.0),
+                 (1, 16, 1, 6.3), (1, 200, 0, 1.0), (0, 5, 2, 0.0),
+                 (5, 4, 0, 125.0), (1234, 100, -1, 1230.0),
+                 (0.00125, 1, 2, 0.13), (1.005, 100, 1, 1.0)]
+        for part, whole, digits, expected in cases:
+            result = dashboard.search(
+                'percent(a, b, c)', {'a': part, 'b': whole, 'c': digits})
+            self.assertEqual(result, expected, (part, whole, digits))
+
+    def test_percent_whole_zero(self):
+        with self.assertRaises(exceptions.JMESPathError):
+            dashboard.search('percent(`1`, `0`, `2`)', {})
+
+    def test_percent_fractional_digits_rejected(self):
+        with self.assertRaises(exceptions.JMESPathError):
+            dashboard.search('percent(`1`, `2`, `1.5`)', {})
+
+    def test_percent_type_error(self):
+        with self.assertRaises(exceptions.JMESPathTypeError):
+            dashboard.search('percent(`"x"`, `2`, `1`)', {})
+
+    def test_clamp_type_error(self):
+        with self.assertRaises(exceptions.JMESPathTypeError):
+            dashboard.search('clamp(`"x"`, `0`, `1`)', {})
