new file mode 100644
index 0000000..36344d3
--- /dev/null
+++ b/HANDOFF.md
@@ -0,0 +1,5 @@
+# HANDOFF
+Task: `skip_none` flag on `Dict.to_dict()` (addict/addict.py), default False.
+- Drops None-valued keys at every level, including dicts inside lists/tuples. None *list items* are kept (only keys are skipped).
+- Refactored into helper `_to_plain`, which also now recurses into lists nested in lists (previously not converted).
+- Tests: test_to_dict_skip_none*, in test_addict.py. All pass.
diff --git a/addict/addict.py b/addict/addict.py
index 55e02d1..911658f 100644
--- a/addict/addict.py
+++ b/addict/addict.py
@@ -74,19 +74,22 @@ class Dict(dict):
     def __delattr__(self, name):
         del self[name]
 
-    def to_dict(self):
+    def to_dict(self, skip_none=False):
         base = {}
         for key, value in self.items():
-            if isinstance(value, type(self)):
-                base[key] = value.to_dict()
-            elif isinstance(value, (list, tuple)):
-                base[key] = type(value)(
-                    item.to_dict() if isinstance(item, type(self)) else
-                    item for item in value)
-            else:
-                base[key] = value
+            if skip_none and value is None:
+                continue
+            base[key] = self._to_plain(value, skip_none)
         return base
 
+    def _to_plain(self, value, skip_none):
+        if isinstance(value, type(self)):
+            return value.to_dict(skip_none=skip_none)
+        if isinstance(value, (list, tuple)):
+            return type(value)(
+                self._to_plain(item, skip_none) for item in value)
+        return value
+
     def copy(self):
         return copy.copy(self)
 
