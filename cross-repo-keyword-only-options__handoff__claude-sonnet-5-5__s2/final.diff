+    def test_to_dict_skip_none_default_off(self):
+        prop = self.dict_class({'a': None, 'b': {'c': None}})
+        self.assertDictEqual(prop.to_dict(), {'a': None, 'b': {'c': None}})
+
+    def test_to_dict_skip_none(self):
+        prop = self.dict_class({
+            'a': None, 'b': 1,
+            'c': {'d': None, 'e': 2, 'f': {'g': None}},
+            'h': [{'i': None, 'j': 3}, None, 4],
+            'k': ({'l': None},),
+        })
+        regular = prop.to_dict(skip_none=True)
+        self.assertDictEqual(regular, {
+            'b': 1,
+            'c': {'e': 2, 'f': {}},
+            'h': [{'j': 3}, None, 4],
+            'k': ({},),
+        })
+        self.assertNotIsInstance(regular['c'], self.dict_class)
+        self.assertNotIsInstance(regular['h'][0], self.dict_class)
+        self.assertIsInstance(regular['k'], tuple)
+        # original untouched
+        self.assertIsNone(prop['a'])
+
     def test_update(self):
         old = self.dict_class()
         old.child.a = 'a'
