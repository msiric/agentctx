+describe("constantCase", () => {
+  test.each([
+    ["", ""],
+    ["foo", "FOO"],
+    ["fooBar", "FOO_BAR"],
+    ["foo-bar_baz", "FOO_BAR_BAZ"],
+    ["FooBARb", "FOO_BA_RB"],
+    ["FOO_BAR", "FOO_BAR"],
+    ["foo--bar-Baz", "FOO_BAR_BAZ"],
+  ])("%s => %s", (input, expected) => {
+    expect(constantCase(input)).toBe(expected);
+  });
+
+  test("array input", () => {
+    expect(constantCase(["foo", "bar"])).toBe("FOO_BAR");
+  });
+});
