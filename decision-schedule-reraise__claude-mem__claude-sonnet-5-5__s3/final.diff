+    def test_run_all_sleeps_only_between_jobs(self):
+        mock_job = make_mock_job()
+        every().minute.do(mock_job)
+        every().hour.do(mock_job)
+        every().day.do(mock_job)
+        with mock.patch("schedule.time.sleep") as mock_sleep:
+            schedule.run_all(delay_seconds=5)
+        assert mock_job.call_count == 3
+        assert mock_sleep.call_count == 2
+
+    def test_run_pending_runs_remaining_jobs_after_failure(self):
+        failing = mock.Mock(side_effect=ValueError("boom"), __name__="failing")
+        ok = make_mock_job()
+        for f in (failing, ok):
+            j = every().hour.do(f)
+            j.next_run = datetime.datetime.now() - datetime.timedelta(seconds=1)
+        with self.assertRaises(ValueError):
+            schedule.run_pending()
+        assert failing.call_count == 1
+        assert ok.call_count == 1
+
+    def test_run_pending_reschedules_failed_job(self):
+        failing = mock.Mock(side_effect=ValueError("boom"), __name__="failing")
+        job = every().hour.do(failing)
+        job.next_run = datetime.datetime.now() - datetime.timedelta(seconds=1)
+        with self.assertRaises(ValueError):
+            schedule.run_pending()
+        assert job.last_run is not None
+        assert job.next_run > datetime.datetime.now()
+        schedule.run_pending()  # no longer due, does not raise again
+        assert failing.call_count == 1
+
+    def test_run_pending_logs_additional_failures(self):
+        first = mock.Mock(side_effect=ValueError("first"), __name__="first")
+        second = mock.Mock(side_effect=KeyError("second"), __name__="second")
+        for f in (first, second):
+            j = every().hour.do(f)
+            j.next_run = datetime.datetime.now() - datetime.timedelta(seconds=1)
+        with self.assertLogs("schedule", level="ERROR"):
+            with self.assertRaises((ValueError, KeyError)):
+                schedule.run_pending()
+        assert first.call_count == 1
+        assert second.call_count == 1
+
