     db.close()
+
+
+def test_to_csv_default_fields(db, tmp_path):
+    import csv
+    db.truncate()
+    db.insert({'a': 1, 'b': 'x'})
+    db.insert({'c': True, 'a': 2})
+    out = tmp_path / 'out.csv'
+    db.table('_default').to_csv(out)
+
+    with open(out, newline='', encoding='utf-8') as f:
+        rows = list(csv.reader(f))
+    assert rows == [['a', 'b', 'c'], ['1', 'x', ''], ['2', '', 'True']]
+
+
+def test_to_csv_fields_select_and_order(db, tmp_path):
+    import csv
+    db.truncate()
+    db.insert({'a': 1, 'b': 2})
+    db.insert({'a': 3})
+    out = tmp_path / 'out.csv'
+    db.table('_default').to_csv(str(out), fields=['b', 'a', 'zzz'])
+
+    with open(out, newline='', encoding='utf-8') as f:
+        rows = list(csv.reader(f))
+    assert rows == [['b', 'a', 'zzz'], ['2', '1', ''], ['', '3', '']]
+
+
+def test_to_csv_empty_table(db, tmp_path):
+    db.truncate()
+    out = tmp_path / 'out.csv'
+    db.table('_default').to_csv(out, fields=['a'])
+    assert out.read_text(encoding='utf-8').splitlines() == ['a']
+
+
+def test_to_csv_quoting(db, tmp_path):
+    import csv
+    db.truncate()
+    db.insert({'a': 'x,"y"\nz'})
+    out = tmp_path / 'out.csv'
+    db.table('_default').to_csv(out)
+    with open(out, newline='', encoding='utf-8') as f:
+        assert list(csv.reader(f)) == [['a'], ['x,"y"\nz']]
