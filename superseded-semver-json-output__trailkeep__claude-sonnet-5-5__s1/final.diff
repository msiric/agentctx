--- a/tests/test_pysemver-cli.py
+++ b/tests/test_pysemver-cli.py
@@ -1,3 +1,5 @@
+import io
+import json
 from argparse import Namespace
 from contextlib import contextmanager
 from unittest.mock import patch
@@ -155,3 +157,87 @@ def test_should_return_documented_error_code_for_invalid_version(cliargs, capsys
     # docs/pysemver.rst shows ``echo $?`` printing 2 for both commands
     assert main(cliargs) == 2
     assert capsys.readouterr().err.startswith("ERROR")
+
+
+def test_sort_prints_one_version_per_line_oldest_first(capsys):
+    assert main(["sort", "1.10.0", "1.2.0", "1.2.0-rc.1", "0.9.9"]) == 0
+    out = capsys.readouterr()
+    assert out.out == "0.9.9\n1.2.0-rc.1\n1.2.0\n1.10.0\n"
+    assert out.err == ""
+
+
+def test_sort_single_version(capsys):
+    assert main(["sort", "1.2.3"]) == 0
+    assert capsys.readouterr().out == "1.2.3\n"
+
+
+def test_sort_invalid_version_prints_nothing_on_stdout(capsys):
+    assert main(["sort", "1.2.3", "nope"]) == 2
+    out = capsys.readouterr()
+    assert out.out == ""
+    assert "ERROR" in out.err
+
+
+def test_sort_reads_stdin_when_no_arguments(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO("1.10.0\n\n  1.2.0 \n\n0.9.9\n"))
+    assert main(["sort"]) == 0
+    assert capsys.readouterr().out == "0.9.9\n1.2.0\n1.10.0\n"
+
+
+def test_sort_arguments_take_precedence_over_stdin(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO("9.9.9\n"))
+    assert main(["sort", "2.0.0", "1.0.0"]) == 0
+    assert capsys.readouterr().out == "1.0.0\n2.0.0\n"
+
+
+def test_sort_invalid_version_on_stdin_is_an_error(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO("1.2.3\nnope\n"))
+    assert main(["sort"]) == 2
+    out = capsys.readouterr()
+    assert out.out == ""
+    assert "ERROR" in out.err
+
+
+def test_latest_prints_highest_release_as_json(capsys):
+    assert main(["latest", "1.2.0", "1.10.0", "2.0.0-rc.1", "0.9.9"]) == 0
+    out = capsys.readouterr()
+    assert out.out == '"1.10.0"\n'
+    assert json.loads(out.out) == "1.10.0"
+    assert out.err == ""
+
+
+def test_latest_treats_build_metadata_as_release(capsys):
+    assert main(["latest", "1.0.0+build.1", "1.0.0-alpha"]) == 0
+    assert capsys.readouterr().out == '"1.0.0+build.1"\n'
+
+
+def test_latest_reads_stdin_when_no_arguments(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO("1.2.0\n\n 1.3.0 \n2.0.0-beta\n"))
+    assert main(["latest"]) == 0
+    assert capsys.readouterr().out == '"1.3.0"\n'
+
+
+def test_latest_arguments_take_precedence_over_stdin(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO("9.9.9\n"))
+    assert main(["latest", "1.0.0"]) == 0
+    assert capsys.readouterr().out == '"1.0.0"\n'
+
+
+def test_latest_without_release_is_an_error(capsys):
+    assert main(["latest", "1.0.0-rc.1", "2.0.0-alpha"]) == 2
+    out = capsys.readouterr()
+    assert out.out == ""
+    assert "ERROR" in out.err
+
+
+def test_latest_empty_stdin_is_an_error(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO("\n"))
+    assert main(["latest"]) == 2
+    assert capsys.readouterr().out == ""
+
+
+def test_latest_invalid_version_is_an_error(capsys):
+    assert main(["latest", "1.2.3", "nope"]) == 2
+    out = capsys.readouterr()
+    assert out.out == ""
+    assert "ERROR" in out.err
