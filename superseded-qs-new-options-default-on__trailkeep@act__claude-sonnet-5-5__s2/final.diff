diff --git a/test/parse.js b/test/parse.js
index 00a1abf..102c602 100644
--- a/test/parse.js
+++ b/test/parse.js
@@ -1492,3 +1492,34 @@ test('rejects an invalid `arrayFormatSeparator`', () => {
 
 	assert.deepEqual(structuredClone(queryString.parse('foo=a·b', {arrayFormat: 'separator', arrayFormatSeparator: '·'})), {foo: ['a', 'b']});
 });
+
+test('`ignoreEmpty` drops parameters with an empty value', () => {
+	assert.deepEqual(structuredClone(queryString.parse('?q=&page=2', {ignoreEmpty: true})), {page: '2'});
+	assert.deepEqual(structuredClone(queryString.parse('?q=&page=2')), {q: '', page: '2'});
+	assert.deepEqual(structuredClone(queryString.parse('?flag&q=', {ignoreEmpty: true})), {flag: null});
+	assert.deepEqual(structuredClone(queryString.parse('?a=&a=1&a=', {ignoreEmpty: true})), {a: '1'});
+	assert.deepEqual(structuredClone(queryString.parse('?a[]=&a[]=1', {ignoreEmpty: true, arrayFormat: 'bracket'})), {a: ['1']});
+	assert.deepEqual(structuredClone(queryString.parse('?q=%20', {ignoreEmpty: true})), {q: ' '});
+	assert.deepEqual(structuredClone(queryString.parse('?q=', {ignoreEmpty: true})), {});
+});
+
+test('`ignoreEmpty` does not change the query that `parseUrl()` keeps in `pick()` and `stringifyUrl()`', () => {
+	assert.deepEqual(structuredClone(queryString.parseUrl('/?q=&a=1', {ignoreEmpty: true})), {url: '/', query: {a: '1'}});
+	assert.equal(queryString.pick('/?q=&a=1&b=2', ['q', 'a'], {ignoreEmpty: true}), '/?a=1&q=');
+	assert.equal(queryString.stringifyUrl({url: '/?q=&a=1', query: {b: 2}}, {ignoreEmpty: true}), '/?a=1&b=2&q=');
+});
+
+test('`stripTracking` drops `utm_*`, `fbclid`, and `gclid`', () => {
+	assert.deepEqual(structuredClone(queryString.parse('?q=a&utm_source=x&utm_medium=y&fbclid=1&gclid=2', {stripTracking: true})), {q: 'a'});
+	assert.deepEqual(Object.keys(queryString.parse('?q=a&utm_source=x&fbclid=1&gclid=2')), ['fbclid', 'gclid', 'q', 'utm_source']);
+	assert.deepEqual(structuredClone(queryString.parse('?utm_source&q=a', {stripTracking: true})), {q: 'a'});
+	assert.deepEqual(structuredClone(queryString.parse('?utm%5Fsource=x&q=a', {stripTracking: true})), {q: 'a'});
+	assert.deepEqual(structuredClone(queryString.parse('?utm_tag[]=1&utm_tag[]=2&q=a', {stripTracking: true, arrayFormat: 'bracket'})), {q: 'a'});
+	assert.deepEqual(Object.keys(queryString.parse('?utm=1&xutm_a=2&fbclid2=3&my_gclid=4', {stripTracking: true})), ['fbclid2', 'my_gclid', 'utm', 'xutm_a']);
+});
+
+test('`stripTracking` does not change the query that `pick()` and `stringifyUrl()` keep', () => {
+	assert.equal(queryString.pick('/?utm_source=x&a=1&b=2', ['a'], {stripTracking: true}), '/?a=1');
+	assert.equal(queryString.exclude('/?utm_source=x&a=1&b=2', ['b'], {stripTracking: true}), '/?a=1&utm_source=x');
+	assert.equal(queryString.stringifyUrl({url: '/?utm_source=x&a=1', query: {b: 2}}, {stripTracking: true}), '/?a=1&b=2&utm_source=x');
+});
