diff --git a/test/same-origin.test.ts b/test/same-origin.test.ts
new file mode 100644
index 0000000..2332029
--- /dev/null
+++ b/test/same-origin.test.ts
@@ -0,0 +1,95 @@
+import { describe, expect, test } from "vitest";
+import { isSameOrigin } from "../src";
+
+describe("isSameOrigin", () => {
+  const sameOrigins = [
+    // Identical
+    ["https://example.com", "https://example.com"],
+    // Path, query and hash are ignored
+    ["https://example.com", "https://example.com/"],
+    ["https://example.com/foo", "https://example.com/bar"],
+    ["https://example.com/?a=1", "https://example.com/?b=2"],
+    ["https://example.com/#a", "https://example.com/#b"],
+    // Protocol and host are case-insensitive
+    ["HTTPS://example.com", "https://example.com"],
+    ["https://EXAMPLE.com", "https://example.com"],
+    // Default ports are normalized (CDN rewrites links with explicit ports)
+    ["https://example.com:443", "https://example.com"],
+    ["http://example.com:80", "http://example.com"],
+    ["wss://example.com:443", "wss://example.com"],
+    ["ws://example.com:80", "ws://example.com"],
+    // Identical explicit ports match each other
+    ["https://example.com:8080/a", "https://example.com:8080/b"],
+    ["https://example.com:443/a", "https://example.com:443/b"],
+    // Userinfo is not part of the origin
+    ["https://user:pass@example.com", "https://example.com"],
+    ["https://a@example.com", "https://b@example.com"],
+    // Internationalized hostnames (unicode and punycode forms)
+    ["https://тест.com", "https://xn--e1aybc.com"],
+    // IP hosts
+    ["http://127.0.0.1:3000/a", "http://127.0.0.1:3000/b"],
+    ["http://[::1]:3000/a", "http://[::1]:3000/b"],
+  ];
+
+  const notSameOrigins = [
+    // Different protocol
+    ["http://example.com", "https://example.com"],
+    ["ws://example.com", "wss://example.com"],
+    // Different host
+    ["https://example.com", "https://example.org"],
+    // Subdomains are different origins
+    ["https://example.com", "https://www.example.com"],
+    ["https://a.example.com", "https://b.example.com"],
+    // Different port
+    ["https://example.com:8080", "https://example.com"],
+    ["https://example.com:8080", "https://example.com:8081"],
+    // Mismatched ports on the same protocol
+    ["http://example.com:443", "http://example.com"],
+    ["https://example.com:80", "https://example.com"],
+    // Look-alike hosts (userinfo / suffix tricks)
+    ["https://example.com@evil.com", "https://example.com"],
+    ["https://example.com.evil.com", "https://example.com"],
+  ];
+
+  // Relative / origin-less inputs have no origin, so they never match
+  // (not even each other).
+  const noOrigin = [
+    ["/foo", "/foo"],
+    ["", ""],
+    ["foo/bar", "foo/bar"],
+    ["//example.com/foo", "//example.com/foo"],
+    ["/foo", "https://example.com/foo"],
+    ["//example.com", "https://example.com"],
+    ["mailto:a@example.com", "mailto:a@example.com"],
+    ["data:text/plain,hi", "data:text/plain,hi"],
+    ["javascript:void(0)", "javascript:void(0)"],
+    ["not a url", "not a url"],
+  ];
+
+  for (const [a, b] of sameOrigins) {
+    test(`${a} == ${b}`, () => {
+      expect(isSameOrigin(a, b)).toBe(true);
+      // Symmetric
+      expect(isSameOrigin(b, a)).toBe(true);
+    });
+  }
+
+  for (const [a, b] of notSameOrigins) {
+    test(`${a} != ${b}`, () => {
+      expect(isSameOrigin(a, b)).toBe(false);
+      expect(isSameOrigin(b, a)).toBe(false);
+    });
+  }
+
+  for (const [a, b] of noOrigin) {
+    test(`${JSON.stringify(a)} != ${JSON.stringify(b)} (no origin)`, () => {
+      expect(isSameOrigin(a, b)).toBe(false);
+      expect(isSameOrigin(b, a)).toBe(false);
+    });
+  }
+
+  test("does not throw on invalid input", () => {
+    expect(() => isSameOrigin("http://", "http://")).not.toThrow();
+    expect(() => isSameOrigin("https://[", "https://[")).not.toThrow();
+  });
+});
