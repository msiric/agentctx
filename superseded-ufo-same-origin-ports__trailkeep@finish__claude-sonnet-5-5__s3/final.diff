@@ -773,3 +782,48 @@ export function withoutHost(input: string) {
   const parsed = parseURL(input);
   return (parsed.pathname || "/") + parsed.search + parsed.hash;
 }
+
+const DEFAULT_PORTS: Record<string, string> = {
+  "http:": "80",
+  "https:": "443",
+  "ws:": "80",
+  "wss:": "443",
+  "ftp:": "21",
+};
+
+function _getOrigin(input: string): string | undefined {
+  const { protocol, host } = parseURL(input);
+  if (!protocol || !host || !hasProtocol(input, { strict: true })) {
+    return undefined;
+  }
+  const match = host.match(/^(\[[^\]]*\]|[^:]*)(?::(\d*))?$/);
+  if (!match || !match[1]) {
+    return undefined;
+  }
+  const hostname = encodeHost(decode(match[1])).toLowerCase();
+  let port = match[2] || "";
+  if (port === DEFAULT_PORTS[protocol.toLowerCase()]) {
+    port = "";
+  }
+  return `${protocol.toLowerCase()}//${hostname}${port ? ":" + port : ""}`;
+}
+
+/**
+ * Checks if two URLs have the same origin (protocol, hostname and port).
+ *
+ * Protocol and hostname are case-insensitive, and default ports are normalized
+ * (`https://example.com` equals `https://example.com:443`). Path, query, hash and
+ * userinfo are ignored. Relative or invalid URLs have no origin and never match.
+ *
+ * @example
+ * ```js
+ * isSameOrigin("https://example.com/a", "https://example.com:443/b"); // true
+ * isSameOrigin("https://example.com", "http://example.com"); // false
+ * ```
+ *
+ * @group utils
+ */
+export function isSameOrigin(a: string, b: string): boolean {
+  const originA = _getOrigin(a);
+  return originA !== undefined && originA === _getOrigin(b);
+}
