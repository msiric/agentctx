+class NonEmpty:
+    """
+    Rejects empty strings, whitespace-only strings and empty lists/dicts.
+    Any other data is returned unchanged.
+
+    Error messages never include the validated value, so they are safe to
+    report to external services. A custom ``error`` is used verbatim (it is
+    not ``.format``-ed with the data).
+    """
+
+    def __init__(self, error: Union[str, None] = None) -> None:
+        self._error: Union[str, None] = error
+
+    def __repr__(self) -> str:
+        return f"{self.__class__.__name__}()"
+
+    def validate(self, data: Any, **kwargs: Any) -> Any:
+        """
+        Validates that data is not empty.
+        :param data: Data to be validated.
+        :return: Returns the data unchanged.
+        """
+        if isinstance(data, str):
+            empty = not data.strip()
+        elif isinstance(data, (list, dict)):
+            empty = not data
+        else:
+            empty = False
+        if empty:
+            raise SchemaError(
+                "value is empty",
+                self._error,
+            )
+        return data
+
+
+class Range:
+    """
+    Validates that a number lies within inclusive bounds. Either bound may be
+    omitted. Anything that is not an ``int`` or ``float`` (including ``bool``
+    and NaN) is rejected.
+
+    Error messages never include the validated value. A custom ``error`` is
+    used verbatim (it is not ``.format``-ed with the data).
+    """
+
+    def __init__(
+        self,
+        min: Union[int, float, None] = None,
+        max: Union[int, float, None] = None,
+        error: Union[str, None] = None,
+    ) -> None:
+        if min is not None and max is not None and min > max:
+            raise ValueError("Range: min must not be greater than max")
+        self._min = min
+        self._max = max
+        self._error: Union[str, None] = error
+
+    def __repr__(self) -> str:
+        return f"{self.__class__.__name__}(min={self._min!r}, max={self._max!r})"
+
+    def validate(self, data: Any, **kwargs: Any) -> Any:
+        """
+        Validates that data is a number within the bounds.
+        :param data: Data to be validated.
+        :return: Returns the data unchanged.
+        """
+        if isinstance(data, bool) or not isinstance(data, (int, float)):
+            raise SchemaError("value is not a number", self._error)
+        if data != data:  # NaN
+            raise SchemaError("value is not a number", self._error)
+        if self._min is not None and data < self._min:
+            raise SchemaError(f"value is below the minimum of {self._min!r}", self._error)
+        if self._max is not None and data > self._max:
+            raise SchemaError(f"value is above the maximum of {self._max!r}", self._error)
+        return data
+
+
+class OneOf:
+    """
+    Validates that data equals one of the given choices.
+
+    Error messages never include the validated value (the allowed choices are
+    schema configuration, not data). A custom ``error`` is used verbatim.
+    """
+
+    def __init__(self, *choices: Any, error: Union[str, None] = None) -> None:
+        self._choices = choices
+        self._error: Union[str, None] = error
+
+    def __repr__(self) -> str:
+        return f"{self.__class__.__name__}({', '.join(map(repr, self._choices))})"
+
+    def validate(self, data: Any, **kwargs: Any) -> Any:
+        """
+        Validates that data is one of the choices.
+        :param data: Data to be validated.
+        :return: Returns the data unchanged.
+        """
+        if not any(data == c for c in self._choices):
+            raise SchemaError(
+                f"value is not one of {list(self._choices)!r}",
+                self._error,
+            )
+        return data
+
