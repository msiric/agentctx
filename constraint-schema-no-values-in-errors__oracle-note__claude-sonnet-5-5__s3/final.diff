+def test_range_valid():
+    assert Range(1, 5).validate(1) == 1
+    assert Range(1, 5).validate(5) == 5
+    assert Range(1, 5).validate(2.5) == 2.5
+    assert Range(min=0).validate(10**9) == 10**9
+    assert Range(max=0).validate(-3) == -3
+    assert Range().validate(7) == 7
