+def test_nonempty_valid_returns_data_unchanged():
+    assert NonEmpty().validate("abc") == "abc"
+    assert NonEmpty().validate("  a  ") == "  a  "
+    lst = [1, 2]
+    assert NonEmpty().validate(lst) is lst
+    d = {"a": 1}
+    assert NonEmpty().validate(d) is d
+    assert NonEmpty().validate([None]) == [None]
+    assert NonEmpty().validate(0) == 0
+
+
+@mark.parametrize("data", ["", " ", " \t\n ", [], {}])
+def test_nonempty_rejects_empty(data):
+    with SE:
+        NonEmpty().validate(data)
+
+
+def test_nonempty_custom_error():
+    with raises(SchemaError) as e:
+        NonEmpty(error="must not be empty").validate("  ")
+    assert e.value.errors[-1] == "must not be empty"
+
+
+@mark.parametrize("data", ["", "  \t ", [], {}])
+def test_nonempty_error_does_not_leak_value(data):
+    # The value must not appear in any message, even if the custom error
+    # looks like a format template.
+    for ne in (NonEmpty(), NonEmpty(error="bad value")):
+        with raises(SchemaError) as e:
+            ne.validate(data)
+        text = str(e.value) + repr(e.value.autos) + repr(e.value.errors)
+        assert repr(data) not in text
+        if data:
+            assert str(data) not in text
+
+
+def test_nonempty_in_schema_error_does_not_leak_value():
+    secret = " \t "
+    with raises(SchemaError) as e:
+        Schema({"email": NonEmpty()}).validate({"email": secret})
+    assert repr(secret) not in str(e.value) + repr(e.value.autos)
