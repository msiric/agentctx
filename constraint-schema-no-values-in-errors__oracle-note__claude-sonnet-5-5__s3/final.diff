+def test_nonempty_in_schema():
+    s = Schema({"name": And(str, NonEmpty()), "tags": NonEmpty()})
+    assert s.validate({"name": "x", "tags": ["a"]}) == {"name": "x", "tags": ["a"]}
+    with SE:
+        s.validate({"name": " ", "tags": ["a"]})
+    with SE:
+        s.validate({"name": "x", "tags": []})
+
