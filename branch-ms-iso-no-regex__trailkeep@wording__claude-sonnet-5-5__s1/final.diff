+
+/**
+ * Format the given milliseconds as an ISO 8601 duration string.
+ *
+ * Days are the largest unit used, since months and years are ambiguous.
+ * Sub-second remainders are written as a decimal fraction of the seconds.
+ * Negative values are prefixed with `-` (an ISO 8601-2 extension).
+ *
+ * @example formatISO(5400000) // "PT1H30M"
+ * @example formatISO(90061000) // "P1DT1H1M1S"
+ *
+ * @param ms - milliseconds
+ * @returns The ISO 8601 duration string
+ */
+export function formatISO(ms: number): string {
+  if (typeof ms !== 'number' || !Number.isFinite(ms)) {
+    throw new Error('Value provided to ms.formatISO() must be of type number.');
+  }
+
+  let rest = Math.round(Math.abs(ms));
+  const days = Math.floor(rest / d);
+  rest -= days * d;
+  const hours = Math.floor(rest / h);
+  rest -= hours * h;
+  const minutes = Math.floor(rest / m);
+  rest -= minutes * m;
+  const seconds = Math.floor(rest / s);
+  const millis = rest - seconds * s;
+
+  let secStr = '';
+  if (millis > 0) {
+    secStr = `${seconds}.${String(millis).padStart(3, '0').replace(/0+$/, '')}S`;
+  } else if (seconds > 0) {
+    secStr = `${seconds}S`;
+  }
+
+  const time = `${hours ? `${hours}H` : ''}${minutes ? `${minutes}M` : ''}${secStr}`;
+  if (!days && !time) {
+    return 'PT0S';
+  }
+  const sign = ms < 0 ? '-' : '';
+  return `${sign}P${days ? `${days}D` : ''}${time ? `T${time}` : ''}`;
+}
+
+function isDigit(code: number): boolean {
+  return code >= 48 && code <= 57;
+}
+
+/**
+ * Parse an ISO 8601 duration string into milliseconds.
+ *
+ * Supports weeks, days, hours, minutes and seconds (seconds may have a
+ * decimal fraction), and an optional leading `-` or `+`. Years and months
+ * are rejected because their length is ambiguous.
+ *
+ * Implemented by hand (no regular expressions) so that parsing time is
+ * linear in the input length.
+ *
+ * @example parseISO("PT1H30M") // 5400000
+ * @example parseISO("P1DT1H1M1S") // 90061000
+ *
+ * @param str - ISO 8601 duration
+ * @returns The duration in milliseconds
+ */
+export function parseISO(str: string): number {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw new Error(
+      'Value provided to ms.parseISO() must be a non-empty string (max length 100).',
+    );
+  }
+  const fail = (): never => {
+    throw new Error(`Invalid ISO 8601 duration: ${JSON.stringify(str)}`);
+  };
+
+  let i = 0;
+  let sign = 1;
+  if (str[i] === '-' || str[i] === '+') {
+    if (str[i] === '-') sign = -1;
+    i++;
+  }
+  if (str[i] !== 'P') return fail();
+  i++;
+
+  let inTime = false;
+  let total = 0;
+  let count = 0;
+  let lastRank = -1;
+
+  while (i < str.length) {
+    if (str[i] === 'T') {
+      if (inTime) return fail();
+      inTime = true;
+      lastRank = Math.max(lastRank, 1); // date units may not follow
+      i++;
+      if (i >= str.length) return fail(); // "T" must be followed by a unit
+      continue;
+    }
+
+    // number: digits, optionally followed by '.' or ',' and more digits
+    const start = i;
+    while (i < str.length && isDigit(str.charCodeAt(i))) i++;
+    const intDigits = i - start;
+    if (intDigits === 0) return fail();
+    let fracDigits = 0;
+    if (str[i] === '.' || str[i] === ',') {
+      i++;
+      const fracStart = i;
+      while (i < str.length && isDigit(str.charCodeAt(i))) i++;
+      fracDigits = i - fracStart;
+      if (fracDigits === 0) return fail();
+    }
+    const value = Number(str.slice(start, i).replace(',', '.'));
+    if (i >= str.length) return fail(); // missing unit designator
+
+    const unit = str[i];
+    i++;
+    let factor: number;
+    let rank: number;
+    if (!inTime && unit === 'W') {
+      factor = 7 * d;
+      rank = 0;
+    } else if (!inTime && unit === 'D') {
+      factor = d;
+      rank = 1;
+    } else if (inTime && unit === 'H') {
+      factor = h;
+      rank = 2;
+    } else if (inTime && unit === 'M') {
+      factor = m;
+      rank = 3;
+    } else if (inTime && unit === 'S') {
+      factor = s;
+      rank = 4;
+    } else {
+      return fail(); // includes ambiguous years/months
+    }
+    // units must appear in descending order, each at most once
+    if (rank <= lastRank) return fail();
+    lastRank = rank;
+    total += value * factor;
+    count++;
+  }
+
+  if (count === 0) return fail();
+  return Math.round(sign * total) || 0;
+}
