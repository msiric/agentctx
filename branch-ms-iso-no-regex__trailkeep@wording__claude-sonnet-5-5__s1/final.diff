+++ b/src/parse-iso.test.ts
@@ -0,0 +1,88 @@
+import { describe, expect, it } from '@jest/globals';
+import { formatISO, parseISO } from './index';
+
+describe('parseISO(string)', () => {
+  it('should parse hours and minutes', () => {
+    expect(parseISO('PT1H30M')).toBe(5400000);
+  });
+
+  it('should parse days, hours, minutes and seconds', () => {
+    expect(parseISO('P1DT1H1M1S')).toBe(90061000);
+  });
+
+  it('should parse single units', () => {
+    expect(parseISO('P1D')).toBe(86400000);
+    expect(parseISO('PT1H')).toBe(3600000);
+    expect(parseISO('PT1M')).toBe(60000);
+    expect(parseISO('PT1S')).toBe(1000);
+    expect(parseISO('P2W')).toBe(2 * 7 * 86400000);
+  });
+
+  it('should parse fractional seconds with . or ,', () => {
+    expect(parseISO('PT1.5S')).toBe(1500);
+    expect(parseISO('PT0,25S')).toBe(250);
+    expect(parseISO('PT0.001S')).toBe(1);
+  });
+
+  it('should parse zero', () => {
+    expect(parseISO('PT0S')).toBe(0);
+    expect(parseISO('-PT0S')).toBe(0);
+    expect(Object.is(parseISO('-PT0S'), 0)).toBe(true);
+  });
+
+  it('should parse signs', () => {
+    expect(parseISO('-PT1H')).toBe(-3600000);
+    expect(parseISO('+PT1H')).toBe(3600000);
+  });
+
+  it('should round-trip with formatISO', () => {
+    for (const ms of [
+      0, 1, 999, 1000, 1500, 60000, 5400000, 90061001, -42000,
+    ]) {
+      expect(parseISO(formatISO(ms))).toBe(ms);
+    }
+  });
+
+  it('should reject ambiguous years and months', () => {
+    expect(() => parseISO('P1Y')).toThrow();
+    expect(() => parseISO('P1M')).toThrow();
+  });
+
+  it('should reject malformed input', () => {
+    for (const bad of [
+      '',
+      'P',
+      'PT',
+      'P1DT',
+      '1H',
+      'PT1',
+      'PT1X',
+      'PT1H1H',
+      'PT1M1H',
+      'P1H',
+      'PT1D',
+      'PTT1H',
+      'PT.S',
+      'PT1.S',
+      'PT1.5',
+      'P-1D',
+      'PT1H ',
+      ' PT1H',
+      'pt1h',
+    ]) {
+      expect(() => parseISO(bad)).toThrow();
+    }
+  });
+
+  it('should reject non-strings and overly long input', () => {
+    expect(() => parseISO(undefined as unknown as string)).toThrow();
+    expect(() => parseISO(5 as unknown as string)).toThrow();
+    expect(() => parseISO(`PT${'1'.repeat(200)}S`)).toThrow();
+  });
+
+  it('should run in linear time on pathological input', () => {
+    const start = Date.now();
+    expect(() => parseISO(`PT${'1'.repeat(90)}`)).toThrow();
+    expect(Date.now() - start).toBeLessThan(100);
+  });
+});
