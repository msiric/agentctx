index 4fac6e9..7737515 100644
--- a/index.d.ts
+++ b/index.d.ts
@@ -216,3 +216,14 @@ export default function prettyBytes(
 	number: number | bigint,
 	options?: Options
 ): string;
+
+/**
+Parse a byte string, the reverse of `prettyBytes(number, {binary: true})`, into a number of bytes.
+
+Accepts a plain number (`'512'`), `B`, the binary units `KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`, `ZiB`, and `YiB`, and the units without the `i` (`kB`, `KB`, `MB`, `GB`, `TB`, `PB`, `EB`, `ZB`, and `YB`). The units without the `i` are also powers of 1024, so `'1 MB'` is `1048576`, unlike the decimal `MB` that `prettyBytes` outputs. The value may be fractional (`'1.5 KiB'` is `1536`) and may have a leading `+` or `-`. A single space between the value and the unit is optional. Units are case-sensitive.
+
+The result is not rounded, so `'1.5'` is `1.5`.
+
+@throws A `TypeError` if the input is not a string, and a `SyntaxError` if it cannot be parsed or the unit is not supported.
+*/
+export function parseBytes(string: string): number;
diff --git a/index.js b/index.js
index c5f37ab..cb2e004 100644
--- a/index.js
+++ b/index.js
@@ -285,3 +285,35 @@ export default function prettyBytes(number, options) {
 	const result = prefix + numberString + separator + UNITS[exponent];
 	return result.padStart(options.fixedWidth ?? 0);
 }
+
+// The non-`i` units are powers of 1024 too, since sizes are pasted from tools like Windows Explorer. `KB` and `kB` are both accepted.
+const PARSE_UNITS = new Map([
+	...BIBYTE_UNITS.map((unit, exponent) => [unit, exponent]),
+	...BYTE_UNITS.map((unit, exponent) => [unit, exponent]),
+	['KB', 1],
+]);
+const BYTES_PATTERN = /^([+-]?)(\d+(?:\.\d+)?|\.\d+)[ \u00A0]?([A-Za-z]+)?$/;
+
+export function parseBytes(string) {
+	if (typeof string !== 'string') {
+		throw new TypeError(`Expected a string, got ${typeof string}: ${string}`);
+	}
+
+	const match = BYTES_PATTERN.exec(string.trim());
+
+	if (!match) {
+		throw new SyntaxError(`Invalid byte string: ${JSON.stringify(string)}`);
+	}
+
+	const [, sign, digits, unit = 'B'] = match;
+	const exponent = PARSE_UNITS.get(unit);
+
+	if (exponent === undefined) {
+		throw new SyntaxError(`Unsupported unit ${JSON.stringify(unit)} in ${JSON.stringify(string)}, expected one of: ${[...PARSE_UNITS.keys()].join(', ')}`);
+	}
+
+	// `1024 ** exponent` is a power of two, so the scaling is exact.
+	const bytes = Number(digits) * (1024 ** exponent);
+
+	return sign === '-' ? -bytes : bytes;
+}
