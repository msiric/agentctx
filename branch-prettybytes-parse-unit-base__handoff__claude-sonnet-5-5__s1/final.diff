+++ b/readme.md
@@ -240,6 +240,18 @@ prettyBytes(100_000, {fixedWidth: 10});
 //=> ['    1 kB', '   10 kB', '  100 kB']
 ```
 
+### parseBytes(string)
+
+Parse a byte string into a number of bytes. It is the reverse of `prettyBytes(number, {binary: true})`.
+
+Accepts a plain number (`'512'`), `B`, the binary units `KiB` to `YiB`, and the units without the `i` (`kB`, `KB`, `MB`, `GB`, `TB`, `PB`, `EB`, `ZB`, `YB`). Both `kB` and `KB` are accepted. Units are case-sensitive, and a single space between the value and the unit is optional.
+
+**The units without the `i` are powers of 1024**, so `'1 kB'` and `'1 KB'` are `1024` and `'1 MB'` is `1048576`. This matches how sizes appear in tools like Windows Explorer, but it differs from `prettyBytes`, where `kB` is 1000 bytes. Only the binary output round-trips: use `{binary: true}`.
+
+The value may be fractional (`'1.5 KiB'` is `1536`) and may have a leading `+` or `-`. The result is not rounded. Exponents (`1e3`), `Infinity`, and thousands separators are not supported.
+
+Throws a `TypeError` if the input is not a string, and a `SyntaxError` if it cannot be parsed or the unit is not supported.
+
 ## FAQ
 
 ### Why kB and not KB?
diff --git a/test.js b/test.js
index cf4a4d9..53f0458 100644
--- a/test.js
+++ b/test.js
@@ -3,7 +3,7 @@ import {readFileSync} from 'node:fs';
 import process from 'node:process';
 import {promisify} from 'node:util';
 import test from 'ava';
-import prettyBytes from './index.js';
+import prettyBytes, {parseBytes} from './index.js';
 
 const DECIMAL_UNITS = ['B', 'kB', 'MB', 'GB', 'TB', 'PB', 'EB', 'ZB', 'YB'];
 const BINARY_UNITS = ['B', 'KiB', 'MiB', 'GiB', 'TiB', 'PiB', 'EiB', 'ZiB', 'YiB'];
@@ -1147,3 +1147,66 @@ test('the options shape the output as documented', t => {
 		t.is(prettyBytes(value, {signed: true}), prefix + prettyBytes(Math.abs(value)));
 	}
 });
+
+test('parseBytes: plain numbers and bytes', t => {
+	t.is(parseBytes('512'), 512);
+	t.is(parseBytes('512 B'), 512);
+	t.is(parseBytes('512B'), 512);
+	t.is(parseBytes('0'), 0);
+	t.is(parseBytes('  512 B  '), 512);
+	t.is(parseBytes('1 B'), 1);
+});
+
+test('parseBytes: binary units', t => {
+	for (const [exponent, unit] of BINARY_UNITS.entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1024 ** exponent);
+		t.is(parseBytes(`2${unit}`), 2 * (1024 ** exponent));
+	}
+});
+
+test('parseBytes: fractions and signs', t => {
+	t.is(parseBytes('1.5 KiB'), 1536);
+	t.is(parseBytes('.5 KiB'), 512);
+	t.is(parseBytes('1.5'), 1.5);
+	t.is(parseBytes('-1 KiB'), -1024);
+	t.is(parseBytes('+1 KiB'), 1024);
+});
+
+test('parseBytes: reverses prettyBytes for exact values', t => {
+	for (const bytes of [0, 1, 512, 1024, 1536, 1024 ** 3, 1024 ** 8]) {
+		t.is(parseBytes(prettyBytes(bytes, {binary: true})), bytes);
+	}
+});
+
+test('parseBytes: units are case-sensitive', t => {
+	for (const input of ['1 kib', '1 KIB', '1 kiB', '1 b', '1 mib']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError});
+	}
+});
+
+test('parseBytes: non-i units are powers of 1024', t => {
+	for (const [exponent, unit] of DECIMAL_UNITS.entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1024 ** exponent);
+		t.is(parseBytes(`2${unit}`), 2 * (1024 ** exponent));
+	}
+
+	t.is(parseBytes('1 KB'), 1024);
+	t.is(parseBytes('1 kB'), 1024);
+	t.is(parseBytes('1.5 MB'), 1.5 * 1024 * 1024);
+});
+
+test('parseBytes: unsupported units throw', t => {
+	for (const input of ['1 K', '1 k', '1 Kb', '1 mB', '1 gb', '1 bit', '1 KIB']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError});
+	}
+});
+
+test('parseBytes: rejects malformed input', t => {
+	for (const input of ['', ' ', 'KiB', 'abc', '1..5 KiB', '1.5.5', '1  KiB', '1 2 KiB', '1e3', 'Infinity', 'NaN', '- 1', '--1']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError}, `${input}`);
+	}
+
+	for (const input of [1, undefined, null, {}, 10n]) {
+		t.throws(() => parseBytes(input), {instanceOf: TypeError});
+	}
+});
