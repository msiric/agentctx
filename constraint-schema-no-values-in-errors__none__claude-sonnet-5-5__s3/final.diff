+def test_range_custom_error_and_no_value_leak():
+    with raises(SchemaError) as exc_info:
+        Schema({"age": Range(0, 120, error="bad age {}")}).validate({"age": 999})
+    assert "999" not in " ".join(map(str, [exc_info.value, exc_info.value.autos]))
+    with raises(SchemaError) as exc_info:
+        Range(0, 1).validate(12345)
+    assert "12345" not in str(exc_info.value)
