+def test_nonempty_nested():
+    schema = Schema({"name": NonEmpty(), "tags": And([str], NonEmpty())})
+    good = {"name": "x", "tags": ["a"]}
+    assert schema.validate(good) == good
+    assert not schema.is_valid({"name": " ", "tags": ["a"]})
+    assert not schema.is_valid({"name": "x", "tags": []})
+
