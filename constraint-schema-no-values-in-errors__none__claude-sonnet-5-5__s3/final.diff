+@mark.parametrize("secret", [" \t ", b"   ", []])
+def test_nonempty_error_never_contains_value(secret):
+    # Errors go to Sentry, so the validated value must never appear in them.
+    for validator in (NonEmpty(), NonEmpty(error="bad {} {!r}")):
+        for wrapped in (validator, Schema(validator), Schema({"k": validator})):
+            data = {"k": secret} if isinstance(wrapped, Schema) and wrapped._schema == {"k": validator} else secret
+            with raises(SchemaError) as exc_info:
+                (wrapped.validate)(data)
+            e = exc_info.value
+            text = " ".join(map(str, [e, e.autos, e.errors, e.code]))
+            assert repr(secret) not in text
+
