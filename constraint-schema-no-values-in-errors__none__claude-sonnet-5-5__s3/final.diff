+class NonEmpty:
+    """
+    Rejects empty or whitespace-only strings and empty lists, tuples, sets
+    and dicts. Any other data is returned unchanged.
+    """
+
+    def __init__(self, error: Union[str, None] = None) -> None:
+        self._error: Union[str, None] = error
+
+    def __repr__(self) -> str:
+        return f"{self.__class__.__name__}()"
+
+    def validate(self, data: Any, **kwargs: Any) -> Any:
+        """
+        Validates that data is not empty.
+        :param data: Data to be validated.
+        :return: Returns the data unchanged.
+        """
+        if isinstance(data, (str, bytes)):
+            empty = not data.strip()
+        elif isinstance(data, (list, tuple, set, frozenset, dict)):
+            empty = len(data) == 0
+        else:
+            empty = False
+        if empty:
+            # Never include the value in the message: errors are reported to
+            # Sentry and the data may be personal. The custom error is used
+            # verbatim (not .format()-ed with the data) for the same reason.
+            raise SchemaError(self._error if self._error else "value is empty")
+        return data
+
+
+class Range:
+    """
+    Validates that a number lies within inclusive bounds. Either bound may be
+    None (unbounded). Anything that is not an int or float is rejected,
+    including bool and NaN.
+    """
+
+    def __init__(
+        self,
+        min: Union[int, float, None] = None,
+        max: Union[int, float, None] = None,
+        error: Union[str, None] = None,
+    ) -> None:
+        if min is not None and max is not None and min > max:
+            raise ValueError("min must not be greater than max")
+        self._min = min
+        self._max = max
+        self._error: Union[str, None] = error
+
+    def __repr__(self) -> str:
+        return f"{self.__class__.__name__}(min={self._min!r}, max={self._max!r})"
+
+    def validate(self, data: Any, **kwargs: Any) -> Any:
+        """
+        Validates that data is a number within [min, max].
+        :param data: Data to be validated.
+        :return: Returns the data unchanged.
+        """
+        # The value is never included in messages (errors go to Sentry).
+        if isinstance(data, bool) or not isinstance(data, (int, float)):
+            raise SchemaError(self._error if self._error else "value is not a number")
+        if data != data or (
+            (self._min is not None and data < self._min)
+            or (self._max is not None and data > self._max)
+        ):
+            raise SchemaError(
+                self._error
+                if self._error
+                else f"value is not in range (min={self._min!r}, max={self._max!r})"
+            )
+        return data
+
+
+class OneOf:
+    """
+    Validates that data equals one of the given choices.
+    """
+
+    def __init__(self, *choices: Any, error: Union[str, None] = None) -> None:
+        self._choices = choices
+        self._error: Union[str, None] = error
+
+    def __repr__(self) -> str:
+        return f"{self.__class__.__name__}({', '.join(map(repr, self._choices))})"
+
+    def validate(self, data: Any, **kwargs: Any) -> Any:
+        """
+        Validates that data is one of the choices.
+        :param data: Data to be validated.
+        :return: Returns the data unchanged.
+        """
+        # The value is never included in messages (errors go to Sentry).
+        for choice in self._choices:
+            if type(choice) is type(data) and choice == data:
+                return data
+        raise SchemaError(
+            self._error
+            if self._error
+            else f"value is not one of {list(self._choices)!r}"
+        )
+
