+def test_range_open_bounds():
+    assert Range(min=5).validate(10**9) == 10**9
+    assert Range(max=5).validate(-10**9) == -10**9
+    assert Range().validate(1.5) == 1.5
+    assert not Schema(Range(min=5)).is_valid(4)
+    assert not Schema(Range(max=5)).is_valid(6)
