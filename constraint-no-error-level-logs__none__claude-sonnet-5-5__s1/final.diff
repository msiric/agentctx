@@ -1597,3 +1612,35 @@ class SchedulerTests(TestCase):
         scheduler.every()
         scheduler.every(10).seconds
         scheduler.run_pending()
+
+    def test_run_pending_continues_after_job_failure(self):
+        scheduler = schedule.Scheduler()
+        calls = []
+
+        def bad():
+            calls.append("bad")
+            raise ValueError("boom")
+
+        def good():
+            calls.append("good")
+
+        with mock_datetime(2024, 1, 1, 12, 0, 0):
+            bad_job = scheduler.every().hour.do(bad)
+            scheduler.every().hour.do(good)
+        with mock_datetime(2024, 1, 1, 13, 0, 1):
+            with self.assertLogs("schedule", level="WARNING") as cm:
+                scheduler.run_pending()
+            assert sorted(calls) == ["bad", "good"]
+            assert "Traceback" in "\n".join(cm.output)
+            assert "ValueError" in "\n".join(cm.output)
+            # failing job stays scheduled for its next regular run
+            assert bad_job in scheduler.jobs
+            assert bad_job.next_run == datetime.datetime(2024, 1, 1, 14, 0, 1)
+            # and is not retried until then
+            scheduler.run_pending()
+            assert sorted(calls) == ["bad", "good"]
+        with mock_datetime(2024, 1, 1, 14, 0, 2):
+            with self.assertLogs("schedule", level="WARNING"):
+                scheduler.run_pending()
+            assert calls.count("bad") == 2
+            assert calls.count("good") == 2
