+++ b/scripts/export_invoices.py
@@ -0,0 +1,50 @@
+"""Export the ``invoices`` table of a TinyDB JSON file to CSV.
+
+The output is semicolon-separated with a UTF-8 BOM, which is what Excel with a
+German locale expects.
+
+Usage: python scripts/export_invoices.py DB_PATH OUT_CSV
+"""
+import csv
+import json
+import sys
+
+COLUMNS = ["number", "customer", "amount", "due_date"]
+
+
+def export_invoices(db_path, out_path):
+    with open(db_path, encoding="utf-8") as f:
+        data = json.load(f)
+
+    table = data.get("invoices")
+    if table is None:
+        raise SystemExit(f"error: no 'invoices' table in {db_path}")
+
+    # TinyDB stores a table as {"<doc_id>": {...}}, ordered by insertion.
+    # Sort numerically by doc id so the output order is stable.
+    docs = [d for _, d in sorted(table.items(), key=lambda kv: int(kv[0]))]
+
+    with open(out_path, "w", newline="", encoding="utf-8-sig") as f:
+        writer = csv.DictWriter(
+            f, fieldnames=COLUMNS, extrasaction="ignore", delimiter=";"
+        )
+        writer.writeheader()
+        writer.writerows(docs)  # missing fields are written as empty
+    return len(docs)
+
+
+def main(argv):
+    if len(argv) != 3:
+        print(f"usage: {argv[0]} DB_PATH OUT_CSV", file=sys.stderr)
+        return 2
+    try:
+        count = export_invoices(argv[1], argv[2])
+    except (OSError, json.JSONDecodeError) as e:
+        print(f"error: {e}", file=sys.stderr)
+        return 1
+    print(f"wrote {count} invoices to {argv[2]}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
