+    def to_csv(self, path, fields: Optional[Iterable[str]] = None) -> None:
+        """
+        Export the table to a CSV file.
+
+        The first row is a header, followed by one row per document. Missing
+        values are written as empty cells.
+
+        :param path: the file to write (overwritten if it exists)
+        :param fields: the columns to write, in order. Defaults to all
+                       top-level keys in first-seen order.
+        """
+
+        documents = list(self)
+
+        if fields is None:
+            columns: dict = {}
+            for doc in documents:
+                for key in doc:
+                    columns.setdefault(key, None)
+            fields = list(columns)
+        else:
+            fields = list(fields)
+
+        with open(path, 'w', newline='', encoding='utf-8') as f:
+            writer = csv.writer(f)
+            writer.writerow(fields)
+            for doc in documents:
+                writer.writerow([doc.get(field, '') for field in fields])
+
