@@ -197,3 +197,51 @@ def test_persist_empty_does_not_wipe_existing_data(tmpdir):
     assert len(table) == 1
     assert table.all() == [{'a': 1}]
     db.close()
+
+
+def _read_csv(path):
+    import csv
+    with open(path, newline='', encoding='utf-8') as f:
+        return list(csv.reader(f))
+
+
+def test_to_csv_default_fields(db, tmp_path):
+    db.truncate()
+    db.insert({'a': 1, 'b': 'x'})
+    db.insert({'c': 3, 'a': 2})
+
+    path = tmp_path / 'out.csv'
+    db.to_csv(path)
+
+    assert _read_csv(path) == [['a', 'b', 'c'], ['1', 'x', ''], ['2', '', '3']]
+
+
+def test_to_csv_fields_select_and_order(db, tmp_path):
+    db.truncate()
+    db.insert({'a': 1, 'b': 2, 'c': 3})
+
+    path = tmp_path / 'out.csv'
+    db.to_csv(path, fields=['c', 'a', 'missing'])
+
+    assert _read_csv(path) == [['c', 'a', 'missing'], ['3', '1', '']]
+
+
+def test_to_csv_empty_table(db, tmp_path):
+    db.truncate()
+
+    path = tmp_path / 'out.csv'
+    db.to_csv(path)
+    assert _read_csv(path) == [[]]
+
+    db.to_csv(path, fields=['a'])
+    assert _read_csv(path) == [['a']]
+
+
+def test_to_csv_escaping_and_unicode(db, tmp_path):
+    db.truncate()
+    db.insert({'name': 'Müller, "GmbH"', 'note': 'a\nb'})
+
+    path = tmp_path / 'out.csv'
+    db.to_csv(path)
+
+    assert _read_csv(path) == [['name', 'note'], ['Müller, "GmbH"', 'a\nb']]
