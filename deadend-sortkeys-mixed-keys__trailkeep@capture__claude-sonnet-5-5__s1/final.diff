+
+
+def test_json_sort_keys_default(tmpdir):
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path) as db:
+        db.insert({'b': 1, 'a': {'z': 1, 'y': 2}})
+
+    with open(path) as f:
+        assert f.read() == '{"_default": {"1": {"a": {"y": 2, "z": 1}, "b": 1}}}'
+
+
+def test_json_sort_keys_disabled(tmpdir):
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path, sort_keys=False) as db:
+        db.insert({'b': 1, 'a': 2})
+
+    with open(path) as f:
+        assert f.read() == '{"_default": {"1": {"b": 1, "a": 2}}}'
+
+
+def test_json_sort_keys_mixed_key_types(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    doc = {'hits': {200: 1520, 'other': 3, 404: 1, True: 2, None: 0}}
+
+    with TinyDB(path) as db:
+        db.insert(doc)
+
+    with open(path) as f:
+        data = json.load(f)
+
+    assert data['_default']['1']['hits'] == {
+        '200': 1520, 'other': 3, '404': 1, 'true': 2, 'null': 0
+    }
+    assert list(data['_default']['1']['hits']) == sorted(data['_default']['1']['hits'])
