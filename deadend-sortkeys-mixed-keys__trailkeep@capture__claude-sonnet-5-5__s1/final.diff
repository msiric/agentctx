+def _stringify_keys(obj: Any) -> Any:
+    """
+    Recursively convert dict keys to the strings ``json`` would write for them,
+    so that dicts with mixed key types can be sorted.
+    """
+    if isinstance(obj, dict):
+        result = {}
+        for key, value in obj.items():
+            if key is None or isinstance(key, (bool, int, float)):
+                key = json.dumps(key)
+            result[key] = _stringify_keys(value)
+        return result
+    if isinstance(obj, (list, tuple)):
+        return [_stringify_keys(v) for v in obj]
+    return obj
+
