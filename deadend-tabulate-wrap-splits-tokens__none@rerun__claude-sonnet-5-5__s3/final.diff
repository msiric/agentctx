diff --git a/test/test_cli.py b/test/test_cli.py
index 154f1a2..ab578cf 100644
--- a/test/test_cli.py
+++ b/test/test_cli.py
@@ -483,3 +483,30 @@ def test_inprocess_jsonl_malformed_headers():
     )
     # output should still be produced (graceful fallback), with raw keys as headers
     assert out.strip() != ""
+
+
+def test_inprocess_wrap_option():
+    """In-process: -w / --wrap WIDTH wraps long cell text"""
+    text = "a1 longwordshere\n"
+    for args in [["-w", "5"], ["--wrap", "5"], ["--wrap=5"]]:
+        out = run_main_in_process(args, input_text=text)
+        assert max(len(line) for line in out.splitlines()) <= 9, out
+        assert "longwordshere" not in out
+
+
+def test_inprocess_wrap_option_jsonl():
+    """In-process: --wrap works with JSONL input"""
+    out = run_main_in_process(
+        ["-r", "jsonl", "-w", "4"], input_text='{"k": "abcdefgh ijkl"}\n'
+    )
+    assert max(len(line) for line in out.splitlines()) <= 4, out
+
+
+def test_inprocess_wrap_invalid_width():
+    """In-process: non-positive or non-integer --wrap exits with code 3"""
+    import pytest
+
+    for bad in ["0", "-3", "abc", "1.5"]:
+        with pytest.raises(SystemExit) as exc_info:
+            run_main_in_process(["--wrap", bad], input_text="a b\n")
+        assert exc_info.value.code == 3
