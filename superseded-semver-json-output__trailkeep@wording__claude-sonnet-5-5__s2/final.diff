@@ -11,6 +11,7 @@ The result of each command is printed on stdout.
 """
 
 import argparse
+import json
 import sys
 from typing import cast, List, Optional
 
@@ -83,6 +84,45 @@ def cmd_nextver(args: argparse.Namespace) -> str:
     return str(version.next_version(args.part))
 
 
+def cmd_sort(args: argparse.Namespace) -> Optional[str]:
+    """
+    Subcommand: Sort versions, oldest first.
+
+    Synopsis: sort [<VERSION>...]
+
+    If no versions are given, they are read from standard input,
+    one per line; blank lines are ignored.
+
+    :param args: The parsed arguments
+    :return: the sorted versions, one per line (None if there are none)
+    """
+    raw = args.versions or [line.strip() for line in sys.stdin]
+    versions = sorted(Version.parse(v) for v in raw if v)
+    if not versions:
+        return None
+    return "\n".join(str(v) for v in versions)
+
+
+def cmd_latest(args: argparse.Namespace) -> str:
+    """
+    Subcommand: Find the highest version that is not a prerelease.
+
+    Synopsis: latest [<VERSION>...]
+
+    If no versions are given, they are read from standard input,
+    one per line; blank lines are ignored.
+
+    :param args: The parsed arguments
+    :return: JSON object ``{"version": "<highest stable version>"}``
+    :raises ValueError: if there is no non-prerelease version
+    """
+    raw = args.versions or [line.strip() for line in sys.stdin]
+    stable = [v for v in map(Version.parse, filter(None, raw)) if not v.prerelease]
+    if not stable:
+        raise ValueError("no version without prerelease given")
+    return json.dumps({"version": str(max(stable))})
+
+
 def createparser() -> argparse.ArgumentParser:
