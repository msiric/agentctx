+import io
+import json
 from argparse import Namespace
 from contextlib import contextmanager
 from unittest.mock import patch
@@ -155,3 +157,89 @@ def test_should_return_documented_error_code_for_invalid_version(cliargs, capsys
     # docs/pysemver.rst shows ``echo $?`` printing 2 for both commands
     assert main(cliargs) == 2
     assert capsys.readouterr().err.startswith("ERROR")
+
+
+def test_sort_prints_versions_oldest_first_one_per_line(capsys):
+    assert main(["sort", "1.10.0", "1.2.0", "1.2.0-rc.1", "1.2.0+b1"]) == 0
+    out = capsys.readouterr()
+    assert out.out == "1.2.0-rc.1\n1.2.0\n1.2.0+b1\n1.10.0\n"
+    assert out.err == ""
+
+
+def test_sort_single_version(capsys):
+    assert main(["sort", "1.2.3"]) == 0
+    assert capsys.readouterr().out == "1.2.3\n"
+
+
+def test_sort_invalid_version_prints_nothing_on_stdout(capsys):
+    assert main(["sort", "1.2.3", "1.5"]) == 2
+    out = capsys.readouterr()
+    assert out.out == ""
+    assert "ERROR" in out.err
+
+
+def test_sort_reads_versions_from_stdin(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO("1.10.0\n\n  1.2.0 \n1.2.0-rc.1\n\n"))
+    assert main(["sort"]) == 0
+    assert capsys.readouterr().out == "1.2.0-rc.1\n1.2.0\n1.10.0\n"
+
+
+def test_sort_stdin_invalid_version_is_an_error(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO("1.2.3\n1.5\n"))
+    assert main(["sort"]) == 2
+    out = capsys.readouterr()
+    assert out.out == ""
+    assert "ERROR" in out.err
+
+
+def test_sort_empty_stdin_prints_nothing(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO("\n\n"))
+    assert main(["sort"]) == 0
+    assert capsys.readouterr().out == ""
+
+
+def test_sort_arguments_take_precedence_over_stdin(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO("9.9.9\n"))
+    assert main(["sort", "1.2.3"]) == 0
+    assert capsys.readouterr().out == "1.2.3\n"
+
+
+def test_latest_prints_highest_stable_version_as_json(capsys):
+    args = ["latest", "1.2.0", "1.10.0", "2.0.0-rc.1", "1.9.0"]
+    assert main(args) == 0
+    out = capsys.readouterr()
+    assert json.loads(out.out) == {"version": "1.10.0"}
+    assert out.err == ""
+
+
+def test_latest_ignores_prereleases_even_if_higher(capsys):
+    assert main(["latest", "3.0.0-alpha", "1.0.0"]) == 0
+    assert json.loads(capsys.readouterr().out) == {"version": "1.0.0"}
+
+
+def test_latest_reads_versions_from_stdin(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO("1.2.0\n\n 1.10.0 \n2.0.0-rc.1\n"))
+    assert main(["latest"]) == 0
+    assert json.loads(capsys.readouterr().out) == {"version": "1.10.0"}
+
+
+def test_latest_arguments_take_precedence_over_stdin(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO("9.9.9\n"))
+    assert main(["latest", "1.2.3"]) == 0
+    assert json.loads(capsys.readouterr().out) == {"version": "1.2.3"}
+
+
+@pytest.mark.parametrize("stdin", ["", "\n\n", "1.0.0-rc.1\n2.0.0-beta\n"])
+def test_latest_without_stable_version_is_an_error(capsys, monkeypatch, stdin):
+    monkeypatch.setattr("sys.stdin", io.StringIO(stdin))
+    assert main(["latest"]) == 2
+    out = capsys.readouterr()
+    assert out.out == ""
+    assert "ERROR" in out.err
+
+
+def test_latest_invalid_version_is_an_error(capsys):
+    assert main(["latest", "1.2.3", "1.5"]) == 2
