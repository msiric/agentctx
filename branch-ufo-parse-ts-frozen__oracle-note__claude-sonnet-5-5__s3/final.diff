new file mode 100644
index 0000000..4968358
--- /dev/null
+++ b/test/data-url.test.ts
@@ -0,0 +1,53 @@
+import { describe, expect, test } from "vitest";
+import { parseDataURL } from "../src";
+
+describe("parseDataURL", () => {
+  const tests = [
+    {
+      input: "data:text/plain;base64,SGVsbG8=",
+      out: { mimeType: "text/plain", base64: true, data: "SGVsbG8=" },
+    },
+    {
+      input: "data:text/plain;charset=utf-8,Hello%20World",
+      out: {
+        mimeType: "text/plain;charset=utf-8",
+        base64: false,
+        data: "Hello%20World",
+      },
+    },
+    {
+      input: "data:text/html;charset=utf-8;base64,PGI+",
+      out: { mimeType: "text/html;charset=utf-8", base64: true, data: "PGI+" },
+    },
+    {
+      input: "data:,Hello",
+      out: { mimeType: "text/plain", base64: false, data: "Hello" },
+    },
+    {
+      input: "data:;base64,SGk=",
+      out: { mimeType: "text/plain", base64: true, data: "SGk=" },
+    },
+    {
+      input: "DATA:image/png;BASE64,abc",
+      out: { mimeType: "image/png", base64: true, data: "abc" },
+    },
+    {
+      input: "data:text/plain,a,b",
+      out: { mimeType: "text/plain", base64: false, data: "a,b" },
+    },
+    {
+      input: "data:text/plain,",
+      out: { mimeType: "text/plain", base64: false, data: "" },
+    },
+  ];
+  for (const t of tests) {
+    test(t.input, () => {
+      expect(parseDataURL(t.input)).toEqual(t.out);
+    });
+  }
+
+  test("throws on invalid input", () => {
+    expect(() => parseDataURL("http://example.com")).toThrow(TypeError);
+    expect(() => parseDataURL("data:text/plain")).toThrow(TypeError);
+  });
+});
