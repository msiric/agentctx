index 0000000..fb32198
--- /dev/null
+++ b/src/data-url.ts
@@ -0,0 +1,37 @@
+export interface ParsedDataURL {
+  /** MIME type (including any parameters, e.g. `text/plain;charset=utf-8`). Defaults to `text/plain`. */
+  mimeType: string;
+  /** Whether the payload is base64-encoded. */
+  base64: boolean;
+  /** The raw payload following the first comma (not decoded). */
+  data: string;
+}
+
+/**
+ * Parses a `data:` URL into its MIME type, base64 flag and raw data.
+ *
+ * Throws a `TypeError` if the input is not a valid `data:` URL.
+ *
+ * @example
+ *
+ * ```js
+ * parseDataURL("data:text/plain;base64,SGVsbG8=");
+ * // { mimeType: "text/plain", base64: true, data: "SGVsbG8=" }
+ * ```
+ *
+ * @group parse
+ */
+export function parseDataURL(input: string): ParsedDataURL {
+  const match = /^data:([^,]*),([\S\s]*)$/i.exec(input.trim());
+  if (!match) {
+    throw new TypeError(`Invalid data URL: ${input}`);
+  }
+  let meta = match[1]!;
+  let base64 = false;
+  const b64 = /;\s*base64$/i.exec(meta);
+  if (b64) {
+    base64 = true;
+    meta = meta.slice(0, b64.index);
+  }
+  return { mimeType: meta.trim() || "text/plain", base64, data: match[2]! };
+}
