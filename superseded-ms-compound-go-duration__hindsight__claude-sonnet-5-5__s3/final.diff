+/**
+ * Compound short format for `ms`, e.g. `1h 30m`.
+ */
+function fmtCompound(ms: number): string {
+  let remaining = Math.floor(Math.abs(ms) / s) * s;
+  if (remaining === 0) {
+    return '0s';
+  }
+  const parts: string[] = [];
+  for (const [size, name] of [
+    [d, 'd'],
+    [h, 'h'],
+    [m, 'm'],
+    [s, 's'],
+  ] as const) {
+    const count = Math.floor(remaining / size);
+    remaining -= count * size;
+    if (count > 0) {
+      parts.push(`${count}${name}`);
+    }
+  }
+  return `${ms < 0 ? '-' : ''}${parts.join(' ')}`;
+}
