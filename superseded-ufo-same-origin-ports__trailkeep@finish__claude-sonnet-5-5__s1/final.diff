+
+const DEFAULT_PORTS: Record<string, string> = {
+  "http:": "80",
+  "https:": "443",
+  "ws:": "80",
+  "wss:": "443",
+  "ftp:": "21",
+};
+
+function getOrigin(input: unknown): string | undefined {
+  if (typeof input !== "string" || !input) {
+    return undefined;
+  }
+  const { protocol, host } = parseURL(input);
+  if (!protocol || !host) {
+    return undefined;
+  }
+  const match = host.match(/^(.*?)(?::(\d*))?$/);
+  const hostname = (match?.[1] ?? host).toLowerCase();
+  let port = match?.[2] ?? "";
+  const proto = protocol.toLowerCase();
+  if (!hostname || port === DEFAULT_PORTS[proto]) {
+    port = "";
+  }
+  return hostname
+    ? `${proto}//${hostname}${port ? ":" + port : ""}`
+    : undefined;
+}
+
+/**
+ * Check if two URLs have the same origin (protocol, host and port).
+ *
+ * Path, query, hash and userinfo are ignored. Protocol and host are compared
+ * case-insensitively, and an explicit default port (e.g. `:443` for `https:`)
+ * equals an omitted one. Relative and protocol-relative URLs have no origin
+ * and always return `false`.
+ *
+ * @example
+ * ```js
+ * isSameOrigin("https://example.com/a", "https://example.com:443/b"); // true
+ * isSameOrigin("https://example.com", "http://example.com"); // false
+ * ```
+ *
+ * @group utils
+ */
+export function isSameOrigin(
+  a: string | undefined | null,
+  b: string | undefined | null,
+): boolean {
+  const originA = getOrigin(a);
+  return originA !== undefined && originA === getOrigin(b);
+}
