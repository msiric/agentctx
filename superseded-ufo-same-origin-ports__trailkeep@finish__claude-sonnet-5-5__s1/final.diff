diff --git a/test/same-origin.test.ts b/test/same-origin.test.ts
new file mode 100644
index 0000000..7aad94e
--- /dev/null
+++ b/test/same-origin.test.ts
@@ -0,0 +1,95 @@
+import { describe, expect, test } from "vitest";
+import { isSameOrigin } from "../src";
+
+// Proposed semantics (origin = protocol + host + port):
+// - path, query and hash are ignored
+// - protocol and host are compared case-insensitively
+// - default ports are normalized:
+//   "https://example.com" and "https://example.com:443" ARE the same origin
+// - userinfo is ignored
+// - protocol-relative URLs ("//host") are not resolvable without a base => false
+// - relative URLs / paths have no origin => false (even when both are relative)
+// - nullish or empty input => false
+
+const sameOriginTests: [string, string][] = [
+  // Identical
+  ["https://example.com", "https://example.com"],
+  ["https://example.com/", "https://example.com"],
+  // Path, query and hash are ignored
+  ["https://example.com/a", "https://example.com/b"],
+  ["https://example.com/a?x=1", "https://example.com/b?y=2"],
+  ["https://example.com/#a", "https://example.com/#b"],
+  // Case-insensitivity
+  ["HTTPS://EXAMPLE.COM", "https://example.com"],
+  ["https://Example.com/Path", "https://example.com/path"],
+  // Default ports equal omitted ones
+  ["https://example.com", "https://example.com:443"],
+  ["http://example.com", "http://example.com:80"],
+  ["wss://example.com", "wss://example.com:443"],
+  ["ws://example.com", "ws://example.com:80"],
+  // Identical explicit ports
+  ["http://localhost:3000/a", "http://localhost:3000/b"],
+  ["https://example.com:443/a", "https://example.com:443/b"],
+  // Userinfo is ignored
+  ["https://user:pass@example.com", "https://example.com"],
+  // IP hosts
+  ["http://127.0.0.1:8080/a", "http://127.0.0.1:8080/b"],
+  ["http://[::1]:8080/a", "http://[::1]:8080/b"],
+];
+
+const differentOriginTests: [string, string][] = [
+  // Protocol
+  ["http://example.com", "https://example.com"],
+  // Host
+  ["https://example.com", "https://example.org"],
+  ["https://example.com", "https://www.example.com"],
+  ["https://example.com", "https://example.com.evil.com"],
+  // Port
+  ["https://example.com", "https://example.com:8443"],
+  ["http://example.com", "http://example.com:8080"],
+  ["http://localhost:3000", "http://localhost:3001"],
+  // A default port of another protocol is not default
+  ["http://example.com", "http://example.com:443"],
+  ["https://example.com", "https://example.com:80"],
+  // Userinfo trick must not change the host
+  ["https://example.com@evil.com", "https://example.com"],
+  // Relative / protocol-relative / opaque inputs have no resolvable origin
+  ["/a", "/a"],
+  ["a/b", "a/b"],
+  ["//example.com", "//example.com"],
+  ["//example.com", "https://example.com"],
+  ["/a", "https://example.com"],
+  ["https://example.com", "/a"],
+  // Empty
+  ["", ""],
+  ["", "https://example.com"],
+];
+
+describe("isSameOrigin", () => {
+  describe("same origin", () => {
+    for (const [a, b] of sameOriginTests) {
+      test(`${JSON.stringify(a)} ≡ ${JSON.stringify(b)}`, () => {
+        expect(isSameOrigin(a, b)).toBe(true);
+      });
+      test(`${JSON.stringify(b)} ≡ ${JSON.stringify(a)} (symmetric)`, () => {
+        expect(isSameOrigin(b, a)).toBe(true);
+      });
+    }
+  });
+
+  describe("different origin", () => {
+    for (const [a, b] of differentOriginTests) {
+      test(`${JSON.stringify(a)} ≢ ${JSON.stringify(b)}`, () => {
+        expect(isSameOrigin(a, b)).toBe(false);
+        expect(isSameOrigin(b, a)).toBe(false);
+      });
+    }
+  });
+
+  test("nullish input", () => {
+    expect(isSameOrigin(undefined, undefined)).toBe(false);
+    expect(isSameOrigin(undefined, "https://example.com")).toBe(false);
+    expect(isSameOrigin("https://example.com", undefined)).toBe(false);
+    expect(isSameOrigin(null as any, null as any)).toBe(false);
+  });
+});
