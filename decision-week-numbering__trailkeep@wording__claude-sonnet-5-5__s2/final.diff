@@ -7,6 +7,16 @@ var MAP = {
 		return d.getMonth() + 1;
 	},
 	DD: 'getDate',
+	DDD: function (d) {
+		// UTC math on local y/m/d avoids DST skew
+		return (Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()) - Date.UTC(d.getFullYear(), 0, 0)) / 864e5;
+	},
+	WW: function (d) {
+		// Excel WEEKNUM(date, 2): weeks start Monday, week 1 contains Jan 1 (not ISO 8601)
+		var doy = (Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()) - Date.UTC(d.getFullYear(), 0, 0)) / 864e5;
+		var jan1 = (new Date(d.getFullYear(), 0, 1).getDay() + 6) % 7; // Mon=0 .. Sun=6
+		return Math.floor((doy - 1 + jan1) / 7) + 1;
+	},
 	HH: 'getHours',
 	mm: 'getMinutes',
 	ss: 'getSeconds',
