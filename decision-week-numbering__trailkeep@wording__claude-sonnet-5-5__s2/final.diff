+	t.is(render('{DDD}'), '121', 'returns day of year, zero-padded to 3');
+	t.is(render('{DDD}', new Date(2017, 0, 1)), '001', 'DDD: Jan 1 is 001');
+	t.is(render('{DDD}', new Date(2017, 11, 31)), '365', 'DDD: last day of common year');
+	t.is(render('{DDD}', new Date(2016, 11, 31)), '366', 'DDD: last day of leap year');
+	t.is(render('{DDD}', new Date(2016, 2, 1)), '061', 'DDD: counts Feb 29 in leap year');
+	t.is(render('{DDD}', new Date(2017, 2, 1)), '060', 'DDD: no Feb 29 in common year');
+	t.is(render('{DDD}', new Date(2017, 2, 12, 23, 59)), '071', 'DDD: unaffected by time of day / DST');
+	t.is(render('{DDD}', new Date(2017, 10, 6)), '310', 'DDD: unaffected by DST end');
+	t.is(render('{YYYY}-{DDD}'), '2017-121', 'DDD combines with other tokens');
+	t.is(render('{WW}'), '19', 'returns week number, zero-padded to 2');
+	t.is(render('{WW}', new Date(2017, 0, 1)), '01', 'WW: Jan 1 (Sunday) is week 1');
+	t.is(render('{WW}', new Date(2017, 0, 2)), '02', 'WW: weeks start Monday');
+	t.is(render('{WW}', new Date(2017, 0, 8)), '02', 'WW: Sunday ends the week');
+	t.is(render('{WW}', new Date(2018, 0, 1)), '01', 'WW: Jan 1 on Monday is week 1');
+	t.is(render('{WW}', new Date(2016, 0, 3)), '01', 'WW: Sunday Jan 3 2016 still week 1');
+	t.is(render('{WW}', new Date(2016, 0, 4)), '02', 'WW: Monday Jan 4 2016 starts week 2');
+	t.is(render('{WW}', new Date(2017, 11, 31)), '53', 'WW: not ISO (ISO would be 52)');
+	t.is(render('{WW}', new Date(2017, 10, 6)), '46', 'WW: unaffected by DST');
 	t.is(render('{YY}'), '17', 'returns partial year');
 	t.is(render('{YYYY}'), '2017', 'returns full year');
 	t.is(render('{HH}'), '16', 'returns full hours (24h)');
