     assert out.strip() != ""
+
+
+def test_wrap_wraps_text_and_keeps_long_tokens():
+    text = "SUPPORT-2024-118233\tthe quick brown fox jumps\n"
+    out = run_main_in_process(["--wrap", "10", "-s", "\t", "-f", "plain"], text)
+    assert "SUPPORT-2024-118233" in out
+    assert "the quick" in out and "brown fox" in out
+    assert "the quick brown" not in out
+
+
+def test_wrap_rejects_invalid_width():
+    import pytest
+
+    for bad in ["0", "-3", "abc"]:
+        with pytest.raises(SystemExit) as e:
+            run_main_in_process(["--wrap", bad], "a b\n")
+        assert e.value.code == 2
