+
+const DEFAULT_PORTS: Record<string, string> = {
+  "http:": "80",
+  "https:": "443",
+  "ws:": "80",
+  "wss:": "443",
+  "ftp:": "21",
+};
+
+// `\` before an `@` in the authority is parsed differently by browsers and
+// servers (host vs. credentials) - never treat such input as same-origin.
+const AMBIGUOUS_AUTHORITY_RE = /^[^/\\]*[/\\]{2}[^/\\?#]*\\[^/?#]*@/;
+
+function _originOf(input: string) {
+  if (AMBIGUOUS_AUTHORITY_RE.test(input)) {
+    return;
+  }
+  const { protocol, host } = parseURL(input);
+  if (protocol && !host && protocol !== "file:") {
+    return; // opaque (blob:, data:, javascript:, ...)
+  }
+  if (protocol === "file:") {
+    return; // opaque origin, like browsers
+  }
+  if (!host) {
+    return { relative: true as const };
+  }
+  const m = host.match(/^(\[[^\]]*\]|[^:]*)(?::(\d*))?$/);
+  if (!m) {
+    return;
+  }
+  return {
+    relative: false as const,
+    protocol: protocol || "",
+    hostname: m[1].toLowerCase(),
+    port: m[2] || "",
+  };
+}
+
+/**
+ * Checks whether two URLs share the same origin (scheme + host + port).
+ *
+ * Path, query, hash and credentials are ignored. Default ports are
+ * normalized (`https://x` equals `https://x:443`). Two relative inputs are
+ * same-origin; relative vs absolute, opaque (`data:`, `blob:`, `javascript:`)
+ * and `file:` URLs are not. If only one side has a scheme (`//host`), only
+ * host and port are compared.
+ *
+ * @example
+ * ```js
+ * isSameOrigin("https://x.com/a", "https://x.com:443/b?q=1") // true
+ * isSameOrigin("https://x.com", "http://x.com") // false
+ * ```
+ *
+ * @group utils
+ */
+export function isSameOrigin(a: string, b: string): boolean {
+  const oa = _originOf(a);
+  const ob = _originOf(b);
+  if (!oa || !ob) {
+    return false;
+  }
+  if (oa.relative || ob.relative) {
+    return oa.relative && ob.relative;
+  }
+  if (oa.hostname !== ob.hostname) {
+    return false;
+  }
+  if (oa.protocol && ob.protocol && oa.protocol !== ob.protocol) {
+    return false;
+  }
+  const proto = oa.protocol || ob.protocol;
+  const def = DEFAULT_PORTS[proto] || "";
+  return (oa.port || def) === (ob.port || def);
+}
