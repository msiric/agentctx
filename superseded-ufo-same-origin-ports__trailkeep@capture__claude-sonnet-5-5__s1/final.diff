diff --git a/test/same-origin.test.ts b/test/same-origin.test.ts
new file mode 100644
index 0000000..e1fb91f
--- /dev/null
+++ b/test/same-origin.test.ts
@@ -0,0 +1,107 @@
+import { describe, expect, test } from "vitest";
+// @ts-expect-error not implemented yet
+import { isSameOrigin } from "../src";
+
+// Proposed semantics: two URLs are same-origin when scheme + host + port match
+// (like the web platform's origin). Path, query, hash and credentials are ignored.
+// Ports are compared strictly as written: no default-port normalization.
+
+describe("isSameOrigin", () => {
+  const same = [
+    // Identical / differing only in path, query, hash
+    ["https://example.com", "https://example.com"],
+    ["https://example.com", "https://example.com/"],
+    ["https://example.com/foo", "https://example.com/bar"],
+    ["https://example.com/foo?a=1", "https://example.com/bar?b=2"],
+    ["https://example.com/#a", "https://example.com/#b"],
+
+    // Scheme and host are case-insensitive
+    ["HTTPS://EXAMPLE.COM/foo", "https://example.com/foo"],
+
+    // Credentials are not part of the origin
+    ["https://user:pass@example.com/foo", "https://example.com/foo"],
+
+    // Explicit non-default ports match each other
+    ["http://localhost:3000/a", "http://localhost:3000/b"],
+
+    // Backslashes are treated as slashes (consistent with parseURL)
+    ["https:\\\\example.com\\foo", "https://example.com/foo"],
+
+    // Two relative inputs share whatever origin they are resolved against
+    ["/foo", "/bar"],
+    ["foo", "/bar?x=1"],
+    ["", "/"],
+  ];
+
+  const notSame = [
+    // Different scheme
+    ["http://example.com", "https://example.com"],
+
+    // Different host (including subdomain, and no implicit www handling)
+    ["https://example.com", "https://example.org"],
+    ["https://example.com", "https://www.example.com"],
+    ["https://sub.example.com", "https://example.com"],
+
+    // Strict ports: no default-port normalization, an explicit port is
+    // never equal to an omitted one, even when it is the scheme's default
+    ["https://example.com", "https://example.com:443"],
+    ["http://example.com", "http://example.com:80"],
+    ["https://example.com:443/foo", "https://example.com/foo"],
+
+    // Different port
+    ["https://example.com:8443", "https://example.com"],
+    ["http://localhost:3000", "http://localhost:4000"],
+    ["http://example.com:443", "https://example.com:443"],
+
+    // Lookalike hosts / credential tricks must not match
+    ["https://example.com@evil.com", "https://example.com"],
+    ["https://example.com.evil.com", "https://example.com"],
+    ["https://example.com\\@evil.com", "https://example.com"],
+
+    // Relative vs absolute is not comparable without a base
+    ["/foo", "https://example.com/foo"],
+    ["https://example.com/foo", "foo"],
+    ["", "https://example.com"],
+
+    // Opaque / script protocols never share an origin
+    ["javascript:alert(1)", "javascript:alert(1)"],
+    ["data:text/plain,a", "data:text/plain,a"],
+    ["blob:https://example.com/uuid", "https://example.com"],
+  ];
+
+  for (const [a, b] of same) {
+    test(`${JSON.stringify(a)} == ${JSON.stringify(b)}`, () => {
+      expect(isSameOrigin(a, b)).toBe(true);
+      expect(isSameOrigin(b, a)).toBe(true); // symmetric
+    });
+  }
+
+  for (const [a, b] of notSame) {
+    test(`${JSON.stringify(a)} != ${JSON.stringify(b)}`, () => {
+      expect(isSameOrigin(a, b)).toBe(false);
+      expect(isSameOrigin(b, a)).toBe(false); // symmetric
+    });
+  }
+
+  // Open question: protocol-relative inputs ("//host") have no scheme.
+  // Proposal: compare host (+port) only when one side lacks a scheme.
+  describe("protocol-relative (to be agreed)", () => {
+    test("//example.com == //example.com/foo", () => {
+      expect(isSameOrigin("//example.com", "//example.com/foo")).toBe(true);
+    });
+    test("//example.com == https://example.com", () => {
+      expect(isSameOrigin("//example.com", "https://example.com")).toBe(true);
+    });
+    test("//example.com != https://example.org", () => {
+      expect(isSameOrigin("//example.com", "https://example.org")).toBe(false);
+    });
+  });
+
+  // Open question: file: URLs have an opaque origin in browsers.
+  // Proposal: follow the browser and treat them as never same-origin.
+  describe("file: (to be agreed)", () => {
+    test("file:///a != file:///b", () => {
+      expect(isSameOrigin("file:///a", "file:///b")).toBe(false);
+    });
+  });
+});
