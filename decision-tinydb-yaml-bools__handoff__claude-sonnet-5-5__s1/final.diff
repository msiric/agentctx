+# Words that YAML 1.1 reads as booleans but that we want to stay strings
+_YAML11_BOOL_WORDS = frozenset(
+    w for base in ('y', 'n', 'yes', 'no', 'on', 'off', 'true', 'false')
+    for w in (base, base.capitalize(), base.upper())
+)
+
+_yaml_classes = None
+
+
+def _get_yaml_classes():
+    """
+    Build (once) the PyYAML loader/dumper that only treat ``true``/``false``
+    (YAML 1.2 core spelling) as booleans.
+
+    PyYAML implements YAML 1.1 where ``NO``, ``off``, ``y`` ... are booleans.
+    The resolver tables are shared class state, so they are copied.
+    """
+    global _yaml_classes
+    if _yaml_classes is not None:
+        return _yaml_classes
+
+    try:
+        import yaml
+    except ImportError as e:  # pragma: no cover
+        raise ImportError(
+            'YAMLStorage requires PyYAML. Install it with "pip install tinydb[yaml]".'
+        ) from e
+
+    bool_tag = 'tag:yaml.org,2002:bool'
+    bool_re = re.compile(r'^(?:true|True|TRUE|false|False|FALSE)$')
+
+    def restricted(resolvers):
+        table = {}
+        for key, entries in resolvers.items():
+            table[key] = [(t, bool_re if t == bool_tag else r) for t, r in entries]
+        # Make sure t/T/f/F first characters exist (they do in PyYAML's table)
+        return table
+
+    class Loader(yaml.SafeLoader):
+        pass
+
+    class Dumper(yaml.SafeDumper):
+        pass
+
+    Loader.yaml_implicit_resolvers = restricted(yaml.SafeLoader.yaml_implicit_resolvers)
+    Dumper.yaml_implicit_resolvers = restricted(yaml.SafeDumper.yaml_implicit_resolvers)
+
+    # Only 'true'/'false' resolve as bool above, so a 1.1-style word such as
+    # "NO" would be written bare. Quote it so other YAML 1.1 readers keep it
+    # a string too.
+    def represent_str(dumper, value):
+        style = '"' if value in _YAML11_BOOL_WORDS else None
+        return dumper.represent_scalar('tag:yaml.org,2002:str', value, style=style)
+
+    Dumper.add_representer(str, represent_str)
+
+    _yaml_classes = (Loader, Dumper)
+    return _yaml_classes
+
+
+class YAMLStorage(FileStorage):
+    """
+    Store the data in a YAML file (requires PyYAML, ``pip install tinydb[yaml]``).
+
+    Only ``true``/``false`` (any of ``true``, ``True``, ``TRUE`` and likewise
+    for false) are read as booleans; YAML 1.1 words like ``NO`` or ``off``
+    stay strings. Only safe YAML tags are supported. Comments in the file are
+    not preserved when the database is written.
+    """
+
+    def __init__(self, path: str, create_dirs=False, encoding=None, access_mode='r+', **kwargs):
+        """
+        Create a new instance.
+
+        See :class:`FileStorage` for the file handling arguments.
+
+        :param kwargs: Passed on to :func:`yaml.dump` on every write.
+        """
+
+        _get_yaml_classes()  # fail early if PyYAML is missing
+        super().__init__(path, create_dirs=create_dirs, encoding=encoding, access_mode=access_mode)
+
+        self.kwargs = kwargs
+
+    def read(self) -> Optional[dict[str, dict[str, Any]]]:
+        import yaml
+
+        self._handle.seek(0)
+        text = self._handle.read()
+
+        if not text.strip():
+            return None
+
+        loader, _ = _get_yaml_classes()
+        # YAMLError is deliberately not caught: returning None would make the
+        # next write wipe a hand-edited file that merely has a syntax error.
+        data = yaml.load(text, Loader=loader)  # noqa: S506 - safe loader subclass
+
+        if data is None:
+            return None
+        if not isinstance(data, dict):
+            raise ValueError('YAML database must contain a mapping at the top level')
+
+        # Unquoted ``1:`` parses as an int key, but TinyDB looks up str(doc_id)
+        return {
+            str(name): (
+                {str(k): v for k, v in table.items()} if isinstance(table, dict) else table
+            )
+            for name, table in data.items()
+        }
+
+    def write(self, data: dict[str, dict[str, Any]]):
+        import yaml
+
+        _, dumper = _get_yaml_classes()
+        options = dict(sort_keys=False, default_flow_style=False, allow_unicode=True)
+        options.update(self.kwargs)
+
+        # Serialize first so a failure cannot leave a truncated file
+        serialized = yaml.dump(data, Dumper=dumper, **options)
+
+        self._handle.seek(0)
+        try:
+            self._handle.write(serialized)
+        except io.UnsupportedOperation:
+            raise IOError('Cannot write to the database. Access mode is "{0}"'.format(self._mode))
+
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+        self._handle.truncate()
+
+
