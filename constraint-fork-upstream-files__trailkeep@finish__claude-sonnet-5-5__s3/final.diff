diff --git a/test/dashdash.js b/test/dashdash.js
new file mode 100644
index 0000000..cb03074
--- /dev/null
+++ b/test/dashdash.js
@@ -0,0 +1,35 @@
+const test = require('tape');
+const fn = require('../lib');
+
+test('-- : default behavior', t => {
+	t.deepEqual(fn(['a', '--', 'b', '--x']), { _: ['a', 'b', '--x'] });
+	t.end();
+});
+
+test('-- : opts["--"] collects args after bare --', t => {
+	const argv = fn(['a', '--foo', 'bar', '--', 'b', '-x', '--y=1'], { '--': true });
+	t.deepEqual(argv, { _: ['a'], foo: 'bar', '--': ['b', '-x', '--y=1'] });
+	t.end();
+});
+
+test('-- : empty array when no bare --', t => {
+	t.deepEqual(fn(['a', '-x'], { '--': true }), { _: ['a'], x: true, '--': [] });
+	t.deepEqual(fn([], { '--': true }), { _: [], '--': [] });
+	t.end();
+});
+
+test('-- : trailing --', t => {
+	t.deepEqual(fn(['a', '--'], { '--': true }), { _: ['a'], '--': [] });
+	t.end();
+});
+
+test('-- : only first -- is consumed', t => {
+	t.deepEqual(fn(['--', 'a', '--', 'b'], { '--': true }), { _: [], '--': ['a', '--', 'b'] });
+	t.end();
+});
+
+test('-- : works with alias/boolean/string', t => {
+	const argv = fn(['-v', 'x', '--', '-v', '1'], { '--': true, boolean: 'v', alias: { v: 'verbose' } });
+	t.deepEqual(argv, { _: ['x'], v: true, verbose: true, '--': ['-v', '1'] });
+	t.end();
+});
