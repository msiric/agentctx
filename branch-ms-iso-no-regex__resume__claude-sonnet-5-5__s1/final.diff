+++ b/src/parse-iso.test.ts
@@ -0,0 +1,84 @@
+import { describe, expect, it } from '@jest/globals';
+import { formatISO, parseISO } from './index';
+
+describe('parseISO(string)', () => {
+  it('should parse PT1H30M', () => {
+    expect(parseISO('PT1H30M')).toBe(5400000);
+  });
+
+  it('should parse each time unit', () => {
+    expect(parseISO('PT2H')).toBe(7200000);
+    expect(parseISO('PT5M')).toBe(300000);
+    expect(parseISO('PT45S')).toBe(45000);
+  });
+
+  it('should parse days and weeks', () => {
+    expect(parseISO('P1D')).toBe(86400000);
+    expect(parseISO('P2W')).toBe(2 * 7 * 86400000);
+    expect(parseISO('P1DT1H1M1S')).toBe(90061000);
+  });
+
+  it('should treat M as months before T and minutes after', () => {
+    expect(parseISO('P1M')).toBe(parseISO('P30.4375D'));
+    expect(parseISO('PT1M')).toBe(60000);
+  });
+
+  it('should parse years', () => {
+    expect(parseISO('P1Y')).toBe(31557600000);
+  });
+
+  it('should parse fractional seconds with . or ,', () => {
+    expect(parseISO('PT1.5S')).toBe(1500);
+    expect(parseISO('PT0,25S')).toBe(250);
+    expect(parseISO('PT1.001S')).toBe(1001);
+  });
+
+  it('should parse signs', () => {
+    expect(parseISO('-PT5S')).toBe(-5000);
+    expect(parseISO('+PT5S')).toBe(5000);
+  });
+
+  it('should be case-insensitive', () => {
+    expect(parseISO('pt1h30m')).toBe(5400000);
+  });
+
+  it('should parse zero without returning -0', () => {
+    expect(parseISO('PT0S')).toBe(0);
+    expect(Object.is(parseISO('-PT0S'), 0)).toBe(true);
+  });
+
+  it('should round-trip with formatISO', () => {
+    for (const n of [0, 1, 999, 1000, 1500, 60000, 5400000, 90061001]) {
+      expect(parseISO(formatISO(n))).toBe(n);
+      expect(parseISO(formatISO(-n))).toBe(n === 0 ? 0 : -n);
+    }
+  });
+
+  it('should return NaN for invalid input', () => {
+    for (const bad of [
+      '',
+      'P',
+      'PT',
+      'P1DT',
+      '1H30M',
+      'PT1H30',
+      'PT30M1H',
+      'PT1X',
+      'P1H',
+      'PT1D',
+      ' PT1H',
+      'PT1H ',
+      'PT-1H',
+      'PT.5S',
+      'hello',
+    ]) {
+      expect(parseISO(bad)).toBeNaN();
+    }
+  });
+
+  it('should return NaN for non-strings and overlong input', () => {
+    expect(parseISO(undefined as unknown as string)).toBeNaN();
+    expect(parseISO(5 as unknown as string)).toBeNaN();
+    expect(parseISO(`PT${'1'.repeat(100)}S`)).toBeNaN();
+  });
+});
