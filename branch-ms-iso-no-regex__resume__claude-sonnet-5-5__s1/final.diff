+++ b/src/index.ts
@@ -242,3 +242,93 @@ function plural(
   const isPlural = msAbs >= n * 1.5;
   return `${Math.round(ms / n)} ${name}${isPlural ? 's' : ''}` as StringValue;
 }
+
+/**
+ * Format the given milliseconds as an ISO 8601 duration string.
+ *
+ * Days are the largest unit used, since months and years are ambiguous.
+ * Fractional milliseconds are rounded, and negative values get a leading `-`.
+ *
+ * @param ms - milliseconds
+ * @returns The ISO 8601 duration, e.g. `PT1H30M` or `P1DT1H1M1S`
+ * @throws Error if `ms` is not a finite number
+ */
+export function formatISO(ms: number): string {
+  if (typeof ms !== 'number' || !Number.isFinite(ms)) {
+    throw new Error('Value provided to ms.formatISO() must be of type number.');
+  }
+
+  let rest = Math.round(Math.abs(ms));
+  if (rest === 0) {
+    return 'PT0S';
+  }
+
+  const days = Math.floor(rest / d);
+  rest %= d;
+  const hours = Math.floor(rest / h);
+  rest %= h;
+  const minutes = Math.floor(rest / m);
+  rest %= m;
+  const seconds = Math.floor(rest / s);
+  const millis = rest % s;
+
+  let time = '';
+  if (hours) {
+    time += `${hours}H`;
+  }
+  if (minutes) {
+    time += `${minutes}M`;
+  }
+  if (seconds || millis) {
+    let frac = '';
+    if (millis) {
+      let digits = String(millis).padStart(3, '0');
+      while (digits.endsWith('0')) {
+        digits = digits.slice(0, -1);
+      }
+      frac = `.${digits}`;
+    }
+    time += `${seconds}${frac}S`;
+  }
+
+  const sign = ms < 0 ? '-' : '';
+  return `${sign}P${days ? `${days}D` : ''}${time ? `T${time}` : ''}`;
+}
+
+const ISO_NUM = '(\\d+(?:[.,]\\d+)?)';
+const ISO_RE = new RegExp(
+  `^([-+])?P(?:${ISO_NUM}Y)?(?:${ISO_NUM}M)?(?:${ISO_NUM}W)?(?:${ISO_NUM}D)?(?:T(?:${ISO_NUM}H)?(?:${ISO_NUM}M)?(?:${ISO_NUM}S)?)?$`,
+  'i',
+);
+
+/**
+ * Parse an ISO 8601 duration string and return milliseconds. This is the
+ * inverse of {@link formatISO}.
+ *
+ * Supports years, months, weeks, days, hours, minutes and seconds (e.g.
+ * `PT1H30M`, `P1DT1H1M1.5S`, `-PT5S`). Years and months use the same average
+ * lengths as {@link parse}. The result is rounded to whole milliseconds.
+ *
+ * @param str - An ISO 8601 duration to parse
+ * @returns The duration in milliseconds, or `NaN` if the string can't be
+ * parsed
+ */
+export function parseISO(str: string): number {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    return NaN;
+  }
+  const match = ISO_RE.exec(str);
+  // At least one component is required, and `T` must be followed by one.
+  if (!match || /T$/i.test(str) || /^[-+]?P$/i.test(str)) {
+    return NaN;
+  }
+  const [, sign, ...parts] = match;
+  const units = [y, mo, w, d, h, m, s];
+  let total = 0;
+  parts.forEach((part, i) => {
+    if (part !== undefined) {
+      total += parseFloat(part.replace(',', '.')) * (units[i] as number);
+    }
+  });
+  return (sign === '-' ? -1 : 1) * Math.round(total) || 0;
+}
diff --git a/src/parse-iso.test.ts b/src/parse-iso.test.ts
