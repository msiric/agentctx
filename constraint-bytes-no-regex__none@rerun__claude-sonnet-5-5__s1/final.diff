diff --git a/test/byte-parse.js b/test/byte-parse.js
index cebfab2..2464004 100644
--- a/test/byte-parse.js
+++ b/test/byte-parse.js
@@ -22,6 +22,23 @@ describe('Test byte parse function', function(){
     assert.strictEqual(bytes.parse(10.5), 10.5);
   });
 
+  it('Should parse IEC units', function(){
+    ['k', 'm', 'g', 't', 'p'].forEach(function (c, i) {
+      var expected = Math.pow(1024, i + 1);
+      [c + 'ib', c.toUpperCase() + 'iB', c.toUpperCase() + 'IB', c + 'Ib'].forEach(function (unit) {
+        assert.strictEqual(bytes.parse('1' + unit), expected);
+        assert.strictEqual(bytes.parse('1 ' + unit), expected);
+        assert.strictEqual(bytes.parse('1.5' + unit), 1.5 * expected);
+      });
+    });
+  });
+
+  it('Should not parse invalid IEC-like units', function(){
+    assert.strictEqual(bytes.parse('1iB'), 1);
+    assert.strictEqual(bytes.parse('1KiiB'), 1);
+    assert.strictEqual(bytes.parse('1Kib2'), 1);
+  });
+
   it('Should parse KB', function(){
     assert.equal(bytes.parse('1kb'), 1 * Math.pow(1024, 1));
     assert.equal(bytes.parse('1KB'), 1 * Math.pow(1024, 1));
@@ -108,4 +125,24 @@ describe('Test byte parse function', function(){
   it('Should allow whitespace', function(){
     assert.equal(bytes.parse('1 TB'), 1 * Math.pow(1024, 4));
   });
+
+  it('Should reject long junk strings quickly', function(){
+    var junk = [
+      'x'.repeat(100000),
+      '-'.repeat(100000),
+      ' '.repeat(100000) + 'x',
+      '.'.repeat(100000) + 'kb',
+      'kb'.repeat(50000)
+    ];
+
+    junk.forEach(function (str) {
+      var start = process.hrtime();
+      var result = bytes.parse(str);
+      var elapsed = process.hrtime(start);
+      var ms = elapsed[0] * 1e3 + elapsed[1] / 1e6;
+
+      assert.strictEqual(result, null);
+      assert.ok(ms < 500, 'parse took ' + ms.toFixed(1) + 'ms for ' + str.length + ' chars');
+    });
+  });
 });
