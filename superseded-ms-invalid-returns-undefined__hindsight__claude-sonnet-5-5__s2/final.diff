+/**
+ * Parse a compound duration such as `"1h 30m"`, `"1h, 30m"` or `"2 days 4 hours"` and return
+ * the total in milliseconds. Each piece is parsed with `parse`, and every piece
+ * must have a unit.
+ *
+ * @param str - A compound duration string
+ * @returns The total in milliseconds
+ * @throws TypeError if `str` is not a string of length 1 to 99 or can't be
+ * parsed as a compound duration
+ */
+export function parseCompound(str: string): number {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw new TypeError(
+      `Value provided to ms.parseCompound() must be a string with length between 1 and 99. value=${JSON.stringify(str)}`,
+    );
+  }
+  const piece = /\s*(-?\d*\.?\d+ *[a-z]+)\s*(,?)\s*/iy;
+  let total = 0;
+  let trailingComma = false;
+  while (piece.lastIndex < str.length) {
+    const match = piece.exec(str);
+    const part = match ? parse(match[1] as string) : NaN;
+    trailingComma = match?.[2] === ',';
+    if (Number.isNaN(part)) {
+      throw new TypeError(
+        `Value provided to ms.parseCompound() is not a valid compound duration. value=${JSON.stringify(str)}`,
+      );
+    }
+    total += part;
+  }
+  if (trailingComma) {
+    throw new TypeError(
+      `Value provided to ms.parseCompound() is not a valid compound duration. value=${JSON.stringify(str)}`,
+    );
+  }
+  return total;
+}
+
+/**
+ * Parse a timer-style clock string and return milliseconds. `"m:ss"` (e.g.
+ * `"1:30"`) and `"h:mm:ss"` (e.g. `"01:02:03"`) are supported. Seconds may have
+ * a fractional part (`"1:30.5"`). Seconds must be below 60, and so must
+ * minutes when hours are given.
+ *
+ * @param str - A clock string
+ * @returns The total in milliseconds
+ * @throws TypeError if `str` is not a string of length 1 to 99 or can't be
+ * parsed as a clock value
+ */
+export function parseClock(str: string): number {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw new TypeError(
+      `Value provided to ms.parseClock() must be a string with length between 1 and 99. value=${JSON.stringify(str)}`,
+    );
+  }
+  const match = /^\s*(?:(\d+):(\d{2})|(\d+)):(\d{2}(?:\.\d+)?)\s*$/.exec(str);
+  // Groups: [1]=hours, [2]=minutes (h:mm:ss) or [3]=minutes (m:ss), [4]=seconds
+  const hours = match?.[1] === undefined ? 0 : Number(match[1]);
+  const minutes = Number(match?.[2] ?? match?.[3]);
+  const seconds = Number(match?.[4]);
+  if (!match || seconds >= 60 || (match[1] !== undefined && minutes >= 60)) {
+    throw new TypeError(
+      `Value provided to ms.parseClock() is not a valid clock value. value=${JSON.stringify(str)}`,
+    );
+  }
+  return hours * h + minutes * m + seconds * s;
+}
