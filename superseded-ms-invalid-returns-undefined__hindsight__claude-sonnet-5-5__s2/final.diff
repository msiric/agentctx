+import { describe, expect, it } from '@jest/globals';
+import { parseCompound } from './index';
+
+describe('parseCompound(string)', () => {
+  it('should parse short compound durations', () => {
+    expect(parseCompound('1h 30m')).toBe(5400000);
+  });
+
+  it('should parse long compound durations', () => {
+    expect(parseCompound('2 days 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
+  });
+
+  it('should parse pieces without spaces between them', () => {
+    expect(parseCompound('1h30m15s')).toBe(5415000);
+  });
+
+  it('should parse a single piece like parse does', () => {
+    expect(parseCompound('2d')).toBe(172800000);
+  });
+
+  it('should accept commas between parts', () => {
+    expect(parseCompound('1h, 30m')).toBe(5400000);
+    expect(parseCompound('1h,30m')).toBe(5400000);
+    expect(parseCompound('2 days , 4 hours,30m')).toBe(
+      2 * 86400000 + 4 * 3600000 + 1800000,
+    );
+  });
+
+  it('should support decimals and negatives', () => {
+    expect(parseCompound('1.5h 30m')).toBe(7200000);
+    expect(parseCompound('1h -30m')).toBe(1800000);
+  });
+
+  it('should ignore surrounding whitespace', () => {
+    expect(parseCompound('  1m 30s ')).toBe(90000);
+  });
+
+  it('should throw a TypeError including the input for invalid input', () => {
+    for (const bad of [
+      '1h foo',
+      '1h 30',
+      'abc',
+      '   ',
+      '5foo',
+      '1h,',
+      ',1h',
+      '1h,,30m',
+      '1h , , 30m',
+    ]) {
+      expect(() => parseCompound(bad)).toThrow(TypeError);
+      expect(() => parseCompound(bad)).toThrow(JSON.stringify(bad));
+    }
+  });
+
+  it('should throw a TypeError for empty, non-string or too long values', () => {
+    expect(() => parseCompound('')).toThrow(TypeError);
+    expect(() => parseCompound('')).toThrow('""');
+    expect(() => parseCompound('1m '.repeat(40))).toThrow(TypeError);
+    // @ts-expect-error testing runtime behavior
+    expect(() => parseCompound(5)).toThrow(TypeError);
+  });
+});
