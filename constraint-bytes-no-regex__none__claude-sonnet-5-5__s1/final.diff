diff --git a/test/byte-parse.js b/test/byte-parse.js
index cebfab2..cef2401 100644
--- a/test/byte-parse.js
+++ b/test/byte-parse.js
@@ -108,4 +108,41 @@ describe('Test byte parse function', function(){
   it('Should allow whitespace', function(){
     assert.equal(bytes.parse('1 TB'), 1 * Math.pow(1024, 4));
   });
+
+  it('Should parse IEC units with the same values as the JEDEC units', function(){
+    ['k', 'm', 'g', 't', 'p'].forEach(function (prefix) {
+      assert.equal(bytes.parse('1' + prefix + 'ib'), bytes.parse('1' + prefix + 'b'));
+      assert.equal(bytes.parse('1.5 ' + prefix.toUpperCase() + 'iB'), bytes.parse('1.5' + prefix + 'b'));
+    });
+    assert.equal(bytes.parse('1KiB'), 1024);
+    assert.equal(bytes.parse('1MiB'), 1048576);
+    assert.equal(bytes.parse('1GiB'), 1073741824);
+    assert.equal(bytes.parse('1TiB'), Math.pow(1024, 4));
+    assert.equal(bytes.parse('1PiB'), Math.pow(1024, 5));
+  });
+
+  it('Should parse IEC units case-insensitively', function(){
+    assert.equal(bytes.parse('1kib'), 1024);
+    assert.equal(bytes.parse('1KIB'), 1024);
+    assert.equal(bytes.parse('-2 gIb'), -2 * 1073741824);
+  });
+
+  it('Should reject long junk strings quickly', function(){
+    var junk = [
+      'x'.repeat(100000),
+      ' '.repeat(100000) + 'x',
+      '.'.repeat(100000),
+      '-' + 'kb'.repeat(50000)
+    ];
+
+    junk.forEach(function (str) {
+      var start = process.hrtime();
+      var result = bytes.parse(str);
+      var elapsed = process.hrtime(start);
+      var ms = elapsed[0] * 1e3 + elapsed[1] / 1e6;
+
+      assert.strictEqual(result, null);
+      assert.ok(ms < 100, 'parse took ' + ms.toFixed(1) + 'ms');
+    });
+  });
 });
