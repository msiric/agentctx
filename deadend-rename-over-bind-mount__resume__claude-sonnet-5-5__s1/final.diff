@@ -285,3 +285,104 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def test_write_keeps_inode(tmpdir):
+    # The db file must be rewritten in place (it may be a bind-mounted file)
+    path = str(tmpdir.join('db.json'))
+    storage = JSONStorage(path)
+    storage.write({'a': 1})
+    inode = os.stat(path).st_ino
+    storage.write({'a': 2})
+    storage.close()
+
+    assert os.stat(path).st_ino == inode
+    assert sorted(os.listdir(str(tmpdir))) == ['db.json', 'db.json.bak']
+
+
+def test_recover_from_truncated_file(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    old, new = {'_default': {'1': {'v': 'old'}}}, {'_default': {'1': {'v': 'new' * 10}}}
+
+    storage = JSONStorage(path)
+    storage.write(old)
+    storage.close()
+
+    new_serialized = json.dumps(new)
+
+    # Simulate dying after every possible number of bytes of the in-place
+    # write (the file is truncated first, then the new data is written)
+    for cut in range(len(new_serialized)):
+        with open(path, 'w') as f:
+            f.write(new_serialized[:cut])
+
+        db = TinyDB(path)
+        try:
+            with pytest.warns(UserWarning, match='recovered'):
+                recovered = db.storage.read()
+        finally:
+            db.close()
+
+        assert recovered in (old, new)
+
+
+def test_crash_during_write(tmpdir, monkeypatch):
+    path = str(tmpdir.join('db.json'))
+    old, new = {'_default': {'1': {'v': 1}}}, {'_default': {'1': {'v': 2}}}
+
+    storage = JSONStorage(path)
+    storage.write(old)
+
+    # Die after the data was written to the file but before it is flushed,
+    # and in the middle of writing it
+    class Crash(Exception):
+        pass
+
+    real_handle = storage._handle
+
+    class Proxy:
+        def __getattr__(self, name):
+            return getattr(real_handle, name)
+
+        def write(self, data):
+            real_handle.write(data[:len(data) // 2])
+            real_handle.flush()
+            raise Crash()
+
+    storage._handle = Proxy()
+    with pytest.raises(Crash):
+        storage.write(new)
+    real_handle.close()
+
+    db = TinyDB(path)
+    with pytest.warns(UserWarning, match='recovered'):
+        assert db.storage.read() in (old, new)
+    db.close()
+
+
+def test_corrupt_file_without_backup_still_raises(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    with open(path, 'w') as f:
+        f.write('{"_default": {')
+
+    with pytest.raises(ValueError):
+        TinyDB(path).tables()
+
+
+def test_empty_file_without_backup_is_fresh_db(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    storage = JSONStorage(path)
+    assert storage.read() is None
+    storage.close()
+    assert os.listdir(str(tmpdir)) == ['db.json']
+
+
+def test_read_only_mode_creates_no_backup(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    with open(path, 'w') as f:
+        f.write('{}')
+    storage = JSONStorage(path, access_mode='r')
+    with pytest.raises(IOError):
+        storage.write({})
+    storage.close()
+    assert os.listdir(str(tmpdir)) == ['db.json']
