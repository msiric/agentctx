+def test_yaml(tmpdir):
+    path = str(tmpdir.join('test.yaml'))
+    storage = YAMLStorage(path)
+    assert storage.read() is None
+
+    storage.write(doc)
+    assert doc == storage.read()
+    storage.close()
+
+
+def test_yaml_shrinking_write(tmpdir):
+    path = str(tmpdir.join('test.yaml'))
+    storage = YAMLStorage(path)
+    storage.write(doc)
+    storage.write({'a': 1})
+    assert storage.read() == {'a': 1}
+    storage.close()
+
+
+def test_yaml_readonly(tmpdir):
+    path = str(tmpdir.join('test.yaml'))
+    YAMLStorage(path).close()
+
+    storage = YAMLStorage(path, access_mode='r')
+    with pytest.raises(IOError):
+        storage.write(doc)
+    storage.close()
+
+
+def test_yaml_create_dirs(tmpdir):
+    path = str(tmpdir.join('sub', 'dir', 'test.yaml'))
+    YAMLStorage(path, create_dirs=True).close()
+    assert os.path.exists(path)
+
+
+def test_yaml_with_tinydb(tmpdir):
+    path = str(tmpdir.join('test.yaml'))
+    with TinyDB(path, storage=YAMLStorage) as db:
+        db.insert({'name': 'a', 'n': 1})
+        db.insert({'name': 'b', 'n': 2})
+        db.update({'n': 3}, where('name') == 'a')
+        db.remove(where('name') == 'b')
+
+    with TinyDB(path, storage=YAMLStorage) as db:
+        assert db.all() == [{'name': 'a', 'n': 3}]
+        assert db.get(doc_id=1) == {'name': 'a', 'n': 3}
