+
+/**
+ * Format the given milliseconds as an ISO 8601 duration string, e.g. `PT1H30M`.
+ *
+ * Days are the largest unit used, since months and years are ambiguous.
+ * Zero-valued components are omitted, and zero is formatted as `PT0S`.
+ * Sub-second precision is emitted as a decimal fraction of seconds. Negative
+ * values get a leading `-` (as permitted by ISO 8601-2).
+ *
+ * @param ms - milliseconds
+ * @returns The ISO 8601 duration string
+ */
+export function formatISO(ms: number): string {
+  if (typeof ms !== 'number' || !Number.isFinite(ms)) {
+    throw new Error('Value provided to ms.formatISO() must be of type number.');
+  }
+
+  let rest = Math.round(Math.abs(ms));
+  const days = Math.floor(rest / d);
+  rest -= days * d;
+  const hours = Math.floor(rest / h);
+  rest -= hours * h;
+  const minutes = Math.floor(rest / m);
+  rest -= minutes * m;
+  const seconds = Math.floor(rest / s);
+  const millis = rest - seconds * s;
+
+  const date = days ? `${days}D` : '';
+  const secondsStr = millis
+    ? `${seconds}.${String(millis).padStart(3, '0').replace(/0+$/, '')}`
+    : String(seconds);
+  const time =
+    (hours ? `${hours}H` : '') +
+    (minutes ? `${minutes}M` : '') +
+    (seconds || millis ? `${secondsStr}S` : '');
+
+  if (!date && !time) {
+    return 'PT0S';
+  }
+  return `${ms < 0 ? '-' : ''}P${date}${time ? `T${time}` : ''}`;
+}
+
+/**
+ * Parse an ISO 8601 duration string, e.g. `PT1H30M`, into milliseconds.
+ * This is the inverse of `formatISO`.
+ *
+ * Supported designators are `W`, `D`, `H`, `M` and `S`, in that order. Years
+ * and months are rejected because their length is ambiguous. Only the last
+ * component may have a decimal fraction (`.` or `,`). A leading `-` or `+`
+ * sign is accepted. Implemented with a manual character scan (no regular
+ * expressions).
+ *
+ * @param str - the ISO 8601 duration
+ * @returns The duration in milliseconds
+ */
+export function parseISO(str: string): number {
+  if (typeof str !== "string") {
+    throw new Error("Value provided to ms.parseISO() must be a string.");
+  }
+  const fail = (): never => {
+    throw new Error(`Invalid ISO 8601 duration: ${JSON.stringify(str)}`);
+  };
+
+  // Guard against absurdly long input.
+  if (str.length > 100) {
+    return fail();
+  }
+
+  let i = 0;
+  let sign = 1;
+  if (str[i] === "-" || str[i] === "+") {
+    sign = str[i] === "-" ? -1 : 1;
+    i++;
+  }
+  if (str[i] !== "P") {
+    return fail();
+  }
+  i++;
+
+  const isDigit = (c: string | undefined): boolean =>
+    c !== undefined && c >= "0" && c <= "9";
+
+  let total = 0;
+  let inTime = false;
+  let components = 0;
+  let sawTimeComponent = false;
+  // Index into the designator order for the current section.
+  const dateUnits: Array<[string, number]> = [
+    ["W", w],
+    ["D", d],
+  ];
+  const timeUnits: Array<[string, number]> = [
+    ["H", h],
+    ["M", m],
+    ["S", s],
+  ];
+  let unitIdx = 0;
+  let fractionSeen = false;
+
+  while (i < str.length) {
+    if (str[i] === "T") {
+      if (inTime) {
+        return fail();
+      }
+      inTime = true;
+      unitIdx = 0;
+      i++;
+      continue;
+    }
+    if (fractionSeen) {
+      // Nothing may follow a fractional component.
+      return fail();
+    }
+
+    const start = i;
+    while (isDigit(str[i])) {
+      i++;
+    }
+    const intDigits = i - start;
+    if (intDigits === 0) {
+      return fail();
+    }
+    let value = Number(str.slice(start, i));
+
+    if (str[i] === "." || str[i] === ",") {
+      i++;
+      const fracStart = i;
+      while (isDigit(str[i])) {
+        i++;
+      }
+      if (i === fracStart) {
+        return fail();
+      }
+      value = Number(
+        `${str.slice(start, start + intDigits)}.${str.slice(fracStart, i)}`,
+      );
+      fractionSeen = true;
+    }
+
+    const designator = str[i];
+    const units = inTime ? timeUnits : dateUnits;
+    let found = -1;
+    for (let k = unitIdx; k < units.length; k++) {
+      if (units[k]![0] === designator) {
+        found = k;
+        break;
+      }
+    }
+    if (found === -1) {
+      return fail();
+    }
+    total += value * units[found]![1];
+    unitIdx = found + 1;
+    components++;
+    if (inTime) {
+      sawTimeComponent = true;
+    }
+    i++;
+  }
+
+  // Need at least one component, and 'T' must be followed by one.
+  if (components === 0 || (inTime && !sawTimeComponent)) {
+    return fail();
+  }
+  return sign * Math.round(total);
+}
