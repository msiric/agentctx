--- a/test.js
+++ b/test.js
@@ -292,3 +292,42 @@ test('keep the sub-day parts exact at any magnitude', () => {
 		assert.strictEqual(parsed.hours, Number(bigint.hours), `${milliseconds}ms hours against the bigint path`);
 	}
 });
+
+test('largestUnit', () => {
+	const ms = 93_600_000 + 61_001; // 1d 2h 1m 1s 1ms
+	const rest = {milliseconds: 1, microseconds: 0, nanoseconds: 0};
+	assert.deepStrictEqual(parseMilliseconds(ms, {largestUnit: 'days'}), parseMilliseconds(ms));
+	assert.deepStrictEqual(parseMilliseconds(ms, {largestUnit: 'hours'}), {
+		days: 0, hours: 26, minutes: 1, seconds: 1, ...rest,
+	});
+	assert.deepStrictEqual(parseMilliseconds(ms, {largestUnit: 'minutes'}), {
+		days: 0, hours: 0, minutes: 1561, seconds: 1, ...rest,
+	});
+	assert.deepStrictEqual(parseMilliseconds(ms, {largestUnit: 'seconds'}), {
+		days: 0, hours: 0, minutes: 0, seconds: 93_661, ...rest,
+	});
+	assert.deepStrictEqual(parseMilliseconds(-ms, {largestUnit: 'hours'}), {
+		days: 0, hours: -26, minutes: -1, seconds: -1, milliseconds: -1, microseconds: -0, nanoseconds: -0,
+	});
+});
+
+test('largestUnit with bigint', () => {
+	const ms = 93_600_000n + 61_001n;
+	const rest = {milliseconds: 1n, microseconds: 0n, nanoseconds: 0n};
+	assert.deepStrictEqual(parseMilliseconds(ms, {largestUnit: 'hours'}), {
+		days: 0n, hours: 26n, minutes: 1n, seconds: 1n, ...rest,
+	});
+	assert.deepStrictEqual(parseMilliseconds(ms, {largestUnit: 'minutes'}), {
+		days: 0n, hours: 0n, minutes: 1561n, seconds: 1n, ...rest,
+	});
+	assert.deepStrictEqual(parseMilliseconds(ms, {largestUnit: 'seconds'}), {
+		days: 0n, hours: 0n, minutes: 0n, seconds: 93_661n, ...rest,
+	});
+});
+
+test('largestUnit rejects invalid values', () => {
+	for (const largestUnit of ['weeks', 'day', '', null, 1]) {
+		assert.throws(() => parseMilliseconds(1000, {largestUnit}), TypeError);
+		assert.throws(() => parseMilliseconds(1000n, {largestUnit}), TypeError);
+	}
+});
