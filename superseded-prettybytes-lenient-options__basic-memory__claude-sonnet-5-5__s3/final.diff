 //=> '1.92 kB'
 ```
 
+##### significantDigits
+
+Type: `number`\
+Default: `3`
+
+The number of significant digits to round to.
+
+Only applies when neither `minimumFractionDigits` nor `maximumFractionDigits` is set. The integer part of a value is never cut short, so `999` bytes with `significantDigits: 1` is still `999 B`.
+
+Must be an integer between 1 and 100. Throws a `TypeError` for invalid values.
+
+```js
+import prettyBytes from 'pretty-bytes';
+
+prettyBytes(1337, {significantDigits: 2});
+//=> '1.3 kB'
+
+prettyBytes(1337, {significantDigits: 4});
+//=> '1.337 kB'
+```
+
 ##### space
 
 Type: `boolean`\
diff --git a/test.js b/test.js
index a8b6271..8934180 100644
--- a/test.js
+++ b/test.js
@@ -1191,3 +1191,30 @@ test('unit must belong to the active unit system', t => {
 		prettyBytes(10n ** 400n, {unit: 'KiB'});
 	}, {instanceOf: TypeError});
 });
+
+test('significantDigits', t => {
+	t.is(prettyBytes(1337, {significantDigits: 1}), '1 kB');
+	t.is(prettyBytes(1337, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 3}), '1.34 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 10}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4, locale: 'de'}), '1,337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4, bits: true}), '1.337 kbit');
+	t.is(prettyBytes(1337, {significantDigits: 1, unit: 'B'}), '1337 B');
+	t.is(prettyBytes(1337n, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(999, {significantDigits: 1}), '999 B');
+	t.is(prettyBytes(1337, {significantDigits: undefined}), '1.34 kB');
+});
+
+test('significantDigits is ignored when fraction digits are set', t => {
+	t.is(prettyBytes(1337, {significantDigits: 4, maximumFractionDigits: 1}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 1, minimumFractionDigits: 2}), '1.337 kB');
+});
+
+test('significantDigits must be an integer between 1 and 100', t => {
+	for (const significantDigits of [0, -1, 1.5, 101, Number.NaN, Number.POSITIVE_INFINITY, '3', null]) {
+		t.throws(() => {
+			prettyBytes(1337, {significantDigits});
+		}, {instanceOf: TypeError});
+	}
+});
