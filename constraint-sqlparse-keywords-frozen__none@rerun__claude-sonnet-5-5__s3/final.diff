+def test_cli_check_reports_files_that_would_change(tmpdir, capsys):
+    changed = tmpdir.join("changed.sql")
+    changed.write("select * from foo")
+    clean = tmpdir.join("clean.sql")
+    clean.write("SELECT * FROM foo")
+
+    result = sqlparse.cli.main(
+        ['--check', '-k', 'upper', str(changed), str(clean)])
+
+    out, _ = capsys.readouterr()
+    assert result == 1
+    assert out.splitlines() == [str(changed)]
+    assert changed.read() == "select * from foo"  # nothing written
+
+
+def test_cli_check_clean_exits_zero(tmpdir, capsys):
+    clean = tmpdir.join("clean.sql")
+    clean.write("SELECT * FROM foo")
+    assert sqlparse.cli.main(['--check', '-k', 'upper', str(clean)]) == 0
+    out, _ = capsys.readouterr()
+    assert out == ""
+
+
+def test_cli_check_incompatible_with_inplace_and_outfile(tmpdir, capsys):
+    f = tmpdir.join("a.sql")
+    f.write("select 1")
+    assert sqlparse.cli.main(['--check', '--in-place', str(f)]) != 0
+    assert sqlparse.cli.main(
+        ['--check', '-o', str(tmpdir.join("o.sql")), str(f)]) != 0
