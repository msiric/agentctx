+import io
 from argparse import Namespace
 from contextlib import contextmanager
 from unittest.mock import patch
@@ -155,3 +156,86 @@ def test_should_return_documented_error_code_for_invalid_version(cliargs, capsys
     # docs/pysemver.rst shows ``echo $?`` printing 2 for both commands
     assert main(cliargs) == 2
     assert capsys.readouterr().err.startswith("ERROR")
+
+
+def test_sort_prints_one_version_per_line(capsys):
+    assert main(["sort", "1.10.0", "1.2.0", "1.2.0-rc.1"]) == 0
+    assert capsys.readouterr().out == "1.2.0-rc.1\n1.2.0\n1.10.0\n"
+
+
+def test_sort_without_versions_prints_nothing(capsys):
+    with patch("sys.stdin", io.StringIO("")):
+        assert main(["sort"]) == 0
+    assert capsys.readouterr().out == ""
+
+
+def test_sort_invalid_version(capsys):
+    assert main(["sort", "1.0.0", "1.x"]) == 2
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert "ERROR" in captured.err
+
+
+def test_sort_reads_stdin_ignoring_blank_lines(capsys):
+    with patch("sys.stdin", io.StringIO("1.10.0\n\n  \n1.2.0\n")):
+        assert main(["sort"]) == 0
+    assert capsys.readouterr().out == "1.2.0\n1.10.0\n"
+
+
+def test_sort_stdin_invalid_version(capsys):
+    with patch("sys.stdin", io.StringIO("1.0.0\n1.x\n")):
+        assert main(["sort"]) == 2
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert "ERROR" in captured.err
+
+
+def test_sort_arguments_take_precedence_over_stdin(capsys):
+    with patch("sys.stdin", io.StringIO("9.9.9\n")):
+        assert main(["sort", "1.0.0", "2.0.0"]) == 0
+    assert capsys.readouterr().out == "1.0.0\n2.0.0\n"
+
+
+def test_latest_skips_prereleases(capsys):
