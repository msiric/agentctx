--- a/src/semver/cli.py
+++ b/src/semver/cli.py
@@ -83,6 +83,58 @@ def cmd_nextver(args: argparse.Namespace) -> str:
     return str(version.next_version(args.part))
 
 
+def _read_versions(args: argparse.Namespace) -> List[Version]:
+    """
+    Parse the versions given as arguments, or from stdin if there are none.
+
+    Stdin is read one version per line; blank lines are ignored.
+
+    :param args: The parsed arguments
+    :return: the parsed versions
+    :raises ValueError: if any version is invalid
+    """
+    raw = args.versions
+    if not raw:
+        raw = [line.strip() for line in sys.stdin if line.strip()]
+    return [Version.parse(v) for v in raw]
+
+
+def cmd_sort(args: argparse.Namespace) -> Optional[str]:
+    """
+    Subcommand: Sort versions, oldest first.
+
+    Synopsis: sort [<VERSION>...]
+
+    :param args: The parsed arguments
+    :return: the sorted versions, one per line (nothing if no versions given)
+
+    If no versions are given as arguments, they are read from stdin,
+    one per line; blank lines are ignored.
+    """
+    versions = sorted(_read_versions(args))
+    if not versions:
+        return None
+    return "\n".join(str(v) for v in versions)
+
+
+def cmd_latest(args: argparse.Namespace) -> Optional[str]:
+    """
+    Subcommand: Print the highest version that is not a prerelease.
+
+    Synopsis: latest [<VERSION>...]
+
+    :param args: The parsed arguments
+    :return: the highest non-prerelease version (nothing if there is none)
+
+    If no versions are given as arguments, they are read from stdin,
+    one per line; blank lines are ignored.
+    """
+    stable = [v for v in _read_versions(args) if not v.prerelease]
+    if not stable:
+        return None
+    return str(max(stable))
+
+
 def createparser() -> argparse.ArgumentParser:
     """
     Create an :class:`argparse.ArgumentParser` instance.
@@ -133,6 +185,18 @@ def createparser() -> argparse.ArgumentParser:
     parser_nextver.add_argument(
         "part", help="One of 'major', 'minor', 'patch', or 'prerelease'"
     )
+
+    # Create the sort subcommand
+    parser_sort = s.add_parser("sort", help="Sort versions, oldest first")
+    parser_sort.set_defaults(func=cmd_sort)
+    parser_sort.add_argument("versions", nargs="*", help="Versions to sort")
+
+    # Create the latest subcommand
+    parser_latest = s.add_parser(
+        "latest", help="Print the highest version that is not a prerelease"
+    )
+    parser_latest.set_defaults(func=cmd_latest)
+    parser_latest.add_argument("versions", nargs="*", help="Versions to search")
     return parser
 
 
