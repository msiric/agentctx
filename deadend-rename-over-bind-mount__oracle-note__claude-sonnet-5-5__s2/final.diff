@@ -119,6 +120,51 @@ class JSONStorage(Storage):
         # Open the file for reading/writing
         self._handle = open(path, mode=self._mode, encoding=encoding)
 
+        # Crash safety: writes go to a journal file first (see ``write``).
+        # The database file itself is never renamed/replaced, so this also
+        # works when it is a bind-mounted single file.
+        self._journal_path = str(path) + '.journal'
+        if '+' in self._mode:
+            self._recover()
+
+    def _recover(self) -> None:
+        """
+        Finish a write that was interrupted by a crash.
+
+        A complete journal holds the full new state, so it is replayed onto
+        the database file. An incomplete/corrupt journal means the crash
+        happened before the database file was touched, so it is discarded.
+        """
+        try:
+            with open(self._journal_path, 'rb') as f:
+                raw = f.read()
+        except FileNotFoundError:
+            return
+
+        digest, _, payload = raw.partition(b'\n')
+        if hashlib.sha256(payload).hexdigest().encode() == digest:
+            self._overwrite(payload.decode('utf-8'))
+
+        os.remove(self._journal_path)
+
+    def _overwrite(self, serialized: str) -> None:
+        self._handle.seek(0)
+        self._handle.write(serialized)
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+        # Remove data behind the cursor in case the file has gotten shorter
+        self._handle.truncate()
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+
+    def _write_journal(self, serialized: str) -> None:
+        payload = serialized.encode('utf-8')
+        digest = hashlib.sha256(payload).hexdigest().encode()
+        with open(self._journal_path, 'wb') as f:
+            f.write(digest + b'\n' + payload)
+            f.flush()
+            os.fsync(f.fileno())
+
     def close(self) -> None:
         self._handle.close()
 
