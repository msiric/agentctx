@@ -285,3 +285,69 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def test_crash_during_write_is_recovered(tmpdir):
+    """A write killed mid-way must leave a readable database on next open."""
+    import json as _json
+    import os as _os
+    from unittest import mock
+
+    path = str(tmpdir.join('db.json'))
+    db = TinyDB(path)
+    db.insert({'a': 1})
+    db.close()
+
+    class Crash(BaseException):
+        pass
+
+    # Crash after the db file was partially written (truncated mid-content)
+    real_overwrite = JSONStorage._overwrite
+
+    def torn(self, serialized):
+        self._handle.seek(0)
+        self._handle.write(serialized[:5])
+        self._handle.flush()
+        self._handle.truncate()
+        raise Crash
+
+    db = TinyDB(path)
+    with mock.patch.object(JSONStorage, '_overwrite', torn):
+        with pytest.raises(Crash):
+            db.insert({'b': 2})
+    db._storage._handle.close()
+
+    with pytest.raises(ValueError):
+        _json.load(open(path))  # file really is corrupt now
+
+    db = TinyDB(path)
+    assert db.all() == [{'a': 1}, {'b': 2}]
+    assert not _os.path.exists(path + '.journal')
+    db.close()
+
+
+def test_crash_while_writing_journal_keeps_old_state(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    db = TinyDB(path)
+    db.insert({'a': 1})
+    db.close()
+
+    # Partial / corrupt journal left behind by a crash during journaling
+    with open(path + '.journal', 'wb') as f:
+        f.write(b'deadbeef\n{"_default": {"1": {"a"')
+
+    db = TinyDB(path)
+    assert db.all() == [{'a': 1}]
+    db.close()
+    assert not os.path.exists(path + '.journal')
+
+
+def test_write_does_not_replace_db_file(tmpdir):
+    """The db file must keep its inode (bind-mount friendly)."""
+    path = str(tmpdir.join('db.json'))
+    db = TinyDB(path)
+    ino = os.stat(path).st_ino
+    db.insert({'a': 1})
+    assert os.stat(path).st_ino == ino
+    assert not os.path.exists(path + '.journal')
+    db.close()
