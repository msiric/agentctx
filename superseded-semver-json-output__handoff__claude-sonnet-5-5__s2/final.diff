 """
 
 import argparse
+import json
 import sys
 from typing import cast, List, Optional
 
@@ -83,6 +84,48 @@ def cmd_nextver(args: argparse.Namespace) -> str:
     return str(version.next_version(args.part))
 
 
+def cmd_sort(args: argparse.Namespace) -> Optional[str]:
+    """
+    Subcommand: Sort versions, oldest first, one per line.
+
+    Synopsis: sort [<VERSION>...]
+
+    Without any ``VERSION``, versions are read from stdin, one per line.
+    Blank lines are ignored.
+
+    :param args: The parsed arguments
+    """
+    raw = args.versions
+    if not raw:
+        raw = [line.strip() for line in sys.stdin if line.strip()]
+    versions = sorted(Version.parse(v) for v in raw)
+    if not versions:
+        return None
+    return "\n".join(str(v) for v in versions)
+
+
+def cmd_latest(args: argparse.Namespace) -> str:
+    """
+    Subcommand: Print the highest version that is not a prerelease.
+
+    Synopsis: latest [<VERSION>...]
+
+    Without any ``VERSION``, versions are read from stdin, one per line.
+    Blank lines are ignored. The result is printed as a JSON string.
+
+    :param args: The parsed arguments
+    :return: the highest non-prerelease version, JSON encoded
+    :raises ValueError: if there is no non-prerelease version
+    """
+    raw = args.versions
+    if not raw:
+        raw = [line.strip() for line in sys.stdin if line.strip()]
+    stable = [v for v in map(Version.parse, raw) if not v.prerelease]
+    if not stable:
+        raise ValueError("no non-prerelease version given")
+    return json.dumps(str(max(stable)))
+
+
 def createparser() -> argparse.ArgumentParser:
     """
     Create an :class:`argparse.ArgumentParser` instance.
@@ -133,6 +176,20 @@ def createparser() -> argparse.ArgumentParser:
     parser_nextver.add_argument(
         "part", help="One of 'major', 'minor', 'patch', or 'prerelease'"
     )
+
+    # Create the sort subcommand
+    parser_sort = s.add_parser(
+        "sort", help="Sorts versions, oldest first, one per line"
+    )
+    parser_sort.set_defaults(func=cmd_sort)
+    parser_sort.add_argument("versions", nargs="*", help="Versions to sort")
+
+    # Create the latest subcommand
+    parser_latest = s.add_parser(
+        "latest", help="Prints the highest version that is not a prerelease"
+    )
+    parser_latest.set_defaults(func=cmd_latest)
+    parser_latest.add_argument("versions", nargs="*", help="Versions to search")
