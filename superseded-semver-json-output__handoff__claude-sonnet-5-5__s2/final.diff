diff --git a/tests/test_latest.py b/tests/test_latest.py
new file mode 100644
index 0000000..ddc0297
--- /dev/null
+++ b/tests/test_latest.py
@@ -0,0 +1,58 @@
+import io
+import json
+
+from semver import main
+from semver.cli import cmd_latest, createparser
+
+
+def test_latest_skips_prereleases(capsys):
+    assert main(["latest", "1.2.0", "2.0.0-rc.1", "1.10.0", "1.9.0"]) == 0
+    assert json.loads(capsys.readouterr().out) == "1.10.0"
+
+
+def test_latest_output_is_json_string(capsys):
+    main(["latest", "1.0.0"])
+    assert capsys.readouterr().out == '"1.0.0"\n'
+
+
+def test_latest_keeps_build_metadata(capsys):
+    main(["latest", "1.0.0+b1", "0.9.0"])
+    assert json.loads(capsys.readouterr().out) == "1.0.0+b1"
+
+
+def test_latest_reads_stdin(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO("1.2.0\n\n3.0.0-beta\n1.3.0\n"))
+    assert main(["latest"]) == 0
+    assert json.loads(capsys.readouterr().out) == "1.3.0"
+
+
+def test_latest_args_take_precedence_over_stdin(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO("9.9.9\n"))
+    assert main(["latest", "1.0.0"]) == 0
+    assert json.loads(capsys.readouterr().out) == "1.0.0"
+
+
+def test_latest_only_prereleases(capsys):
+    assert main(["latest", "1.0.0-rc.1", "2.0.0-alpha"]) == 2
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert "ERROR" in captured.err
+
+
+def test_latest_no_versions(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO(""))
+    assert main(["latest"]) == 2
+    assert capsys.readouterr().out == ""
+
+
+def test_latest_invalid_version(capsys):
+    assert main(["latest", "1.0.0", "1.2"]) == 2
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert "ERROR" in captured.err
+
+
+def test_latest_parser():
+    args = createparser().parse_args(["latest", "1.0.0"])
+    assert args.versions == ["1.0.0"]
+    assert args.func is cmd_latest
