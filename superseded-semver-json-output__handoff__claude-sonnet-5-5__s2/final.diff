@@ -0,0 +1,61 @@
+import io
+
+import pytest
+
+from semver import main
+from semver.cli import cmd_sort, createparser
+
+
+def test_sort_orders_oldest_first_one_per_line(capsys):
+    assert main(["sort", "1.10.0", "1.2.0", "1.2.0-rc.1", "0.9.9"]) == 0
+    out = capsys.readouterr().out
+    assert out == "0.9.9\n1.2.0-rc.1\n1.2.0\n1.10.0\n"
+
+
+def test_sort_output_has_no_extra_formatting(capsys):
+    main(["sort", "2.0.0", "1.0.0"])
+    assert capsys.readouterr().out.splitlines() == ["1.0.0", "2.0.0"]
+
+
+def test_sort_single_version(capsys):
+    assert main(["sort", "1.2.3"]) == 0
+    assert capsys.readouterr().out == "1.2.3\n"
+
+
+def test_sort_no_versions_prints_nothing(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO(""))
+    assert main(["sort"]) == 0
+    assert capsys.readouterr().out == ""
+
+
+def test_sort_invalid_version(capsys):
+    assert main(["sort", "1.2.3", "1.2"]) == 2
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert "ERROR" in captured.err
+
+
+def test_sort_parser():
+    args = createparser().parse_args(["sort", "1.0.0", "0.1.0"])
+    assert args.versions == ["1.0.0", "0.1.0"]
+    assert args.func is cmd_sort
+
+
+def test_sort_reads_stdin_when_no_args(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO("1.10.0\n\n  \n1.2.0\n1.2.0-rc.1\n"))
+    assert main(["sort"]) == 0
+    assert capsys.readouterr().out == "1.2.0-rc.1\n1.2.0\n1.10.0\n"
+
+
+def test_sort_stdin_invalid_version(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO("1.0.0\nnope\n"))
+    assert main(["sort"]) == 2
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert "ERROR" in captured.err
+
+
+def test_sort_args_take_precedence_over_stdin(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO("9.9.9\n"))
+    assert main(["sort", "2.0.0", "1.0.0"]) == 0
+    assert capsys.readouterr().out == "1.0.0\n2.0.0\n"
