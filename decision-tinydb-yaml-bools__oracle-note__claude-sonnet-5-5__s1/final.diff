+class YAMLStorage(FileStorage):
+    """
+    Store the data in a YAML file.
+
+    Requires PyYAML. Only ``true`` and ``false`` are read as booleans, so
+    hand-edited values like ``yes``, ``NO``, ``on`` or ``Off`` load as strings.
+    """
+
+    def __init__(self, path: str, create_dirs=False, encoding=None, access_mode='r+', **kwargs):
+        """
+        :param path: Where to store the YAML data.
+        :param kwargs: Extra arguments passed to ``yaml.dump``.
+        """
+
+        try:
+            import yaml
+        except ImportError as e:  # pragma: no cover
+            raise ImportError('YAMLStorage requires PyYAML to be installed') from e
+
+        super().__init__(path, create_dirs=create_dirs, encoding=encoding, access_mode=access_mode)
+
+        self.kwargs = kwargs
+        self._yaml = yaml
+        self._loader, self._dumper = _yaml_classes(yaml)
+
+    def read(self) -> Optional[dict[str, dict[str, Any]]]:
+        self._handle.seek(0)
+        return self._yaml.load(self._handle, Loader=self._loader)
+
+    def write(self, data: dict[str, dict[str, Any]]):
+        self._handle.seek(0)
+
+        serialized = self._yaml.dump(data, Dumper=self._dumper, **self.kwargs)
+
+        try:
+            self._handle.write(serialized)
+        except io.UnsupportedOperation:
+            raise IOError('Cannot write to the database. Access mode is "{0}"'.format(self._mode))
+
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+        self._handle.truncate()
+
+
+_yaml_cache: Optional[tuple] = None
+
+
+def _yaml_classes(yaml):
+    """
+    Build (once) a safe loader that only treats ``true``/``false`` as booleans
+    and a safe dumper that can serialize dict subclasses such as ``Document``.
+    """
+    global _yaml_cache
+    if _yaml_cache is not None:
+        return _yaml_cache
+
+    class Loader(yaml.SafeLoader):
+        pass
+
+    # Copy the resolver table so SafeLoader itself stays untouched
+    Loader.yaml_implicit_resolvers = {
+        ch: [(tag, rx) for tag, rx in resolvers if tag != 'tag:yaml.org,2002:bool']
+        for ch, resolvers in yaml.SafeLoader.yaml_implicit_resolvers.items()
+    }
+    Loader.add_implicit_resolver(
+        'tag:yaml.org,2002:bool', re.compile(r'^(?:true|false)$'), list('tf')
+    )
+
+    class Dumper(yaml.SafeDumper):
+        pass
+
+    Dumper.add_multi_representer(
+        dict, lambda dumper, data: dumper.represent_dict(dict(data))
+    )
+
+    _yaml_cache = (Loader, Dumper)
+    return _yaml_cache
+
+
