+def test_yaml_storage(tmpdir):
+    pytest.importorskip('yaml')
+
+    path = str(tmpdir.join('test.yaml'))
+    with TinyDB(path, storage=YAMLStorage) as db:
+        db.insert({'name': 'foo', 'flag': True, 'word': 'yes'})
+        db.insert({'name': 'bar', 'n': 3})
+        db.update({'name': 'baz'}, where('n') == 3)
+        assert '!' not in tmpdir.join('test.yaml').read()
+
+    with TinyDB(path, storage=YAMLStorage) as db:
+        assert db.get(doc_id=1) == {'name': 'foo', 'flag': True, 'word': 'yes'}
+        assert db.get(where('name') == 'baz')['n'] == 3
+        assert len(db) == 2
+
+
+def test_yaml_storage_only_true_false_are_bools(tmpdir):
+    pytest.importorskip('yaml')
+
+    path = tmpdir.join('test.yaml')
+    path.write(
+        '_default:\n'
+        '  "1": {a: NO, b: yes, c: off, d: On, e: true, f: false, g: y, h: n}\n'
+    )
+    with TinyDB(str(path), storage=YAMLStorage) as db:
+        assert db.get(doc_id=1) == {
+            'a': 'NO', 'b': 'yes', 'c': 'off', 'd': 'On',
+            'e': True, 'f': False, 'g': 'y', 'h': 'n',
+        }
+
+    import yaml
+    assert yaml.safe_load('a: NO')['a'] is False  # global loader untouched
+
+
+def test_yaml_storage_shrinking_file(tmpdir):
+    pytest.importorskip('yaml')
+
+    path = str(tmpdir.join('test.yaml'))
+    with TinyDB(path, storage=YAMLStorage) as db:
+        db.insert({'text': 'x' * 200})
+        db.truncate()
+    with TinyDB(path, storage=YAMLStorage) as db:
+        assert len(db) == 0
+
