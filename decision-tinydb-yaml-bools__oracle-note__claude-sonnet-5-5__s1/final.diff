+class YAMLStorage(FileStorage):
+    """
+    Store the data in a YAML file.
+
+    Requires PyYAML. Only ``true`` and ``false`` are read as booleans; values
+    such as ``yes``, ``NO``, ``on`` or ``Off`` are loaded as strings.
+    """
+
+    _loader = None
+
+    @classmethod
+    def _get_loader(cls):
+        if cls._loader is None:
+            import re
+
+            import yaml
+
+            class _Loader(yaml.SafeLoader):
+                pass
+
+            bool_re = re.compile(r'^(?:true|false)$')
+
+            # Copy the resolver table so SafeLoader itself stays untouched
+            resolvers = {}
+            for char, entries in yaml.SafeLoader.yaml_implicit_resolvers.items():
+                kept = [(t, r) for t, r in entries if t != 'tag:yaml.org,2002:bool']
+                if kept:
+                    resolvers[char] = kept
+            for char in 'tf':
+                resolvers.setdefault(char, []).append(('tag:yaml.org,2002:bool', bool_re))
+            _Loader.yaml_implicit_resolvers = resolvers
+
+            cls._loader = _Loader
+        return cls._loader
+
+    def __init__(self, path: str, create_dirs=False, encoding=None, access_mode='r+', **kwargs):
+        """
+        Create a new instance.
+
+        See :class:`FileStorage` for the file handling arguments. Extra
+        ``kwargs`` are passed to ``yaml.safe_dump``.
+
+        :param path: Where to store the YAML data.
+        """
+
+        self._get_loader()  # fail early if PyYAML is missing
+        super().__init__(path, create_dirs=create_dirs, encoding=encoding, access_mode=access_mode)
+
+        self.kwargs = kwargs
+
+    def read(self) -> Optional[dict[str, dict[str, Any]]]:
+        import yaml
+
+        self._handle.seek(0, os.SEEK_END)
+        if not self._handle.tell():
+            return None
+
+        self._handle.seek(0)
+        data = yaml.load(self._handle, Loader=self._get_loader())
+        return data or None
+
+    def write(self, data: dict[str, dict[str, Any]]):
+        import yaml
+
+        self._handle.seek(0)
+
+        serialized = yaml.safe_dump(data, **self.kwargs)
+
+        try:
+            self._handle.write(serialized)
+        except io.UnsupportedOperation:
+            raise IOError('Cannot write to the database. Access mode is "{0}"'.format(self._mode))
+
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+        self._handle.truncate()
+
+
