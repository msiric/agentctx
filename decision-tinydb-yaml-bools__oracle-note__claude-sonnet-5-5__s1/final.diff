+def test_yaml(tmpdir):
+    path = str(tmpdir.join('test.yaml'))
+    storage = YAMLStorage(path)
+    assert storage.read() is None
+    storage.write(doc)
+    assert doc == storage.read()
+    storage.close()
+
+
+def test_yaml_shrinking_write(tmpdir):
+    path = str(tmpdir.join('test.yaml'))
+    storage = YAMLStorage(path)
+    storage.write(doc)
+    storage.write({'a': 1})
+    assert storage.read() == {'a': 1}
+    storage.close()
+
+
+def test_yaml_only_true_false_are_booleans(tmpdir):
+    path = str(tmpdir.join('test.yaml'))
+    with open(path, 'w') as f:
+        f.write('t: true\nf: false\nT: True\n'
+                'a: NO\nb: yes\nc: off\nd: On\ne: Yes\nf2: n\n')
+    storage = YAMLStorage(path)
+    data = storage.read()
+    storage.close()
+    assert data['t'] is True and data['f'] is False and data['T'] == 'True'
+    assert data['a'] == 'NO' and data['b'] == 'yes'
+    assert data['c'] == 'off' and data['d'] == 'On'
+    assert data['e'] == 'Yes' and data['f2'] == 'n'
+
+
+def test_yaml_string_roundtrip(tmpdir):
+    path = str(tmpdir.join('test.yaml'))
+    storage = YAMLStorage(path)
+    value = {'s': ['yes', 'NO', 'off', 'On', 'true'], 'b': [True, False]}
+    storage.write(value)
+    assert storage.read() == value
+    storage.close()
+
+
+def test_yaml_with_tinydb(tmpdir):
+    path = str(tmpdir.join('test.yaml'))
+    with TinyDB(path, storage=YAMLStorage) as db:
+        db.insert({'x': 1, 'flag': True, 'answer': 'yes'})
+    with TinyDB(path, storage=YAMLStorage) as db:
+        assert db.all() == [{'x': 1, 'flag': True, 'answer': 'yes'}]
