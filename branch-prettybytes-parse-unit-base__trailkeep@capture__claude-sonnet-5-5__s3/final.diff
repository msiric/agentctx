+
+test('parseBytes: plain numbers and bytes', t => {
+	t.is(parseBytes('0'), 0);
+	t.is(parseBytes('512'), 512);
+	t.is(parseBytes('512 B'), 512);
+	t.is(parseBytes('512B'), 512);
+	t.is(parseBytes('  512  B  '), 512);
+	t.is(parseBytes('0.5'), 0.5);
+	t.is(parseBytes('.5 B'), 0.5);
+});
+
+test('parseBytes: binary units', t => {
+	for (const [exponent, unit] of BINARY_UNITS.entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1024 ** exponent);
+		t.is(parseBytes(`2${unit}`), 2 * (1024 ** exponent));
+	}
+});
+
+test('parseBytes: fractional values', t => {
+	t.is(parseBytes('1.5 KiB'), 1536);
+	t.is(parseBytes('0.25 MiB'), 262_144);
+	t.is(parseBytes('1.5 YiB'), 1.5 * (1024 ** 8));
+});
+
+test('parseBytes: round-trips binary prettyBytes output', t => {
+	for (const bytes of [0, 1, 512, 1024, 1536, 10_240, 1024 ** 3, 1024 ** 5]) {
+		t.is(parseBytes(prettyBytes(bytes, {binary: true})), bytes);
+		t.is(parseBytes(prettyBytes(bytes, {binary: true, space: false})), bytes);
+	}
+});
+
+test('parseBytes: units are case-sensitive', t => {
+	for (const input of ['1 kib', '1 KIB', '1 kiB', '1 mib', '1 b', '1 Kib']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError});
+	}
+});
+
+test('parseBytes: units without the i are powers of 1024', t => {
+	t.is(parseBytes('1 kB'), 1024);
+	t.is(parseBytes('1 KB'), 1024);
+	t.is(parseBytes('1 MB'), 1_048_576);
+	t.is(parseBytes('1.5GB'), 1.5 * (1024 ** 3));
+
+	for (const [index, unit] of ['MB', 'GB', 'TB', 'PB', 'EB', 'ZB', 'YB'].entries()) {
+		t.is(parseBytes(`2 ${unit}`), 2 * (1024 ** (index + 2)));
+	}
+});
+
+test('parseBytes: unsupported units', t => {
+	for (const unit of ['kb', 'Kb', 'mB', 'mb', 'gB', 'kbit', 'Kibit']) {
+		t.throws(() => parseBytes(`1 ${unit}`), {instanceOf: SyntaxError, message: /Unsupported unit/});
+	}
+});
+
+test('parseBytes: invalid input', t => {
+	for (const input of ['', ' ', 'KiB', 'abc', '-1 KiB', '+1 KiB', '1e3', '1,000', '1.', '1.2.3', '1 2 KiB', 'Infinity', 'NaN', '1 Ki B']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError});
+	}
+
+	for (const input of [1, undefined, null, 1n, {}]) {
+		t.throws(() => parseBytes(input), {instanceOf: TypeError});
+	}
+});
