diff --git a/index.d.ts b/index.d.ts
index 4fac6e9..6f919f0 100644
--- a/index.d.ts
+++ b/index.d.ts
@@ -216,3 +216,30 @@ export default function prettyBytes(
 	number: number | bigint,
 	options?: Options
 ): string;
+
+/**
+Convert a size string to a number of bytes, the reverse of `prettyBytes(number, {binary: true})`: `'1.5 KiB'` → `1536`.
+
+Accepts a plain number (`'512'`), or a number followed by `B` or one of `KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`, `ZiB`, `YiB`, with or without a space. The same units without the `i` (`kB` or `KB`, `MB`, `GB`, `TB`, `PB`, `EB`, `ZB`, `YB`) are also accepted and are powers of 1024 too, like Windows Explorer shows them: `'1 KB'` → `1024` and `'1 MB'` → `1048576`. Fractional values are allowed. Units are case-sensitive. Surrounding whitespace is ignored.
+
+Bits, signs and exponents are not supported and throw.
+
+@param string - The size to parse.
+@returns The number of bytes. It is not rounded, so a fractional result is possible, like `'0.5 B'` → `0.5`.
+@throws A `TypeError` if the input is not a string, and a `SyntaxError` if it is not a number with an optional supported unit.
+
+@example
+```
+import {parseBytes} from 'pretty-bytes';
+
+parseBytes('512');
+//=> 512
+
+parseBytes('1.5 KiB');
+//=> 1536
+
+parseBytes('1 MB');
+//=> 1048576
+```
+*/
+export function parseBytes(string: string): number;
diff --git a/index.js b/index.js
index c5f37ab..e519c47 100644
--- a/index.js
+++ b/index.js
@@ -285,3 +285,34 @@ export default function prettyBytes(number, options) {
 	const result = prefix + numberString + separator + UNITS[exponent];
 	return result.padStart(options.fixedWidth ?? 0);
 }
+
+// Units without the `i` (`kB`/`KB`, `MB`, ...) are read as powers of 1024 too, matching what Windows Explorer shows.
+const BYTE_MULTIPLIERS = new Map([
+	...BIBYTE_UNITS.map((unit, exponent) => [unit, 1024 ** exponent]),
+	...['kB', 'MB', 'GB', 'TB', 'PB', 'EB', 'ZB', 'YB'].map((unit, index) => [unit, 1024 ** (index + 1)]),
+	['KB', 1024],
+]);
+
+// An optional unit may follow the number, with or without whitespace. Only plain decimal digits are accepted, so signs, exponents, separators and `Infinity` are rejected.
+const BYTES_PATTERN = /^\s*(\d+(?:\.\d+)?|\.\d+)\s*([A-Za-z]*)\s*$/;
+
+export function parseBytes(string) {
+	if (typeof string !== 'string') {
+		throw new TypeError(`Expected a string, got ${typeof string}: ${string}`);
+	}
+
+	const match = BYTES_PATTERN.exec(string);
+
+	if (!match) {
+		throw new SyntaxError(`Cannot parse bytes from: ${JSON.stringify(string)}`);
+	}
+
+	const [, value, unit] = match;
+	const multiplier = unit === '' ? 1 : BYTE_MULTIPLIERS.get(unit);
+
+	if (multiplier === undefined) {
+		throw new SyntaxError(`Unsupported unit ${JSON.stringify(unit)} in: ${JSON.stringify(string)}`);
+	}
+
+	return Number(value) * multiplier;
+}
