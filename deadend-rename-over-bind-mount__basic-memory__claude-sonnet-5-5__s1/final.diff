@@ -285,3 +285,74 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def test_json_write_is_atomic_on_crash(tmpdir, monkeypatch):
+    # Simulate the process dying right before the rename: the database file
+    # must still contain the complete old state.
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+
+        def crash(*args, **kwargs):
+            raise KeyboardInterrupt('simulated kill')
+
+        monkeypatch.setattr(os, 'replace', crash)
+        with pytest.raises(KeyboardInterrupt):
+            db.insert({'a': 2})
+        monkeypatch.undo()
+
+    # No temp files left behind, old state is intact and readable
+    assert os.listdir(str(tmpdir)) == ['db.json']
+    with TinyDB(path) as db:
+        assert db.all() == [{'a': 1}]
+
+
+def test_json_write_crash_during_serialization(tmpdir):
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+        with pytest.raises(TypeError):
+            db.insert({'a': object()})
+
+    with TinyDB(path) as db:
+        assert db.all() == [{'a': 1}]
+
+
+def test_json_write_crash_mid_temp_write(tmpdir, monkeypatch):
+    # A failure while the temp file is being written must not touch
+    # the real database.
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+
+        def crash(fd):
+            raise KeyboardInterrupt('simulated kill')
+
+        monkeypatch.setattr(os, 'fsync', crash)
+        with pytest.raises(KeyboardInterrupt):
+            db.insert({'a': 2})
+        monkeypatch.undo()
+
+    with TinyDB(path) as db:
+        assert db.all() == [{'a': 1}]
+
+
+def test_json_write_keeps_permissions_and_symlink(tmpdir):
+    real = tmpdir.join('real.json')
+    link = tmpdir.join('link.json')
+    real.write('{}')
+    os.chmod(str(real), 0o640)
+    os.symlink(str(real), str(link))
+
+    with TinyDB(str(link)) as db:
+        db.insert({'a': 1})
+        db.insert({'a': 2})
+
+    assert os.path.islink(str(link))
+    assert (os.stat(str(real)).st_mode & 0o777) == 0o640
+    with TinyDB(str(real)) as db:
+        assert len(db) == 2
