+    def _atomic_write(self, serialized: str) -> None:
+        """
+        Crash-safe write: write to a temporary file in the same directory,
+        fsync it and atomically rename it over the database file. A crash at
+        any point leaves either the old or the new contents on disk.
+        """
+
+        # Resolve symlinks so we replace the real file, not the link
+        target = os.path.realpath(self._path)
+        directory = os.path.dirname(target)
+
+        fd, tmp_path = tempfile.mkstemp(
+            dir=directory, prefix=os.path.basename(target) + '.', suffix='.tmp'
+        )
+        try:
+            with os.fdopen(fd, 'w', encoding=self._encoding) as tmp:
+                tmp.write(serialized)
+                tmp.flush()
+                os.fsync(tmp.fileno())
+
+            # Keep the permissions of the existing database file
+            try:
+                shutil.copymode(target, tmp_path)
+            except OSError:
+                pass
+
+            os.replace(tmp_path, target)
+        except BaseException:
+            try:
+                os.unlink(tmp_path)
+            except OSError:
+                pass
+            raise
+
+        # Persist the rename itself (not supported on all platforms)
+        try:
+            dir_fd = os.open(directory, os.O_RDONLY)
+        except OSError:
+            dir_fd = None
+        if dir_fd is not None:
+            try:
+                os.fsync(dir_fd)
+            except OSError:
+                pass
+            finally:
+                os.close(dir_fd)
+
+        # The old handle points at the replaced inode: reopen on the new file
+        self._handle.close()
+        self._handle = open(target, mode=self._mode, encoding=self._encoding)
+
 
