@@ -558,6 +558,46 @@ def _emit(key, value, content_handler,
             content_handler.ignorableWhitespace(newl)
 
 
+def drop_keys(doc, names):
+    """Return a copy of ``doc`` with every key in ``names`` removed at any depth.
+
+    Attribute keys are matched literally, so pass ``'@id'`` (with the prefix)
+    to drop an attribute. The input is never mutated. The walk is iterative,
+    so very deeply nested documents do not hit the recursion limit.
+    """
+    if isinstance(names, str):
+        names = (names,)
+    names = frozenset(names)
+
+    def shell(node):
+        if isinstance(node, dict):
+            return type(node)()
+        if isinstance(node, list):
+            return []
+        return None
+
+    root = shell(doc)
+    if root is None:
+        return doc
+    stack = [(doc, root)]
+    while stack:
+        src, dst = stack.pop()
+        items = src.items() if isinstance(src, dict) else enumerate(src)
+        for key, value in items:
+            if isinstance(src, dict) and key in names:
+                continue
+            child = shell(value)
+            if child is None:
+                child, value = value, None
+            else:
+                stack.append((value, child))
+            if isinstance(dst, dict):
+                dst[key] = child
+            else:
+                dst.append(child)
+    return root
+
+
 class _XMLGenerator(XMLGenerator):
     def comment(self, text):
         text = _validate_comment(text)
