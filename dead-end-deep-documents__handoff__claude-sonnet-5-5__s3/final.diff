@@ -720,3 +720,40 @@ def test_force_list_true_applies_to_all_keys():
     xml = "<a><b>1</b><b>2</b><c>x</c></a>"
     expected = {"a": [{"b": ["1", "2"], "c": ["x"]}]}
     assert parse(xml, force_list=True) == expected
+
+
+def test_drop_keys_any_depth_and_attributes():
+    from xmltodict import drop_keys
+    doc = parse('<a id="1"><b id="2" k="v"><c>x</c></b><b id="3"><c>y</c></b></a>')
+    assert drop_keys(doc, ['@id', 'c']) == {'a': {'b': [{'@k': 'v'}, {}]}}
+
+
+def test_drop_keys_does_not_mutate_input():
+    import copy
+    from xmltodict import drop_keys
+    doc = parse('<a id="1"><b id="2">t</b><b id="3"/></a>')
+    snapshot = copy.deepcopy(doc)
+    out = drop_keys(doc, {'@id'})
+    assert doc == snapshot
+    assert out is not doc
+    assert out['a']['b'] is not doc['a']['b']
+
+
+def test_drop_keys_noop_and_string_name():
+    from xmltodict import drop_keys
+    doc = parse('<a><b>1</b></a>')
+    assert drop_keys(doc, []) == doc
+    assert drop_keys(doc, 'b') == {'a': {}}
+    assert drop_keys('text', ['x']) == 'text'
+
+
+def test_drop_keys_deeply_nested():
+    from xmltodict import drop_keys
+    depth = 3000
+    xml = ''.join('<part id="%d">' % i for i in range(depth)) + ''.join('</part>' for _ in range(depth))
+    out = drop_keys(parse(xml), ['@id'])
+    node, n = out, 0
+    while node:
+        node = node['part']
+        n += 1
+    assert n == depth
