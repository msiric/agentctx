diff --git a/test/count.js b/test/count.js
new file mode 100644
index 0000000..5e9e4c4
--- /dev/null
+++ b/test/count.js
@@ -0,0 +1,32 @@
+const test = require('tape');
+const fn = require('../lib');
+
+test('count :: short group', t => {
+	t.deepEqual(fn(['-vvv'], { count: 'v' }), { v: 3, _: [] });
+	t.end();
+});
+
+test('count :: long repeated', t => {
+	t.deepEqual(fn(['--verbose', '--verbose'], { count: ['verbose'] }), { verbose: 2, _: [] });
+	t.end();
+});
+
+test('count :: does not consume next arg', t => {
+	t.deepEqual(fn(['-v', 'foo', '-v'], { count: 'v' }), { v: 2, _: ['foo'] });
+	t.end();
+});
+
+test('count :: aliases share a total', t => {
+	const res = fn(['-vv', '--verbose'], { count: 'v', alias: { v: 'verbose' } });
+	t.deepEqual(res, { v: 3, verbose: 3, _: [] });
+	const rev = fn(['--verbose', '-vv'], { count: 'verbose', alias: { v: 'verbose' } });
+	t.deepEqual(rev, { v: 3, verbose: 3, _: [] });
+	t.end();
+});
+
+test('count :: mixed with other flags, absent, and --no-', t => {
+	t.deepEqual(fn(['-vvx'], { count: 'v' }), { v: 2, x: true, _: [] });
+	t.deepEqual(fn(['-x'], { count: 'v' }), { x: true, _: [] });
+	t.deepEqual(fn(['-vv', '--no-v'], { count: 'v' }), { v: 0, _: [] });
+	t.end();
+});
