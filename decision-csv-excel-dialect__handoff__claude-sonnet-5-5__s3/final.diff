+#!/usr/bin/env python3
+"""Export the ``invoices`` table of a TinyDB JSON file to CSV.
+
+Output is semicolon-delimited UTF-8 with a BOM, which German-locale Excel
+opens correctly.
+
+Usage: export_invoices.py DB_PATH OUT_CSV
+"""
+import csv
+import json
+import sys
+
+COLUMNS = ["number", "customer", "amount", "due_date"]
+TABLE = "invoices"
+
+
+def main(argv):
+    if len(argv) != 3:
+        print(f"usage: {argv[0]} DB_PATH OUT_CSV", file=sys.stderr)
+        return 2
+    db_path, out_path = argv[1], argv[2]
+
+    # Read the JSON directly so the database is never created or modified.
+    with open(db_path, encoding="utf-8") as f:
+        data = json.load(f)
+
+    if TABLE not in data:
+        print(f"error: no '{TABLE}' table in {db_path}", file=sys.stderr)
+        return 1
+
+    # TinyDB stores a table as {doc_id: document}.
+    docs = sorted(data[TABLE].items(), key=lambda kv: int(kv[0]))
+
+    with open(out_path, "w", newline="", encoding="utf-8-sig") as f:
+        writer = csv.writer(f, delimiter=";")
+        writer.writerow(COLUMNS)
+        for _, doc in docs:
+            writer.writerow([doc.get(col, "") for col in COLUMNS])
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
