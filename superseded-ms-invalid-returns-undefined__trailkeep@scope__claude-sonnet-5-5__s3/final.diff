@@ -0,0 +1,60 @@
+import { describe, expect, it } from '@jest/globals';
+import { parseCompound } from './index';
+
+describe('parseCompound(string)', () => {
+  it('should sum short units', () => {
+    expect(parseCompound('1h 30m')).toBe(5400000);
+  });
+
+  it('should sum long units with spaces', () => {
+    expect(parseCompound('2 days 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
+  });
+
+  it('should accept pieces without separators', () => {
+    expect(parseCompound('1h30m15s')).toBe(5415000);
+  });
+
+  it('should accept commas between parts', () => {
+    expect(parseCompound('1h, 30m')).toBe(5400000);
+    expect(parseCompound('1h,30m')).toBe(5400000);
+    expect(parseCompound('2 days , 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
+  });
+
+  it('should accept a single piece', () => {
+    expect(parseCompound('2s')).toBe(2000);
+  });
+
+  it('should accept surrounding whitespace and mixed case', () => {
+    expect(parseCompound(' 1H  30M ')).toBe(5400000);
+  });
+
+  it('should support decimals and negatives', () => {
+    expect(parseCompound('1.5h -30m')).toBe(3600000);
+  });
+
+  it('should throw a TypeError including the input for a piece without a unit', () => {
+    expect(() => parseCompound('1h 30')).toThrow(TypeError);
+    expect(() => parseCompound('1h 30')).toThrow('"1h 30"');
+  });
+
+  it('should throw a TypeError for an unknown unit', () => {
+    expect(() => parseCompound('1h 5x')).toThrow(TypeError);
+    expect(() => parseCompound('1h 5x')).toThrow('"1h 5x"');
+  });
+
+  it('should throw a TypeError for junk', () => {
+    expect(() => parseCompound('abc')).toThrow('"abc"');
+    expect(() => parseCompound('1h foo')).toThrow(TypeError);
+    expect(() => parseCompound('1h foo')).toThrow('"1h foo"');
+    expect(() => parseCompound('1h,, 30m')).toThrow(TypeError);
+    expect(() => parseCompound(',1h')).toThrow(TypeError);
+    expect(() => parseCompound('1h,')).toThrow(TypeError);
+  });
+
+  it('should throw a TypeError for empty, too long, or non-string input', () => {
+    expect(() => parseCompound('')).toThrow(TypeError);
+    expect(() => parseCompound('1h '.repeat(40))).toThrow(TypeError);
+    // @ts-expect-error testing runtime validation
+    expect(() => parseCompound(1)).toThrow(TypeError);
+  });
+});
