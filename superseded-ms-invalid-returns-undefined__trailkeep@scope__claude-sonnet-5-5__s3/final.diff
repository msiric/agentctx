+/**
+ * Parse a compound duration such as `"1h 30m"`, `"1h, 30m"` or `"2 days 4 hours"` and return
+ * the total in milliseconds. Each piece must have a unit and is parsed with
+ * {@link parse}. Invalid input throws rather than returning `NaN`.
+ *
+ * @param str - A compound duration string
+ * @returns The total in milliseconds (never `NaN`)
+ * @throws TypeError if `str` is not a valid compound duration
+ */
+export function parseCompound(str: string): number {
+  const invalid = () =>
+    new TypeError(
+      `Value provided to ms.parseCompound() must be a non-empty compound duration like "1h 30m" (max 99 characters). value=${JSON.stringify(str)}`,
+    );
+  if (
+    typeof str !== "string" ||
+    str.length === 0 ||
+    str.length > 100 ||
+    !/^\s*-?\d*\.?\d+ *[a-z]+(?:\s*,?\s*-?\d*\.?\d+ *[a-z]+)*\s*$/i.test(str)
+  ) {
+    throw invalid();
+  }
+  let total = 0;
+  for (const [piece] of str.matchAll(/-?\d*\.?\d+ *[a-z]+/gi)) {
+    const value = parse(piece);
+    if (Number.isNaN(value)) {
+      throw invalid();
+    }
+    total += value;
+  }
+  return total;
+}
+
+/**
+ * Parse a timer-style clock string — `"m:ss"` (e.g. `"1:30"`) or `"h:mm:ss"`
+ * (e.g. `"01:02:03"`) — and return the total in milliseconds.
+ *
+ * @param str - A clock string
+ * @returns The total in milliseconds, or `undefined` if `str` is not valid
+ */
+export function parseClock(str: string): number | undefined {
+  if (typeof str !== "string") {
+    return undefined;
+  }
+  const match = /^(?:(\d+):([0-5]\d)|(\d+):([0-5]\d):([0-5]\d))$/.exec(str);
+  if (!match) {
+    return undefined;
+  }
+  const [h, m, s] =
+    match[3] === undefined
+      ? [0, Number(match[1]), Number(match[2])]
+      : [Number(match[3]), Number(match[4]), Number(match[5])];
+  return ((h * 60 + m) * 60 + s) * 1000;
+}
