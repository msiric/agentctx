+def test_yaml(tmpdir):
+    path = str(tmpdir.join('test.yaml'))
+    storage = YAMLStorage(path)
+    assert storage.read() is None
+
+    storage.write(doc)
+    assert doc == storage.read()
+    storage.close()
+
+
+def test_yaml_shrinking_file(tmpdir):
+    path = str(tmpdir.join('test.yaml'))
+    storage = YAMLStorage(path)
+    storage.write({'a': 'x' * 1000})
+    storage.write({'a': 1})
+    assert storage.read() == {'a': 1}
+    storage.close()
+
+
+def test_yaml_kwargs(tmpdir):
+    db_file = tmpdir.join('test.yaml')
+    db = TinyDB(str(db_file), storage=YAMLStorage, indent=4)
+    db.insert({'b': 1})
+    db.close()
+
+    assert db_file.read() == "_default:\n    '1':\n        b: 1\n"
+
+
+def test_yaml_tinydb_roundtrip(tmpdir):
+    path = str(tmpdir.join('test.yaml'))
+
+    with TinyDB(path, storage=YAMLStorage) as db:
+        db.insert({'int': 1, 'char': 'a'})
+        db.table('other').insert({'x': [1, 2]})
+
+    with TinyDB(path, storage=YAMLStorage) as db:
+        assert db.get(where('char') == 'a')['int'] == 1
+        assert db.table('other').all() == [{'x': [1, 2]}]
+        assert db.tables() == {'_default', 'other'}
+
+
+def test_yaml_readonly(tmpdir):
+    path = str(tmpdir.join('test.yaml'))
+    with open(path, 'w') as f:
+        f.write('_default: {}\n')
+
+    storage = YAMLStorage(path, access_mode='r')
+    assert storage.read() == {'_default': {}}
+    with pytest.raises(IOError):
+        storage.write({})
+    storage.close()
