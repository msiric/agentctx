 ```
 
+##### significantDigits
+
+Type: `number`\
+Default: `3`
+
+The number of significant digits to round to. Only applies when neither `minimumFractionDigits` nor `maximumFractionDigits` is set.
+
+The integer part is never rounded away, so `123456` bytes is `123 kB` even with `significantDigits: 2`.
+
+Must be an integer between 1 and 100. Throws a `TypeError` for invalid values.
+
+```js
+import prettyBytes from 'pretty-bytes';
+
+prettyBytes(1337, {significantDigits: 2});
+//=> '1.3 kB'
+
+prettyBytes(1337, {significantDigits: 4});
+//=> '1.337 kB'
+```
+
 ##### space
 
 Type: `boolean`\
diff --git a/test.js b/test.js
index 32a0f06..fd80b60 100644
--- a/test.js
+++ b/test.js
@@ -1185,3 +1185,25 @@ test('the options shape the output as documented', t => {
 		t.is(prettyBytes(value, {signed: true}), prefix + prettyBytes(Math.abs(value)));
 	}
 });
+
+test('significantDigits changes the default rounding', t => {
+	t.is(prettyBytes(1337, {significantDigits: 1}), '1 kB');
+	t.is(prettyBytes(1337, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 3}), prettyBytes(1337));
+	t.is(prettyBytes(1337, {significantDigits: 4}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4, locale: 'de'}), '1,337 kB');
+	t.is(prettyBytes(123_456, {significantDigits: 2}), '123 kB');
+	t.is(prettyBytes(999_999, {significantDigits: 2}), '1 MB');
+	t.is(prettyBytes(1337, {significantDigits: 2, bits: true}), '1.3 kbit');
+});
+
+test('significantDigits is ignored when fraction digits are set', t => {
+	t.is(prettyBytes(1337, {significantDigits: 2, maximumFractionDigits: 3}), '1.337 kB');
+	t.is(prettyBytes(1900, {significantDigits: 5, minimumFractionDigits: 1}), '1.9 kB');
+});
+
+test('significantDigits is validated', t => {
+	for (const value of [0, 101, 1.5, -1, '3', Number.NaN, null]) {
+		t.throws(() => prettyBytes(1337, {significantDigits: value}), {instanceOf: TypeError});
+	}
+});
