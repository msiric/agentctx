+def _sort_keys_recursive(obj: Any) -> Any:
+    """
+    Return a copy of ``obj`` with all dict keys ordered by their string form.
+
+    ``json.dumps(sort_keys=True)`` raises ``TypeError`` for dicts that mix key
+    types (e.g. ``int`` and ``str``). JSON object keys end up as strings
+    anyway, so ordering by ``str(key)`` is stable and gives the same result
+    for homogeneous keys of ``str`` type.
+    """
+    if isinstance(obj, dict):
+        return {k: _sort_keys_recursive(obj[k]) for k in sorted(obj, key=str)}
+    if isinstance(obj, (list, tuple)):
+        return [_sort_keys_recursive(v) for v in obj]
+    return obj
+
