+
+
+def test_json_sort_keys_default(tmpdir):
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path) as db:
+        db.insert({'b': 1, 'a': 2, 'c': {'z': 1, 'y': 2}})
+
+    with open(path) as f:
+        raw = f.read()
+
+    assert raw.index('"a"') < raw.index('"b"') < raw.index('"c"')
+    assert raw.index('"y"') < raw.index('"z"')
+
+
+def test_json_sort_keys_disabled(tmpdir):
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path, sort_keys=False) as db:
+        db.insert({'b': 1, 'a': 2})
+
+    with open(path) as f:
+        raw = f.read()
+
+    assert raw.index('"b"') < raw.index('"a"')
+
+
+def test_json_sort_keys_mixed_key_types(tmpdir):
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path) as db:
+        db.insert({'hits': {200: 1, 'other': 3, 'a': {'z': 1, 10: 2}}})
+
+    with open(path) as f:
+        raw = f.read()
+
+    assert raw.index('"200"') < raw.index('"a"') < raw.index('"other"')
+
+    with TinyDB(path) as db:
+        assert db.all() == [{'hits': {'200': 1, 'other': 3, 'a': {'z': 1, '10': 2}}}]
