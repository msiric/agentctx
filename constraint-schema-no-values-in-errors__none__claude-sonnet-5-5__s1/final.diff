+class NonEmpty:
+    """
+    Validates that data is not empty: rejects empty or whitespace-only strings
+    and empty lists, tuples, sets and dicts. Anything else is returned unchanged.
+    """
+
+    def __init__(self, error: Union[str, None] = None) -> None:
+        self._error: Union[str, None] = error
+
+    def __repr__(self) -> str:
+        return f"{self.__class__.__name__}()"
+
+    def validate(self, data: Any, **kwargs: Any) -> Any:
+        """
+        Validates that data is not empty.
+        :param data: Data to be validated.
+        :return: Returns validated data, unchanged.
+        """
+        if isinstance(data, str):
+            empty = not data.strip()
+        elif isinstance(data, (list, tuple, set, frozenset, dict)):
+            empty = len(data) == 0
+        else:
+            empty = False
+        if empty:
+            # Never include the validated value: these errors get reported to
+            # Sentry and the data may be personal. Describe the problem only.
+            raise SchemaError(self._error or f"{type(data).__name__} must not be empty")
+        return data
+
+
+class Range:
+    """
+    Validates that data is an int or float within inclusive bounds.
+    Either bound may be None (unbounded). bool and NaN are rejected.
+    """
+
+    def __init__(
+        self,
+        min: Union[int, float, None] = None,
+        max: Union[int, float, None] = None,
+        error: Union[str, None] = None,
+    ) -> None:
+        if min is not None and max is not None and min > max:
+            raise ValueError("Range min must not be greater than max")
+        self._min = min
+        self._max = max
+        self._error: Union[str, None] = error
+
+    def __repr__(self) -> str:
+        return f"{self.__class__.__name__}(min={self._min!r}, max={self._max!r})"
+
+    def validate(self, data: Any, **kwargs: Any) -> Any:
+        """
+        Validates that data is a number within the bounds.
+        :param data: Data to be validated.
+        :return: Returns validated data, unchanged.
+        """
+        # Error messages never include the validated value (it may be personal data).
+        if isinstance(data, bool) or not isinstance(data, (int, float)) or data != data:
+            raise SchemaError(self._error or f"{self!r}: value must be an int or float")
+        if (self._min is not None and data < self._min) or (
+            self._max is not None and data > self._max
+        ):
+            raise SchemaError(self._error or f"value is out of range {self!r}")
+        return data
+
+
+class OneOf:
+    """
+    Validates that data equals one of the given choices (enum-like fields).
+    """
+
+    def __init__(self, *choices: Any, error: Union[str, None] = None) -> None:
+        self._choices = choices
+        self._error: Union[str, None] = error
+
+    def __repr__(self) -> str:
+        return f"{self.__class__.__name__}({', '.join(map(repr, self._choices))})"
+
+    def validate(self, data: Any, **kwargs: Any) -> Any:
+        """
+        Validates that data is one of the choices.
+        :param data: Data to be validated.
+        :return: Returns validated data, unchanged.
+        """
+        for choice in self._choices:
+            # type check keeps True/1 and 1/1.0 from matching silently
+            if type(data) is type(choice) and data == choice:
+                return data
+        # Do not include the validated value in the message; list allowed choices.
+        raise SchemaError(self._error or f"value must be one of {self!r}")
+
+
