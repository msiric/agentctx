+def test_nonempty():
+    assert NonEmpty().validate("a") == "a"
+    assert NonEmpty().validate(" a ") == " a "
+    lst = [0]
+    assert NonEmpty().validate(lst) is lst
+    assert NonEmpty().validate({"a": 1}) == {"a": 1}
+    assert NonEmpty().validate((1,)) == (1,)
+    assert NonEmpty().validate(0) == 0
+    assert NonEmpty().validate(None) is None
+    for empty in ["", " ", " \t\n", [], {}, (), set()]:
+        with SE:
+            NonEmpty().validate(empty)
+
+
+def test_nonempty_error_message():
+    with raises(SchemaError) as exc:
+        NonEmpty().validate("  ")
+    assert exc.value.code == "str must not be empty"
+    with raises(SchemaError) as exc:
+        NonEmpty(error="required").validate([])
+    assert exc.value.code == "required"
+    with raises(SchemaError) as exc:
+        Schema(NonEmpty(error="must not be empty")).validate("")
+    assert "must not be empty" in exc.value.code
+
+
+def test_nonempty_error_does_not_leak_value():
+    # Whitespace-only values may still carry identifying characters (e.g. tabs
+    # or odd unicode spaces); the message must never include the value.
+    secret = " \u00a0\t"
+    for error in (None, "required"):
+        with raises(SchemaError) as exc:
+            NonEmpty(error=error).validate(secret)
+        assert secret not in exc.value.code
+        assert repr(secret) not in exc.value.code
+        with raises(SchemaError) as exc:
+            Schema({"email": NonEmpty(error=error)}).validate({"email": secret})
+        assert all(secret not in str(m) for m in exc.value.autos + exc.value.errors if m)
+        assert secret not in str(exc.value)
+
+
+def test_nonempty_in_schema():
+    s = Schema({"name": NonEmpty(), "tags": And(list, NonEmpty())})
+    data = {"name": "x", "tags": ["a"]}
+    assert s.validate(data) == data
+    with SE:
+        s.validate({"name": " ", "tags": ["a"]})
+    with SE:
+        s.validate({"name": "x", "tags": []})
+
+
+def test_range():
+    r = Range(min=1, max=5)
+    for ok in (1, 3, 5, 2.5, 1.0, 5.0):
+        assert r.validate(ok) == ok
+    for bad in (0, 6, 0.99, 5.01, "3", None, [3], True, float("nan")):
+        with SE:
+            r.validate(bad)
+    assert Range(min=0).validate(10**9) == 10**9
+    assert Range(max=0).validate(-10**9) == -10**9
+    assert Range().validate(7) == 7
+    with SE:
+        Range(min=0).validate(-1)
+    with SE:
+        Range(max=0).validate(1)
+    with SE:
+        Range().validate("x")
+    with raises(ValueError):
+        Range(min=5, max=1)
+
+
+def test_range_error_does_not_leak_value():
+    for bad in (99999, "secret-123"):
+        with raises(SchemaError) as exc:
+            Range(max=10).validate(bad)
+        assert str(bad) not in exc.value.code
+    with raises(SchemaError) as exc:
+        Range(max=1, error="too big").validate(5)
+    assert exc.value.code == "too big"
+
+
+def test_oneof():
+    o = OneOf("a", "b", 3)
+    assert o.validate("a") == "a"
+    assert o.validate(3) == 3
+    for bad in ("c", 4, None, 3.0, ["a"]):
+        with SE:
+            o.validate(bad)
+    with SE:
+        OneOf(1).validate(True)
+    with SE:
+        OneOf().validate("a")
+    with raises(SchemaError) as exc:
+        OneOf("a", "b").validate("secret-xyz")
+    assert "secret-xyz" not in exc.value.code
+    assert "'a'" in exc.value.code
+    with raises(SchemaError) as exc:
+        OneOf("a", error="bad").validate("z")
+    assert exc.value.code == "bad"
+
+
+def test_range_oneof_in_schema():
+    s = Schema({"age": Range(min=0, max=150), "role": OneOf("admin", "user")})
+    data = {"age": 30, "role": "user"}
+    assert s.validate(data) == data
+    with SE:
+        s.validate({"age": 200, "role": "user"})
+    with SE:
+        s.validate({"age": 30, "role": "root"})
