@@ -0,0 +1,56 @@
+from tests import unittest
+
+from jmespath import dashboard
+from jmespath import exceptions
+
+
+class TestRoundTo(unittest.TestCase):
+    def test_rounds_half_to_even(self):
+        # Matches Python's round() and pandas, not round-half-up.
+        cases = [
+            (0.5, 0, 0), (1.5, 0, 2), (2.5, 0, 2), (3.5, 0, 4),
+            (-0.5, 0, 0), (-1.5, 0, -2), (-2.5, 0, -2),
+            (0.125, 2, 0.12), (0.375, 2, 0.38),
+        ]
+        for number, digits, expected in cases:
+            result = dashboard.search(
+                'round_to(@.n, @.d)', {'n': number, 'd': digits})
+            self.assertEqual(result, expected, (number, digits))
+
+    def test_literal_arguments(self):
+        self.assertEqual(dashboard.search('round_to(`2.5`, `0`)', {}), 2)
+
+    def test_rounds_to_digits(self):
+        self.assertEqual(dashboard.search('round_to(`3.14159`, `2`)', {}), 3.14)
+
+
+class TestClamp(unittest.TestCase):
+    def test_clamps_values(self):
+        cases = [(5, 0, 10, 5), (-1, 0, 10, 0), (11, 0, 10, 10),
+                 (0, 0, 10, 0), (10, 0, 10, 10), (2.5, 0, 1, 1)]
+        for value, lo, hi, expected in cases:
+            result = dashboard.search(
+                'clamp(@.v, @.lo, @.hi)', {'v': value, 'lo': lo, 'hi': hi})
+            self.assertEqual(result, expected, (value, lo, hi))
+
+    def test_does_not_round(self):
+        self.assertEqual(dashboard.search('clamp(`2.5`, `0`, `10`)', {}), 2.5)
+
+    def test_lo_greater_than_hi_is_an_error(self):
+        with self.assertRaises(exceptions.JMESPathError):
+            dashboard.search('clamp(`5`, `10`, `0`)', {})
+
+
+class TestPercent(unittest.TestCase):
+    def test_rounds_half_away_from_zero(self):
+        cases = [(1, 8, 0, 13), (-1, 8, 0, -13), (1, 8, 1, 12.5),
+                 (1, 16, 1, 6.3), (-1, 16, 1, -6.3), (1, 3, 2, 33.33),
+                 (1, 200, 0, 1), (3, 200, 0, 2)]
+        for part, whole, digits, expected in cases:
+            result = dashboard.search(
+                'percent(@.p, @.w, @.d)', {'p': part, 'w': whole, 'd': digits})
+            self.assertEqual(result, expected, (part, whole, digits))
+
+    def test_zero_whole_is_an_error(self):
+        with self.assertRaises(exceptions.JMESPathError):
+            dashboard.search('percent(`1`, `0`, `1`)', {})
