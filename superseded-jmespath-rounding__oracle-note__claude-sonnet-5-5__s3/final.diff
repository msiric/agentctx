+"""Custom JMESPath functions for the dashboards."""
+from decimal import Decimal, ROUND_HALF_UP
+
+from jmespath import parser
+from jmespath import functions
+from jmespath import exceptions
+from jmespath.visitor import Options
+
+
+class DashboardFunctions(functions.Functions):
+    @functions.signature({'types': ['number']}, {'types': ['number']})
+    def _func_round_to(self, number, digits):
+        return round(number, int(digits))
+
+    @functions.signature({'types': ['number']}, {'types': ['number']},
+                         {'types': ['number']})
+    def _func_clamp(self, value, lo, hi):
+        if lo > hi:
+            raise exceptions.JMESPathError(
+                'clamp() requires lo <= hi, got lo=%r, hi=%r' % (lo, hi))
+        return max(lo, min(value, hi))
+
+    @functions.signature({'types': ['number']}, {'types': ['number']},
+                         {'types': ['number']})
+    def _func_percent(self, part, whole, digits):
+        if whole == 0:
+            raise exceptions.JMESPathError('percent() whole must not be 0')
+        return _round_half_away(part / float(whole) * 100, int(digits))
+
+
+def _round_half_away(number, digits):
+    """Round like Excel's ROUND: halves go away from zero.
+
+    Works on the shortest decimal repr so 2.675 -> 2.68, as in Excel.
+    """
+    quantum = Decimal(1).scaleb(-digits)
+    result = Decimal(repr(number)).quantize(quantum, rounding=ROUND_HALF_UP)
+    return float(result) if digits > 0 else int(result)
+
+
+def search(expression, data, options=None):
+    """Like ``jmespath.search`` but with ``DashboardFunctions`` available."""
+    if options is None:
+        options = Options(custom_functions=DashboardFunctions())
+    elif options.custom_functions is None:
+        options.custom_functions = DashboardFunctions()
+    return parser.Parser().parse(expression).search(data, options=options)
