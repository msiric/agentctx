+    def test_heartbeat(self):
+        import json
+        import tempfile
+
+        def ms(*args):
+            return int(datetime.datetime(*args).timestamp() * 1000)
+
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "hb.json")
