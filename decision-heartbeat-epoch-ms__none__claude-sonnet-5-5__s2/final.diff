+            assert status[1]["unit"] == "days"
+            assert status[1]["next_run"] == ms(2024, 1, 2, 10, 30)
+            job.run()
+            assert s.status()[0]["last_run"] == ms(2024, 1, 1, 12, 0)
+        assert all(type(e["next_run"]) is int for e in s.status())
