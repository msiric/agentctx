            every().minute.do(good)
        with mock_datetime(2024, 1, 1, 10, 5, 0):
            with self.assertRaises(ValueError):
                schedule.run_pending()
        assert bad.call_count == 1
        assert good.call_count == 1

    def test_run_all_with_decorator(self):""",1)
