    def test_run_all_continues_after_failure(self):
        good = make_mock_job()
        bad = mock.Mock(side_effect=ValueError("first"))
        bad.__name__ = "bad"
        every().minute.do(bad)
        every().hour.do(good)
        with self.assertRaises(ValueError):
            schedule.run_all()
        assert good.call_count == 1

