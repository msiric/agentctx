+    def _run_job_safely(
+        self, job: "Job", first_error: Optional[Exception]
+    ) -> Optional[Exception]:
+        # Keep running the remaining jobs if this one raises; the caller
+        # re-raises the first captured exception once the loop is done.
+        # KeyboardInterrupt/SystemExit are not Exceptions and still propagate.
