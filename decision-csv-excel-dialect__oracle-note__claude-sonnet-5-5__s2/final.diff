     db.close()
+
+
+def test_to_csv_default_fields(db, tmp_path):
+    db.truncate()
+    db.insert({'a': 1, 'b': 'x'})
+    db.insert({'c': 'Müller', 'a': 2})
+
+    path = tmp_path / 'out.csv'
+    db.to_csv(path)
+
+    raw = path.read_bytes()
+    assert raw.startswith(b'\xef\xbb\xbf')
+    text = raw.decode('utf-8-sig')
+    assert text.splitlines() == ['a;b;c', '1;x;', '2;;Müller']
+
+
+def test_to_csv_fields_select_and_order(db, tmp_path):
+    db.truncate()
+    db.insert({'a': 1, 'b': 'x'})
+    db.insert({'a': 2})
+
+    path = tmp_path / 'out.csv'
+    db.to_csv(path, fields=['b', 'a', 'missing'])
+
+    lines = path.read_text(encoding='utf-8-sig').splitlines()
+    assert lines == ['b;a;missing', 'x;1;', ';2;']
+
+
+def test_to_csv_quotes_delimiters(db, tmp_path):
+    import csv
+    db.truncate()
+    db.insert({'a': 'x;y', 'b': 'line\nbreak'})
+
+    path = tmp_path / 'out.csv'
+    db.to_csv(path)
+
+    with open(path, newline='', encoding='utf-8-sig') as f:
+        rows = list(csv.reader(f, delimiter=';'))
+    assert rows == [['a', 'b'], ['x;y', 'line\nbreak']]
+
+
+def test_to_csv_empty_table(db, tmp_path):
+    db.truncate()
+    path = tmp_path / 'out.csv'
+    db.to_csv(path)
+    assert path.read_bytes() == b'\xef\xbb\xbf\r\n'
