+"""Export the ``invoices`` table of a TinyDB JSON file to CSV (semicolon-separated, UTF-8 with BOM, for German-locale Excel).
+
+Usage: python scripts/export_invoices.py DB_PATH OUT_CSV
+"""
+import csv
+import json
+import sys
+
+COLUMNS = ['number', 'customer', 'amount', 'due_date']
+
+
+def export_invoices(db_path, out_path):
+    with open(db_path, encoding='utf-8') as f:
+        data = json.load(f)
+
+    # TinyDB stores each table as {doc_id: document}
+    invoices = data.get('invoices')
+    if invoices is None:
+        raise SystemExit(f'No "invoices" table in {db_path}')
+
+    with open(out_path, 'w', newline='', encoding='utf-8-sig') as f:
+        writer = csv.DictWriter(f, fieldnames=COLUMNS, extrasaction='ignore', delimiter=';')
+        writer.writeheader()
+        for doc_id in sorted(invoices, key=int):
+            writer.writerow(invoices[doc_id])
+    return len(invoices)
+
+
+def main(argv):
+    if len(argv) != 3:
+        print(__doc__, file=sys.stderr)
+        return 2
+    count = export_invoices(argv[1], argv[2])
+    print(f'Wrote {count} invoices to {argv[2]}')
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main(sys.argv))
