     db.close()
+
+
+def _read_csv(path):
+    import csv
+    raw = path.read_bytes()
+    assert raw.startswith(b'\xef\xbb\xbf')
+    with open(path, newline='', encoding='utf-8-sig') as f:
+        return list(csv.reader(f, delimiter=';'))
+
+
+def test_to_csv_default_fields(db, tmp_path):
+    db.insert({'int': 4, 'extra': 'x'})
+    path = tmp_path / 'out.csv'
+
+    db.to_csv(path)
+
+    assert _read_csv(path) == [
+        ['int', 'char', 'extra'],
+        ['1', 'a', ''],
+        ['1', 'b', ''],
+        ['1', 'c', ''],
+        ['4', '', 'x'],
+    ]
+
+
+def test_to_csv_fields_select_and_order(db, tmp_path):
+    path = tmp_path / 'out.csv'
+
+    db.to_csv(path, fields=['char', 'missing', 'int'])
+
+    assert _read_csv(path) == [
+        ['char', 'missing', 'int'],
+        ['a', '', '1'],
+        ['b', '', '1'],
+        ['c', '', '1'],
+    ]
+
+
+def test_to_csv_umlauts_and_delimiters(db, tmp_path):
+    db.truncate()
+    db.insert({'name': 'Müller; Söhne', 'note': 'a "q"\nb'})
+    path = tmp_path / 'out.csv'
+
+    db.to_csv(path)
+
+    assert _read_csv(path) == [
+        ['name', 'note'],
+        ['Müller; Söhne', 'a "q"\nb'],
+    ]
+
+
+def test_to_csv_empty_table(db, tmp_path):
+    db.truncate()
+    path = tmp_path / 'out.csv'
+
+    db.to_csv(path, fields=['a', 'b'])
+    assert _read_csv(path) == [['a', 'b']]
+
+    db.to_csv(path)
+    assert _read_csv(path) == [[]]
