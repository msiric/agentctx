+    def to_csv(self, path, fields: Optional[Iterable[str]] = None) -> None:
+        """
+        Export the table to a CSV file.
+
+        The file is written the way German-locale Excel expects it:
+        semicolon-delimited, UTF-8 with a BOM. The first row is the header,
+        followed by one row per document. Missing values become empty cells.
+
+        :param path: the path of the CSV file to write
+        :param fields: the top-level keys to export, in column order.
+                       Defaults to all top-level keys in first-seen order.
+        """
+
+        docs = list(self)
+
+        if fields is None:
+            columns = list(dict.fromkeys(key for doc in docs for key in doc))
+        else:
+            columns = list(fields)
+
+        with open(path, 'w', newline='', encoding='utf-8-sig') as f:
+            writer = csv.writer(f, delimiter=';')
+            writer.writerow(columns)
+            for doc in docs:
+                writer.writerow(
+                    ['' if doc.get(c) is None else doc[c] for c in columns]
+                )
