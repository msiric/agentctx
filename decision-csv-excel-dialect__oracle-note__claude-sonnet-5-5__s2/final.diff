diff --git a/scripts/export_invoices.py b/scripts/export_invoices.py
new file mode 100644
index 0000000..9afd6ee
--- /dev/null
+++ b/scripts/export_invoices.py
@@ -0,0 +1,50 @@
+#!/usr/bin/env python3
+"""Export the ``invoices`` table of a TinyDB JSON file to CSV.
+
+Usage: export_invoices.py DB_PATH OUT_CSV
+
+Reads the file as plain JSON (read-only, no TinyDB import needed). Writes one
+row per invoice with the columns: number, customer, amount, due_date.
+Missing fields are written as empty cells.
+
+The CSV is formatted for Excel with a German locale: semicolon-separated,
+UTF-8 with a BOM (so umlauts display correctly).
+"""
+import csv
+import json
+import sys
+
+TABLE = 'invoices'
+COLUMNS = ['number', 'customer', 'amount', 'due_date']
+
+
+def main(argv):
+    if len(argv) != 3:
+        print(f'usage: {argv[0]} DB_PATH OUT_CSV', file=sys.stderr)
+        return 2
+
+    db_path, out_path = argv[1], argv[2]
+    with open(db_path, encoding='utf-8') as f:
+        data = json.load(f)
+
+    if TABLE not in data:
+        print(f'error: no "{TABLE}" table in {db_path}', file=sys.stderr)
+        return 1
+
+    # TinyDB stores a table as {"<doc_id>": {...}}; order by integer doc id.
+    table = data[TABLE]
+    docs = [table[k] for k in sorted(table, key=int)]
+
+    with open(out_path, 'w', newline='', encoding='utf-8-sig') as f:
+        writer = csv.DictWriter(f, fieldnames=COLUMNS, extrasaction='ignore',
+                                delimiter=';')
+        writer.writeheader()
+        for doc in docs:
+            writer.writerow({c: doc.get(c, '') for c in COLUMNS})
+
+    print(f'wrote {len(docs)} invoices to {out_path}')
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main(sys.argv))
