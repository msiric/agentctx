+"""
+Benchmark TinyDB read performance on a large JSON file.
+
+Usage: python scripts/bench_read.py [--size-mb 40] [--repeat 5]
+"""
+import argparse
+import json
+import os
+import random
+import sys
+import tempfile
+import time
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))
+
+from tinydb import TinyDB, where  # noqa: E402
+from tinydb.table import Document  # noqa: E402
+
+
+def generate(path, size_mb):
+    rnd = random.Random(0)
+    target = size_mb * 1024 * 1024
+    table, size, i = {}, 0, 1
+    while size < target:
+        doc = {
+            'name': f'user{i}', 'age': rnd.randint(0, 99),
+            'email': f'user{i}@example.com',
+            'tags': [rnd.choice('abcdefgh') for _ in range(5)],
+            'address': {'city': f'city{rnd.randint(0, 999)}', 'zip': rnd.randint(10000, 99999)},
+        }
+        table[str(i)] = doc
+        size += len(json.dumps(doc)) + 8
+        i += 1
+    with open(path, 'w') as f:
+        json.dump({'_default': table}, f)
+    return i - 1
+
+
+def timed(fn, repeat):
+    best = float('inf')
+    for _ in range(repeat):
+        t = time.perf_counter()
+        fn()
+        best = min(best, time.perf_counter() - t)
+    return best
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--size-mb', type=int, default=40)
+    ap.add_argument('--repeat', type=int, default=5)
+    a = ap.parse_args()
+
+    with tempfile.TemporaryDirectory() as d:
+        path = os.path.join(d, 'db.json')
+        n = generate(path, a.size_mb)
+        print(f'{n} docs, {os.path.getsize(path) / 1e6:.1f} MB\n')
+
+        db = TinyDB(path)
+        table = db.table('_default')
+        counter = iter(range(10**9))
+
+        def cold_search():
+            # a fresh query each time bypasses the query cache
+            table.search(where('age') == 42 + next(counter) * 0.0001)
+
+        raw = table._read_table()
+        cond = where('age') == 42
+
+        rows = [
+            ('db.all()', timed(db.all, a.repeat)),
+            ('search (cold, uncached query)', timed(cold_search, a.repeat)),
+            ('search (cached, same query)',
+             (table.search(cond), timed(lambda: table.search(cond), a.repeat))[1]),
+            ('  breakdown: storage.read() [json.load]', timed(db.storage.read, a.repeat)),
+            ('  breakdown: Document wrapping only',
+             timed(lambda: [Document(v, int(k)) for k, v in raw.items()], a.repeat)),
+            ('  breakdown: query eval only', timed(lambda: [v for v in raw.values() if cond(v)], a.repeat)),
+        ]
+        for name, t in rows:
+            print(f'{name:45s} {t * 1000:9.1f} ms')
+        db.close()
+
+
+if __name__ == '__main__':
+    main()
