@@ -285,3 +285,28 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def test_json_read_cache_sees_external_writes(tmpdir):
+    import json as _json
+    import os
+    import time
+    path = str(tmpdir.join('db.json'))
+    with open(path, 'w') as f:
+        _json.dump({'_default': {'1': {'a': 1}}}, f)
+    old = time.time() - 100
+    os.utime(path, (old, old))
+
+    storage = JSONStorage(path)
+    first = storage.read()
+    assert storage.read() is first  # unchanged file: no re-parse
+
+    # An external process rewrites the file with identical size
+    with open(path, 'w') as f:
+        _json.dump({'_default': {'1': {'a': 2}}}, f)
+    assert storage.read() == {'_default': {'1': {'a': 2}}}
+
+    # Our own writes are visible too
+    storage.write({'_default': {'1': {'a': 3}}})
+    assert storage.read() == {'_default': {'1': {'a': 3}}}
+    storage.close()
