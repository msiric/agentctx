+"""
+Benchmark read performance of TinyDB on a large JSON file.
+
+Usage: python scripts/bench_read.py [--size-mb 40] [--keep] [--repeat 5]
+
+Generates a database of roughly --size-mb megabytes in a temp dir, then times
+the pieces that make up a read: raw json.load, JSONStorage.read, db.all(), and
+db.search() (uncached and cached), so you can see where the time goes.
+"""
+import argparse
+import json
+import os
+import random
+import statistics
+import string
+import sys
+import tempfile
+import time
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))
+
+from tinydb import TinyDB, where  # noqa: E402
+from tinydb.storages import JSONStorage  # noqa: E402
+
+
+def make_doc(i, rnd):
+    return {
+        'id': i,
+        'name': ''.join(rnd.choices(string.ascii_lowercase, k=12)),
+        'group': rnd.randrange(100),
+        'score': rnd.random(),
+        'tags': [rnd.choice(string.ascii_lowercase) for _ in range(5)],
+        'payload': ''.join(rnd.choices(string.ascii_letters, k=100)),
+    }
+
+
+def generate(path, size_mb):
+    rnd = random.Random(0)
+    data, n, batch = {}, 0, 10_000
+    target = size_mb * 1024 * 1024
+    while True:
+        for _ in range(batch):
+            n += 1
+            data[str(n)] = make_doc(n, rnd)
+        size = len(json.dumps({'_default': data}))
+        if size >= target:
+            break
+    with open(path, 'w') as f:
+        json.dump({'_default': data}, f)
+    return n
+
+
+def timeit(label, fn, repeat):
+    times = []
+    for _ in range(repeat):
+        t = time.perf_counter()
+        fn()
+        times.append(time.perf_counter() - t)
+    print(f'{label:<42} min {min(times)*1000:9.1f} ms   '
+          f'median {statistics.median(times)*1000:9.1f} ms')
+    return min(times)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--size-mb', type=float, default=40)
+    ap.add_argument('--repeat', type=int, default=5)
+    ap.add_argument('--keep', action='store_true', help='keep the generated db')
+    args = ap.parse_args()
+
+    db = None
+    tmp = tempfile.mkdtemp(prefix='tinydb-bench-')
+    path = os.path.join(tmp, 'db.json')
+    try:
+        n = generate(path, args.size_mb)
+        print(f'{n} docs, {os.path.getsize(path)/1e6:.1f} MB, {path}\n')
+
+        db = TinyDB(path)
+        storage = db.storage
+        counter = iter(range(10**9))
+
+        def raw_json_load():
+            with open(path) as f:
+                json.load(f)
+
+        raw = timeit('raw json.load (open+parse)', raw_json_load, args.repeat)
+        rd = timeit('JSONStorage.read()', storage.read, args.repeat)
+        al = timeit('db.all()', db.all, args.repeat)
+        # Each call uses a distinct condition so the query cache never hits.
+        se = timeit('db.search(...) uncached',
+                    lambda: db.search(where('score') > 0.999 - next(counter) * 1e-9),
+                    args.repeat)
+        q = where('group') == 7
+        db.search(q)
+        ca = timeit('db.search(...) cached (same query)',
+                    lambda: db.search(q), args.repeat)
+        timeit('len(db)', lambda: len(db), args.repeat)
+
+        # Pure in-memory costs, with the parse removed
+        data = storage.read()['_default']
+        cond = where('score') > 0.999
+        timeit('  in-memory: wrap docs (no parse)',
+               lambda: [db.document_class(d, int(i)) for i, d in data.items()],
+               args.repeat)
+        timeit('  in-memory: eval query (no parse)',
+               lambda: [d for d in data.values() if cond(d)], args.repeat)
+
+        print(f'\nparse share of db.all():    {rd/al:6.1%}')
+        print(f'parse share of search():    {rd/se:6.1%}')
+        print(f'search cached vs uncached:  {se/ca:,.0f}x faster')
+    finally:
+        if db is not None:
+            db.close()
+        if args.keep:
+            print(f'kept {path}')
+        else:
+            os.remove(path)
+            os.rmdir(tmp)
+
+
+if __name__ == '__main__':
+    main()
