+        # Parsed contents of the file and the file signature they correspond
+        # to. Reads reuse the parsed data as long as the signature is unchanged
+        self._cache: Any = None
+        self._cache_sig: Optional[tuple] = None
+
+    # A file modified less than this many seconds before we looked at it may
+    # be modified again without its signature changing (coarse timestamps), so
+    # we don't trust a cache entry taken in that window.
+    _RACY_WINDOW = 2.0
+
+    def _signature(self) -> tuple:
+        st = os.fstat(self._handle.fileno())
+        return st.st_mtime_ns, st.st_size, st.st_ino, st.st_ctime_ns
+
+    def _remember(self, data: Any) -> None:
+        sig = self._signature()
+        if time.time() - sig[0] / 1e9 > self._RACY_WINDOW:
+            self._cache, self._cache_sig = data, sig
+        else:
+            self._cache, self._cache_sig = None, None
+
     def close(self) -> None:
+        self._cache, self._cache_sig = None, None
         self._handle.close()
 
     def read(self) -> Optional[dict[str, dict[str, Any]]]:
+        # Skip parsing if the file is unchanged since we last read/wrote it
+        if self._cache_sig is not None and self._signature() == self._cache_sig:
+            return self._cache
+
+        self._cache, self._cache_sig = None, None
+
         # Get the file size by moving the cursor to the file end and reading
         # its location
         self._handle.seek(0, os.SEEK_END)
@@ -137,9 +166,15 @@ class JSONStorage(Storage):
