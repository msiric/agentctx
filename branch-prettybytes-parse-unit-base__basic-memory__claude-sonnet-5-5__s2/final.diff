+test('parseBytes parses plain numbers, decimal units, and binary units', t => {
+	t.is(parseBytes('0'), 0);
+	t.is(parseBytes('512'), 512);
+	t.is(parseBytes('512 B'), 512);
+	t.is(parseBytes('512B'), 512);
+	t.is(parseBytes('0.5 B'), 0.5);
+	t.is(parseBytes('.5 KiB'), 512);
+	t.is(parseBytes('1 KiB'), 1024);
+	t.is(parseBytes('1.5 KiB'), 1536);
+	t.is(parseBytes('  2 MiB  '), 2 * (1024 ** 2));
+	t.is(parseBytes('1.5\u00A0KiB'), 1536);
+	t.is(parseBytes('+42 B'), 42);
+	t.is(parseBytes('-1.5 KiB'), -1536);
+	t.is(parseBytes('-0'), 0);
+	t.true(Object.is(parseBytes('-0 B'), 0));
+
+	for (const [exponent, unit] of BINARY_UNITS.entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1024 ** exponent);
+	}
+
+	for (const [exponent, unit] of DECIMAL_UNITS.entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1000 ** exponent);
+	}
+
+	t.is(parseBytes('1 KB'), 1000);
+	t.is(parseBytes('1.5 kB'), 1500);
+	t.is(parseBytes('-2 MB'), -2e6);
+	t.is(parseBytes('3GB'), 3e9);
+});
+
+test('parseBytes reverses prettyBytes for decimal output', t => {
+	for (const value of [0, 1, 512, 999, 1000, 1500, 1e6, 1.25e9, 1e24]) {
+		t.is(parseBytes(prettyBytes(value)), value);
+		t.is(parseBytes(prettyBytes(value, {space: false})), value);
+		t.is(parseBytes(prettyBytes(-value)), value === 0 ? 0 : -value);
+	}
+});
+
+test('parseBytes reverses prettyBytes for binary output', t => {
+	for (const value of [0, 1, 512, 1023, 1024, 1536, 1024 ** 2, 1.25 * (1024 ** 3), 1024 ** 8]) {
+		t.is(parseBytes(prettyBytes(value, {binary: true})), value);
+		t.is(parseBytes(prettyBytes(value, {binary: true, space: false})), value);
+		t.is(parseBytes(prettyBytes(value, {binary: true, nonBreakingSpace: true})), value);
+		t.is(parseBytes(prettyBytes(-value, {binary: true})), value === 0 ? 0 : -value);
+		t.is(parseBytes(prettyBytes(value, {binary: true, signed: true, fixedWidth: 12})), value);
+	}
+});
+
+test('parseBytes is case-sensitive and rejects unsupported units', t => {
+	for (const input of ['1 kib', '1 KIB', '1 kiB', '1 b', '1 kb', '1 Kb', '1 mB', '1 Mb', '1 gb', '1 K', '1 M', '1 bit', '1 KiBs']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError}, `Expected ${JSON.stringify(input)} to throw`);
+	}
+});
+
+test('parseBytes rejects malformed input', t => {
+	for (const input of ['', ' ', 'KiB', 'abc', '1.', '1.2.3', '1,5 KiB', '1,000 B', '1e3', '1e3 B', '--1', '1 2 KiB', '0x10', 'Infinity', 'NaN', '１２']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError}, `Expected ${JSON.stringify(input)} to throw`);
+	}
+
+	for (const input of [1, undefined, null, {}, 10n]) {
+		t.throws(() => parseBytes(input), {instanceOf: TypeError});
+	}
+});
