@@ -216,3 +216,29 @@ export default function prettyBytes(
 	number: number | bigint,
 	options?: Options
 ): string;
+
+/**
+Convert a human readable size string to a number of bytes: `1.5 KiB` → `1536`, `1.5 kB` → `1500`.
+
+Accepts a plain number or a number followed by a decimal unit (`B`, `kB`, `MB`, `GB`, `TB`, `PB`, `EB`, `ZB`, `YB`, powers of 1000; `KB` is accepted as an alias for `kB`) or a binary unit (`B`, `KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`, `ZiB`, `YiB`, powers of 1024), with an optional space (regular or non-breaking) in between and an optional leading `+` or `-`. Fractional values are allowed. Units are case-sensitive, like the output of `prettyBytes`.
+
+Bits, localized numbers, and digit grouping are not supported yet and throw.
+
+@param string - The string to parse.
+@throws A `TypeError` if the input is not a string, and a `SyntaxError` if it is not a number with a supported unit.
+
+@example
+```
+import {parseBytes} from 'pretty-bytes';
+
+parseBytes('512');
+//=> 512
+
+parseBytes('1.5 KiB');
+//=> 1536
+
+parseBytes('1.5 MB');
+//=> 1500000
+```
+*/
+export function parseBytes(string: string): number;
diff --git a/index.js b/index.js
index c5f37ab..703293a 100644
--- a/index.js
+++ b/index.js
@@ -285,3 +285,35 @@ export default function prettyBytes(number, options) {
 	const result = prefix + numberString + separator + UNITS[exponent];
 	return result.padStart(options.fixedWidth ?? 0);
 }
+
+// Decimal units (`kB`, `MB`, …) are powers of 1000 and binary units (`KiB`, `MiB`, …) are powers of 1024, matching what `prettyBytes` outputs. `KB` is accepted as an alias for `kB`. Units are case-sensitive, like the output of `prettyBytes`.
+const PARSE_UNITS = new Map([
+	...BYTE_UNITS.map((unit, exponent) => [unit, 1000 ** exponent]),
+	...BIBYTE_UNITS.map((unit, exponent) => [unit, 1024 ** exponent]),
+	['KB', 1000],
+]);
+
+// A sign, a plain decimal number, and an optional unit that may be separated by whitespace (a regular or non-breaking space, as `prettyBytes` can produce).
+const BYTES_PATTERN = /^(?<sign>[+-])?(?<number>\d+(?:\.\d+)?|\.\d+)(?:\s*(?<unit>[A-Za-z]+))?$/;
+
+export function parseBytes(string) {
+	if (typeof string !== 'string') {
+		throw new TypeError(`Expected a string, got ${typeof string}: ${string}`);
+	}
+
+	const match = BYTES_PATTERN.exec(string.trim());
+
+	if (!match) {
+		throw new SyntaxError(`Unable to parse bytes from: ${JSON.stringify(string)}`);
+	}
+
+	const {sign, number, unit = 'B'} = match.groups;
+	const multiplier = PARSE_UNITS.get(unit);
+
+	if (multiplier === undefined) {
+		throw new SyntaxError(`Unsupported unit ${JSON.stringify(unit)} in: ${JSON.stringify(string)}`);
+	}
+
+	const bytes = Number(number) * multiplier;
+	return sign === '-' && bytes !== 0 ? -bytes : bytes;
+}
