 Parse the value as a boolean type instead of string type if it's a boolean.
 
+##### ignoreEmpty
+
+Type: `boolean`\
+Default: `false`
+
+```js
+import queryString from 'query-string';
+
+queryString.parse('?q=&page=2', {ignoreEmpty: true});
+//=> {page: '2'}
+
+queryString.parse('?flag&q=', {ignoreEmpty: true});
+//=> {flag: null}
+```
+
+Skip the parameters with an empty value, like `?q=`. A key without `=`, like `?flag`, has no value instead of an empty one, so it is kept.
+
+##### stripTracking
+
+Type: `boolean`\
+Default: `true`
+
+```js
+import queryString from 'query-string';
+
+queryString.parse('?q=a&utm_source=x&fbclid=y&gclid=z');
+//=> {q: 'a'}
+
+queryString.parse('?q=a&utm_source=x', {stripTracking: false});
+//=> {q: 'a', utm_source: 'x'}
+```
+
+Drop the tracking parameters: `utm_*`, `fbclid`, and `gclid`. The match is case-insensitive. This also applies to `.parseUrl()`. `.pick()`, `.exclude()`, and `.stringifyUrl()` always keep the tracking parameters in the URL.
+
 ##### types
 
 Type: `object`\
diff --git a/test/parse.js b/test/parse.js
index 00a1abf..5df8423 100644
--- a/test/parse.js
+++ b/test/parse.js
@@ -1492,3 +1492,37 @@ test('rejects an invalid `arrayFormatSeparator`', () => {
 
 	assert.deepEqual(structuredClone(queryString.parse('foo=a·b', {arrayFormat: 'separator', arrayFormatSeparator: '·'})), {foo: ['a', 'b']});
 });
+
+test('ignoreEmpty drops parameters with an empty value', () => {
+	assert.deepEqual(structuredClone(queryString.parse('?q=&page=2', {ignoreEmpty: true})), {page: '2'});
+	assert.deepEqual(structuredClone(queryString.parse('?q=&page=2')), {q: '', page: '2'});
+	assert.deepEqual(structuredClone(queryString.parse('?flag&q=', {ignoreEmpty: true})), {flag: null});
+	assert.deepEqual(structuredClone(queryString.parse('?q=', {ignoreEmpty: true})), {});
+	assert.deepEqual(structuredClone(queryString.parse('?q=%20&r=+', {ignoreEmpty: true})), {q: ' ', r: ' '});
+	assert.deepEqual(structuredClone(queryString.parse('a=1&a=&a=2', {ignoreEmpty: true})), {a: ['1', '2']});
+	assert.deepEqual(structuredClone(queryString.parse('a[]=&a[]=1&b=', {ignoreEmpty: true, arrayFormat: 'bracket'})), {a: ['1']});
+	assert.deepEqual(structuredClone(queryString.parse('a=&b=1', {ignoreEmpty: true, arrayFormat: 'comma'})), {b: '1'});
+});
+
+/* eslint-disable camelcase -- The tracking parameters are snake case. */
+test('stripTracking drops the tracking parameters by default', () => {
+	assert.deepEqual(structuredClone(queryString.parse('?q=a&utm_source=x&utm_medium=y&fbclid=1&gclid=2')), {q: 'a'});
+	assert.deepEqual(structuredClone(queryString.parse('?UTM_Source=x&FBCLID=1&utm%5Fcampaign=z&a=1')), {a: '1'});
+	assert.deepEqual(structuredClone(queryString.parse('?utm_source&a=1')), {a: '1'});
+	assert.deepEqual(structuredClone(queryString.parse('?utm=1&xutm_source=1&fbclid2=1&gclid_=1')), {
+		utm: '1',
+		xutm_source: '1',
+		fbclid2: '1',
+		gclid_: '1',
+	});
+	assert.deepEqual(structuredClone(queryString.parse('?utm_source[]=a&utm_source[]=b&c=1', {arrayFormat: 'bracket'})), {c: '1'});
+	assert.deepEqual(structuredClone(queryString.parse('?q=a&utm_source=x&fbclid=y', {stripTracking: false})), {q: 'a', utm_source: 'x', fbclid: 'y'});
+	assert.deepEqual(structuredClone(queryString.parseUrl('https://foo.bar?a=1&gclid=2').query), {a: '1'});
+});
+
+test('stripTracking does not change pick(), exclude(), or stringifyUrl()', () => {
+	assert.equal(queryString.pick('https://foo.bar?a=1&utm_source=x', ['a']), 'https://foo.bar?a=1');
+	assert.equal(queryString.pick('https://foo.bar?a=1&utm_source=x', () => true), 'https://foo.bar?a=1&utm_source=x');
+	assert.equal(queryString.exclude('https://foo.bar?a=1&utm_source=x&fbclid=2', ['a']), 'https://foo.bar?fbclid=2&utm_source=x');
+});
+/* eslint-enable camelcase */
