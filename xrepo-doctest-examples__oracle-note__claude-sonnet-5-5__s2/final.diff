     """
     stack = engine.FilterStack(strip_semicolon=strip_semicolon)
     return [str(stmt).strip() for stmt in stack.run(sql, encoding)]
+
+
+def statement_types(sql: str) -> list[str]:
+    """Return the type of each statement in *sql*, in order.
+
+    Each entry is what :meth:`~sqlparse.sql.Statement.get_type` returns
+    for the corresponding statement from :func:`parse`.
+
+    >>> statement_types("select 1; insert into t values (1)")
+    ['SELECT', 'INSERT']
+
+    :param sql: A string containing one or more SQL statements.
+    :returns: A list of strings (``'UNKNOWN'`` for unrecognized statements).
+    """
+    return [stmt.get_type() for stmt in parse(sql)]
