diff --git a/test/dashdash.js b/test/dashdash.js
new file mode 100644
index 0000000..0fcdf29
--- /dev/null
+++ b/test/dashdash.js
@@ -0,0 +1,32 @@
+const test = require('tape');
+const fn = require('../lib');
+
+test('-- option: args after -- go to argv["--"]', t => {
+	const argv = fn(['a', '-x', '1', '--', 'b', '--c', '-d', '5'], { '--': true });
+	t.same(argv, { _: ['a'], x: 1, '--': ['b', '--c', '-d', '5'] });
+	t.end();
+});
+
+test('-- option: always present, empty when no --', t => {
+	t.same(fn(['a', '--b'], { '--': true }), { _: ['a'], b: true, '--': [] });
+	t.same(fn([], { '--': true }), { _: [], '--': [] });
+	t.end();
+});
+
+test('-- option: trailing -- and values are not coerced', t => {
+	t.same(fn(['--'], { '--': true }), { _: [], '--': [] });
+	t.same(fn(['--', '123'], { '--': true }), { _: [], '--': ['123'] });
+	t.end();
+});
+
+test('-- option: off by default', t => {
+	t.same(fn(['a', '--', 'b']), { _: ['a', 'b'] });
+	t.same(fn(['a', '--', 'b'], { '--': false }), { _: ['a', 'b'] });
+	t.end();
+});
+
+test('-- option: works with alias/unknown', t => {
+	const argv = fn(['-h', '--', '--nope'], { '--': true, alias: { h: 'help' }, unknown: () => { throw 1; } });
+	t.same(argv, { _: [], h: true, help: true, '--': ['--nope'] });
+	t.end();
+});
