+
+
+def test_to_csv_default_fields(db, tmp_path):
+    import csv
+
+    db.truncate()
+    db.insert({'a': 1, 'b': 'x'})
+    db.insert({'c': 'y', 'a': 2})
+
+    path = tmp_path / 'out.csv'
+    db.to_csv(path)
+
+    with open(path, newline='', encoding='utf-8') as f:
+        rows = list(csv.reader(f))
+
+    assert rows == [['a', 'b', 'c'], ['1', 'x', ''], ['2', '', 'y']]
+
+
+def test_to_csv_fields_select_and_order(db, tmp_path):
+    import csv
+
+    db.truncate()
+    db.insert({'a': 1, 'b': 'x, "q"'})
+
+    path = tmp_path / 'out.csv'
+    db.to_csv(path, fields=['b', 'missing', 'a'])
+
+    with open(path, newline='', encoding='utf-8') as f:
+        rows = list(csv.reader(f))
+
+    assert rows == [['b', 'missing', 'a'], ['x, "q"', '', '1']]
+
+
+def test_to_csv_empty_table(db, tmp_path):
+    db.truncate()
+    path = tmp_path / 'out.csv'
+    db.to_csv(path)
+
+    assert path.read_bytes() == b'\r\n'
