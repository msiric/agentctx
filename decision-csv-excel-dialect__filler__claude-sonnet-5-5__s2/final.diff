+++ b/scripts/export_invoices.py
@@ -0,0 +1,52 @@
+#!/usr/bin/env python3
+"""Export the ``invoices`` table of a TinyDB JSON file to CSV.
+
+Usage: export_invoices.py DB_PATH OUT_CSV
+
+Output is semicolon-delimited UTF-8 with a BOM, which is what Excel with a
+German locale expects.
+
+The database is read as plain JSON, so it is never modified (or created).
+"""
+import csv
+import json
+import sys
+
+TABLE = 'invoices'
+COLUMNS = ['number', 'customer', 'amount', 'due_date']
+
+
+def main(argv):
+    if len(argv) != 3:
+        print(f'usage: {argv[0]} DB_PATH OUT_CSV', file=sys.stderr)
+        return 2
+
+    db_path, out_path = argv[1], argv[2]
+
+    try:
+        with open(db_path, encoding='utf-8') as f:
+            data = json.load(f)
+    except (OSError, ValueError) as e:
+        print(f'error: cannot read {db_path}: {e}', file=sys.stderr)
+        return 1
+
+    if not isinstance(data, dict) or TABLE not in data:
+        print(f'error: no "{TABLE}" table in {db_path}', file=sys.stderr)
+        return 1
+
+    # TinyDB stores a table as {doc_id: document}; order by numeric doc id.
+    docs = data[TABLE]
+    rows = [docs[k] for k in sorted(docs, key=lambda k: int(k))]
+
+    with open(out_path, 'w', newline='', encoding='utf-8-sig') as f:
+        writer = csv.DictWriter(f, fieldnames=COLUMNS, extrasaction='ignore',
+                                delimiter=';')
+        writer.writeheader()
+        writer.writerows(rows)  # missing fields become empty cells
+
+    print(f'wrote {len(rows)} invoices to {out_path}')
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main(sys.argv))
