diff --git a/tests/test_storages.py b/tests/test_storages.py
index 6e433a1..a58f423 100644
--- a/tests/test_storages.py
+++ b/tests/test_storages.py
@@ -285,3 +285,77 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def _crash_during_write(storage, data, keep_bytes):
+    """Simulate a process dying after ``keep_bytes`` of the in-place write."""
+    real = storage._handle
+
+    class Boom(BaseException):
+        pass
+
+    class Proxy:
+        def __getattr__(self, name):
+            return getattr(real, name)
+
+        def write(self, text):
+            real.write(text[:keep_bytes])
+            real.flush()
+            raise Boom
+
+    storage._handle = Proxy()
+    with pytest.raises(Boom):
+        storage.write(data)
+    real.close()
+
+
+def test_json_crash_mid_write_recovers_new_state(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    old = {'_default': {'1': {'a': 1}}}
+    new = {'_default': {'9': {'zzzz': 'x' * 100}}}
+
+    storage = JSONStorage(path)
+    storage.write(old)
+    _crash_during_write(storage, new, keep_bytes=25)
+
+    # File on disk is now truncated garbage
+    with pytest.raises(ValueError):
+        json.load(open(path))
+
+    db = TinyDB(path, storage=JSONStorage)
+    assert db.storage.read() == new
+    db.close()
+    assert not os.path.exists(path + '.journal')
+
+
+def test_json_crash_during_journal_keeps_old_state(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    old = {'_default': {'1': {'a': 1}}}
+
+    storage = JSONStorage(path)
+    storage.write(old)
+    storage.close()
+
+    # Half-written journal (no valid checksum): db file was never touched
+    with open(path + '.journal', 'wb') as f:
+        f.write(b'deadbeef\n{"_default": {"1"')
+
+    storage = JSONStorage(path)
+    assert storage.read() == old
+    storage.close()
+    assert not os.path.exists(path + '.journal')
+
+
+def test_json_write_leaves_no_journal_and_never_renames(tmpdir, monkeypatch):
+    def no_rename(*a, **k):
+        raise OSError(16, 'Device or resource busy')
+
+    monkeypatch.setattr(os, 'rename', no_rename)
+    monkeypatch.setattr(os, 'replace', no_rename)
+
+    path = str(tmpdir.join('db.json'))
+    with TinyDB(path, storage=JSONStorage) as db:
+        db.insert({'a': 1})
+    assert not os.path.exists(path + '.journal')
+    with TinyDB(path, storage=JSONStorage) as db:
+        assert db.all() == [{'a': 1}]
