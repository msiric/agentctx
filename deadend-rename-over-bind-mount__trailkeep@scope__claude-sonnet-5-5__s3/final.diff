 import os
@@ -119,6 +120,42 @@ class JSONStorage(Storage):
         # Open the file for reading/writing
         self._handle = open(path, mode=self._mode, encoding=encoding)
 
+        # Crash safety: finish or discard a write that was interrupted
+        self._journal_path = os.fspath(path) + '.journal'
+        if self._writable:
+            self._recover()
+
+    @property
+    def _writable(self) -> bool:
+        return any(c in self._mode for c in ('+', 'w', 'a'))
+
+    def _recover(self) -> None:
+        """
+        Replay a write-ahead journal left behind by a crashed write.
+
+        A journal is only trusted if its checksum matches. An incomplete
+        journal means the crash happened before the database file was touched,
+        so the old state is intact and the journal is simply discarded.
+        """
+        try:
+            with open(self._journal_path, 'rb') as f:
+                raw = f.read()
+        except FileNotFoundError:
+            return
+
+        digest, _, payload = raw.partition(b'\n')
+        if digest == hashlib.sha256(payload).hexdigest().encode():
+            self._write_in_place(payload.decode('utf-8'))
+        os.remove(self._journal_path)
+
+    def _write_journal(self, serialized: str) -> None:
+        payload = serialized.encode('utf-8')
+        digest = hashlib.sha256(payload).hexdigest().encode()
+        with open(self._journal_path, 'wb') as f:
+            f.write(digest + b'\n' + payload)
+            f.flush()
+            os.fsync(f.fileno())
+
     def close(self) -> None:
         self._handle.close()
 
