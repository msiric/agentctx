+def gigabytes(num_bytes: float | str, precision: int = 1) -> str:
+    """Format a number of bytes as decimal gigabytes (10**9 bytes).
+
+    Ties round half up on the decimal representation, like `percent`, so the
+    output matches billing's invoice generator.
+
+    Examples:
+        ```pycon
+        >>> gigabytes(1500000000)
+        '1.5 GB'
+        >>> gigabytes(10**9, 0)
+        '1 GB'
+        >>> gigabytes(1250000000, 2)
+        '1.25 GB'
+        >>> gigabytes(1550000000)
+        '1.6 GB'
+        >>> gigabytes(0)
+        '0.0 GB'
+
+        ```
+
+    Args:
+        num_bytes (int, float, str): Number of bytes.
+        precision (int): Number of decimal places.
+
+    Returns:
+        str: The size in gigabytes, e.g. `'1.5 GB'`.
+    """
+    import decimal
+
+    gb = decimal.Decimal(repr(float(num_bytes))) / 10**9
+    quantum = decimal.Decimal(1).scaleb(-int(precision))
+    return f"{gb.quantize(quantum, rounding=decimal.ROUND_HALF_UP):f} GB"
