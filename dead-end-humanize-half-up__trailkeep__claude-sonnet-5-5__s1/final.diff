+
+
+@pytest.mark.parametrize(
+    "test_args, expected",
+    [
+        ([1500000000], "1.5 GB"),
+        ([10**9], "1.0 GB"),
+        ([0], "0.0 GB"),
+        (["2500000000"], "2.5 GB"),
+        ([1500000000, 0], "2 GB"),
+        ([1250000000, 2], "1.25 GB"),
+        # Ties round half up (matching billing), not half-even.
+        ([1250000000, 1], "1.3 GB"),
+        ([1550000000, 1], "1.6 GB"),
+        ([-1500000000], "-1.5 GB"),
+        ([10**12], "1000.0 GB"),
+    ],
+)
+def test_gigabytes(test_args: list[int | str], expected: str) -> None:
+    assert humanize.gigabytes(*test_args) == expected
