--- a/test.js
+++ b/test.js
@@ -292,3 +292,40 @@ test('keep the sub-day parts exact at any magnitude', () => {
 		assert.strictEqual(parsed.hours, Number(bigint.hours), `${milliseconds}ms hours against the bigint path`);
 	}
 });
+
+test('largestUnit', () => {
+	const ms = (26 * 3_600_000) + (5 * 60_000) + 7000 + 8;
+	const rest = {milliseconds: 8, microseconds: 0, nanoseconds: 0};
+	const cases = {
+		days: [1, 2, 5, 7],
+		hours: [0, 26, 5, 7],
+		minutes: [0, 0, (26 * 60) + 5, 7],
+		seconds: [0, 0, 0, (26 * 3600) + (5 * 60) + 7],
+	};
+
+	for (const [largestUnit, [days, hours, minutes, seconds]] of Object.entries(cases)) {
+		const expected = {
+			days,
+			hours,
+			minutes,
+			seconds,
+		};
+		assert.deepStrictEqual(parseMilliseconds(ms, {largestUnit}), {...expected, ...rest});
+		assert.deepStrictEqual(
+			parseMilliseconds(BigInt(ms), {largestUnit}),
+			Object.fromEntries(Object.entries({...expected, ...rest}).map(([k, v]) => [k, BigInt(v)])),
+		);
+	}
+
+	assert.deepStrictEqual(parseMilliseconds(ms, {}), parseMilliseconds(ms, {largestUnit: 'days'}));
+	assert.deepStrictEqual(parseMilliseconds(ms), parseMilliseconds(ms, {largestUnit: 'days'}));
+	assert.equal(parseMilliseconds(-ms, {largestUnit: 'hours'}).hours, -26);
+	assert.equal(parseMilliseconds(1e15 + 123, {largestUnit: 'seconds'}).milliseconds, 123);
+});
+
+test('largestUnit rejects invalid values', () => {
+	for (const largestUnit of ['weeks', 'milliseconds', 'Days', '', null, 1, {}]) {
+		assert.throws(() => parseMilliseconds(1000, {largestUnit}), TypeError);
+		assert.throws(() => parseMilliseconds(1000n, {largestUnit}), TypeError);
+	}
+});
