+
+test('parseBytes: plain numbers and bytes', t => {
+	t.is(parseBytes('0'), 0);
+	t.is(parseBytes('512'), 512);
+	t.is(parseBytes('512 B'), 512);
+	t.is(parseBytes('512B'), 512);
+	t.is(parseBytes('  512  B  '), 512);
+	t.is(parseBytes('1.5'), 1.5);
+});
+
+test('parseBytes: binary units', t => {
+	for (const [index, unit] of BINARY_UNITS.entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1024 ** index);
+		t.is(parseBytes(`1${unit}`), 1024 ** index);
+		t.is(parseBytes(`2 ${unit}`), 2 * (1024 ** index));
+	}
+
+	t.is(parseBytes('1.5 KiB'), 1536);
+	t.is(parseBytes('0.5 MiB'), 524_288);
+	t.is(parseBytes('1 KiB'), 1024);
+});
+
+test('parseBytes: reverses prettyBytes in binary mode', t => {
+	for (const value of [0, 1, 512, 1024, 1536, 10_240, 1024 ** 3, 1024 ** 5]) {
+		t.is(parseBytes(prettyBytes(value, {binary: true})), value);
+		t.is(parseBytes(prettyBytes(value, {binary: true, space: false})), value);
+		t.is(parseBytes(prettyBytes(value, {binary: true, nonBreakingSpace: true})), value);
+	}
+});
+
+test('parseBytes: units are case-sensitive', t => {
+	for (const input of ['1 kib', '1 KIB', '1 kiB', '1 b', '1 mib']) {
+		t.throws(() => {
+			parseBytes(input);
+		}, {instanceOf: SyntaxError});
+	}
+});
+
+test('parseBytes: units without the i are powers of 1024', t => {
+	for (const [index, unit] of DECIMAL_UNITS.entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1024 ** index);
+		t.is(parseBytes(`2${unit}`), 2 * (1024 ** index));
+	}
+
+	t.is(parseBytes('1 KB'), 1024);
+	t.is(parseBytes('1 kB'), 1024);
+	t.is(parseBytes('1 MB'), 1_048_576);
+	t.is(parseBytes('1.5 GB'), 1.5 * (1024 ** 3));
+});
+
+test('parseBytes: other casings of the units are rejected', t => {
+	for (const input of ['1 kb', '1 Kb', '1 mb', '1 Mb', '1 gB', '1 yb']) {
+		t.throws(() => {
+			parseBytes(input);
+		}, {instanceOf: SyntaxError, message: /Unsupported unit/});
+	}
+});
+
+test('parseBytes: throws on invalid input', t => {
+	for (const input of ['', ' ', 'KiB', 'abc', '1 2', '1..5', '.5', '5.', '-1', '+1', '1e3', '1,5 KiB', '1 KiB KiB', '1 bit']) {
+		t.throws(() => {
+			parseBytes(input);
+		}, {instanceOf: SyntaxError});
+	}
+
+	for (const input of [1, null, undefined, 10n, {}]) {
+		t.throws(() => {
+			parseBytes(input);
+		}, {instanceOf: TypeError});
+	}
+});
