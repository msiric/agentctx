 	number: number | bigint,
 	options?: Options
 ): string;
+
+/**
+Convert a string with a byte size to a number of bytes: `1.5 KiB` → `1536`.
+
+Accepts a plain number (`'512'`), bytes (`'512 B'`), the binary units `KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`, `ZiB`, and `YiB`, and the units without the `i` (`kB`, `KB`, `MB`, `GB`, `TB`, `PB`, `EB`, `ZB`, and `YB`). All of them are read as powers of 1024, like Windows Explorer shows them, so `1 kB` is `1024`, not `1000`. Fractional values are allowed, and units are case-sensitive. The space between the number and the unit is optional.
+
+The result is not rounded, so a fractional number of bytes can be returned.
+
+@param string - The string to parse.
+@throws A `TypeError` if the argument is not a string, and a `SyntaxError` if the string is not a number with an optional supported unit.
+
+@example
+```
+import {parseBytes} from 'pretty-bytes';
+
+parseBytes('512');
+//=> 512
+
+parseBytes('1.5 KiB');
+//=> 1536
+```
+*/
+export function parseBytes(string: string): number;
diff --git a/index.js b/index.js
index c5f37ab..10f7979 100644
--- a/index.js
+++ b/index.js
@@ -285,3 +285,35 @@ export default function prettyBytes(number, options) {
 	const result = prefix + numberString + separator + UNITS[exponent];
 	return result.padStart(options.fixedWidth ?? 0);
 }
+
+const BINARY_MULTIPLIERS = new Map(BIBYTE_UNITS.map((unit, index) => [unit, 1024 ** index]));
+
+// The units without the `i` are also read as powers of 1024, like Windows Explorer shows them, so `1 kB`, `1 KB`, and `1 KiB` are all `1024`. This differs from `prettyBytes`, which uses powers of 1000 for them unless `binary` is set.
+for (const [index, unit] of BYTE_UNITS.entries()) {
+	BINARY_MULTIPLIERS.set(unit, 1024 ** index);
+}
+
+BINARY_MULTIPLIERS.set('KB', 1024);
+
+// Units are case-sensitive, like the output of `prettyBytes`. The space is optional because `prettyBytes` can omit it, and `\s` also covers its non-breaking space.
+const BYTES_PATTERN = /^\s*(?<value>\d+(?:\.\d+)?)\s*(?<unit>[A-Za-z]+)?\s*$/;
+
+export function parseBytes(string) {
+	if (typeof string !== 'string') {
+		throw new TypeError(`Expected a string, got ${typeof string}: ${string}`);
+	}
+
+	const {value, unit = 'B'} = BYTES_PATTERN.exec(string)?.groups ?? {};
+
+	if (value === undefined) {
+		throw new SyntaxError(`Unable to parse bytes from: ${JSON.stringify(string)}`);
+	}
+
+	const multiplier = BINARY_MULTIPLIERS.get(unit);
+
+	if (multiplier === undefined) {
+		throw new SyntaxError(`Unsupported unit: ${JSON.stringify(unit)}`);
+	}
+
+	return Number(value) * multiplier;
+}
