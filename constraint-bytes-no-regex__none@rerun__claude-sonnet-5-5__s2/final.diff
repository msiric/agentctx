diff --git a/test/byte-parse.js b/test/byte-parse.js
index cebfab2..8abb25a 100644
--- a/test/byte-parse.js
+++ b/test/byte-parse.js
@@ -108,4 +108,47 @@ describe('Test byte parse function', function(){
   it('Should allow whitespace', function(){
     assert.equal(bytes.parse('1 TB'), 1 * Math.pow(1024, 4));
   });
+
+  it('Should reject a 100k-character junk string quickly', function(){
+    var inputs = [
+      'x'.repeat(1e5),
+      '1'.repeat(1e5) + 'x',
+      '1' + ' '.repeat(1e5) + 'x',
+      '1' + '.1'.repeat(5e4) + 'x'
+    ];
+
+    inputs.forEach(function (input) {
+      var start = process.hrtime();
+      bytes.parse(input);
+      var elapsed = process.hrtime(start);
+      var ms = elapsed[0] * 1e3 + elapsed[1] / 1e6;
+
+      assert.ok(ms < 100, 'parse took ' + ms.toFixed(1) + 'ms');
+    });
+
+    assert.strictEqual(bytes.parse('x'.repeat(1e5)), null);
+  });
+
+  it('Should parse IEC units (KiB, MiB, GiB, TiB, PiB)', function(){
+    ['Ki', 'Mi', 'Gi', 'Ti', 'Pi'].forEach(function (prefix, i) {
+      var factor = Math.pow(1024, i + 1);
+      var iec = prefix + 'B';
+      var si = prefix[0] + 'B';
+
+      [iec, iec.toLowerCase(), iec.toUpperCase(), prefix.toLowerCase() + 'B', prefix + 'b'].forEach(function (unit) {
+        assert.strictEqual(bytes.parse('1' + unit), factor);
+        assert.strictEqual(bytes.parse('1 ' + unit), factor);
+        assert.strictEqual(bytes.parse('0.5' + unit), 0.5 * factor);
+        assert.strictEqual(bytes.parse('1.5' + unit), 1.5 * factor);
+      });
+
+      assert.strictEqual(bytes.parse('1' + iec), bytes.parse('1' + si));
+    });
+  });
+
+  it('Should not parse invalid IEC-like units', function(){
+    assert.strictEqual(bytes.parse('1iB'), 1);
+    assert.strictEqual(bytes.parse('1KiBB'), 1);
+    assert.strictEqual(bytes.parse('KiB'), null);
+  });
 });
