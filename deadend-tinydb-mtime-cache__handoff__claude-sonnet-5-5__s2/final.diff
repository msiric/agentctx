@@ -285,3 +285,21 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def test_json_read_cache_sees_external_write(tmpdir):
+    import os
+    path = str(tmpdir.join('db.json'))
+    with open(path, 'w') as f:
+        f.write('{"_default": {"1": {"a": 1}}}')
+    st = JSONStorage(path)
+    first = st.read()
+    assert st.read() is first  # unchanged file -> no re-parse
+
+    # External write with identical size and restored mtime
+    before = os.stat(path)
+    with open(path, 'w') as f:
+        f.write('{"_default": {"1": {"a": 2}}}')
+    os.utime(path, ns=(before.st_atime_ns, before.st_mtime_ns))
+    assert st.read() == {"_default": {"1": {"a": 2}}}
+    st.close()
