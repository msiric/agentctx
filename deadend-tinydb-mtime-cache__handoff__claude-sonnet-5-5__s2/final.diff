@@ -0,0 +1,67 @@
+"""Benchmark read performance on a large TinyDB JSON file.
+
+Usage: python scripts/bench_read.py [target_mb=40]
+"""
+import cProfile
+import json
+import os
+import pstats
+import sys
+import tempfile
+import time
+
+from tinydb import TinyDB, where
+from tinydb.storages import JSONStorage
+
+
+def timed(label, fn, repeat=3):
+    best = min(_once(fn) for _ in range(repeat))
+    print(f'{label:<28}{best * 1000:10.1f} ms')
+    return best
+
+
+def _once(fn):
+    t = time.perf_counter()
+    fn()
+    return time.perf_counter() - t
+
+
+def main():
+    target_mb = float(sys.argv[1]) if len(sys.argv) > 1 else 40
+    with tempfile.TemporaryDirectory() as d:
+        path = os.path.join(d, 'big.json')
+        docs = {}
+        i = 0
+        while True:
+            i += 1
+            docs[str(i)] = {'int': i, 'name': f'user-{i}', 'group': i % 100,
+                            'tags': ['a', 'b', 'c'], 'text': 'lorem ipsum ' * 8,
+                            'nested': {'x': i * 0.5, 'y': [i, i + 1]}}
+            if i % 10000 == 0:
+                est = len(json.dumps(docs)) / 1e6
+                if est >= target_mb:
+                    break
+        with open(path, 'w') as f:
+            json.dump({'_default': docs}, f)
+        print(f'{len(docs)} docs, {os.path.getsize(path) / 1e6:.1f} MB\n')
+
+        db = TinyDB(path)
+        storage = db.storage
+        timed('raw json.load', lambda: (storage._handle.seek(0), json.load(storage._handle)))
+        timed('storage.read()', storage.read)
+        timed('db.all()', db.all)
+        timed('db.search(group==5)', lambda: (db.clear_cache(), db.search(where('group') == 5)))
+        timed('db.get(doc_id=1)', lambda: db.get(doc_id=1))
+        timed('db.count(group==5)', lambda: (db.clear_cache(), db.count(where('group') == 5)))
+        timed('db.search (cache hit)', lambda: db.search(where('group') == 5))
+
+        print('\nProfile of db.search():')
+        pr = cProfile.Profile()
+        db.clear_cache()
+        pr.runcall(db.search, where('group') == 5)
+        pstats.Stats(pr).sort_stats('cumulative').print_stats(8)
+        db.close()
+
+
+if __name__ == '__main__':
+    main()
