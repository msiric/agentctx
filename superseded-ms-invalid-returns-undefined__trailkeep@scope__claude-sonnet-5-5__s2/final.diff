+import { describe, expect, it } from '@jest/globals';
+import { parseCompound } from './index';
+
+describe('parseCompound(string)', () => {
+  it('should sum short units', () => {
+    expect(parseCompound('1h 30m')).toBe(5400000);
+  });
+
+  it('should sum long units with spaces', () => {
+    expect(parseCompound('2 days 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
+  });
+
+  it('should allow pieces without separators', () => {
+    expect(parseCompound('1h30m15s')).toBe(5415000);
+  });
+
+  it('should allow commas between pieces', () => {
+    expect(parseCompound('1h, 30m')).toBe(5400000);
+    expect(parseCompound('1h,30m , 15s')).toBe(5415000);
+  });
+
+  it('should handle a single piece', () => {
+    expect(parseCompound('500ms')).toBe(500);
+  });
+
+  it('should handle decimals, negatives and surrounding spaces', () => {
+    expect(parseCompound(' 1.5h -30m ')).toBe(3600000);
+  });
+
+  it('should throw a TypeError including the input when a piece has no unit', () => {
+    expect(() => parseCompound('1 2h')).toThrow(TypeError);
+    expect(() => parseCompound('90')).toThrow('value="90"');
+  });
+
+  it('should throw a TypeError including the input for unknown units or junk', () => {
+    expect(() => parseCompound('abc')).toThrow(TypeError);
+    expect(() => parseCompound('abc')).toThrow('value="abc"');
+    expect(() => parseCompound('1h foo')).toThrow('value="1h foo"');
+    expect(() => parseCompound('1x 2m')).toThrow(TypeError);
+    expect(() => parseCompound('1h,, 30m')).toThrow(TypeError);
+    expect(() => parseCompound(',1h')).toThrow(TypeError);
+    expect(() => parseCompound('1h,')).toThrow(TypeError);
+  });
+
+  it('should throw a TypeError on empty, too long, or non-string input', () => {
+    expect(() => parseCompound('')).toThrow(TypeError);
+    expect(() => parseCompound('')).toThrow('value=""');
+    expect(() => parseCompound('1h '.repeat(40))).toThrow(TypeError);
+    expect(() => parseCompound(5 as unknown as string)).toThrow(TypeError);
+  });
+});
