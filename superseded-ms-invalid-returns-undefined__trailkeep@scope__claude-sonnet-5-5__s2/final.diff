+/**
+ * Parse a compound duration such as `"1h 30m"` or `"1h, 30m"` or `"2 days 4 hours"` and
+ * return the total in milliseconds. Each piece must have a unit and is parsed
+ * with {@link parse}.
+ *
+ * @param str - A compound duration string
+ * @returns The summed value in milliseconds
+ * @throws TypeError if `str` is not a string of 1 to 99 characters, or any
+ * part of it can't be parsed. The message includes the input.
+ */
+export function parseCompound(str: string): number {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw new TypeError(
+      `Value provided to ms.parseCompound() must be a string with length between 1 and 99. value=${JSON.stringify(str)}`,
+    );
+  }
+  const invalid = () =>
+    new TypeError(
+      `Value provided to ms.parseCompound() is not a valid compound duration. value=${JSON.stringify(str)}`,
+    );
+  const piece = '-?\\d*\\.?\\d+ *[a-z]+';
+  if (!new RegExp(`^ *${piece}(?:\\s*,?\\s*${piece})* *$`, 'i').test(str)) {
+    throw invalid();
+  }
+  let total = 0;
+  for (const [part] of str.matchAll(new RegExp(piece, 'gi'))) {
+    const value = parse(part);
+    if (Number.isNaN(value)) {
+      throw invalid();
+    }
+    total += value;
+  }
+  return total;
+}
+
+/**
+ * Parse a timer-style clock string and return the total in milliseconds.
+ * `"1:30"` is m:ss and `"01:02:03"` is h:mm:ss. Seconds may have a decimal
+ * part (`"1:30.5"`). Seconds, and minutes in h:mm:ss, must be below 60.
+ *
+ * Unlike {@link parseCompound}, this does not throw on bad input.
+ *
+ * @param str - A clock string
+ * @returns The value in milliseconds, or `undefined` if `str` is not a valid clock string
+ */
+export function parseClock(str: string): number | undefined {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    return undefined;
+  }
+  const m = /^(?:(\d+):)?(\d+):(\d{2}(?:\.\d+)?)$/.exec(str.trim());
+  if (!m) {
+    return undefined;
+  }
+  const hasHours = m[1] !== undefined;
+  const hours = hasHours ? Number(m[1]) : 0;
+  const minutes = Number(m[2]);
+  const seconds = Number(m[3]);
+  if (seconds >= 60 || (hasHours && (m[2].length !== 2 || minutes >= 60))) {
+    return undefined;
+  }
+  return ((hours * 60 + minutes) * 60 + seconds) * 1000;
+}
