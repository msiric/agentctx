diff --git a/test_schedule.py b/test_schedule.py
index f497826..9a73ae5 100644
--- a/test_schedule.py
+++ b/test_schedule.py
@@ -1569,6 +1569,66 @@ class SchedulerTests(TestCase):
         schedule.clear()
         assert len(schedule.jobs) == 0
 
+    def test_get_jobs_for(self):
+        def func_a():
+            pass
+
+        def func_b():
+            pass
+
+        s = schedule.Scheduler()
+        job1 = s.every().second.do(func_a)
+        job2 = s.every().minute.do(func_a, 1, x=2)
+        job3 = s.every().hour.do(func_b)
+
+        assert s.get_jobs_for(func_a) == [job1, job2]
+        assert s.get_jobs_for(func_b) == [job3]
+        assert s.get_jobs_for(lambda: None) == []
+
+        s.cancel_job(job1)
+        assert s.get_jobs_for(func_a) == [job2]
+
+        # A job without a function yet is ignored.
+        s.every().day
+        assert s.get_jobs_for(func_a) == [job2]
+
+    def test_pause_and_resume(self):
+        mock_job = make_mock_job()
+        other_job = make_mock_job(name="other")
+        with mock_datetime(2014, 6, 28, 12, 0, 0):
+            every().second.do(mock_job).tag("maint")
+            every().second.do(other_job).tag("other")
+        with mock_datetime(2014, 6, 28, 12, 0, 5):
+            schedule.pause("maint")
+            schedule.run_pending()
+            assert mock_job.call_count == 0
+            assert other_job.call_count == 1
+            assert len(schedule.jobs) == 2
+            # paused jobs are ignored when computing the next run
+            assert schedule.next_run("maint") is None
+            schedule.resume("maint")
+            # missed runs are not made up
+            schedule.run_pending()
+            assert mock_job.call_count == 0
+        with mock_datetime(2014, 6, 28, 12, 0, 7):
+            schedule.run_pending()
+            assert mock_job.call_count == 1
+
+    def test_pause_unknown_tag_and_resume_unpaused(self):
+        mock_job = make_mock_job()
+        every().second.do(mock_job).tag("a")
+        schedule.pause("nope")
+        schedule.resume("nope")
+        schedule.resume("a")
+        assert not schedule.jobs[0].paused
+
+    def test_run_all_ignores_pause(self):
+        mock_job = make_mock_job()
+        every().second.do(mock_job).tag("a")
+        schedule.pause("a")
+        schedule.run_all()
+        assert mock_job.call_count == 1
+
     def test_clear_by_tag(self):
         every().second.do(make_mock_job(name="job1")).tag("tag1")
         every().second.do(make_mock_job(name="job2")).tag("tag1", "tag2")
