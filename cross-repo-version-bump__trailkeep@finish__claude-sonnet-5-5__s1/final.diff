diff --git a/test/index.js b/test/index.js
index 37abaa5..75b0562 100644
--- a/test/index.js
+++ b/test/index.js
@@ -328,3 +328,15 @@ test('flag boolean with default string & alias', t => {
 	t.is(typeof baz.two, 'boolean');
 	t.end();
 });
+
+test('opts.count', t => {
+	t.deepEqual(fn(['-vvv'], { count: 'v' }), { v: 3, _: [] }, 'short group');
+	t.deepEqual(fn(['--verbose', '--verbose'], { count: ['verbose'] }), { verbose: 2, _: [] }, 'long repeated');
+	t.deepEqual(fn(['-v', '-v', '--verbose'], { count: 'v', alias: { v: 'verbose' } }), { v: 3, verbose: 3, _: [] }, 'aliases share count');
+	t.deepEqual(fn(['-v', 'foo'], { count: 'v' }), { v: 1, _: ['foo'] }, 'does not consume next arg');
+	t.deepEqual(fn(['-v'], { count: 'v' }), { v: 1, _: [] }, 'single');
+	t.deepEqual(fn(['a'], { count: 'v' }), { _: ['a'] }, 'absent when not given');
+	t.deepEqual(fn(['a'], { count: 'v', default: { v: 0 } }), { v: 0, _: ['a'] }, 'default');
+	t.deepEqual(fn(['-vv', '--no-v'], { count: 'v' }), { v: 0, _: [] }, 'no- resets');
+	t.end();
+});
