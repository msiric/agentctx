+class TestRunPendingErrors:
+    def setup_method(self):
+        schedule.clear()
+
+    def test_runs_remaining_jobs_then_reraises_first(self):
+        calls = []
+
+        def bad():
+            calls.append("bad")
+            raise ValueError("first")
+
+        def bad2():
+            calls.append("bad2")
+            raise KeyError("second")
+
+        def good():
+            calls.append("good")
+
+        for f in (bad, bad2, good):
+            schedule.every().second.do(f)
+        with mock_datetime(2100, 1, 1, 0, 0, 5):
+            with pytest.raises(ValueError):
+                schedule.run_pending()
+            assert sorted(calls) == sorted(["bad", "bad2", "good"])
+            for job in schedule.jobs:
+                assert job.next_run > datetime.datetime.now()
