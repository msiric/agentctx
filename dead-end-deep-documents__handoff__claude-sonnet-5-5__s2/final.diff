+
+
+def test_drop_keys_any_depth_and_attributes():
+    from xmltodict import drop_keys
+    doc = parse('<a id="1"><b id="2" k="x"><c id="3">t</c></b><b id="4"/></a>')
+    out = drop_keys(doc, ['@id'])
+    assert out == {'a': {'b': [{'@k': 'x', 'c': {'#text': 't'}}, {}]}}
+
+
+def test_drop_keys_removes_elements_in_lists():
+    from xmltodict import drop_keys
+    doc = {'a': [{'x': 1, 'y': 2}, {'x': 3}], 'x': 0}
+    assert drop_keys(doc, {'x'}) == {'a': [{'y': 2}, {}]}
+
+
+def test_drop_keys_does_not_mutate_input():
+    import copy
+    from xmltodict import drop_keys
+    doc = {'a': {'@id': '1', 'b': [{'@id': '2', 'c': 'v'}]}}
+    snapshot = copy.deepcopy(doc)
+    out = drop_keys(doc, ['@id'])
+    assert doc == snapshot
+    assert out == {'a': {'b': [{'c': 'v'}]}}
+    assert out['a'] is not doc['a'] and out['a']['b'] is not doc['a']['b']
+
+
+def test_drop_keys_edge_cases():
+    from xmltodict import drop_keys
+    assert drop_keys({'a': 1}, []) == {'a': 1}
+    assert drop_keys({'a': 1}, 'a') == {}  # bare string is one name
+    assert drop_keys('text', ['a']) == 'text'
+    assert drop_keys({'a': 'a', 'b': None}, ['zzz']) == {'a': 'a', 'b': None}
+
+
+def test_drop_keys_very_deep_document():
+    from xmltodict import drop_keys
+    doc = leaf = {}
+    for i in range(5000):
+        leaf['@id'] = str(i)
+        leaf['part'] = {}
+        leaf = leaf['part']
+    out = drop_keys(doc, ['@id'])
+    depth = 0
+    while out:
+        assert '@id' not in out
+        out = out['part']
+        depth += 1
+    assert depth == 5000
