         self._write(f"<!--{escape(text)}-->")
 
 
+def drop_keys(doc, names):
+    """Return a copy of `doc` with every key in `names` removed at any depth.
+
+    Attribute keys (e.g. ``'@id'``) are matched literally, so pass them with
+    their prefix. Dicts and lists are copied; the input is never mutated and
+    leaf values are shared. Implemented iteratively, so arbitrarily deep
+    documents do not hit the recursion limit.
+    """
+    if isinstance(names, str):
+        names = (names,)
+    names = frozenset(names)
+
+    def shell(node):
+        if isinstance(node, dict):
+            try:
+                return type(node)()
+            except TypeError:
+                return {}
+        if isinstance(node, list):
+            return []
+        return None
+
+    root = shell(doc)
+    if root is None:
+        return doc
+    stack = [(doc, root)]
+    while stack:
+        src, dst = stack.pop()
+        items = src.items() if isinstance(src, dict) else enumerate(src)
+        for key, value in items:
+            if isinstance(src, dict) and key in names:
+                continue
+            child = shell(value)
+            if child is None:
+                child = value
+            else:
+                stack.append((value, child))
+            if isinstance(src, dict):
+                dst[key] = child
+            else:
+                dst.append(child)
+    return root
+
+
 def unparse(input_dict, output=None, encoding='utf-8', full_document=True,
             short_empty_elements=False, comment_key='#comment',
