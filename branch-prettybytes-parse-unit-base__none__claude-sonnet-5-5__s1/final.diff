 	number: number | bigint,
 	options?: Options
 ): string;
+
+/**
+Parse a byte size string, the reverse of `prettyBytes()`, into a number of bytes.
+
+Accepts a plain number or a number followed by a binary unit (`B`, `KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`, `ZiB`, `YiB`; powers of 1024) or a decimal unit (`kB` or `KB`, `MB`, `GB`, `TB`, `PB`, `EB`, `ZB`, `YB`; powers of 1000). The number may be fractional and signed, and the space before the unit is optional. Units are case-sensitive.
+
+@throws A `TypeError` if the input is not a string, and a `SyntaxError` if it cannot be parsed or uses an unsupported unit.
+
+@example
+```
+import {parseBytes} from 'pretty-bytes';
+
+parseBytes('512');
+//=> 512
+
+parseBytes('1.5 KiB');
+//=> 1536
+```
+*/
+export function parseBytes(string: string): number;
diff --git a/index.js b/index.js
index c5f37ab..9fe7555 100644
--- a/index.js
+++ b/index.js
@@ -285,3 +285,31 @@ export default function prettyBytes(number, options) {
 	const result = prefix + numberString + separator + UNITS[exponent];
 	return result.padStart(options.fixedWidth ?? 0);
 }
+
+const BINARY_MULTIPLIERS = new Map(BIBYTE_UNITS.map((unit, index) => [unit, 1024 ** index]));
+const DECIMAL_MULTIPLIERS = new Map(BYTE_UNITS.map((unit, index) => [unit, 1000 ** index]));
+// `KB` is accepted as an alias of `kB`.
+DECIMAL_MULTIPLIERS.set('KB', 1000);
+const PARSE_PATTERN = /^(?<sign>[+-]?)(?<value>\d+(?:\.\d+)?|\.\d+)\s*(?<unit>[A-Za-z]+)?$/;
+
+export function parseBytes(string) {
+	if (typeof string !== 'string') {
+		throw new TypeError(`Expected a string, got \`${typeof string}\``);
+	}
+
+	const match = PARSE_PATTERN.exec(string.trim());
+
+	if (!match) {
+		throw new SyntaxError(`Cannot parse \`${string}\` as a byte size`);
+	}
+
+	const {sign, value, unit = 'B'} = match.groups;
+	const multiplier = BINARY_MULTIPLIERS.get(unit) ?? DECIMAL_MULTIPLIERS.get(unit);
+
+	if (multiplier === undefined) {
+		throw new SyntaxError(`Unsupported unit \`${unit}\` in \`${string}\``);
+	}
+
+	const bytes = Number(value) * multiplier;
+	return sign === '-' ? -bytes : bytes;
+}
