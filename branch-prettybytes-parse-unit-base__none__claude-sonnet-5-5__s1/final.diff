+
+test('parseBytes: plain numbers and bytes', t => {
+	t.is(parseBytes('512'), 512);
+	t.is(parseBytes('512 B'), 512);
+	t.is(parseBytes('512B'), 512);
+	t.is(parseBytes('0'), 0);
+	t.is(parseBytes('  42 B  '), 42);
+});
+
+test('parseBytes: binary units', t => {
+	for (const [index, unit] of BINARY_UNITS.entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1024 ** index);
+		t.is(parseBytes(`2${unit}`), 2 * (1024 ** index));
+	}
+});
+
+test('parseBytes: fractions and signs', t => {
+	t.is(parseBytes('1.5 KiB'), 1536);
+	t.is(parseBytes('.5 KiB'), 512);
+	t.is(parseBytes('-1 KiB'), -1024);
+	t.is(parseBytes('+42 B'), 42);
+	t.is(parseBytes('1 KiB'), 1024);
+});
+
+test('parseBytes: round-trips prettyBytes binary output', t => {
+	for (const bytes of [0, 1, 512, 1024, 1536, 10_240, 1024 ** 3, 1024 ** 5]) {
+		t.is(parseBytes(prettyBytes(bytes, {binary: true})), bytes);
+	}
+});
+
+test('parseBytes: units are case-sensitive', t => {
+	for (const input of ['1 kib', '1 KIB', '1 kiB', '1 b', '1 Kib']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError});
+	}
+});
+
+test('parseBytes: decimal units', t => {
+	for (const [index, unit] of DECIMAL_UNITS.entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1000 ** index);
+		t.is(parseBytes(`2${unit}`), 2 * (1000 ** index));
+	}
+
+	t.is(parseBytes('1 KB'), 1000);
+	t.is(parseBytes('1.5 kB'), 1500);
+	t.is(parseBytes('-2 MB'), -2_000_000);
+});
+
+test('parseBytes: round-trips prettyBytes decimal output', t => {
+	for (const bytes of [0, 1, 500, 1000, 1500, 10_000, 1e9, 1e15]) {
+		t.is(parseBytes(prettyBytes(bytes)), bytes);
+	}
+});
+
+test('parseBytes: unsupported units', t => {
+	for (const input of ['1 kb', '1 mB', '1 Kb', '1 Mbit', '1 XB']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError, message: /Unsupported unit/});
+	}
+});
+
+test('parseBytes: invalid input', t => {
+	for (const input of ['', ' ', 'KiB', '1..5 KiB', '1.5.5', '1 KiB KiB', '1e3', '1,5 KiB', '0x10', 'Infinity', 'NaN']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError});
+	}
+
+	for (const input of [1, undefined, null, {}]) {
+		t.throws(() => parseBytes(input), {instanceOf: TypeError});
+	}
+});
