     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def test_json_write_leaves_no_journal(tmpdir):
+    path = str(tmpdir.join('test.db'))
+    storage = JSONStorage(path)
+    storage.write(doc)
+    storage.close()
+
+    assert not os.path.exists(path + '.journal')
+
+
+def test_json_recover_interrupted_inplace_write(tmpdir):
+    # Crash while overwriting the db file: it's truncated, journal is complete
+    path = str(tmpdir.join('test.db'))
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+
+    new_state = json.dumps({'_default': {'1': {'a': 1}, '2': {'a': 2}}})
+    with open(path + '.journal', 'w') as f:
+        f.write(new_state)
+    with open(path, 'w') as f:
+        f.write(new_state[:10])
+
+    with TinyDB(path) as db:
+        assert db.all() == [{'a': 1}, {'a': 2}]
+    assert not os.path.exists(path + '.journal')
+
+
+def test_json_discard_incomplete_journal(tmpdir):
+    # Crash while writing the journal: db file is untouched and must win
+    path = str(tmpdir.join('test.db'))
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+
+    with open(path + '.journal', 'w') as f:
+        f.write('{"_default": {"1": {"a"')
+
+    with TinyDB(path) as db:
+        assert db.all() == [{'a': 1}]
+    assert not os.path.exists(path + '.journal')
+
+
+def test_json_crash_at_every_write_stage(tmpdir, monkeypatch):
+    # Simulate a kill at each os.fsync during a write; the db must stay valid
+    path = str(tmpdir.join('test.db'))
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+
+    class Crash(BaseException):
+        pass
+
+    real_fsync = os.fsync
+    for crash_at in range(1, 4):
+        calls = []
+
+        def fsync(fd):
+            calls.append(fd)
+            if len(calls) == crash_at:
+                raise Crash()
+            real_fsync(fd)
+
+        db = TinyDB(path)
+        monkeypatch.setattr(os, 'fsync', fsync)
+        with pytest.raises(Crash):
+            db.insert({'b': crash_at})
+        monkeypatch.setattr(os, 'fsync', real_fsync)
+        db.storage._handle.close()  # the "process" is gone
+
+        with TinyDB(path) as db:
+            assert db.all()  # readable, old or new state
+            assert not os.path.exists(path + '.journal')
+        os.truncate(path, 0)
+        with TinyDB(path) as db:
+            db.insert({'a': 1})
