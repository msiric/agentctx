@@ -116,9 +116,49 @@ class JSONStorage(Storage):
         if any([character in self._mode for character in ('+', 'w', 'a')]):  # any of the writing modes
             touch(path, create_dirs=create_dirs)
 
+        self._path = path
+        self._encoding = encoding
+        self._journal_path = os.fspath(path) + '.journal'
+
+        # Finish or discard a write that was interrupted by a crash. This must
+        # happen before the database file is opened and read.
+        if '+' in self._mode:
+            self._recover()
+
         # Open the file for reading/writing
         self._handle = open(path, mode=self._mode, encoding=encoding)
 
+    def _recover(self) -> None:
+        """
+        Recover from a write that was interrupted by a crash.
+
+        Writes are made crash-safe in place (no rename, so this also works for
+        bind-mounted single files) by first saving the new state in a journal
+        file. If the journal holds complete, valid JSON, the in-place write may
+        have been cut short, so it is replayed. If the journal is incomplete,
+        the crash happened before the database file was touched, so the
+        journal is simply dropped.
+        """
+
+        try:
+            with open(self._journal_path, encoding=self._encoding) as journal:
+                content = journal.read()
+        except FileNotFoundError:
+            return
+
+        try:
+            json.loads(content)
+        except ValueError:
+            content = None
+
+        if content is not None:
+            with open(self._path, 'w', encoding=self._encoding) as db_file:
+                db_file.write(content)
+                db_file.flush()
+                os.fsync(db_file.fileno())
+
+        os.remove(self._journal_path)
+
     def close(self) -> None:
         self._handle.close()
 
