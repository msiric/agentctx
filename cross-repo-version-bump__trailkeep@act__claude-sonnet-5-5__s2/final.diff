diff --git a/test/count.js b/test/count.js
new file mode 100644
index 0000000..04786b2
--- /dev/null
+++ b/test/count.js
@@ -0,0 +1,47 @@
+const test = require('tape');
+const fn = require('../lib');
+
+test('count: grouped short flags', t => {
+	t.same(fn(['-vvv'], { count: 'v' }), { v: 3, _: [] });
+	t.end();
+});
+
+test('count: repeated flags', t => {
+	t.same(fn(['--verbose', '--verbose'], { count: ['verbose'] }), { verbose: 2, _: [] });
+	t.same(fn(['-v', '-v', '--v'], { count: 'v' }), { v: 3, _: [] });
+	t.end();
+});
+
+test('count: single and absent', t => {
+	t.same(fn(['-v'], { count: 'v' }), { v: 1, _: [] });
+	t.same(fn(['-a'], { count: 'v' }), { a: true, _: [] });
+	t.end();
+});
+
+test('count: does not consume values', t => {
+	t.same(fn(['-vv', 'foo', '-v'], { count: 'v' }), { v: 3, _: ['foo'] });
+	t.end();
+});
+
+test('count: alias', t => {
+	const argv = fn(['-vv', '--verbose'], { count: 'v', alias: { v: 'verbose' } });
+	t.same(argv, { v: 3, verbose: 3, _: [] });
+	t.end();
+});
+
+test('count: mixed with other flags', t => {
+	t.same(fn(['-vvx', '-v'], { count: 'v' }), { v: 3, x: true, _: [] });
+	t.end();
+});
+
+test('count: --no-flag resets', t => {
+	t.same(fn(['-vv', '--no-v'], { count: 'v' }), { v: 0, _: [] });
+	t.end();
+});
+
+test('count: unknown is respected', t => {
+	const unknown = [];
+	fn(['-vx'], { count: 'v', alias: { v: 'verbose' }, unknown: a => unknown.push(a) });
+	t.same(unknown, ['-x']);
+	t.end();
+});
