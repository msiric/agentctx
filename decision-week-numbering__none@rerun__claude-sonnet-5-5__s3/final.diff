diff --git a/src/index.js b/src/index.js
index 3ea001b..976a838 100644
--- a/src/index.js
+++ b/src/index.js
@@ -7,6 +7,23 @@ var MAP = {
 		return d.getMonth() + 1;
 	},
 	DD: 'getDate',
+	DDD: function (d) {
+		// compare as UTC midnights so DST shifts can't skew the day count
+		var a = new Date(0), b = new Date(0);
+		a.setUTCFullYear(d.getFullYear(), d.getMonth(), d.getDate());
+		b.setUTCFullYear(d.getFullYear(), 0, 1);
+		return (a - b) / 864e5 + 1;
+	},
+	WW: function (d) {
+		// ISO 8601 week: the week containing the year's first Thursday is week 1
+		var t = new Date(0);
+		t.setUTCFullYear(d.getFullYear(), d.getMonth(), d.getDate());
+		var day = t.getUTCDay() || 7;
+		t.setUTCDate(t.getUTCDate() + 4 - day); // shift to this week's Thursday
+		var jan1 = new Date(0);
+		jan1.setUTCFullYear(t.getUTCFullYear(), 0, 1);
+		return Math.ceil(((t - jan1) / 864e5 + 1) / 7);
+	},
 	HH: 'getHours',
 	mm: 'getMinutes',
 	ss: 'getSeconds',
