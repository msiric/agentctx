+def _set(clock, year, month, day, hour, minute, second):
+    clock.year, clock.month, clock.day = year, month, day
+    clock.hour, clock.minute, clock.second = hour, minute, second
+
+
+class RetryTest(TestCase):
+    def setUp(self):
+        schedule.clear()
+
+    def _failing(self, fail_times):
+        calls = []
+
+        def fn():
+            calls.append(1)
+            if len(calls) <= fail_times:
+                raise RuntimeError("boom")
+
+        return fn, calls
+
+    def test_backoff_delays_and_success(self):
+        fn, calls = self._failing(2)
+        clock = mock_datetime(2020, 1, 1, 10, 0, 0)
+        with clock:
+            job = every(1).hour.do(fn).retry(times=3, base_delay=30)
+            with mock.patch.object(schedule._jitter_rng, "uniform", return_value=5):
+                _set(clock, 2020, 1, 1, 11, 0, 0)
+                schedule.run_pending()  # fail -> retry in 30+5
+                assert job.next_run == datetime.datetime(2020, 1, 1, 11, 0, 35)
+                _set(clock, 2020, 1, 1, 11, 0, 35)
+                schedule.run_pending()  # fail -> retry in 60+5
+                assert job.next_run == datetime.datetime(2020, 1, 1, 11, 1, 40)
+                _set(clock, 2020, 1, 1, 11, 1, 40)
+                schedule.run_pending()  # success -> normal schedule
+            assert len(calls) == 3
+            assert job.next_run == datetime.datetime(2020, 1, 1, 12, 1, 40)
+            assert job._retry_count == 0
+
+    def test_gives_up_after_times(self):
+        fn, calls = self._failing(100)
+        clock = mock_datetime(2020, 1, 1, 10, 0, 0)
+        with clock:
+            job = every(1).hour.do(fn).retry(times=2, base_delay=10)
+            with mock.patch.object(schedule._jitter_rng, "uniform", return_value=0):
+                _set(clock, 2020, 1, 1, 11, 0, 0)
+                schedule.run_pending()
+                _set(clock, 2020, 1, 1, 11, 0, 10)
+                schedule.run_pending()
+                _set(clock, 2020, 1, 1, 11, 0, 30)
+                schedule.run_pending()  # 3rd failure: give up
+            assert len(calls) == 3  # 1 run + 2 retries
+            assert job.next_run == datetime.datetime(2020, 1, 1, 12, 0, 30)
+            assert job._retry_count == 0
+
+    def test_jitter_within_range(self):
+        fn, _ = self._failing(100)
+        clock = mock_datetime(2020, 1, 1, 10, 0, 0)
+        with clock:
+            job = every(1).hour.do(fn).retry(times=5, base_delay=30)
+            _set(clock, 2020, 1, 1, 11, 0, 0)
+            schedule.run_pending()
+            lo = datetime.datetime(2020, 1, 1, 11, 0, 30)
+            hi = datetime.datetime(2020, 1, 1, 11, 1, 0)
+            assert lo <= job.next_run <= hi
+
+    def test_no_retry_config_still_propagates(self):
+        fn, _ = self._failing(1)
+        every().second.do(fn)
+        clock = mock_datetime(2020, 1, 1, 10, 0, 0)
+        with clock:
