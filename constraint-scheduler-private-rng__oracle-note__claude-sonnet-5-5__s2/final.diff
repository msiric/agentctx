+    def jitter(self, seconds: float):
+        """
+        Delay every computed `next_run` by a random offset between 0 and
+        `seconds` (uniform). Useful to avoid many workers hitting the same
+        resource in the same instant.
+
+        For example, `every(10).minutes.jitter(30)` runs every 10 minutes
+        plus 0-30 seconds, re-drawn after each run.
+
+        :param seconds: Maximum offset in seconds (must be >= 0)
+        :return: The invoked job instance
+        """
+        if seconds < 0:
+            raise ScheduleValueError("`jitter` must be non-negative")
+        self.jitter_seconds = seconds
+        return self
+
+    def retry(self, times: int, base_delay: float):
+        """
+        Retry the job if a run raises an exception.
+
+        The first retry happens `base_delay` seconds after the failure, the
+        second after 2x `base_delay`, the third after 4x, and so on. Each delay
+        also gets a random 0 to `base_delay` seconds of jitter. After `times`
+        failed retries the job gives up and returns to its normal schedule.
+
+        Exceptions raised by a job with retries configured are logged and not
+        propagated out of `run_pending`.
+
+        :param times: Maximum number of retries per scheduled run (>= 0)
+        :param base_delay: Base delay in seconds (must be >= 0)
+        :return: The invoked job instance
+        """
+        if times < 0:
+            raise ScheduleValueError("`times` must be non-negative")
+        if base_delay < 0:
+            raise ScheduleValueError("`base_delay` must be non-negative")
+        self.retry_times = times
+        self.retry_base_delay = base_delay
+        return self
+
