+
+
+def test_inprocess_jsonl_skips_blank_lines():
+    """In-process: JSONL input with trailing blank lines is accepted"""
+    out = run_main_in_process(["-r", "jsonl", "-f", "tsv"], input_text='{"a": 1}\n{"a": 2}\n\n\n')
+    assert "1" in out and "2" in out
+
+
+def test_inprocess_jsonl_missing_key_uses_loader_marker():
+    """In-process: a record lacking a key gets '.' without extra flags"""
+    out = run_main_in_process(
+        ["-r", "jsonl", "-f", "tsv"],
+        input_text='{"a": 1, "b": 2}\n{"a": 3}\n\n',
+    )
+    assert_equal([r.split() for r in out.splitlines()], [["a", "b"], ["1", "2"], ["3", "."]])
