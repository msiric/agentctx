diff --git a/test_schedule.py b/test_schedule.py
index f497826..6534e0f 100644
--- a/test_schedule.py
+++ b/test_schedule.py
@@ -1569,6 +1569,91 @@ class SchedulerTests(TestCase):
         schedule.clear()
         assert len(schedule.jobs) == 0
 
+    def test_get_jobs_for(self):
+        def foo():
+            pass
+
+        def bar():
+            pass
+
+        class Greeter:
+            def hello(self):
+                pass
+
+        g = Greeter()
+        j1 = every().second.do(foo)
+        j2 = every().minute.do(foo, 1, key="v")
+        j3 = every().second.do(bar)
+        j4 = every().second.do(g.hello)
+
+        assert schedule.default_scheduler.get_jobs_for(foo) == [j1, j2]
+        assert schedule.default_scheduler.get_jobs_for(bar) == [j3]
+        assert schedule.default_scheduler.get_jobs_for(g.hello) == [j4]
+        assert schedule.default_scheduler.get_jobs_for(lambda: None) == []
+
+        for job in schedule.default_scheduler.get_jobs_for(foo):
+            schedule.cancel_job(job)
+        assert schedule.default_scheduler.get_jobs_for(foo) == []
+        assert len(schedule.jobs) == 2
+
+    def test_get_jobs_for_scheduler_instance(self):
+        def foo():
+            pass
+
+        s1, s2 = schedule.Scheduler(), schedule.Scheduler()
+        j = s1.every().second.do(foo)
+        assert s1.get_jobs_for(foo) == [j]
+        assert s2.get_jobs_for(foo) == []
+
+    def test_pause_and_resume_by_tag(self):
+        job1, job2, job3 = (make_mock_job(name=f"job{i}") for i in range(3))
+        with mock_datetime(2020, 1, 1, 10, 0, 0):
+            every().second.do(job1).tag("maint")
+            every().second.do(job2).tag("maint", "other")
+            every().second.do(job3).tag("other")
+            schedule.pause("maint")
+            assert len(schedule.jobs) == 3
+        with mock_datetime(2020, 1, 1, 10, 0, 5):
+            schedule.run_pending()
+            assert job1.call_count == 0
+            assert job2.call_count == 0
+            assert job3.call_count == 1
+        with mock_datetime(2020, 1, 1, 10, 0, 6):
+            schedule.resume("maint")
+            # rescheduled from now: no immediate catch-up run
+            schedule.run_pending()
+            assert job1.call_count == 0
+        with mock_datetime(2020, 1, 1, 10, 0, 8):
+            schedule.run_pending()
+            assert job1.call_count == 1
+            assert job2.call_count == 1
+
+    def test_pause_and_resume_all(self):
+        job = make_mock_job()
+        with mock_datetime(2020, 1, 1, 10, 0, 0):
+            every().second.do(job)
+            schedule.pause()
+        with mock_datetime(2020, 1, 1, 10, 0, 5):
+            schedule.run_pending()
+            assert job.call_count == 0
+            schedule.resume()
+        with mock_datetime(2020, 1, 1, 10, 0, 8):
+            schedule.run_pending()
+            assert job.call_count == 1
+
+    def test_resume_unpaused_job_keeps_schedule(self):
+        with mock_datetime(2020, 1, 1, 10, 0, 0):
+            j = every().minute.do(make_mock_job())
+            next_run = j.next_run
+        with mock_datetime(2020, 1, 1, 10, 0, 30):
+            schedule.resume()
+        assert j.next_run == next_run
+
+    def test_pause_unknown_tag_is_noop(self):
+        j = every().second.do(make_mock_job()).tag("a")
+        schedule.pause("nope")
+        assert not j.paused
+
     def test_clear_by_tag(self):
