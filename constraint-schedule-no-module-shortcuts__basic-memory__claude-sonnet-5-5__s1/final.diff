+    def get_jobs_for(self, func: Callable) -> List["Job"]:
+        """
+        Gets scheduled jobs that run the given function, so they can be
+        inspected or cancelled without keeping references to the Job objects.
+
+        :param func: The function that was passed to :meth:`Job.do`. Bound
+                     methods are matched by equality.
+        """
+        return [
+            job
+            for job in self.jobs
+            if job.job_func is not None and job.job_func.func == func
+        ]
+
+    def pause(self, tag: Optional[Hashable] = None) -> None:
+        """
+        Pauses jobs marked with the given tag, or all jobs if tag is
+        omitted. Paused jobs stay scheduled but are skipped by
+        :meth:`run_pending` until :meth:`resume` is called.
+        (:meth:`run_all` still runs them.)
+
+        :param tag: An identifier used to identify a subset of
+                    jobs to pause
+        """
+        logger.debug('Pausing jobs tagged "%s"', tag)
+        for job in self.get_jobs(tag):
+            job.paused = True
+
+    def resume(self, tag: Optional[Hashable] = None) -> None:
+        """
+        Resumes paused jobs marked with the given tag, or all jobs if tag
+        is omitted. Resumed jobs are rescheduled from now, so runs missed
+        while paused are not made up for.
+
+        :param tag: An identifier used to identify a subset of
+                    jobs to resume
+        """
+        logger.debug('Resuming jobs tagged "%s"', tag)
+        for job in self.get_jobs(tag):
+            if job.paused:
+                job.paused = False
+                job._schedule_next_run()
+
