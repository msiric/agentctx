@@ -122,24 +123,50 @@ class JSONStorage(Storage):
     def close(self) -> None:
         self._handle.close()
 
+    def _read_contents(self):
+        # Always read the file itself: other processes may have changed it, and
+        # file metadata (mtime, size) is not a reliable change indicator.
+        self._handle.seek(0)
+        return self._handle.read()
+
     def read(self) -> Optional[dict[str, dict[str, Any]]]:
-        # Get the file size by moving the cursor to the file end and reading
-        # its location
-        self._handle.seek(0, os.SEEK_END)
-        size = self._handle.tell()
+        # Returns a freshly parsed object the caller may modify freely.
+        contents = self._read_contents()
 
-        if not size:
+        if not contents:
             # File is empty, so we return ``None`` so TinyDB can properly
             # initialize the database
             return None
-        else:
-            # Return the cursor to the beginning of the file
-            self._handle.seek(0)
 
-            # Load the JSON contents of the file
-            return json.load(self._handle)
+        return json.loads(contents)
+
+    def read_shared(self) -> Optional[dict[str, dict[str, Any]]]:
+        """
+        Like :meth:`read`, but skips parsing if the file's contents are
+        identical to the last time they were parsed.
+
+        The returned object is shared between calls and **must not be
+        modified**. Whether the file changed is decided by comparing its
+        contents, so changes made by other processes are always picked up.
+        """
+        contents = self._read_contents()
+
+        if not contents:
+            self._cached = None
+            return None
+
+        cached = self._cached
+        if cached is not None and cached[0] == contents:
+            return cached[1]
+
+        data = json.loads(contents)
+        self._cached = (contents, data)
+        return data
 
     def write(self, data: dict[str, dict[str, Any]]):
+        # The cached parse is stale after a write
+        self._cached = None
+
         # Move the cursor to the beginning of the file just in case
         self._handle.seek(0)
 
