+        # Cache of the last raw file contents and their parsed form. Whether
+        # the file changed is decided by comparing the contents themselves,
+        # not stat data like mtime (too coarse on NFS, other processes write
+        # to the same file).
+        self._cached_raw = None
+        self._cached_data = None
+
     def close(self) -> None:
         self._handle.close()
 
@@ -136,10 +143,26 @@ class JSONStorage(Storage):
             # Return the cursor to the beginning of the file
             self._handle.seek(0)
 
-            # Load the JSON contents of the file
-            return json.load(self._handle)
+            # Reading the raw contents is cheap compared to parsing them, so
+            # always read the file and only skip the JSON parsing if the
+            # contents are identical to what we parsed last time
+            raw = self._handle.read()
+
+            if self._cached_raw is None or raw != self._cached_raw:
+                self._cached_data = None
+                self._cached_raw = None
+                data = json.loads(raw)
+                self._cached_raw = raw
+                self._cached_data = data
+
+            return self._cached_data
 
     def write(self, data: dict[str, dict[str, Any]]):
+        # The caller may have mutated the object returned by ``read`` and the
+        # file is about to change, so drop the cache
+        self._cached_raw = None
+        self._cached_data = None
+
         # Move the cursor to the beginning of the file just in case
         self._handle.seek(0)
 
