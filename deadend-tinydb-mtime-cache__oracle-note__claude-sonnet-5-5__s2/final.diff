new file mode 100644
index 0000000..30156b0
--- /dev/null
+++ b/scripts/bench_read.py
@@ -0,0 +1,86 @@
+"""Benchmark TinyDB read performance on a large JSON db file.
+
+Usage: python scripts/bench_read.py [--size-mb 40] [--keep PATH]
+"""
+import argparse
+import cProfile
+import json
+import os
+import pstats
+import random
+import tempfile
+import time
+
+from tinydb import TinyDB, where
+
+
+def generate(path, target_mb):
+    rng = random.Random(0)
+    docs, size, i = {}, 0, 0
+    target = target_mb * 1024 * 1024
+    while size < target:
+        i += 1
+        doc = {
+            'name': f'user{i}',
+            'age': rng.randint(18, 90),
+            'city': rng.choice(['Berlin', 'Paris', 'Rome', 'Oslo', 'Wien']),
+            'tags': [rng.choice('abcdefgh') for _ in range(5)],
+            'bio': ''.join(rng.choices('abcdefghij klmnop', k=200)),
+        }
+        docs[str(i)] = doc
+        size += len(json.dumps(doc)) + 8
+    with open(path, 'w') as f:
+        json.dump({'_default': docs}, f)
+    return len(docs)
+
+
+def timed(label, fn, repeat=3):
+    times = []
+    for _ in range(repeat):
+        t = time.perf_counter()
+        result = fn()
+        times.append(time.perf_counter() - t)
+    print(f'{label:<34} best {min(times)*1000:9.1f} ms  '
+          f'(runs: {", ".join(f"{x*1000:.0f}" for x in times)})')
+    return result
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--size-mb', type=float, default=40)
+    ap.add_argument('--keep', help='reuse/keep db file at this path')
+    args = ap.parse_args()
+
+    path = args.keep or os.path.join(tempfile.mkdtemp(), 'bench.json')
+    if not (args.keep and os.path.exists(path)):
+        n = generate(path, args.size_mb)
+        print(f'generated {n} docs')
+    print(f'file: {path} ({os.path.getsize(path)/1e6:.1f} MB)\n')
+
+    with open(path) as f:
+        raw = f.read()
+    timed('raw read() of file', lambda: open(path).read())
+    timed('json.loads (pure parse floor)', lambda: json.loads(raw))
+
+    db = TinyDB(path)
+    timed('storage.read() (seek + json.load)', db.storage.read)
+    timed('db.all()', db.all)
+    q = where('age') > 80
+    # Equal queries hash equal, so vary the threshold to bypass the cache
+    thresholds = iter(range(70, 90))
+    timed('search (uncached)', lambda: db.search(where('age') > next(thresholds)))
+    db.search(q)
+    timed('search (cache hit)', lambda: db.search(q))
+    timed('len(db)', lambda: len(db))
+
+    print('\ncProfile of one uncached search (top by tottime):')
+    pr = cProfile.Profile()
+    pr.enable()
+    db.search(where('city') == 'Rome')
+    pr.disable()
+    pstats.Stats(pr).sort_stats('tottime').print_stats(6)
+    db.close()
+
+
+if __name__ == '__main__':
+    main()
