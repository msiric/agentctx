index 43e101e..1391877 100644
--- a/src/semver/cli.py
+++ b/src/semver/cli.py
@@ -11,6 +11,7 @@ The result of each command is printed on stdout.
 """
 
 import argparse
+import json
 import sys
 from typing import cast, List, Optional
 
@@ -83,6 +84,51 @@ def cmd_nextver(args: argparse.Namespace) -> str:
     return str(version.next_version(args.part))
 
 
+def _read_versions(args: argparse.Namespace) -> List[Version]:
+    """
+    Parse the versions given as arguments, or from stdin if there are none.
+    Blank lines on stdin are ignored.
+    """
+    raw = args.versions
+    if not raw:
+        raw = [line.strip() for line in sys.stdin if line.strip()]
+    return [Version.parse(v) for v in raw]
+
+
+def cmd_latest(args: argparse.Namespace) -> str:
+    """
+    Subcommand: Print the highest version that is not a prerelease.
+
+    Synopsis: latest [<VERSION>...]
+
+    If no version is given, versions are read from stdin, one per line.
+    The result is JSON: the version as a string, or ``null`` if there is
+    no non-prerelease version.
+
+    :param args: The parsed arguments
+    """
+    stable = [v for v in _read_versions(args) if not v.prerelease]
+    return json.dumps(str(max(stable)) if stable else None)
+
+
+def cmd_sort(args: argparse.Namespace) -> Optional[str]:
+    """
+    Subcommand: Sort versions, oldest first, one per line.
+
+    Synopsis: sort [<VERSION>...]
+
+    If no version is given, versions are read from stdin, one per line.
+    Blank lines are ignored.
+
+    :param args: The parsed arguments
+    """
+    versions = sorted(_read_versions(args))
+    if not versions:
+        # Print nothing at all, not even an empty line
+        return None
+    return "\n".join(str(v) for v in versions)
+
+
 def createparser() -> argparse.ArgumentParser:
     """
     Create an :class:`argparse.ArgumentParser` instance.
@@ -133,6 +179,27 @@ def createparser() -> argparse.ArgumentParser:
     parser_nextver.add_argument(
         "part", help="One of 'major', 'minor', 'patch', or 'prerelease'"
     )
+
+    # Create the sort subcommand
+    parser_sort = s.add_parser(
+        "sort", help="Sorts versions, oldest first, one per line"
+    )
+    parser_sort.set_defaults(func=cmd_sort)
+    parser_sort.add_argument("versions",
+        nargs="*",
+        help="Versions to sort (read from stdin, one per line, if omitted)",
+    )
+
+    # Create the latest subcommand
+    parser_latest = s.add_parser(
+        "latest", help="Prints the highest version that is not a prerelease"
+    )
+    parser_latest.set_defaults(func=cmd_latest)
+    parser_latest.add_argument(
+        "versions",
+        nargs="*",
+        help="Versions to check (read from stdin, one per line, if omitted)",
+    )
     return parser
 
 
diff --git a/tests/test_pysemver-cli.py b/tests/test_pysemver-cli.py
index 9933b0d..5c7ff88 100644
--- a/tests/test_pysemver-cli.py
+++ b/tests/test_pysemver-cli.py
@@ -1,3 +1,4 @@
+import io
 from argparse import Namespace
 from contextlib import contextmanager
 from unittest.mock import patch
@@ -155,3 +156,98 @@ def test_should_return_documented_error_code_for_invalid_version(cliargs, capsys
     # docs/pysemver.rst shows ``echo $?`` printing 2 for both commands
     assert main(cliargs) == 2
     assert capsys.readouterr().err.startswith("ERROR")
+
+
+def test_sort_prints_one_version_per_line_oldest_first(capsys):
+    assert main(["sort", "1.10.0", "1.2.0", "1.2.0-rc.1", "0.9.9+build"]) == 0
+    out = capsys.readouterr()
+    assert out.out == "0.9.9+build\n1.2.0-rc.1\n1.2.0\n1.10.0\n"
+    assert out.err == ""
+
+
+def test_sort_single_version(capsys):
+    assert main(["sort", "1.2.3"]) == 0
+    assert capsys.readouterr().out == "1.2.3\n"
+
+
+def test_sort_without_versions_prints_nothing(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO(""))
+    assert main(["sort"]) == 0
+    assert capsys.readouterr().out == ""
+
+
+def test_sort_invalid_version_prints_nothing_on_stdout(capsys):
+    assert main(["sort", "1.2.3", "2.4"]) == 2
+    out = capsys.readouterr()
+    assert out.out == ""
+    assert out.err.startswith("ERROR")
+
+
+def test_sort_reads_stdin_when_no_arguments(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO("1.10.0\n\n  \n1.2.0\n1.2.0-rc.1"))
+    assert main(["sort"]) == 0
+    out = capsys.readouterr()
+    assert out.out == "1.2.0-rc.1\n1.2.0\n1.10.0\n"
+    assert out.err == ""
+
+
+def test_sort_stdin_only_blank_lines_prints_nothing(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO("\n\n"))
+    assert main(["sort"]) == 0
+    assert capsys.readouterr().out == ""
+
+
+def test_sort_stdin_invalid_version_is_error(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO("1.2.3\n2.4\n"))
+    assert main(["sort"]) == 2
+    out = capsys.readouterr()
+    assert out.out == ""
+    assert out.err.startswith("ERROR")
+
+
+def test_sort_arguments_take_precedence_over_stdin(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO("9.9.9\n"))
+    assert main(["sort", "2.0.0", "1.0.0"]) == 0
+    assert capsys.readouterr().out == "1.0.0\n2.0.0\n"
+
+
+def test_latest_prints_highest_non_prerelease_as_json(capsys):
+    assert main(["latest", "1.2.0", "2.0.0-rc.1", "1.10.0", "1.9.0"]) == 0
+    out = capsys.readouterr()
+    assert out.out == '"1.10.0"\n'
+    assert out.err == ""
+
+
+def test_latest_keeps_build_metadata(capsys):
+    assert main(["latest", "1.0.0", "1.0.1+build"]) == 0
+    assert capsys.readouterr().out == '"1.0.1+build"\n'
+
+
+def test_latest_only_prereleases_prints_null(capsys):
+    assert main(["latest", "1.0.0-rc.1", "2.0.0-alpha"]) == 0
+    assert capsys.readouterr().out == "null\n"
+
+
+def test_latest_reads_stdin_when_no_arguments(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO("1.2.0\n\n3.0.0-rc.1\n1.10.0\n"))
+    assert main(["latest"]) == 0
+    assert capsys.readouterr().out == '"1.10.0"\n'
+
+
+def test_latest_empty_stdin_prints_null(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO(""))
+    assert main(["latest"]) == 0
+    assert capsys.readouterr().out == "null\n"
+
+
+def test_latest_arguments_take_precedence_over_stdin(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO("9.9.9\n"))
+    assert main(["latest", "1.0.0"]) == 0
+    assert capsys.readouterr().out == '"1.0.0"\n'
+
+
+def test_latest_invalid_version_is_error(capsys):
+    assert main(["latest", "1.2.3", "2.4"]) == 2
+    out = capsys.readouterr()
+    assert out.out == ""
+    assert out.err.startswith("ERROR")
