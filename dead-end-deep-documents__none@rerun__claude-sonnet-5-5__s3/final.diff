@@ -655,3 +655,24 @@ if __name__ == '__main__':  # pragma: no cover
             handle_item([], root)
     except KeyboardInterrupt:
         pass
+
+
+def drop_keys(doc, names):
+    """Return a copy of a parsed document with every key in `names` removed
+    at any depth (attribute keys such as '@id' included).
+
+    The input is not mutated. Dicts and lists are rebuilt; other values are
+    shared. A bare string for `names` is treated as a single key.
+    """
+    if isinstance(names, (str, bytes)):
+        names = (names,)
+    names = frozenset(names)
+
+    def _drop(value):
+        if isinstance(value, dict):
+            return {k: _drop(v) for k, v in value.items() if k not in names}
+        if isinstance(value, list):
+            return [_drop(v) for v in value]
+        return value
+
+    return _drop(doc)
