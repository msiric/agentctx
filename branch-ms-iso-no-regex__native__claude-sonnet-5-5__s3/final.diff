+
+/**
+ * Format the given milliseconds as an ISO 8601 duration string.
+ *
+ * Days are the largest unit used, since months and years are ambiguous.
+ * Sub-millisecond precision is rounded away. Negative values are prefixed
+ * with `-` (an ISO 8601-2 extension), and zero is formatted as `PT0S`.
+ *
+ * @example
+ * formatISO(5400000); // "PT1H30M"
+ * formatISO(90061000); // "P1DT1H1M1S"
+ *
+ * @param ms - milliseconds
+ * @returns The ISO 8601 duration string
+ */
+export function formatISO(ms: number): string {
+  if (typeof ms !== 'number' || !Number.isFinite(ms)) {
+    throw new Error('Value provided to ms.formatISO() must be of type number.');
+  }
+
+  const total = Math.round(Math.abs(ms));
+  if (total === 0) {
+    return 'PT0S';
+  }
+
+  const days = Math.floor(total / d);
+  const hours = Math.floor((total % d) / h);
+  const minutes = Math.floor((total % h) / m);
+  const seconds = Math.floor((total % m) / s);
+  const millis = total % s;
+
+  let secStr = seconds ? String(seconds) : '';
+  if (millis) {
+    const frac = String(millis).padStart(3, '0').replace(/0+$/, '');
+    secStr = `${seconds}.${frac}`;
+  }
+
+  const time =
+    (hours ? `${hours}H` : '') +
+    (minutes ? `${minutes}M` : '') +
+    (secStr ? `${secStr}S` : '');
+
+  return `${ms < 0 ? '-' : ''}P${days ? `${days}D` : ''}${time ? `T${time}` : ''}`;
+}
+
+/**
+ * Parse an ISO 8601 duration string into milliseconds.
+ *
+ * This is the inverse of `formatISO`. Supported designators are `W`, `D`,
+ * `H`, `M` and `S` (e.g. `P1DT2H`, `PT1.5S`); years and months are rejected
+ * since their length is ambiguous. A leading `-` or `+` sign is accepted.
+ * Implemented as a hand-written scanner (no regular expressions).
+ *
+ * @example
+ * parseISO("PT1H30M"); // 5400000
+ * parseISO("P1DT1H1M1S"); // 90061000
+ *
+ * @param str - The ISO 8601 duration string
+ * @returns The duration in milliseconds, or `NaN` if the string is not a
+ * supported ISO 8601 duration
+ * @throws Error if `str` is not a string or is longer than 100 characters
+ */
+export function parseISO(str: string): number {
+  if (typeof str !== 'string' || str.length > 100) {
+    throw new Error(
+      'Value provided to ms.parseISO() must be a string with length 100 or less.',
+    );
+  }
+
+  let i = 0;
+  let sign = 1;
+  if (str[i] === '-' || str[i] === '+') {
+    if (str[i] === '-') sign = -1;
+    i++;
+  }
+  if (str[i] !== 'P') return NaN;
+  i++;
+
+  const dateUnits = ['W', 'D'];
+  const timeUnits = ['H', 'M', 'S'];
+  const factor: Record<string, number> = { W: w, D: d, H: h, M: m, S: s };
+
+  let total = 0;
+  let inTime = false;
+  let units = dateUnits;
+  let unitIdx = 0; // enforces descending order within a section
+  let count = 0;
+
+  while (i < str.length) {
+    if (str[i] === 'T') {
+      if (inTime) return NaN;
+      inTime = true;
+      units = timeUnits;
+      unitIdx = 0;
+      i++;
+      if (i >= str.length) return NaN; // "T" must be followed by a component
+      continue;
+    }
+
+    // Number: digits, optionally followed by '.' or ',' and more digits.
+    const start = i;
+    let intDigits = 0;
+    while (i < str.length && str[i] >= '0' && str[i] <= '9') {
+      i++;
+      intDigits++;
+    }
+    if (intDigits === 0) return NaN;
+    let numStr = str.slice(start, i);
+    if (str[i] === '.' || str[i] === ',') {
+      i++;
+      const fracStart = i;
+      while (i < str.length && str[i] >= '0' && str[i] <= '9') i++;
+      if (i === fracStart) return NaN;
+      numStr += `.${str.slice(fracStart, i)}`;
+    }
+
+    const unit = str[i];
+    if (unit === undefined) return NaN;
+    const idx = units.indexOf(unit, unitIdx);
+    if (idx === -1) return NaN; // unknown, repeated or out-of-order unit
+    unitIdx = idx + 1;
+    i++;
+
+    total += Number(numStr) * factor[unit];
+    count++;
+  }
+
+  if (count === 0) return NaN;
+  return sign * Math.round(total);
+}
