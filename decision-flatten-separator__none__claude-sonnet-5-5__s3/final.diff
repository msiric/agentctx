+    def test_to_dict_with_nested_lists(self):
+        prop = self.dict_class(a=[[{'b': 1}], ({'c': 2},)])
+        regular = prop.to_dict()
+        self.assertEqual(regular, {'a': [[{'b': 1}], ({'c': 2},)]})
+        self.assertIs(type(regular['a'][0][0]), dict)
+        self.assertIs(type(regular['a'][1][0]), dict)
+
+    def test_flatten(self):
+        d = self.dict_class({'a': {'b': {'c': 1}, 'd': [{'e': 2}]}, 'f': 3})
+        flat = d.flatten()
+        self.assertEqual(flat, {'a.b.c': 1, 'a.d': [{'e': 2}], 'f': 3})
+        self.assertIs(type(flat), dict)
+
+    def test_flatten_sep_and_non_string_keys(self):
+        d = self.dict_class({'a': {1: {'b': 2}}})
+        self.assertEqual(d.flatten(sep='/'), {'a/1/b': 2})
+
+    def test_flatten_empty(self):
+        self.assertEqual(self.dict_class().flatten(), {})
+        d = self.dict_class({'a': {}, 'b': {'c': {}}})
+        self.assertEqual(d.flatten(), {'a': {}, 'b.c': {}})
+
+    def test_flatten_does_not_mutate(self):
+        d = self.dict_class({'a': {'b': 1}})
+        d.flatten()
+        self.assertEqual(d, {'a': {'b': 1}})
+
