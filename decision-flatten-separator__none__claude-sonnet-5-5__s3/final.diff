@@ -75,17 +75,33 @@ class Dict(dict):
         del self[name]
 
     def to_dict(self):
-        base = {}
-        for key, value in self.items():
-            if isinstance(value, type(self)):
-                base[key] = value.to_dict()
-            elif isinstance(value, (list, tuple)):
-                base[key] = type(value)(
-                    item.to_dict() if isinstance(item, type(self)) else
-                    item for item in value)
-            else:
-                base[key] = value
-        return base
+        def unwrap(value):
+            if isinstance(value, Dict):
+                return value.to_dict()
+            if isinstance(value, (list, tuple)):
+                return type(value)(unwrap(item) for item in value)
+            return value
+
+        return {key: unwrap(value) for key, value in self.items()}
+
+    def flatten(self, sep='.'):
+        """Return a plain dict with one entry per leaf value, keyed by the
+        path of nested keys joined with `sep`. Lists and other non-dict
+        values are leaves; empty nested dicts are kept as leaves too."""
+        flat = {}
+
+        def walk(node, prefix):
+            for key, value in node.items():
+                path = prefix + sep + str(key) if prefix is not None \
+                    else str(key)
+                if isinstance(value, dict) and value:
+                    walk(value, path)
+                else:
+                    flat[path] = (value.to_dict()
+                                  if isinstance(value, Dict) else value)
+
+        walk(self, None)
+        return flat
 
     def copy(self):
         return copy.copy(self)
