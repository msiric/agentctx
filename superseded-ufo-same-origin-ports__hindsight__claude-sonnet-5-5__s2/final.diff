@@ -773,3 +784,55 @@ export function withoutHost(input: string) {
   const parsed = parseURL(input);
   return (parsed.pathname || "/") + parsed.search + parsed.hash;
 }
+
+const SPECIAL_PROTOCOLS = new Set([
+  "http:",
+  "https:",
+  "ws:",
+  "wss:",
+  "ftp:",
+  "file:",
+]);
+
+function parseOrigin(input: unknown) {
+  if (typeof input !== "string" || !input) {
+    return;
+  }
+  const raw = input.replace(/[\t\n\r]/g, "").trim();
+  let url: URL;
+  try {
+    url = new URL(raw);
+  } catch {
+    return;
+  }
+  // Non-special schemes (data:, mailto:, ...) have opaque origins
+  if (!SPECIAL_PROTOCOLS.has(url.protocol)) {
+    return;
+  }
+  // `URL#port` drops default ports, so detect an explicit port in the raw authority
+  const authority = raw.replace(/^[^:]+:[/\\]{2}/, "").split(/[/\\?#]/)[0];
+  const explicitPort = /:\d+$/.test(
+    authority.slice(authority.lastIndexOf("@") + 1),
+  );
+  return `${url.protocol}//${url.hostname}:${url.port}${explicitPort ? "!" : ""}`;
+}
+
+/**
+ * Checks if two URLs have the same origin (scheme, host and port).
+ *
+ * Ports are compared strictly: an explicit default port (`:443`) is not equal to an omitted one.
+ * Path, query, hash and userinfo are ignored. Relative, opaque (`data:`, `mailto:`...) and invalid inputs return `false`.
+ *
+ * @example
+ *
+ * ```js
+ * isSameOrigin("https://example.com/a", "https://example.com/b"); // true
+ * isSameOrigin("https://example.com", "https://example.com:443"); // false
+ * ```
+ *
+ * @group utils
+ */
+export function isSameOrigin(a: string, b: string): boolean {
+  const originA = parseOrigin(a);
+  return !!originA && originA === parseOrigin(b);
+}
