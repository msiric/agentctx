diff --git a/test/same-origin.test.ts b/test/same-origin.test.ts
new file mode 100644
index 0000000..d870090
--- /dev/null
+++ b/test/same-origin.test.ts
@@ -0,0 +1,125 @@
+import { describe, expect, test } from "vitest";
+import { isSameOrigin } from "../src";
+
+// Origin is scheme + host + port, loosely following the WHATWG URL `origin`,
+// except that ports are compared strictly: no default-port normalization.
+// Path, query, hash and userinfo are ignored.
+describe("isSameOrigin", () => {
+  const sameOrigin = [
+    // Identical
+    ["https://example.com", "https://example.com"],
+    // Path, query and hash do not matter
+    ["https://example.com", "https://example.com/"],
+    ["https://example.com/foo", "https://example.com/bar"],
+    ["https://example.com/foo?a=1", "https://example.com/bar?b=2"],
+    ["https://example.com/#a", "https://example.com/#b"],
+    // Userinfo does not matter
+    ["https://user:pass@example.com/", "https://example.com/"],
+    // Scheme and host are case-insensitive
+    ["HTTPS://EXAMPLE.COM", "https://example.com"],
+    // Identical explicit ports match each other
+    ["https://example.com:443/a", "https://example.com:443/b"],
+    ["https://example.com:8443/a", "https://example.com:8443/b"],
+    // IDN / punycode hosts
+    ["https://münchen.de", "https://xn--mnchen-3ya.de"],
+    // Trailing dot is NOT normalised by WHATWG, see notSameOrigin
+    // IPv4 / IPv6
+    ["http://127.0.0.1:3000/a", "http://127.0.0.1:3000/b"],
+    ["http://[::1]:3000/a", "http://[::1]:3000/b"],
+    // Non-http special schemes
+    ["file:///a", "file:///b"],
+  ];
+
+  const notSameOrigin = [
+    // Scheme differs
+    ["http://example.com", "https://example.com"],
+    ["ws://example.com", "wss://example.com"],
+    // Host differs
+    ["https://example.com", "https://example.org"],
+    ["https://example.com", "https://www.example.com"],
+    ["https://example.com", "https://example.com."],
+    // Subdomain lookalikes / userinfo tricks
+    ["https://example.com", "https://example.com.evil.com"],
+    ["https://example.com", "https://example.com@evil.com"],
+    // Strict ports: no default-port normalization. An explicit port is never
+    // equal to an omitted one, even when it is the scheme's default.
+    ["https://example.com", "https://example.com:443"],
+    ["http://example.com", "http://example.com:80"],
+    ["ws://example.com", "ws://example.com:80"],
+    ["wss://example.com", "wss://example.com:443"],
+    // Port differs
+    ["https://example.com", "https://example.com:8443"],
+    ["https://example.com:443", "http://example.com:443"],
+    ["http://example.com:80", "https://example.com:80"],
+    ["http://localhost:3000", "http://localhost:4000"],
+    // IP vs hostname
+    ["http://localhost", "http://127.0.0.1"],
+  ];
+
+  for (const [a, b] of sameOrigin) {
+    test(`${a} == ${b}`, () => {
+      expect(isSameOrigin(a, b)).toBe(true);
+      expect(isSameOrigin(b, a)).toBe(true);
+    });
+  }
+
+  for (const [a, b] of notSameOrigin) {
+    test(`${a} != ${b}`, () => {
+      expect(isSameOrigin(a, b)).toBe(false);
+      expect(isSameOrigin(b, a)).toBe(false);
+    });
+  }
+
+  describe("relative and protocol-relative inputs", () => {
+    test("two relative URLs are not comparable", () => {
+      expect(isSameOrigin("/foo", "/bar")).toBe(false);
+      expect(isSameOrigin("/foo", "/foo")).toBe(false);
+      expect(isSameOrigin("", "")).toBe(false);
+    });
+
+    test("relative vs absolute is false", () => {
+      expect(isSameOrigin("/foo", "https://example.com/foo")).toBe(false);
+      expect(isSameOrigin("https://example.com/foo", "/foo")).toBe(false);
+    });
+
+    test("protocol-relative URLs are not comparable without a base", () => {
+      expect(isSameOrigin("//example.com/a", "//example.com/b")).toBe(false);
+      expect(isSameOrigin("//example.com", "https://example.com")).toBe(false);
+    });
+  });
+
+  describe("opaque origins", () => {
+    // Per spec these origins are opaque and never equal, even to themselves.
+    test("non-hierarchical schemes are never same-origin", () => {
+      expect(isSameOrigin("data:text/plain,a", "data:text/plain,a")).toBe(
+        false,
+      );
+      expect(isSameOrigin("javascript:void(0)", "javascript:void(0)")).toBe(
+        false,
+      );
+      expect(isSameOrigin("mailto:a@example.com", "mailto:a@example.com")).toBe(
+        false,
+      );
+    });
+  });
+
+  describe("invalid input", () => {
+    test("does not throw and returns false", () => {
+      expect(isSameOrigin("http://", "http://")).toBe(false);
+      expect(isSameOrigin("https://exa mple.com", "https://exa mple.com")).toBe(
+        false,
+      );
+      expect(
+        isSameOrigin("https://example.com:99999", "https://example.com"),
+      ).toBe(false);
+    });
+
+    test("empty or non-string input returns false", () => {
+      expect(isSameOrigin("", "https://example.com")).toBe(false);
+      // @ts-expect-error invalid input
+      expect(isSameOrigin(undefined, "https://example.com")).toBe(false);
+      // @ts-expect-error invalid input
+      expect(isSameOrigin("https://example.com", null)).toBe(false);
+    });
+  });
+});
