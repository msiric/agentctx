@@ -139,6 +152,28 @@ function combineRanges (ranges) {
   return combined
 }
 
+/**
+ * Collapse ranges into one range from the lowest start to the highest end.
+ * @private
+ */
+
+function spanRanges (ranges) {
+  var start = ranges[0].start
+  var end = ranges[0].end
+
+  for (var i = 1; i < ranges.length; i++) {
+    start = Math.min(start, ranges[i].start)
+    end = Math.max(end, ranges[i].end)
+  }
+
+  var spanned = [{ start: start, end: end }]
+
+  // copy ranges type
+  spanned.type = ranges.type
+
+  return spanned
+}
