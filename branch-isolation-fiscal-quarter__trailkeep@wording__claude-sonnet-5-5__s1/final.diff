+var DAYS = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
+
 var MAP = {
 	YYYY: 'getFullYear',
 	YY: 'getYear',
 	MM: function (d) {
 		return d.getMonth() + 1;
 	},
+	MMM: function (d) {
+		return MONTHS[d.getMonth()];
+	},
+	Q: function (d) {
+		// Australian financial year: Jul-Sep is Q1, Oct-Dec Q2, Jan-Mar Q3, Apr-Jun Q4
+		return Math.floor(((d.getMonth() + 6) % 12) / 3) + 1;
+	},
 	DD: 'getDate',
+	ddd: function (d) {
+		return DAYS[d.getDay()];
