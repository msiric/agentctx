+
+test('parseBytes: plain numbers and bytes', t => {
+	t.is(parseBytes('0'), 0);
+	t.is(parseBytes('512'), 512);
+	t.is(parseBytes('512 B'), 512);
+	t.is(parseBytes('512B'), 512);
+	t.is(parseBytes('512\u00A0B'), 512);
+	t.is(parseBytes('.5'), 0.5);
+});
+
+test('parseBytes: binary units', t => {
+	for (const [exponent, unit] of BINARY_UNITS.entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1024 ** exponent);
+		t.is(parseBytes(`2${unit}`), 2 * (1024 ** exponent));
+	}
+
+	t.is(parseBytes('1.5 KiB'), 1536);
+	t.is(parseBytes('0.5 MiB'), 524_288);
+	t.is(parseBytes('1 YiB'), 2 ** 80);
+});
+
+test('parseBytes: signs', t => {
+	t.is(parseBytes('-1 KiB'), -1024);
+	t.is(parseBytes('+1 KiB'), 1024);
+});
+
+test('parseBytes: round-trips binary prettyBytes output', t => {
+	for (const value of [0, 1, 512, 1024, 1536, 10_240, 1024 ** 3]) {
+		t.is(parseBytes(prettyBytes(value, {binary: true})), value);
+	}
+});
+
+test('parseBytes: units are case-sensitive', t => {
+	for (const input of ['1 kib', '1 KIB', '1 kiB', '1 b', '1 Kib']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError});
+	}
+});
+
+test('parseBytes: units without an `i` are powers of 1024', t => {
+	for (const [exponent, unit] of DECIMAL_UNITS.entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1024 ** exponent);
+		t.is(parseBytes(`2${unit}`), 2 * (1024 ** exponent));
+	}
+
+	t.is(parseBytes('1 KB'), 1024);
+	t.is(parseBytes('1.5 MB'), 1_572_864);
+	t.is(parseBytes('1 MB'), parseBytes('1 MiB'));
+});
+
+test('parseBytes: units without an `i` are case-sensitive', t => {
+	for (const input of ['1 mb', '1 Mb', '1 kb', '1 gB', '1 Kb']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError, message: /Unsupported unit/});
+	}
+});
+
+test('parseBytes: invalid input', t => {
+	for (const input of ['', ' ', 'KiB', 'abc', '1,5 KiB', '1e3', '1. KiB', '1 2 KiB', ' 1 KiB', '1 KiB ', '--1', '1 K iB', 'Infinity', 'NaN']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError}, `input: ${JSON.stringify(input)}`);
+	}
+
+	for (const input of [1, undefined, null, {}, 1n]) {
+		t.throws(() => parseBytes(input), {instanceOf: TypeError});
+	}
+});
