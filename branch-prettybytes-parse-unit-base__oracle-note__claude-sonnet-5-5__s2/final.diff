@@ -216,3 +216,28 @@ export default function prettyBytes(
 	number: number | bigint,
 	options?: Options
 ): string;
+
+/**
+Parse a byte string back into a number of bytes.
+
+Supports plain numbers (`'512'`), bytes (`'512 B'`), the binary units `KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`, `ZiB`, and `YiB`, and the units without an `i` (`kB`, `KB`, `MB`, `GB`, `TB`, `PB`, `EB`, `ZB`, and `YB`). All units are powers of 1024, so `1 MB` is `1_048_576`, matching how sizes are shown by Windows Explorer. Note that this differs from `prettyBytes`, which uses powers of 1000 for these units unless `binary` is set. Fractional values are allowed, the space before the unit is optional, and a leading `+` or `-` is accepted. Units are case-sensitive.
+
+@param string - The string to parse.
+@returns The number of bytes.
+@throws A `TypeError` if the input is not a string, and a `SyntaxError` if it is not a valid byte string or uses an unknown unit.
+
+@example
+```
+import {parseBytes} from 'pretty-bytes';
+
+parseBytes('512');
+//=> 512
+
+parseBytes('1.5 KiB');
+//=> 1536
+
+parseBytes('1 MB');
+//=> 1048576
+```
+*/
+export function parseBytes(string: string): number;
diff --git a/index.js b/index.js
index c5f37ab..9a6936b 100644
--- a/index.js
+++ b/index.js
@@ -285,3 +285,37 @@ export default function prettyBytes(number, options) {
 	const result = prefix + numberString + separator + UNITS[exponent];
 	return result.padStart(options.fixedWidth ?? 0);
 }
+
+// Units without an `i` (`kB`/`KB`, `MB`, …) are read as powers of 1024, since that is how sizes are usually pasted from file managers like Windows Explorer.
+const PARSE_UNIT_EXPONENTS = new Map([
+	...BIBYTE_UNITS.map((unit, exponent) => [unit, exponent]),
+	...BYTE_UNITS.map((unit, exponent) => [unit, exponent]),
+	['KB', 1],
+]);
+const PARSE_PATTERN = /^(?<sign>[+-]?)(?<value>\d+(?:\.\d+)?|\.\d+)[ \u00A0]*(?<unit>[A-Za-z]+)?$/;
+
+/*
+The reverse of `prettyBytes`. Both the binary (`KiB` … `YiB`) and the `i`-less (`kB`/`KB`, `MB` … `YB`) units are read as powers of 1024.
+*/
+export function parseBytes(string) {
+	if (typeof string !== 'string') {
+		throw new TypeError(`Expected a string, got ${typeof string}: ${string}`);
+	}
+
+	const match = PARSE_PATTERN.exec(string);
+
+	if (!match) {
+		throw new SyntaxError(`Invalid byte string: ${JSON.stringify(string)}`);
+	}
+
+	const {sign, value, unit = 'B'} = match.groups;
+	const exponent = PARSE_UNIT_EXPONENTS.get(unit);
+
+	if (exponent === undefined) {
+		throw new SyntaxError(`Unsupported unit ${JSON.stringify(unit)} in ${JSON.stringify(string)}, expected one of: ${[...PARSE_UNIT_EXPONENTS.keys()].join(', ')}`);
+	}
+
+	const result = Number(value) * (1024 ** exponent);
+
+	return sign === '-' ? -result : result;
+}
