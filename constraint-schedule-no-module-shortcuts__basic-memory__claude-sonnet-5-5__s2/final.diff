diff --git a/test_schedule.py b/test_schedule.py
index f497826..4cdbb66 100644
--- a/test_schedule.py
+++ b/test_schedule.py
@@ -1569,6 +1569,70 @@ class SchedulerTests(TestCase):
         schedule.clear()
         assert len(schedule.jobs) == 0
 
+    def test_get_jobs_for(self):
+        def foo():
+            pass
+
+        def bar(x):
+            pass
+
+        s = schedule.default_scheduler
+        j1 = every().second.do(foo)
+        j2 = every().minute.do(foo)
+        j3 = every().second.do(bar, 1)
+        j4 = every().second.do(bar, 2)
+
+        assert s.get_jobs_for(foo) == [j1, j2]
+        assert s.get_jobs_for(bar) == [j3, j4]
+        assert s.get_jobs_for(lambda: None) == []
+
+        # Jobs can be cancelled via the lookup
+        for job in s.get_jobs_for(foo):
+            s.cancel_job(job)
+        assert s.get_jobs_for(foo) == []
+        assert s.get_jobs() == [j3, j4]
+
+    def test_get_jobs_for_unset_job_func(self):
+        job = every().second
+        job.scheduler.jobs.append(job)  # job_func is None
+        assert job.scheduler.get_jobs_for(print) == []
+
+    def test_pause_and_resume_by_tag(self):
+        mock_a = make_mock_job(name="a")
+        mock_b = make_mock_job(name="b")
+        with mock_datetime(2024, 1, 1, 12, 0, 0):
+            every().hour.do(mock_a).tag("maint")
+            every().hour.do(mock_b).tag("other")
+            schedule.pause("maint")
+            assert [j.paused for j in schedule.jobs] == [True, False]
+        with mock_datetime(2024, 1, 1, 13, 0, 1):
+            schedule.run_pending()
+            assert mock_a.call_count == 0
+            assert mock_b.call_count == 1
+            schedule.resume("maint")
+            # rescheduled relative to now: no catch-up run
+            schedule.run_pending()
+            assert mock_a.call_count == 0
+        with mock_datetime(2024, 1, 1, 14, 0, 1):
+            schedule.run_pending()
+            assert mock_a.call_count == 1
+
+    def test_pause_unknown_tag_is_noop(self):
+        every().hour.do(make_mock_job()).tag("x")
+        schedule.pause("nope")
+        schedule.resume("nope")
+        assert not schedule.jobs[0].paused
+
+    def test_paused_jobs_ignored_by_next_run(self):
+        with mock_datetime(2024, 1, 1, 12, 0, 0):
+            every().hour.do(make_mock_job()).tag("slow")
+            every().minute.do(make_mock_job()).tag("fast")
+            schedule.pause("fast")
+            assert schedule.next_run() == datetime.datetime(2024, 1, 1, 13, 0, 0)
+            schedule.pause("slow")
+            assert schedule.next_run() is None
+            assert schedule.idle_seconds() is None
+
     def test_clear_by_tag(self):
