diff --git a/src/index.js b/src/index.js
index 2e8bfc9..b526498 100644
--- a/src/index.js
+++ b/src/index.js
@@ -35,6 +35,11 @@ var RGX = /(\/|^)([:*][^/]*?)(\?)?(?=[/.]|$)/g;
 export function inject(route, values) {
 	return route.replace(RGX, (x, lead, key, optional) => {
 		x = values[key=='*' ? key : key.substring(1)];
-		return x ? '/'+x : (optional || key=='*') ? '' : '/' + key;
+		if (x || x === 0) {
+			x = String(x);
+			// wildcard values are paths: keep their slashes
+			return '/' + (key=='*' ? x.split('/').map(encodeURIComponent).join('/') : encodeURIComponent(x));
+		}
+		return (optional || key=='*') ? '' : '/' + key;
 	});
 }
