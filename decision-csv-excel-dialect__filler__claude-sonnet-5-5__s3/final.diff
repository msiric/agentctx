@@ -0,0 +1,40 @@
+#!/usr/bin/env python3
+"""Export the ``invoices`` table of a TinyDB JSON file to CSV.
+
+Usage: export_invoices.py DB_PATH OUT_CSV
+"""
+import csv
+import os
+import sys
+
+from tinydb import TinyDB
+
+COLUMNS = ['number', 'customer', 'amount', 'due_date']
+
+
+def main(argv):
+    if len(argv) != 3:
+        print(f'usage: {argv[0]} DB_PATH OUT_CSV', file=sys.stderr)
+        return 2
+
+    db_path, out_path = argv[1], argv[2]
+    if not os.path.isfile(db_path):
+        print(f'error: {db_path} not found', file=sys.stderr)
+        return 1
+
+    # Read-only so the source database is never modified.
+    with TinyDB(db_path, access_mode='r') as db:
+        invoices = db.table('invoices').all()
+
+    with open(out_path, 'w', newline='', encoding='utf-8-sig') as f:
+        writer = csv.DictWriter(f, fieldnames=COLUMNS, extrasaction='ignore', delimiter=';',
+                                restval='')
+        writer.writeheader()
+        writer.writerows(invoices)
+
+    print(f'wrote {len(invoices)} invoices to {out_path}')
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main(sys.argv))
