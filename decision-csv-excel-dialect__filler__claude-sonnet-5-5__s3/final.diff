     assert len(table) == 1
     assert table.all() == [{'a': 1}]
     db.close()
+
+
+def test_to_csv_default_fields(db, tmp_path):
+    import csv
+
+    table = db.table('csv')
+    table.insert({'a': 1, 'b': 'x'})
+    table.insert({'b': 'y', 'c': 3})
+
+    path = tmp_path / 'out.csv'
+    table.to_csv(path)
+
+    with open(path, newline='', encoding='utf-8') as f:
+        rows = list(csv.reader(f))
+
+    assert rows == [['a', 'b', 'c'], ['1', 'x', ''], ['', 'y', '3']]
+
+
+def test_to_csv_fields_select_and_order(db, tmp_path):
+    import csv
+
+    table = db.table('csv')
+    table.insert({'a': 1, 'b': 'x', 'c': 3})
+    table.insert({'a': 2})
+
+    path = tmp_path / 'out.csv'
+    table.to_csv(path, fields=['c', 'a', 'missing'])
+
+    with open(path, newline='', encoding='utf-8') as f:
+        rows = list(csv.reader(f))
+
+    assert rows == [['c', 'a', 'missing'], ['3', '1', ''], ['', '2', '']]
+
+
+def test_to_csv_empty_table(db, tmp_path):
+    table = db.table('empty')
+    path = tmp_path / 'out.csv'
+    table.to_csv(path, fields=['a', 'b'])
+
+    assert path.read_text(encoding='utf-8').splitlines() == ['a,b']
+
+
+def test_to_csv_quoting(db, tmp_path):
+    import csv
+
+    table = db.table('csv')
+    table.insert({'a': 'x,y', 'b': 'line1\nline2'})
+
+    path = tmp_path / 'out.csv'
+    table.to_csv(path)
+
+    with open(path, newline='', encoding='utf-8') as f:
+        rows = list(csv.reader(f))
+
+    assert rows[1] == ['x,y', 'line1\nline2']
