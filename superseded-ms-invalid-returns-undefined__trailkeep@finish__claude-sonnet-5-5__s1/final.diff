+/**
+ * Parse a compound duration such as `"1h 30m"`, `"1h, 30m"` or `"2 days 4 hours"` and
+ * return the total in milliseconds. Each piece is parsed with `parse`.
+ *
+ * @param str - A string made of one or more `<number><unit>` pieces
+ * @returns The total in milliseconds
+ * @throws TypeError if `str` is not a non-empty string of valid pieces (never
+ * returns `NaN`)
+ */
+export function parseCompound(str: string): number {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw new TypeError(
+      `Value provided to ms.parseCompound() must be a string with length between 1 and 99. value=${JSON.stringify(str)}`,
+    );
+  }
+  const piece = / *(-?\d*\.?\d+ *[a-z]+)(?: *,(?= *[-.\d]))? */iy;
+  let total = 0;
+  while (piece.lastIndex < str.length) {
+    const match = piece.exec(str);
+    const value = match ? parse(match[1] as string) : NaN;
+    if (Number.isNaN(value)) {
+      throw new TypeError(
+        `Value provided to ms.parseCompound() is not a valid compound duration. value=${JSON.stringify(str)}`,
+      );
+    }
+    total += value;
+  }
+  return total;
+}
+
+/**
+ * Parse a timer-style clock string and return the total in milliseconds.
+ * `"1:30"` is m:ss and `"01:02:03"` is h:mm:ss. Seconds (and minutes, when
+ * hours are present) must be two digits and below 60.
+ *
+ * @param str - A clock string such as `"1:30"` or `"01:02:03"`
+ * @returns The total in milliseconds, or `undefined` if `str` is invalid
+ * (never throws and never returns `NaN`)
+ */
+export function parseClock(str: string): number | undefined {
+  if (typeof str !== 'string' || str.length > 100) {
+    return undefined;
+  }
+  const match = /^(?:(\d+):([0-5]\d)|(\d+):([0-5]\d):([0-5]\d))$/.exec(str);
+  if (!match) {
+    return undefined;
+  }
+  const [h, m, s] =
+    match[3] !== undefined
+      ? [Number(match[3]), Number(match[4]), Number(match[5])]
+      : [0, Number(match[1]), Number(match[2])];
+  return ((h * 60 + m) * 60 + s) * 1000;
+}
