+import { describe, expect, it } from '@jest/globals';
+import { parse, parseCompound } from './index';
+
+describe('parseCompound(string)', () => {
+  it('should parse short compound durations', () => {
+    expect(parseCompound('1h 30m')).toBe(90 * 60 * 1000);
+  });
+
+  it('should parse long compound durations with spaces', () => {
+    expect(parseCompound('2 days 4 hours')).toBe(parse('2d') + parse('4h'));
+  });
+
+  it('should parse pieces without separators', () => {
+    expect(parseCompound('1h30m15s')).toBe(5415000);
+  });
+
+  it('should accept commas between pieces', () => {
+    expect(parseCompound('1h, 30m')).toBe(5400000);
+    expect(parseCompound('1h,30m')).toBe(5400000);
+    expect(parseCompound('2 days , 4 hours')).toBe(parse('2d') + parse('4h'));
+  });
+
+  it('should reject misplaced commas', () => {
+    for (const input of ['1h,', ',1h', '1h,,30m', '1h, ,30m', ',']) {
+      expect(() => parseCompound(input)).toThrow(TypeError);
+    }
+  });
+
+  it('should handle a single piece like parse', () => {
+    expect(parseCompound('5m')).toBe(parse('5m'));
+  });
+
+  it('should handle decimals and negatives', () => {
+    expect(parseCompound('1.5h 30m')).toBe(2 * 3600000);
+    expect(parseCompound('-1h 30m')).toBe(-1800000);
+  });
+
+  it('should be case insensitive and tolerate outer spaces', () => {
+    expect(parseCompound(' 1H 30M ')).toBe(5400000);
+  });
+
+  it('should throw a TypeError including the input for invalid input', () => {
+    for (const input of ['abc', '1h foo', '1h 30', '1x 30m', '   ', '']) {
+      expect(() => parseCompound(input)).toThrow(TypeError);
+      expect(() => parseCompound(input)).toThrow(JSON.stringify(input));
+    }
+  });
+
+  it('should throw a TypeError for non-string or too long input', () => {
+    expect(() => parseCompound('1h '.repeat(40))).toThrow(TypeError);
+    // @ts-expect-error testing runtime behavior
+    expect(() => parseCompound(5)).toThrow(TypeError);
+  });
+});
