+import { describe, expect, it } from '@jest/globals';
+import { parseClock } from './index';
+
+describe('parseClock(string)', () => {
+  it('should parse m:ss', () => {
+    expect(parseClock('1:30')).toBe(90_000);
+    expect(parseClock('0:05')).toBe(5_000);
+    expect(parseClock('00:00')).toBe(0);
+    expect(parseClock('90:00')).toBe(5_400_000);
+  });
+
+  it('should parse h:mm:ss', () => {
+    expect(parseClock('01:02:03')).toBe(3_723_000);
+    expect(parseClock('1:00:00')).toBe(3_600_000);
+    expect(parseClock('100:59:59')).toBe(363_599_000);
+  });
+
+  it('should return undefined for invalid input', () => {
+    for (const input of [
+      '',
+      '1',
+      '1:5',
+      '1:60',
+      '1:60:00',
+      '1:5:00',
+      '1:00:60',
+      '1:2:3:4',
+      ':30',
+      '1:',
+      '-1:30',
+      '1:30.5',
+      ' 1:30',
+      '1:30 ',
+      '1:30\n',
+      'a:bc',
+      '1h',
+    ]) {
+      expect(parseClock(input)).toBeUndefined();
+    }
+  });
+
+  it('should return undefined for non-strings and overlong input', () => {
+    for (const input of [undefined, null, 90, {}, []]) {
+      expect(parseClock(input as unknown as string)).toBeUndefined();
+    }
+    expect(parseClock(`${'1'.repeat(100)}:30`)).toBeUndefined();
+  });
+
+  it('should never throw or return NaN', () => {
+    for (const input of ['x', `${'9'.repeat(50)}:99`, '::']) {
+      expect(() => parseClock(input)).not.toThrow();
+      expect(parseClock(input)).not.toBeNaN();
+    }
+  });
+});
