index 0000000..1096b96
--- /dev/null
+++ b/scripts/bench_read.py
@@ -0,0 +1,97 @@
+"""
+Benchmark TinyDB read performance on a large JSON db file.
+
+Usage: python scripts/bench_read.py [--size-mb 40] [--repeat 5] [--path FILE]
+"""
+import argparse
+import cProfile
+import json
+import os
+import pstats
+import random
+import sys
+import tempfile
+import time
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))
+
+from tinydb import TinyDB, where  # noqa: E402
+
+
+def generate(path, size_mb):
+    rnd = random.Random(0)
+    target = size_mb * 1024 * 1024
+    docs, size, i = {}, 0, 0
+    while size < target:
+        i += 1
+        doc = {'name': f'user{i}', 'age': rnd.randint(18, 90),
+               'city': rnd.choice(['Berlin', 'Paris', 'Rome', 'Oslo']),
+               'tags': [rnd.choice('abcdefgh') for _ in range(5)],
+               'bio': ''.join(rnd.choices('abcdefghij ', k=100))}
+        docs[str(i)] = doc
+        size += len(json.dumps(doc)) + 8
+    with open(path, 'w') as f:
+        json.dump({'_default': docs}, f)
+    return len(docs)
+
+
+def timeit(label, fn, repeat):
+    times = []
+    for _ in range(repeat):
+        t = time.perf_counter()
+        fn()
+        times.append(time.perf_counter() - t)
+    print(f'{label:<34} min {min(times)*1000:9.1f} ms   '
+          f'avg {sum(times)/len(times)*1000:9.1f} ms')
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--size-mb', type=int, default=40)
+    ap.add_argument('--repeat', type=int, default=5)
+    ap.add_argument('--path')
+    ap.add_argument('--profile', action='store_true')
+    a = ap.parse_args()
+
+    tmp = None
+    path = a.path
+    if not path:
+        tmp = tempfile.TemporaryDirectory()
+        path = os.path.join(tmp.name, 'big.json')
+        n = generate(path, a.size_mb)
+        print(f'generated {n} docs')
+    print(f'file size: {os.path.getsize(path)/1024/1024:.1f} MB\n')
+
+    with TinyDB(path) as db:
+        def raw():
+            with open(path) as f:
+                json.load(f)
+
+        counter = iter(range(10**6))
+
+        def search_fresh():
+            # distinct threshold each call -> distinct cache key -> cache miss
+            db.search(where('age') > next(counter) % 1000 + 1000)
+
+        q = where('age') > 80
+
+        timeit('json.load (floor)', raw, a.repeat)
+        timeit('storage.read()', db.storage.read, a.repeat)
+        timeit('db.all()', db.all, a.repeat)
+        timeit('db.search (uncached)', search_fresh, a.repeat)
+        db.search(q)
+        timeit('db.search (query cache hit)', lambda: db.search(q), a.repeat)
+        timeit('db.get(doc_id=1)', lambda: db.get(doc_id=1), a.repeat)
+
+        if a.profile:
+            pr = cProfile.Profile()
+            pr.enable()
+            db.search(where('age') > -1)
+            pr.disable()
+            pstats.Stats(pr).sort_stats('cumulative').print_stats(8)
+    if tmp:
+        tmp.cleanup()
+
+
+if __name__ == '__main__':
+    main()
