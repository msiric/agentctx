+import { describe, expect, it } from '@jest/globals';
+import { parseCompound } from './index';
+
+describe('parseCompound(string)', () => {
+  it('should parse compact pieces', () => {
+    expect(parseCompound('1h 30m')).toBe(5400000);
+  });
+
+  it('should parse pieces with spaced long units', () => {
+    expect(parseCompound('2 days 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
+  });
+
+  it('should parse a single piece like parse does', () => {
+    expect(parseCompound('1m')).toBe(60000);
+    expect(parseCompound('100')).toBe(100);
+  });
+
+  it('should handle mixed styles, extra whitespace and decimals', () => {
+    expect(parseCompound('  1d   2 h 0.5s ')).toBe(86400000 + 7200000 + 500);
+  });
+
+  it('should accept commas between parts', () => {
+    expect(parseCompound('1h, 30m')).toBe(5400000);
+    expect(parseCompound('1h,30m')).toBe(5400000);
+    expect(parseCompound('2 days, 4 hours , 1m')).toBe(
+      2 * 86400000 + 4 * 3600000 + 60000,
+    );
+  });
+
+  it('should support negative pieces', () => {
+    expect(parseCompound('1h -30m')).toBe(1800000);
+  });
+
+  it('should throw a TypeError including the input on invalid pieces', () => {
+    for (const bad of ['abc', '1h foo', '1 2', 'h', ',', '1h,', ',1h', '1h,,30m']) {
+      expect(() => parseCompound(bad)).toThrow(TypeError);
+      expect(() => parseCompound(bad)).toThrow(JSON.stringify(bad));
+    }
+  });
+
+  it('should throw a TypeError on empty, blank, too long, or non-string input', () => {
+    expect(() => parseCompound('')).toThrow(TypeError);
+    expect(() => parseCompound('   ')).toThrow(TypeError);
+    expect(() => parseCompound('1m '.repeat(40))).toThrow(TypeError);
+    // @ts-expect-error testing runtime behavior
+    expect(() => parseCompound(5)).toThrow(TypeError);
+  });
+});
