+/**
+ * Parse a compound duration such as `"1h 30m"` or `"2 days 4 hours"` and
+ * return the total in milliseconds. Each piece is parsed with `parse`.
+ *
+ * @param str - A string of one or more durations separated by whitespace
+ * and/or commas
+ * @returns The summed value in milliseconds
+ * @throws TypeError if `str` is not a non-empty string of at most 99
+ * characters, or if any piece can't be parsed
+ */
+export function parseCompound(str: string): number {
+  const fail = (): never => {
+    throw new TypeError(
+      `Value provided to ms.parseCompound() must be a string of valid durations such as "1h 30m". value=${JSON.stringify(str)}`,
+    );
+  };
+  if (typeof str !== 'string' || str.length > 100 || str.trim() === '') {
+    return fail();
+  }
+  let total = 0;
+  // Parts may optionally be separated by commas: "1h, 30m".
+  for (const segment of str.split(',')) {
+    if (segment.trim() === '') {
+      return fail();
+    }
+    const tokens = segment.trim().split(/\s+/);
+    for (let i = 0; i < tokens.length; i++) {
+      let piece = tokens[i] as string;
+      // A bare number followed by a unit word, e.g. "2 days", is one piece.
+      if (/^-?\d*\.?\d+$/.test(piece) && i + 1 < tokens.length) {
+        piece += ` ${tokens[++i]}`;
+      }
+      const value = parse(piece);
+      if (Number.isNaN(value)) {
+        return fail();
+      }
+      total += value;
+    }
+  }
+  return total;
+}
+
+/**
+ * Parse a timer-style string, `"m:ss"` (e.g. `"1:30"`) or `"h:mm:ss"`
+ * (e.g. `"01:02:03"`), and return milliseconds. Seconds may have a fractional
+ * part (`"1:30.5"`).
+ *
+ * @param str - A clock-style string
+ * @returns The value in milliseconds, or `undefined` if the input isn't a
+ * valid clock string
+ */
+export function parseClock(str: string): number | undefined {
+  if (typeof str !== 'string' || str.length > 100) {
+    return undefined;
+  }
+  const match = /^(?:(\d+):)?(\d+):(\d{2}(?:\.\d+)?)$/.exec(str);
+  if (!match) {
+    return undefined;
+  }
+  const hasHours = match[1] !== undefined;
+  const minutes = Number(match[2]);
+  const seconds = Number(match[3]);
+  // With an hours field, minutes must be 0-59 and two digits ("1:5:00" is
+  // not a clock time). Seconds are always 0-59.
+  if (seconds >= 60 || (hasHours && (match[2]!.length !== 2 || minutes >= 60))) {
+    return undefined;
+  }
+  const total = (Number(match[1] ?? 0) * 60 + minutes) * 60 + seconds;
+  return Math.round(total * 1000);
+}
