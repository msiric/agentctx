diff --git a/tests/test_storages.py b/tests/test_storages.py
index 6e433a1..6f39a58 100644
--- a/tests/test_storages.py
+++ b/tests/test_storages.py
@@ -285,3 +285,99 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def test_json_write_is_atomic_on_crash(tmpdir, monkeypatch):
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+
+    # Simulate the process dying right before the new file is swapped in
+    def crash(*args, **kwargs):
+        raise KeyboardInterrupt('simulated kill')
+
+    monkeypatch.setattr(os, 'replace', crash)
+
+    db = TinyDB(path)
+    with pytest.raises(KeyboardInterrupt):
+        db.insert({'b': 2})
+    monkeypatch.undo()
+
+    # No partial file, no leftover temp files, old state intact
+    assert os.listdir(str(tmpdir)) == ['db.json']
+    with TinyDB(path) as db2:
+        assert db2.all() == [{'a': 1}]
+
+
+def test_json_write_crash_mid_write(tmpdir, monkeypatch):
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+
+    real_fsync = os.fsync
+
+    def crash(fd):
+        raise OSError('simulated crash during write')
+
+    monkeypatch.setattr(os, 'fsync', crash)
+    db = TinyDB(path)
+    with pytest.raises(OSError):
+        db.insert({'b': 2})
+    monkeypatch.setattr(os, 'fsync', real_fsync)
+
+    with TinyDB(path) as db2:
+        assert db2.all() == [{'a': 1}]
+
+
+def test_json_write_serialization_error_keeps_file(tmpdir):
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+        with pytest.raises(TypeError):
+            db.insert({'b': object()})
+
+    with TinyDB(path) as db2:
+        assert db2.all() == [{'a': 1}]
+
+
+def test_json_write_keeps_working_after_many_writes(tmpdir):
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path) as db:
+        for i in range(5):
+            db.insert({'i': i})
+        db.remove(where('i') > 1)
+        assert len(db) == 2
+
+    with TinyDB(path) as db2:
+        assert [r['i'] for r in db2.all()] == [0, 1]
+    assert os.listdir(str(tmpdir)) == ['db.json']
+
+
+@pytest.mark.skipif(os.name == 'nt', reason='POSIX permissions')
+def test_json_write_preserves_permissions(tmpdir):
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+        os.chmod(path, 0o640)
+        db.insert({'b': 2})
+
+    assert os.stat(path).st_mode & 0o777 == 0o640
+
+
+def test_json_write_through_symlink(tmpdir):
+    real = tmpdir.join('real.json')
+    link = tmpdir.join('link.json')
+    real.write('')
+    os.symlink(str(real), str(link))
+
+    with TinyDB(str(link)) as db:
+        db.insert({'a': 1})
+
+    assert os.path.islink(str(link))
+    with TinyDB(str(real)) as db2:
+        assert db2.all() == [{'a': 1}]
