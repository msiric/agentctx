diff --git a/tests/test_tables.py b/tests/test_tables.py
index a94005e..8c0416e 100644
--- a/tests/test_tables.py
+++ b/tests/test_tables.py
@@ -197,3 +197,68 @@ def test_persist_empty_does_not_wipe_existing_data(tmpdir):
     assert len(table) == 1
     assert table.all() == [{'a': 1}]
     db.close()
+
+
+def read_csv(path):
+    import csv
+
+    with open(path, newline='', encoding='utf-8') as f:
+        return list(csv.reader(f))
+
+
+def test_to_csv_default_fields(db, tmp_path):
+    path = tmp_path / 'out.csv'
+    table = db.table('csv_default')
+    table.insert_multiple([
+        {'b': 1, 'a': 2},
+        {'a': 3, 'c': 4},
+    ])
+
+    table.to_csv(path)
+
+    # First-seen key order, missing values are empty cells
+    assert read_csv(path) == [
+        ['b', 'a', 'c'],
+        ['1', '2', ''],
+        ['', '3', '4'],
+    ]
+
+
+def test_to_csv_selected_fields(db, tmp_path):
+    path = tmp_path / 'out.csv'
+    table = db.table('csv_fields')
+    table.insert({'a': 1, 'b': 2, 'c': 3})
+
+    table.to_csv(path, fields=['c', 'a', 'missing'])
+
+    assert read_csv(path) == [['c', 'a', 'missing'], ['3', '1', '']]
+
+
+def test_to_csv_empty_table(db, tmp_path):
+    path = tmp_path / 'out.csv'
+
+    # No documents and no fields: just an empty header row
+    db.table('csv_empty').to_csv(path)
+    assert read_csv(path) == [[]]
+
+    db.table('csv_empty').to_csv(path, fields=['a', 'b'])
+    assert read_csv(path) == [['a', 'b']]
+
+
+def test_to_csv_quoting_and_unicode(db, tmp_path):
+    path = tmp_path / 'out.csv'
+    table = db.table('csv_quoting')
+    table.insert({'name': 'Müller, "Hans"\nJr.', 'n': None})
+
+    table.to_csv(path)
+
+    assert read_csv(path) == [['name', 'n'], ['Müller, "Hans"\nJr.', '']]
+
+
+def test_to_csv_str_path(db, tmp_path):
+    path = str(tmp_path / 'out.csv')
+
+    db.table('csv_str').insert({'a': 1})
+    db.table('csv_str').to_csv(path)
+
+    assert read_csv(path) == [['a'], ['1']]
