diff --git a/scripts/export_invoices.py b/scripts/export_invoices.py
new file mode 100644
index 0000000..7c199b3
--- /dev/null
+++ b/scripts/export_invoices.py
@@ -0,0 +1,47 @@
+#!/usr/bin/env python3
+"""Export the ``invoices`` table of a TinyDB JSON file to CSV.
+
+The output is semicolon-separated with a UTF-8 BOM so that Excel in a German
+locale opens it with the right columns and encoding.
+
+Usage: python scripts/export_invoices.py DB_PATH OUT_CSV
+"""
+import argparse
+import csv
+import os
+import sys
+
+from tinydb import TinyDB
+
+COLUMNS = ['number', 'customer', 'amount', 'due_date']
+
+
+def export_invoices(db_path, out_path):
+    with TinyDB(db_path) as db:
+        invoices = db.table('invoices').all()
+
+    with open(out_path, 'w', newline='', encoding='utf-8-sig') as f:
+        writer = csv.DictWriter(f, fieldnames=COLUMNS, extrasaction='ignore',
+                                delimiter=';')
+        writer.writeheader()
+        writer.writerows(invoices)
+
+    return len(invoices)
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument('db_path', metavar='DB_PATH')
+    parser.add_argument('out_csv', metavar='OUT_CSV')
+    args = parser.parse_args(argv)
+
+    # TinyDB would silently create a missing file; don't do that here.
+    if not os.path.isfile(args.db_path):
+        parser.error(f'database not found: {args.db_path}')
+
+    count = export_invoices(args.db_path, args.out_csv)
+    print(f'Wrote {count} invoices to {args.out_csv}')
+
+
+if __name__ == '__main__':
+    sys.exit(main())
