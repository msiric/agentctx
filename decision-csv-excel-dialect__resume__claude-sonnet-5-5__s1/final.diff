+    def to_csv(
+        self,
+        path: Union[str, 'PathLike[str]'],
+        fields: Optional[Iterable[str]] = None
+    ) -> None:
+        """
+        Export the table to a CSV file.
+
+        The first row is a header with the column names, followed by one row
+        per document. Values are written as returned by ``str()``, so nested
+        values (lists, dicts) end up as their Python representation. Missing
+        values become empty cells. The file is written as UTF-8 using the
+        default ``csv`` dialect.
+
+        :param path: the file to write (an existing file is overwritten)
+        :param fields: the keys to export, in column order. Keys of the
+                       documents that are not listed are skipped. Defaults to
+                       all top-level keys in the order they are first seen.
+        """
+
+        documents = self.all()
+
+        if fields is None:
+            # dict keys keep insertion order, giving us first-seen order
+            columns = list(dict.fromkeys(
+                key for document in documents for key in document
+            ))
+        else:
+            columns = list(fields)
+
+        with open(path, 'w', newline='', encoding='utf-8') as f:
+            writer = csv.DictWriter(
+                f, fieldnames=columns, restval='', extrasaction='ignore'
+            )
+            writer.writeheader()
+            writer.writerows(documents)
+
