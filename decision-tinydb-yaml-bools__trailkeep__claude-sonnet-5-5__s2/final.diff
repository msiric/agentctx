+
+    path = tmpdir.join('test.yaml')
+    path.write(
+        '_default:\n'
+        '  1:\n'
+        '    a: NO\n'
+        '    b: off\n'
+        '    c: yes\n'
+        '    d: On\n'
+        '    e: true\n'
+        '    f: false\n'
+        '    g: y\n'
+    )
+    storage = YAMLStorage(str(path))
+    item = storage.read()['_default'][1]
+    assert item == {'a': 'NO', 'b': 'off', 'c': 'yes', 'd': 'On',
+                    'e': True, 'f': False, 'g': 'y'}
+    storage.close()
+
+    # Global SafeLoader must be untouched
+    assert pyyaml.safe_load('a: no') == {'a': False}
