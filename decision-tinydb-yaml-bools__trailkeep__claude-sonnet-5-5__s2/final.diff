+def _make_yaml_loader():
+    """
+    Build a ``SafeLoader`` subclass that only resolves ``true``/``false`` as
+    booleans.
+
+    Plain YAML 1.1 loaders turn ``yes``, ``no``, ``on``, ``off`` (and friends)
+    into booleans, which silently corrupts hand-edited files. Here those stay
+    strings.
+    """
+    import yaml
+
+    class _StrictBoolLoader(yaml.SafeLoader):
+        pass
+
+    # Copy the resolver table so we don't touch the global SafeLoader
+    resolvers = {}
+    for first_char, entries in yaml.SafeLoader.yaml_implicit_resolvers.items():
+        kept = [(tag, regexp) for tag, regexp in entries
+                if tag != 'tag:yaml.org,2002:bool']
+        if kept:
+            resolvers[first_char] = kept
+    _StrictBoolLoader.yaml_implicit_resolvers = resolvers
+
+    _StrictBoolLoader.add_implicit_resolver(
+        'tag:yaml.org,2002:bool',
+        re.compile(r'^(?:true|false)$'),
+        list('tf')
+    )
+
+    return _StrictBoolLoader
+
+
+class YAMLStorage(_FileStorage):
+    """
+    Store the data in a YAML file.
+
+    Requires PyYAML. Only ``true`` and ``false`` are read as booleans; values
+    like ``yes``, ``no``, ``on`` and ``off`` are kept as strings.
+    """
+
+    def __init__(self, path: str, create_dirs=False, encoding='utf-8', access_mode='r+', **kwargs):
+        """
+        Create a new instance.
+
+        See :class:`_FileStorage` for the file handling arguments.
+
+        :param path: Where to store the YAML data.
+        :param kwargs: Extra arguments passed to ``yaml.safe_dump``.
+        """
+
+        try:
+            import yaml  # noqa: F401
+        except ImportError as e:
+            raise ImportError('YAMLStorage requires PyYAML (pip install pyyaml)') from e
+
+        super().__init__(path, create_dirs=create_dirs, encoding=encoding, access_mode=access_mode)
+
+        self.kwargs = kwargs
+        self._loader = _make_yaml_loader()
+
+    def read(self) -> Optional[dict[str, dict[str, Any]]]:
+        import yaml
+
+        self._handle.seek(0)
+        data = yaml.load(self._handle, Loader=self._loader)
+
+        # Empty (or comment-only) file
+        return data or None
+
+    def write(self, data: dict[str, dict[str, Any]]):
+        import yaml
+
+        self._handle.seek(0)
+
+        options = {'default_flow_style': False, 'allow_unicode': True, 'sort_keys': False}
+        options.update(self.kwargs)
+        serialized = yaml.safe_dump(data, **options)
+
+        try:
+            self._handle.write(serialized)
+        except io.UnsupportedOperation:
+            raise IOError('Cannot write to the database. Access mode is "{0}"'.format(self._mode))
+
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+        self._handle.truncate()
+
+
