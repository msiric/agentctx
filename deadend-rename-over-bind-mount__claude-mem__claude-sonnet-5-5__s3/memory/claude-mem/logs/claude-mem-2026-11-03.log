        # Serialize the database state using the user-provided arguments
        serialized = json.dumps(data, **self.kwargs)

        if not self._handle.writable():
            raise IOError('Cannot write to the database. Access mode is "{0}"'.format(self._mode))

        # Crash-safe write: write the new contents to a temporary file in the
        # same directory, flush it to disk and atomically rename it over the
        # original. A crash at any point leaves either the complete old file
        # or the complete new file, never a truncated one.
        directory = os.path.dirname(self._path) or '.'
        binary = 'b' in self._mode
        fd, tmp_path = tempfile.mkstemp(
            dir=directory, prefix=os.path.basename(self._path) + '.', suffix='.tmp'
        )
        try:
            with open(fd, 'wb' if binary else 'w',
                      **({} if binary else {'encoding': self._encoding})) as tmp:
                tmp.write(serialized.encode(self._encoding or 'utf-8') if binary else serialized)
                tmp.flush()
                os.fsync(tmp.fileno())

            # Keep the original file's permissions
            try:
                shutil.copymode(self._path, tmp_path)
            except OSError:
                pass

            os.replace(tmp_path, self._path)
        except BaseException:
            try:
                os.unlink(tmp_path)
            except OSError:
                pass
            raise

        # Persist the rename itself (not supported on all platforms)
        try:
            dir_fd = os.open(directory, os.O_RDONLY)
            try:
                os.fsync(dir_fd)
            finally:
                os.close(dir_fd)
        except OSError:
            pass

        # The old handle still points at the replaced file, so reopen it
        self._handle.close()
        self._handle = open(self._path, mode=self._mode, encoding=self._encoding)


'''
