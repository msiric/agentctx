def test_write_is_atomic_on_failure(tmpdir):
    path = str(tmpdir.join('db.json'))
    storage = JSONStorage(path)
    storage.write({'_default': {'1': {'a': 1}}})

    # Simulate a crash right before the atomic rename
    import os
    real_replace = os.replace

    def boom(*args, **kwargs):
        raise OSError('simulated crash')

    os.replace = boom
    try:
        with pytest.raises(OSError):
            storage.write({'_default': {'1': {'a': 2}}})
    finally:
        os.replace = real_replace

    # Old data intact, no temp files left behind, storage still usable
    assert storage.read() == {'_default': {'1': {'a': 1}}}
    assert os.listdir(str(tmpdir)) == ['db.json']
    storage.write({'_default': {'1': {'a': 3}}})
    assert storage.read() == {'_default': {'1': {'a': 3}}}
    storage.close()
EOF
