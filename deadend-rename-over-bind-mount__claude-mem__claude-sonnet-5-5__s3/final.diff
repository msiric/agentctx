+def test_json_crash_during_inplace_write_recovers_new_state(tmpdir, monkeypatch):
+    path = str(tmpdir.join('db.json'))
+    s = JSONStorage(path)
+    s.write({'_default': {'1': {'a': 1}}})
+
+    new = {'_default': {'1': {'a': 1}, '2': {'b': 'x' * 100}}}
+    boom = type('Boom', (BaseException,), {})
+    real = s._handle
+
+    class TornHandle:
+        def __getattr__(self, name):
+            return getattr(real, name)
+
+        def write(self, data):
+            real.write(data[:10])
+            real.truncate()
+            real.flush()
+            raise boom()
+
+    s._handle = TornHandle()
+    with pytest.raises(boom):
+        s.write(new)
+    # Simulate process death: the file really is torn now
+    with open(path) as f:
+        with pytest.raises(ValueError):
+            json.load(f)
+
+    db = TinyDB(path)
+    assert db.storage.read() == new
+    db.close()
+    assert not os.path.exists(path + '.journal')
+
+
+def test_json_crash_during_journal_write_keeps_old_state(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    old = {'_default': {'1': {'a': 1}}}
+    s = JSONStorage(path)
+    s.write(old)
+    s.close()
+
+    # Torn journal, main file untouched
+    with open(path + '.journal', 'w') as f:
+        f.write('{"_default": {"1": {"a"')
+
+    s = JSONStorage(path)
+    assert s.read() == old
+    s.close()
+    assert not os.path.exists(path + '.journal')
+
+
+def test_json_journal_leftover_after_complete_write_is_idempotent(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    new = {'_default': {'1': {'a': 2}}}
+    with open(path, 'w') as f:
+        f.write(json.dumps(new))
+    with open(path + '.journal', 'w') as f:
+        f.write(json.dumps(new))
+
+    s = JSONStorage(path)
+    assert s.read() == new
+    s.close()
+    assert not os.path.exists(path + '.journal')
+
+
+def test_json_no_journal_left_after_normal_write(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    s = JSONStorage(path)
+    s.write({'_default': {}})
+    assert not os.path.exists(path + '.journal')
+    s.close()
+
+
+def test_json_journal_disabled(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    with open(path + '.journal', 'w') as f:
+        f.write('{}')
+    s = JSONStorage(path, journal=False)
+    s.write({'_default': {}})
+    s.close()
+    assert os.path.exists(path + '.journal')  # untouched
+
+
+def test_json_journal_works_without_replacing_inode(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    s = JSONStorage(path)
+    ino = os.stat(path).st_ino
+    s.write({'_default': {'1': {'a': 1}}})
+    s.write({'_default': {}})
+    assert os.stat(path).st_ino == ino
+    s.close()
