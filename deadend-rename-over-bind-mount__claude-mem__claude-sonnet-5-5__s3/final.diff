+    def _recover(self, path: str) -> None:
+        """
+        Finish or discard a write that was interrupted by a crash.
+        """
+        try:
+            with open(self._journal_path, 'rb') as f:
+                raw = f.read()
+        except FileNotFoundError:
+            return
+
+        try:
+            json.loads(raw.decode(self._encoding or 'utf-8'))
+            complete = True
+        except ValueError:  # includes UnicodeDecodeError and JSONDecodeError
+            complete = False
+
+        if complete:
+            # Journal was fully written, but the in-place write may not have
+            # finished: redo it (idempotent).
+            with open(path, 'r+b') as f:
+                f.write(raw)
+                f.flush()
+                os.fsync(f.fileno())
+                f.truncate()
+        # else: the journal itself is torn, so the file was never touched.
+
+        os.remove(self._journal_path)
+        self._fsync_dir(self._journal_path)
+
+    @staticmethod
+    def _fsync_dir(path: str) -> None:
+        try:
+            fd = os.open(os.path.dirname(os.path.abspath(path)), os.O_RDONLY)
+        except OSError:  # e.g. platforms without directory fds
+            return
+        try:
+            os.fsync(fd)
+        finally:
