+class GzipJSONStorage(JSONStorage):
+    """
+    Store the data in a gzip-compressed JSON file.
+
+    Accepts the same arguments as :class:`JSONStorage`, except that the file is
+    always handled in binary mode (the default ``access_mode`` is ``'rb+'``).
+    """
+
+    def __init__(self, path: str, create_dirs=False, access_mode='rb+', **kwargs):
+        if 'b' not in access_mode:
+            raise ValueError('GzipJSONStorage requires a binary access mode, '
+                             'got "{0}"'.format(access_mode))
+
+        super().__init__(path, create_dirs=create_dirs, access_mode=access_mode, **kwargs)
+
+    def read(self) -> Optional[dict[str, dict[str, Any]]]:
+        self._handle.seek(0, os.SEEK_END)
+        if not self._handle.tell():
+            return None
+
+        self._handle.seek(0)
+        return json.loads(gzip.decompress(self._handle.read()).decode('utf-8'))
+
+    def write(self, data: dict[str, dict[str, Any]]):
+        # Serialize and compress completely *before* touching the file so a
+        # serialization error can't leave a half-written database behind
+        payload = gzip.compress(json.dumps(data, **self.kwargs).encode('utf-8'))
+
+        self._handle.seek(0)
+
+        try:
+            self._handle.write(payload)
+        except io.UnsupportedOperation:
+            raise IOError('Cannot write to the database. Access mode is "{0}"'.format(self._mode))
+
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+        self._handle.truncate()
+
+
