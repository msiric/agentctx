+def test_gzip_json(tmpdir):
+    from tinydb.storages import GzipJSONStorage
+    import gzip
+
+    path = str(tmpdir.join('db.json.gz'))
+    db = TinyDB(path, storage=GzipJSONStorage)
+    db.insert({'a': 1})
+    db.insert({'a': 2})
+    with pytest.raises(TypeError):
+        db.insert({'a': object()})
+    db.close()
+
+    with gzip.open(path, 'rt') as f:
+        assert json.load(f)['_default']['2'] == {'a': 2}
+
+    db = TinyDB(path, storage=GzipJSONStorage)
+    assert len(db) == 2
+    db.close()
