@@ -127,6 +127,21 @@ function format(value, options) {
   return str + unitSeparator + unit;
 }
 
+/**
+ * Truncate (toward zero) a number to the given decimal places.
+ * Pre-rounds at 10 extra digits to absorb floating-point noise.
+ *
+ * @private
+ */
+
+function truncate(val, places) {
+  var str = val.toFixed(Math.min(places + 10, 100));
+  if (places <= 0) {
+    return str.slice(0, str.indexOf('.'));
+  }
+  return str.slice(0, str.indexOf('.') + places + 1);
+}
