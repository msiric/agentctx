+def test_inprocess_jsonl_missing_value_is_dot():
+    """In-process: a jsonl record lacking a key renders as '.' (SAS loader)"""
+    out = run_main_in_process(
+        ["-r", "jsonl", "-f", "tsv"], input_text='{"a": 1, "b": 2}\n{"a": 3}\n'
+    )
+    assert out.splitlines()[-1].split("\t")[-1].strip() == "."
