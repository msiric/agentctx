--- a/test_schedule.py
+++ b/test_schedule.py
@@ -1597,3 +1597,42 @@ class SchedulerTests(TestCase):
         scheduler.every()
         scheduler.every(10).seconds
         scheduler.run_pending()
+
+
+class FailingJobsTest(TestCase):
+    def setUp(self):
+        schedule.clear()
+
+    def tearDown(self):
+        schedule.clear()
+
+    def _jobs(self):
+        calls = []
+
+        def bad():
+            calls.append("bad")
+            raise ValueError("boom")
+
+        def good():
+            calls.append("good")
+
+        schedule.every().second.do(bad)
+        schedule.every().second.do(good)
+        return calls
+
+    def test_run_pending_runs_other_jobs_then_raises_first(self):
+        calls = self._jobs()
+        with mock_datetime(2010, 1, 6, 12, 16, 0):
+            pass
+        with mock_datetime(2010, 1, 6, 12, 16, 5):
+            for job in schedule.jobs:
+                job.next_run = datetime.datetime(2010, 1, 6, 12, 16, 0)
+            with self.assertRaises(ValueError):
+                schedule.run_pending()
+        self.assertEqual(sorted(calls), ["bad", "good"])
+
+    def test_run_all_runs_other_jobs_then_raises_first(self):
+        calls = self._jobs()
+        with self.assertRaises(ValueError):
+            schedule.run_all()
+        self.assertEqual(calls, ["bad", "good"])
