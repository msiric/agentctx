+test('onRetry runs only before another attempt, not for the final failure', async () => {
+	const calls = [];
+	let attempts = 0;
+
+	await assert.rejects(pRetry(async () => {
+		attempts++;
+		throw new Error('fail');
+	}, {
+		retries: 2,
+		minTimeout: 0,
+		onFailedAttempt({attemptNumber}) {
+			calls.push(`failed ${attemptNumber}`);
+		},
+		onRetry({attemptNumber}) {
+			calls.push(`retry ${attemptNumber}`);
+		},
+	}), {message: 'fail'});
+
+	assert.equal(attempts, 3);
+	assert.deepEqual(calls, ['failed 1', 'retry 1', 'failed 2', 'retry 2', 'failed 3']);
+});
+
+test('onRetry gets the context and runs after shouldRetry, before the wait', async () => {
+	const order = [];
+	let retryContext;
+	let attempts = 0;
+
+	await pRetry(async () => {
+		attempts++;
+		order.push(`attempt ${attempts}`);
+		if (attempts === 1) {
+			throw new Error('fail');
+		}
+	}, {
+		minTimeout: 0,
+		shouldRetry() {
+			order.push('shouldRetry');
+			return true;
+		},
+		async onRetry(context) {
+			await delay(1);
+			order.push('onRetry');
+			retryContext = context;
+		},
+	});
+
+	assert.deepEqual(order, ['attempt 1', 'shouldRetry', 'onRetry', 'attempt 2']);
+	assert.equal(retryContext.attemptNumber, 1);
+	assert.equal(retryContext.error.message, 'fail');
+	assert.equal(retryContext.retriesLeft, 10);
+	assert.equal(retryContext.retriesConsumed, 0);
+	assert.ok(Object.isFrozen(retryContext));
+});
+
+test('onRetry is not called when no retry follows', async () => {
+	let called = 0;
+	const onRetry = () => {
+		called++;
+	};
+
+	await assert.rejects(pRetry(async () => {
+		throw new Error('fail');
+	}, {onRetry, shouldRetry: () => false}), {message: 'fail'});
+
+	await assert.rejects(pRetry(async () => {
+		throw new Error('fail');
+	}, {onRetry, retries: 0}), {message: 'fail'});
+
+	await assert.rejects(pRetry(async () => {
+		throw new TypeError('nope');
+	}, {onRetry}), {message: 'nope'});
+
+	await assert.rejects(pRetry(async () => {
+		throw new AbortError('stop');
+	}, {onRetry}), {message: 'stop'});
+
+	assert.equal(called, 0);
+});
+
+test('onRetry is called when shouldConsumeRetry returns false', async () => {
+	let called = 0;
+	let attempts = 0;
+
+	await pRetry(async () => {
