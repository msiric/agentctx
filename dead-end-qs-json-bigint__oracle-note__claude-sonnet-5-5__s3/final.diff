+	const filter = encodeURIComponent('{"a":[1,"b",null,true],"c":{"d":1.5}}');
+	assert.deepEqual(structuredClone(queryString.parse(`filter=${filter}&n=5&s=%22x%22`, {types: {filter: 'json', n: 'json', s: 'json'}})), {filter: {a: [1, 'b', null, true], c: {d: 1.5}}, n: 5, s: 'x'});
+});
+
+test('`json` type keeps a value that is not valid JSON as a string', () => {
+	assert.deepEqual(structuredClone(queryString.parse('a=%7Bnope&b=&c', {types: {a: 'json', b: 'json', c: 'json'}})), {a: '{nope', b: '', c: null});
+});
+
+test('`json` type does not round a 64-bit integer', () => {
+	const filter = encodeURIComponent('{"accountId":1274593846275813376,"ids":[-9223372036854775808,12],"f":1e30,"x":1.5}');
+	const {filter: result} = queryString.parse(`filter=${filter}`, {types: {filter: 'json'}});
+	assert.deepEqual(result, {
+		accountId: 1_274_593_846_275_813_376n,
+		ids: [-9_223_372_036_854_775_808n, 12],
+		f: 1e30,
+		x: 1.5,
+	});
+	assert.equal(queryString.parse('id=1274593846275813376', {types: {id: 'json'}}).id, 1_274_593_846_275_813_376n);
+});
+
+test('`json` type applies to each item of a repeated key and overrides `parseNumbers`', () => {
+	assert.deepEqual(structuredClone(queryString.parse('a=%5B1%5D&a=%7B%7D&b=007', {parseNumbers: true, types: {a: 'json', b: 'json'}})), {a: [[1], {}], b: '007'});
+});
