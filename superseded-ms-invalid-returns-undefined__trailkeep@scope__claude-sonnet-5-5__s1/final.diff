+/**
+ * Parse a compound duration such as `"1h 30m"`, `"1h, 30m"` or `"2 days 4 hours"` and
+ * return the total in milliseconds. Each piece is parsed with `parse`.
+ *
+ * @param str - A string made of one or more `<number><unit>` pieces
+ * @returns The total in milliseconds
+ * @throws TypeError if `str` is not a string of 1 to 99 characters or any part
+ * of it can't be parsed
+ */
+export function parseCompound(str: string): number {
+  const invalid = () =>
+    new TypeError(
+      `Value provided to ms.parseCompound() must be a compound duration like "1h 30m". value=${JSON.stringify(str)}`,
+    );
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw invalid();
+  }
+  const piece = /-?\d*\.?\d+ *[a-z]+/gi;
+  const pieces = str.match(piece);
+  // Pieces may be separated by whitespace, a single comma (with optional
+  // whitespace around it), or nothing at all.
+  const separators = str.split(piece);
+  const validSeparators = separators.every((sep, i) =>
+    i === 0 || i === separators.length - 1
+      ? /^\s*$/.test(sep)
+      : /^(?:\s*,\s*|\s*)$/.test(sep),
+  );
+  if (!pieces || !validSeparators) {
+    throw invalid();
+  }
+  let total = 0;
+  for (const p of pieces) {
+    const n = parse(p);
+    if (Number.isNaN(n)) {
+      throw invalid();
+    }
+    total += n;
+  }
+  return total;
+}
+
+/**
+ * Parse a timer-style clock string and return milliseconds. `"m:ss"` (e.g. `"1:30"`)
+ * and `"h:mm:ss"` (e.g. `"01:02:03"`) are supported. Minutes (when hours are
+ * present) and seconds must be 0-59 and written with two digits; seconds may
+ * have a fractional part.
+ *
+ * Unlike `parseCompound`, this returns `undefined` instead of throwing on bad input.
+ *
+ * @param str - A clock string
+ * @returns The total in milliseconds, or `undefined` if `str` isn't a valid clock string
+ */
+export function parseClock(str: string): number | undefined {
+  if (typeof str !== 'string' || str.length > 100) {
+    return undefined;
+  }
+  const match = /^(?:(\d+):([0-5]\d)|(\d+)):([0-5]\d(?:\.\d+)?)$/.exec(str);
+  if (!match) {
+    return undefined;
+  }
+  const [, hours, minutesWithHours, minutesOnly, seconds] = match;
+  if (hours !== undefined) {
+    return Number(hours) * h + Number(minutesWithHours) * m + Number(seconds) * s;
+  }
+  return Number(minutesOnly) * m + Number(seconds) * s;
+}
