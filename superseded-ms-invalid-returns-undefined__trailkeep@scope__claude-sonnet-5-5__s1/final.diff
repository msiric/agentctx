+import { describe, expect, it } from '@jest/globals';
+import { parseCompound } from './index';
+
+describe('parseCompound(string)', () => {
+  it('should sum short units', () => {
+    expect(parseCompound('1h 30m')).toBe(5400000);
+  });
+
+  it('should sum long units with spaces', () => {
+    expect(parseCompound('2 days 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
+  });
+
+  it('should allow pieces without separators', () => {
+    expect(parseCompound('1h30m15s')).toBe(3600000 + 1800000 + 15000);
+  });
+
+  it('should allow commas between pieces', () => {
+    expect(parseCompound('1h, 30m')).toBe(5400000);
+    expect(parseCompound('1h,30m')).toBe(5400000);
+    expect(parseCompound('2 days , 4 hours, 15s')).toBe(
+      2 * 86400000 + 4 * 3600000 + 15000,
+    );
+  });
+
+  it('should handle a single piece like parse', () => {
+    expect(parseCompound('1.5h')).toBe(5400000);
+  });
+
+  it('should be case insensitive', () => {
+    expect(parseCompound('1H 30M')).toBe(5400000);
+  });
+
+  it('should throw a TypeError including the input for bad values', () => {
+    for (const bad of ['', 'abc', '1h foo', '1h 30', '1h 30x', '   ', ',1h', '1h,', '1h,,30m', '1h, , 30m', ',']) {
+      expect(() => parseCompound(bad)).toThrow(TypeError);
+      expect(() => parseCompound(bad)).toThrow(JSON.stringify(bad));
+    }
+  });
+
+  it('should throw a TypeError for non-string or too long values', () => {
+    expect(() => parseCompound(1 as unknown as string)).toThrow(TypeError);
+    expect(() => parseCompound('1h '.repeat(40))).toThrow(TypeError);
+  });
+});
