+class Length:
+    """
+    Validates the length of a string, counting UTF-8 *bytes* (not characters).
+
+    Bounds are inclusive and either may be omitted. Bytes are counted because
+    the values are meant for storage with byte-based limits (e.g. Oracle
+    ``VARCHAR2(n BYTE)``), where accented characters take more than one byte.
+    ``bytes`` and ``bytearray`` values are measured as they are.
+    """
+
+    def __init__(
+        self,
+        min: Union[int, None] = None,
+        max: Union[int, None] = None,
+        error: Union[str, None] = None,
+    ) -> None:
+        for name, bound in (("min", min), ("max", max)):
+            if bound is None:
+                continue
+            if isinstance(bound, bool) or not isinstance(bound, int):
+                raise TypeError(f"Length {name} must be an int or None, not {bound!r}")
+            if bound < 0:
+                raise ValueError(f"Length {name} must not be negative, not {bound!r}")
+        if min is not None and max is not None and min > max:
+            raise ValueError(f"Length min ({min}) must not exceed max ({max})")
+        self._min: Union[int, None] = min
+        self._max: Union[int, None] = max
+        self._error: Union[str, None] = error
+
+    def __repr__(self) -> str:
+        return f"{self.__class__.__name__}(min={self._min!r}, max={self._max!r})"
+
+    @property
+    def min(self) -> Union[int, None]:
+        return self._min
+
+    @property
+    def max(self) -> Union[int, None]:
+        return self._max
+
+    def validate(self, data: Any, **kwargs: Any) -> Any:
+        """
+        Validates that the UTF-8 byte length of data is within the bounds.
+        :param data: String (or bytes) to be validated.
+        :return: Returns validated data.
+        """
+        if isinstance(data, str):
+            try:
+                size = len(data.encode("utf-8"))
+            except UnicodeEncodeError:  # e.g. lone surrogates
+                raise SchemaError(
+                    f"{data!r} cannot be encoded as UTF-8",
+                    self._error.format(data) if self._error else None,
+                )
+        elif isinstance(data, (bytes, bytearray)):
+            size = len(data)
+        else:
+            raise SchemaError(
+                f"{data!r} is not a string",
+                self._error.format(data) if self._error else None,
+            )
+
+        if self._min is not None and size < self._min:
+            message = f"{data!r} is {size} bytes long, expected at least {self._min} bytes"
+        elif self._max is not None and size > self._max:
+            message = f"{data!r} is {size} bytes long, expected at most {self._max} bytes"
+        else:
+            return data
+        raise SchemaError(message, self._error.format(data) if self._error else None)
+
+
