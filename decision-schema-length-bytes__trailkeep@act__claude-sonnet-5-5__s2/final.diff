+def test_length():
+    # Inclusive bounds
+    assert Length(min=2, max=4).validate("ab") == "ab"
+    assert Length(min=2, max=4).validate("abcd") == "abcd"
+    with SE:
+        Length(min=2, max=4).validate("a")
+    with SE:
+        Length(min=2, max=4).validate("abcde")
+
+    # Open-ended bounds
+    assert Length(min=1).validate("x" * 1000) == "x" * 1000
+    assert Length(max=3).validate("") == ""
+    assert Length().validate("anything") == "anything"
+    with SE:
+        Length(min=1).validate("")
+    with SE:
+        Length(max=3).validate("abcd")
+
+    # Bytes, not characters: "é" is 2 bytes in UTF-8
+    assert Length(max=4).validate("abcd") == "abcd"
+    assert Length(max=4).validate("éé") == "éé"
+    with SE:
+        Length(max=4).validate("ééé")  # 3 characters, 6 bytes
+    with SE:
+        Length(min=5).validate("éé")  # 2 characters, 4 bytes
+    assert Length(min=4).validate("éé") == "éé"
+
+    # Messages say bytes
+    with raises(SchemaError, match="6 bytes long, expected at most 4 bytes"):
+        Length(max=4).validate("ééé")
+    with raises(SchemaError, match="expected at least 5 bytes"):
+        Length(min=5).validate("éé")
+
+    # bytes are measured as they are
+    assert Length(max=2).validate(b"ab") == b"ab"
+    with SE:
+        Length(max=1).validate(b"ab")
+
+    # Non-strings are rejected
+    for bad in (1, None, [], {}, ["a", "b"]):
+        with SE:
+            Length(max=10).validate(bad)
+
+    # Unencodable string
+    with SE:
+        Length(max=10).validate("\ud800")
+
+    # Custom error goes in the errors slot
+    with raises(SchemaError) as e:
+        Length(max=1, error="{!r} too long").validate("ab")
+    assert e.value.errors == ["'ab' too long"]
+    assert e.value.code == "'ab' too long"
+
+    # Bad arguments
+    with raises(ValueError):
+        Length(min=-1)
+    with raises(ValueError):
+        Length(max=-1)
+    with raises(ValueError):
+        Length(min=5, max=2)
+    with raises(TypeError):
+        Length(min="1")
+    with raises(TypeError):
+        Length(max=1.5)
+    with raises(TypeError):
+        Length(min=True)
+
+    assert repr(Length(min=1, max=2)) == "Length(min=1, max=2)"
+
+    # Inside a schema
+    assert Schema({"name": Length(max=5)}).validate({"name": "José"}) == {
+        "name": "José"
+    }
+    with SE:
+        Schema({"name": Length(max=5)}).validate({"name": "Josée!"})
+    assert Schema(And(str, Length(min=1))).validate("a") == "a"
+
+
+def test_length_json_schema():
+    assert Schema(Length(min=8, max=20)).json_schema("id") == {
+        "$schema": "http://json-schema.org/draft-07/schema#",
+        "$id": "id",
+        "type": "string",
+        "minLength": 2,
+        "maxLength": 20,
+    }
+    assert Schema(Length(max=5)).json_schema("id")["maxLength"] == 5
+    assert "minLength" not in Schema(Length(max=5)).json_schema("id")
+    assert "maxLength" not in Schema(Length(min=1)).json_schema("id")
+
+
