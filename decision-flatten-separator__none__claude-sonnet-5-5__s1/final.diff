+    def test_flatten(self):
+        d = self.dict_class({'a': {'b': {'c': 1}, 'd': 2}, 'e': 3})
+        flat = d.flatten()
+        self.assertEqual(flat, {'a.b.c': 1, 'a.d': 2, 'e': 3})
+        self.assertIs(type(flat), dict)
+
+    def test_flatten_lists_are_leaves(self):
+        lst = [{'x': 1}, 2]
+        d = self.dict_class({'a': {'b': lst}, 't': (1, 2)})
+        flat = d.flatten()
+        self.assertEqual(set(flat), {'a.b', 't'})
+        self.assertEqual(flat['a.b'], lst)
+        self.assertIsInstance(flat['a.b'], list)
+        self.assertEqual(flat['t'], (1, 2))
+
+    def test_flatten_separator_and_keys(self):
+        d = self.dict_class({'a': {1: {'b': 'x'}}})
+        self.assertEqual(d.flatten('/'), {'a/1/b': 'x'})
+
+    def test_flatten_empty(self):
+        self.assertEqual(self.dict_class().flatten(), {})
+        d = self.dict_class({'a': {}, 'b': {'c': {}}})
+        self.assertEqual(d.flatten(), {'a': {}, 'b.c': {}})
+
+    def test_flatten_does_not_mutate(self):
