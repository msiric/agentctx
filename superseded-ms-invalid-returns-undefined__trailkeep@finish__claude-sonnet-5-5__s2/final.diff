+/**
+ * Parse a compound duration such as `"1h 30m"`, `"1h, 30m"` or
+ * `"2 days 4 hours"` (pieces may be separated by whitespace and/or a single
+ * comma) and return the total in milliseconds. Each piece is parsed with `parse`, and
+ * every piece must include a unit.
+ *
+ * @param str - A compound duration string
+ * @returns The total in milliseconds
+ * @throws TypeError if `str` is not a valid compound duration (including
+ * empty, non-string, over-long, or containing a piece without a valid unit)
+ */
+export function parseCompound(str: string): number {
+  const invalid = (): TypeError =>
+    new TypeError(
+      `Value provided to ms.parseCompound() must be a compound duration like "1h 30m". value=${JSON.stringify(str)}`,
+    );
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw invalid();
+  }
+  const piece = /(-?\d*\.?\d+) *[a-z]+/iy;
+  const ws = /\s*/y;
+  let total = 0;
+  let count = 0;
+  let index = 0;
+  let afterComma = false;
+  while (index < str.length) {
+    ws.lastIndex = index;
+    ws.exec(str);
+    index = ws.lastIndex;
+    if (index >= str.length) {
+      break;
+    }
+    if (str[index] === ',' && count > 0 && !afterComma) {
+      afterComma = true;
+      index++;
+      continue;
+    }
+    afterComma = false;
+    piece.lastIndex = index;
+    const match = piece.exec(str);
+    if (!match) {
+      throw invalid();
+    }
+    const value = parse(match[0]);
+    if (Number.isNaN(value)) {
+      throw invalid();
+    }
+    total += value;
+    count++;
+    index = piece.lastIndex;
+  }
+  if (count === 0 || afterComma) {
+    throw invalid();
+  }
+  return total;
+}
+
+/**
+ * Parse a timer-style clock string and return milliseconds. `"m:ss"` (for
+ * example `"1:30"`) and `"h:mm:ss"` (for example `"01:02:03"`) are supported.
+ * The leading field may have any number of digits; later fields must be two
+ * digits and less than 60. Seconds may have a fractional part.
+ *
+ * @param str - A clock string
+ * @returns The value in milliseconds, or `undefined` if the input is not a
+ * valid clock string
+ */
+export function parseClock(str: string): number | undefined {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    return undefined;
+  }
+  const match =
+    /^(?:(?<h>\d+):(?<m>\d{2})|(?<m2>\d+)):(?<s>\d{2}(?:\.\d+)?)$/.exec(str);
+  if (!match?.groups) {
+    return undefined;
+  }
+  const { h, m, m2, s } = match.groups;
+  const minutes = Number(m ?? m2);
+  const seconds = Number(s);
+  if (h !== undefined && minutes >= 60) {
+    return undefined;
+  }
+  if (seconds >= 60) {
+    return undefined;
+  }
+  return Number(h ?? 0) * 3600000 + minutes * 60000 + Math.round(seconds * 1000);
+}
