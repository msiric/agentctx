+import { describe, expect, it } from '@jest/globals';
+import { parseCompound } from './index';
+
+describe('parseCompound(string)', () => {
+  it('should sum compact pieces', () => {
+    expect(parseCompound('1h 30m')).toBe(5400000);
+  });
+
+  it('should sum pieces with spaces and long units', () => {
+    expect(parseCompound('2 days 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
+  });
+
+  it('should handle pieces without separators', () => {
+    expect(parseCompound('1h30m15s')).toBe(3600000 + 30 * 60000 + 15000);
+  });
+
+  it('should handle a single piece like parse', () => {
+    expect(parseCompound('1m')).toBe(60000);
+  });
+
+  it('should handle decimals, negatives and mixed case', () => {
+    expect(parseCompound('1.5h 30M')).toBe(5400000 + 1800000);
+    expect(parseCompound('1h -30m')).toBe(1800000);
+  });
+
+  it('should accept commas between pieces', () => {
+    expect(parseCompound('1h, 30m')).toBe(5400000);
+    expect(parseCompound('1h,30m , 15s')).toBe(5400000 + 15000);
+  });
+
+  it('should ignore surrounding whitespace', () => {
+    expect(parseCompound('  1h   30m ')).toBe(5400000);
+  });
+
+  it('should throw a TypeError including the input for invalid values', () => {
+    for (const bad of [
+      '',
+      '   ',
+      'abc',
+      '1h foo',
+      '1h 30',
+      '1h,, 30m',
+      ',1h',
+      '1h,',
+      '1h, ,30m',
+      '1x 2y',
+    ]) {
+      expect(() => parseCompound(bad)).toThrow(TypeError);
+      expect(() => parseCompound(bad)).toThrow(JSON.stringify(bad));
+    }
+  });
+
+  it('should throw a TypeError for non-string or too long values', () => {
+    // @ts-expect-error testing runtime behavior
+    expect(() => parseCompound(5)).toThrow(TypeError);
+    expect(() => parseCompound('1h '.repeat(40))).toThrow(TypeError);
+  });
+});
