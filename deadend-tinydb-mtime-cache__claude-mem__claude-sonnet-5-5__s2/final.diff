@@ -0,0 +1,108 @@
+"""
+Benchmark TinyDB read performance on a large JSON database.
+
+Usage: python scripts/bench_read.py [--size-mb 40] [--repeat 5]
+
+Generates a temporary db of roughly --size-mb, then times db.all(), an
+uncached search, a repeated (cached) search, and the raw json.load / Document
+wrapping costs so the time can be attributed.
+"""
+import argparse
+import json
+import os
+import random
+import statistics
+import string
+import sys
+import tempfile
+import time
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))
+
+from tinydb import TinyDB, where  # noqa: E402
+
+
+def make_doc(i, rnd):
+    return {
+        'id': i,
+        'name': ''.join(rnd.choices(string.ascii_lowercase, k=12)),
+        'group': rnd.randrange(1000),
+        'score': rnd.random(),
+        'tags': [''.join(rnd.choices(string.ascii_lowercase, k=6)) for _ in range(4)],
+        'text': ''.join(rnd.choices(string.ascii_lowercase + ' ', k=100)),
+    }
+
+
+def generate(path, size_mb):
+    rnd = random.Random(0)
+    docs = {}
+    i = 0
+    approx = 0
+    target = size_mb * 1024 * 1024
+    while approx < target:
+        i += 1
+        d = make_doc(i, rnd)
+        docs[str(i)] = d
+        approx += 260  # rough serialized size; real size is reported below
+    with open(path, 'w') as f:
+        json.dump({'_default': docs}, f)
+    return i
+
+
+def timeit(fn, repeat):
+    times = []
+    result = None
+    for _ in range(repeat):
+        t = time.perf_counter()
+        result = fn()
+        times.append(time.perf_counter() - t)
+    return statistics.median(times), min(times), result
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--size-mb', type=float, default=40)
+    ap.add_argument('--repeat', type=int, default=5)
+    args = ap.parse_args()
+
+    with tempfile.TemporaryDirectory() as tmp:
+        path = os.path.join(tmp, 'db.json')
+        n = generate(path, args.size_mb)
+        print(f'{n} docs, {os.path.getsize(path) / 1e6:.1f} MB')
+
+        db = TinyDB(path)
+        storage = db.storage
+        table = db.table('_default')
+        q = where('group') == 7
+
+        def row(label, fn):
+            med, best, res = timeit(fn, args.repeat)
+            print(f'{label:<38} median {med * 1000:9.1f} ms   best {best * 1000:9.1f} ms')
+            return res
+
+        row('storage.read() (json.load)', storage.read)
+        row('table._read_table()', table._read_table)
+        row('db.all()', db.all)
+
+        def search_uncached():
+            table.clear_cache()
+            return table.search(q)
+        hits = row('db.search(group == 7) uncached', search_uncached)
+        table.search(q)
+        row('db.search(group == 7) cached', lambda: table.search(q))
+        print(f'({len(hits)} hits)')
+
+        def read_and_wrap():
+            from tinydb.table import Document
+            raw = table._read_table()
+            return [Document(v, int(k)) for k, v in raw.items()]
+        row('read + wrap Documents (no filter)', read_and_wrap)
+
+        raw = table._read_table()
+        row('filter only (pre-parsed, no wrap)',
+            lambda: [v for v in raw.values() if v.get('group') == 7])
+        db.close()
+
+
+if __name__ == '__main__':
+    main()
