@@ -285,3 +285,34 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def test_json_read_cache_sees_external_writes(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    db = TinyDB(path)
+    db.insert({'a': 1})
+
+    storage = db.storage
+    first = storage.read()
+    assert storage.read() is first  # unchanged file: parse is reused
+
+    # Another process rewrites the file with same-length content
+    other = TinyDB(path)
+    other.update({'a': 2})
+    assert db.all() == [{'a': 2}]
+    other.close()
+    db.close()
+
+
+def test_json_read_cache_dropped_on_failed_update(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+
+        def boom(doc):
+            doc['a'] = 99
+            raise RuntimeError
+
+        with pytest.raises(RuntimeError):
+            db.update(boom)
+        assert db.all() == [{'a': 1}]
