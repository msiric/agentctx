+
+test('the context carries the time elapsed since pRetry was called', async t => {
+	await withFakeTime(t);
+	const seen = {shouldConsumeRetry: [], onFailedAttempt: [], shouldRetry: []};
+	const record = name => ({elapsedTime}) => {
+		seen[name].push(elapsedTime);
+		return true;
+	};
+
+	await assert.rejects(pRetry(async () => {
+		throw new Error('fail');
+	}, {
+		retries: 2,
+		minTimeout: 100,
+		factor: 2,
+		shouldConsumeRetry: record('shouldConsumeRetry'),
+		onFailedAttempt: record('onFailedAttempt'),
+		shouldRetry: record('shouldRetry'),
+	}), {message: 'fail'});
+
+	// Failures happen at 0, 100 and 300ms. The last one has no retry left, so `shouldRetry` is not asked.
+	assert.deepEqual(seen.shouldConsumeRetry, [0, 100, 300]);
+	assert.deepEqual(seen.onFailedAttempt, [0, 100, 300]);
+	assert.deepEqual(seen.shouldRetry, [0, 100]);
+});
+
+test('waits for the `retryAfter` of the error when it is longer than the backoff', async t => {
+	const {delays} = await withFakeTime(t);
+	const seen = [];
+
+	await assert.rejects(pRetry(async () => {
+		const error = new Error('limited');
+		error.retryAfter = 2.5;
+		throw error;
+	}, {
+		retries: 1,
+		minTimeout: 100,
+		onFailedAttempt({retryDelay}) {
+			seen.push(retryDelay);
+		},
+	}), {message: 'limited'});
+
+	assert.deepEqual(delays, [2500]);
+	assert.deepEqual(seen, [2500, 0]);
+});
+
+test('`retryAfter` does not shorten a longer backoff', async t => {
+	const {delays} = await withFakeTime(t);
+
+	await assert.rejects(pRetry(async () => {
+		const error = new Error('limited');
+		error.retryAfter = 0.1;
+		throw error;
+	}, {retries: 1, minTimeout: 1000}), {message: 'limited'});
+
+	assert.deepEqual(delays, [1000]);
+});
+
+test('`retryAfter` is not capped by `maxTimeout` but is by `maxRetryTime`', async t => {
+	const {delays} = await withFakeTime(t);
+	const run = options => assert.rejects(pRetry(async () => {
+		const error = new Error('limited');
+		error.retryAfter = 5;
+		throw error;
+	}, {retries: 1, minTimeout: 10, ...options}), {message: 'limited'});
+
+	await run({maxTimeout: 100});
+	assert.deepEqual(delays, [5000]);
+
+	delays.length = 0;
+	await run({maxRetryTime: 1000});
+	assert.ok(delays.every(ms => ms <= 1000));
+});
+
+test('an invalid `retryAfter` is ignored', async t => {
+	const {delays} = await withFakeTime(t);
+
+	for (const retryAfter of [-1, NaN, Infinity, '5', null]) {
+		await assert.rejects(pRetry(async () => {
+			const error = new Error('limited');
+			error.retryAfter = retryAfter;
+			throw error;
+		}, {retries: 1, minTimeout: 10}), {message: 'limited'});
+	}
+
+	assert.deepEqual(delays, [10, 10, 10, 10, 10]);
+});
