+class TestBearerToken(unittest.TestCase):
+
+    def token(self, header=None):
+        env = {} if header is None else {'HTTP_AUTHORIZATION': header}
+        return bottle.BaseRequest(env).bearer_token
+
+    def test_valid(self):
+        self.assertEqual('abc.def-1', self.token('Bearer abc.def-1'))
+
+    def test_scheme_case_insensitive(self):
+        self.assertEqual('abc', self.token('bearer abc'))
+
+    def test_missing_header(self):
+        self.assertEqual(None, self.token())
+
+    def test_other_scheme(self):
+        self.assertEqual(None, self.token('Basic Zm9vOmJhcg=='))
+
+    def test_no_token(self):
+        self.assertEqual(None, self.token('Bearer'))
+        self.assertEqual(None, self.token('Bearer   '))
