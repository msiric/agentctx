 If omitted, keys are sorted using `Array#sort()`.
 
+##### ignoreEmpty
+
+Type: `boolean`\
+Default: `false`
+
+```js
+import queryString from 'query-string';
+
+queryString.parse('?q=&page=2', {ignoreEmpty: true});
+//=> {page: '2'}
+
+queryString.parse('?flag&q=', {ignoreEmpty: true});
+//=> {flag: null}
+```
+
+Drop parameters that have an empty value. A key without `=` (`?flag`) is not empty and is kept as `null`.
+
+##### stripTracking
+
+Type: `boolean`\
+Default: `true`
+
+```js
+import queryString from 'query-string';
+
+queryString.parse('?q=cats&utm_source=news&fbclid=abc');
+//=> {q: 'cats'}
+
+queryString.parse('?q=cats&utm_source=news', {stripTracking: false});
+//=> {q: 'cats', utm_source: 'news'}
+```
+
+Drop tracking parameters: `utm_*`, `fbclid`, and `gclid`. Set to `false` to keep them.
+
 ##### parseNumbers
 
 Type: `boolean`\
diff --git a/test/parse.js b/test/parse.js
index 00a1abf..b29b946 100644
--- a/test/parse.js
+++ b/test/parse.js
@@ -1492,3 +1492,24 @@ test('rejects an invalid `arrayFormatSeparator`', () => {
 
 	assert.deepEqual(structuredClone(queryString.parse('foo=a·b', {arrayFormat: 'separator', arrayFormatSeparator: '·'})), {foo: ['a', 'b']});
 });
+
+test('`ignoreEmpty` drops parameters with an empty value', () => {
+	assert.deepEqual(structuredClone(queryString.parse('?q=&page=2', {ignoreEmpty: true})), {page: '2'});
+	assert.deepEqual(structuredClone(queryString.parse('?q=&page=2')), {q: '', page: '2'});
+	assert.deepEqual(structuredClone(queryString.parse('?flag&q=', {ignoreEmpty: true})), {flag: null});
+	assert.deepEqual(structuredClone(queryString.parse('a=&a=1&a=', {ignoreEmpty: true})), {a: '1'});
+	assert.deepEqual(structuredClone(queryString.parse('a[]=&a[]=1', {ignoreEmpty: true, arrayFormat: 'bracket'})), {a: ['1']});
+	assert.deepEqual(structuredClone(queryString.parse('q=%20', {ignoreEmpty: true})), {q: ' '});
+	assert.deepEqual(structuredClone(queryString.parse('q=', {ignoreEmpty: true})), {});
+});
+
+test('`stripTracking` drops tracking parameters', () => {
+	assert.deepEqual(structuredClone(queryString.parse('?q=cats&utm_source=news&utm_medium=x&fbclid=a&gclid=b')), {q: 'cats'});
+	assert.deepEqual(structuredClone(queryString.parse('?q=cats&utm_source=news&fbclid')), {q: 'cats'});
+	assert.deepEqual(structuredClone(queryString.parse('?utm%5Fsource=a&q=1')), {q: '1'});
+	// eslint-disable-next-line camelcase
+	assert.deepEqual(structuredClone(queryString.parse('?q=cats&utm_source=news&fbclid=a', {stripTracking: false})), {fbclid: 'a', q: 'cats', utm_source: 'news'});
+	assert.deepEqual(structuredClone(queryString.parse('?utm_term[]=a&q=1', {arrayFormat: 'bracket'})), {q: '1'});
+	// eslint-disable-next-line camelcase
+	assert.deepEqual(structuredClone(queryString.parse('?myutm_x=1&fbclid2=2&gclid_x=3')), {myutm_x: '1', fbclid2: '2', gclid_x: '3'});
+});
