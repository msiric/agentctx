+test('elapsedTime is provided in every callback context', async t => {
+	collapseDelays(t);
+	const originalPerformanceNow = performance.now;
+	let now = 1000;
+	performance.now = () => now;
+
+	t.after(() => {
+		performance.now = originalPerformanceNow;
+	});
+
+	const seen = {consume: [], failed: [], retry: []};
+
+	await assert.rejects(pRetry(
+		async () => {
+			now += 10;
+			throw new Error('test');
+		},
+		{
+			retries: 2,
+			minTimeout: 0,
+			shouldConsumeRetry({elapsedTime}) {
+				seen.consume.push(elapsedTime);
+			},
+			async onFailedAttempt({elapsedTime}) {
+				seen.failed.push(elapsedTime);
+				now += 5;
+			},
+			shouldRetry({elapsedTime}) {
+				seen.retry.push(elapsedTime);
+				return true;
+			},
+		},
+	), {message: 'test'});
+
+	// Each attempt spends 10, and `onFailedAttempt` spends 5 more. `shouldRetry` shares the context of `onFailedAttempt`, so it sees the same value. The last failure has no retry left, so `shouldRetry` is not asked.
+	assert.deepEqual(seen.consume, [10, 25, 40]);
+	assert.deepEqual(seen.failed, [10, 25, 40]);
+	assert.deepEqual(seen.retry, [10, 25]);
+});
+
+test('retryAfter on the error is added to the backoff', async t => {
