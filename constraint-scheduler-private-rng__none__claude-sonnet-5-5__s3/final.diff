+    def jitter(self, seconds: float):
+        """
+        Delay every run by a random offset between 0 and `seconds`.
+
+        The offset is drawn anew each time the next run is computed, so
+        jobs sharing the same schedule (e.g. many workers doing
+        `every(10).minutes`) do not all fire in the same instant.
+
+        :param seconds: Maximum offset in seconds (must be >= 0)
+        :return: The invoked job instance
+        """
+        if seconds < 0:
+            raise ScheduleValueError("`jitter` must be non-negative")
+        self.jitter_seconds = seconds
+        return self
+
+    def retry(self, times: int, base_delay: float):
+        """
+        Retry a run that raised an exception, with exponential backoff.
+
+        After a failure the job is retried after `base_delay` seconds, then
+        `2 * base_delay`, `4 * base_delay`, ... seconds, each delay plus a
+        random 0 to `base_delay` seconds of jitter. At most `times` retries
+        are made; if they all fail the job gives up and returns to its
+        normal schedule. Exceptions (subclasses of :class:`Exception`) from
+        a job with retries configured are logged, not raised.
+
+        :param times: Maximum number of retries (must be >= 1)
+        :param base_delay: Initial delay in seconds (must be >= 0)
+        :return: The invoked job instance
+        """
+        if times < 1:
+            raise ScheduleValueError("`times` must be at least 1")
+        if base_delay < 0:
+            raise ScheduleValueError("`base_delay` must be non-negative")
+        self.retry_times = times
+        self.retry_base_delay = base_delay
+        return self
