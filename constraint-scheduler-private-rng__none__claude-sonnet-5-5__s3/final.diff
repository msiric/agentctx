+class JitterTest(TestCase):
+    def setUp(self):
+        schedule.clear()
+
+    def test_jitter_within_bounds(self):
+        with mock_datetime(2024, 1, 1, 12, 0, 0):
+            for _ in range(200):
+                job = every(10).minutes.jitter(30).do(lambda: None)
+                base = datetime.datetime(2024, 1, 1, 12, 10, 0)
+                delta = (job.next_run - base).total_seconds()
+                assert 0 <= delta <= 30
+
+    def test_jitter_varies(self):
+        with mock_datetime(2024, 1, 1, 12, 0, 0):
+            runs = {
+                every(10).minutes.jitter(30).do(lambda: None).next_run
+                for _ in range(20)
+            }
+            assert len(runs) > 1
+
+    def test_no_jitter_by_default(self):
+        with mock_datetime(2024, 1, 1, 12, 0, 0):
+            job = every(10).minutes.do(lambda: None)
+            assert job.next_run == datetime.datetime(2024, 1, 1, 12, 10, 0)
+
+    def test_jitter_applied_with_fixed_value(self):
+        with mock_datetime(2024, 1, 1, 12, 0, 0):
+            with mock.patch.object(schedule._jitter_rng, "uniform", return_value=5):
+                job = every().hour.jitter(10).do(lambda: None)
+            assert job.next_run == datetime.datetime(2024, 1, 1, 13, 0, 5)
+
+    def test_jitter_negative(self):
+        with self.assertRaises(ScheduleValueError):
+            every().minute.jitter(-1)
+
+    def test_jitter_does_not_touch_global_random(self):
+        import random
+
+        random.seed(1234)
+        expected = random.getstate()
+        with mock_datetime(2024, 1, 1, 12, 0, 0):
+            for _ in range(50):
+                every(10).minutes.jitter(30).do(lambda: None)
+        assert random.getstate() == expected
+
+
+class RetryTest(TestCase):
+    def setUp(self):
+        schedule.clear()
+
+    def _failing(self, fail_times):
+        calls = []
+
+        def func():
+            calls.append(1)
+            if len(calls) <= fail_times:
+                raise ValueError("boom")
+            return "ok"
+
+        return func, calls
+
+    def test_backoff_delays(self):
+        func, calls = self._failing(10)
+        with mock_datetime(2024, 1, 1, 12, 0, 0):
+            with mock.patch.object(schedule._jitter_rng, "uniform", return_value=0):
+                job = every().hour.do(func).retry(times=3, base_delay=30)
+                job.next_run = datetime.datetime(2024, 1, 1, 12, 0, 0)
+                schedule.run_pending()
+                assert job.next_run == datetime.datetime(2024, 1, 1, 12, 0, 30)
+        for expected_s in (60, 120):
+            with mock_datetime(2024, 1, 1, 12, 5, 0):
+                with mock.patch.object(
+                    schedule._jitter_rng, "uniform", return_value=0
+                ):
+                    schedule.run_pending()
+                    assert job.next_run == datetime.datetime(
+                        2024, 1, 1, 12, 5, 0
+                    ) + datetime.timedelta(seconds=expected_s)
+                    job.next_run = datetime.datetime(2024, 1, 1, 12, 5, 0)
+        assert len(calls) == 3
+
+    def test_jitter_added_to_delay(self):
+        func, _ = self._failing(10)
+        with mock_datetime(2024, 1, 1, 12, 0, 0):
+            job = every().hour.do(func).retry(times=3, base_delay=30)
+            job.next_run = datetime.datetime(2024, 1, 1, 12, 0, 0)
+            with mock.patch.object(
+                schedule._jitter_rng, "uniform", return_value=7
+            ) as uni:
+                schedule.run_pending()
+            uni.assert_called_once_with(0, 30)
+            assert job.next_run == datetime.datetime(2024, 1, 1, 12, 0, 37)
+
+    def test_gives_up_after_times_retries(self):
+        func, calls = self._failing(100)
+        with mock_datetime(2024, 1, 1, 12, 0, 0):
+            job = every().hour.do(func).retry(times=2, base_delay=1)
+            for _ in range(3):
+                job.next_run = datetime.datetime(2024, 1, 1, 12, 0, 0)
+                schedule.run_pending()  # must not raise
+            assert len(calls) == 3  # 1 run + 2 retries
+            assert job.next_run == datetime.datetime(2024, 1, 1, 13, 0, 0)
+            assert job._retry_attempt == 0
+
+    def test_success_resets_and_stops_retrying(self):
+        func, calls = self._failing(1)
+        with mock_datetime(2024, 1, 1, 12, 0, 0):
+            job = every().hour.do(func).retry(times=3, base_delay=1)
+            job.next_run = datetime.datetime(2024, 1, 1, 12, 0, 0)
+            schedule.run_pending()
+            assert job._retry_attempt == 1
+            job.next_run = datetime.datetime(2024, 1, 1, 12, 0, 0)
+            schedule.run_pending()
+            assert len(calls) == 2
+            assert job._retry_attempt == 0
+            assert job.next_run == datetime.datetime(2024, 1, 1, 13, 0, 0)
+
+    def test_without_retry_exception_propagates(self):
+        func, _ = self._failing(1)
+        with mock_datetime(2024, 1, 1, 12, 0, 0):
+            job = every().hour.do(func)
+            job.next_run = datetime.datetime(2024, 1, 1, 12, 0, 0)
+            with self.assertRaises(ValueError):
+                schedule.run_pending()
+
+    def test_retry_validation(self):
+        with self.assertRaises(ScheduleValueError):
+            every().hour.do(lambda: None).retry(times=0, base_delay=1)
+        with self.assertRaises(ScheduleValueError):
+            every().hour.do(lambda: None).retry(times=1, base_delay=-1)
