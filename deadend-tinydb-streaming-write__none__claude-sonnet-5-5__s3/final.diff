+def test_gzip_json_storage(tmpdir):
+    path = str(tmpdir.join('db.json.gz'))
+
+    with TinyDB(path, storage=GzipJSONStorage) as db:
+        db.insert_multiple({'int': 1, 'text': 'x' * 50} for _ in range(100))
+
+    with open(path, 'rb') as f:
+        assert f.read(2) == b'\x1f\x8b'
+
+    with TinyDB(path, storage=GzipJSONStorage) as db:
+        assert len(db) == 100
+        db.remove(where('int') == 1)
+
+    with TinyDB(path, storage=GzipJSONStorage) as db:
+        assert len(db) == 0
+
+
+def test_gzip_json_storage_readonly_and_create_dirs(tmpdir):
+    path = str(tmpdir.join('sub', 'db.gz'))
+
+    with TinyDB(path, storage=GzipJSONStorage, create_dirs=True) as db:
+        db.insert({'a': 1})
+
+    with TinyDB(path, storage=GzipJSONStorage, access_mode='rb') as db:
+        assert db.all() == [{'a': 1}]
+        with pytest.raises(IOError):
+            db.insert({'a': 2})
