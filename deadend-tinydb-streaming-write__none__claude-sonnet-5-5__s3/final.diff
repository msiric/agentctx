+class GzipJSONStorage(Storage):
+    """
+    Store the data in a gzip-compressed JSON file.
+    """
+
+    def __init__(self, path: str, create_dirs=False, access_mode='r+b',
+                 compresslevel=9, **kwargs):
+        """
+        Create a new instance.
+
+        Also creates the storage file, if it doesn't exist and the access mode
+        is appropriate for writing.
+
+        **Note:** **Never** pass untrusted or user-controlled code as ``kwargs``
+        members like ``cls`` or ``default`` will be called on every write
+        operation.
+
+        :param path: Where to store the compressed JSON data.
+        :param create_dirs: Whether to create missing parent directories.
+        :param access_mode: mode in which the file is opened (``rb``, ``r+b``)
+        :param compresslevel: gzip compression level (0-9)
+        :param kwargs: Passed on to :func:`json.dumps`.
+        """
+
+        super().__init__()
+
+        self._mode = access_mode
+        self._compresslevel = compresslevel
+        self.kwargs = kwargs
+
+        if access_mode not in ('rb', 'r+b'):
+            warnings.warn(
+                'Using an `access_mode` other than \'rb\' or \'r+b\' '
+                'can cause data loss or corruption'
+            )
+
+        if any([character in self._mode for character in ('+', 'w', 'a')]):
+            touch(path, create_dirs=create_dirs)
+
+        self._handle = open(path, mode=self._mode)
+
+    def close(self) -> None:
+        self._handle.close()
+
+    def read(self) -> Optional[dict[str, dict[str, Any]]]:
+        self._handle.seek(0, os.SEEK_END)
+        size = self._handle.tell()
+
+        if not size:
+            return None
+
+        self._handle.seek(0)
+        return json.loads(gzip.decompress(self._handle.read()).decode('utf-8'))
+
+    def write(self, data: dict[str, dict[str, Any]]):
+        self._handle.seek(0)
+
+        serialized = json.dumps(data, **self.kwargs).encode('utf-8')
+        compressed = gzip.compress(serialized, compresslevel=self._compresslevel)
+
+        try:
+            self._handle.write(compressed)
+        except io.UnsupportedOperation:
+            raise IOError('Cannot write to the database. Access mode is "{0}"'.format(self._mode))
+
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+
+        self._handle.truncate()
+
+
