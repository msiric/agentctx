@@ -655,3 +655,42 @@ if __name__ == '__main__':  # pragma: no cover
             handle_item([], root)
     except KeyboardInterrupt:
         pass
+
+
+def drop_keys(doc, names):
+    """Return a copy of a parsed document with every key in ``names`` removed
+    at any depth (attribute keys such as ``'@id'`` included).
+
+    The input is not mutated. Traversal is iterative, so very deeply nested
+    documents do not hit the interpreter recursion limit.
+    """
+    if isinstance(names, str):
+        names = (names,)
+    names = frozenset(names)
+
+    def shell(node):
+        if isinstance(node, dict):
+            return type(node)()
+        if isinstance(node, list):
+            return []
+        return None
+
+    root = shell(doc)
+    if root is None:
+        return doc
+    stack = [(doc, root)]
+    while stack:
+        src, dst = stack.pop()
+        items = src.items() if isinstance(src, dict) else enumerate(src)
+        for key, value in items:
+            if isinstance(src, dict) and key in names:
+                continue
+            child = shell(value)
+            if child is not None:
+                stack.append((value, child))
+                value = child
+            if isinstance(dst, dict):
+                dst[key] = value
+            else:
+                dst.append(value)
+    return root
