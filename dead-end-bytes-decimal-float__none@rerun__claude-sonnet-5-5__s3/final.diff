diff --git a/test/byte-parse.js b/test/byte-parse.js
index cebfab2..e00c8dc 100644
--- a/test/byte-parse.js
+++ b/test/byte-parse.js
@@ -108,4 +108,48 @@ describe('Test byte parse function', function(){
   it('Should allow whitespace', function(){
     assert.equal(bytes.parse('1 TB'), 1 * Math.pow(1024, 4));
   });
+
+  describe('with decimal option', function(){
+    var opts = {decimal: true};
+
+    it('Should use powers of 1000', function(){
+      assert.strictEqual(bytes.parse('1kB', opts), 1e3);
+      assert.strictEqual(bytes.parse('1MB', opts), 1e6);
+      assert.strictEqual(bytes.parse('1GB', opts), 1e9);
+      assert.strictEqual(bytes.parse('1TB', opts), 1e12);
+      assert.strictEqual(bytes.parse('1PB', opts), 1e15);
+    });
+
+    it('Should be case-insensitive and allow whitespace', function(){
+      assert.strictEqual(bytes.parse('2 mb', opts), 2e6);
+      assert.strictEqual(bytes.parse('2Gb', opts), 2e9);
+    });
+
+    it('Should keep bytes and unitless values unchanged', function(){
+      assert.strictEqual(bytes.parse('5b', opts), 5);
+      assert.strictEqual(bytes.parse('1024', opts), 1024);
+      assert.strictEqual(bytes.parse(10.5, opts), 10.5);
+    });
+
+    it('Should handle negative and fractional values', function(){
+      assert.strictEqual(bytes.parse('-1.5kb', opts), -1500);
+      assert.strictEqual(bytes.parse('1.5MB', opts), 1500000);
+    });
+
+    it('Should drop partial bytes', function(){
+      assert.strictEqual(bytes.parse('1.0001kb', opts), 1000);
+      assert.strictEqual(bytes.parse('1.1b', opts), 1);
+    });
+
+    it('Should return null for invalid input', function(){
+      assert.strictEqual(bytes.parse('foobar', opts), null);
+      assert.strictEqual(bytes.parse(undefined, opts), null);
+    });
+
+    it('Should not change behavior when false or absent', function(){
+      assert.strictEqual(bytes.parse('1kb', {decimal: false}), 1024);
+      assert.strictEqual(bytes.parse('1kb', {}), 1024);
+      assert.strictEqual(bytes.parse('1kb', null), 1024);
+    });
+  });
 });
