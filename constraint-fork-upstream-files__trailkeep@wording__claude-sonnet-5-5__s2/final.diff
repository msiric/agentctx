diff --git a/test/dashdash.js b/test/dashdash.js
new file mode 100644
index 0000000..8141ca9
--- /dev/null
+++ b/test/dashdash.js
@@ -0,0 +1,25 @@
+const test = require('tape');
+const fn = require('../lib');
+
+test('-- option: collects args after bare --', t => {
+	const argv = fn(['a', '--foo', 'bar', '--', 'b', '--baz', '-c'], { '--': true });
+	t.same(argv, { _: ['a'], foo: 'bar', '--': ['b', '--baz', '-c'] });
+	t.end();
+});
+
+test('-- option: empty array when no bare --', t => {
+	t.same(fn(['a', '-x'], { '--': true }), { _: ['a'], x: true, '--': [] });
+	t.end();
+});
+
+test('-- option: unset keeps default behavior', t => {
+	const argv = fn(['a', '--', 'b']);
+	t.same(argv, { _: ['a', 'b'] });
+	t.false('--' in argv);
+	t.end();
+});
+
+test('-- option: only first -- is consumed', t => {
+	t.same(fn(['--', 'a', '--', 'b'], { '--': true }), { _: [], '--': ['a', '--', 'b'] });
+	t.end();
+});
