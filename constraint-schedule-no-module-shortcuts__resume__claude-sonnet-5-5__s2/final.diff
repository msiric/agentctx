diff --git a/test_schedule.py b/test_schedule.py
index f497826..a44e2c3 100644
--- a/test_schedule.py
+++ b/test_schedule.py
@@ -1569,6 +1569,95 @@ class SchedulerTests(TestCase):
         schedule.clear()
         assert len(schedule.jobs) == 0
 
+    def test_get_jobs_for(self):
+        def foo(*args):
+            pass
+
+        def bar():
+            pass
+
+        j1 = every().second.do(foo)
+        j2 = every().minute.do(foo, 1, 2)
+        j3 = every().second.do(bar)
+
+        assert schedule.default_scheduler.get_jobs_for(foo) == [j1, j2]
+        assert schedule.default_scheduler.get_jobs_for(bar) == [j3]
+        assert schedule.default_scheduler.get_jobs_for(lambda: None) == []
+
+        schedule.cancel_job(j1)
+        assert schedule.default_scheduler.get_jobs_for(foo) == [j2]
+        schedule.clear()
+
+    def test_pause_resume_by_tag(self):
+        mock_a = make_mock_job()
+        mock_b = make_mock_job()
+        with mock_datetime(2014, 6, 28, 12, 0, 0):
+            job_a = every().second.do(mock_a).tag("a")
+            job_b = every().second.do(mock_b).tag("b")
+
+        sched = schedule.default_scheduler
+        sched.pause("a")
+        assert job_a.paused
+        assert not job_b.paused
+
+        with mock_datetime(2014, 6, 28, 12, 0, 10):
+            schedule.run_pending()
+        assert mock_a.call_count == 0
+        assert mock_b.call_count == 1
+        # still scheduled
+        assert job_a in sched.get_jobs()
+
+        sched.resume("a")
+        assert not job_a.paused
+        with mock_datetime(2014, 6, 28, 12, 0, 20):
+            schedule.run_pending()
+        # runs once on resume, missed runs are not made up
+        assert mock_a.call_count == 1
+        assert mock_b.call_count == 2
+
+    def test_pause_resume_all_without_tag(self):
+        mock_job = make_mock_job()
+        with mock_datetime(2014, 6, 28, 12, 0, 0):
+            every().second.do(mock_job).tag("a")
+            every().second.do(mock_job)
+
+        schedule.default_scheduler.pause()
+        with mock_datetime(2014, 6, 28, 12, 0, 10):
+            schedule.run_pending()
+        assert mock_job.call_count == 0
+
+        schedule.default_scheduler.resume()
+        with mock_datetime(2014, 6, 28, 12, 0, 10):
+            schedule.run_pending()
+        assert mock_job.call_count == 2
+
+    def test_pause_unknown_tag_is_noop(self):
+        job = every().second.do(make_mock_job()).tag("a")
+        schedule.default_scheduler.pause("nope")
+        schedule.default_scheduler.resume("nope")
+        assert not job.paused
+
+    def test_paused_jobs_ignored_by_next_run(self):
+        with mock_datetime(2014, 6, 28, 12, 0, 0):
+            every().minute.do(make_mock_job()).tag("a")
+            every().hour.do(make_mock_job()).tag("b")
+            sched = schedule.default_scheduler
+            sched.pause("a")
+            assert sched.get_next_run() == datetime.datetime(2014, 6, 28, 13, 0, 0)
+            assert sched.get_next_run("a") is None
+            sched.pause("b")
+            assert sched.get_next_run() is None
+            assert sched.idle_seconds is None
+            sched.resume()
+            assert sched.get_next_run() == datetime.datetime(2014, 6, 28, 12, 1, 0)
+
+    def test_run_all_runs_paused_jobs(self):
+        mock_job = make_mock_job()
+        every().second.do(mock_job)
+        schedule.default_scheduler.pause()
+        schedule.run_all()
+        assert mock_job.call_count == 1
+
