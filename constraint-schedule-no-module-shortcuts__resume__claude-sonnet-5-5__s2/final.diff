+    def pause(self, tag: Optional[Hashable] = None) -> None:
+        """
+        Pause scheduled jobs marked with the given tag, or all jobs
+        if tag is omitted.
+
+        Paused jobs stay scheduled but are skipped by
+        :meth:`run_pending <Scheduler.run_pending>` and ignored by
+        :meth:`next_run <Scheduler.next_run>` until they are resumed.
+        :meth:`run_all <Scheduler.run_all>` still runs them.
+
+        Pausing does not move a job's next run. A job that became due
+        while paused runs on the first ``run_pending()`` after
+        :meth:`resume <Scheduler.resume>` (once, missed runs are not
+        made up).
+
+        :param tag: An identifier used to identify a subset of
+                    jobs to pause
+        """
+        logger.debug('Pausing jobs tagged "%s"', tag)
+        for job in self.get_jobs(tag):
+            job.paused = True
+
+    def resume(self, tag: Optional[Hashable] = None) -> None:
+        """
+        Resume paused jobs marked with the given tag, or all jobs
+        if tag is omitted.
+
+        :param tag: An identifier used to identify a subset of
+                    jobs to resume
+        """
+        logger.debug('Resuming jobs tagged "%s"', tag)
+        for job in self.get_jobs(tag):
+            job.paused = False
+
