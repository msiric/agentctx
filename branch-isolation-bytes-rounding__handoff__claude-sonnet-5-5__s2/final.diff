@@ -127,6 +128,32 @@ function format(value, options) {
   return str + unitSeparator + unit;
 }
 
+/**
+ * Truncate (toward zero) a number to the given decimal places, as a string.
+ *
+ * Whole-byte inputs are expanded exactly (division by a power of two is exact
+ * in binary floating point), so values just under a boundary are not rounded
+ * up. Fractional inputs carry float noise (e.g. 1.2 * 1024 / 1024 is
+ * 1.19999999999999996), so they are first rounded at a much finer precision.
+ *
+ * @param {number} val
+ * @param {number} decimalPlaces
+ * @param {boolean} exact
+ * @returns {string}
+ * @private
+ */
+
+function truncate(val, decimalPlaces, exact) {
+  var digits = exact ? 100 : Math.min(decimalPlaces + 12, 100);
+  var str = val.toFixed(digits);
+  var dot = str.indexOf('.');
+
+  str = str.slice(0, decimalPlaces > 0 ? dot + decimalPlaces + 1 : dot);
+
+  // avoid "-0" / "-0.00" when a small negative is truncated to zero
+  return /^-0(\.0*)?$/.test(str) ? str.slice(1) : str;
+}
