+### parseMilliseconds(milliseconds, options?)
+
+#### options
+
+##### largestUnit
+
+Type: `'days' | 'hours' | 'minutes' | 'seconds'`\
+Default: `'days'`
+
+The largest unit to include. Bigger units are rolled into it. Any other value throws a `TypeError`.
+
+```js
+parseMilliseconds(93_600_000, {largestUnit: 'hours'});
+// {days: 0, hours: 26, minutes: 0, seconds: 0, …}
+```
+
 ## Related
 
 - [to-milliseconds](https://github.com/sindresorhus/to-milliseconds) - The inverse of this module
diff --git a/test.js b/test.js
index 6314aab..6543dcc 100644
--- a/test.js
+++ b/test.js
@@ -292,3 +292,47 @@ test('keep the sub-day parts exact at any magnitude', () => {
 		assert.strictEqual(parsed.hours, Number(bigint.hours), `${milliseconds}ms hours against the bigint path`);
 	}
 });
+
+test('largestUnit rolls bigger units into the chosen one', () => {
+	const milliseconds = (26 * 3_600_000) + (5 * 60_000) + 7000 + 8;
+	const expected = {
+		days: 0, hours: 0, minutes: 0, seconds: 0, milliseconds: 8, microseconds: 0, nanoseconds: 0,
+	};
+
+	assert.deepStrictEqual(parseMilliseconds(milliseconds), parseMilliseconds(milliseconds, {largestUnit: 'days'}));
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit: 'hours'}), {
+		...expected, hours: 26, minutes: 5, seconds: 7,
+	});
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit: 'minutes'}), {...expected, minutes: 1565, seconds: 7});
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit: 'seconds'}), {...expected, seconds: 93_907});
+	assert.deepStrictEqual(parseMilliseconds(-milliseconds, {largestUnit: 'hours'}), {
+		...expected, hours: -26, minutes: -5, seconds: -7, milliseconds: -8, microseconds: -0, nanoseconds: -0,
+	});
+});
+
+test('largestUnit works for bigint', () => {
+	const milliseconds = 93_907_008n;
+	const expected = {
+		days: 0n, hours: 0n, minutes: 0n, seconds: 0n, milliseconds: 8n, microseconds: 0n, nanoseconds: 0n,
+	};
+
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit: 'days'}), parseMilliseconds(milliseconds));
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit: 'hours'}), {
+		...expected, hours: 26n, minutes: 5n, seconds: 7n,
+	});
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit: 'minutes'}), {...expected, minutes: 1565n, seconds: 7n});
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit: 'seconds'}), {...expected, seconds: 93_907n});
+});
+
+test('largestUnit keeps large numbers exact', () => {
+	const exact = 1_000_000_000_000_000_000_000n;
+	assert.strictEqual(parseMilliseconds(1e21, {largestUnit: 'hours'}).minutes, Number((exact % 3_600_000n) / 60_000n));
+	assert.strictEqual(parseMilliseconds(1e21, {largestUnit: 'seconds'}).seconds, Number(exact / 1000n));
+});
+
+test('largestUnit rejects other values', () => {
+	for (const largestUnit of ['weeks', 'Days', '', null, 1, {}]) {
+		assert.throws(() => parseMilliseconds(1000, {largestUnit}), TypeError);
+		assert.throws(() => parseMilliseconds(1000n, {largestUnit}), TypeError);
+	}
+});
