diff --git a/test/same-origin.test.ts b/test/same-origin.test.ts
new file mode 100644
index 0000000..fc8732d
--- /dev/null
+++ b/test/same-origin.test.ts
@@ -0,0 +1,134 @@
+import { describe, expect, test } from "vitest";
+import { isSameOrigin } from "../src";
+
+describe("isSameOrigin", () => {
+  describe("same origin", () => {
+    const sameOrigins = [
+      // Identical
+      ["https://example.com", "https://example.com"],
+      // Path, query and hash are ignored
+      ["https://example.com", "https://example.com/"],
+      ["https://example.com/foo", "https://example.com/bar"],
+      ["https://example.com/?a=1", "https://example.com/?b=2"],
+      ["https://example.com/#a", "https://example.com/#b"],
+      // Credentials are not part of the origin
+      ["https://john:doe@example.com", "https://example.com"],
+      ["https://john@example.com/foo", "https://jane@example.com/bar"],
+      // Scheme and host are case-insensitive
+      ["HTTPS://example.com", "https://example.com"],
+      ["https://EXAMPLE.com", "https://example.com"],
+      // Ports are compared literally (no default-port normalization)
+      ["https://example.com:443", "https://example.com:443/foo"],
+      ["http://example.com:80", "http://example.com:80/foo"],
+      // Non-default ports must match exactly
+      ["https://example.com:8080", "https://example.com:8080/foo"],
+      // IDN / punycode hosts
+      ["https://münchen.de", "https://xn--mnchen-3ya.de"],
+      // Trailing dot is the same DNS name
+      // (open question, see todo below)
+      // IPv4 / IPv6
+      ["http://127.0.0.1:3000/a", "http://127.0.0.1:3000/b"],
+      ["http://[::1]:3000/a", "http://[::1]:3000/b"],
+    ];
+
+    for (const [a, b] of sameOrigins) {
+      test(`${a} == ${b}`, () => {
+        expect(isSameOrigin(a, b)).toBe(true);
+        // Symmetric
+        expect(isSameOrigin(b, a)).toBe(true);
+      });
+    }
+  });
+
+  describe("different origin", () => {
+    const differentOrigins = [
+      // Scheme
+      ["http://example.com", "https://example.com"],
+      ["ws://example.com", "wss://example.com"],
+      // Host
+      ["https://example.com", "https://example.org"],
+      // Subdomains are distinct
+      ["https://example.com", "https://www.example.com"],
+      ["https://a.example.com", "https://b.example.com"],
+      // Suffix / prefix lookalikes
+      ["https://example.com", "https://example.com.evil.com"],
+      ["https://example.com", "https://evilexample.com"],
+      // Userinfo must not be mistaken for the host
+      ["https://example.com@evil.com", "https://example.com"],
+      ["https://example.com", "https://evil.com#@example.com"],
+      // Port
+      ["https://example.com:8080", "https://example.com:8081"],
+      ["https://example.com:8080", "https://example.com"],
+      ["http://example.com:443", "https://example.com:443"],
+      // Strict ports: an explicit port never equals an omitted one,
+      // even when it is the scheme's default (no magic normalization)
+      ["https://example.com", "https://example.com:443"],
+      ["http://example.com", "http://example.com:80"],
+      ["ws://example.com", "ws://example.com:80"],
+      ["wss://example.com", "wss://example.com:443"],
+      ["http://example.com:443", "http://example.com"],
+      ["https://example.com:80", "https://example.com"],
+      // IPs
+      ["http://127.0.0.1", "http://localhost"],
+      ["http://[::1]", "http://[::2]"],
+    ];
+
+    for (const [a, b] of differentOrigins) {
+      test(`${a} != ${b}`, () => {
+        expect(isSameOrigin(a, b)).toBe(false);
+        // Symmetric
+        expect(isSameOrigin(b, a)).toBe(false);
+      });
+    }
+  });
+
+  describe("inputs without an origin", () => {
+    // Proposed: a URL without an origin can never be "same origin" as anything,
+    // including itself, mirroring the opaque-origin rule of the web platform.
+    const noOrigin = [
+      ["/foo", "/foo"],
+      ["foo", "foo"],
+      ["", ""],
+      ["/foo", "https://example.com/foo"],
+      ["https://example.com", "/foo"],
+      ["mailto:a@example.com", "mailto:a@example.com"],
+      ["javascript:alert(1)", "javascript:alert(1)"],
+      ["data:text/plain,hi", "data:text/plain,hi"],
+    ];
+
+    for (const [a, b] of noOrigin) {
+      test(`${JSON.stringify(a)} != ${JSON.stringify(b)}`, () => {
+        expect(isSameOrigin(a, b)).toBe(false);
+      });
+    }
+  });
+
+  describe("protocol-relative URLs", () => {
+    // Proposed: `//host` has a host but no scheme, so it is treated as having
+    // no origin (same as relative paths) unless a base is provided.
+    test("//example.com vs //example.com", () => {
+      expect(isSameOrigin("//example.com", "//example.com")).toBe(false);
+    });
+    test("//example.com vs https://example.com", () => {
+      expect(isSameOrigin("//example.com", "https://example.com")).toBe(false);
+    });
+  });
+
+  describe("malformed input", () => {
+    test("does not throw", () => {
+      expect(isSameOrigin("http://", "http://")).toBe(false);
+      expect(isSameOrigin("https://exa mple.com", "https://exa mple.com")).toBe(
+        false,
+      );
+      expect(
+        isSameOrigin("https://example.com:abc", "https://example.com"),
+      ).toBe(false);
+    });
+  });
+
+  // Open questions to settle before implementing:
+  test.todo("trailing dot: https://example.com. vs https://example.com");
+  test.todo("backslashes: https://example.com\\@evil.com (WHATWG treats as /)");
+  test.todo("optional base argument to resolve relative / protocol-relative");
+  test.todo("file: URLs (origin is opaque in WHATWG; same file host?)");
+});
