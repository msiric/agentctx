+
+const ORIGIN_RE = /^([a-z][\d+.a-z-]*):\/\/([^#/?\\]*)/i;
+
+function _getOrigin(input: string): string | undefined {
+  const match = input.trim().match(ORIGIN_RE);
+  if (!match) {
+    return undefined;
+  }
+  const protocol = match[1].toLowerCase();
+  // Userinfo ends at the last "@" of the authority (never leaks past `/?#\`)
+  const authority = match[2].slice(match[2].lastIndexOf("@") + 1);
+  const hostMatch = authority.match(/^(\[[^\]]*\]|[^:]*)(?::(\d*))?$/);
+  if (!hostMatch || !hostMatch[1]) {
+    return undefined;
+  }
+  let hostname: string;
+  try {
+    // Normalizes case, IDN/punycode and IP literals
+    hostname = new URL(`${protocol}://${hostMatch[1]}`).hostname;
+  } catch {
+    return undefined;
+  }
+  if (!hostname) {
+    return undefined;
+  }
+  // Ports are compared literally: an explicit port never equals an omitted one
+  const port = hostMatch[2] ? `:${Number(hostMatch[2])}` : "";
+  return `${protocol}//${hostname}${port}`;
+}
+
+/**
+ * Checks if two URLs have the same origin (scheme, host and port).
+ *
+ * Path, query, hash and credentials are ignored. Ports are compared literally
+ * (`https://a.com` and `https://a.com:443` are **not** the same). Inputs without
+ * an origin (relative, protocol-relative, `mailto:`, `data:`, malformed) are never
+ * the same origin as anything.
+ *
+ * @example
+ *
+ * ```js
+ * isSameOrigin("https://example.com/a", "https://example.com/b?x"); // true
+ * isSameOrigin("https://example.com", "https://example.com:8080"); // false
+ * isSameOrigin("/foo", "/foo"); // false
+ * ```
+ *
+ * @group utils
+ */
+export function isSameOrigin(a: string, b: string): boolean {
+  const originA = _getOrigin(a);
+  return originA !== undefined && originA === _getOrigin(b);
+}
