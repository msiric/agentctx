@@ -2100,3 +2101,64 @@ def test_tuple_key_error_message_does_not_crash():
     with raises(SchemaError) as exc_info:
         Schema({("a", "b"): int}).validate({("a", "b"): "not-an-int"})
     assert "Key '('a', 'b')' error:" in exc_info.value.code
+
+
+def test_length_bytes():
+    assert Length(max=3).validate("abc") == "abc"  # boundary, inclusive
+    with SE:
+        Length(max=3).validate("abcd")
+    assert Length(min=3).validate("abc") == "abc"
+    with SE:
+        Length(min=3).validate("ab")
+    assert Length(min=0, max=0).validate("") == ""
+    # Multibyte: 'é' is 2 bytes, so 2 characters but 4 bytes
+    assert Length(max=4).validate("éé") == "éé"
+    with SE:
+        Length(max=3).validate("éé")
+    with SE:
+        Length(min=5).validate("éé")
+    assert Length(min=2, max=2).validate("é") == "é"
+    # 4-byte character
+    assert Length(max=4).validate("\U0001f600") == "\U0001f600"
+    with SE:
+        Length(max=3).validate("\U0001f600")
+
+
+def test_length_errors():
+    with raises(SchemaError) as exc:
+        Length(max=3).validate("secret")
+    assert "secret" not in str(exc.value)
+    assert "bytes" in str(exc.value)
+    # lone surrogate cannot be encoded
+    with SE:
+        Length(max=10).validate("\ud800")
+    # non-str
+    with SE:
+        Length(max=10).validate(5)
+    with SE:
+        Length(max=10).validate(b"abc")
+    # custom error
+    with raises(SchemaError) as exc:
+        Length(max=1, error="too long").validate("ab")
+    assert str(exc.value) == "too long"
+
+
+def test_length_constructor():
+    for kwargs in ({}, {"min": -1}, {"max": -1}, {"min": 1.5}, {"max": "3"},
+                   {"min": True}, {"min": 5, "max": 3}):
+        with raises(ValueError):
+            Length(**kwargs)
+    assert repr(Length(min=1, max=2)) == "Length(min=1, max=2)"
+
+
+def test_length_in_schema():
+    s = Schema({"name": Length(max=4)})
+    assert s.validate({"name": "éé"}) == {"name": "éé"}
+    with raises(SchemaError) as exc:
+        s.validate({"name": "éée"})
+    assert "Key 'name' error:" in str(exc.value)
+    assert "éée" not in str(exc.value)
+    assert Schema({Length(max=3): int}).validate({"ab": 1}) == {"ab": 1}
+    # no minLength/maxLength: they count characters, not bytes
+    js = Schema({"name": Length(max=4)}).json_schema("x")
+    assert "maxLength" not in str(js) and "minLength" not in str(js)
