+class Length:
+    """
+    Validate that the UTF-8 encoded size of a string, in BYTES (not characters),
+    is within inclusive bounds. Bytes are counted because the values end up in
+    VARCHAR2(n BYTE) columns, where accented characters take more than one byte.
+    """
+
+    def __init__(
+        self,
+        min: Union[int, None] = None,
+        max: Union[int, None] = None,
+        error: Union[str, None] = None,
+    ) -> None:
+        if min is None and max is None:
+            raise ValueError("Length requires at least one of min or max")
+        for name, value in (("min", min), ("max", max)):
+            if value is None:
+                continue
+            if isinstance(value, bool) or not isinstance(value, int):
+                raise ValueError(f"Length {name} must be an int, not {value!r}")
+            if value < 0:
+                raise ValueError(f"Length {name} must not be negative, got {value}")
+        if min is not None and max is not None and min > max:
+            raise ValueError(f"Length min ({min}) must not be greater than max ({max})")
+        self._min: Union[int, None] = min
+        self._max: Union[int, None] = max
+        self._error: Union[str, None] = error
+
+    def __repr__(self) -> str:
+        args = []
+        if self._min is not None:
+            args.append(f"min={self._min!r}")
+        if self._max is not None:
+            args.append(f"max={self._max!r}")
+        return f"{self.__class__.__name__}({', '.join(args)})"
+
+    def _bounds(self) -> str:
+        if self._min is not None and self._max is not None:
+            return f"between {self._min} and {self._max} bytes"
+        if self._min is not None:
+            return f"at least {self._min} bytes"
+        return f"at most {self._max} bytes"
+
+    def validate(self, data: str, **kwargs: Any) -> str:
+        """
+        Validates the UTF-8 byte length of data.
+        :param data: String to be validated.
+        :return: Returns validated data.
+        """
+        e = self._error
+
+        def fail(default: str) -> "SchemaError":
+            # Like Regex, put the message in autos so that the
+            # "Key 'x' error:" prefix is kept. Data is never echoed by default.
+            return SchemaError(e.format(data) if e else default)
+
+        if not isinstance(data, str):
+            raise fail(f"expected a string, got {type(data).__name__}")
+        try:
+            size = len(data.encode("utf-8"))
+        except UnicodeEncodeError:
+            raise fail("string cannot be encoded as UTF-8")
+        if (self._min is not None and size < self._min) or (
+            self._max is not None and size > self._max
+        ):
+            raise fail(f"length must be {self._bounds()} (UTF-8), got {size} bytes")
+        return data
+
+
