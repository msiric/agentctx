+"""Custom JMESPath functions for the dashboards."""
+from decimal import Decimal, ROUND_HALF_UP
+
+from jmespath import parser
+from jmespath.functions import Functions, signature
+from jmespath.visitor import Options
+
+
+class DashboardFunctions(Functions):
+
+    @signature({"types": ['number']}, {"types": ['number']})
+    def _func_round_to(self, number, digits):
+        # Half-to-even (banker's) rounding, matching Python's round() and
+        # pandas, so dashboard values agree with the pandas reports.
+        digits = int(digits)
+        if digits == 0:
+            # round(x) returns an int, so round_to(2.5, 0) is 2, not 2.0.
+            return round(number)
+        return round(number, digits)
+
+    @signature({"types": ['number']}, {"types": ['number']},
+               {"types": ['number']})
+    def _func_clamp(self, value, lo, hi):
+        # Restrict value to the inclusive range [lo, hi]. No rounding is
+        # done; the input number is returned unchanged when in range.
+        if lo > hi:
+            raise ValueError("clamp: lo (%s) must not exceed hi (%s)"
+                             % (lo, hi))
+        return max(lo, min(value, hi))
+
+    @signature({"types": ['number']}, {"types": ['number']},
+               {"types": ['number']})
+    def _func_percent(self, part, whole, digits):
+        # part / whole * 100, rounded half away from zero (like Excel, per
+        # Finance), NOT half-to-even like round_to. Decimal avoids binary
+        # float artifacts (e.g. 1.005 stays a true tie).
+        if whole == 0:
+            return None
+        digits = int(digits)
+        value = Decimal(repr(part)) / Decimal(repr(whole)) * 100
+        rounded = value.quantize(Decimal(1).scaleb(-digits),
+                                 rounding=ROUND_HALF_UP)
+        if digits <= 0:
+            return int(rounded)
+        return float(rounded)
+
+
+def search(expression, data, options=None):
+    if options is None:
+        options = Options(custom_functions=DashboardFunctions())
+    return parser.Parser().parse(expression).search(data, options=options)
