--- a/test.js
+++ b/test.js
@@ -292,3 +292,36 @@ test('keep the sub-day parts exact at any magnitude', () => {
 		assert.strictEqual(parsed.hours, Number(bigint.hours), `${milliseconds}ms hours against the bigint path`);
 	}
 });
+
+test('largestUnit rolls larger units into the chosen one', () => {
+	const milliseconds = 93_600_000 + 61_000 + 5; // 1d 2h 1m 1s 5ms
+
+	assert.deepStrictEqual(parseMilliseconds(milliseconds), parseMilliseconds(milliseconds, {largestUnit: 'days'}));
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit: 'hours'}), {
+		days: 0, hours: 26, minutes: 1, seconds: 1, milliseconds: 5, microseconds: 0, nanoseconds: 0,
+	});
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit: 'minutes'}), {
+		days: 0, hours: 0, minutes: 1561, seconds: 1, milliseconds: 5, microseconds: 0, nanoseconds: 0,
+	});
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit: 'seconds'}), {
+		days: 0, hours: 0, minutes: 0, seconds: 93_661, milliseconds: 5, microseconds: 0, nanoseconds: 0,
+	});
+	assert.deepStrictEqual(parseMilliseconds(-milliseconds, {largestUnit: 'hours'}), {
+		days: 0, hours: -26, minutes: -1, seconds: -1, milliseconds: -5, microseconds: -0, nanoseconds: -0,
+	});
+});
+
+test('largestUnit works with bigint', () => {
+	assert.deepStrictEqual(parseMilliseconds(93_600_005n, {largestUnit: 'hours'}), {
+		days: 0n, hours: 26n, minutes: 0n, seconds: 0n, milliseconds: 5n, microseconds: 0n, nanoseconds: 0n,
+	});
+	assert.strictEqual(parseMilliseconds(93_600_000n, {largestUnit: 'seconds'}).seconds, 93_600n);
+	assert.strictEqual(parseMilliseconds(10n ** 30n, {largestUnit: 'seconds'}).seconds, 10n ** 27n);
+});
+
+test('largestUnit throws a TypeError for other values', () => {
+	for (const largestUnit of ['weeks', 'Days', 'milliseconds', '', 5, null, {}]) {
+		assert.throws(() => parseMilliseconds(1000, {largestUnit}), {name: 'TypeError', message: /^parse-ms: /v});
+		assert.throws(() => parseMilliseconds(1000n, {largestUnit}), TypeError);
+	}
+});
