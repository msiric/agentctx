--- a/addict/addict.py
+++ b/addict/addict.py
@@ -75,17 +75,34 @@ class Dict(dict):
         del self[name]
 
     def to_dict(self):
-        base = {}
-        for key, value in self.items():
-            if isinstance(value, type(self)):
-                base[key] = value.to_dict()
-            elif isinstance(value, (list, tuple)):
-                base[key] = type(value)(
-                    item.to_dict() if isinstance(item, type(self)) else
-                    item for item in value)
-            else:
-                base[key] = value
-        return base
+        def unwrap(value):
+            if isinstance(value, Dict):
+                return value.to_dict()
+            if isinstance(value, (list, tuple)):
+                return type(value)(unwrap(item) for item in value)
+            return value
+
+        return {key: unwrap(value) for key, value in self.items()}
+
+    def flatten(self, separator='__'):
+        """Return a plain dict with one entry per leaf value.
+
+        Keys are the paths of nested keys joined with `separator`.
+        Lists, tuples and other non-dict values are leaves and are
+        returned unchanged.
+        """
+        flat = {}
+
+        def walk(mapping, prefix):
+            for key, value in mapping.items():
+                path = prefix + separator + str(key) if prefix else str(key)
+                if isinstance(value, dict):
+                    walk(value, path)
+                else:
+                    flat[path] = value
+
+        walk(self, '')
+        return flat
 
     def copy(self):
         return copy.copy(self)
