+    def test_to_dict_with_nested_lists(self):
+        nested = {'a': [[{'b': 1}], ({'c': 2},)]}
+        prop = self.dict_class(nested)
+        regular = prop.to_dict()
+        self.assertEqual(regular, nested)
+        self.assertNotIsInstance(regular['a'][0][0], self.dict_class)
+        self.assertIs(type(regular['a'][0][0]), dict)
+        self.assertIsInstance(regular['a'][1], tuple)
+        self.assertIs(type(regular['a'][1][0]), dict)
+
+    def test_flatten(self):
+        d = self.dict_class({'db': {'host': 'x', 'port': 1}, 'name': 'n'})
+        flat = d.flatten()
+        self.assertIs(type(flat), dict)
+        self.assertEqual(flat, {'db__host': 'x', 'db__port': 1, 'name': 'n'})
+
+    def test_flatten_deep_and_separator(self):
+        d = self.dict_class()
+        d.a.b.c = 1
+        self.assertEqual(d.flatten(), {'a__b__c': 1})
+        self.assertEqual(d.flatten('.'), {'a.b.c': 1})
+
+    def test_flatten_lists_are_leaves(self):
+        d = self.dict_class({'a': [{'b': 1}, 2], 't': (1, 2), 'n': None})
+        flat = d.flatten()
+        self.assertEqual(set(flat), {'a', 't', 'n'})
+        self.assertEqual(flat['a'], [{'b': 1}, 2])
+        self.assertEqual(flat['t'], (1, 2))
+
+    def test_flatten_empty_and_non_string_keys(self):
+        self.assertEqual(self.dict_class().flatten(), {})
+        self.assertEqual(self.dict_class({1: {2: 'x'}}).flatten(), {'1__2': 'x'})
+
