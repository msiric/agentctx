+  it('uses hours as the largest unit', () => {
+    expect(format(86400000, { compound: true })).toBe('24h');
+    expect(format(91800000, { compound: true })).toBe('25h30m');
+    expect(format(10 * 86400000, { compound: true })).toBe('240h');
+  });
