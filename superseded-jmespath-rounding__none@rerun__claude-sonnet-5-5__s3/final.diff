+from tests import unittest
+
+from jmespath import exceptions
+from jmespath.dashboard import search
+
+
+class TestClamp(unittest.TestCase):
+
+    def test_within_range_unchanged(self):
+        self.assertEqual(search('clamp(@, `0`, `10`)', 5), 5)
+
+    def test_below_and_above(self):
+        self.assertEqual(search('clamp(@, `0`, `10`)', -3), 0)
+        self.assertEqual(search('clamp(@, `0`, `10`)', 12.5), 10)
+
+    def test_bounds_inclusive(self):
+        self.assertEqual(search('clamp(@, `0`, `10`)', 0), 0)
+        self.assertEqual(search('clamp(@, `0`, `10`)', 10), 10)
+
+    def test_does_not_round(self):
+        self.assertEqual(search('clamp(@, `0`, `10`)', 2.5), 2.5)
+
+    def test_lo_greater_than_hi_rejected(self):
+        with self.assertRaises(exceptions.JMESPathError):
+            search('clamp(@, `10`, `0`)', 5)
+
+    def test_non_number_rejected(self):
+        with self.assertRaises(exceptions.JMESPathTypeError):
+            search('clamp(@, `0`, `10`)', 'x')
+
+
+class TestPercent(unittest.TestCase):
+
+    def test_basic(self):
+        self.assertEqual(search('percent(`1`, `4`, `0`)', {}), 25)
+        self.assertEqual(search('percent(`1`, `3`, `2`)', {}), 33.33)
+
+    def test_over_100_and_negative(self):
+        self.assertEqual(search('percent(`3`, `2`, `0`)', {}), 150)
+        self.assertEqual(search('percent(`-1`, `4`, `0`)', {}), -25)
+
+    def test_fields(self):
+        self.assertEqual(
+            search('percent(a, b, `1`)', {'a': 1, 'b': 8}), 12.5)
+
+    def test_zero_whole_rejected(self):
+        with self.assertRaises(exceptions.JMESPathError):
+            search('percent(`1`, `0`, `1`)', {})
+
+    def test_non_integer_digits_rejected(self):
+        with self.assertRaises(exceptions.JMESPathTypeError):
+            search('percent(`1`, `2`, `1.5`)', {})
+
+    def test_non_number_rejected(self):
+        with self.assertRaises(exceptions.JMESPathTypeError):
+            search('percent(`"x"`, `2`, `1`)', {})
+
+
+class TestRoundTo(unittest.TestCase):
+
+    def test_rounds_half_to_even_at_zero_digits(self):
+        # Matches Python's round() and pandas, which the dashboards are
+        # checked against. Half-way cases go to the nearest even number.
+        for value, expected in [(0.5, 0), (1.5, 2), (2.5, 2), (3.5, 4),
+                                (-0.5, 0), (-1.5, -2), (-2.5, -2)]:
+            self.assertEqual(search('round_to(@, `0`)', value), expected,
+                             value)
+
+    def test_literal_two_point_five_is_two(self):
+        self.assertEqual(search('round_to(`2.5`, `0`)', {}), 2)
+
+    def test_rounds_half_to_even_with_digits(self):
+        # 0.125, 0.375 and 2.675's neighbours are exactly representable.
+        self.assertEqual(search('round_to(@, `2`)', 0.125), 0.12)
+        self.assertEqual(search('round_to(@, `2`)', 0.375), 0.38)
+
+    def test_negative_digits(self):
+        self.assertEqual(search('round_to(@, `-1`)', 25), 20)
+        self.assertEqual(search('round_to(@, `-1`)', 35), 40)
+
+    def test_non_integer_digits_rejected(self):
+        with self.assertRaises(exceptions.JMESPathTypeError):
+            search('round_to(@, `1.5`)', 1)
+
+    def test_builtins_still_available(self):
+        self.assertEqual(search('abs(@)', -3), 3)
