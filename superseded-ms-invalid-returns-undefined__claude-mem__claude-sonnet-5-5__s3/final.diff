+/**
+ * Parse a compound duration such as `"1h 30m"` or `"2 days 4 hours"` and
+ * return the total in milliseconds. Each piece is parsed with `parse`.
+ *
+ * @param str - A string made of one or more `parse`-compatible pieces
+ * @returns The total in milliseconds
+ * @throws TypeError if `str` is not a valid compound duration
+ */
+export function parseCompound(str: string): number {
+  const invalid = () =>
+    new TypeError(
+      `Value provided to ms.parseCompound() must be a valid duration string such as "1h 30m". value=${JSON.stringify(str)}`,
+    );
+  if (typeof str !== "string" || str.length === 0 || str.length > 100) {
+    throw invalid();
+  }
+  const matches = [...str.matchAll(/-?\d*\.?\d+ *[a-z]*/gi)];
+  // Pieces may be separated by whitespace and/or a single comma. Leading or
+  // trailing commas, repeated commas, and any other leftover text are invalid.
+  let end = 0;
+  for (const [i, m] of matches.entries()) {
+    const gap = str.slice(end, m.index);
+    if (!(i === 0 ? /^\s*$/ : /^\s*,?\s*$/).test(gap)) {
+      throw invalid();
+    }
+    end = m.index + m[0].length;
+  }
+  if (matches.length === 0 || str.slice(end).trim() !== "") {
+    throw invalid();
+  }
+  const pieces = matches.map((m) => m[0].trim());
+  // With multiple pieces, each one must carry an explicit unit.
+  if (pieces.length > 1 && pieces.some((p) => !/[a-z]$/i.test(p))) {
+    throw invalid();
+  }
+  const total = pieces.reduce((sum, p) => sum + parse(p), 0);
+  if (Number.isNaN(total)) {
+    throw invalid();
+  }
+  return total;
+}
+
+/**
+ * Parse a timer-style clock string and return the total in milliseconds.
+ * `"m:ss"` (e.g. `"1:30"`) and `"h:mm:ss"` (e.g. `"01:02:03"`) are supported,
+ * with optional fractional seconds (e.g. `"1:30.5"`). The leading field may
+ * have any number of digits; the remaining fields must be two digits and
+ * the minutes and seconds fields must be below 60.
+ *
+ * Unlike `parseCompound`, this returns `undefined` on invalid input.
+ *
+ * @param str - A clock string such as `"1:30"` or `"01:02:03"`
+ * @returns The total in milliseconds, or `undefined` if `str` is invalid
+ */
+export function parseClock(str: string): number | undefined {
+  if (typeof str !== "string" || str.length > 100) {
+    return undefined;
+  }
+  const match = /^(?:(\d+):(\d{2})|(\d+)):(\d{2}(?:\.\d+)?)$/.exec(str);
+  if (!match) {
+    return undefined;
+  }
+  const hours = match[2] === undefined ? 0 : Number(match[1]);
+  const minutes = Number(match[2] ?? match[3]);
+  const seconds = Number(match[4]);
+  if (seconds >= 60 || (match[2] !== undefined && minutes >= 60)) {
+    return undefined;
+  }
+  return Math.round(((hours * 60 + minutes) * 60 + seconds) * 1000);
+}
