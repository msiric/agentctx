+++ b/src/parse-compound.test.ts
@@ -0,0 +1,72 @@
+import { describe, expect, it } from '@jest/globals';
+import { parseCompound } from './index';
+
+describe('parseCompound(string)', () => {
+  it('should sum compact pieces', () => {
+    expect(parseCompound('1h 30m')).toBe(5400000);
+  });
+
+  it('should sum pieces with long units', () => {
+    expect(parseCompound('2 days 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
+  });
+
+  it('should handle pieces without separators', () => {
+    expect(parseCompound('1h30m')).toBe(5400000);
+  });
+
+  it('should handle three or more pieces and decimals', () => {
+    expect(parseCompound('1d 2h 3m 4s 5ms')).toBe(
+      86400000 + 7200000 + 180000 + 4000 + 5,
+    );
+    expect(parseCompound('1.5h 30m')).toBe(7200000);
+  });
+
+  it('should accept an optional comma between pieces', () => {
+    expect(parseCompound('1h, 30m')).toBe(5400000);
+    expect(parseCompound('1h,30m')).toBe(5400000);
+    expect(parseCompound('1h , 30m')).toBe(5400000);
+    expect(parseCompound('2 days, 4 hours, 5 minutes')).toBe(
+      2 * 86400000 + 4 * 3600000 + 5 * 60000,
+    );
+    expect(parseCompound(' 1h, 30m ')).toBe(5400000);
+  });
+
+  it('should be case insensitive', () => {
+    expect(parseCompound('1H 30M')).toBe(5400000);
+  });
+
+  it('should behave like parse for a single piece', () => {
+    expect(parseCompound('1m')).toBe(60000);
+    expect(parseCompound('100')).toBe(100);
+    expect(parseCompound('-1h')).toBe(-3600000);
+  });
+
+  it('should throw a TypeError including the input for invalid strings', () => {
+    for (const input of [
+      '',
+      'abc',
+      '1h foo',
+      ',1h',
+      '1h,',
+      '1h,, 30m',
+      '1h , , 30m',
+      '1,5h',
+      '1h; 30m',
+      '1h 30m 5x',
+      '5x',
+      '1 30',
+      '1h 30',
+      '1h '.repeat(40),
+    ]) {
+      expect(() => parseCompound(input)).toThrow(TypeError);
+      expect(() => parseCompound(input)).toThrow(JSON.stringify(input));
+    }
+  });
+
+  it('should throw a TypeError for non-string values', () => {
+    // @ts-expect-error testing invalid input
+    expect(() => parseCompound(5)).toThrow(TypeError);
+    // @ts-expect-error testing invalid input
+    expect(() => parseCompound(undefined)).toThrow(TypeError);
+  });
+});
