  it('should return NaN for invalid input', () => {
    expect(parseCompound('abc')).toBeNaN();
    expect(parseCompound('1h, 30m')).toBeNaN();
    expect(parseCompound('1h 30m foo')).toBeNaN();
    expect(parseCompound('1h 30m 5x')).toBeNaN();
  });

  it('should return NaN when a piece in a compound has no unit', () => {
    expect(parseCompound('1 30')).toBeNaN();
    expect(parseCompound('1h 30')).toBeNaN();
  });

  it('should throw for empty, too long, or non-string values', () => {
    expect(() => parseCompound('')).toThrow();
    expect(() => parseCompound('1h '.repeat(40))).toThrow();
    // @ts-expect-error testing invalid input
    expect(() => parseCompound(5)).toThrow();
  });
});
