/**
 * Parse a compound duration such as `"1h 30m"` or `"2 days 4 hours"` and
 * return the total in milliseconds. Each piece is parsed with `parse`.
 *
 * @param str - A string made of one or more `parse`-compatible pieces
 * @returns The total in milliseconds, or `NaN` if any part can't be parsed
 */
export function parseCompound(str: string): number {
  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
    // Let parse() throw its standard error for invalid input.
    return parse(str);
  }
  const pieceRe = /-?\d*\.?\d+ *[a-z]*/gi;
  const pieces = str.match(pieceRe)?.map((p) => p.trim());
  // Anything left over after removing the pieces (e.g. "," or "abc") is invalid.
  if (!pieces || str.replace(pieceRe, '').trim() !== '') {
    return NaN;
  }
  if (pieces.length === 1) {
    return parse(pieces[0] as string);
  }
  // With multiple pieces, each one must carry an explicit unit.
  if (pieces.some((p) => !/[a-z]$/i.test(p))) {
    return NaN;
  }
  return pieces.reduce((total, p) => total + parse(p), 0);
}
EOF
