 def test_obj_to_str_mapping(obj, expected_str, multiline_strings):
     assert tomli_w.dumps(obj, multiline_strings=multiline_strings) == expected_str
+
+
+@pytest.mark.parametrize(
+    "obj,expected_str",
+    [
+        ({"a": None}, 'a = ""\n'),
+        ({"a": None, "b": 1}, 'a = ""\nb = 1\n'),
+        ({"t": {"a": None, "b": 1}}, '[t]\na = ""\nb = 1\n'),
+        ({"t": {"a": None}}, '[t]\na = ""\n'),
+        ({"a": [None]}, 'a = [\n    "",\n]\n'),
+        ({"a": [1, None]}, 'a = [\n    1,\n    "",\n]\n'),
+        ({"a": [[None, 1]]}, 'a = [\n    [\n        "",\n        1,\n    ],\n]\n'),
+        ({"a": [{"x": None, "y": 1}]}, 'a = [\n    { x = "", y = 1 },\n]\n'),
+        ({"a": {"b": [None]}}, '[a]\nb = [\n    "",\n]\n'),
+    ],
+)
+def test_none_values_written_as_empty_string(obj, expected_str):
+    assert tomli_w.dumps(obj) == expected_str
+
+
+def test_none_values_dump():
+    import io
+
+    buf = io.BytesIO()
+    tomli_w.dump({"a": None, "b": [None]}, buf)
+    assert buf.getvalue() == b'a = ""\nb = [\n    "",\n]\n'
+
+
+def test_none_roundtrip():
+    out = tomli_w.dumps({"a": None, "b": [1, None], "t": {"c": None}})
+    assert tomli.loads(out) == {"a": "", "b": [1, ""], "t": {"c": ""}}
+
+
+@pytest.mark.parametrize("path_cls", [Path, PurePosixPath])
+def test_path_values(path_cls):
+    p = path_cls("/tmp/some dir/file.txt")
+    expected = f'a = "{p}"\nb = [\n    "{p}",\n]\n\n[t]\nc = "{p}"\n'
+    assert tomli_w.dumps({"a": p, "b": [p], "t": {"c": p}}) == expected
+
+
+def test_path_values_in_table_and_roundtrip():
+    p = Path("rel/dir")
+    out = tomli_w.dumps({"t": {"p": p}})
+    assert out == f'[t]\np = "{p}"\n'
+    assert tomli.loads(out) == {"t": {"p": str(p)}}
