+def test_yaml_storage(tmpdir):
+    pytest.importorskip('yaml')
+    from tinydb.storages import YAMLStorage
+
+    path = str(tmpdir.join('sub', 'test.yaml'))
+    with TinyDB(path, storage=YAMLStorage, create_dirs=True) as db:
+        db.insert({'name': 'a', 'tags': [1, 2]})
+        db.insert(Document({'name': 'b'}, doc_id=7))
+        db.table('other').insert({'x': 1})
+        db.update({'name': 'foo'}, doc_ids=[1])
+
+    text = open(path).read()
+    assert '!' not in text
+
+    with TinyDB(path, storage=YAMLStorage) as db:
+        assert db.get(doc_id=1) == {'name': 'foo', 'tags': [1, 2]}
+        assert db.get(doc_id=7) == {'name': 'b'}
+        assert db.table('other').all() == [{'x': 1}]
+        assert len(db) == 2
+
+
+def test_yaml_storage_empty_and_shrink(tmpdir):
+    pytest.importorskip('yaml')
+    from tinydb.storages import YAMLStorage
+
+    path = str(tmpdir.join('t.yaml'))
+    storage = YAMLStorage(path)
+    assert storage.read() is None
+    storage.write({'_default': {'1': {'text': 'x' * 100}}})
+    storage.write({'_default': {}})
+    assert storage.read() == {'_default': {}}
+    storage.close()
+
+
+def test_yaml_storage_readonly(tmpdir):
+    pytest.importorskip('yaml')
+    from tinydb.storages import YAMLStorage
+
+    path = str(tmpdir.join('t.yaml'))
+    YAMLStorage(path).close()
+    storage = YAMLStorage(path, access_mode='r')
+    with pytest.raises(IOError):
+        storage.write({})
+    storage.close()
