diff --git a/test/byte-parse.js b/test/byte-parse.js
index cebfab2..df3c8cc 100644
--- a/test/byte-parse.js
+++ b/test/byte-parse.js
@@ -108,4 +108,38 @@ describe('Test byte parse function', function(){
   it('Should allow whitespace', function(){
     assert.equal(bytes.parse('1 TB'), 1 * Math.pow(1024, 4));
   });
+
+  describe('decimal option', function(){
+    it('Should use powers of 1000 for units', function(){
+      var o = {decimal: true};
+      assert.strictEqual(bytes.parse('1kB', o), 1000);
+      assert.strictEqual(bytes.parse('1MB', o), 1e6);
+      assert.strictEqual(bytes.parse('1GB', o), 1e9);
+      assert.strictEqual(bytes.parse('1TB', o), 1e12);
+      assert.strictEqual(bytes.parse('1PB', o), 1e15);
+    });
+
+    it('Should floor fractional bytes', function(){
+      assert.strictEqual(bytes.parse('1.5kB', {decimal: true}), 1500);
+      assert.strictEqual(bytes.parse('1.0005kB', {decimal: true}), 1000);
+      assert.strictEqual(bytes.parse('-1.0005kB', {decimal: true}), -1001);
+    });
+
+    it('Should not change plain numbers or bytes', function(){
+      assert.strictEqual(bytes.parse(1024, {decimal: true}), 1024);
+      assert.strictEqual(bytes.parse('1024', {decimal: true}), 1024);
+      assert.strictEqual(bytes.parse('foobar', {decimal: true}), null);
+    });
+
+    it('Should keep binary units without the option', function(){
+      assert.strictEqual(bytes.parse('1kB'), 1024);
+      assert.strictEqual(bytes.parse('1kB', {}), 1024);
+      assert.strictEqual(bytes.parse('1kB', {decimal: false}), 1024);
+    });
+
+    it('Should work via the default export', function(){
+      assert.strictEqual(bytes('1kB', {decimal: true}), 1000);
+      assert.strictEqual(bytes('1kB'), 1024);
+    });
+  });
 });
