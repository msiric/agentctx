diff --git a/test/test_cli.py b/test/test_cli.py
index 154f1a2..5a707b0 100644
--- a/test/test_cli.py
+++ b/test/test_cli.py
@@ -483,3 +483,21 @@ def test_inprocess_jsonl_malformed_headers():
     )
     # output should still be produced (graceful fallback), with raw keys as headers
     assert out.strip() != ""
+
+
+def test_inprocess_jsonl_skips_blank_lines():
+    """In-process: JSONL input with trailing blank lines is accepted"""
+    out = run_main_in_process(
+        ["-r", "jsonl", "-f", "tsv"], input_text='{"a": 1}\n{"a": 2}\n\n\n'
+    )
+    assert out == run_main_in_process(
+        ["-r", "jsonl", "-f", "tsv"], input_text='{"a": 1}\n{"a": 2}\n'
+    )
+
+
+def test_inprocess_jsonl_missing_key_uses_dot():
+    """Records lacking a key get '.' (no extra flags needed)."""
+    inp = '{"a": 1, "b": 2}\n{"a": 3}\n\n'
+    out = run_main_in_process(["-r", "jsonl", "-f", "tsv"], input_text=inp)
+    rows = [[c.strip() for c in l.split("\t")] for l in out.splitlines()]
+    assert rows == [["a", "b"], ["1", "2"], ["3", "."]]
