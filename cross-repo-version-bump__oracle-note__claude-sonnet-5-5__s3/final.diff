diff --git a/test/count.js b/test/count.js
new file mode 100644
index 0000000..805737e
--- /dev/null
+++ b/test/count.js
@@ -0,0 +1,40 @@
+const test = require('tape');
+const fn = require('../lib');
+
+test('count :: short flags', t => {
+	t.deepEqual(fn(['-vvv'], { count: 'v' }), { _: [], v: 3 });
+	t.deepEqual(fn(['-v', '-v'], { count: ['v'] }), { _: [], v: 2 });
+	t.deepEqual(fn(['-v'], { count: 'v' }), { _: [], v: 1 });
+	t.end();
+});
+
+test('count :: long flags', t => {
+	t.deepEqual(fn(['--verbose', '--verbose'], { count: 'verbose' }), { _: [], verbose: 2 });
+	t.end();
+});
+
+test('count :: does not consume values', t => {
+	t.deepEqual(fn(['-vv', 'foo'], { count: 'v' }), { _: ['foo'], v: 2 });
+	t.end();
+});
+
+test('count :: alias', t => {
+	const opts = { count: 'v', alias: { v: 'verbose' } };
+	t.deepEqual(fn(['-v', '--verbose', '-v'], opts), { _: [], v: 3, verbose: 3 });
+	t.end();
+});
+
+test('count :: mixed with other flags', t => {
+	t.deepEqual(fn(['-vvx', '--name=a'], { count: 'v' }), { _: [], v: 2, x: true, name: 'a' });
+	t.end();
+});
+
+test('count :: --no- resets to 0', t => {
+	t.deepEqual(fn(['--no-v'], { count: 'v' }), { _: [], v: 0 });
+	t.end();
+});
+
+test('count :: unspecified flags unaffected', t => {
+	t.deepEqual(fn(['-vv']), { _: [], v: [true, true] });
+	t.end();
+});
