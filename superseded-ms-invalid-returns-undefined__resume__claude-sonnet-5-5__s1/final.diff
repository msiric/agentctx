+import { describe, expect, it } from '@jest/globals';
+import { parseCompound } from './index';
+
+describe('parseCompound(string)', () => {
+  it('should parse a single piece like parse()', () => {
+    expect(parseCompound('1h')).toBe(3600000);
+    expect(parseCompound('100')).toBe(100);
+  });
+
+  it('should sum short compound durations', () => {
+    expect(parseCompound('1h 30m')).toBe(5400000);
+    expect(parseCompound('1h30m')).toBe(5400000);
+  });
+
+  it('should sum long compound durations', () => {
+    expect(parseCompound('2 days 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
+  });
+
+  it('should accept commas between parts', () => {
+    expect(parseCompound('1h, 30m')).toBe(5400000);
+    expect(parseCompound('1h,30m')).toBe(5400000);
+    expect(parseCompound('1h , 30m, 10s')).toBe(5410000);
+  });
+
+  it.each([',1h', '1h,', '1h,,30m', '1h, ,30m', ','])(
+    'should reject misplaced commas in %j',
+    (input) => {
+      expect(() => parseCompound(input)).toThrow(TypeError);
+    },
+  );
+
+  it('should support decimals and mixed case', () => {
+    expect(parseCompound('1.5h 30M')).toBe(7200000);
+  });
+
+  it('should tolerate surrounding whitespace', () => {
+    expect(parseCompound('  1m   30s ')).toBe(90000);
+  });
+
+  it.each(['abc', '1h foo', '1h 30', '1h 30x', '   ', '', '1h '.repeat(40)])(
+    'should throw a TypeError including the input for %j',
+    (input) => {
+      expect(() => parseCompound(input)).toThrow(TypeError);
+      expect(() => parseCompound(input)).toThrow(JSON.stringify(input));
+    },
+  );
+
+  it('should throw a TypeError for non-string input', () => {
+    // @ts-expect-error testing runtime behavior
+    expect(() => parseCompound(5)).toThrow(TypeError);
+  });
+});
