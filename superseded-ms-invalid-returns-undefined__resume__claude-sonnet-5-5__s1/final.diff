+/**
+ * Parse a compound duration such as `"1h 30m"` or `"2 days 4 hours"` and
+ * return the total in milliseconds. Each piece is parsed with {@link parse}.
+ *
+ * @param str - A string made of one or more `<number><unit>` pieces
+ * @returns The summed value in milliseconds
+ * @throws TypeError if `str` is not a string of 1 to 100 characters, or if any
+ * piece can't be parsed
+ */
+export function parseCompound(str: string): number {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw new TypeError(
+      `Value provided to ms.parseCompound() must be a string with length between 1 and 100. value=${JSON.stringify(str)}`,
+    );
+  }
+  const invalid = () =>
+    new TypeError(
+      `Invalid compound duration provided to ms.parseCompound(). value=${JSON.stringify(str)}`,
+    );
+  const piece = /-?\d*\.?\d+ *[a-z]*/iy;
+  const pieces: string[] = [];
+  let i = 0;
+  while (i < str.length) {
+    const ws = /\s*/y;
+    ws.lastIndex = i;
+    ws.exec(str);
+    i = ws.lastIndex;
+    if (i >= str.length) break;
+    // A single comma may separate pieces, e.g. "1h, 30m".
+    if (str[i] === ',') {
+      if (pieces.length === 0) throw invalid();
+      ws.lastIndex = i + 1;
+      ws.exec(str);
+      i = ws.lastIndex;
+      if (i >= str.length) throw invalid();
+    }
+    piece.lastIndex = i;
+    const match = piece.exec(str);
+    if (!match) throw invalid();
+    pieces.push(match[0]);
+    i = piece.lastIndex;
+  }
+  if (pieces.length === 0) throw invalid();
+  // A bare number is only meaningful on its own, e.g. "100".
+  if (pieces.length > 1 && pieces.some((p) => /^-?[\d.]+$/.test(p))) {
+    throw invalid();
+  }
+  let total = 0;
+  for (const p of pieces) {
+    const n = parse(p);
+    if (Number.isNaN(n)) throw invalid();
+    total += n;
+  }
+  return total;
+}
+
+/**
+ * Parse a timer-style string and return milliseconds. `"m:ss"` (e.g. `"1:30"`)
+ * and `"h:mm:ss"` (e.g. `"01:02:03"`) are supported. Seconds, and minutes when
+ * hours are present, must be two digits and below 60.
+ *
+ * Unlike {@link parseCompound}, this never throws: invalid input (including
+ * non-string input) returns `undefined`.
+ *
+ * @param str - A clock-style duration
+ * @returns The value in milliseconds, or `undefined` if `str` is invalid
+ */
+export function parseClock(str: string): number | undefined {
+  if (typeof str !== 'string' || str.length > 100) return undefined;
+  const match = /^(?:(\d+):([0-5]\d)|(\d+)):([0-5]\d)$/.exec(str);
+  if (!match) return undefined;
+  const [, h, mm, m, ss] = match;
+  const seconds = Number(ss);
+  if (h !== undefined) {
+    return (Number(h) * 3600 + Number(mm) * 60 + seconds) * 1000;
+  }
+  return (Number(m) * 60 + seconds) * 1000;
+}
