diff --git a/tests/test_pysemver-cli.py b/tests/test_pysemver-cli.py
index 9933b0d..a5ccb69 100644
--- a/tests/test_pysemver-cli.py
+++ b/tests/test_pysemver-cli.py
@@ -155,3 +155,40 @@ def test_should_return_documented_error_code_for_invalid_version(cliargs, capsys
     # docs/pysemver.rst shows ``echo $?`` printing 2 for both commands
     assert main(cliargs) == 2
     assert capsys.readouterr().err.startswith("ERROR")
+
+
+@pytest.mark.parametrize(
+    "cliargs,expected",
+    [
+        (["bump", "major", "v1.4.2"], "2.0.0"),
+        (["bump", "minor", "V1.4.2"], "1.5.0"),
+        (["bump", "patch", "v1.4.2"], "1.4.3"),
+        (["bump", "prerelease", "v1.4.2-rc.1"], "1.4.2-rc.2"),
+        (["bump", "build", "v1.4.2+build.1"], "1.4.2+build.2"),
+        (["compare", "v1.4.2", "v1.4.3"], "-1"),
+        (["compare", "V2.0.0", "1.0.0"], "1"),
+        (["compare", "1.0.0", "v1.0.0"], "0"),
+        (["nextver", "v1.4.2", "patch"], "1.4.3"),
+        (["check", "v1.4.2"], ""),
+    ],
+)
+def test_cli_accepts_leading_v(cliargs, expected, capsys):
+    from semver.cli import main
+    assert main(cliargs) == 0
+    assert capsys.readouterr().out.strip() == expected
+
+
+@pytest.mark.parametrize(
+    "cliargs",
+    [
+        ["check", "vv1.4.2"],
+        ["check", "v"],
+        ["bump", "major", "vv1.4.2"],
+        ["compare", "1.0.0", "vv1.0.0"],
+        ["nextver", "v", "patch"],
+    ],
+)
+def test_cli_rejects_other_v_prefixes(cliargs, capsys):
+    from semver.cli import main
+    assert main(cliargs) == 2
+    assert "ERROR" in capsys.readouterr().err
