+
+
+def test_check_reports_changed_files(tmpdir, capsys):
+    good = tmpdir.join('good.sql')
+    good.write('select 1\n')
+    bad = tmpdir.join('bad.sql')
+    bad.write('select 1\n')
+    args = ['--check', '-k', 'upper']
+    assert sqlparse.cli.main(args + [str(good), str(bad)]) == 1
+    out = capsys.readouterr().out
+    assert out.splitlines() == [str(good), str(bad)]
+    assert good.read() == 'select 1\n'  # nothing written
+
+
+def test_check_clean_exit_zero(tmpdir, capsys):
+    f = tmpdir.join('ok.sql')
+    f.write('SELECT 1\n')
+    assert sqlparse.cli.main(['--check', '-k', 'upper', str(f)]) == 0
+    assert capsys.readouterr().out == ''
+
+
+def test_check_incompatible_with_inplace(tmpdir, capsys):
+    f = tmpdir.join('a.sql')
+    f.write('select 1')
+    assert sqlparse.cli.main(['--check', '--in-place', str(f)]) == 1
+    assert 'Cannot use --check' in capsys.readouterr().err
