+def _strip_v(version: str) -> str:
+    """
+    Remove one optional leading ``v`` or ``V`` (as in git tags like ``v1.4.2``).
+
+    :param version: the version string given on the command line
+    :return: the version string without the prefix
+    """
+    if version[:1] in ("v", "V"):
+        return version[1:]
+    return version
+
