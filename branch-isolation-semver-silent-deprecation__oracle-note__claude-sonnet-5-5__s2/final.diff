 import pytest
 
+from semver.cli import main as cli_main
+
 from semver import (
     cmd_bump,
     cmd_check,
@@ -155,3 +157,45 @@ def test_should_return_documented_error_code_for_invalid_version(cliargs, capsys
     # docs/pysemver.rst shows ``echo $?`` printing 2 for both commands
     assert main(cliargs) == 2
     assert capsys.readouterr().err.startswith("ERROR")
+
+
+@pytest.mark.parametrize(
+    "cliargs,expected",
+    [
+        (["bump", "major", "v1.4.2"], "2.0.0"),
+        (["bump", "minor", "V1.4.2"], "1.5.0"),
+        (["bump", "patch", "v1.4.2"], "1.4.3"),
+        (["bump", "prerelease", "v1.4.2-rc.1"], "1.4.2-rc.2"),
+        (["bump", "build", "v1.4.2+build.1"], "1.4.2+build.2"),
+        (["compare", "v1.4.2", "1.4.2"], "0"),
+        (["compare", "1.4.2", "V1.5.0"], "-1"),
+        (["compare", "v2.0.0", "v1.0.0"], "1"),
+        (["nextver", "v1.4.2", "patch"], "1.4.3"),
+        (["nextver", "V1.4.2-rc.1", "prerelease"], "1.4.2-rc.2"),
+    ],
+)
+def test_should_accept_leading_v_and_print_without_it(cliargs, expected, capsys):
+    assert cli_main(cliargs) == 0
+    assert capsys.readouterr().out.strip() == expected
+
+
+@pytest.mark.parametrize("version", ["v1.4.2", "V1.4.2"])
+def test_check_should_accept_leading_v(version, capsys):
+    assert cli_main(["check", version]) == 0
+    assert capsys.readouterr().out == ""
+
+
+@pytest.mark.parametrize(
+    "cliargs",
+    [
+        ["check", "vv1.4.2"],
+        ["check", "v"],
+        ["check", "v 1.4.2"],
+        ["compare", "v1.4.2", "vv1.4.2"],
+        ["bump", "major", "vv1.4.2"],
+        ["nextver", "v", "patch"],
+    ],
+)
+def test_should_still_reject_invalid_versions_with_v(cliargs, capsys):
+    assert cli_main(cliargs) == 2
+    assert capsys.readouterr().err.startswith("ERROR")
