 ## [Unreleased]
 
+### Added
+
+- Add `dotenv check` command to list keys from an example file that are missing from `.env`
+- Add `dotenv diff A B` command to show keys only in one file or with differing values, exiting 1 if the files differ
+
 ### Fixed
 
 - Fix a package build deprecation warning caused by a non-string `license` value in `pyproject.toml` by [@kurtmckee] in [#648]
diff --git a/README.md b/README.md
index 3400e67..cdc2421 100644
--- a/README.md
+++ b/README.md
@@ -163,8 +163,17 @@ $ dotenv list --format=json
   "EMAIL": "foo@example.org"
 }
 $ dotenv run -- python foo.py
+$ dotenv check  # compare against .env.example, exit 1 if keys are missing
+$ dotenv diff .env .env.production  # exit 1 if the files differ
 ```
 
+`dotenv check` lists the keys defined in the example file (`--example`, default
+`.env.example` next to the `.env` file) that are missing from `.env`.
+
+`dotenv diff A B` prints the keys only in `A` (`- KEY`), only in `B` (`+ KEY`)
+and those whose values differ (`~ KEY`). Values are never printed. It exits 1 if
+the files differ and 0 if they are the same.
+
 Run `dotenv --help` for more information about the options and subcommands.
 
 ## File format
diff --git a/src/dotenv/cli.py b/src/dotenv/cli.py
index c06c706..0e03389 100644
--- a/src/dotenv/cli.py
+++ b/src/dotenv/cli.py
@@ -176,6 +176,64 @@ def unset(ctx: click.Context, key: Any) -> None:
         sys.exit(1)
 
 
+@cli.command()
+@click.pass_context
+@click.option(
+    "--example",
+    type=click.Path(file_okay=True),
+    default=None,
+    help="Example file to compare against, defaults to .env.example next to the .env file.",
+)
+def check(ctx: click.Context, example: Any) -> None:
+    """
+    List keys present in the example file but missing from the .env file.
+
+    Exits with code 1 if any key is missing.
+    """
+    file = ctx.obj["FILE"]
+    if example is None:
+        example = os.path.join(os.path.dirname(file), ".env.example")
+    else:
+        example = os.path.expanduser(example)
+
+    with stream_file(file) as stream:
+        actual = dotenv_values(stream=stream)
+    with stream_file(example) as stream:
+        expected = dotenv_values(stream=stream)
+
+    missing = [k for k in expected if k not in actual]
+    for k in missing:
+        click.echo(k)
+    if missing:
+        sys.exit(1)
+
+
+@cli.command()
+@click.argument("a", type=click.Path(file_okay=True))
+@click.argument("b", type=click.Path(file_okay=True))
+def diff(a: Any, b: Any) -> None:
+    """
+    Show how two env files differ.
+
+    Prints key names only, never values: "- KEY" for keys only in A, "+ KEY"
+    for keys only in B and "~ KEY" for keys whose values differ.
+
+    Exits with code 1 if the files differ, 0 if they are the same.
+    """
+    with stream_file(os.path.expanduser(a)) as stream:
+        left = dotenv_values(stream=stream)
+    with stream_file(os.path.expanduser(b)) as stream:
+        right = dotenv_values(stream=stream)
+
+    lines = [f"- {k}" for k in sorted(left.keys() - right.keys())]
+    lines += [f"+ {k}" for k in sorted(right.keys() - left.keys())]
+    lines += [f"~ {k}" for k in sorted(left.keys() & right.keys()) if left[k] != right[k]]
+    for line in lines:
+        click.echo(line)
+    if lines:
+        sys.exit(1)
+
+
 @cli.command(
     context_settings={
         "allow_extra_args": True,
