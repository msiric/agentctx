 ```
 
+## API
+
+### parseMilliseconds(milliseconds, options?)
+
+#### options
+
+Type: `object`
+
+##### largestUnit
+
+Type: `'days' | 'hours' | 'minutes' | 'seconds'`\
+Default: `'days'`
+
+The largest unit to include. Bigger units roll into it, so `{largestUnit: 'hours'}` gives `hours: 26` instead of `days: 1, hours: 2`. Throws a `TypeError` for any other value.
+
 ## Related
 
 - [to-milliseconds](https://github.com/sindresorhus/to-milliseconds) - The inverse of this module
diff --git a/test.js b/test.js
index 6314aab..fce1991 100644
--- a/test.js
+++ b/test.js
@@ -292,3 +292,34 @@ test('keep the sub-day parts exact at any magnitude', () => {
 		assert.strictEqual(parsed.hours, Number(bigint.hours), `${milliseconds}ms hours against the bigint path`);
 	}
 });
+
+test('largestUnit rolls bigger units into the chosen one', () => {
+	const day = 86_400_000;
+	const input = day + (2 * 3_600_000) + (3 * 60_000) + 4000 + 5;
+
+	assert.deepEqual(parseMilliseconds(input, {largestUnit: 'days'}), parseMilliseconds(input));
+	assert.deepEqual(parseMilliseconds(input, {largestUnit: 'hours'}), {
+		days: 0, hours: 26, minutes: 3, seconds: 4, milliseconds: 5, microseconds: 0, nanoseconds: 0,
+	});
+	assert.deepEqual(parseMilliseconds(input, {largestUnit: 'minutes'}), {
+		days: 0, hours: 0, minutes: (26 * 60) + 3, seconds: 4, milliseconds: 5, microseconds: 0, nanoseconds: 0,
+	});
+	assert.deepEqual(parseMilliseconds(-input, {largestUnit: 'seconds'}), {
+		days: 0, hours: 0, minutes: 0, seconds: -Math.trunc(input / 1000), milliseconds: -5, microseconds: -0, nanoseconds: -0,
+	});
+	assert.deepEqual(parseMilliseconds(BigInt(input), {largestUnit: 'hours'}), {
+		days: 0n, hours: 26n, minutes: 3n, seconds: 4n, milliseconds: 5n, microseconds: 0n, nanoseconds: 0n,
+	});
+	assert.deepEqual(parseMilliseconds(-BigInt(input), {largestUnit: 'minutes'}), {
+		days: 0n, hours: 0n, minutes: -1563n, seconds: -4n, milliseconds: -5n, microseconds: 0n, nanoseconds: 0n,
+	});
+	assert.equal(parseMilliseconds(10n ** 20n, {largestUnit: 'seconds'}).seconds, 10n ** 17n);
+	assert.equal(parseMilliseconds(input, {largestUnit: undefined}).days, 1);
+});
+
+test('largestUnit rejects invalid values', () => {
+	for (const largestUnit of ['weeks', 'day', 'milliseconds', '', null, 1, {}]) {
+		assert.throws(() => parseMilliseconds(1000, {largestUnit}), TypeError);
+		assert.throws(() => parseMilliseconds(1000n, {largestUnit}), TypeError);
+	}
+});
