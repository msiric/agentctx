--- a/index.d.ts
+++ b/index.d.ts
@@ -216,3 +216,28 @@ export default function prettyBytes(
 	number: number | bigint,
 	options?: Options
 ): string;
+
+/**
+Parse a byte string into a number of bytes. The reverse of `prettyBytes`.
+
+Understands plain numbers (`'512'`), bytes (`'512 B'`), the binary units `KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`, `ZiB` and `YiB` (powers of 1024), and the decimal units `kB`, `MB`, `GB`, `TB`, `PB`, `EB`, `ZB` and `YB` (strict SI, powers of 1000, so `1 MB` is exactly `1000000`). `KB` is accepted as an alias for `kB`. Units are case-sensitive, the space before the unit is optional, and fractional values are allowed. The result is not rounded.
+
+@param string - The string to parse.
+@returns The number of bytes.
+@throws A `TypeError` if the input is not a string, is not a number with an optional unit, or uses an unsupported unit. A `RangeError` if the value is too large for a `number`.
+
+@example
+```
+import {parseBytes} from 'pretty-bytes';
+
+parseBytes('512');
+//=> 512
+
+parseBytes('1.5 KiB');
+//=> 1536
+
+parseBytes('1.5 MB');
+//=> 1500000
+```
+*/
+export function parseBytes(string: string): number;
diff --git a/index.js b/index.js
index c5f37ab..073d75a 100644
--- a/index.js
+++ b/index.js
@@ -285,3 +285,59 @@ export default function prettyBytes(number, options) {
 	const result = prefix + numberString + separator + UNITS[exponent];
 	return result.padStart(options.fixedWidth ?? 0);
 }
+
+// Each unit maps to its `[base, exponent]`. Binary units are powers of 1024, the decimal ones are strict SI powers of 1000, matching `prettyBytes`: `1 MB` is exactly 1,000,000 bytes.
+const PARSE_UNITS = new Map([
+	...BIBYTE_UNITS.map((unit, exponent) => [unit, [1024, exponent]]),
+	...BYTE_UNITS.slice(1).map((unit, index) => [unit, [1000, index + 1]]),
+	['KB', [1000, 1]], // Common alias for `kB`.
+]);
+
+const BYTES_PATTERN = /^([+-]?(?:\d+\.?\d*|\.\d+))\s*([A-Za-z]*)$/;
+
+// Decimal units are scaled with integer math where the result is a whole number of bytes, so `'1.1 MB'` is exactly `1100000` and not `1100000.0000000002`.
+const scale = (numberString, base, exponent) => {
+	if (base === 1000) {
+		const [integerPart, fractionPart = ''] = numberString.replace(/^[+-]/, '').split('.');
+		const shift = (exponent * 3) - fractionPart.length;
+
+		if (shift >= 0) {
+			const sign = numberString.startsWith('-') ? -1 : 1;
+			return sign * Number(BigInt(integerPart + fractionPart || '0') * (10n ** BigInt(shift)));
+		}
+	}
+
+	return Number(numberString) * (base ** exponent);
+};
+
+/*
+The reverse of `prettyBytes`: `'1.5 KiB'` → `1536`.
+Binary (`KiB`) and decimal (`kB`) units are both understood, are case-sensitive, and the unit defaults to bytes. Localized numbers are not understood.
+*/
+export function parseBytes(string) {
+	if (typeof string !== 'string') {
+		throw new TypeError(`Expected a string, got ${typeof string}: ${string}`);
+	}
+
+	const match = BYTES_PATTERN.exec(string.trim());
+
+	if (!match) {
+		throw new TypeError(`Unable to parse bytes from: ${JSON.stringify(string)}`);
+	}
+
+	const [, numberString, unit] = match;
+	const [base, exponent] = unit === '' ? [1, 0] : (PARSE_UNITS.get(unit) ?? []);
+
+	if (exponent === undefined) {
+		throw new TypeError(`Unsupported unit ${JSON.stringify(unit)}, expected one of: B, ${[...PARSE_UNITS.keys()].join(', ')}`);
+	}
+
+	const result = scale(numberString, base, exponent);
+
+	if (!Number.isFinite(result)) {
+		throw new RangeError(`Value is too large: ${JSON.stringify(string)}`);
+	}
+
+	// Avoids returning `-0`.
+	return result === 0 ? 0 : result;
+}
