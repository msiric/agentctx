+
+test('parseBytes - plain numbers and bytes', t => {
+	t.is(parseBytes('512'), 512);
+	t.is(parseBytes('512 B'), 512);
+	t.is(parseBytes('512B'), 512);
+	t.is(parseBytes('  512 B  '), 512);
+	t.is(parseBytes('0'), 0);
+	t.is(parseBytes('-0'), 0);
+	t.true(Object.is(parseBytes('-0 B'), 0));
+});
+
+test('parseBytes - binary units', t => {
+	for (const [exponent, unit] of BINARY_UNITS.entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1024 ** exponent);
+		t.is(parseBytes(`2${unit}`), 2 * (1024 ** exponent));
+	}
+});
+
+test('parseBytes - fractions and signs', t => {
+	t.is(parseBytes('1.5 KiB'), 1536);
+	t.is(parseBytes('.5 KiB'), 512);
+	t.is(parseBytes('2. KiB'), 2048);
+	t.is(parseBytes('+1 KiB'), 1024);
+	t.is(parseBytes('-1.5 KiB'), -1536);
+	t.is(parseBytes('1.5 B'), 1.5);
+});
+
+test('parseBytes - whitespace variants from prettyBytes', t => {
+	t.is(parseBytes('1 KiB'), 1024);
+	t.is(parseBytes(' 1 KiB'), 1024);
+});
+
+test('parseBytes - round trips prettyBytes binary output', t => {
+	for (const number of [0, 1, 512, 1024, 1536, 10_240, 1024 ** 3, 3 * (1024 ** 5)]) {
+		t.is(parseBytes(prettyBytes(number, {binary: true})), number);
+	}
+});
+
+test('parseBytes - units are case-sensitive', t => {
+	for (const input of ['1 kib', '1 KIB', '1 kiB', '1 Kib', '1 b', '1 mib', '1 Mb', '1 mB']) {
+		t.throws(() => parseBytes(input), {instanceOf: TypeError, message: /Unsupported unit/});
+	}
+});
+
+test('parseBytes - decimal units are strict SI', t => {
+	for (const [exponent, unit] of ['kB', 'MB', 'GB', 'TB', 'PB', 'EB', 'ZB', 'YB'].entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1000 ** (exponent + 1));
+		t.is(parseBytes(`2${unit}`), 2 * (1000 ** (exponent + 1)));
+	}
+
+	t.is(parseBytes('1 MB'), 1_000_000);
+	t.is(parseBytes('1 KB'), 1000);
+	t.is(parseBytes('1.1 MB'), 1_100_000);
+	t.is(parseBytes('0.001 kB'), 1);
+	t.is(parseBytes('1.5 kB'), 1500);
+	t.is(parseBytes('-1.5 MB'), -1_500_000);
+	t.is(parseBytes('.5 GB'), 500_000_000);
+	t.is(parseBytes('0.0005 kB'), 0.5);
+	t.true(Object.is(parseBytes('-0 MB'), 0));
+});
+
+test('parseBytes - round trips prettyBytes decimal output', t => {
+	for (const number of [0, 1, 512, 1000, 1500, 10_000, 1_000_000, 1000 ** 3, 3 * (1000 ** 5)]) {
+		t.is(parseBytes(prettyBytes(number)), number);
+	}
+});
+
+test('parseBytes - unsupported units', t => {
+	for (const input of ['1 K', '1 bit', '1 kbit', '1 Kb', '1 mB', '1 kb', '1 Mb']) {
+		t.throws(() => parseBytes(input), {instanceOf: TypeError, message: /Unsupported unit/});
+	}
+});
+
+test('parseBytes - invalid input', t => {
+	for (const input of ['', ' ', 'KiB', 'abc', '1 2 KiB', '1,5 KiB', '1e3 KiB', '--1', '1.2.3', '1 KiB KiB', '0x10', 'NaN', 'Infinity']) {
+		t.throws(() => parseBytes(input), {instanceOf: TypeError});
+	}
+
+	for (const input of [undefined, null, 512, 1n, {}]) {
+		t.throws(() => parseBytes(input), {instanceOf: TypeError, message: /Expected a string/});
+	}
+});
+
+test('parseBytes - too large', t => {
+	t.throws(() => parseBytes(`${'9'.repeat(400)} B`), {instanceOf: RangeError});
+});
