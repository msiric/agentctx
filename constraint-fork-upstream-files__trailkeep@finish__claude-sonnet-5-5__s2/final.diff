diff --git a/test/dashdash.js b/test/dashdash.js
new file mode 100644
index 0000000..7ab9477
--- /dev/null
+++ b/test/dashdash.js
@@ -0,0 +1,27 @@
+const test = require('tape');
+const fn = require('../lib');
+
+test('-- option: rest goes to argv["--"]', t => {
+	t.same(
+		fn(['a', '--foo', 'b', '--', 'c', '--bar', '-d'], { '--': true }),
+		{ _: ['a'], foo: 'b', '--': ['c', '--bar', '-d'] }
+	);
+	t.end();
+});
+
+test('-- option: empty array when no bare --', t => {
+	t.same(fn(['a', '-x'], { '--': true }), { _: ['a'], x: true, '--': [] });
+	t.end();
+});
+
+test('-- option unset: rest goes to argv._', t => {
+	const argv = fn(['a', '--', 'b', '--c']);
+	t.same(argv, { _: ['a', 'b', '--c'] });
+	t.false('--' in argv);
+	t.end();
+});
+
+test('-- option: values after -- are not parsed', t => {
+	t.same(fn(['--', '1', '-x'], { '--': true }), { _: [], '--': ['1', '-x'] });
+	t.end();
+});
