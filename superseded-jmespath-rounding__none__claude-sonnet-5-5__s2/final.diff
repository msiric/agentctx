+from tests import unittest
+
+from jmespath import exceptions
+from jmespath.dashboard import search
+
+
+class TestDashboardFunctions(unittest.TestCase):
+    def test_round_to(self):
+        self.assertEqual(search('round_to(a, `2`)', {'a': 3.14159}), 3.14)
+        self.assertEqual(search('round_to(a, `0`)', {'a': 2.6}), 3.0)
+        self.assertEqual(search('round_to(a, `-1`)', {'a': 1234}), 1230)
+
+    def test_round_to_is_half_to_even(self):
+        # Matches Python's round() and pandas, not round-half-up.
+        self.assertEqual(search('round_to(`0.5`, `0`)', None), 0)
+        self.assertEqual(search('round_to(`1.5`, `0`)', None), 2)
+        self.assertEqual(search('round_to(`2.5`, `0`)', None), 2)
+        self.assertEqual(search('round_to(`3.5`, `0`)', None), 4)
+        self.assertEqual(search('round_to(`-2.5`, `0`)', None), -2)
+        self.assertEqual(search('round_to(`0.125`, `2`)', None), 0.12)
+
+    def test_builtins_still_available(self):
+        self.assertEqual(search('abs(a)', {'a': -1}), 1)
+
+    def test_round_to_rejects_non_integer_digits(self):
+        with self.assertRaises(exceptions.JMESPathTypeError):
+            search('round_to(a, `1.5`)', {'a': 1})
+
+    def test_round_to_rejects_non_number(self):
+        with self.assertRaises(exceptions.JMESPathTypeError):
+            search('round_to(a, `1`)', {'a': 'x'})
+
+    def test_clamp(self):
+        self.assertEqual(search('clamp(`5`, `0`, `10`)', None), 5)
+        self.assertEqual(search('clamp(`-5`, `0`, `10`)', None), 0)
+        self.assertEqual(search('clamp(`15`, `0`, `10`)', None), 10)
+        self.assertEqual(search('clamp(`0`, `0`, `10`)', None), 0)
+        self.assertEqual(search('clamp(`1.5`, `0`, `1`)', None), 1)
+
+    def test_clamp_rejects_lo_greater_than_hi(self):
+        with self.assertRaises(exceptions.JMESPathError):
+            search('clamp(`5`, `10`, `0`)', None)
+
+    def test_percent(self):
+        self.assertEqual(search('percent(`1`, `3`, `2`)', None), 33.33)
+        self.assertEqual(search('percent(`1`, `4`, `0`)', None), 25)
+        self.assertEqual(search('percent(a, b, `1`)', {'a': 2, 'b': 3}), 66.7)
+        self.assertEqual(search('percent(`3`, `2`, `0`)', None), 150)
+        self.assertEqual(search('percent(`-1`, `4`, `0`)', None), -25)
+
+    def test_percent_rejects_zero_whole(self):
+        with self.assertRaises(exceptions.JMESPathError):
+            search('percent(`1`, `0`, `2`)', None)
+
+    def test_percent_rejects_non_integer_digits(self):
+        with self.assertRaises(exceptions.JMESPathTypeError):
+            search('percent(`1`, `2`, `1.5`)', None)
+
+    def test_percent_rejects_non_number(self):
+        with self.assertRaises(exceptions.JMESPathTypeError):
+            search('percent(a, `1`, `1`)', {'a': 'x'})
+
+    def test_clamp_rejects_non_number(self):
+        with self.assertRaises(exceptions.JMESPathTypeError):
+            search('clamp(a, `0`, `1`)', {'a': 'x'})
