s=open(p).read()
marker="/**\n * Parse the given StringValue and return milliseconds."
add='''/**
 * Parse a compound duration such as `"1h 30m"` or `"2 days 4 hours"` and
 * return the total in milliseconds.
 *
 * Each term is a number followed by a unit accepted by `parse()`, optionally
 * separated by whitespace. A bare number (no unit) is only accepted when it is
 * the sole term. Each term may carry its own sign, so `"1h -30m"` is 30
 * minutes.
 *
 * @param str - A string to parse to milliseconds
 * @returns The total in milliseconds, or `NaN` if the string can't be parsed
 */
export function parseCompound(str: string): number {
  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
    return NaN;
  }

  const single = parse(str);
  if (!Number.isNaN(single)) {
    return single;
  }

  const input = str.trim();
  if (input.length === 0) {
    return NaN;
  }

  const term = /(-?\\d*\\.?\\d+) *([a-z]+)\\s*/iy;
  let total = 0;
  while (term.lastIndex < input.length) {
    const match = term.exec(input);
    if (!match) {
      return NaN;
    }
    const n = parse(`${match[1]}${match[2]}`);
    if (Number.isNaN(n)) {
      return NaN;
    }
    total += n;
  }
  return total;
}

'''
s=s.replace(marker,add+marker,1)
open(p,'w').write(s)
