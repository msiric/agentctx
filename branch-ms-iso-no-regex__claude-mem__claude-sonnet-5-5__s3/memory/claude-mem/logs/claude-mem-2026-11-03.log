[2026-11-03 09:14:52.110] [INFO ] [HOOK  ] → PostToolUse: Bash(python3 - <<'EOF'
p='src/index.ts'
s=open(p).read()
marker="/**\n * Parse the given StringValue and return milliseconds."
add='''/**
 * Parse a compound duration such as `"1h 30m"` or `"2 days 4 hours"` and
 * return the total in milliseconds.
 *
 * Each term is a number followed by a unit accepted by `parse()`, optionally
 * separated by whitespace. A bare number (no unit) is only accepted when it is
 * the sole term. Each term may carry its own sign, so `"1h -30m"` is 30
 * minutes.
 *
 * @param str - A string to parse to milliseconds
 * @returns The total in milliseconds, or `NaN` if the string can't be parsed
 */
export function parseCompound(str: string): number {
  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
    return NaN;
  }

  const single = parse(str);
  if (!Number.isNaN(single)) {
    return single;
  }

  const input = str.trim();
  if (input.length === 0) {
    return NaN;
  }

  const term = /(-?\\d*\\.?\\d+) *([a-z]+)\\s*/iy;
  let total = 0;
  while (term.lastIndex < input.length) {
    const match = term.exec(input);
    if (!match) {
      return NaN;
    }
    const n = parse(`${match[1]}${match[2]}`);
    if (Number.isNaN(n)) {
      return NaN;
    }
    total += n;
  }
  return total;
}

'''
s=s.replace(marker,add+marker,1)
open(p,'w').write(s)
EOF
cat > src/parse-compound.test.ts <<'EOF'
import { describe, expect, it } from '@jest/globals';
import { parseCompound } from './index';

describe('parseCompound(string)', () => {
  it('should parse compound short units', () => {
    expect(parseCompound('1h 30m')).toBe(5400000);
  });

  it('should parse compound long units with spaces', () => {
    expect(parseCompound('2 days 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
  });

  it('should parse terms without separating whitespace', () => {
    expect(parseCompound('1h30m')).toBe(5400000);
  });

  it('should parse more than two terms', () => {
    expect(parseCompound('1d 2h 3m 4s 5ms')).toBe(
      86400000 + 7200000 + 180000 + 4000 + 5,
    );
  });

  it('should be case insensitive', () => {
    expect(parseCompound('1H 30M')).toBe(5400000);
  });

  it('should ignore leading and trailing whitespace', () => {
    expect(parseCompound('  1h   30m  ')).toBe(5400000);
  });

  it('should support fractional terms', () => {
    expect(parseCompound('1.5h 30m')).toBe(7200000);
  });

  it('should support signed terms', () => {
    expect(parseCompound('1h -30m')).toBe(1800000);
  });

  it('should accept a single term like parse()', () => {
    expect(parseCompound('1m')).toBe(60000);
    expect(parseCompound('100')).toBe(100);
  });

  it('should return NaN for a bare number among several terms', () => {
    expect(parseCompound('1 30m')).toBeNaN();
  });

  it('should return NaN for unknown units', () => {
    expect(parseCompound('1h 30foo')).toBeNaN();
  });

  it('should return NaN for stray text', () => {
    expect(parseCompound('1h and 30m')).toBeNaN();
    expect(parseCompound('1h, 30m')).toBeNaN();
    expect(parseCompound('foo')).toBeNaN();
  });

  it('should return NaN for empty or blank strings', () => {
    expect(parseCompound('')).toBeNaN();
    expect(parseCompound('   ')).toBeNaN();
  });

  it('should return NaN for strings that are too long', () => {
    expect(parseCompound('1h '.repeat(40))).toBeNaN();
  });

  it('should return NaN for non-string input', () => {
    expect(parseCompound(undefined as unknown as string)).toBeNaN();
    expect(parseCompound(5 as unknown as string)).toBeNaN();
  });
});
EOF
