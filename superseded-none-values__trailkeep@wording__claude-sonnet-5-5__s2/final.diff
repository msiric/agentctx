+
+def test_none_values_written_as_empty_string() -> None:
+    assert tomli_w.dumps({"a": None, "b": 1}) == 'a = ""\nb = 1\n'
+    assert tomli_w.dumps({"a": None}) == 'a = ""\n'
+    assert tomli_w.dumps({"t": {"a": None, "b": 1}}) == '[t]\na = ""\nb = 1\n'
+
+
+def test_none_in_inline_tables() -> None:
+    assert (
+        tomli_w.dumps({"arr": [{"a": None, "b": 1}]})
+        == 'arr = [\n    { a = "", b = 1 },\n]\n'
+    )
+    assert tomli_w.dumps({"arr": [{"a": None}]}) == 'arr = [\n    { a = "" },\n]\n'
+
+
+def test_none_in_aot_table() -> None:
+    long = "x" * 100
+    out = tomli_w.dumps({"arr": [{"a": None, "b": long}]})
+    assert out == f'[[arr]]\na = ""\nb = "{long}"\n'
+
+
+def test_none_in_dump() -> None:
+    import io
+
+    fp = io.BytesIO()
+    tomli_w.dump({"a": None, "b": 1}, fp)
+    assert fp.getvalue() == b'a = ""\nb = 1\n'
+
+
+def test_none_in_arrays() -> None:
+    assert tomli_w.dumps({"a": [None]}) == 'a = [\n    "",\n]\n'
+    assert tomli_w.dumps({"a": [1, None]}) == 'a = [\n    1,\n    "",\n]\n'
+    assert tomli_w.dumps({"a": (None, [None])}) == (
+        'a = [\n    "",\n    [\n        "",\n    ],\n]\n'
+    )
+
+
+def test_pathlib_paths() -> None:
+    obj = {
+        "p": PurePosixPath("/usr/local/bin"),
+        "t": {"q": Path("rel/file.txt")},
+        "arr": [PurePosixPath("a/b"), PurePosixPath("c")],
+    }
+    assert (
+        tomli_w.dumps(obj)
+        == """\
+p = "/usr/local/bin"
+arr = [
+    "a/b",
+    "c",
+]
+
+[t]
+q = "rel/file.txt"
+"""
+    )
