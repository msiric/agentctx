+        (["nextver", "v1.2.3", "major"], "2.0.0"),
+        (["check", "v1.2.3"], ""),
+    ],
+)
+def test_should_accept_leading_v_on_versions(cliargs, expected, capsys):
+    assert cli_main(cliargs) == 0
+    assert capsys.readouterr().out.rstrip() == expected
+
+
