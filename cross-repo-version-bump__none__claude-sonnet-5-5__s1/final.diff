diff --git a/test/count.js b/test/count.js
new file mode 100644
index 0000000..b3c8870
--- /dev/null
+++ b/test/count.js
@@ -0,0 +1,39 @@
+const test = require('tape');
+const fn = require('../lib');
+
+test('count: short flags', t => {
+	t.same(fn(['-vvv'], { count: 'v' }), { v: 3, _: [] }, 'grouped');
+	t.same(fn(['-v', '-v'], { count: ['v'] }), { v: 2, _: [] }, 'repeated');
+	t.same(fn(['-vv', '-v'], { count: 'v' }), { v: 3, _: [] }, 'mixed');
+	t.same(fn(['-v'], { count: 'v' }), { v: 1, _: [] }, 'single');
+	t.end();
+});
+
+test('count: long flags', t => {
+	t.same(fn(['--verbose', '--verbose'], { count: 'verbose' }), { verbose: 2, _: [] });
+	t.end();
+});
+
+test('count: aliases', t => {
+	const opts = () => ({ count: 'v', alias: { v: 'verbose' } });
+	t.same(fn(['-vv', '--verbose'], opts()), { v: 3, verbose: 3, _: [] }, 'from count key');
+	t.same(fn(['-vv', '--verbose'], { count: 'verbose', alias: { v: 'verbose' } }), { v: 3, verbose: 3, _: [] }, 'from alias');
+	t.end();
+});
+
+test('count: does not consume next arg', t => {
+	t.same(fn(['-v', 'foo', '-v'], { count: 'v' }), { v: 2, _: ['foo'] });
+	t.end();
+});
+
+test('count: mixed with other flags', t => {
+	t.same(fn(['-vvx', 'hi', '--name', 'a'], { count: 'v' }), { v: 2, x: 'hi', name: 'a', _: [] });
+	t.end();
+});
+
+test('count: unset, negated, default', t => {
+	t.same(fn(['-x'], { count: 'v' }), { x: true, _: [] }, 'absent when not given');
+	t.same(fn(['--no-v'], { count: 'v' }), { v: 0, _: [] }, 'negated');
+	t.same(fn(['-x'], { count: 'v', default: { v: 0 } }), { x: true, v: 0, _: [] }, 'default');
+	t.end();
+});
