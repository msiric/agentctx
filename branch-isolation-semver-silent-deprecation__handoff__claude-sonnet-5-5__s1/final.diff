index 0000000..6dfe2d1
--- /dev/null
+++ b/tests/test_compare_dict_deprecation.py
@@ -0,0 +1,32 @@
+import warnings
+
+import pytest
+
+from semver import Version
+
+
+def test_compare_dict_warns():
+    v = Version(1, 2, 3)
+    with pytest.warns(DeprecationWarning, match="dict"):
+        assert v.compare(dict(major=1, minor=2, patch=4)) == -1
+
+
+def test_compare_dict_warning_points_at_caller():
+    with pytest.warns(DeprecationWarning) as rec:
+        Version(1, 2, 3).compare(dict(major=1, minor=2, patch=3))
+    assert rec[0].filename == __file__
+
+
+@pytest.mark.parametrize(
+    "other", ["1.2.3", b"1.2.3", (1, 2, 3), [1, 2, 3], Version(1, 2, 3)]
+)
+def test_compare_other_types_do_not_warn(other):
+    with warnings.catch_warnings():
+        warnings.simplefilter("error")
+        assert Version(1, 2, 3).compare(other) == 0
+
+
+def test_operators_with_dict_do_not_warn():
+    with warnings.catch_warnings():
+        warnings.simplefilter("error")
+        assert Version(1, 2, 3) == dict(major=1, minor=2, patch=3)
