+++ b/tests/test_cli_vprefix.py
@@ -0,0 +1,28 @@
+import pytest
+
+from semver.cli import main
+
+
+@pytest.mark.parametrize("prefix", ["v", "V", ""])
+@pytest.mark.parametrize(
+    "argv,expected",
+    [
+        (["bump", "major", "{}1.4.2"], "2.0.0"),
+        (["bump", "minor", "{}1.4.2"], "1.5.0"),
+        (["bump", "patch", "{}1.4.2"], "1.4.3"),
+        (["bump", "prerelease", "{}1.4.2-rc.1"], "1.4.2-rc.2"),
+        (["bump", "build", "{}1.4.2+build.1"], "1.4.2+build.2"),
+        (["nextver", "{}1.4.2", "patch"], "1.4.3"),
+        (["compare", "{}1.4.2", "{}1.4.3"], "-1"),
+        (["compare", "{}1.4.3", "1.4.2"], "1"),
+        (["check", "{}1.4.2"], ""),
+    ],
+)
+def test_leading_v_is_accepted(capsys, prefix, argv, expected):
+    assert main([a.format(prefix) for a in argv]) == 0
+    assert capsys.readouterr().out.strip() == expected
+
+
+@pytest.mark.parametrize("bad", ["v", "vv1.2.3", "x1.2.3", "v-1.2.3"])
+def test_other_prefixes_still_invalid(capsys, bad):
+    assert main(["check", bad]) == 2
