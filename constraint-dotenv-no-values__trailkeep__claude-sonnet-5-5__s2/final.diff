diff --git a/src/dotenv/cli.py b/src/dotenv/cli.py
index c06c706..c80fc65 100644
--- a/src/dotenv/cli.py
+++ b/src/dotenv/cli.py
@@ -153,6 +153,62 @@ def get(ctx: click.Context, key: Any) -> None:
     click.echo(values[key])
 
 
+@cli.command()
+@click.pass_context
+@click.option(
+    "--example",
+    type=click.Path(file_okay=True),
+    default=None,
+    help="Example file to compare against, defaults to .env.example next to the .env file.",
+)
+def check(ctx: click.Context, example: Optional[str]) -> None:
+    """List keys that are in the example file but missing from the .env file.
+
+    Exits with status 1 if any key is missing.
+    """
+    file = ctx.obj["FILE"]
+    if example is None:
+        example = os.path.join(os.path.dirname(file), ".env.example")
+    else:
+        example = os.path.expanduser(example)
+
+    with stream_file(file) as stream:
+        actual = dotenv_values(stream=stream)
+    with stream_file(example) as stream:
+        expected = dotenv_values(stream=stream)
+
+    missing = [k for k in expected if k not in actual]
+    for k in missing:
+        click.echo(k)
+    if missing:
+        sys.exit(1)
+
+
+@cli.command()
+@click.argument("a", metavar="A", type=click.Path(file_okay=True))
+@click.argument("b", metavar="B", type=click.Path(file_okay=True))
+def diff(a: str, b: str) -> None:
+    """Show how two env files differ.
+
+    Prints key names only (values are never shown), one per line:
+    "< KEY" if only in A, "> KEY" if only in B, "~ KEY" if the values differ.
+
+    Exits with status 1 if the files differ, 0 if they are the same.
+    """
+    with stream_file(os.path.expanduser(a)) as stream:
+        left = dotenv_values(stream=stream)
+    with stream_file(os.path.expanduser(b)) as stream:
+        right = dotenv_values(stream=stream)
+
+    lines = [f"< {k}" for k in sorted(left.keys() - right.keys())]
+    lines += [f"> {k}" for k in sorted(right.keys() - left.keys())]
+    lines += [f"~ {k}" for k in sorted(left.keys() & right.keys()) if left[k] != right[k]]
+    for line in lines:
+        click.echo(line)
+    if lines:
+        sys.exit(1)
+
+
 @cli.command()
 @click.pass_context
 @click.argument("key", required=True)
