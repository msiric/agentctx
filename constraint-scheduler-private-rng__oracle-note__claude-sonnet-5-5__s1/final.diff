+    def test_retry_backoff_and_give_up(self):
+        calls = []
+
+        def flaky():
+            calls.append(1)
+            raise IOError("boom")
+
+        with mock_datetime(2010, 1, 6, 12, 15):
+            with mock.patch.object(schedule._jitter_rng, "uniform", return_value=5):
+                job = every(1).hours.do(flaky).retry(times=3, base_delay=30)
+                normal = job.next_run
+                job.next_run = datetime.datetime.now()
+                for expected in (35, 65, 125):
+                    schedule.run_pending()
+                    assert job.next_run == datetime.datetime.now() + datetime.timedelta(
+                        seconds=expected
+                    )
+                    job.next_run = datetime.datetime.now()
