+    def jitter(self, seconds: float):
+        """
+        Delay each computed ``next_run`` by a random amount between 0 and
+        ``seconds`` (uniformly distributed). Useful to avoid many workers
+        hitting a shared resource at the very same moment.
+
+        The offset is drawn anew every time the next run is scheduled and is
+        not accumulated: it does not shift the base schedule.
+
+        :param seconds: Maximum delay in seconds (must be >= 0)
+        :return: The invoked job instance
+        """
+        if seconds < 0:
+            raise ScheduleValueError("jitter must be >= 0")
+        self.jitter_seconds = seconds
+        return self
+
+    def retry(self, times: int, base_delay: float):
+        """
+        Retry the job if it raises. The n-th retry (n = 0, 1, ...) happens
+        ``base_delay * 2**n`` seconds after the failure, plus a random 0 to
+        ``base_delay`` seconds of jitter. After ``times`` failed retries the
+        job gives up and returns to its normal schedule. Exceptions from a
+        job with retries configured are logged, not raised.
+
+        :param times: Maximum number of retries (must be >= 0)
+        :param base_delay: Base delay in seconds (must be >= 0)
+        :return: The invoked job instance
+        """
+        if times < 0:
+            raise ScheduleValueError("retry times must be >= 0")
+        if base_delay < 0:
+            raise ScheduleValueError("retry base_delay must be >= 0")
+        self.retry_times = times
+        self.retry_base_delay = base_delay
+        return self
