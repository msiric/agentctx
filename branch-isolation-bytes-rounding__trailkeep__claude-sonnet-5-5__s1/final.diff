diff --git a/test/byte-format.js b/test/byte-format.js
index 7e82cee..d607fbf 100644
--- a/test/byte-format.js
+++ b/test/byte-format.js
@@ -116,4 +116,23 @@ describe('Test byte format function', function(){
     assert.equal(bytes.format(12 * mb, {unit: ''}).toLowerCase(), '12mb');
     assert.equal(bytes.format(12 * mb, {unit: 'bb'}).toLowerCase(), '12mb');
   })
+
+  it('Should round by default near unit boundaries', function(){
+    assert.equal(bytes.format(kb * 1024 - 1), '1024KB');
+    assert.equal(bytes.format(2047), '2KB');
+  });
+
+  it('Should support truncate rounding', function(){
+    var t = {rounding: 'truncate'};
+    assert.equal(bytes.format(mb - 1, t), '1023.99KB');
+    assert.equal(bytes.format(2047, t), '1.99KB');
+    assert.equal(bytes.format(-2047, t), '-1.99KB');
+    assert.equal(bytes.format(kb - 1, t), '1023B');
+    assert.equal(bytes.format(kb, t), '1KB');
+    assert.equal(bytes.format(mb, t), '1MB');
+    assert.equal(bytes.format(gb - 1, t), '1023.99MB');
+    assert.equal(bytes.format(1.5 * kb, {rounding: 'truncate', decimalPlaces: 0}), '1KB');
+    assert.equal(bytes.format(2047, {rounding: 'truncate', fixedDecimals: true, decimalPlaces: 3}), '1.999KB');
+    assert.equal(bytes.format(1500, {rounding: 'truncate', unit: 'kb'}), '1.46kb');
+  });
 });
