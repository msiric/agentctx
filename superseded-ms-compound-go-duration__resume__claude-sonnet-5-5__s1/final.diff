+/**
+ * Compound short format for `ms`, e.g. `25h30m`. Compatible with Go's
+ * `time.ParseDuration`: parts are not separated and hours are the largest unit.
+ */
+function fmtCompound(ms: number): string {
+  let rest = Math.floor(Math.abs(ms) / s) * s;
+  const parts: string[] = [];
+  for (const [size, name] of [
+    [h, 'h'],
+    [m, 'm'],
+    [s, 's'],
+  ] as const) {
+    const count = Math.floor(rest / size);
+    rest -= count * size;
+    if (count > 0) {
+      parts.push(`${count}${name}`);
+    }
+  }
+  if (parts.length === 0) {
+    return '0s';
+  }
+  return `${ms < 0 ? '-' : ''}${parts.join('')}`;
+}
