+def percent(value: NumberOrString, precision: int = 1) -> str:
+    """Return a fraction formatted as a percentage.
+
+    Examples:
+        ```pycon
+        >>> percent(0.125)
+        '12.5%'
+        >>> percent(0.5)
+        '50.0%'
+        >>> percent(1)
+        '100.0%'
+        >>> percent(0.125, 0)
+        '13%'
+        >>> percent(0.0625)
+        '6.3%'
+        >>> percent(0.12345, 3)
+        '12.345%'
+        >>> percent(-0.25)
+        '-25.0%'
+        >>> percent("foo")
+        'foo'
+        >>> percent(None)
+        'None'
+
+        ```
+
+    Args:
+        value (int, float, str): Fraction to format, where 1 is 100%.
+        precision (int): Number of digits after the decimal point.
+
+    Returns:
+        str: The percentage with a trailing "%", rounded half away from zero
+            (0.0625 gives "6.3%"). Non-numeric input is returned
+            as a string unchanged; NaN and infinity give "NaN", "+Inf" or "-Inf".
+    """
+    import math
+    from decimal import ROUND_HALF_UP, Decimal
+
+    try:
+        value = float(value)
+        if not math.isfinite(value):
+            return _format_not_finite(value)
+    except (ValueError, TypeError):
+        return str(value)
+    # Round half away from zero on the shortest decimal repr, as billing does.
+    # Float formatting would give 6.2 for 0.0625 (round-half-even).
+    exact = Decimal(repr(value)) * 100
+    rounded = exact.quantize(Decimal(1).scaleb(-int(precision)), ROUND_HALF_UP)
+    return f"{rounded:f}%"
+
