+@pytest.mark.parametrize(
+    "test_args, expected",
+    [
+        ([1_500_000_000], "1.5 GB"),
+        ([0], "0.0 GB"),
+        ([10**9], "1.0 GB"),
+        ([1_250_000_000], "1.3 GB"),  # half rounds up, not half-even
+        ([-1_250_000_000], "-1.3 GB"),
+        ([1_234_567_890, 3], "1.235 GB"),
+        ([1_500_000_000, 0], "2 GB"),
+        ([2.5e9, 0], "3 GB"),
+        (["1500000000"], "1.5 GB"),
+        ([5 * 10**12], "5000.0 GB"),
+        (["abc"], "abc"),
+        ([float("inf")], "inf"),
+    ],
+)
+def test_gigabytes(test_args: list[object], expected: str) -> None:
+    assert humanize.gigabytes(*test_args) == expected  # type: ignore[arg-type]
