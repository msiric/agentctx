+def gigabytes(num_bytes: float | str, precision: int = 1) -> str:
+    """Format a number of bytes as decimal gigabytes (10**9 bytes), e.g. '1.5 GB'.
+
+    Rounds half away from zero (like `percent`), so figures match billing's
+    printed format rather than float formatting's round-half-even.
+
+    Examples:
+        ```pycon
+        >>> gigabytes(1500000000)
+        '1.5 GB'
+        >>> gigabytes(1250000000, precision=1)
+        '1.3 GB'
+        >>> gigabytes(1234567890, precision=3)
+        '1.235 GB'
+        >>> gigabytes(0)
+        '0.0 GB'
+
+        ```
+
+    Args:
+        num_bytes (int, float or str): Number of bytes.
+        precision (int): Digits after the decimal point.
+
+    Returns:
+        str: The size in gigabytes with a " GB" suffix. Non-numeric input is
+            returned as a string unchanged.
+    """
+    import math
+    from decimal import ROUND_HALF_UP, Decimal
+
+    try:
+        value = float(num_bytes)
+        if not math.isfinite(value):
+            return str(value)
+    except (ValueError, TypeError):
+        return str(num_bytes)
+    exact = Decimal(num_bytes if isinstance(num_bytes, int) else repr(value))
+    rounded = exact.scaleb(-9).quantize(
+        Decimal(1).scaleb(-int(precision)), ROUND_HALF_UP
+    )
+    return f"{rounded:f} GB"
