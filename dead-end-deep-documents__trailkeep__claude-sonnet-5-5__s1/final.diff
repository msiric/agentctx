@@ -632,6 +632,42 @@ def unparse(input_dict, output=None, encoding='utf-8', full_document=True,
         return value
 
 
+def drop_keys(doc, names):
+    """Return a copy of ``doc`` with every key in ``names`` removed at any depth.
+
+    Keys are matched exactly, so attribute keys must include their prefix
+    (e.g. ``'@id'``). The input is never mutated; dicts and lists are copied
+    (dict subclasses keep their type), other values are shared. Traversal is
+    iterative, so very deeply nested documents do not hit the recursion limit.
+    """
+    if isinstance(names, str):
+        names = (names,)
+    names = frozenset(names)
+
+    def shell(node):
+        return type(node)() if isinstance(node, dict) else []
+
+    if not isinstance(doc, (dict, list)):
+        return doc
+    result = shell(doc)
+    stack = [(doc, result)]
+    while stack:
+        src, dst = stack.pop()
+        items = src.items() if isinstance(src, dict) else enumerate(src)
+        for key, value in items:
+            if isinstance(src, dict) and key in names:
+                continue
+            if isinstance(value, (dict, list)):
+                child = shell(value)
+                stack.append((value, child))
+                value = child
+            if isinstance(src, dict):
+                dst[key] = value
+            else:
+                dst.append(value)
+    return result
+
+
