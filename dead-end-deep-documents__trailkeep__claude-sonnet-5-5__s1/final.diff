@@ -720,3 +720,50 @@ def test_force_list_true_applies_to_all_keys():
     xml = "<a><b>1</b><b>2</b><c>x</c></a>"
     expected = {"a": [{"b": ["1", "2"], "c": ["x"]}]}
     assert parse(xml, force_list=True) == expected
+
+
+def test_drop_keys_any_depth_and_attributes():
+    from xmltodict import drop_keys
+    doc = parse('<a id="1"><b id="2" k="v"><c>x</c></b><b><c>y</c></b></a>')
+    assert drop_keys(doc, ['@id', 'c']) == {
+        'a': {'b': [{'@k': 'v'}, {}]}}
+
+
+def test_drop_keys_does_not_mutate_input():
+    import copy
+    from xmltodict import drop_keys
+    doc = parse('<a id="1"><b id="2"><c>x</c></b><b>y</b></a>')
+    snapshot = copy.deepcopy(doc)
+    out = drop_keys(doc, {'@id', 'b'})
+    assert doc == snapshot
+    assert out == {'a': {}}
+    out2 = drop_keys(doc, {'@id'})
+    out2['a']['b'][0]['c'] = 'changed'
+    assert doc == snapshot
+
+
+def test_drop_keys_edge_cases():
+    from collections import OrderedDict
+    from xmltodict import drop_keys
+    assert drop_keys({'a': 1}, []) == {'a': 1}
+    assert drop_keys({'a': 1}, 'a') == {}
+    assert drop_keys('text', ['a']) == 'text'
+    assert drop_keys({'a': [1, [{'x': 1, 'y': 2}]]}, ['x']) == {'a': [1, [{'y': 2}]]}
+    # prefix matters: 'id' does not match '@id'
+    assert drop_keys({'@id': 1}, ['id']) == {'@id': 1}
+    out = drop_keys(OrderedDict([('a', OrderedDict([('b', 1)]))]), ['b'])
+    assert isinstance(out, OrderedDict) and isinstance(out['a'], OrderedDict)
+
+
+def test_drop_keys_deep_nesting_no_recursion_error():
+    from xmltodict import drop_keys
+    doc = leaf = {}
+    for _ in range(5000):
+        leaf['part'] = {'@id': 'x'}
+        leaf = leaf['part']
+    out = drop_keys(doc, ['@id'])
+    depth = 0
+    while out:
+        out = out['part']
+        depth += 1
+    assert depth == 5000
