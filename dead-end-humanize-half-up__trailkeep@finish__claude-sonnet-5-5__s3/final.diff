+def gigabytes(num_bytes: float | str, precision: int = 1) -> str:
+    """Format a number of bytes as decimal gigabytes (10**9 bytes), e.g. '1.5 GB'.
+
+    Rounds half up (away from zero) on the decimal value, matching billing's
+    invoice generator, rather than using binary float formatting.
+
+    Examples:
+        ```pycon
+        >>> gigabytes(1500000000)
+        '1.5 GB'
+        >>> gigabytes(0)
+        '0.0 GB'
+        >>> gigabytes(1250000000, 2)
+        '1.25 GB'
+        >>> gigabytes(1250000000, 0)
+        '1 GB'
+        >>> gigabytes(1250000000)
+        '1.3 GB'
+
+        ```
+
+    Args:
+        num_bytes (int, float, str): Number of bytes.
+        precision (int): Number of decimal places.
+
+    Returns:
+        str: The size in gigabytes.
+    """
+    import decimal
+    import math
+
+    value = float(num_bytes)
+    if not math.isfinite(value):
+        from humanize.number import _format_not_finite
+
+        return _format_not_finite(value)
+    exact = decimal.Decimal(repr(value)) / 10**9
+    quantum = decimal.Decimal(1).scaleb(-int(precision))
+    rounded = exact.quantize(quantum, rounding=decimal.ROUND_HALF_UP)
+    return f"{rounded:f} GB"
