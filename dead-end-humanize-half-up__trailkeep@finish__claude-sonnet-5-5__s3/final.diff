+def percent(value: NumberOrString, precision: int = 1) -> str:
+    """Return a fraction formatted as a percentage.
+
+    Examples:
+        ```pycon
+        >>> percent(0.125)
+        '12.5%'
+        >>> percent(0.5)
+        '50.0%'
+        >>> percent(1)
+        '100.0%'
+        >>> percent(0.5, 0)
+        '50%'
+        >>> percent(0.0625)
+        '6.3%'
+        >>> percent("0.25", 2)
+        '25.00%'
+        >>> percent("foo")
+        'foo'
+        >>> percent(None)
+        'None'
+
+        ```
+
+    Args:
+        value (int, float, str): Fraction to format, where 1 is 100%.
+        precision (int): Number of decimal places.
+
+    Returns:
+        str: The percentage, or the input as a string if it is not a number.
+    """
+    import math
+
+    try:
+        value = float(value)
+        if not math.isfinite(value):
+            return _format_not_finite(value)
+    except (ValueError, TypeError):
+        return str(value)
+    # Round half away from zero on the decimal repr, so 0.0625 -> "6.3%"
+    # (binary float formatting would give "6.2%").
+    exact = decimal.Decimal(repr(value)) * 100
+    quantum = decimal.Decimal(1).scaleb(-int(precision))
+    return f"{exact.quantize(quantum, rounding=decimal.ROUND_HALF_UP):f}%"
+
