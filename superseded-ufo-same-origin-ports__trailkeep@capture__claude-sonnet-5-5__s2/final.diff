@@ -773,3 +784,49 @@ export function withoutHost(input: string) {
   const parsed = parseURL(input);
   return (parsed.pathname || "/") + parsed.search + parsed.hash;
 }
+
+const DEFAULT_PORTS: Record<string, string> = {
+  "http:": "80",
+  "https:": "443",
+  "ws:": "80",
+  "wss:": "443",
+};
+
+function getOrigin(input?: string): string | undefined {
+  if (!input || /^[\s\0]/.test(input)) {
+    return undefined;
+  }
+  const { protocol, host } = parseURL(input);
+  if (!protocol || !host || isScriptProtocol(protocol)) {
+    return undefined;
+  }
+  const match = host.toLowerCase().match(/^(\[[^\]]*\]|[^:]*)(?::(\d*))?$/);
+  if (!match || !match[1]) {
+    return undefined;
+  }
+  const port = match[2] === DEFAULT_PORTS[protocol] ? "" : (match[2] ?? "");
+  return `${protocol}//${match[1]}${port ? ":" + port : ""}`;
+}
+
+/**
+ * Checks if two URLs have the same origin (protocol, hostname and port).
+ *
+ * Default ports are normalized (`https://x.com` equals `https://x.com:443`).
+ * Path, query, hash and userinfo are ignored. URLs without an absolute origin
+ * (relative, protocol-relative, empty, `data:`, `javascript:`, ...) never match.
+ *
+ * @example
+ *
+ * ```js
+ * isSameOrigin("https://example.com/a", "https://example.com/b"); // true
+ * isSameOrigin("https://example.com", "https://example.com:443"); // true
+ * isSameOrigin("https://example.com", "http://example.com"); // false
+ * isSameOrigin("/a", "/a"); // false
+ * ```
+ *
+ * @group utils
+ */
+export function isSameOrigin(a?: string, b?: string): boolean {
+  const originA = getOrigin(a);
+  return originA !== undefined && originA === getOrigin(b);
+}
