diff --git a/test/same-origin.test.ts b/test/same-origin.test.ts
new file mode 100644
index 0000000..dc64c00
--- /dev/null
+++ b/test/same-origin.test.ts
@@ -0,0 +1,128 @@
+import { describe, expect, test } from "vitest";
+import { isSameOrigin } from "../src";
+
+// Proposed semantics: two URLs are same-origin when protocol, hostname and
+// port all match, compared literally (no default-port normalization, so
+// `https://a.com` ≢ `https://a.com:443`). Path, query, hash and userinfo are ignored.
+// A URL without an absolute origin (relative, protocol-relative, empty) never
+// matches anything.
+
+describe("isSameOrigin", () => {
+  describe("same origin", () => {
+    test.each([
+      ["https://example.com", "https://example.com"],
+      ["https://example.com", "https://example.com/"],
+      ["https://example.com/a", "https://example.com/b"],
+      ["https://example.com/a?x=1", "https://example.com/b?y=2"],
+      ["https://example.com/#a", "https://example.com/#b"],
+      ["http://localhost:3000/a", "http://localhost:3000/b"],
+      ["http://127.0.0.1:8080", "http://127.0.0.1:8080/x"],
+    ])("%s ≡ %s", (a, b) => {
+      expect(isSameOrigin(a, b)).toBe(true);
+      expect(isSameOrigin(b, a)).toBe(true);
+    });
+  });
+
+  describe("normalization", () => {
+    test.each([
+      // Case-insensitive protocol and host
+      ["HTTPS://EXAMPLE.com", "https://example.COM"],
+      // Explicit identical default ports still match each other
+      ["https://example.com:443/a", "https://example.com:443/b"],
+      // Userinfo is not part of the origin
+      ["https://user:pass@example.com", "https://example.com"],
+      ["https://a@example.com", "https://b@example.com"],
+      // Trailing dot is NOT normalized (see "different origin") — kept out of here
+    ])("%s ≡ %s", (a, b) => {
+      expect(isSameOrigin(a, b)).toBe(true);
+      expect(isSameOrigin(b, a)).toBe(true);
+    });
+  });
+
+  describe("different origin", () => {
+    test.each([
+      // Protocol
+      ["http://example.com", "https://example.com"],
+      // Host
+      ["https://example.com", "https://example.org"],
+      ["https://example.com", "https://www.example.com"],
+      ["https://a.example.com", "https://example.com"],
+      ["https://example.com", "https://example.com.evil.com"],
+      // Port
+      ["https://example.com:8443", "https://example.com"],
+      ["http://localhost:3000", "http://localhost:3001"],
+      // Strict ports: no default-port normalization. An explicit port never
+      // equals an omitted one, even when it is the scheme's default.
+      ["https://example.com", "https://example.com:443"],
+      ["http://example.com", "http://example.com:80"],
+      ["https://example.com:443/a", "https://example.com/b"],
+      ["http://example.com:443", "http://example.com"],
+      ["https://example.com:80", "https://example.com"],
+      // Userinfo must not be able to spoof the host
+      ["https://example.com@evil.com", "https://example.com"],
+      ["https://example.com", "https://example.com:pass@evil.com"],
+    ])("%s ≢ %s", (a, b) => {
+      expect(isSameOrigin(a, b)).toBe(false);
+      expect(isSameOrigin(b, a)).toBe(false);
+    });
+  });
+
+  describe("no origin (always false)", () => {
+    test.each([
+      ["/a", "/a"],
+      ["a/b", "a/b"],
+      ["./a", "./a"],
+      ["", ""],
+      ["//example.com/a", "//example.com/a"],
+      ["//example.com/a", "https://example.com/a"],
+      ["/a", "https://example.com/a"],
+      ["example.com", "example.com"],
+    ])("%j vs %j", (a, b) => {
+      expect(isSameOrigin(a, b)).toBe(false);
+      expect(isSameOrigin(b, a)).toBe(false);
+    });
+
+    test("undefined / nullish inputs", () => {
+      expect(isSameOrigin(undefined, undefined)).toBe(false);
+      expect(isSameOrigin(undefined, "https://example.com")).toBe(false);
+      expect(isSameOrigin("https://example.com", undefined)).toBe(false);
+    });
+  });
+
+  describe("opaque / non-hierarchical protocols", () => {
+    // Origins of these are opaque, so they never match (even themselves).
+    test.each([
+      ["javascript:alert(1)", "javascript:alert(1)"],
+      ["data:text/plain,hi", "data:text/plain,hi"],
+      ["mailto:a@example.com", "mailto:a@example.com"],
+      ["blob:https://example.com/uuid", "https://example.com"],
+    ])("%s vs %s", (a, b) => {
+      expect(isSameOrigin(a, b)).toBe(false);
+    });
+  });
+
+  describe("other schemes with hosts", () => {
+    test("ws / wss compare like http / https (strict ports)", () => {
+      expect(isSameOrigin("ws://example.com/a", "ws://example.com/b")).toBe(true);
+      expect(isSameOrigin("ws://example.com", "ws://example.com:80")).toBe(false);
+      expect(isSameOrigin("wss://example.com", "wss://example.com:443")).toBe(false);
+      expect(isSameOrigin("ws://example.com", "wss://example.com")).toBe(false);
+      expect(isSameOrigin("ws://example.com", "http://example.com")).toBe(false);
+    });
+  });
+
+  describe("edge cases", () => {
+    test("identical string is not automatically same-origin when it has no origin", () => {
+      expect(isSameOrigin("/a", "/a")).toBe(false);
+    });
+
+    test("IPv6 hosts", () => {
+      expect(isSameOrigin("http://[::1]:3000/a", "http://[::1]:3000/b")).toBe(true);
+      expect(isSameOrigin("http://[::1]:3000", "http://[::1]:3001")).toBe(false);
+    });
+
+    test("whitespace-padded input is not trimmed", () => {
+      expect(isSameOrigin(" https://example.com", "https://example.com")).toBe(false);
+    });
+  });
+});
