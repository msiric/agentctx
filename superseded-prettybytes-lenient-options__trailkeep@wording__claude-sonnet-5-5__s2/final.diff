 ```
 
+##### significantDigits
+
+Type: `number`\
+Default: `3`
+
+The number of significant digits to round to when neither `minimumFractionDigits` nor `maximumFractionDigits` is set.
+
+Must be an integer between 1 and 100. Any other value is ignored and the default is used. The integer part of the number is never cut short, so a value like `999` is still shown in full with `significantDigits: 2`.
+
+```js
+import prettyBytes from 'pretty-bytes';
+
+prettyBytes(1337, {significantDigits: 2});
+//=> '1.3 kB'
+
+prettyBytes(1337, {significantDigits: 4});
+//=> '1.337 kB'
+```
+
 ##### minimumFractionDigits
 
 Type: `number`\
diff --git a/test.js b/test.js
index 25fcd07..3c8ca0e 100644
--- a/test.js
+++ b/test.js
@@ -1189,3 +1189,22 @@ test('the options shape the output as documented', t => {
 		t.is(prettyBytes(value, {signed: true}), prefix + prettyBytes(Math.abs(value)));
 	}
 });
+
+test('significantDigits option', t => {
+	t.is(prettyBytes(1337, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 1}), '1 kB');
+	t.is(prettyBytes(999, {significantDigits: 1}), '999 B');
+	t.is(prettyBytes(999_999, {significantDigits: 1}), '1 MB');
+	t.is(prettyBytes(1337n, {significantDigits: 4}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 2, locale: 'de'}), '1,3 kB');
+});
+
+test('significantDigits option is ignored when invalid or when fraction digits are set', t => {
+	for (const value of [0, -1, 1.5, 101, Number.NaN, '2', null, undefined, {}]) {
+		t.is(prettyBytes(1337, {significantDigits: value}), '1.34 kB');
+	}
+
+	t.is(prettyBytes(1337, {significantDigits: 4, maximumFractionDigits: 1}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 2, minimumFractionDigits: 3}), '1.337 kB');
+});
