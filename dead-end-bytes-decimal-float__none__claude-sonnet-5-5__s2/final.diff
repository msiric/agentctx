diff --git a/test/byte-parse.js b/test/byte-parse.js
index cebfab2..7cf9bd1 100644
--- a/test/byte-parse.js
+++ b/test/byte-parse.js
@@ -108,4 +108,40 @@ describe('Test byte parse function', function(){
   it('Should allow whitespace', function(){
     assert.equal(bytes.parse('1 TB'), 1 * Math.pow(1024, 4));
   });
+
+  describe('decimal option', function(){
+    var opts = {decimal: true};
+
+    it('Should use powers of 1000', function(){
+      assert.equal(bytes.parse('1kB', opts), 1e3);
+      assert.equal(bytes.parse('1MB', opts), 1e6);
+      assert.equal(bytes.parse('1GB', opts), 1e9);
+      assert.equal(bytes.parse('1TB', opts), 1e12);
+      assert.equal(bytes.parse('1PB', opts), 1e15);
+      assert.equal(bytes.parse('1 kb', opts), 1e3);
+    });
+
+    it('Should leave bytes and unitless values unchanged', function(){
+      assert.equal(bytes.parse('1b', opts), 1);
+      assert.equal(bytes.parse('1024', opts), 1024);
+      assert.equal(bytes.parse(1024, opts), 1024);
+    });
+
+    it('Should floor fractional bytes and accept negatives', function(){
+      assert.equal(bytes.parse('1.5kB', opts), 1500);
+      assert.equal(bytes.parse('1.0001kB', opts), 1000);
+      assert.equal(bytes.parse('1.0009kB', opts), 1000);
+      assert.equal(bytes.parse('-1.5MB', opts), -1.5e6);
+    });
+
+    it('Should keep binary behaviour when option is absent or false', function(){
+      assert.equal(bytes.parse('1kB'), 1024);
+      assert.equal(bytes.parse('1kB', {}), 1024);
+      assert.equal(bytes.parse('1kB', {decimal: false}), 1024);
+    });
+
+    it('Should work through the default export', function(){
+      assert.equal(bytes('1kB', opts), 1e3);
+    });
+  });
 });
