index c06c706..f715a62 100644
--- a/src/dotenv/cli.py
+++ b/src/dotenv/cli.py
@@ -111,6 +111,67 @@ def list_values(ctx: click.Context, output_format: str) -> None:
                 click.echo(f"{prefix}{k}={v}")
 
 
+@cli.command()
+@click.pass_context
+@click.option(
+    "--example",
+    type=click.Path(file_okay=True),
+    default=None,
+    help="Location of the example file, defaults to .env.example next to the .env file.",
+)
+def check(ctx: click.Context, example: Any) -> None:
+    """List keys present in the example file but missing from the .env file.
+
+    Exits with status 1 if any key is missing.
+    """
+    file = ctx.obj["FILE"]
+    if example is None:
+        example = os.path.join(os.path.dirname(file), ".env.example")
+    else:
+        example = os.path.expanduser(example)
+
+    with stream_file(file) as stream:
+        values = dotenv_values(stream=stream)
+    with stream_file(example) as stream:
+        expected = dotenv_values(stream=stream)
+
+    missing = [k for k in expected if k not in values]
+    for k in missing:
+        click.echo(k)
+    if missing:
+        sys.exit(1)
+
+
+@cli.command()
+@click.argument("file_a", type=click.Path(file_okay=True))
+@click.argument("file_b", type=click.Path(file_okay=True))
+def diff(file_a: Any, file_b: Any) -> None:
+    """Show how two env files differ.
+
+    Lists keys only in A (<), keys only in B (>) and keys whose values differ
+    (~). Only key names are printed, never values.
+
+    Exits with status 1 if the files differ, 0 if they are the same.
+    """
+    with stream_file(os.path.expanduser(file_a)) as stream:
+        a = dotenv_values(stream=stream)
+    with stream_file(os.path.expanduser(file_b)) as stream:
+        b = dotenv_values(stream=stream)
+
+    only_a = [k for k in a if k not in b]
+    only_b = [k for k in b if k not in a]
+    changed = [k for k in a if k in b and a[k] != b[k]]
+
+    for k in only_a:
+        click.echo(f"< {k}")
+    for k in only_b:
+        click.echo(f"> {k}")
+    for k in changed:
+        click.echo(f"~ {k}")
+    if only_a or only_b or changed:
+        sys.exit(1)
+
+
 @cli.command(name="set")
 @click.pass_context
 @click.argument("key", required=True)
