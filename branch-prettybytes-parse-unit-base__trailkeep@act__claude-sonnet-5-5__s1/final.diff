+
+test('parseBytes: plain numbers and bytes', t => {
+	t.is(parseBytes('0'), 0);
+	t.is(parseBytes('512'), 512);
+	t.is(parseBytes('512 B'), 512);
+	t.is(parseBytes('512B'), 512);
+	t.is(parseBytes('  512 B  '), 512);
+	t.is(parseBytes('512 B'), 512);
+	t.is(parseBytes('.5'), 0.5);
+});
+
+test('parseBytes: binary units', t => {
+	for (const [index, unit] of BINARY_UNITS.entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1024 ** index);
+		t.is(parseBytes(`1${unit}`), 1024 ** index);
+	}
+
+	t.is(parseBytes('1 YiB'), Number(2n ** 80n));
+});
+
+test('parseBytes: fractions and signs', t => {
+	t.is(parseBytes('1.5 KiB'), 1536);
+	t.is(parseBytes('0.25 MiB'), 262_144);
+	t.is(parseBytes('-1.5 KiB'), -1536);
+	t.is(parseBytes('+42 B'), 42);
+	t.true(Object.is(parseBytes('-0'), 0));
+});
+
+test('parseBytes: round trips prettyBytes in binary mode', t => {
+	for (const bytes of [0, 1, 512, 1024, 1536, 1_048_576, 5_368_709_120]) {
+		t.is(parseBytes(prettyBytes(bytes, {binary: true})), bytes);
+	}
+});
+
+test('parseBytes: units are case-sensitive', t => {
+	for (const input of ['1 kib', '1 KIB', '1 kiB', '1 b', '1 Kib', '1 mib']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError}, `${input}`);
+	}
+});
+
+test('parseBytes: units without the i are powers of 1024', t => {
+	const units = ['kB', 'MB', 'GB', 'TB', 'PB', 'EB', 'ZB', 'YB'];
+	for (const [index, unit] of units.entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1024 ** (index + 1), `${unit}`);
+		t.is(parseBytes(`1 ${unit.replace('B', 'iB').replace('kiB', 'KiB')}`), 1024 ** (index + 1), `${unit} (binary)`);
+	}
+
+	t.is(parseBytes('1 KB'), 1024);
+	t.is(parseBytes('1 kB'), 1024);
+	t.is(parseBytes('1.5MB'), 1.5 * 1024 * 1024);
+	t.throws(() => parseBytes('1 mb'), {instanceOf: SyntaxError, message: /Unsupported unit/});
+});
+
+test('parseBytes: invalid input', t => {
+	for (const input of ['', ' ', 'KiB', 'abc', '1.', '1..5', '1,5 KiB', '1 2 KiB', '1 KiB KiB', '--1', '1e3', 'Infinity', 'NaN', '0x10']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError}, `${input}`);
+	}
+
+	for (const input of [1, undefined, null, 1n, {}]) {
+		t.throws(() => parseBytes(input), {instanceOf: TypeError});
+	}
+});
