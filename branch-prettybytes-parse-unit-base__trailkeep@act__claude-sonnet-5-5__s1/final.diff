@@ -216,3 +216,25 @@ export default function prettyBytes(
 	number: number | bigint,
 	options?: Options
 ): string;
+
+/**
+Parse a human readable binary size string into a number of bytes. The reverse of `prettyBytes(number, {binary: true})`.
+
+Accepts a plain number (`'512'`), or a number followed by `B` or one of the binary units `KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`, `ZiB`, `YiB`. The space before the unit is optional, the number may be fractional and carry a leading `+` or `-`, and units are case-sensitive. The same units without the `i` (`kB`/`KB`, `MB`, `GB`...) are also accepted and are powers of 1024, not 1000: `'1 KB'` is `1024`.
+
+The result is not rounded, so `'1.5 B'` is `1.5`.
+
+@throws A `TypeError` if the input is not a string, and a `SyntaxError` if it cannot be parsed or uses an unsupported unit.
+
+@example
+```
+import {parseBytes} from 'pretty-bytes';
+
+parseBytes('512');
+//=> 512
+
+parseBytes('1.5 KiB');
+//=> 1536
+```
+*/
+export function parseBytes(string: string): number;
diff --git a/index.js b/index.js
index c5f37ab..85e98d2 100644
--- a/index.js
+++ b/index.js
@@ -285,3 +285,39 @@ export default function prettyBytes(number, options) {
 	const result = prefix + numberString + separator + UNITS[exponent];
 	return result.padStart(options.fixedWidth ?? 0);
 }
+
+// Matching is case-sensitive. Units without the `i` (`kB`, `KB`, `MB`...) are powers of 1024, the same as the binary units (Windows Explorer style).
+const PARSE_EXPONENTS = new Map([
+	['B', 0],
+	['kB', 1],
+	['KB', 1],
+	...['MB', 'GB', 'TB', 'PB', 'EB', 'ZB', 'YB'].map((unit, index) => [unit, index + 2]),
+	...BIBYTE_UNITS.map((unit, index) => [unit, index]),
+]);
+
+const PARSE_PATTERN = /^([+-]?)(\d+(?:\.\d+)?|\.\d+)\s*([A-Za-z]*)$/;
+
+export function parseBytes(string) {
+	if (typeof string !== 'string') {
+		throw new TypeError(`Expected a string, got ${typeof string}`);
+	}
+
+	const match = PARSE_PATTERN.exec(string.trim());
+
+	if (!match) {
+		throw new SyntaxError(`Unable to parse bytes from: ${JSON.stringify(string)}`);
+	}
+
+	const [, sign, digits, unit] = match;
+	const exponent = unit === '' ? 0 : PARSE_EXPONENTS.get(unit);
+
+	if (exponent === undefined) {
+		throw new SyntaxError(`Unsupported unit ${JSON.stringify(unit)} in: ${JSON.stringify(string)}`);
+	}
+
+	// Scaling by a power of 2 is exact, so only the decimal digits can introduce rounding.
+	const bytes = Number(digits) * (1024 ** exponent);
+
+	// Avoid returning `-0`.
+	return sign === '-' && bytes !== 0 ? -bytes : bytes;
+}
