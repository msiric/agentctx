-  return options && options.combine
-    ? combineRanges(ranges)
-    : ranges
+  if (options && options.combine) {
+    ranges = combineRanges(ranges)
+  }
+
+  var limit = options && options.limit
+
+  if (typeof limit === 'number' && isFinite(limit) && Math.floor(limit) === limit &&
+    limit > 0 && ranges.length > limit) {
+    ranges = spanRanges(ranges)
+  }
+
+  return ranges
+}
+
+/**
+ * Collapse ranges into one spanning the lowest start to the highest end.
+ * @private
+ */
+
+function spanRanges (ranges) {
+  var start = ranges[0].start
+  var end = ranges[0].end
+
+  for (var i = 1; i < ranges.length; i++) {
+    if (ranges[i].start < start) start = ranges[i].start
+    if (ranges[i].end > end) end = ranges[i].end
+  }
+
+  var spanned = [{ start: start, end: end }]
+  spanned.type = ranges.type
+
+  return spanned
 }
 
