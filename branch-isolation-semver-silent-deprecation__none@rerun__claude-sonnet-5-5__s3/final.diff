diff --git a/tests/test_pysemver-cli.py b/tests/test_pysemver-cli.py
index 9933b0d..99765f0 100644
--- a/tests/test_pysemver-cli.py
+++ b/tests/test_pysemver-cli.py
@@ -4,6 +4,7 @@ from unittest.mock import patch
 
 import pytest
 
+from semver.cli import main as cli_main
 from semver import (
     cmd_bump,
     cmd_check,
@@ -155,3 +156,32 @@ def test_should_return_documented_error_code_for_invalid_version(cliargs, capsys
     # docs/pysemver.rst shows ``echo $?`` printing 2 for both commands
     assert main(cliargs) == 2
     assert capsys.readouterr().err.startswith("ERROR")
+
+
+@pytest.mark.parametrize("prefix", ["v", "V"])
+@pytest.mark.parametrize(
+    "cli,expected",
+    [
+        (["bump", "major", "{v}1.2.3"], "2.0.0"),
+        (["bump", "minor", "{v}1.2.3"], "1.3.0"),
+        (["bump", "patch", "{v}1.2.3"], "1.2.4"),
+        (["bump", "prerelease", "{v}1.2.3-rc.1"], "1.2.3-rc.2"),
+        (["bump", "build", "{v}1.2.3+build.1"], "1.2.3+build.2"),
+        (["compare", "{v}1.2.3", "{v}2.1.3"], "-1"),
+        (["compare", "{v}1.2.3", "1.2.3"], "0"),
+        (["compare", "2.0.0", "{v}1.2.3"], "1"),
+        (["check", "{v}1.2.3"], ""),
+        (["nextver", "{v}1.2.3", "patch"], "1.2.4"),
+        (["nextver", "{v}1.2.3-rc.1", "prerelease"], "1.2.3-rc.2"),
+    ],
+)
+def test_cli_accepts_leading_v(capsys, prefix, cli, expected):
+    assert cli_main([a.format(v=prefix) for a in cli]) == 0
+    out = capsys.readouterr().out.strip()
+    assert out == expected
+    assert "v" not in out.lower()
+
+
+@pytest.mark.parametrize("arg", ["vv1.2.3", "v", "v-1.2.3", "1.2.3v"])
+def test_cli_rejects_malformed_v_prefix(capsys, arg):
+    assert cli_main(["check", arg]) == 2
