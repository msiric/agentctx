+/**
+ * Parse a compound duration such as `"1h 30m"`, `"1h, 30m"` or `"2 days 4 hours"` and
+ * return the total in milliseconds. Each piece is parsed with `parse`, so every
+ * piece needs a unit and accepts the same units as `parse`.
+ *
+ * Unlike `parse`, this never returns `NaN`, so the result is always safe to
+ * pass to things like `setTimeout`.
+ *
+ * @param str - A compound duration string
+ * @returns The summed value in milliseconds
+ * @throws TypeError if `str` is not a string, is empty, is longer than 99
+ * characters, or any part of it can't be parsed
+ */
+export function parseCompound(str: string): number {
+  if (typeof str !== "string" || str.length === 0 || str.length > 100) {
+    throw new TypeError(
+      `Value provided to ms.parseCompound() must be a string with length between 1 and 99. value=${JSON.stringify(str)}`,
+    );
+  }
+  const piece = /-?\d*\.?\d+ *[a-z]+/gi;
+  // Pieces may be separated by whitespace, a single comma (with optional
+  // whitespace around it), or nothing at all.
+  const whole =
+    /^\s*-?\d*\.?\d+ *[a-z]+(?:(?:\s*,\s*|\s*)-?\d*\.?\d+ *[a-z]+)*\s*$/i;
+  const pieces = whole.test(str) ? str.match(piece) : null;
+  const total = pieces ? pieces.reduce((sum, p) => sum + parse(p), 0) : NaN;
+
+  if (Number.isNaN(total)) {
+    throw new TypeError(
+      `Value provided to ms.parseCompound() is not a valid compound duration. value=${JSON.stringify(str)}`,
+    );
+  }
+
+  return total;
+}
+
+/**
+ * Parse a timer-style string and return milliseconds: `"m:ss"` (e.g. `"1:30"`)
+ * or `"h:mm:ss"` (e.g. `"01:02:03"`).
+ *
+ * Seconds (and minutes, when hours are present) must be two digits and
+ * below 60. The leading field may have any number of digits.
+ *
+ * Unlike `parseCompound`, this returns `undefined` on bad input instead of
+ * throwing, and never returns `NaN`.
+ *
+ * @param str - A clock-style duration string
+ * @returns The value in milliseconds, or `undefined` if `str` is invalid
+ */
+export function parseClock(str: string): number | undefined {
+  if (typeof str !== "string" || str.length > 100) {
+    return undefined;
+  }
+  const match = /^(?:(\d+):([0-5]\d)|(\d+):([0-5]\d):([0-5]\d))$/.exec(
+    str.trim(),
+  );
+  if (!match) {
+    return undefined;
+  }
+  const [h, m, s] =
+    match[1] !== undefined
+      ? [0, match[1], match[2]]
+      : [match[3], match[4], match[5]];
+  return (Number(h) * 3600 + Number(m) * 60 + Number(s)) * 1000;
+}
