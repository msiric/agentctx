new file mode 100644
index 0000000..7cbffc0
--- /dev/null
+++ b/src/parse-clock.test.ts
@@ -0,0 +1,48 @@
+import { describe, expect, it } from "@jest/globals";
+import { parseClock } from "./index";
+
+describe("parseClock(string)", () => {
+  it("should parse m:ss", () => {
+    expect(parseClock("1:30")).toBe(90000);
+    expect(parseClock("0:05")).toBe(5000);
+    expect(parseClock("90:00")).toBe(5400000);
+  });
+
+  it("should parse h:mm:ss", () => {
+    expect(parseClock("01:02:03")).toBe(3723000);
+    expect(parseClock("1:00:00")).toBe(3600000);
+    expect(parseClock("100:00:01")).toBe(360001000);
+  });
+
+  it("should ignore surrounding whitespace", () => {
+    expect(parseClock(" 1:30 ")).toBe(90000);
+  });
+
+  it.each([
+    [""],
+    ["abc"],
+    ["90"],
+    ["1:5"],
+    ["1:60"],
+    ["1:02:60"],
+    ["1:60:00"],
+    ["1:2:03"],
+    [":30"],
+    ["1:"],
+    ["1:30:"],
+    ["1:02:03:04"],
+    ["-1:30"],
+    ["1.5:30"],
+    ["1h"],
+  ])("should return undefined for %j", (input) => {
+    expect(parseClock(input)).toBeUndefined();
+  });
+
+  it("should return undefined for non-strings and overlong input", () => {
+    // @ts-expect-error - testing runtime behaviour
+    expect(parseClock(5)).toBeUndefined();
+    // @ts-expect-error - testing runtime behaviour
+    expect(parseClock(null)).toBeUndefined();
+    expect(parseClock("1".repeat(101))).toBeUndefined();
+  });
+});
diff --git a/src/parse-compound.test.ts b/src/parse-compound.test.ts
new file mode 100644
index 0000000..99715f2
--- /dev/null
+++ b/src/parse-compound.test.ts
@@ -0,0 +1,62 @@
+import { describe, expect, it } from '@jest/globals';
+import { parseCompound } from './index';
+
+describe('parseCompound(string)', () => {
+  it('should sum short units', () => {
+    expect(parseCompound('1h 30m')).toBe(5400000);
+  });
+
+  it('should sum long units with spaces', () => {
+    expect(parseCompound('2 days 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
+  });
+
+  it('should accept pieces without separators', () => {
+    expect(parseCompound('1h30m15s')).toBe(5415000);
+  });
+
+  it('should accept commas between pieces', () => {
+    expect(parseCompound('1h, 30m')).toBe(5400000);
+    expect(parseCompound('1h,30m')).toBe(5400000);
+    expect(parseCompound('2 days , 4 hours, 1m')).toBe(
+      2 * 86400000 + 4 * 3600000 + 60000,
+    );
+  });
+
+  it('should accept a single piece', () => {
+    expect(parseCompound('90 seconds')).toBe(90000);
+  });
+
+  it('should accept decimals and negative pieces', () => {
+    expect(parseCompound('1.5h -30m')).toBe(3600000);
+  });
+
+  it('should ignore surrounding whitespace', () => {
+    expect(parseCompound('  1m 1s  ')).toBe(61000);
+  });
+
+  it.each([
+    ['1h 5x'],
+    ['1h and 30m'],
+    ['foo'],
+    ['abc'],
+    ['1h foo'],
+    ['100'],
+    ['1h 30'],
+    ['   '],
+    ['1h,, 30m'],
+    [',1h'],
+    ['1h,'],
+    ['1h, and 30m'],
+  ])('should throw a TypeError including the input for %j', (input) => {
+    expect(() => parseCompound(input)).toThrow(TypeError);
+    expect(() => parseCompound(input)).toThrow(JSON.stringify(input));
+  });
+
+  it('should throw a TypeError for empty, too long or non-string values', () => {
+    expect(() => parseCompound('')).toThrow(TypeError);
+    expect(() => parseCompound('')).toThrow('value=""');
+    expect(() => parseCompound('1h '.repeat(40))).toThrow(TypeError);
+    // @ts-expect-error - testing runtime behaviour
+    expect(() => parseCompound(5)).toThrow(TypeError);
+  });
+});
