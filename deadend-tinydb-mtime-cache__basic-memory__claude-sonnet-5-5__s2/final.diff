@@ -0,0 +1,85 @@
+"""Benchmark TinyDB read paths on a large JSON db.
+
+Usage: python scripts/bench_read.py [--size-mb 40] [--repeat 5] [--path FILE]
+"""
+import argparse
+import cProfile
+import json
+import os
+import pstats
+import random
+import sys
+import tempfile
+import time
+
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..'))
+
+from tinydb import TinyDB, where  # noqa: E402
+
+
+def generate(path, size_mb):
+    rnd = random.Random(0)
+    docs, size, i = {}, 0, 0
+    target = size_mb * 1024 * 1024
+    while size < target:
+        i += 1
+        doc = {'name': f'user{i}', 'age': rnd.randint(18, 90),
+               'email': f'user{i}@example.com',
+               'tags': [rnd.choice('abcdefgh') * 5 for _ in range(5)],
+               'bio': ''.join(rnd.choices('abcdefghij klmnop', k=200))}
+        docs[str(i)] = doc
+        size += len(json.dumps(doc)) + 10
+    with open(path, 'w') as f:
+        json.dump({'_default': docs}, f)
+    return i
+
+
+def timed(label, fn, repeat):
+    ts = []
+    for _ in range(repeat):
+        t = time.perf_counter()
+        r = fn()
+        ts.append(time.perf_counter() - t)
+    print(f'{label:<34} min {min(ts)*1000:8.1f} ms   median '
+          f'{sorted(ts)[len(ts)//2]*1000:8.1f} ms   ({len(r)} results)')
+    return r
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--size-mb', type=int, default=40)
+    ap.add_argument('--repeat', type=int, default=5)
+    ap.add_argument('--path')
+    a = ap.parse_args()
+
+    with tempfile.TemporaryDirectory() as d:
+        path = a.path or os.path.join(d, 'db.json')
+        if not a.path:
+            n = generate(path, a.size_mb)
+            print(f'generated {n} docs')
+        print(f'file size: {os.path.getsize(path)/1e6:.1f} MB')
+
+        with open(path) as f:
+            t = time.perf_counter(); data = json.load(f)
+            print(f'raw json.load: {(time.perf_counter()-t)*1000:.1f} ms')
+
+        db = TinyDB(path)
+        timed('db.all()', db.all, a.repeat)
+        # Distinct conditions each time so the query cache can't hide the cost
+        counter = iter(range(10**6))
+        timed('db.search (uncached, new query)',
+              lambda: db.search(where('age') == 18 + next(counter) % 70), a.repeat)
+        q = where('name') == 'user1'
+        db.search(q)
+        timed('db.search (cached, same query)', lambda: db.search(q), a.repeat)
+        timed('len(db)', lambda: [db.__len__()], a.repeat)
+
+        print('\n--- profile of one uncached search ---')
+        pr = cProfile.Profile()
+        pr.runcall(db.search, where('age') == 99)
+        pstats.Stats(pr).sort_stats('cumulative').print_stats(8)
+        db.close()
+
+
+if __name__ == '__main__':
+    main()
