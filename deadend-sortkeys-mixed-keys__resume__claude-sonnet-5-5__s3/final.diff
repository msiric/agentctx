+def _keys_in_order(path, *keys):
+    with open(path) as f:
+        content = f.read()
+    positions = [content.index('"{}"'.format(k)) for k in keys]
+    return positions == sorted(positions)
+
+
+def test_json_sort_keys_default(tmpdir):
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path) as db:
+        db.insert({'b': 1, 'a': {'z': 1, 'y': 2}})
+
+    assert _keys_in_order(path, 'a', 'y', 'z', 'b')
+
+
+def test_json_sort_keys_stable_across_insertion_order(tmpdir):
+    p1 = str(tmpdir.join('1.json'))
+    p2 = str(tmpdir.join('2.json'))
+
+    with TinyDB(p1) as db:
+        db.insert({'a': 1, 'b': 2, 'c': {'x': 1, 'y': 2}})
+    with TinyDB(p2) as db:
+        db.insert({'c': {'y': 2, 'x': 1}, 'b': 2, 'a': 1})
+
+    with open(p1) as f1, open(p2) as f2:
+        assert f1.read() == f2.read()
+
+
+def test_json_sort_keys_opt_out(tmpdir):
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path, sort_keys=False) as db:
+        db.insert({'b': 1, 'a': 2})
+
+    assert _keys_in_order(path, 'b', 'a')
+
+
+def test_json_sort_keys_mixed_key_types(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    doc = {'endpoint': '/api/orders', 'hits': {200: 1520, 404: 12, 'other': 3}}
+
+    with TinyDB(path) as db:
+        db.insert(doc)
+        db.insert({'hits': {'other': 1, 500: 2}})
+
+    assert _keys_in_order(path, '200', '404', 'other')
+    with TinyDB(path) as db:
+        assert db.all()[0]['hits'] == {'200': 1520, '404': 12, 'other': 3}
