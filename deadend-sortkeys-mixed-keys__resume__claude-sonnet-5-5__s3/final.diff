+def _sort_keys(obj: Any) -> Any:
+    """
+    Recursively rebuild dicts with their keys in a stable order.
+
+    ``json.dumps(sort_keys=True)`` fails on dicts that mix key types (e.g.
+    ``{200: 1, "other": 2}``), so we order by the string form of each key
+    instead, which is what ends up in the JSON output anyway.
+    """
+    if isinstance(obj, dict):
+        return {k: _sort_keys(obj[k]) for k in sorted(obj, key=str)}
+    if isinstance(obj, (list, tuple)):
+        return [_sort_keys(v) for v in obj]
+    return obj
+
+
