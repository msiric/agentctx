+    def test_status(self):
+        import json
+
+        real_datetime = datetime.datetime
+
+        def ms(*args):
+            return int(real_datetime(*args).timestamp() * 1000)
+
+        scheduler = schedule.Scheduler()
+        assert scheduler.status() == []
+        with mock_datetime(2024, 1, 1, 12, 0, 0):
+            scheduler.every(5).minutes.do(make_mock_job(name="job1"))
+            scheduler.every().day.at("10:30").do(make_mock_job(name="job2"))
+            status = scheduler.status()
+            assert status[0] == {
+                "job": "job1",
+                "interval": 5,
+                "unit": "minutes",
+                "last_run": None,
+                "next_run": ms(2024, 1, 1, 12, 5),
+            }
+            assert status[1]["job"] == "job2"
+            assert status[1]["unit"] == "days"
+            assert status[1]["next_run"] == ms(2024, 1, 2, 10, 30)
+            scheduler.jobs[0].run()
+            status = scheduler.status()
+            assert status[0]["last_run"] == ms(2024, 1, 1, 12, 0)
+            assert isinstance(status[0]["last_run"], int)
+            json.dumps(status)
+
+    def test_heartbeat(self):
+        import json
+        import tempfile
+
+        real_datetime = datetime.datetime
+
+        def ms(*args):
+            return int(real_datetime(*args).timestamp() * 1000)
+
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "hb.json")
+
+            # Disabled by default: nothing written
+            schedule.Scheduler().run_pending()
+            assert os.listdir(d) == []
+
+            scheduler = schedule.Scheduler(heartbeat_path=path)
+            with mock_datetime(2024, 1, 1, 12, 0, 0):
+                # No jobs: next_run is null
+                scheduler.run_pending()
+                with open(path) as f:
+                    assert json.load(f) == {
+                        "last_pass": ms(2024, 1, 1, 12, 0),
+                        "next_run": None,
+                    }
+
+                scheduler.every(5).minutes.do(make_mock_job())
+                scheduler.every(1).hours.do(make_mock_job())
+                scheduler.run_pending()
+                with open(path) as f:
+                    assert json.load(f) == {
+                        "last_pass": ms(2024, 1, 1, 12, 0),
+                        "next_run": ms(2024, 1, 1, 12, 5),
+                    }
+
+            # A pass that runs a job reports the rescheduled next_run
+            with mock_datetime(2024, 1, 1, 12, 6, 0):
+                scheduler.run_pending()
+                with open(path) as f:
+                    assert json.load(f) == {
+                        "last_pass": ms(2024, 1, 1, 12, 6),
+                        "next_run": ms(2024, 1, 1, 12, 11),
+                    }
+            assert os.listdir(d) == ["hb.json"]
+
+    def test_heartbeat_write_failure_does_not_break_scheduler(self):
+        job = make_mock_job()
+        scheduler = schedule.Scheduler(heartbeat_path="/nonexistent-dir/hb.json")
+        with mock_datetime(2024, 1, 1, 12, 0, 0):
+            scheduler.every(1).seconds.do(job)
+            scheduler.run_pending()
+        with mock_datetime(2024, 1, 1, 12, 0, 2):
+            scheduler.run_pending()
+        assert job.call_count == 1
