diff --git a/test/same-origin.test.ts b/test/same-origin.test.ts
new file mode 100644
index 0000000..082e78a
--- /dev/null
+++ b/test/same-origin.test.ts
@@ -0,0 +1,151 @@
+import { describe, expect, test } from "vitest";
+import { isSameOrigin } from "../src";
+
+describe("isSameOrigin", () => {
+  describe("same origin", () => {
+    const tests: [string, string][] = [
+      // Identical
+      ["https://example.com", "https://example.com"],
+      // Path, query and hash are ignored
+      ["https://example.com/a", "https://example.com/b"],
+      ["https://example.com/a?x=1#h", "https://example.com/b?y=2"],
+      ["https://example.com", "https://example.com/"],
+      // Host is case-insensitive
+      ["https://EXAMPLE.com", "https://example.com"],
+      // Protocol is case-insensitive
+      ["HTTPS://example.com", "https://example.com"],
+      // Default ports are normalized
+      ["https://example.com:443", "https://example.com"],
+      ["http://example.com:80", "http://example.com"],
+      // Identical explicit ports match
+      ["https://example.com:443/a", "https://example.com:443/b"],
+      ["http://example.com:8080/a", "http://example.com:8080/b"],
+      // Explicit non-default ports match
+      ["http://example.com:8080/a", "http://example.com:8080/b"],
+      // Credentials are not part of the origin
+      ["https://user:pass@example.com", "https://example.com"],
+      // Internationalized hostnames: unicode and punycode are equivalent
+      ["https://münchen.de", "https://xn--mnchen-3ya.de"],
+    ];
+    test.each(tests)("%s ≡ %s", (a, b) => {
+      expect(isSameOrigin(a, b)).toBe(true);
+      // Symmetric
+      expect(isSameOrigin(b, a)).toBe(true);
+    });
+  });
+
+  describe("different origin", () => {
+    const tests: [string, string][] = [
+      // Protocol
+      ["http://example.com", "https://example.com"],
+      // Host
+      ["https://example.com", "https://example.org"],
+      // Subdomains are distinct
+      ["https://example.com", "https://www.example.com"],
+      ["https://a.example.com", "https://b.example.com"],
+      // Port
+      ["https://example.com:8080", "https://example.com"],
+      ["https://example.com:8080", "https://example.com:8081"],
+      // A non-default port for the scheme is distinct
+      ["http://example.com:443", "http://example.com"],
+      // Userinfo trick: host is what follows the `@`
+      ["https://example.com@evil.com", "https://example.com"],
+      // Suffix / prefix lookalikes
+      ["https://example.com.evil.com", "https://example.com"],
+      ["https://example.com", "https://notexample.com"],
+    ];
+    test.each(tests)("%s ≢ %s", (a, b) => {
+      expect(isSameOrigin(a, b)).toBe(false);
+      expect(isSameOrigin(b, a)).toBe(false);
+    });
+  });
+
+  describe("relative and protocol-relative inputs", () => {
+    // Open question: relative URLs have no origin of their own.
+    // Proposed semantics: a URL without a host never has an origin,
+    // so it is never "same origin" as anything (including itself).
+    test.each([
+      ["/path", "/path"],
+      ["/path", "https://example.com/path"],
+      ["https://example.com/path", "/path"],
+      ["path", "path"],
+      ["", ""],
+      ["?a=1", "?a=1"],
+      ["#hash", "#hash"],
+    ])("%j vs %j is false", (a, b) => {
+      expect(isSameOrigin(a, b)).toBe(false);
+    });
+
+    // Open question: `//host` has no protocol, so it cannot be compared
+    // strictly. Proposed: false unless both sides are protocol-relative
+    // with the same host.
+    test("protocol-relative on both sides compares host and port", () => {
+      expect(isSameOrigin("//example.com/a", "//example.com/b")).toBe(true);
+      expect(isSameOrigin("//example.com", "//example.org")).toBe(false);
+    });
+    test("protocol-relative vs absolute is false", () => {
+      expect(isSameOrigin("//example.com", "https://example.com")).toBe(false);
+      expect(isSameOrigin("https://example.com", "//example.com")).toBe(false);
+    });
+  });
+
+  describe("opaque / non-hierarchical origins", () => {
+    // Per the WHATWG URL spec these serialize to the opaque origin "null",
+    // which is never equal to any other origin (even itself).
+    test.each([
+      ["mailto:a@example.com", "mailto:a@example.com"],
+      ["javascript:alert(1)", "javascript:alert(1)"],
+      ["data:text/plain,hi", "data:text/plain,hi"],
+      ["blob:https://example.com/uuid", "blob:https://example.com/uuid"],
+      ["file:///a", "file:///a"],
+      ["file:///a", "file:///b"],
+    ])("%s vs %s is false", (a, b) => {
+      expect(isSameOrigin(a, b)).toBe(false);
+    });
+  });
+
+  describe("other schemes", () => {
+    test("ws / wss compare like http(s), with default-port normalization", () => {
+      expect(isSameOrigin("ws://example.com/a", "ws://example.com/b")).toBe(
+        true,
+      );
+      expect(isSameOrigin("wss://example.com:443", "wss://example.com")).toBe(
+        true,
+      );
+      expect(isSameOrigin("ws://example.com", "wss://example.com")).toBe(false);
+    });
+    test("ws is not same-origin as http", () => {
+      expect(isSameOrigin("ws://example.com", "http://example.com")).toBe(
+        false,
+      );
+    });
+  });
+
+  describe("edge cases", () => {
+    test("backslashes are treated as slashes for special schemes", () => {
+      expect(isSameOrigin("https:\\\\example.com\\a", "https://example.com")).toBe(
+        true,
+      );
+    });
+    test("trailing dot in host is distinct", () => {
+      expect(isSameOrigin("https://example.com.", "https://example.com")).toBe(
+        false,
+      );
+    });
+    test("IPv4 and IPv6 literals", () => {
+      expect(isSameOrigin("http://127.0.0.1:3000/a", "http://127.0.0.1:3000")).toBe(
+        true,
+      );
+      expect(isSameOrigin("http://[::1]:3000/a", "http://[::1]:3000/b")).toBe(
+        true,
+      );
+      expect(isSameOrigin("http://127.0.0.1", "http://localhost")).toBe(false);
+    });
+    test("invalid input returns false instead of throwing", () => {
+      expect(isSameOrigin("http://", "http://")).toBe(false);
+      expect(isSameOrigin("https://exa mple.com", "https://exa mple.com")).toBe(
+        false,
+      );
+    });
+  });
+});
