@@ -773,3 +781,33 @@ export function withoutHost(input: string) {
   const parsed = parseURL(input);
   return (parsed.pathname || "/") + parsed.search + parsed.hash;
 }
+
+const SAME_ORIGIN_SCHEMES = new Set(["http:", "https:", "ws:", "wss:"]);
+const PROTOCOL_RELATIVE_RE = /^[/\\]{2}/;
+
+/**
+ * Checks whether two URLs share the same origin (protocol, host and port).
+ *
+ * - Default ports are normalized (`https://x` ≡ `https://x:443`).
+ * - Path, query, hash and credentials are ignored.
+ * - Relative URLs and non-http(s)/ws(s) schemes have no origin and return `false`.
+ * - Protocol-relative URLs (`//host`) only match other protocol-relative URLs.
+ */
+export function isSameOrigin(a: string, b: string): boolean {
+  const aRel = PROTOCOL_RELATIVE_RE.test(a);
+  const bRel = PROTOCOL_RELATIVE_RE.test(b);
+  if (aRel !== bRel) {
+    return false;
+  }
+  try {
+    // Placeholder scheme for protocol-relative inputs (compared on host:port only)
+    const urlA = new URL(aRel ? "http:" + a : a);
+    const urlB = new URL(bRel ? "http:" + b : b);
+    if (!SAME_ORIGIN_SCHEMES.has(urlA.protocol) || !urlA.host) {
+      return false;
+    }
+    return urlA.origin === urlB.origin && urlA.origin !== "null";
+  } catch {
+    return false;
+  }
+}
