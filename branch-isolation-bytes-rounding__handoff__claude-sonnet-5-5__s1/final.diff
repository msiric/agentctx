+/**
+ * Truncate a non-negative number to the given decimal places, without rounding.
+ *
+ * Dividing by a power of two is exact, so toFixed with many digits yields the
+ * exact decimal expansion; cutting that string avoids float error from
+ * multiplying by 10^decimalPlaces.
+ *
+ * @param {number} val
+ * @param {number} decimalPlaces
+ * @returns {string}
+ * @private
+ */
+
+function truncate(val, decimalPlaces) {
+  var places = Math.max(0, Math.floor(decimalPlaces) || 0);
+  var exact = val.toFixed(100);
+  var dot = exact.indexOf('.');
+
+  return places === 0 ? exact.slice(0, dot) : exact.slice(0, dot + 1 + places);
+}
