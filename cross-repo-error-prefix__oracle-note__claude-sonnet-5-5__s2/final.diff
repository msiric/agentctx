@@ -292,3 +292,56 @@ test('keep the sub-day parts exact at any magnitude', () => {
 		assert.strictEqual(parsed.hours, Number(bigint.hours), `${milliseconds}ms hours against the bigint path`);
 	}
 });
+
+test('largestUnit rolls bigger units into the chosen one', () => {
+	const milliseconds = 93_600_000 + 61_000 + 5; // 1d 2h 1m 1s 5ms
+
+	const expectations = {
+		days: [1, 2, 1, 1],
+		hours: [0, 26, 1, 1],
+		minutes: [0, 0, 1561, 1],
+		seconds: [0, 0, 0, 93_661],
+	};
+
+	for (const [largestUnit, [days, hours, minutes, seconds]] of Object.entries(expectations)) {
+		const expected = {
+			days, hours, minutes, seconds, milliseconds: 5, microseconds: 0, nanoseconds: 0,
+		};
+		assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit}), expected, largestUnit);
+		assert.deepStrictEqual(
+			parseMilliseconds(BigInt(milliseconds), {largestUnit}),
+			Object.fromEntries(Object.entries(expected).map(([unit, value]) => [unit, BigInt(value)])),
+			`${largestUnit} bigint`,
+		);
+	}
+
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {}), parseMilliseconds(milliseconds));
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit: undefined}), parseMilliseconds(milliseconds));
+});
+
+test('largestUnit with negative and fractional input', () => {
+	assert.deepStrictEqual(parseMilliseconds(-93_600_000, {largestUnit: 'hours'}), {
+		days: 0, hours: -26, minutes: -0, seconds: -0, milliseconds: -0, microseconds: -0, nanoseconds: -0,
+	});
+	assert.strictEqual(parseMilliseconds(-93_600_000n, {largestUnit: 'minutes'}).minutes, -1560n);
+	assert.strictEqual(parseMilliseconds(1500.5, {largestUnit: 'seconds'}).seconds, 1);
+	assert.strictEqual(parseMilliseconds(1500.5, {largestUnit: 'seconds'}).microseconds, 500);
+});
+
+test('largestUnit keeps the lower parts exact at any magnitude', () => {
+	const exact = 10_000_000_000_000_000_000_000n;
+	const parsed = parseMilliseconds(1e22, {largestUnit: 'hours'});
+	assert.strictEqual(parsed.minutes, Number((exact % 3_600_000n) / 60_000n));
+	assert.strictEqual(parsed.seconds, Number((exact % 60_000n) / 1000n));
+});
+
+test('largestUnit rejects invalid values', () => {
+	for (const largestUnit of ['weeks', 'Days', 'milliseconds', '', null, 1, {}]) {
+		for (const input of [1000, 1000n]) {
+			assert.throws(() => parseMilliseconds(input, {largestUnit}), {
+				name: 'TypeError',
+				message: /^parse-ms: Expected `largestUnit`/v,
+			});
+		}
+	}
+});
