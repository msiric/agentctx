+
+/**
+ * Format the given milliseconds as an ISO 8601 duration string.
+ *
+ * Days are the largest unit used, since months and years are ambiguous.
+ * Sub-second precision is emitted as fractional seconds (e.g. `PT1.5S`).
+ * Negative values are prefixed with `-` (a widely supported extension).
+ *
+ * @param ms - milliseconds
+ * @returns The ISO 8601 duration, e.g. `PT1H30M` or `P1DT1H1M1S`
+ */
+export function formatISO(ms: number): string {
+  if (typeof ms !== 'number' || !Number.isFinite(ms)) {
+    throw new Error('Value provided to ms.formatISO() must be of type number.');
+  }
+
+  let rest = Math.round(Math.abs(ms));
+  const days = Math.floor(rest / d);
+  rest -= days * d;
+  const hours = Math.floor(rest / h);
+  rest -= hours * h;
+  const minutes = Math.floor(rest / m);
+  rest -= minutes * m;
+  const seconds = Math.floor(rest / s);
+  const millis = rest - seconds * s;
+
+  let time = '';
+  if (hours) time += `${hours}H`;
+  if (minutes) time += `${minutes}M`;
+  if (seconds || millis) {
+    const frac = millis
+      ? `.${String(millis).padStart(3, '0').replace(/0+$/, '')}`
+      : '';
+    time += `${seconds}${frac}S`;
+  }
+
+  if (!days && !time) {
+    return 'PT0S';
+  }
+
+  const sign = ms < 0 ? '-' : '';
+  return `${sign}P${days ? `${days}D` : ''}${time ? `T${time}` : ''}`;
+}
+
+/**
+ * Parse a decimal number made of digits with an optional single `.` (at least
+ * one digit overall). The caller guarantees the string only contains digits
+ * and dots. Hand-written (no regular expressions) on purpose.
+ */
+function parseISONumber(str: string): number {
+  let digits = 0;
+  let dots = 0;
+  for (let i = 0; i < str.length; i++) {
+    const c = str.charCodeAt(i);
+    if (c === 46) {
+      dots++;
+    } else {
+      digits++;
+    }
+  }
+  if (digits === 0 || dots > 1) {
+    return NaN;
+  }
+  return parseFloat(str);
+}
+
+/**
+ * Parse an ISO 8601 duration string and return milliseconds. This is the
+ * inverse of `formatISO`.
+ *
+ * Supports weeks (`W`), days (`D`), hours (`H`), minutes (`M`) and seconds
+ * (`S`, optionally fractional), plus a leading `-` or `+`. Years and months
+ * are ambiguous and are not supported.
+ *
+ * @param str - An ISO 8601 duration, e.g. `PT1H30M` or `P1DT1H1M1S`
+ * @returns The parsed value in milliseconds, or `NaN` if the string can't be
+ * parsed
+ */
+export function parseISO(str: string): number {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw new Error(
+      `Value provided to ms.parseISO() must be a string with length between 1 and 99. value=${JSON.stringify(str)}`,
+    );
+  }
+
+  let i = 0;
+  let sign = 1;
+  if (str[i] === '-' || str[i] === '+') {
+    sign = str[i] === '-' ? -1 : 1;
+    i++;
+  }
+  if (str[i] !== 'P') {
+    return NaN;
+  }
+  i++;
+
+  let total = 0;
+  let inTime = false;
+  let components = 0;
+  // Designators must appear in order, each at most once.
+  let lastRank = 0;
+  let start = i;
+
+  for (; i < str.length; i++) {
+    const ch = str[i] as string;
+    if (ch === 'T') {
+      if (inTime || i !== start) {
+        return NaN;
+      }
+      inTime = true;
+      start = i + 1;
+      continue;
+    }
+
+    let unitMs: number;
+    let rank: number;
+    if (!inTime && ch === 'W') {
+      unitMs = w;
+      rank = 1;
+    } else if (!inTime && ch === 'D') {
+      unitMs = d;
+      rank = 2;
+    } else if (inTime && ch === 'H') {
+      unitMs = h;
+      rank = 3;
+    } else if (inTime && ch === 'M') {
+      unitMs = m;
+      rank = 4;
+    } else if (inTime && ch === 'S') {
+      unitMs = s;
+      rank = 5;
+    } else if (ch >= '0' && ch <= '9') {
+      continue;
+    } else if (ch === '.') {
+      continue;
+    } else {
+      return NaN;
+    }
+
+    const n = parseISONumber(str.slice(start, i));
+    if (Number.isNaN(n) || rank <= lastRank) {
+      return NaN;
+    }
+    lastRank = rank;
+    components++;
+    total += n * unitMs;
+    start = i + 1;
+  }
+
+  // Trailing number without designator, no components, or dangling "T".
+  if (start !== str.length || components === 0) {
+    return NaN;
+  }
+  if (inTime && lastRank < 3) {
+    return NaN;
+  }
+
+  return sign * Math.round(total);
+}
