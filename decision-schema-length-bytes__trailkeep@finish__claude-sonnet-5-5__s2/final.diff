+
+
+def test_length():
+    assert Length(min=2, max=4).validate("ab") == "ab"
+    assert Length(min=2, max=4).validate("abcd") == "abcd"
+    assert Length(min=2).validate("a" * 100) == "a" * 100
+    assert Length(max=3).validate("") == ""
+    assert Length().validate("anything") == "anything"
+    with SE:
+        Length(min=2).validate("a")
+    with SE:
+        Length(max=3).validate("abcd")
+    with SE:
+        Length(max=3).validate(123)
+    with raises(ValueError):
+        Length(min=5, max=2)
+    assert Schema({"name": Length(max=5)}).validate({"name": "abc"}) == {"name": "abc"}
+    with SE:
+        Schema({"name": Length(max=5)}).validate({"name": "abcdef"})
+
+
+def test_length_counts_utf8_bytes():
+    # "é" is 1 character but 2 UTF-8 bytes
+    assert Length(max=2).validate("é") == "é"
+    with SE:
+        Length(max=3).validate("éé")
+    assert Length(max=4).validate("éé") == "éé"
+    with SE:
+        Length(min=3).validate("é")
+
+
+def test_length_custom_error():
+    with raises(SchemaError) as ei:
+        Length(max=1, error="too long: {}").validate("abc")
+    assert "too long: abc" in str(ei.value)
