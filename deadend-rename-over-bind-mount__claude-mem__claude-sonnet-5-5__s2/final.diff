diff --git a/tests/test_storages.py b/tests/test_storages.py
index 6e433a1..655d65b 100644
--- a/tests/test_storages.py
+++ b/tests/test_storages.py
@@ -285,3 +285,72 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+class _TornHandle:
+    """File handle proxy that dies halfway through a write (like a kill -9)."""
+
+    def __init__(self, handle):
+        self._handle = handle
+
+    def write(self, text):
+        self._handle.write(text[:len(text) // 2])
+        self._handle.flush()
+        raise KeyboardInterrupt('simulated kill')
+
+    def __getattr__(self, name):
+        return getattr(self._handle, name)
+
+
+def test_json_crash_during_write_recovers_new_state(tmpdir):
+    path = str(tmpdir.join('db.json'))
+
+    storage = JSONStorage(path)
+    old = {'_default': {'1': {'a': 1}}}
+    new = {'_default': {str(i): {'a': i} for i in range(50)}}
+    storage.write(old)
+
+    storage._handle = _TornHandle(storage._handle)
+    with pytest.raises(KeyboardInterrupt):
+        storage.write(new)
+
+    # The db file is torn, as after an OOM kill
+    with open(path) as f, pytest.raises(ValueError):
+        json.load(f)
+
+    inode = os.stat(path).st_ino
+    db = TinyDB(path)
+    assert db.storage.read() == new
+    db.close()
+
+    # Recovered in place (bind mounts) and journal cleaned up
+    assert os.stat(path).st_ino == inode
+    assert not os.path.exists(path + '.new')
+
+
+def test_json_crash_while_writing_journal_keeps_old_state(tmpdir):
+    path = str(tmpdir.join('db.json'))
+
+    storage = JSONStorage(path)
+    old = {'_default': {'1': {'a': 1}}}
+    storage.write(old)
+    storage.close()
+
+    # Truncated journal: the crash happened before the db file was touched
+    with open(path + '.new', 'w') as f:
+        f.write('{"_default": {"1": {"a"')
+
+    db = TinyDB(path)
+    assert db.storage.read() == old
+    db.close()
+    assert not os.path.exists(path + '.new')
+
+
+def test_json_write_leaves_no_journal(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    db = TinyDB(path)
+    db.insert({'a': 1})
+    db.close()
+
+    assert os.listdir(str(tmpdir)) == ['db.json']
+    assert TinyDB(path).all() == [{'a': 1}]
