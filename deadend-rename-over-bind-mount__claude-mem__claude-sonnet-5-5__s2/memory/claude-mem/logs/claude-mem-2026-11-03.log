def test_json_write_is_atomic(tmpdir, monkeypatch):
    path = str(tmpdir.join('db.json'))

    storage = JSONStorage(path)
    storage.write({'_default': {'1': {'a': 1}}})

    # Simulate a crash right before the rename
    def boom(*args, **kwargs):
        raise KeyboardInterrupt

    monkeypatch.setattr(os, 'replace', boom)
    with pytest.raises(KeyboardInterrupt):
        storage.write({'_default': {'1': {'a': 2}}})
    monkeypatch.undo()
    storage.close()

    # Old contents intact, no temp files left behind
    with open(path) as f:
        assert json.load(f) == {'_default': {'1': {'a': 1}}}
    assert os.listdir(str(tmpdir)) == ['db.json']
EOF
