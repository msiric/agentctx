def _crash_during_inplace_write(monkeypatch):
    """Make the in-place write of the db file die after a partial write."""
    real_write = io.TextIOWrapper.write

    def torn_write(self, text):
        if self.name.endswith('db.json'):
            real_write(self, text[:len(text) // 2])
            self.flush()
            raise KeyboardInterrupt('simulated kill')
        return real_write(self, text)

    monkeypatch.setattr(io.TextIOWrapper, 'write', torn_write)


def test_json_crash_during_write_recovers_new_state(tmpdir, monkeypatch):
    path = str(tmpdir.join('db.json'))

    storage = JSONStorage(path)
    old = {'_default': {'1': {'a': 1}}}
    new = {'_default': {str(i): {'a': i} for i in range(50)}}
    storage.write(old)

    with monkeypatch.context() as m:
        _crash_during_inplace_write(m)
        with pytest.raises(KeyboardInterrupt):
            storage.write(new)

    # The db file is torn, as after an OOM kill
    with open(path) as f, pytest.raises(ValueError):
        json.load(f)

    inode = os.stat(path).st_ino
    db = TinyDB(path)
    assert db.storage.read() == new
    db.close()

    # Recovered in place (bind mounts) and journal cleaned up
    assert os.stat(path).st_ino == inode
    assert not os.path.exists(path + '.new')


def test_json_crash_while_writing_journal_keeps_old_state(tmpdir):
    path = str(tmpdir.join('db.json'))

    storage = JSONStorage(path)
    old = {'_default': {'1': {'a': 1}}}
    storage.write(old)
    storage.close()

    # Truncated journal: the crash happened before the db file was touched
    with open(path + '.new', 'w') as f:
        f.write('{"_default": {"1": {"a"')

    db = TinyDB(path)
    assert db.storage.read() == old
    db.close()
    assert not os.path.exists(path + '.new')


def test_json_write_leaves_no_journal(tmpdir):
    path = str(tmpdir.join('db.json'))
    db = TinyDB(path)
    db.insert({'a': 1})
    db.close()

    assert os.listdir(str(tmpdir)) == ['db.json']
    assert TinyDB(path).all() == [{'a': 1}]
