diff --git a/index.js b/index.js
index 6f2d0f8..db7d4c1 100644
--- a/index.js
+++ b/index.js
@@ -34,6 +34,8 @@ var map = {
   pb: Math.pow(1024, 5),
 };
 
+var units = ['B', 'KB', 'MB', 'GB', 'TB', 'PB'];
+
 var parseRegExp = /^((-|\+)?(\d+(?:\.\d+)?)) *(kb|mb|gb|tb|pb)$/i;
 
 /**
@@ -93,7 +95,9 @@ function format(value, options) {
   var fixedDecimals = Boolean(options && options.fixedDecimals);
   var unit = (options && options.unit) || '';
 
-  if (!unit || !map[unit.toLowerCase()]) {
+  var autoUnit = !unit || !map[unit.toLowerCase()];
+
+  if (autoUnit) {
     if (mag >= map.pb) {
       unit = 'PB';
     } else if (mag >= map.tb) {
@@ -112,6 +116,17 @@ function format(value, options) {
   var val = value / map[unit.toLowerCase()];
   var str = val.toFixed(decimalPlaces);
 
+  // Rounding may push the value up to the next unit (e.g. 1024KB -> 1MB)
+  if (autoUnit) {
+    var next = units[units.indexOf(unit) + 1];
+
+    if (next && Math.abs(Number(str)) >= 1024) {
+      unit = next;
+      val = value / map[unit.toLowerCase()];
+      str = val.toFixed(decimalPlaces);
+    }
+  }
+
   if (!fixedDecimals) {
     str = str.replace(formatDecimalsRegExp, '$1');
   }
diff --git a/test/byte-format.js b/test/byte-format.js
index 7e82cee..36b5a4e 100644
--- a/test/byte-format.js
+++ b/test/byte-format.js
@@ -116,4 +116,23 @@ describe('Test byte format function', function(){
     assert.equal(bytes.format(12 * mb, {unit: ''}).toLowerCase(), '12mb');
     assert.equal(bytes.format(12 * mb, {unit: 'bb'}).toLowerCase(), '12mb');
   })
+
+  it('Should promote to the next unit when rounding reaches 1024', function(){
+    assert.equal(bytes.format(mb - 1), '1MB');
+    assert.equal(bytes.format(-(mb - 1)), '-1MB');
+    assert.equal(bytes.format(gb - 1), '1GB');
+    assert.equal(bytes.format(tb - 1), '1TB');
+    assert.equal(bytes.format(pb - 1), '1PB');
+    assert.equal(bytes.format(mb - 1, {fixedDecimals: true}), '1.00MB');
+    assert.equal(bytes.format(kb - 0.4, {decimalPlaces: 0}), '1KB');
+  })
+
+  it('Should not promote when value stays below 1024', function(){
+    assert.equal(bytes.format(mb - 1024), '1023KB');
+    assert.equal(bytes.format(mb - 1, {decimalPlaces: 6}), '1023.999023KB');
+  })
+
+  it('Should not promote with an explicit unit', function(){
+    assert.equal(bytes.format(mb - 1, {unit: 'kb'}), '1024kb');
+  })
 });
