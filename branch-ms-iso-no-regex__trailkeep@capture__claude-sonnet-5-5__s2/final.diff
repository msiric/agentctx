+
+/**
+ * Format the given milliseconds as an ISO 8601 duration string, e.g.
+ * `PT1H30M` or `P1DT1H1M1S`. Days are the largest unit used, since months and
+ * years are ambiguous. Sub-second precision is emitted as a decimal fraction
+ * of seconds (`PT1.5S`). Negative values get a leading `-`, and zero is
+ * `PT0S`. Fractional milliseconds are rounded.
+ *
+ * @param ms - milliseconds
+ * @returns The ISO 8601 duration string
+ */
+export function formatISO(ms: number): string {
+  if (typeof ms !== 'number' || !Number.isFinite(ms)) {
+    throw new Error('Value provided to ms.formatISO() must be of type number.');
+  }
+
+  let rest = Math.round(Math.abs(ms));
+  const days = Math.floor(rest / d);
+  rest -= days * d;
+  const hours = Math.floor(rest / h);
+  rest -= hours * h;
+  const minutes = Math.floor(rest / m);
+  rest -= minutes * m;
+  const seconds = Math.floor(rest / s);
+  const millis = rest - seconds * s;
+
+  const secStr = millis
+    ? `${seconds}.${String(millis).padStart(3, '0').replace(/0+$/, '')}`
+    : `${seconds}`;
+
+  const time =
+    (hours ? `${hours}H` : '') +
+    (minutes ? `${minutes}M` : '') +
+    (rest ? `${secStr}S` : '');
+
+  if (!days && !time) {
+    return 'PT0S';
+  }
+  return `${ms < 0 ? '-' : ''}P${days ? `${days}D` : ''}${time ? `T${time}` : ''}`;
+}
+
+function isDigit(c: string | undefined): boolean {
+  return c !== undefined && c >= '0' && c <= '9';
+}
+
+/**
+ * Parse an ISO 8601 duration string, e.g. `PT1H30M` or `P1DT1H1M1S`, and
+ * return milliseconds. This is the inverse of `formatISO`.
+ *
+ * Supports years, months, weeks, days, hours, minutes and seconds (years and
+ * months use the same approximations as `parse`), a decimal fraction on any
+ * component (`PT1.5S`, `,` is also accepted), and a leading `-` or `+`.
+ * Designators must appear in order, and at least one component is required.
+ * Hand-written scanner, no regular expressions.
+ *
+ * @param str - An ISO 8601 duration string
+ * @returns The parsed value in milliseconds, or `NaN` if the string is not a
+ * valid duration
+ */
+export function parseISO(str: string): number {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw new Error(
+      `Value provided to ms.parseISO() must be a string with length between 1 and 99. value=${JSON.stringify(str)}`,
+    );
+  }
+
+  let i = 0;
+  let sign = 1;
+  if (str[i] === '-' || str[i] === '+') {
+    sign = str[i] === '-' ? -1 : 1;
+    i++;
+  }
+  if (str[i] !== 'P') {
+    return NaN;
+  }
+  i++;
+
+  const dateUnits: Record<string, [number, number]> = {
+    Y: [y, 0],
+    M: [mo, 1],
+    W: [w, 2],
+    D: [d, 3],
+  };
+  const timeUnits: Record<string, [number, number]> = {
+    H: [h, 0],
+    M: [m, 1],
+    S: [s, 2],
+  };
+
+  let inTime = false;
+  let lastOrder = -1;
+  let count = 0;
+  let total = 0;
+
+  while (i < str.length) {
+    if (str[i] === 'T') {
+      // Only one T, and it must be followed by at least one component.
+      if (inTime || i === str.length - 1) {
+        return NaN;
+      }
+      inTime = true;
+      lastOrder = -1;
+      i++;
+      continue;
+    }
+
+    // number: digits [ ('.' | ',') digits ]
+    const start = i;
+    while (isDigit(str[i])) {
+      i++;
+    }
+    if (i === start) {
+      return NaN;
+    }
+    if (str[i] === '.' || str[i] === ',') {
+      i++;
+      const fracStart = i;
+      while (isDigit(str[i])) {
+        i++;
+      }
+      if (i === fracStart) {
+        return NaN;
+      }
+    }
+    const n = parseFloat(str.slice(start, i).replace(',', '.'));
+
+    const units = inTime ? timeUnits : dateUnits;
+    const designator = str[i] ?? '';
+    if (!Object.hasOwn(units, designator)) {
+      return NaN;
+    }
+    const entry = units[designator]!;
+    const [size, order] = entry;
+    if (order <= lastOrder) {
+      return NaN;
+    }
+    lastOrder = order;
+    total += n * size;
+    count++;
+    i++;
+  }
+
+  return count === 0 ? NaN : sign * total;
+}
