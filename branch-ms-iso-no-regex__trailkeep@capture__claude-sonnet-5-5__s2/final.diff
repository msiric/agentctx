+++ b/src/parse-iso.test.ts
@@ -0,0 +1,79 @@
+import { describe, expect, it } from '@jest/globals';
+import { formatISO, parseISO } from './index';
+
+describe('parseISO(string)', () => {
+  it('parses hours and minutes', () => {
+    expect(parseISO('PT1H30M')).toBe(5400000);
+  });
+
+  it('parses days, hours, minutes and seconds', () => {
+    expect(parseISO('P1DT1H1M1S')).toBe(90061000);
+  });
+
+  it('parses date-only and time-only durations', () => {
+    expect(parseISO('P1D')).toBe(86400000);
+    expect(parseISO('P2W')).toBe(14 * 86400000);
+    expect(parseISO('PT1S')).toBe(1000);
+    expect(parseISO('PT0S')).toBe(0);
+  });
+
+  it('parses fractional seconds and other fractions', () => {
+    expect(parseISO('PT1.5S')).toBe(1500);
+    expect(parseISO('PT0.001S')).toBe(1);
+    expect(parseISO('PT1,5S')).toBe(1500);
+    expect(parseISO('PT1.5H')).toBe(5400000);
+  });
+
+  it('parses years and months with the same approximations as parse()', () => {
+    expect(parseISO('P1Y')).toBe(365.25 * 86400000);
+    expect(parseISO('P1M')).toBe((365.25 * 86400000) / 12);
+    expect(parseISO('P1MT1M')).toBe((365.25 * 86400000) / 12 + 60000);
+  });
+
+  it('parses signs', () => {
+    expect(parseISO('-PT1H')).toBe(-3600000);
+    expect(parseISO('+PT1H')).toBe(3600000);
+  });
+
+  it('round-trips formatISO', () => {
+    for (const v of [0, 1, 999, 1500, 60000, 5400000, 90061001, -5400000]) {
+      expect(parseISO(formatISO(v))).toBe(v);
+    }
+  });
+
+  it('returns NaN for invalid input', () => {
+    for (const bad of [
+      'P',
+      'PT',
+      '-',
+      '1H',
+      'pt1h',
+      'PT1',
+      'PT1X',
+      'P1H',
+      'PT1D',
+      'P1DT',
+      'PT1H1H',
+      'PT1M1H',
+      'P1D1Y',
+      'PTT1H',
+      'PT.5S',
+      'PT1.S',
+      'PT-1H',
+      'P1 D',
+      'PT1H ',
+      'PT1S1',
+      'P1__proto__',
+      'PTconstructor',
+    ]) {
+      expect(parseISO(bad)).toBeNaN();
+    }
+  });
+
+  it('throws for non-strings and bad lengths', () => {
+    expect(() => parseISO('')).toThrow();
+    expect(() => parseISO('P' + '1'.repeat(100) + 'D')).toThrow();
+    // @ts-expect-error testing runtime behavior
+    expect(() => parseISO(5)).toThrow();
+  });
+});
