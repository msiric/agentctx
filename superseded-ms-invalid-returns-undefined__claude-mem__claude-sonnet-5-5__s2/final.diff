+/**
+ * Parse a compound duration such as `"1h 30m"`, `"1h, 30m"` or
+ * `"2 days 4 hours"` (pieces may be separated by whitespace and/or a single
+ * comma) and return the total in milliseconds. Each piece must have a unit and is parsed
+ * with {@link parse}.
+ *
+ * @param str - A compound duration string
+ * @returns The total in milliseconds (never `NaN`)
+ * @throws TypeError if `str` is not a string of 1 to 99 characters made up of
+ * valid number-and-unit pieces
+ */
+export function parseCompound(str: string): number {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw new TypeError(
+      `Value provided to ms.parseCompound() must be a string with length between 1 and 99. value=${JSON.stringify(str)}`,
+    );
+  }
+  let total = NaN;
+  const piece = '-?\\d*\\.?\\d+ *[a-z]+';
+  if (
+    new RegExp(`^\\s*${piece}(?:(?:\\s*,\\s*|\\s*)${piece})*\\s*$`, 'i').test(
+      str,
+    )
+  ) {
+    total = 0;
+    for (const [match] of str.matchAll(new RegExp(piece, 'gi'))) {
+      total += parse(match);
+    }
+  }
+  if (Number.isNaN(total)) {
+    throw new TypeError(
+      `Value provided to ms.parseCompound() is not a valid compound duration. value=${JSON.stringify(str)}`,
+    );
+  }
+  return total;
+}
+
+const CLOCK_REGEX = /^(?:(\d+):([0-5]\d)|(\d+):([0-5]\d):([0-5]\d))$/;
+
+/**
+ * Parse a timer-style clock string and return the total in milliseconds.
+ * `"m:ss"` (e.g. `"1:30"`) and `"h:mm:ss"` (e.g. `"01:02:03"`) are supported.
+ * Seconds, and minutes in the `h:mm:ss` form, must be two digits from `00` to
+ * `59`. The leading hours/minutes field may have any number of digits.
+ *
+ * Unlike {@link parseCompound}, this does not throw: invalid input returns
+ * `undefined`.
+ *
+ * @param str - A clock string
+ * @returns The total in milliseconds, or `undefined` if `str` is not valid
+ */
+export function parseClock(str: string): number | undefined {
+  if (typeof str !== 'string') return undefined;
+  const match = CLOCK_REGEX.exec(str);
+  if (!match) return undefined;
+  const [h, m, s] =
+    match[1] !== undefined
+      ? [0, Number(match[1]), Number(match[2])]
+      : [Number(match[3]), Number(match[4]), Number(match[5])];
+  return ((h * 60 + m) * 60 + s) * 1000;
+}
