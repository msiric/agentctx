+import { describe, expect, it } from '@jest/globals';
+import { parseCompound } from './index';
+
+describe('parseCompound(string)', () => {
+  it('should sum short units', () => {
+    expect(parseCompound('1h 30m')).toBe(5400000);
+  });
+
+  it('should sum long units with spaces', () => {
+    expect(parseCompound('2 days 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
+  });
+
+  it('should handle a single piece', () => {
+    expect(parseCompound('5s')).toBe(5000);
+  });
+
+  it('should handle pieces without separating whitespace', () => {
+    expect(parseCompound('1h30m')).toBe(5400000);
+  });
+
+  it('should accept commas between parts', () => {
+    expect(parseCompound('1h, 30m')).toBe(5400000);
+    expect(parseCompound('1h,30m')).toBe(5400000);
+    expect(parseCompound('2 days , 4 hours,30 min')).toBe(
+      2 * 86400000 + 4 * 3600000 + 30 * 60000,
+    );
+  });
+
+  it('should handle decimals, case and surrounding whitespace', () => {
+    expect(parseCompound(' 1.5H 500ms ')).toBe(5400500);
+  });
+
+  it.each([
+    ['1h 30'],
+    ['100'],
+    ['1h 30foo'],
+    ['1h foo'],
+    ['1h,'],
+    [',1h'],
+    ['1h,, 30m'],
+    ['1h , , 30m'],
+    ['abc'],
+  ])('should throw a TypeError including the input for %j', (input) => {
+    expect(() => parseCompound(input)).toThrow(TypeError);
+    expect(() => parseCompound(input)).toThrow(JSON.stringify(input));
+  });
+
+  it('should throw a TypeError for empty, non-string or too long values', () => {
+    expect(() => parseCompound('')).toThrow(TypeError);
+    expect(() => parseCompound('')).toThrow('value=""');
+    // @ts-expect-error - testing runtime behavior
+    expect(() => parseCompound(5)).toThrow(TypeError);
+    expect(() => parseCompound('1h '.repeat(40))).toThrow(TypeError);
+  });
+});
