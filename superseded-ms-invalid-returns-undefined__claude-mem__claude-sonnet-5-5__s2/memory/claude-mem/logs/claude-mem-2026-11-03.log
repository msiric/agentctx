import re
p='src/index.ts'
t=open(p).read()
a=t.index(" * Parse a compound duration")
b=t.index("/**\n * Parse the given StringValue")
new=''' * Parse a compound duration such as `"1h 30m"` or `"2 days 4 hours"` and
 * return the total in milliseconds. Each piece must have a unit and is parsed
 * with {@link parse}.
 *
 * @param str - A compound duration string
 * @returns The total in milliseconds (never `NaN`)
 * @throws TypeError if `str` is not a string of 1 to 99 characters made up of
 * valid number-and-unit pieces
 */
export function parseCompound(str: string): number {
  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
    throw new TypeError(
      `Value provided to ms.parseCompound() must be a string with length between 1 and 99. value=${JSON.stringify(str)}`,
    );
  }
  let total = NaN;
  if (/^\\s*(?:-?\\d*\\.?\\d+ *[a-z]+\\s*)+$/i.test(str)) {
    total = 0;
    for (const [piece] of str.matchAll(/-?\\d*\\.?\\d+ *[a-z]+/gi)) {
      total += parse(piece);
    }
  }
  if (Number.isNaN(total)) {
    throw new TypeError(
      `Value provided to ms.parseCompound() is not a valid compound duration. value=${JSON.stringify(str)}`,
    );
  }
  return total;
}

'''
t=t[:a]+new+t[b:]
open(p,'w').write(t)

p='src/parse-compound.test.ts'
t=open(p).read()
a=t.index("  it('should return NaN for a piece")
t=t[:a]+'''  it.each([
    ['1h 30'],
    ['100'],
    ['1h 30foo'],
    ['1h foo'],
    ['1h, 30m'],
    ['abc'],
  ])('should throw a TypeError including the input for %j', (input) => {
    expect(() => parseCompound(input)).toThrow(TypeError);
    expect(() => parseCompound(input)).toThrow(JSON.stringify(input));
  });

  it('should throw a TypeError for empty, non-string or too long values', () => {
    expect(() => parseCompound('')).toThrow(TypeError);
    expect(() => parseCompound('')).toThrow('value=""');
    // @ts-expect-error - testing runtime behavior
    expect(() => parseCompound(5)).toThrow(TypeError);
    expect(() => parseCompound('1h '.repeat(40))).toThrow(TypeError);
  });
});
'''
open(p,'w').write(t)
EOF
