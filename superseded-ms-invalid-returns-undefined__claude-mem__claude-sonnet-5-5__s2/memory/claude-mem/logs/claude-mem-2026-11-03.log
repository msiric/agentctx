p='src/index.ts'
t=open(p).read()
marker="/**\n * Parse the given StringValue and return milliseconds."
add='''/**
 * Parse a compound duration such as `"1h 30m"` or `"2 days 4 hours"` and
 * return the total in milliseconds. Each piece must have a unit and is parsed
 * with {@link parse}.
 *
 * @param str - A compound duration string
 * @returns The total in milliseconds, or `NaN` if any piece can't be parsed
 * @throws Error if `str` is not a string with length between 1 and 99
 */
export function parseCompound(str: string): number {
  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
    throw new Error(
      `Value provided to ms.parseCompound() must be a string with length between 1 and 99. value=${JSON.stringify(str)}`,
    );
  }
  const piece = /(-?\\d*\\.?\\d+) *[a-z]+/gi;
  if (!/^\\s*(?:(?:-?\\d*\\.?\\d+) *[a-z]+\\s*)+$/i.test(str)) {
    return NaN;
  }
  let total = 0;
  for (const [match] of str.matchAll(piece)) {
    total += parse(match);
  }
  return total;
}

'''
t=t.replace(marker,add+marker,1)
open(p,'w').write(t)
EOF
cat > src/parse-compound.test.ts <<'EOF'
import { describe, expect, it } from '@jest/globals';
import { parseCompound } from './index';

describe('parseCompound(string)', () => {
  it('should sum short units', () => {
    expect(parseCompound('1h 30m')).toBe(5400000);
  });

  it('should sum long units with spaces', () => {
    expect(parseCompound('2 days 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
  });

  it('should handle a single piece', () => {
    expect(parseCompound('5s')).toBe(5000);
  });

  it('should handle pieces without separating whitespace', () => {
    expect(parseCompound('1h30m')).toBe(5400000);
  });

  it('should handle decimals, case and surrounding whitespace', () => {
    expect(parseCompound(' 1.5H 500ms ')).toBe(5400500);
  });

  it('should return NaN for a piece without a unit', () => {
    expect(parseCompound('1h 30')).toBeNaN();
    expect(parseCompound('100')).toBeNaN();
  });

  it('should return NaN for unknown units or garbage', () => {
    expect(parseCompound('1h 30foo')).toBeNaN();
    expect(parseCompound('1h, 30m')).toBeNaN();
    expect(parseCompound('abc')).toBeNaN();
  });

  it('should throw for empty, non-string or too long values', () => {
    expect(() => parseCompound('')).toThrow();
    // @ts-expect-error - testing runtime behavior
    expect(() => parseCompound(5)).toThrow();
    expect(() => parseCompound('1h '.repeat(40))).toThrow();
  });
});
EOF
