+def gigabytes(num_bytes: float | str, precision: int = 1) -> str:
+    """Format a number of bytes as decimal gigabytes (10**9 bytes).
+
+    Unlike `naturalsize`, the unit is always GB, whatever the magnitude.
+
+    Examples:
+        ```pycon
+        >>> gigabytes(1500000000)
+        '1.5 GB'
+        >>> gigabytes(1500000000, precision=3)
+        '1.500 GB'
+        >>> gigabytes(250000000)
+        '0.2 GB'
+        >>> gigabytes(-3000000000, 0)
+        '-3 GB'
+
+        ```
+
+    Args:
+        num_bytes (int, float, str): Number of bytes to convert.
+        precision (int): Number of digits after the decimal point.
+
+    Returns:
+        str: The size in gigabytes, e.g. `'1.5 GB'`.
+    """
+    return f"{float(num_bytes) / 10**9:.{precision}f} " + _("GB")
