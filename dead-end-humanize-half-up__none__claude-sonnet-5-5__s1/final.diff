+def percent(value: NumberOrString, precision: int = 1) -> str:
+    """Return a fraction formatted as a percentage.
+
+    Examples:
+        ```pycon
+        >>> percent(0.125)
+        '12.5%'
+        >>> percent(0.5)
+        '50.0%'
+        >>> percent(1)
+        '100.0%'
+        >>> percent(0.12345, 2)
+        '12.35%'
+        >>> percent(0.5, 0)
+        '50%'
+        >>> percent(0.0125)
+        '1.3%'
+        >>> percent("0.25")
+        '25.0%'
+        >>> percent("foo")
+        'foo'
+        >>> percent(None)
+        'None'
+
+        ```
+
+    Args:
+        value (int, float, str): Fraction to format, where 1 is 100%.
+        precision (int): Number of digits after the decimal point.
+
+    Returns:
+        str: The percentage, rounded half up (away from zero), or the input as a string if it is not a number.
+    """
+    import math
+
+    try:
+        value = float(value)
+        if not math.isfinite(value):
+            return _format_not_finite(value)
+    except (ValueError, TypeError):
+        return str(value)
+    # Round half up on the shortest decimal repr of the input (not on its binary
+    # value), so 0.0125 -> "1.3%" as in billing's invoices.
+    digits = int(precision)
+    with decimal.localcontext() as ctx:
+        ctx.prec = 400
+        scaled = decimal.Decimal(repr(value)).scaleb(2)
+        rounded = scaled.quantize(
+            decimal.Decimal(1).scaleb(-digits), rounding=decimal.ROUND_HALF_UP
+        )
+        return f"{rounded:f}%"
+
