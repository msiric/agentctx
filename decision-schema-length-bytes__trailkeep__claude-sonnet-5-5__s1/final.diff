+def test_length_validator():
+    assert Length(min=2, max=4).validate("ab") == "ab"
+    assert Length(min=2, max=4).validate("abcd") == "abcd"
+    assert Length().validate("anything") == "anything"
+    assert Length(max=3).validate("") == ""
+    assert Length(min=2).validate("x" * 1000)
+    with SE:
+        Length(min=2, max=4).validate("a")
+    with SE:
+        Length(min=2, max=4).validate("abcde")
+    with SE:
+        Length(min=1).validate("")
+    with SE:
+        Length(max=2).validate(b"ab")
+    with SE:
+        Length(max=2).validate(None)
+
+
+def test_length_validator_counts_utf8_bytes():
+    # "é" is 1 character but 2 bytes in UTF-8
+    assert Length(max=2).validate("é") == "é"
+    with SE:
+        Length(max=3).validate("éé")
+    assert Length(max=4).validate("éé") == "éé"
+    with SE:
+        Length(min=3).validate("é")
+    with SE:
+        Length(max=3).validate("日本")  # 6 bytes
+
+
+def test_length_validator_ctor_and_schema():
+    with raises(ValueError):
+        Length(min=5, max=2)
+    with raises(ValueError):
+        Length(min=-1)
+    with raises(TypeError):
+        Length(min="1")
+    with raises(TypeError):
+        Length(max=True)
+    assert repr(Length(min=1, max=3)) == "Length(min=1, max=3)"
+    assert Schema({"name": Length(max=3)}).validate({"name": "abc"}) == {"name": "abc"}
+    with SE:
+        Schema({"name": Length(max=3)}).validate({"name": "abcd"})
+    with raises(SchemaError) as exc:
+        Length(max=1, error="too long: {}").validate("ab")
+    assert exc.value.errors == ["too long: ab"]
+    assert Schema(And(str, Length(min=1))).validate("a") == "a"
