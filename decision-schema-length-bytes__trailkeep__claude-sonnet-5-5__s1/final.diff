+class Length:
+    """
+    Validate that a string's length is within inclusive bounds.
+
+    Length is measured in UTF-8 encoded bytes, not characters, because the
+    values end up in byte-sized database columns (e.g. Oracle
+    VARCHAR2(n BYTE)); ``"é"`` counts as 2.
+    """
+
+    def __init__(
+        self,
+        min: Union[int, None] = None,
+        max: Union[int, None] = None,
+        error: Union[str, None] = None,
+    ) -> None:
+        for name, value in (("min", min), ("max", max)):
+            if value is not None and (
+                isinstance(value, bool) or not isinstance(value, int)
+            ):
+                raise TypeError(f"Length {name} must be an int or None, not {value!r}")
+            if value is not None and value < 0:
+                raise ValueError(f"Length {name} must be >= 0, not {value!r}")
+        if min is not None and max is not None and min > max:
+            raise ValueError(f"Length min ({min}) must not exceed max ({max})")
+        self._min: Union[int, None] = min
+        self._max: Union[int, None] = max
+        self._error: Union[str, None] = error
+
+    def __repr__(self) -> str:
+        return f"{self.__class__.__name__}(min={self._min!r}, max={self._max!r})"
+
+    def validate(self, data: str, **kwargs: Any) -> str:
+        """
+        Validates that the UTF-8 byte length of data is within bounds.
+        :param data: Data to be validated.
+        :return: Returns validated data.
+        """
+        e = self._error
+        if not isinstance(data, str):
+            raise SchemaError(f"{data!r} is not a string", e.format(data) if e else None)
+        size = len(data.encode("utf-8"))
+        if (self._min is not None and size < self._min) or (
+            self._max is not None and size > self._max
+        ):
+            raise SchemaError(
+                f"{data!r} has length {size} bytes (UTF-8), "
+                f"which is not within {self!r}",
+                e.format(data) if e else None,
+            )
+        return data
+
+
