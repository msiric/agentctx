diff --git a/tests/test_storages.py b/tests/test_storages.py
index 6e433a1..e6784aa 100644
--- a/tests/test_storages.py
+++ b/tests/test_storages.py
@@ -285,3 +285,80 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def _crash_write(path, data, crash_at):
+    """Run a write that dies (raises) at the given stage."""
+    storage = JSONStorage(path)
+
+    class Crash(BaseException):
+        pass
+
+    if crash_at == 'mid_inplace':
+        orig = storage._handle.write
+
+        def torn(text):
+            orig(text[:len(text) // 2])
+            storage._handle.flush()
+            raise Crash
+
+        storage._handle.write = torn
+    elif crash_at == 'mid_journal':
+        orig_fsync = os.fsync
+        calls = []
+
+        def fsync(fd):
+            calls.append(fd)
+            raise Crash
+
+        os.fsync = fsync
+    try:
+        with pytest.raises(Crash):
+            storage.write(data)
+    finally:
+        if crash_at == 'mid_journal':
+            os.fsync = orig_fsync
+    # Simulate process death: no close()/cleanup
+
+
+@pytest.mark.parametrize('crash_at', ['mid_journal', 'mid_inplace'])
+def test_json_crash_during_write(tmpdir, crash_at):
+    path = str(tmpdir.join('db.json'))
+    old = {'_default': {'1': {'a': 1}}}
+    new = {'_default': {'1': {'a': 1}, '2': {'b': 'x' * 1000}}}
+
+    storage = JSONStorage(path)
+    storage.write(old)
+    storage.close()
+
+    _crash_write(path, new, crash_at)
+
+    # Next open must yield a readable database: old or new state
+    db = TinyDB(path)
+    assert db.storage.read() in (old, new)
+    db.close()
+    assert not os.path.exists(path + '.journal')
+
+
+def test_json_truncated_journal_is_ignored(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    old = {'_default': {'1': {'a': 1}}}
+    storage = JSONStorage(path)
+    storage.write(old)
+    storage.close()
+
+    with open(path + '.journal', 'wb') as f:
+        f.write(b'deadbeef\n{"_default": {"1"')
+
+    storage = JSONStorage(path)
+    assert storage.read() == old
+    storage.close()
+    assert not os.path.exists(path + '.journal')
+
+
+def test_json_write_keeps_no_journal(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    storage = JSONStorage(path)
+    storage.write(doc)
+    assert not os.path.exists(path + '.journal')
+    storage.close()
