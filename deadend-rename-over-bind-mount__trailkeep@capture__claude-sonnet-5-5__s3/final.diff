+import hashlib
 import io
 import json
 import os
@@ -119,6 +120,65 @@ class JSONStorage(Storage):
         # Open the file for reading/writing
         self._handle = open(path, mode=self._mode, encoding=encoding)
 
+        # Crash safety: the file is rewritten in place (so it also works for
+        # single-file bind mounts, where rename-over-target fails with EBUSY).
+        # Before each in-place write the complete new state is saved to a
+        # checksummed journal next to the database; a leftover journal is
+        # replayed on open.
+        self._journal_path = os.fspath(path) + '.journal'
+        if any(c in self._mode for c in ('+', 'w', 'a')):
+            self._recover()
+
+    def _recover(self) -> None:
+        try:
+            with open(self._journal_path, 'rb') as f:
+                raw = f.read()
+        except FileNotFoundError:
+            return
+
+        digest, _, payload = raw.partition(b'\n')
+        if hashlib.sha256(payload).hexdigest().encode() == digest:
+            # Journal was fully written, but the in-place write may have been
+            # interrupted: redo it.
+            self._write_in_place(payload.decode(self._handle.encoding))
+        # Otherwise the crash happened while writing the journal. The main
+        # file was not touched yet, so it is still intact.
+        self._remove_journal()
+
+    def _remove_journal(self) -> None:
+        try:
+            os.remove(self._journal_path)
+        except FileNotFoundError:
+            return
+        self._fsync_dir()
+
+    def _fsync_dir(self) -> None:
+        try:
+            fd = os.open(os.path.dirname(os.path.abspath(self._journal_path)), os.O_RDONLY)
+        except OSError:  # e.g. Windows
+            return
+        try:
+            os.fsync(fd)
+        finally:
+            os.close(fd)
+
+    def _write_in_place(self, serialized: str) -> None:
+        self._handle.seek(0)
+        try:
+            self._handle.write(serialized)
+        except io.UnsupportedOperation:
+            raise IOError('Cannot write to the database. Access mode is "{0}"'.format(self._mode))
+
+        # Ensure the file has been written
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+
+        # Remove data that is behind the new cursor in case the file has
+        # gotten shorter
+        self._handle.truncate()
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+
     def close(self) -> None:
         self._handle.close()
 
