+    def test_heartbeat(self):
+        import json
+        import os
+        import tempfile
+
+        def ms(*args):
+            return round(datetime.datetime(*args).timestamp() * 1000)
+
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "hb.json")
+
+            # no path -> nothing written
+            schedule.Scheduler().run_pending()
+            assert not os.path.exists(path)
+
+            scheduler = schedule.Scheduler(heartbeat_path=path)
+            with mock_datetime(2024, 1, 1, 12, 0, 0):
+                scheduler.run_pending()
+            with open(path) as f:
+                assert json.load(f) == {"last_pass": ms(2024, 1, 1, 12, 0), "next_run": None}
+
+            with mock_datetime(2024, 1, 1, 12, 0, 0):
+                scheduler.every(5).minutes.do(make_mock_job())
+                scheduler.every(1).hours.do(make_mock_job())
+            with mock_datetime(2024, 1, 1, 12, 1, 0):
+                scheduler.run_pending()
+            with open(path) as f:
+                data = json.load(f)
+            assert data == {
+                "last_pass": ms(2024, 1, 1, 12, 1),
+                "next_run": ms(2024, 1, 1, 12, 5),
+            }
+            assert isinstance(data["last_pass"], int)
+
+            # next_run reflects jobs that ran during this pass
+            with mock_datetime(2024, 1, 1, 12, 5, 0):
+                scheduler.run_pending()
+            with open(path) as f:
+                data = json.load(f)
+            assert data["last_pass"] == ms(2024, 1, 1, 12, 5)
+            assert data["next_run"] == ms(2024, 1, 1, 12, 10)
