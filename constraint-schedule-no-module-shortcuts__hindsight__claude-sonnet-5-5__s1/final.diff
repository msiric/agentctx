diff --git a/test_schedule.py b/test_schedule.py
index f497826..cd856fd 100644
--- a/test_schedule.py
+++ b/test_schedule.py
@@ -1569,6 +1569,77 @@ class SchedulerTests(TestCase):
         schedule.clear()
         assert len(schedule.jobs) == 0
 
+    def test_pause_and_resume_by_tag(self):
+        with mock_datetime(2024, 1, 1, 10, 0, 0):
+            paused_mock = make_mock_job("paused")
+            other_mock = make_mock_job("other")
+            every().second.do(paused_mock).tag("maintenance")
+            every().second.do(other_mock).tag("other")
+
+            schedule.pause("maintenance")
+        with mock_datetime(2024, 1, 1, 10, 0, 5):
+            schedule.run_pending()
+            assert paused_mock.call_count == 0
+            assert other_mock.call_count == 1
+
+            schedule.resume("maintenance")
+            schedule.run_pending()
+            assert paused_mock.call_count == 1
+            # missed runs are not repeated
+            schedule.run_pending()
+            assert paused_mock.call_count == 1
+
+    def test_pause_keeps_jobs_scheduled(self):
+        job = every().second.do(make_mock_job()).tag("t")
+        schedule.pause("t")
+        assert job.paused
+        assert schedule.get_jobs("t") == [job]
+        schedule.resume("t")
+        assert not job.paused
+
+    def test_pause_unknown_tag_is_noop(self):
+        job = every().second.do(make_mock_job())
+        schedule.pause("nope")
+        schedule.resume("nope")
+        assert not job.paused
+
+    def test_get_jobs_for(self):
+        def foo():
+            pass
+
+        def bar():
+            pass
+
+        j1 = every().second.do(foo)
+        j2 = every().hour.do(foo)
+        j3 = every().minute.do(bar)
+
+        assert schedule.default_scheduler.get_jobs_for(foo) == [j1, j2]
+        assert schedule.default_scheduler.get_jobs_for(bar) == [j3]
+        assert schedule.default_scheduler.get_jobs_for(lambda: None) == []
+
+        # arguments don't matter
+        j4 = every().second.do(bar, 1, x=2)
+        assert schedule.default_scheduler.get_jobs_for(bar) == [j3, j4]
+
+        # cancelling via the lookup
+        for job in schedule.default_scheduler.get_jobs_for(foo):
+            schedule.cancel_job(job)
+        assert schedule.default_scheduler.get_jobs_for(foo) == []
+        assert schedule.get_jobs() == [j3, j4]
+        schedule.clear()
+
+    def test_get_jobs_for_bound_method(self):
+        class A:
+            def m(self):
+                pass
+
+        a = A()
+        job = every().second.do(a.m)
+        assert schedule.default_scheduler.get_jobs_for(a.m) == [job]
+        assert schedule.default_scheduler.get_jobs_for(A().m) == []
+        schedule.clear()
+
     def test_clear_by_tag(self):
