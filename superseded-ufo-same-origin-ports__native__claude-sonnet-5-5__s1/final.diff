diff --git a/test/same-origin.test.ts b/test/same-origin.test.ts
new file mode 100644
index 0000000..317b596
--- /dev/null
+++ b/test/same-origin.test.ts
@@ -0,0 +1,102 @@
+import { describe, expect, test } from "vitest";
+import { isSameOrigin } from "../src";
+
+// Proposed semantics (to be agreed before implementation):
+//  - Origin = protocol + hostname + port (WHATWG-style tuple origin).
+//  - Path, query, hash and userinfo are ignored.
+//  - Protocol and hostname are case-insensitive.
+//  - Default ports (:80 http/ws, :443 https/wss) equal an omitted port, so
+//    `https://example.com` and `https://example.com:443` are the same origin.
+//  - Inputs without an absolute origin (relative, protocol-relative, empty)
+//    never match, even against each other.
+//  - Opaque origins (data:, blob:, javascript:, ...) never match.
+
+describe("isSameOrigin", () => {
+  const sameOrigin = [
+    // Identical
+    ["https://example.com", "https://example.com"],
+    // Path, query, hash are ignored
+    ["https://example.com", "https://example.com/"],
+    ["https://example.com/a", "https://example.com/b"],
+    ["https://example.com/?a=1", "https://example.com/#hash"],
+    // Userinfo is ignored
+    ["https://user:pass@example.com", "https://example.com"],
+    // Case-insensitive protocol and host
+    ["HTTPS://EXAMPLE.COM", "https://example.com"],
+    ["https://Example.com/Path", "https://example.com/other"],
+    // Identical explicit ports match (including default ports, written the same way)
+    ["https://example.com:443/a", "https://example.com:443/b"],
+    // Default ports are equivalent to an omitted port
+    ["https://example.com", "https://example.com:443"],
+    ["http://example.com", "http://example.com:80"],
+    ["wss://example.com", "wss://example.com:443"],
+    ["http://localhost:3000/a", "http://localhost:3000/b"],
+    // IPv4 / IPv6
+    ["http://127.0.0.1:8080", "http://127.0.0.1:8080/x"],
+    ["http://[::1]:8080", "http://[::1]:8080/x"],
+  ];
+
+  const differentOrigin = [
+    // Different protocol
+    ["http://example.com", "https://example.com"],
+    // Different host
+    ["https://example.com", "https://example.org"],
+    // Subdomains are different origins
+    ["https://example.com", "https://www.example.com"],
+    ["https://a.example.com", "https://b.example.com"],
+    // Different port
+    ["http://localhost:3000", "http://localhost:4000"],
+    ["https://example.com:8443", "https://example.com"],
+    // A default port of another protocol is not a default port
+    ["http://example.com:443", "http://example.com"],
+    ["https://example.com:80", "https://example.com"],
+    // Userinfo trick must not confuse host parsing
+    ["https://example.com@evil.com", "https://example.com"],
+    ["https://example.com", "https://example.com.evil.com"],
+  ];
+
+  const noOrigin = [
+    // Relative / path-only inputs have no origin
+    ["/foo", "/foo"],
+    ["./foo", "./foo"],
+    ["foo", "foo"],
+    ["", ""],
+    ["/foo", "https://example.com/foo"],
+    // Protocol-relative has no protocol, so no full origin
+    ["//example.com", "//example.com"],
+    ["//example.com", "https://example.com"],
+    // Opaque origins never match, not even themselves
+    ["data:text/plain,hi", "data:text/plain,hi"],
+    ["blob:https://example.com/uuid", "blob:https://example.com/uuid"],
+    ["javascript:alert(1)", "javascript:alert(1)"],
+  ];
+
+  for (const [a, b] of sameOrigin) {
+    test(`"${a}" == "${b}"`, () => {
+      expect(isSameOrigin(a, b)).toBe(true);
+      // Symmetric
+      expect(isSameOrigin(b, a)).toBe(true);
+    });
+  }
+
+  for (const [a, b] of differentOrigin) {
+    test(`"${a}" != "${b}"`, () => {
+      expect(isSameOrigin(a, b)).toBe(false);
+      expect(isSameOrigin(b, a)).toBe(false);
+    });
+  }
+
+  for (const [a, b] of noOrigin) {
+    test(`"${a}" has no comparable origin vs "${b}"`, () => {
+      expect(isSameOrigin(a, b)).toBe(false);
+      expect(isSameOrigin(b, a)).toBe(false);
+    });
+  }
+
+  test("handles undefined/nullish inputs as no origin", () => {
+    // @ts-expect-error invalid input
+    expect(isSameOrigin(undefined, "https://example.com")).toBe(false);
+    // @ts-expect-error invalid input
+    expect(isSameOrigin("https://example.com", undefined)).toBe(false);
+  });
+});
