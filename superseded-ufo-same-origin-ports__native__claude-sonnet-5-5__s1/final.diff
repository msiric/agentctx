@@ -773,3 +792,54 @@ export function withoutHost(input: string) {
   const parsed = parseURL(input);
   return (parsed.pathname || "/") + parsed.search + parsed.hash;
 }
+
+const ORIGIN_RE = /^([a-z][\d+.a-z-]*):\/\/([^#/?]*)/i;
+const DEFAULT_PORTS: Record<string, string> = {
+  "http:": "80",
+  "ws:": "80",
+  "https:": "443",
+  "wss:": "443",
+};
+
+function getOrigin(input: string): string | undefined {
+  if (typeof input !== "string") {
+    return undefined;
+  }
+  const match = input.trim().match(ORIGIN_RE);
+  if (!match) {
+    return undefined;
+  }
+  const protocol = match[1].toLowerCase() + ":";
+  // Drop userinfo
+  const authority = match[2].slice(match[2].lastIndexOf("@") + 1);
+  const hostMatch = authority.match(/^(\[[^\]]*\]|[^:]*)(?::(\d*))?$/);
+  if (!hostMatch || !hostMatch[1]) {
+    return undefined;
+  }
+  let port = hostMatch[2] || "";
+  if (port === DEFAULT_PORTS[protocol]) {
+    port = "";
+  }
+  return `${protocol}//${hostMatch[1].toLowerCase()}${port ? ":" + port : ""}`;
+}
+
+/**
+ * Checks if two URLs share the same origin (protocol, hostname and port).
+ *
+ * Path, query, hash and userinfo are ignored. Default ports (`:80` for
+ * http/ws, `:443` for https/wss) are equivalent to an omitted port. Inputs
+ * without an absolute origin (relative, protocol-relative, `data:`, `blob:`...)
+ * never match.
+ *
+ * @example
+ * ```js
+ * isSameOrigin("https://example.com/a", "https://example.com:443/b")
+ * // Returns true
+ * ```
+ *
+ * @group utils
+ */
+export function isSameOrigin(a: string, b: string): boolean {
+  const originA = getOrigin(a);
+  return originA !== undefined && originA === getOrigin(b);
+}
