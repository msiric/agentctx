@@ -83,6 +83,52 @@ def cmd_nextver(args: argparse.Namespace) -> str:
     return str(version.next_version(args.part))
 
 
+def _read_versions(args: argparse.Namespace) -> List[str]:
+    """Return versions from the arguments, or from stdin if there are none."""
+    if args.versions:
+        return list(args.versions)
+    return [line.strip() for line in sys.stdin if line.strip()]
+
+
+def cmd_sort(args: argparse.Namespace) -> Optional[str]:
+    """
+    Subcommand: Sort versions, oldest first.
+
+    Synopsis: sort [<VERSION>...]
+
+    If no versions are given, they are read from stdin, one per line
+    (blank lines are ignored).
+
+    :param args: The parsed arguments
+    :return: the sorted versions, one per line (None if there is nothing to sort)
+    """
+    raw = _read_versions(args)
+    if not raw:
+        return None
+    versions = sorted(Version.parse(v) for v in raw)
+    return "\n".join(str(v) for v in versions)
+
+
+def cmd_latest(args: argparse.Namespace) -> str:
+    """
+    Subcommand: Print the highest version that is not a prerelease.
+
+    Synopsis: latest [<VERSION>...]
+
+    If no versions are given, they are read from stdin, one per line
+    (blank lines are ignored).
+
+    :param args: The parsed arguments
+    :return: the highest non-prerelease version
+    :raises ValueError: if there is no non-prerelease version
+    """
+    versions = [Version.parse(v) for v in _read_versions(args)]
+    stable = [v for v in versions if not v.prerelease]
+    if not stable:
+        raise ValueError("no version without a prerelease found")
+    return str(max(stable))
+
+
