+def test_sort_prints_one_version_per_line_oldest_first(capsys):
+    rc = main(["sort", "1.10.0", "1.2.0", "1.2.0-rc.1", "0.9.9"])
+    assert rc == 0
+    assert capsys.readouterr().out == "0.9.9\n1.2.0-rc.1\n1.2.0\n1.10.0\n"
+
+
+def test_sort_single_version(capsys):
+    assert main(["sort", "1.2.3"]) == 0
+    assert capsys.readouterr().out == "1.2.3\n"
+
+
+def test_cmd_sort_returns_newline_joined_string():
+    assert cmd_sort(Namespace(versions=["2.0.0", "1.0.0"])) == "1.0.0\n2.0.0"
+
+
+def test_sort_invalid_version_prints_nothing_on_stdout(capsys):
+    rc = main(["sort", "1.0.0", "1.2"])
+    captured = capsys.readouterr()
+    assert rc == 2
+    assert captured.out == ""
+    assert captured.err.startswith("ERROR")
+
+
+def test_sort_reads_stdin_when_no_arguments(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO("1.10.0\n\n  1.2.0 \n0.9.9\n\n"))
+    assert main(["sort"]) == 0
+    assert capsys.readouterr().out == "0.9.9\n1.2.0\n1.10.0\n"
+
+
+def test_sort_stdin_invalid_version_is_an_error(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO("1.0.0\nnope\n"))
