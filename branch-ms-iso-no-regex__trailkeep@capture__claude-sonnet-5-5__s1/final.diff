   const isPlural = msAbs >= n * 1.5;
   return `${Math.round(ms / n)} ${name}${isPlural ? 's' : ''}` as StringValue;
 }
+
+/**
+ * Format the given milliseconds as an ISO 8601 duration, e.g. `PT1H30M`.
+ *
+ * Days are the largest unit used, since months and years are ambiguous.
+ * Sub-millisecond precision is rounded away, and negative values get a
+ * leading `-`.
+ *
+ * @param ms - milliseconds
+ * @returns The ISO 8601 duration string
+ * @throws Error if `ms` is not a finite number
+ */
+export function formatISO(ms: number): string {
+  if (typeof ms !== 'number' || !Number.isFinite(ms)) {
+    throw new Error('Value provided to ms.formatISO() must be of type number.');
+  }
+
+  const total = Math.round(Math.abs(ms));
+  if (total === 0) {
+    return 'PT0S';
+  }
+
+  const days = Math.floor(total / d);
+  const hours = Math.floor((total % d) / h);
+  const minutes = Math.floor((total % h) / m);
+  const secs = Math.floor((total % m) / s);
+  const millis = total % s;
+
+  let seconds = secs ? `${secs}` : '';
+  if (millis) {
+    let frac = String(millis).padStart(3, '0');
+    while (frac.endsWith('0')) {
+      frac = frac.slice(0, -1);
+    }
+    seconds = `${secs}.${frac}`;
+  }
+
+  const time =
+    (hours ? `${hours}H` : '') +
+    (minutes ? `${minutes}M` : '') +
+    (seconds ? `${seconds}S` : '');
+
+  return `${ms < 0 ? '-' : ''}P${days ? `${days}D` : ''}${time ? `T${time}` : ''}`;
+}
+
+/**
+ * Parse an ISO 8601 duration, e.g. `PT1H30M`, and return milliseconds. This
+ * is the inverse of `formatISO`.
+ *
+ * Supports weeks, days, hours, minutes and seconds (with an optional decimal
+ * fraction), and a leading `-` for negative durations. Years and months are
+ * ambiguous and not supported.
+ *
+ * @param str - An ISO 8601 duration string
+ * @returns The parsed value in milliseconds, or `NaN` if the string can't be
+ * parsed
+ * @throws Error if `str` is not a string with length between 1 and 99
+ */
+export function parseISO(str: string): number {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw new Error(
+      `Value provided to ms.parseISO() must be a string with length between 1 and 99. value=${JSON.stringify(str)}`,
+    );
+  }
+
+  let i = 0;
+  let sign = 1;
+  if (str[i] === '-') {
+    sign = -1;
+    i++;
+  }
+  if (str[i] !== 'P') {
+    return NaN;
+  }
+  i++;
+
+  let total = 0;
+  let inTime = false;
+  let count = 0;
+  // Index into the designator order for the current section, to enforce
+  // ordering and prevent duplicates.
+  let lastRank = -1;
+  const dateUnits: Record<string, [number, number]> = {
+    W: [0, w],
+    D: [1, d],
+  };
+  const timeUnits: Record<string, [number, number]> = {
+    H: [0, h],
+    M: [1, m],
+    S: [2, s],
+  };
+
+  while (i < str.length) {
+    if (str[i] === 'T') {
+      if (inTime) {
+        return NaN;
+      }
+      inTime = true;
+      lastRank = -1;
+      i++;
+      // A trailing `T` with nothing after it is invalid.
+      if (i >= str.length) {
+        return NaN;
+      }
+      continue;
+    }
+
+    // Scan a number: digits with an optional single `.` or `,` fraction.
+    const start = i;
+    let digits = 0;
+    let sepAt = -1;
+    while (i < str.length) {
+      const c = str.charCodeAt(i);
+      if (c >= 48 && c <= 57) {
+        digits++;
+      } else if ((str[i] === '.' || str[i] === ',') && sepAt === -1) {
+        sepAt = i;
+      } else {
+        break;
+      }
+      i++;
+    }
+    // Require digits both before and after the separator, if present.
+    if (
+      digits === 0 ||
+      (sepAt !== -1 && (sepAt === start || sepAt === i - 1))
+    ) {
+      return NaN;
+    }
+    const n = parseFloat(str.slice(start, i).replace(',', '.'));
+
+    const unit = (inTime ? timeUnits : dateUnits)[str[i] ?? ''];
+    if (!unit || unit[0] <= lastRank) {
+      return NaN;
+    }
+    lastRank = unit[0];
+    total += n * unit[1];
+    count++;
+    i++;
+  }
+
+  if (count === 0) {
+    return NaN;
+  }
+  return sign * Math.round(total);
+}
diff --git a/src/parse-iso.test.ts b/src/parse-iso.test.ts
new file mode 100644
index 0000000..bf9e9cd
--- /dev/null
+++ b/src/parse-iso.test.ts
@@ -0,0 +1,68 @@
+import { describe, expect, it } from '@jest/globals';
+import { formatISO, parseISO } from './index';
+
+describe('parseISO(string)', () => {
+  it('should parse hours and minutes', () => {
+    expect(parseISO('PT1H30M')).toBe(5400000);
+  });
+
+  it('should parse days, weeks and combinations', () => {
+    expect(parseISO('P1D')).toBe(86400000);
+    expect(parseISO('P2W')).toBe(86400000 * 14);
+    expect(parseISO('P1DT1H1M1S')).toBe(90061000);
+  });
+
+  it('should parse zero', () => {
+    expect(parseISO('PT0S')).toBe(0);
+  });
+
+  it('should parse fractional seconds', () => {
+    expect(parseISO('PT1.5S')).toBe(1500);
+    expect(parseISO('PT0,25S')).toBe(250);
+    expect(parseISO('PT1.001S')).toBe(1001);
+  });
+
+  it('should parse negative durations', () => {
+    expect(parseISO('-PT1H30M')).toBe(-5400000);
+  });
+
+  it('should be the inverse of formatISO', () => {
+    for (const v of [0, 1, 999, 1000, 61001, 5400000, 90061001, -5400000]) {
+      expect(parseISO(formatISO(v))).toBe(v);
+    }
+  });
+
+  it('should return NaN for invalid input', () => {
+    for (const v of [
+      'P',
+      'PT',
+      'P1DT',
+      'PT1H30',
+      '1H',
+      'T1H',
+      'PT1M1H',
+      'PT1H1H',
+      'P1D1D',
+      'PTH',
+      'PT.5S',
+      'PT5.S',
+      'PT1.2.3S',
+      'P1Y',
+      'P1M',
+      'PT1X',
+      'PT1HT1M',
+      'P1H',
+      'pt1h',
+      '--PT1H',
+    ]) {
+      expect(parseISO(v)).toBeNaN();
+    }
+  });
+
+  it('should throw for non-strings and bad lengths', () => {
+    expect(() => parseISO('')).toThrow();
+    expect(() => parseISO('P'.repeat(101))).toThrow();
+    // @ts-expect-error testing runtime behavior
+    expect(() => parseISO(5)).toThrow();
+  });
+});
