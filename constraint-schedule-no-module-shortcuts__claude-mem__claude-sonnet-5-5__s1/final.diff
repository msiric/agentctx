+    def get_jobs_for(self, func: Callable) -> List["Job"]:
+        """
+        Gets scheduled jobs that run the given function, regardless of
+        the arguments they were scheduled with.
+
+        :param func: The function that was passed to :meth:`Job.do`
+        """
+        return [
+            job
+            for job in self.jobs
+            if job.job_func is not None and job.job_func.func == func
+        ]
+
+    def pause(self, tag: Hashable) -> None:
+        """
+        Pause all jobs marked with the given tag. Paused jobs are skipped by
+        :meth:`run_pending` until :meth:`resume` is called with the same tag.
+        This also applies to jobs given the tag after pausing.
+
+        Paused jobs stay scheduled and their ``next_run`` is not moved, so a
+        job whose run time passed while paused runs once on the first
+        :meth:`run_pending` after resuming. :meth:`run_all` ignores pauses.
+
+        :param tag: An identifier used to identify a subset of jobs to pause
+        """
+        logger.debug('Pausing all jobs tagged "%s"', tag)
+        self._paused_tags.add(tag)
+
+    def resume(self, tag: Hashable) -> None:
+        """
+        Resume jobs paused with :meth:`pause`. Does nothing if the tag
+        is not paused.
+
+        :param tag: An identifier used to identify a subset of jobs to resume
+        """
+        logger.debug('Resuming all jobs tagged "%s"', tag)
+        self._paused_tags.discard(tag)
+
+    def _is_paused(self, job: "Job") -> bool:
+        return not self._paused_tags.isdisjoint(job.tags)
+
