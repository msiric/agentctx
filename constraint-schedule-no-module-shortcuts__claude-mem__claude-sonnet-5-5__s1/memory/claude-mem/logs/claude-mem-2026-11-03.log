b=s.index("    def test_get_jobs_for_scheduler_instance")
new='''    def test_get_jobs_for(self):
        def foo():
            pass

        def bar():
            pass

        class Greeter:
            def hello(self):
                pass

        g = Greeter()
        s = schedule.Scheduler()
        j1 = s.every().second.do(foo)
        j2 = s.every().minute.do(foo)
        j3 = s.every().second.do(bar, 1, x=2)
        j4 = s.every().second.do(g.hello)

        assert s.get_jobs_for(foo) == [j1, j2]
        assert s.get_jobs_for(bar) == [j3]
        assert s.get_jobs_for(g.hello) == [j4]
        assert s.get_jobs_for(lambda: None) == []

        # Returned list is a copy; cancelling through it works
        for job in s.get_jobs_for(foo):
            s.cancel_job(job)
        assert s.get_jobs_for(foo) == []
        assert s.get_jobs() == [j3, j4]

'''
s=s[:a]+new+s[b:]
