        def bar():
            pass

        class Greeter:
            def hello(self):
                pass

        g = Greeter()
        j1 = every().second.do(foo)
        j2 = every().minute.do(foo)
        j3 = every().second.do(bar, 1, x=2)
        j4 = every().second.do(g.hello)

        assert schedule.get_jobs_for(foo) == [j1, j2]
        assert schedule.get_jobs_for(bar) == [j3]
        assert schedule.get_jobs_for(g.hello) == [j4]
        assert schedule.get_jobs_for(lambda: None) == []

        # Returned list is a copy; cancelling through it works
        for job in schedule.get_jobs_for(foo):
            schedule.cancel_job(job)
        assert schedule.get_jobs_for(foo) == []
        assert schedule.get_jobs() == [j3, j4]

    def test_get_jobs_for_scheduler_instance(self):
        def foo():
            pass

        s1, s2 = schedule.Scheduler(), schedule.Scheduler()
        j = s1.every().second.do(foo)
        assert s1.get_jobs_for(foo) == [j]
        assert s2.get_jobs_for(foo) == []

    def test_clear_by_tag(self):''',1)
