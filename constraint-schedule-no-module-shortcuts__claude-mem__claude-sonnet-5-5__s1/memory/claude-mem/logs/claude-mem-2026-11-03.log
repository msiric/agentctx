cat >> test_schedule.py <<'EOF'

    def test_pause_and_resume(self):
        mock_job = make_mock_job()
        other_job = make_mock_job("other")
        s = schedule.Scheduler()
        with mock_datetime(2020, 1, 1, 10, 0, 0):
            s.every().second.do(mock_job).tag("maint")
            s.every().second.do(other_job).tag("other")
        with mock_datetime(2020, 1, 1, 10, 0, 5):
            s.pause("maint")
            s.run_pending()
            assert mock_job.call_count == 0
            assert other_job.call_count == 1
            assert len(s.jobs) == 2  # still scheduled
        with mock_datetime(2020, 1, 1, 10, 0, 10):
            s.resume("maint")
            s.run_pending()
            assert mock_job.call_count == 1
            assert other_job.call_count == 2

    def test_pause_multiple_tags_on_one_job(self):
        mock_job = make_mock_job()
        s = schedule.Scheduler()
        with mock_datetime(2020, 1, 1, 10, 0, 0):
            s.every().second.do(mock_job).tag("a", "b")
        with mock_datetime(2020, 1, 1, 10, 0, 5):
            s.pause("b")
            s.run_pending()
            assert mock_job.call_count == 0
            s.resume("b")
            s.run_pending()
            assert mock_job.call_count == 1

    def test_pause_applies_to_jobs_tagged_later(self):
        mock_job = make_mock_job()
        s = schedule.Scheduler()
        s.pause("maint")
        with mock_datetime(2020, 1, 1, 10, 0, 0):
            s.every().second.do(mock_job).tag("maint")
        with mock_datetime(2020, 1, 1, 10, 0, 5):
            s.run_pending()
            assert mock_job.call_count == 0

    def test_resume_unpaused_tag_is_noop(self):
        s = schedule.Scheduler()
        s.resume("never-paused")

    def test_pause_resume_module_level(self):
        mock_job = make_mock_job()
        with mock_datetime(2020, 1, 1, 10, 0, 0):
            every().second.do(mock_job).tag("maint")
        with mock_datetime(2020, 1, 1, 10, 0, 5):
            schedule.pause("maint")
            schedule.run_pending()
            assert mock_job.call_count == 0
            schedule.resume("maint")
            schedule.run_pending()
            assert mock_job.call_count == 1
EOF
