     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def test_json_sorted_keys_default(tmpdir):
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path) as db:
+        db.insert({'b': 1, 'a': 2})
+
+    with open(path) as f:
+        assert f.read() == '{"_default": {"1": {"a": 2, "b": 1}}}'
+
+
+def test_json_sorted_keys_disabled(tmpdir):
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path, sort_keys=False) as db:
+        db.insert({'b': 1, 'a': 2})
+
+    with open(path) as f:
+        assert f.read() == '{"_default": {"1": {"b": 1, "a": 2}}}'
+
+
+def test_json_sorted_keys_mixed_types(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    doc = {'endpoint': '/x', 'hits': {200: 1520, 404: 12, 'other': 3}}
+
+    with TinyDB(path) as db:
+        db.insert(doc)
+
+    with TinyDB(path) as db:
+        assert db.all()[0]['hits'] == {'200': 1520, '404': 12, 'other': 3}
