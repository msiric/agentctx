+    def test_to_dict_with_nested_lists(self):
+        prop = self.dict_class(a=[[{'b': 1}], ({'c': 2},)])
+        regular = prop.to_dict()
+        self.assertIs(type(regular['a'][0][0]), dict)
+        self.assertIs(type(regular['a'][1][0]), dict)
+        self.assertIsInstance(regular['a'][1], tuple)
+        self.assertEqual(regular, {'a': [[{'b': 1}], ({'c': 2},)]})
+
+    def test_flatten(self):
+        d = self.dict_class(a=1, b={'c': 2, 'd': {'e': [1, {'f': 3}]}})
+        flat = d.flatten()
+        self.assertIs(type(flat), dict)
+        self.assertEqual(flat, {'a': 1, 'b__c': 2, 'b__d__e': [1, {'f': 3}]})
+
+    def test_flatten_custom_sep_and_empty(self):
+        d = self.dict_class(a={'b': {'c': 1}})
+        self.assertEqual(d.flatten(sep='.'), {'a.b.c': 1})
+        self.assertEqual(self.dict_class().flatten(), {})
+
     def test_update(self):
