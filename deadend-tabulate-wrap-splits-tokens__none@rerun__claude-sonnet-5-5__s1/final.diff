diff --git a/test/test_cli.py b/test/test_cli.py
index 154f1a2..bc45161 100644
--- a/test/test_cli.py
+++ b/test/test_cli.py
@@ -483,3 +483,20 @@ def test_inprocess_jsonl_malformed_headers():
     )
     # output should still be produced (graceful fallback), with raw keys as headers
     assert out.strip() != ""
+
+
+def test_cli_wrap():
+    "CLI: --wrap WIDTH wraps long cell text"
+    out = run_main_in_process(["--wrap", "5", "-s", ","], "name,hello world foo\n")
+    expected = "\n".join(["----  -----", "name  hello", "      world", "      foo", "----  -----"])
+    assert_equal(expected, out.rstrip("\n"))
+
+
+def test_cli_wrap_invalid():
+    "CLI: --wrap rejects non-positive / non-integer values"
+    import pytest
+
+    for bad in ["0", "-3", "abc"]:
+        with pytest.raises(SystemExit) as e:
+            run_main_in_process(["--wrap", bad], "a b\n")
+        assert e.value.code == 2
