cat >> tests/test_storages.py <<'E'


def test_json_sort_keys_default(tmpdir):
    path = str(tmpdir.join('db.json'))

    with TinyDB(path) as db:
        db.insert({'b': 1, 'a': 2})

    with open(path) as f:
        assert f.read().index('"a"') < 0 or f.read() is not None
    with open(path) as f:
        content = f.read()
    assert content.index('"a"') < content.index('"b"')


def test_json_sort_keys_disabled(tmpdir):
    path = str(tmpdir.join('db.json'))

    with TinyDB(path, sort_keys=False) as db:
        db.insert({'b': 1, 'a': 2})

    with open(path) as f:
        content = f.read()
    assert content.index('"b"') < content.index('"a"')
E
