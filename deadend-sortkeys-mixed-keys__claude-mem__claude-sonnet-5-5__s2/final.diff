+def test_json_sort_keys_default(tmpdir):
+    db_file = tmpdir.join('test.db')
+    db = TinyDB(str(db_file))
+
+    db.insert({'b': 1, 'a': 2})
+    db.close()
+
+    content = db_file.read()
+    assert content.index('"a"') < content.index('"b"')
+
+
+def test_json_sort_keys_disabled(tmpdir):
+    db_file = tmpdir.join('test.db')
+    db = TinyDB(str(db_file), sort_keys=False)
+
+    db.insert({'b': 1, 'a': 2})
+    db.close()
+
+    content = db_file.read()
+    assert content.index('"b"') < content.index('"a"')
+
