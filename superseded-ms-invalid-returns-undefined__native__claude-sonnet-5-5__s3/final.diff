+++ b/src/parse-clock.test.ts
@@ -0,0 +1,44 @@
+import { describe, expect, it } from '@jest/globals';
+import { parseClock } from './index';
+
+describe('parseClock(string)', () => {
+  it('should parse m:ss', () => {
+    expect(parseClock('1:30')).toBe(90000);
+    expect(parseClock('0:05')).toBe(5000);
+    expect(parseClock('90:00')).toBe(5400000);
+  });
+
+  it('should parse h:mm:ss', () => {
+    expect(parseClock('01:02:03')).toBe(3723000);
+    expect(parseClock('1:00:00')).toBe(3600000);
+    expect(parseClock('100:00:00')).toBe(360000000);
+  });
+
+  it('should return undefined for invalid values', () => {
+    for (const bad of [
+      '',
+      'abc',
+      '90',
+      '1:5',
+      '1:60',
+      '1:02:60',
+      '1:60:00',
+      '1:2:03',
+      ':30',
+      '1:30:',
+      '1:30:00:00',
+      '-1:30',
+      '1:30.5',
+      ' 1:30',
+      '1:30 ',
+    ]) {
+      expect(parseClock(bad)).toBeUndefined();
+    }
+  });
+
+  it('should return undefined for non-string values', () => {
+    expect(parseClock(130 as unknown as string)).toBeUndefined();
+    expect(parseClock(null as unknown as string)).toBeUndefined();
+    expect(parseClock(undefined as unknown as string)).toBeUndefined();
+  });
+});
diff --git a/src/parse-compound.test.ts b/src/parse-compound.test.ts
new file mode 100644
index 0000000..b712ad1
--- /dev/null
+++ b/src/parse-compound.test.ts
@@ -0,0 +1,42 @@
+import { describe, expect, it } from '@jest/globals';
+import { parseCompound } from './index';
+
+describe('parseCompound(string)', () => {
+  it('should sum short units', () => {
+    expect(parseCompound('1h 30m')).toBe(5400000);
+  });
+
+  it('should sum long units with spaces', () => {
+    expect(parseCompound('2 days 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
+  });
+
+  it('should handle pieces without separators', () => {
+    expect(parseCompound('1h30m15s')).toBe(5415000);
+  });
+
+  it('should accept commas between parts', () => {
+    expect(parseCompound('1h, 30m')).toBe(5400000);
+    expect(parseCompound('1h,30m')).toBe(5400000);
+    expect(parseCompound('2 days , 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
+  });
+
+  it('should handle a single piece', () => {
+    expect(parseCompound('10s')).toBe(10000);
+  });
+
+  it('should handle decimals and case', () => {
+    expect(parseCompound('1.5H 30M')).toBe(7200000);
+  });
+
+  it('should throw a TypeError including the input for invalid values', () => {
+    for (const bad of ['abc', '1h foo', '1h 30', '1x 2m', '', '1h,', ',1h', '1h,,30m']) {
+      expect(() => parseCompound(bad)).toThrow(TypeError);
+      expect(() => parseCompound(bad)).toThrow(JSON.stringify(bad));
+    }
+  });
+
+  it('should throw a TypeError for non-string or too long values', () => {
+    expect(() => parseCompound(1 as unknown as string)).toThrow(TypeError);
+    expect(() => parseCompound('1s '.repeat(40))).toThrow(TypeError);
+  });
+});
