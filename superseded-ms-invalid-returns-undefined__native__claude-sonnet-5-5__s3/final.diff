+/**
+ * Parse a compound duration such as `"1h 30m"` or `"2 days 4 hours"` and
+ * return the total in milliseconds. Each piece is a number followed by a unit
+ * and is parsed with `parse`.
+ *
+ * @param str - A string of one or more `<number><unit>` pieces
+ * @returns The summed value in milliseconds
+ * @throws TypeError if `str` is not a valid compound duration
+ */
+export function parseCompound(str: string): number {
+  const invalid = () =>
+    new TypeError(
+      `Value provided to ms.parseCompound() must be a string of one or more "<number><unit>" pieces, with length between 1 and 99. value=${JSON.stringify(str)}`,
+    );
+  if (typeof str !== "string" || str.length === 0 || str.length > 100) {
+    throw invalid();
+  }
+  const piece = "-?\\d*\\.?\\d+ *[a-z]+";
+  if (
+    !new RegExp(`^\\s*${piece}(?:(?:\\s*,\\s*|\\s*)${piece})*\\s*$`, "i").test(
+      str,
+    )
+  ) {
+    throw invalid();
+  }
+  const pieces = str.match(/-?\d*\.?\d+ *[a-z]+/gi) as string[];
+  const total = pieces.reduce((sum, piece) => sum + parse(piece), 0);
+  if (Number.isNaN(total)) {
+    throw invalid();
+  }
+  return total;
+}
+
+/**
+ * Parse a timer-style clock string and return the total in milliseconds.
+ * `"m:ss"` (e.g. `"1:30"`) and `"h:mm:ss"` (e.g. `"01:02:03"`) are supported.
+ * Seconds, and minutes in the `h:mm:ss` form, must be two digits from 00 to 59.
+ *
+ * @param str - A clock string
+ * @returns The value in milliseconds, or `undefined` if `str` is not a valid clock string
+ */
+export function parseClock(str: string): number | undefined {
+  if (typeof str !== "string") {
+    return undefined;
+  }
+  const match = /^(?:(\d+):([0-5]\d)|(\d+):([0-5]\d):([0-5]\d))$/.exec(str);
+  if (!match) {
+    return undefined;
+  }
+  if (match[1] !== undefined) {
+    return Number(match[1]) * m + Number(match[2]) * s;
+  }
+  return Number(match[3]) * h + Number(match[4]) * m + Number(match[5]) * s;
 }
