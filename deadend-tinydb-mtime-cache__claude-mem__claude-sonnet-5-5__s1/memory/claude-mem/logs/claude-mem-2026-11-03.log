cat >> tests/test_storages.py <<'EOF'


def test_json_read_cache(tmpdir, monkeypatch):
    path = str(tmpdir.join('db.json'))
    with open(path, 'w') as f:
        f.write('{"_default": {"1": {"a": 1}}}')
    old = os.stat(path).st_mtime_ns - 10_000_000_000
    os.utime(path, ns=(old, old))

    storage = JSONStorage(path, cache_reads=True)
    calls = []
    real_load = json.load
    monkeypatch.setattr(json, 'load', lambda f: calls.append(1) or real_load(f))

    assert storage.read() == {'_default': {'1': {'a': 1}}}
    assert storage.read() == {'_default': {'1': {'a': 1}}}
    assert len(calls) == 1  # second read served from cache

    # Another process rewrites the file in place, same size, same mtime
    with open(path, 'r+') as f:
        f.write('{"_default": {"1": {"a": 2}}}')
    os.utime(path, ns=(old, old))
    assert storage.read() == {'_default': {'1': {'a': 2}}}  # ctime changed
    storage.close()


def test_json_read_cache_skips_fresh_files(tmpdir):
    path = str(tmpdir.join('db.json'))
    storage = JSONStorage(path, cache_reads=True)
    storage.write({'_default': {'1': {'a': 1}}})
    storage.read()
    assert storage._cache is None  # just modified, not cached
    storage.close()
EOF
