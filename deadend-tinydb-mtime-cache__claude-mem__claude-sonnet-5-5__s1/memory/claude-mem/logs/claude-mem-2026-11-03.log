"""Benchmark TinyDB read performance on a large JSON db.

Usage: python scripts/bench_read.py [--size-mb 40] [--profile]
"""
import argparse
import cProfile
import os
import pstats
import random
import tempfile
import time

from tinydb import TinyDB, where


def generate(path, size_mb):
    rng = random.Random(0)
    docs = []
    # ~200 bytes per doc
    n = size_mb * 1024 * 1024 // 200
    for i in range(n):
        docs.append({
            'id': i,
            'name': f'user{i}',
            'group': rng.randrange(1000),
            'tags': ['a', 'b', 'c'],
            'note': 'x' * 100,
        })
    db = TinyDB(path)
    db.insert_multiple(docs)
    db.close()
    return n


def timeit(label, fn, repeat=3):
    times = []
    for _ in range(repeat):
        t = time.perf_counter()
        fn()
        times.append(time.perf_counter() - t)
    print(f'{label:<28} best {min(times)*1000:8.1f} ms   '
          f'all {[round(x*1000, 1) for x in times]}')


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--size-mb', type=int, default=40)
    ap.add_argument('--profile', action='store_true')
    args = ap.parse_args()

    with tempfile.TemporaryDirectory() as d:
        path = os.path.join(d, 'db.json')
        t = time.perf_counter()
        n = generate(path, args.size_mb)
        print(f'generated {n} docs, {os.path.getsize(path)/1e6:.1f} MB '
              f'in {time.perf_counter()-t:.1f}s')

        db = TinyDB(path)
        timeit('db.all()', db.all)
        # distinct queries so the query cache never hits
        counter = iter(range(10**6))
        timeit('db.search(group == k)',
               lambda: db.search(where('group') == next(counter) % 1000))
        timeit('db.count(group == 5)', lambda: db.count(where('group') == 5))

        if args.profile:
            pr = cProfile.Profile()
            pr.enable()
            db.search(where('group') == 1001 - 1)
            pr.disable()
            pstats.Stats(pr).sort_stats('cumulative').print_stats(12)
        db.close()


if __name__ == '__main__':
    main()
EOF
