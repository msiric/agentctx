diff --git a/src/parse-clock.test.ts b/src/parse-clock.test.ts
new file mode 100644
index 0000000..a27e791
--- /dev/null
+++ b/src/parse-clock.test.ts
@@ -0,0 +1,61 @@
+import { describe, expect, it } from "@jest/globals";
+import { parseClock } from "./index";
+
+describe("parseClock(string)", () => {
+  it("should parse m:ss", () => {
+    expect(parseClock("1:30")).toBe(90000);
+    expect(parseClock("0:05")).toBe(5000);
+    expect(parseClock("00:00")).toBe(0);
+  });
+
+  it("should allow minutes above 59 in m:ss", () => {
+    expect(parseClock("90:00")).toBe(5400000);
+  });
+
+  it("should parse h:mm:ss", () => {
+    expect(parseClock("01:02:03")).toBe(3723000);
+    expect(parseClock("1:02:03")).toBe(3723000);
+    expect(parseClock("100:00:00")).toBe(360000000);
+  });
+
+  it("should tolerate surrounding whitespace", () => {
+    expect(parseClock(" 1:30 ")).toBe(90000);
+  });
+
+  it("should return undefined for out-of-range fields", () => {
+    expect(parseClock("1:60")).toBeUndefined();
+    expect(parseClock("1:60:00")).toBeUndefined();
+    expect(parseClock("1:00:60")).toBeUndefined();
+  });
+
+  it("should return undefined for malformed input", () => {
+    for (const v of [
+      "",
+      ":",
+      "1",
+      "1:5",
+      "1:2:03",
+      "1:02:3",
+      "1:30:",
+      ":30",
+      "-1:30",
+      "1.5:30",
+      "1:30.5",
+      "1:02:03:04",
+      "abc",
+      "1h:30",
+    ]) {
+      expect(parseClock(v)).toBeUndefined();
+    }
+  });
+
+  it("should return undefined for non-strings instead of throwing", () => {
+    expect(parseClock(undefined as any)).toBeUndefined();
+    expect(parseClock(null as any)).toBeUndefined();
+    expect(parseClock(130 as any)).toBeUndefined();
+  });
+
+  it("should never return NaN", () => {
+    expect(parseClock("9".repeat(400) + ":00")).toBeUndefined();
+  });
+});
diff --git a/src/parse-compound.test.ts b/src/parse-compound.test.ts
new file mode 100644
index 0000000..c8119e7
--- /dev/null
+++ b/src/parse-compound.test.ts
@@ -0,0 +1,74 @@
+import { describe, expect, it } from '@jest/globals';
+import { parseCompound } from './index';
+
+describe('parseCompound(string)', () => {
+  it('should parse compact pieces', () => {
+    expect(parseCompound('1h 30m')).toBe(5400000);
+  });
+
+  it('should parse long-form pieces with spaces', () => {
+    expect(parseCompound('2 days 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
+  });
+
+  it('should parse a single piece', () => {
+    expect(parseCompound('1m')).toBe(60000);
+  });
+
+  it('should parse pieces without separators', () => {
+    expect(parseCompound('1h30m')).toBe(5400000);
+  });
+
+  it('should be case insensitive and tolerate surrounding whitespace', () => {
+    expect(parseCompound('  1H 30M ')).toBe(5400000);
+  });
+
+  it('should support decimals and ms', () => {
+    expect(parseCompound('1.5s 500ms')).toBe(2000);
+  });
+
+  it('should support negative pieces', () => {
+    expect(parseCompound('1h -30m')).toBe(1800000);
+  });
+
+  it('should accept commas between pieces', () => {
+    expect(parseCompound('1h, 30m')).toBe(5400000);
+    expect(parseCompound('1h,30m')).toBe(5400000);
+    expect(parseCompound('2 days , 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
+  });
+
+  it('should throw a TypeError for misplaced commas', () => {
+    expect(() => parseCompound(',1h')).toThrow(TypeError);
+    expect(() => parseCompound('1h,')).toThrow(TypeError);
+    expect(() => parseCompound('1h,,30m')).toThrow(TypeError);
+    expect(() => parseCompound(',')).toThrow(TypeError);
+  });
+
+  it('should throw a TypeError for a piece without a unit', () => {
+    expect(() => parseCompound('1h 30')).toThrow(TypeError);
+  });
+
+  it('should throw a TypeError for unknown units', () => {
+    expect(() => parseCompound('1h foo')).toThrow(TypeError);
+    expect(() => parseCompound('1h 30foo')).toThrow(TypeError);
+  });
+
+  it('should throw a TypeError for stray text', () => {
+    expect(() => parseCompound('1h and 30m')).toThrow(TypeError);
+    expect(() => parseCompound('abc')).toThrow(TypeError);
+  });
+
+  it('should throw a TypeError including the input for empty strings', () => {
+    expect(() => parseCompound('')).toThrow(TypeError);
+    expect(() => parseCompound('   ')).toThrow(TypeError);
+    expect(() => parseCompound('')).toThrow('value=""');
+  });
+
+  it('should include the input in the error message', () => {
+    expect(() => parseCompound('1h foo')).toThrow('value="1h foo"');
+  });
+
+  it('should throw a TypeError for non-strings', () => {
+    // @ts-expect-error testing runtime behavior
+    expect(() => parseCompound(100)).toThrow(TypeError);
+  });
+});
