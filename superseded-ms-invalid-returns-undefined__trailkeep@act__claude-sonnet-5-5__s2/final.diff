+/**
+ * Parse a compound duration such as `"1h 30m"`, `"1h, 30m"` or `"2 days 4 hours"` and
+ * return the total in milliseconds. Each piece must have a unit and is parsed
+ * with {@link parse}.
+ *
+ * @param str - A string of one or more `<number><unit>` pieces
+ * @returns The total in milliseconds
+ * @throws TypeError if `str` is not a string made up entirely of valid
+ * `<number><unit>` pieces. Never returns `NaN`.
+ */
+export function parseCompound(str: string): number {
+  const fail = () =>
+    new TypeError(
+      `Value provided to ms.parseCompound() must be a string of <number><unit> pieces like "1h 30m". value=${JSON.stringify(str)}`,
+    );
+  if (typeof str !== "string") {
+    throw fail();
+  }
+  const piece = /-?\d*\.?\d+ *[a-z]+/gi;
+  // Pieces may be separated by whitespace, a comma, or nothing at all.
+  const whole = /^\s*-?\d*\.?\d+ *[a-z]+(?:\s*,?\s*-?\d*\.?\d+ *[a-z]+)*\s*$/i;
+  const pieces = whole.test(str) ? str.match(piece) : null;
+  if (!pieces) {
+    throw fail();
+  }
+  const total = pieces.reduce((sum, p) => sum + parse(p), 0);
+  if (Number.isNaN(total)) {
+    throw fail();
+  }
+  return total;
+}
+
+/**
+ * Parse a timer-style clock string and return the total in milliseconds.
+ * Accepts `m:ss` (e.g. `"1:30"`) and `h:mm:ss` (e.g. `"01:02:03"`). Seconds
+ * (and minutes in `h:mm:ss`) must be two digits and below 60; the leading
+ * field may have any number of digits.
+ *
+ * @param str - A clock string
+ * @returns The total in milliseconds, or `undefined` if the input is invalid.
+ * Never throws and never returns `NaN`.
+ */
+export function parseClock(str: string): number | undefined {
+  if (typeof str !== "string") {
+    return undefined;
+  }
+  const match = /^(?:(\d+):([0-5]\d)|(\d+):([0-5]\d):([0-5]\d))$/.exec(
+    str.trim(),
+  );
+  if (!match) {
+    return undefined;
+  }
+  const [h, m, s] =
+    match[3] !== undefined
+      ? [match[3], match[4], match[5]]
+      : ["0", match[1], match[2]];
+  const total = ((Number(h) * 60 + Number(m)) * 60 + Number(s)) * 1000;
+  return Number.isSafeInteger(total) ? total : undefined;
+}
