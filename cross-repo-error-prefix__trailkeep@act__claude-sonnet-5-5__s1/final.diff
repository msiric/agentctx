 ```
 
+## API
+
+### parseMilliseconds(milliseconds, options?)
+
+#### options
+
+Type: `object`
+
+##### largestUnit
+
+Type: `'days' | 'hours' | 'minutes' | 'seconds'`\
+Default: `'days'`
+
+The largest unit to include. Bigger units roll into it, so `{largestUnit: 'hours'}` gives `hours: 26` instead of `days: 1, hours: 2`. Any other value throws a `TypeError`.
+
 ## Related
 
 - [to-milliseconds](https://github.com/sindresorhus/to-milliseconds) - The inverse of this module
diff --git a/test.js b/test.js
index 6314aab..bd00b7e 100644
--- a/test.js
+++ b/test.js
@@ -292,3 +292,48 @@ test('keep the sub-day parts exact at any magnitude', () => {
 		assert.strictEqual(parsed.hours, Number(bigint.hours), `${milliseconds}ms hours against the bigint path`);
 	}
 });
+
+test('largestUnit', () => {
+	const milliseconds = 93_784_005; // 1d 2h 3m 4s 5ms
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit: 'days'}), parseMilliseconds(milliseconds));
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit: 'hours'}), {
+		days: 0, hours: 26, minutes: 3, seconds: 4, milliseconds: 5, microseconds: 0, nanoseconds: 0,
+	});
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit: 'minutes'}), {
+		days: 0, hours: 0, minutes: 1563, seconds: 4, milliseconds: 5, microseconds: 0, nanoseconds: 0,
+	});
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit: 'seconds'}), {
+		days: 0, hours: 0, minutes: 0, seconds: 93_784, milliseconds: 5, microseconds: 0, nanoseconds: 0,
+	});
+	assert.deepStrictEqual(parseMilliseconds(-milliseconds, {largestUnit: 'hours'}), {
+		days: 0, hours: -26, minutes: -3, seconds: -4, milliseconds: -5, microseconds: -0, nanoseconds: -0,
+	});
+	assert.equal(parseMilliseconds(1.5, {largestUnit: 'seconds'}).microseconds, 500);
+});
+
+test('largestUnit with bigint', () => {
+	const milliseconds = 93_784_005n;
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit: 'hours'}), {
+		days: 0n, hours: 26n, minutes: 3n, seconds: 4n, milliseconds: 5n, microseconds: 0n, nanoseconds: 0n,
+	});
+	assert.equal(parseMilliseconds(milliseconds, {largestUnit: 'minutes'}).minutes, 1563n);
+	assert.equal(parseMilliseconds(milliseconds, {largestUnit: 'seconds'}).seconds, 93_784n);
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit: 'days'}), parseMilliseconds(milliseconds));
+	assert.equal(parseMilliseconds(10n ** 20n, {largestUnit: 'seconds'}).seconds, 10n ** 17n);
+});
+
+test('largestUnit keeps large values exact', () => {
+	assert.equal(parseMilliseconds(Number.MAX_SAFE_INTEGER, {largestUnit: 'hours'}).minutes, Number(BigInt(Number.MAX_SAFE_INTEGER) / 60_000n % 60n));
+});
+
+test('largestUnit invalid', () => {
+	for (const largestUnit of ['weeks', 'Days', '', 1, null, {}]) {
+		assert.throws(() => {
+			parseMilliseconds(1000, {largestUnit});
+		}, {name: 'TypeError', message: /^parse-ms: /v});
+
+		assert.throws(() => {
+			parseMilliseconds(1000n, {largestUnit});
+		}, TypeError);
+	}
+});
