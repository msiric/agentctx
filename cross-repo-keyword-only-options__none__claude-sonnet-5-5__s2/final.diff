+    def test_to_dict_skip_none(self):
+        nested = {'a': None, 'b': {'c': None, 'd': 1},
+                  'e': [{'f': None, 'g': 2}, None],
+                  'h': ({'i': None},)}
+        prop = self.dict_class(nested)
+        self.assertEqual(prop.to_dict(skip_none=True),
+                         {'b': {'d': 1}, 'e': [{'g': 2}, None],
+                          'h': ({},)})
+        self.assertIsInstance(prop.to_dict(skip_none=True)['h'], tuple)
+
+    def test_to_dict_skip_none_default_off(self):
+        nested = {'a': None, 'b': {'c': None}, 'e': [{'f': None}]}
+        prop = self.dict_class(nested)
+        self.assertEqual(prop.to_dict(), nested)
+        self.assertEqual(prop.to_dict(skip_none=False), nested)
+
     def test_update(self):
