cat >> test.js <<'EOF'

test('maxUnit option', t => {
	t.is(prettyBytes(2e12, {maxUnit: 'GB'}), '2000 GB');
	t.is(prettyBytes(2e12, {maxUnit: 'TB'}), '2 TB');
	t.is(prettyBytes(2e12, {maxUnit: 'YB'}), '2 TB');
	t.is(prettyBytes(2e12, {maxUnit: 'B'}), '2000000000000 B');
	t.is(prettyBytes(2e12, {maxUnit: undefined}), '2 TB');
	t.is(prettyBytes(2n * 10n ** 12n, {maxUnit: 'GB'}), '2000 GB');
	t.is(prettyBytes(-2e12, {maxUnit: 'GB'}), '-2000 GB');
	t.is(prettyBytes(2 * 1024 ** 4, {binary: true, maxUnit: 'GiB'}), '2048 GiB');
	t.is(prettyBytes(2e9, {bits: true, maxUnit: 'Mbit'}), '2000 Mbit');
	t.is(prettyBytes(2 * 1024 ** 3, {bits: true, binary: true, maxUnit: 'Mibit'}), '2048 Mibit');
	t.is(prettyBytes(2e12, {maxUnit: 'GB', maximumFractionDigits: 1, locale: 'en'}), '2,000 GB');
	// Rounding up across the boundary must not escape the cap.
	t.is(prettyBytes(999_999_999, {maxUnit: 'MB'}), '1000 MB');
	t.is(prettyBytes(999_999_999n, {maxUnit: 'MB'}), '1000 MB');
	t.is(prettyBytes(1e30, {maxUnit: 'kB'}), '1000000000000000000000000000 kB');
});

test('maxUnit must belong to the selected unit system', t => {
	for (const options of [
		{maxUnit: 'GiB'},
		{maxUnit: 'gb'},
		{maxUnit: 'Gbit'},
		{maxUnit: ''},
		{maxUnit: 5},
		{maxUnit: null},
		{binary: true, maxUnit: 'GB'},
		{bits: true, maxUnit: 'GB'},
		{bits: true, binary: true, maxUnit: 'Gbit'},
	]) {
		t.throws(() => prettyBytes(1, options), {instanceOf: TypeError}, JSON.stringify(options));
	}
});
EOF
