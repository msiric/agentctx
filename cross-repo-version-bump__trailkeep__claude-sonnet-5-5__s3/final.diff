diff --git a/test/count.js b/test/count.js
new file mode 100644
index 0000000..f100ca3
--- /dev/null
+++ b/test/count.js
@@ -0,0 +1,31 @@
+const test = require('tape');
+const fn = require('../lib');
+
+test('count :: short group', t => {
+	t.deepEqual(fn(['-vvv'], { count: 'v' }), { v: 3, _: [] });
+	t.deepEqual(fn(['-v'], { count: ['v'] }), { v: 1, _: [] });
+	t.end();
+});
+
+test('count :: long repeated', t => {
+	t.deepEqual(fn(['--verbose', '--verbose'], { count: 'verbose' }), { verbose: 2, _: [] });
+	t.end();
+});
+
+test('count :: mixed forms and aliases', t => {
+	const opts = { count: 'v', alias: { v: 'verbose' } };
+	t.deepEqual(fn(['-vv', '--verbose', '-v'], opts), { v: 4, verbose: 4, _: [] });
+	t.deepEqual(fn(['--verbose'], { count: 'verbose', alias: { v: 'verbose' } }), { verbose: 1, v: 1, _: [] });
+	t.end();
+});
+
+test('count :: does not consume values', t => {
+	t.deepEqual(fn(['-v', 'foo', '-v'], { count: 'v' }), { v: 2, _: ['foo'] });
+	t.end();
+});
+
+test('count :: other flags unaffected; default', t => {
+	t.deepEqual(fn(['-vx', '--name=a'], { count: 'v' }), { v: 1, x: true, name: 'a', _: [] });
+	t.deepEqual(fn([], { count: 'v', default: { v: 0 } }), { v: 0, _: [] });
+	t.end();
+});
