@@ -197,3 +197,53 @@ def test_persist_empty_does_not_wipe_existing_data(tmpdir):
     assert len(table) == 1
     assert table.all() == [{'a': 1}]
     db.close()
+
+
+def _read_csv_raw(path):
+    with open(path, 'rb') as f:
+        return f.read()
+
+
+def test_to_csv_default_fields(db, tmp_path):
+    db.truncate()
+    db.insert({'a': 1, 'b': 'x'})
+    db.insert({'b': 'y', 'c': 3})
+
+    out = tmp_path / 'out.csv'
+    db.to_csv(out)
+
+    raw = _read_csv_raw(out)
+    assert raw.startswith(b'\xef\xbb\xbf')
+    text = raw.decode('utf-8-sig')
+    assert text.splitlines() == ['a;b;c', '1;x;', ';y;3']
+
+
+def test_to_csv_fields_select_and_order(db, tmp_path):
+    db.truncate()
+    db.insert({'a': 1, 'b': 2, 'c': 3})
+
+    out = tmp_path / 'out.csv'
+    db.to_csv(out, fields=['c', 'a', 'missing'])
+
+    text = _read_csv_raw(out).decode('utf-8-sig')
+    assert text.splitlines() == ['c;a;missing', '3;1;']
+
+
+def test_to_csv_umlauts_and_delimiter(db, tmp_path):
+    db.truncate()
+    db.insert({'name': 'Müller; GmbH'})
+
+    out = tmp_path / 'out.csv'
+    db.to_csv(out)
+
+    text = _read_csv_raw(out).decode('utf-8-sig')
+    assert text.splitlines() == ['name', '"Müller; GmbH"']
+
+
+def test_to_csv_empty_table(db, tmp_path):
+    db.truncate()
+
+    out = tmp_path / 'out.csv'
+    db.to_csv(out, fields=['a', 'b'])
+
+    assert _read_csv_raw(out).decode('utf-8-sig').splitlines() == ['a;b']
