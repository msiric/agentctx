     db.close()
+
+
+def test_to_csv_default_fields(db, tmp_path):
+    db.truncate()
+    db.insert({'a': 1, 'b': 'x'})
+    db.insert({'c': 'Müller', 'a': 2})
+    path = tmp_path / 'out.csv'
+
+    assert db.to_csv(path) == 2
+
+    raw = path.read_bytes()
+    assert raw.startswith(b'\xef\xbb\xbf')
+    text = raw.decode('utf-8-sig')
+    assert text.splitlines() == ['a;b;c', '1;x;', '2;;Müller']
+
+
+def test_to_csv_fields(db, tmp_path):
+    db.truncate()
+    db.insert({'a': 1, 'b': 2, 'c': 3})
+    db.insert({'a': 4})
+    path = tmp_path / 'out.csv'
+
+    db.to_csv(path, fields=['c', 'a'])
+
+    text = path.read_bytes().decode('utf-8-sig')
+    assert text.splitlines() == ['c;a', '3;1', ';4']
+
+
+def test_to_csv_empty_table(db, tmp_path):
+    db.truncate()
+    path = tmp_path / 'out.csv'
+
+    assert db.to_csv(path) == 0
+    assert path.read_bytes().decode('utf-8-sig') == '\r\n'
