--- a/test.js
+++ b/test.js
@@ -1284,3 +1284,31 @@ try {
 		await removeTemporaryScript(temporaryFile);
 	}
 });
+
+test('the context carries the time elapsed since pRetry was called', async () => {
+	const elapsed = {shouldConsumeRetry: [], onFailedAttempt: [], shouldRetry: []};
+	const record = name => ({elapsedTime}) => {
+		elapsed[name].push(elapsedTime);
+		return true;
+	};
+
+	await assert.rejects(pRetry(async () => {
+		throw new Error('fail');
+	}, {
+		retries: 2,
+		minTimeout: 50,
+		factor: 1,
+		shouldConsumeRetry: record('shouldConsumeRetry'),
+		onFailedAttempt: record('onFailedAttempt'),
+		shouldRetry: record('shouldRetry'),
+	}), {message: 'fail'});
+
+	for (const values of Object.values(elapsed)) {
+		assert.equal(values.length, values === elapsed.shouldRetry ? 2 : 3);
+		assert.ok(values.every(value => typeof value === 'number' && value >= 0));
+		assert.ok(values[0] < 50, `first failure is reported before any delay, got ${values[0]}`);
+		// Each retry waited about 50ms, with a little slack for timer rounding.
+		assert.ok(values[1] >= 45, `second failure came after one delay, got ${values[1]}`);
+		assert.ok(values.every((value, index) => index === 0 || value > values[index - 1]));
+	}
+});
