+test('onRetry runs only when another attempt follows', {timeout: 60_000}, async t => {
+	await withFakeTime(t);
+	const order = [];
+	const contexts = [];
+
+	await assert.rejects(pRetry(async () => {
+		order.push('run');
+		throw new Error('fail');
+	}, {
+		retries: 2,
+		onFailedAttempt() {
+			order.push('onFailedAttempt');
+		},
+		async onRetry(context) {
+			await delay(1);
+			order.push('onRetry');
+			contexts.push(context);
+		},
+	}), {message: 'fail'});
+
+	assert.deepEqual(order, [
+		'run',
+		'onFailedAttempt',
+		'onRetry',
+		'run',
+		'onFailedAttempt',
+		'onRetry',
+		'run',
+		'onFailedAttempt',
+	]);
+	assert.deepEqual(contexts.map(({attemptNumber, retriesLeft, retryDelay}) => ({attemptNumber, retriesLeft, retryDelay})), [
+		{attemptNumber: 1, retriesLeft: 2, retryDelay: 1000},
+		{attemptNumber: 2, retriesLeft: 1, retryDelay: 2000},
+	]);
+	assert.ok(Object.isFrozen(contexts[0]));
+});
+
+test('onRetry is not called when no retry follows', async () => {
+	let calls = 0;
+	const onRetry = () => {
+		calls++;
+	};
+
+	await assert.rejects(pRetry(async () => {
+		throw new Error('fail');
+	}, {retries: 0, onRetry}), {message: 'fail'});
+
+	await assert.rejects(pRetry(async () => {
+		throw new Error('fail');
+	}, {onRetry, shouldRetry: () => false}), {message: 'fail'});
+
+	await assert.rejects(pRetry(async () => {
+		throw new AbortError('stop');
+	}, {onRetry}), {message: 'stop'});
+
+	await assert.rejects(pRetry(async () => {
+		throw new TypeError('nope');
+	}, {onRetry}), {message: 'nope'});
+
+	assert.equal(calls, 0);
+});
+
+test('onRetry is called for a retry that does not consume the budget', async () => {
+	const delays = [];
+	let attempts = 0;
+
+	await pRetry(async () => {
+		if (++attempts < 3) {
+			throw new Error('fail');
+		}
+	}, {
+		retries: 1,
+		shouldConsumeRetry: () => false,
+		maxRetryTime: 60_000,
+		onRetry({retryDelay}) {
+			delays.push(retryDelay);
+		},
+	});
+
+	assert.deepEqual(delays, [0, 0]);
+});
+
+test('onRetry can throw to abort retries', async () => {
+	const error = new Error('from onRetry');
+	let attempts = 0;
+
+	await assert.rejects(pRetry(async () => {
+		attempts++;
+		throw new Error('fail');
+	}, {
+		onRetry() {
+			throw error;
+		},
+	}), rejectsWith(error));
+
+	assert.equal(attempts, 1);
+});
+
