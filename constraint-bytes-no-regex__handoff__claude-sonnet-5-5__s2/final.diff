--- a/index.js
+++ b/index.js
@@ -147,6 +147,13 @@ function parse(val) {
     return null;
   }
 
+  // IEC units (KiB, MiB, ...) share values with their KB, MB, ... counterparts.
+  // Normalize with plain string handling (no regex) by dropping the "i".
+  var len = val.length;
+  if (len > 3 && val.charAt(len - 1).toLowerCase() === 'b' && val.charAt(len - 2).toLowerCase() === 'i' && 'kmgtp'.indexOf(val.charAt(len - 3).toLowerCase()) !== -1) {
+    val = val.slice(0, len - 2) + val.charAt(len - 1);
+  }
+
   // Test if the string passed is valid
   var results = parseRegExp.exec(val);
   var floatValue;
diff --git a/test/byte-parse.js b/test/byte-parse.js
index cebfab2..15f61aa 100644
--- a/test/byte-parse.js
+++ b/test/byte-parse.js
@@ -108,4 +108,46 @@ describe('Test byte parse function', function(){
   it('Should allow whitespace', function(){
     assert.equal(bytes.parse('1 TB'), 1 * Math.pow(1024, 4));
   });
+
+  it('Should parse IEC units like their SI-named counterparts', function(){
+    assert.equal(bytes.parse('1KiB'), 1 * Math.pow(1024, 1));
+    assert.equal(bytes.parse('1MiB'), 1 * Math.pow(1024, 2));
+    assert.equal(bytes.parse('1GiB'), 1 * Math.pow(1024, 3));
+    assert.equal(bytes.parse('1TiB'), 1 * Math.pow(1024, 4));
+    assert.equal(bytes.parse('1PiB'), 1 * Math.pow(1024, 5));
+  });
+
+  it('Should parse IEC units case-insensitively', function(){
+    assert.equal(bytes.parse('1kib'), 1024);
+    assert.equal(bytes.parse('1KIB'), 1024);
+    assert.equal(bytes.parse('2 mIb'), 2 * Math.pow(1024, 2));
+    assert.equal(bytes.parse('1.5 GiB'), 1.5 * Math.pow(1024, 3));
+    assert.equal(bytes.parse('-1KiB'), -1024);
+  });
+
+  it('Should not treat malformed IEC units as valid', function(){
+    assert.strictEqual(bytes.parse('KiB'), null);
+    assert.strictEqual(bytes.parse('1xiB'), 1);
+    assert.strictEqual(bytes.parse('abcKiB'), null);
+  });
+
+  it('Should reject long junk strings quickly', function(){
+    var inputs = [
+      'x'.repeat(100000),
+      ' '.repeat(100000) + '!',
+      '.'.repeat(100000),
+      '-'.repeat(100000) + '1kb!',
+      'kb'.repeat(50000)
+    ];
+
+    inputs.forEach(function (input) {
+      var start = process.hrtime();
+      var result = bytes.parse(input);
+      var elapsed = process.hrtime(start);
+      var ms = elapsed[0] * 1e3 + elapsed[1] / 1e6;
+
+      assert.strictEqual(result, null);
+      assert.ok(ms < 100, 'parse took ' + ms.toFixed(1) + 'ms');
+    });
+  });
 });
