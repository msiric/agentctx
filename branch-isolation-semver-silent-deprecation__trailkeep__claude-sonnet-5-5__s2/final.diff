diff --git a/tests/test_cli_v_prefix.py b/tests/test_cli_v_prefix.py
new file mode 100644
index 0000000..2db7472
--- /dev/null
+++ b/tests/test_cli_v_prefix.py
@@ -0,0 +1,30 @@
+import pytest
+
+from semver.cli import main
+
+
+@pytest.mark.parametrize("prefix", ["v", "V", ""])
+@pytest.mark.parametrize(
+    "argv,expected",
+    [
+        (["bump", "major", "{v}1.2.3"], "2.0.0"),
+        (["bump", "minor", "{v}1.2.3"], "1.3.0"),
+        (["bump", "patch", "{v}1.2.3"], "1.2.4"),
+        (["bump", "prerelease", "{v}1.2.3-rc.1"], "1.2.3-rc.2"),
+        (["bump", "build", "{v}1.2.3+build.1"], "1.2.3+build.2"),
+        (["compare", "{v}1.2.3", "{v}2.0.0"], "-1"),
+        (["compare", "{v}2.0.0", "1.2.3"], "1"),
+        (["compare", "{v}1.2.3", "{v}1.2.3"], "0"),
+        (["nextver", "{v}1.2.3", "minor"], "1.3.0"),
+        (["check", "{v}1.2.3"], ""),
+    ],
+)
+def test_v_prefix_accepted(capsys, prefix, argv, expected):
+    argv = [a.format(v=prefix) for a in argv]
+    assert main(argv) == 0
+    assert capsys.readouterr().out.strip() == expected
+
+
+@pytest.mark.parametrize("arg", ["vv1.2.3", "v", "V", "x1.2.3"])
+def test_only_single_v_prefix_stripped(capsys, arg):
+    assert main(["check", arg]) == 2
