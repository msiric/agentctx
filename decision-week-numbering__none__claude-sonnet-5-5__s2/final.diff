@@ -28,6 +28,24 @@ test('rendering', t => {
 	t.is(render('{fff}'), '000', 'returns milliseconds (default 000)');
 	t.is(render('{fff}', new Date(1559607289771)), '771', 'returns milliseconds');
 
+	t.is(render('{DDD}'), '121', 'returns day of year (padded to 3)');
+	t.is(render('{DDD}', new Date(2017, 0, 1)), '001', 'Jan 1 is day 001');
+	t.is(render('{DDD}', new Date(2017, 11, 31)), '365', 'Dec 31 is day 365 (non-leap)');
+	t.is(render('{DDD}', new Date(2016, 11, 31)), '366', 'Dec 31 is day 366 (leap year)');
+	t.is(render('{DDD}', new Date(2016, 1, 29)), '060', 'Feb 29 is day 060 (leap year)');
+	t.is(render('{DDD}', new Date(2017, 2, 1)), '060', 'Mar 1 is day 060 (non-leap)');
+	t.is(render('{DDD}', new Date(2017, 2, 12, 23, 59)), '071', 'ignores time of day');
+	t.is(render('{DDD}', new Date(2017, 10, 5)), '309', 'day after DST end (US, Nov 5) is correct');
+	t.is(render('{DDD}', new Date(2017, 2, 12)), '071', 'DST start day (US, Mar 12) is correct');
+
+	t.is(render('{WW}'), '18', 'returns ISO week number (May 1, 2017)');
+	t.is(render('{WW}', new Date(2017, 0, 1)), '52', 'Jan 1 2017 (Sun) belongs to last week of 2016');
+	t.is(render('{WW}', new Date(2017, 0, 2)), '01', 'Jan 2 2017 (Mon) starts week 01');
+	t.is(render('{WW}', new Date(2015, 11, 31)), '53', 'Dec 31 2015 is week 53');
+	t.is(render('{WW}', new Date(2018, 11, 31)), '01', 'Dec 31 2018 belongs to week 01 of 2019');
+	t.is(render('{WW}', new Date(2020, 0, 1)), '01', 'Jan 1 2020 is week 01');
+	t.is(render('{WW}', new Date(2017, 2, 12)), '10', 'DST start day is correct');
+
 	// formats
 	t.is(render('[{HH}:{mm}:{ss}]'), '[16:30:09]', 'returns formatted time string');
 	t.is(render('The date is {MM}/{DD}/{YYYY}!'), 'The date is 05/01/2017!', 'returns formatted date string');
