 	number: number | bigint,
 	options?: Options
 ): string;
+
+/**
+Parse a size string into a number of bytes. The reverse of `prettyBytes(number, {binary: true})`.
+
+Accepts a plain number or a number followed by one of `B`, `KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`, `ZiB`, `YiB`, optionally separated by whitespace. The units without the `i` (`kB` or `KB`, `MB`, `GB`, `TB`, `PB`, `EB`, `ZB`, `YB`) are also accepted and are powers of 1024, not 1000, so `'1 kB'` is `1024`. Fractional values are allowed. Units are case-sensitive.
+
+@param string - The size to parse, for example `'1.5 KiB'`.
+@returns The number of bytes.
+@throws A `TypeError` if the input is not a string, and a `SyntaxError` if it cannot be parsed.
+
+@example
+```
+import {parseBytes} from 'pretty-bytes';
+
+parseBytes('512');
+//=> 512
+
+parseBytes('1.5 KiB');
+//=> 1536
+```
+*/
+export function parseBytes(string: string): number;
diff --git a/index.js b/index.js
index c5f37ab..21830c2 100644
--- a/index.js
+++ b/index.js
@@ -285,3 +285,24 @@ export default function prettyBytes(number, options) {
 	const result = prefix + numberString + separator + UNITS[exponent];
 	return result.padStart(options.fixedWidth ?? 0);
 }
+
+// The units without the `i` (`kB`, `KB`, `MB`, …) are read as powers of 1024, like Windows Explorer shows them.
+const PARSE_PATTERN = /^(\d+(?:\.\d+)?|\.\d+)[ \u00A0\u202F]*(B|[kK]B|[MGTPEZY]B|[KMGTPEZY]iB)?$/;
+
+export function parseBytes(string) {
+	if (typeof string !== 'string') {
+		throw new TypeError(`Expected a string, got \`${typeof string}\``);
+	}
+
+	const match = PARSE_PATTERN.exec(string.trim());
+
+	if (match === null) {
+		throw new SyntaxError(`Unable to parse \`${string}\` as a number of bytes`);
+	}
+
+	const [, digits, unit = 'B'] = match;
+	const prefix = unit === 'B' ? '' : unit[0].toUpperCase();
+
+	// Every factor is a power of 2, so the multiplication only shifts the exponent and adds no rounding error.
+	return Number(digits) * (1024 ** BIBYTE_UNITS.indexOf(prefix === '' ? 'B' : `${prefix}iB`));
+}
