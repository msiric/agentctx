diff --git a/test/dashdash.js b/test/dashdash.js
new file mode 100644
index 0000000..f3ce340
--- /dev/null
+++ b/test/dashdash.js
@@ -0,0 +1,27 @@
+const test = require('tape');
+const fn = require('../lib');
+
+test('-- (opts["--"] = true)', t => {
+	const argv = fn(['a', '-x', '1', '--', 'b', '-y', '--z=3'], { '--': true });
+	t.same(argv, { _: ['a'], x: 1, '--': ['b', '-y', '--z=3'] });
+	t.end();
+});
+
+test('-- (opts["--"] = true, no bare --)', t => {
+	const argv = fn(['a', '-x'], { '--': true });
+	t.same(argv, { _: ['a'], x: true, '--': [] });
+	t.end();
+});
+
+test('-- (opts["--"] unset)', t => {
+	const argv = fn(['a', '--', 'b', '-y']);
+	t.same(argv, { _: ['a', 'b', '-y'] });
+	t.false('--' in argv);
+	t.end();
+});
+
+test('-- (with alias)', t => {
+	const argv = fn(['-f', '1', '--', 'x'], { '--': true, alias: { f: 'foo' } });
+	t.same(argv, { _: [], f: 1, foo: 1, '--': ['x'] });
+	t.end();
+});
