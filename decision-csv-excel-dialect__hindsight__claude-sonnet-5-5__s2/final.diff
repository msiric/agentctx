+#!/usr/bin/env python3
+"""Export the ``invoices`` table of a TinyDB JSON file to CSV.
+
+The output is formatted for Excel with a German locale: fields are separated
+by semicolons and the file starts with a UTF-8 BOM so umlauts display correctly.
+
+Usage: export_invoices.py DB_PATH OUT_CSV
+"""
+import csv
+import sys
+from pathlib import Path
+
+from tinydb import TinyDB
+
+COLUMNS = ["number", "customer", "amount", "due_date"]
+
+
+def export_invoices(db_path, out_path):
+    if not Path(db_path).is_file():
+        raise FileNotFoundError(f"database not found: {db_path}")
+
+    # Read-only so we never modify the source database.
+    with TinyDB(db_path, access_mode="r") as db:
+        invoices = db.table("invoices").all()
+
+    with open(out_path, "w", newline="", encoding="utf-8-sig") as f:
+        writer = csv.DictWriter(f, fieldnames=COLUMNS, delimiter=";",
+                                extrasaction="ignore", restval="")
+        writer.writeheader()
+        writer.writerows(invoices)
+    return len(invoices)
+
+
+def main(argv):
+    if len(argv) != 3:
+        print(__doc__.strip(), file=sys.stderr)
+        return 2
+    try:
+        count = export_invoices(argv[1], argv[2])
+    except (OSError, ValueError) as e:
+        print(f"error: {e}", file=sys.stderr)
+        return 1
+    print(f"Wrote {count} invoice(s) to {argv[2]}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
