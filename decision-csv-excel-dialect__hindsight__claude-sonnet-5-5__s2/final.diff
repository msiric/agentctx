     assert len(table) == 1
     assert table.all() == [{'a': 1}]
     db.close()
+
+
+def test_to_csv_default_fields(db, tmp_path):
+    db.truncate()
+    db.insert_multiple([{'a': 1, 'b': 'x'}, {'c': 3, 'a': 2}])
+    path = tmp_path / 'out.csv'
+
+    assert db.to_csv(path) == 2
+    assert path.read_text(encoding='utf-8').splitlines() == [
+        'a,b,c', '1,x,', '2,,3'
+    ]
+
+
+def test_to_csv_selected_fields(db, tmp_path):
+    db.truncate()
+    db.insert({'a': 1, 'b': 'x', 'c': 3})
+    path = tmp_path / 'out.csv'
+
+    db.to_csv(path, fields=['c', 'a', 'missing'])
+    assert path.read_text(encoding='utf-8').splitlines() == [
+        'c,a,missing', '3,1,'
+    ]
+
+
+def test_to_csv_empty_table(db, tmp_path):
+    db.truncate()
+    path = tmp_path / 'out.csv'
+
+    assert db.to_csv(path) == 0
+    assert path.read_text(encoding='utf-8').strip() == ''
+    db.to_csv(path, fields=['a'])
+    assert path.read_text(encoding='utf-8').splitlines() == ['a']
+
+
+def test_to_csv_quoting_and_unicode(db, tmp_path):
+    db.truncate()
+    db.insert({'name': 'Müller, "Hans"', 'note': 'a\nb'})
+    path = tmp_path / 'out.csv'
+
+    db.to_csv(path)
+    import csv
+    with open(path, newline='', encoding='utf-8') as f:
+        assert list(csv.reader(f)) == [
+            ['name', 'note'], ['Müller, "Hans"', 'a\nb']
+        ]
