+  describe("respectQueryAndFragment", () => {
+    const respected = {
+      "/foo//bar?redirect=//baz": "/foo/bar?redirect=//baz",
+      "/foo//bar#//baz": "/foo/bar#//baz",
+      "//foo//bar//?a=//b#//c": "/foo/bar/?a=//b#//c",
+      "http://foo.com//bar?u=http://x.com//y":
+        "http://foo.com/bar?u=http://x.com//y",
+      "?a=//b": "?a=//b",
+      "/foo//bar": "/foo/bar",
+    };
+    for (const input in respected) {
+      test(input, () => {
+        expect(cleanDoubleSlashes(input, true)).toBe(respected[input]);
+      });
+    }
+
+    test("default still cleans query and fragment", () => {
+      expect(cleanDoubleSlashes("/foo//bar?redirect=//baz#//x")).toBe(
+        "/foo/bar?redirect=/baz#/x",
+      );
+      expect(cleanDoubleSlashes("/a//b?c=//d", false)).toBe("/a/b?c=/d");
+    });
+  });
+
   test("no input", () => {
     expect(cleanDoubleSlashes()).toBe("");
