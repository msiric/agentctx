 ```
 
+##### significantDigits
+
+Type: `number`\
+Default: `3`
+
+The number of significant digits to round to when neither `minimumFractionDigits` nor `maximumFractionDigits` is set.
+
+The integer part is never rounded away, so `prettyBytes(999, {significantDigits: 1})` is still `999 B`.
+
+Has no effect when `minimumFractionDigits` or `maximumFractionDigits` is set.
+
+Must be an integer between 1 and 100. Throws a `TypeError` for invalid values.
+
+```js
+import prettyBytes from 'pretty-bytes';
+
+prettyBytes(1337, {significantDigits: 2});
+//=> '1.3 kB'
+
+prettyBytes(1337, {significantDigits: 4});
+//=> '1.337 kB'
+```
+
 ##### minimumFractionDigits
 
 Type: `number`\
diff --git a/test.js b/test.js
index d305f51..03800e8 100644
--- a/test.js
+++ b/test.js
@@ -1182,3 +1182,36 @@ test('the options shape the output as documented', t => {
 		t.is(prettyBytes(value, {signed: true}), prefix + prettyBytes(Math.abs(value)));
 	}
 });
+
+test('significantDigits changes the default rounding', t => {
+	t.is(prettyBytes(1337, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 3}), prettyBytes(1337));
+	t.is(prettyBytes(1337, {significantDigits: 4}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 1}), '1 kB');
+	t.is(prettyBytes(1337, {significantDigits: 10}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 2, locale: 'de'}), '1,3 kB');
+	t.is(prettyBytes(1337n, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(-1337, {significantDigits: 2}), '-1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 2, unit: 'MB'}), '0.0013 MB');
+
+	// The integer part is never rounded away.
+	t.is(prettyBytes(999, {significantDigits: 1}), '999 B');
+	t.is(prettyBytes(123_456, {significantDigits: 2}), '123 kB');
+
+	// Rounding up onto a unit boundary still carries.
+	t.is(prettyBytes(999_999, {significantDigits: 2}), '1 MB');
+});
+
+test('significantDigits is ignored when fraction digits are set', t => {
+	t.is(prettyBytes(1337, {significantDigits: 2, maximumFractionDigits: 3}), '1.337 kB');
+	t.is(prettyBytes(1900, {significantDigits: 1, minimumFractionDigits: 2}), '1.90 kB');
+});
+
+test('significantDigits is validated', t => {
+	for (const value of [0, 101, 1.5, -1, Number.NaN, '3', null]) {
+		t.throws(() => prettyBytes(1337, {significantDigits: value}), {instanceOf: TypeError});
+	}
+
+	t.is(prettyBytes(1337, {significantDigits: undefined}), '1.34 kB');
+	t.is(prettyBytes(1337, {significantDigits: 100}), '1.337 kB');
+});
