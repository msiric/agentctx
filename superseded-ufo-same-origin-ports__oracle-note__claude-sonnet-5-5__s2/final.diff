+
+function getOrigin(input: string): string | undefined {
+  if (typeof input !== "string") {
+    return undefined;
+  }
+  try {
+    const { origin } = new URL(input);
+    return origin === "null" ? undefined : origin;
+  } catch {
+    return undefined;
+  }
+}
+
+/**
+ * Checks if two URLs have the same origin (protocol, host and port).
+ *
+ * Default ports are equivalent to omitted ones (`https://a.com` and `https://a.com:443`).
+ * Both inputs must be absolute URLs with a non-opaque origin, otherwise `false` is returned.
+ *
+ * @example
+ * ```js
+ * isSameOrigin("https://example.com/foo", "https://example.com/bar") // true
+ * isSameOrigin("https://example.com", "https://example.com:443") // true
+ * isSameOrigin("https://example.com", "http://example.com") // false
+ * isSameOrigin("/foo", "/foo") // false
+ * ```
+ *
+ * @group utils
+ */
+export function isSameOrigin(a: string, b: string): boolean {
+  const originA = getOrigin(a);
+  return originA !== undefined && originA === getOrigin(b);
+}
