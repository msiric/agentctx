+def _make_yaml_loader():
+    """
+    Build a ``SafeLoader`` subclass in which only ``true``/``false`` (any of
+    ``true``, ``True``, ``TRUE`` and the same for false) are booleans.
+
+    YAML 1.1 also treats ``yes``, ``no``, ``on``, ``off`` etc. as booleans,
+    which is surprising for hand-edited files, so those load as strings.
+    """
+
+    import re
+    import yaml
+
+    class _Loader(yaml.SafeLoader):
+        pass
+
+    # Copy the resolver table so we don't modify ``SafeLoader`` itself
+    _Loader.yaml_implicit_resolvers = {
+        ch: [(tag, regexp) for tag, regexp in resolvers
+             if tag != 'tag:yaml.org,2002:bool']
+        for ch, resolvers in yaml.SafeLoader.yaml_implicit_resolvers.items()
+    }
+    _Loader.add_implicit_resolver(
+        'tag:yaml.org,2002:bool',
+        re.compile(r'^(?:true|True|TRUE|false|False|FALSE)$'),
+        list('tTfF'),
+    )
+
+    return _Loader
+
+
+class YAMLStorage(FileStorage):
+    """
+    Store the data in a YAML file (requires PyYAML).
+
+    Only ``true`` and ``false`` are loaded as booleans; values such as
+    ``yes``, ``NO``, ``on`` or ``Off`` are loaded as strings.
+    """
+
+    def __init__(self, path: str, create_dirs=False, encoding=None, access_mode='r+', **kwargs):
+        """
+        Create a new instance.
+
+        See :class:`FileStorage` for the file handling arguments. Additional
+        ``kwargs`` are passed to ``yaml.safe_dump``.
+
+        :param path: Where to store the YAML data.
+        """
+
+        self._loader = _make_yaml_loader()
+
+        super().__init__(path, create_dirs=create_dirs, encoding=encoding, access_mode=access_mode)
+
+        self.kwargs = kwargs
+
+    def read(self) -> Optional[dict[str, dict[str, Any]]]:
+        import yaml
+
+        self._handle.seek(0)
+        data = yaml.load(self._handle, Loader=self._loader)
+
+        # Empty (or comment-only) file: let TinyDB initialize the database
+        return data if data else None
+
+    def write(self, data: dict[str, dict[str, Any]]):
+        import yaml
+
+        self._handle.seek(0)
+
+        serialized = yaml.safe_dump(data, **self.kwargs)
+
+        try:
+            self._handle.write(serialized)
+        except io.UnsupportedOperation:
+            raise IOError('Cannot write to the database. Access mode is "{0}"'.format(self._mode))
+
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+        self._handle.truncate()
+
+
