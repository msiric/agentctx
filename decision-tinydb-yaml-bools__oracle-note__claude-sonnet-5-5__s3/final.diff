+def test_yaml(tmpdir):
+    path = str(tmpdir.join('test.yaml'))
+    storage = YAMLStorage(path)
+    assert storage.read() is None
+    storage.write(doc)
+    assert doc == storage.read()
+    storage.close()
+
+
+def test_yaml_shrinking_write(tmpdir):
+    path = str(tmpdir.join('test.yaml'))
+    storage = YAMLStorage(path)
+    storage.write(doc)
+    storage.write({'a': 1})
+    assert storage.read() == {'a': 1}
+    storage.close()
+
+
+def test_yaml_hand_edited_booleans(tmpdir):
+    path = str(tmpdir.join('test.yaml'))
+    with open(path, 'w') as f:
+        f.write('_default:\n  1: {a: NO, b: yes, c: off, d: On, e: true,'
+                ' f: False, g: n, h: Y}\n')
+    storage = YAMLStorage(path)
+    row = storage.read()['_default'][1]
+    storage.close()
+    assert row == {'a': 'NO', 'b': 'yes', 'c': 'off', 'd': 'On',
+                   'e': True, 'f': False, 'g': 'n', 'h': 'Y'}
+
+
+def test_yaml_string_roundtrip(tmpdir):
+    path = str(tmpdir.join('test.yaml'))
+    data = {'_default': {'1': {'a': 'NO', 'b': 'on', 'c': True}}}
+    storage = YAMLStorage(path)
+    storage.write(data)
+    assert storage.read() == data
+    storage.close()
+
+
+def test_yaml_safeloader_untouched(tmpdir):
+    import yaml
+    YAMLStorage(str(tmpdir.join('t.yaml'))).close()
+    assert yaml.safe_load('a: yes') == {'a': True}
+
+
+def test_yaml_tinydb(tmpdir):
+    path = str(tmpdir.join('test.yaml'))
+    with TinyDB(path, storage=YAMLStorage) as db:
+        db.insert({'x': 'No', 'y': 1})
+    with TinyDB(path, storage=YAMLStorage) as db:
+        assert db.all() == [{'x': 'No', 'y': 1}]
