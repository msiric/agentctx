+
+/**
+ * Scale a numeric string by 10^shift by moving its decimal point, which
+ * avoids float errors such as 2.01 * 1000 = 2009.9999999999998. The result
+ * is floored (toward -Infinity), like the binary path.
+ *
+ * @param {string} sign
+ * @param {string} num
+ * @param {number} shift
+ * @returns {number}
+ * @private
+ */
+
+function parseDecimal(sign, num, shift) {
+  var parts = num.split('.');
+  var frac = parts[1] || '';
+  while (frac.length < shift) {
+    frac += '0';
+  }
+
+  var whole = Number(parts[0] + frac.slice(0, shift));
+  var hasRemainder = /[1-9]/.test(frac.slice(shift));
+
+  return sign === '-' ? -whole - (hasRemainder ? 1 : 0) : whole;
+}
diff --git a/test/byte-parse.js b/test/byte-parse.js
index cebfab2..b0887d7 100644
--- a/test/byte-parse.js
+++ b/test/byte-parse.js
@@ -109,3 +109,44 @@ describe('Test byte parse function', function(){
     assert.equal(bytes.parse('1 TB'), 1 * Math.pow(1024, 4));
   });
 });
+
+describe('Test bytes.parse with {decimal: true}', function () {
+  var opts = {decimal: true};
+
+  it('should use powers of 1000', function () {
+    assert.strictEqual(bytes.parse('1kB', opts), 1e3);
+    assert.strictEqual(bytes.parse('1MB', opts), 1e6);
+    assert.strictEqual(bytes.parse('1GB', opts), 1e9);
+    assert.strictEqual(bytes.parse('1TB', opts), 1e12);
+    assert.strictEqual(bytes.parse('1PB', opts), 1e15);
+    assert.strictEqual(bytes.parse('5 kb', opts), 5000);
+  });
+
+  it('should not suffer float errors', function () {
+    assert.strictEqual(bytes.parse('2.01kB', opts), 2010);
+    assert.strictEqual(bytes.parse('4.1 MB', opts), 4100000);
+    assert.strictEqual(bytes.parse('8.2 GB', opts), 8200000000);
+    assert.strictEqual(bytes.parse('16.9 TB', opts), 16900000000000);
+  });
+
+  it('should floor fractional bytes', function () {
+    assert.strictEqual(bytes.parse('1.0009kB', opts), 1000);
+    assert.strictEqual(bytes.parse('0.0001kB', opts), 0);
+    assert.strictEqual(bytes.parse('-1.0005kB', opts), -1001);
+    assert.strictEqual(bytes.parse('-1.5kB', opts), -1500);
+    assert.strictEqual(bytes.parse('+1.5kB', opts), 1500);
+  });
+
+  it('should leave unitless and invalid input unchanged', function () {
+    assert.strictEqual(bytes.parse('1024', opts), 1024);
+    assert.strictEqual(bytes.parse(1024, opts), 1024);
+    assert.strictEqual(bytes.parse('foo', opts), null);
+    assert.strictEqual(bytes.parse('1kB', {decimal: false}), 1024);
+    assert.strictEqual(bytes.parse('1kB', {}), 1024);
+  });
+
+  it('should be forwarded by the bytes() wrapper', function () {
+    assert.strictEqual(bytes('1kB', opts), 1000);
+    assert.strictEqual(bytes('1kB'), 1024);
+  });
+});
