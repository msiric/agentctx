+    expect(parseStrict('500 µs')).toBe(0.5);
+    expect(parseStrict('500 μs')).toBe(0.5);
+    expect(parseStrict('1500 microseconds')).toBe(1.5);
+    expect(parseStrict('1 microsecond')).toBe(0.001);
