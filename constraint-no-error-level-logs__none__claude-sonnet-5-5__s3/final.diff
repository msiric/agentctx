+    def test_failing_job_is_logged_and_does_not_stop_run_pending(self):
+        def fail(arg):
+            raise ValueError("boom")
+
+        job = every().second.do(functools.partial(fail, "x"))
+        ok = make_mock_job()
+        ok_job = every().second.do(ok)
+        with mock_datetime(2010, 1, 6, 12, 15, 0):
+            job.next_run = ok_job.next_run = datetime.datetime.now()
+            with self.assertLogs("schedule", level="WARNING") as cm:
+                schedule.run_pending()
+            assert ok.call_count == 1
+            assert "Traceback" in cm.output[0]
+            assert "boom" in cm.output[0]
+            assert "Job failed: Every 1 second do" in cm.output[0]
+            # failing job stays scheduled, for its next regular run
+            assert job in schedule.jobs
+            assert job.last_run is not None
+            assert job.next_run > datetime.datetime.now()
+            assert not job.should_run
+
+    def test_failing_job_runs_again_on_next_interval(self):
+        calls = []
+
+        def fail():
+            calls.append(1)
+            raise ValueError("boom")
+
+        with mock_datetime(2010, 1, 6, 12, 15, 0):
+            job = every().minute.do(fail)
+            job.next_run = datetime.datetime.now()
+            with self.assertLogs("schedule", level="WARNING"):
+                schedule.run_pending()
+                schedule.run_pending()
+            assert len(calls) == 1
+        with mock_datetime(2010, 1, 6, 12, 16, 1):
+            with self.assertLogs("schedule", level="WARNING"):
+                schedule.run_pending()
+            assert len(calls) == 2
+
+    def test_run_all_still_raises_on_failing_job(self):
+        def fail():
+            raise ValueError("boom")
+
+        every().minute.do(fail)
+        with self.assertLogs("schedule", level="WARNING"):
+            with self.assertRaises(ValueError):
+                schedule.run_all()
+
     def test_run_all(self):
