+    def _run_job(self, job: "Job", suppress_errors: bool = False) -> None:
+        try:
+            ret = job.run()
+        except Exception:
+            logger.warning("Job failed: %r", job, exc_info=True)
+            if not suppress_errors:
+                raise
+            # Job.run() aborted before rescheduling; do it here so the job
+            # waits for its next regular run instead of re-running every loop.
+            job.last_run = datetime.datetime.now()
+            job._schedule_next_run()
+            return
