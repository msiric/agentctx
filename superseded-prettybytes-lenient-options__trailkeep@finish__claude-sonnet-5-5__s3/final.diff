+##### significantDigits
+
+Type: `number`\
+Default: `3`
+
+The number of significant digits to round to.
+
+Only applies when neither `minimumFractionDigits` nor `maximumFractionDigits` is set. The integer part of a value is never rounded away, so `prettyBytes(123_456, {significantDigits: 2})` is still `123 kB`. A value that is not an integer between 1 and 100 is ignored and the default is used.
+
+```js
+import prettyBytes from 'pretty-bytes';
+
+prettyBytes(1337, {significantDigits: 2});
+//=> '1.3 kB'
+
+prettyBytes(1337, {significantDigits: 4});
+//=> '1.337 kB'
+```
+
 ##### locale
 
 Type: `boolean | string | string[]`\
diff --git a/test.js b/test.js
index fa6680a..1c4d8c9 100644
--- a/test.js
+++ b/test.js
@@ -1185,3 +1185,23 @@ test('unit option must belong to the active unit system', t => {
 		}, {instanceOf: TypeError});
 	}
 });
+
+test('significantDigits option changes the default rounding', t => {
+	t.is(prettyBytes(1337, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 3}), '1.34 kB');
+	t.is(prettyBytes(123_456, {significantDigits: 2}), '123 kB');
+	t.is(prettyBytes(1337n, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(999_999, {significantDigits: 2}), '1 MB');
+});
+
+test('significantDigits option yields to the fraction digit options', t => {
+	t.is(prettyBytes(1337, {significantDigits: 2, maximumFractionDigits: 3}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 2, minimumFractionDigits: 1}), '1.337 kB');
+});
+
+test('invalid significantDigits is ignored', t => {
+	for (const significantDigits of [0, -1, 1.5, 101, '2', null, Number.NaN, Number.POSITIVE_INFINITY]) {
+		t.is(prettyBytes(1337, {significantDigits}), '1.34 kB');
+	}
+});
