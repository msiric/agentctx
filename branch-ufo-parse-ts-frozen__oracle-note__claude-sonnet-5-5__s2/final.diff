+/**
+ * Removes the query string of the URL, keeping the hash.
+ *
+ * @example
+ *
+ * ```js
+ * withoutQuery("/foo?bar=1#baz"); // "/foo#baz"
+ * ```
+ *
+ * @group utils
+ */
+export function withoutQuery(input: string): string {
+  if (!input.includes("?")) {
+    return input;
+  }
+  const parsed = parseURL(input);
+  parsed.search = "";
+  return stringifyParsedURL(parsed);
+}
