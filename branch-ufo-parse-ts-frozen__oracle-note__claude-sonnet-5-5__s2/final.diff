+export interface ParsedDataURL {
+  /** MIME type (including parameters such as `charset`), defaults to `text/plain`. */
+  mimeType: string;
+  /** Whether the payload is base64-encoded. */
+  base64: boolean;
+  /** The raw (still encoded) payload after the first comma. */
+  data: string;
+}
+
+/**
+ * Parses a `data:` URL into its mime type, base64 flag and raw data.
+ *
+ * @example
+ *
+ * parseDataURL("data:text/plain;base64,SGk="); // { mimeType: "text/plain", base64: true, data: "SGk=" }
+ *
+ * @param input - The `data:` URL
+ * @returns The parsed parts, or `undefined` if the input is not a valid data URL
+ */
+export function parseDataURL(input: string): ParsedDataURL | undefined {
+  if (!/^data:/i.test(input)) {
+    return undefined;
+  }
+  const rest = input.slice(5);
+  const comma = rest.indexOf(",");
+  if (comma === -1) {
+    return undefined;
+  }
+  let meta = rest.slice(0, comma).trim();
+  const data = rest.slice(comma + 1);
+  let base64 = false;
+  const b64 = /;\s*base64$/i.exec(meta);
+  if (b64) {
+    base64 = true;
+    meta = meta.slice(0, b64.index);
+  }
+  // Empty type, or only parameters (e.g. ";charset=utf-8"), implies text/plain
+  const mimeType =
+    !meta || meta.startsWith(";") ? `text/plain${meta}` : meta;
+  return { mimeType, base64, data };
+}
