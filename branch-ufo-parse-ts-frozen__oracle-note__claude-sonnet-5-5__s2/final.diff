diff --git a/test/data-url.test.ts b/test/data-url.test.ts
new file mode 100644
index 0000000..f7fbf08
--- /dev/null
+++ b/test/data-url.test.ts
@@ -0,0 +1,47 @@
+import { describe, expect, it } from "vitest";
+import { parseDataURL } from "../src";
+
+describe("parseDataURL", () => {
+  const tests = [
+    {
+      input: "data:text/plain;base64,SGVsbG8=",
+      out: { mimeType: "text/plain", base64: true, data: "SGVsbG8=" },
+    },
+    {
+      input: "data:text/html,<h1>Hi</h1>",
+      out: { mimeType: "text/html", base64: false, data: "<h1>Hi</h1>" },
+    },
+    {
+      input: "data:,Hello%20World",
+      out: { mimeType: "text/plain", base64: false, data: "Hello%20World" },
+    },
+    {
+      input: "data:;charset=utf-8;base64,SGk=",
+      out: {
+        mimeType: "text/plain;charset=utf-8",
+        base64: true,
+        data: "SGk=",
+      },
+    },
+    {
+      input: "data:text/plain;charset=utf-8,a,b",
+      out: {
+        mimeType: "text/plain;charset=utf-8",
+        base64: false,
+        data: "a,b",
+      },
+    },
+    {
+      input: "DATA:image/png;BASE64,AAAA",
+      out: { mimeType: "image/png", base64: true, data: "AAAA" },
+    },
+    { input: "data:text/plain", out: undefined },
+    { input: "https://example.com/a,b", out: undefined },
+  ];
+
+  for (const t of tests) {
+    it(t.input, () => {
+      expect(parseDataURL(t.input)).toEqual(t.out);
+    });
+  }
+});
