+/**
+ * Format a number with a fixed count of decimals, cutting off extra
+ * decimals (toward zero) instead of rounding, so the result never
+ * exceeds the actual value.
+ *
+ * @param {number} val
+ * @param {number} decimalPlaces
+ * @param {number} scale bytes per unit
+ * @returns {string}
+ * @private
+ */
+
+function truncate(val, decimalPlaces, scale) {
+  // toFixed(20) gives the (near) exact decimal expansion without rounding
+  // at the digits we care about; then cut the string.
+  var full = Math.abs(val) < 1e21 ? val.toFixed(20) : val.toFixed(0);
+  var parts = full.split('.');
+  var frac = (parts[1] || '');
+  while (frac.length < decimalPlaces) {
+    frac += '0';
+  }
+  frac = frac.slice(0, decimalPlaces);
+  var out = decimalPlaces > 0 ? parts[0] + '.' + frac : parts[0];
+
+  // Absorb binary float noise (e.g. 1.2 stored as 1.19999...): if the next
+  // step up still maps back to the same byte count, it is the true value.
+  var step = Math.pow(10, -decimalPlaces);
+  var up = Number(out) + (val < 0 ? -step : step);
+  if (Math.abs(up) * scale <= Math.abs(val) * scale) {
+    return up.toFixed(decimalPlaces);
+  }
+
+  return out;
+}
