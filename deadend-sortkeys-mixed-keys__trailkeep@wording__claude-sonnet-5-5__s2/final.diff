+def _stringify_keys(obj: Any) -> Any:
+    """
+    Recursively convert dict keys the way :mod:`json` does (``1`` -> ``'1'``,
+    ``True`` -> ``'true'``, ``None`` -> ``'null'``), so that dicts with mixed
+    key types can be sorted without raising a ``TypeError``.
+    """
+    if isinstance(obj, dict):
+        result = {}
+        for key, value in obj.items():
+            if isinstance(key, bool):
+                key = 'true' if key else 'false'
+            elif key is None:
+                key = 'null'
+            elif isinstance(key, (int, float)):
+                key = json.dumps(key)
+            result[key] = _stringify_keys(value)
+        return result
+    if isinstance(obj, (list, tuple)):
+        return [_stringify_keys(item) for item in obj]
+    return obj
+
