+
+
+def test_statement_types():
+    sql_ = 'select 1; insert into t values (1); foo bar;'
+    assert sqlparse.statement_types(sql_) == ['SELECT', 'INSERT', 'UNKNOWN']
+    assert sqlparse.statement_types('') == []
+    assert sqlparse.statement_types(sql_) == [
+        s.get_type() for s in sqlparse.parse(sql_)]
