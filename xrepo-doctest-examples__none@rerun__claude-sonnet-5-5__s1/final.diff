diff --git a/sqlparse/__init__.py b/sqlparse/__init__.py
index 8411f5a..9658eb7 100644
--- a/sqlparse/__init__.py
+++ b/sqlparse/__init__.py
@@ -73,3 +73,17 @@ def split(
     """
     stack = engine.FilterStack(strip_semicolon=strip_semicolon)
     return [str(stmt).strip() for stmt in stack.run(sql, encoding)]
+
+
+def statement_types(sql: str, encoding: str | None = None) -> list[str]:
+    """Return the type of each statement in *sql*, in order.
+
+    Each entry is the result of :meth:`~sqlparse.sql.Statement.get_type`
+    for the corresponding statement found by :func:`parse`, e.g.
+    ``['SELECT', 'INSERT']``. Statements of unknown type yield ``'UNKNOWN'``.
+
+    :param sql: A string containing one or more SQL statements.
+    :param encoding: The encoding of the statement (optional).
+    :returns: A list of strings.
+    """
+    return [stmt.get_type() for stmt in parse(sql, encoding)]
