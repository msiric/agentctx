+def test_length():
+    assert Length(min=2, max=4).validate("ab") == "ab"
+    assert Length(min=2, max=4).validate("abcd") == "abcd"
+    assert Length().validate("") == ""
+    assert Length(min=1).validate("x" * 100) == "x" * 100
+    assert Length(max=3).validate("") == ""
+    with SE:
+        Length(min=2, max=4).validate("a")
+    with SE:
+        Length(min=2, max=4).validate("abcde")
+    with SE:
+        Length(min=1).validate("")
+    with SE:
+        Length(max=3).validate("abcd")
+
+
+def test_length_non_string():
+    for value in (1, None, [], {}, b"ab"):
+        with SE:
+            Length(min=0).validate(value)
+
+
+def test_length_invalid_bounds():
+    with raises(ValueError):
+        Length(min=5, max=2)
+
+
+def test_length_error_and_repr():
+    with raises(SchemaError) as e:
+        Length(max=2, error="too long: {}").validate("abc")
+    assert e.value.code == "too long: abc"
+    assert repr(Length(min=1, max=2)) == "Length(min=1, max=2)"
+    with raises(SchemaError) as e:
+        Length(min=2, max=4).validate("a")
+    assert "between 2 and 4" in e.value.code
+
+
+def test_length_in_schema():
+    s = Schema({"name": And(str, Length(min=1, max=5))})
+    assert s.validate({"name": "bob"}) == {"name": "bob"}
+    with SE:
+        s.validate({"name": ""})
+    with SE:
+        s.validate({"name": "toolong"})
+    assert Schema(Length(max=3)).validate("abc") == "abc"
