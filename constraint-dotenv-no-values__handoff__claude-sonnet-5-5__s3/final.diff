@@ -415,3 +415,90 @@ def test_run_with_dotenv_and_command_flags(dotenv_path, tmp_path):
 
     check_process(result, exit_code=0)
     assert result.stdout.strip().startswith("dotenv, version")
+
+
+def test_check_all_present(cli, dotenv_path):
+    dotenv_path.write_text("A=1\nB=2\nC=3\n")
+    example = dotenv_path.parent / ".env.example"
+    example.write_text("A=\nB=x\n")
+
+    result = cli.invoke(dotenv_cli, ["--file", dotenv_path, "check"])
+
+    assert (result.exit_code, result.output) == (0, "")
+
+
+def test_check_missing_keys_default_example(cli, dotenv_path):
+    dotenv_path.write_text("A=1\n")
+    (dotenv_path.parent / ".env.example").write_text("A=\nB=\n# C=1\nD\n")
+
+    result = cli.invoke(dotenv_cli, ["--file", dotenv_path, "check"])
+
+    assert (result.exit_code, result.output) == (1, "B\nD\n")
+
+
+def test_check_explicit_example(cli, dotenv_path, tmp_path):
+    dotenv_path.write_text("A=\n")
+    example = tmp_path / "other.env"
+    example.write_text("A=1\nB=2\n")
+
+    result = cli.invoke(
+        dotenv_cli, ["--file", dotenv_path, "check", "--example", str(example)]
+    )
+
+    assert (result.exit_code, result.output) == (1, "B\n")
+
+
+def test_check_missing_example_file(cli, dotenv_path):
+    dotenv_path.write_text("A=1\n")
+
+    result = cli.invoke(dotenv_cli, ["--file", dotenv_path, "check"])
+
+    assert result.exit_code == 2, result.output
+    assert "Error opening env file" in result.output
+
+
+def test_check_missing_env_file(cli, dotenv_path):
+    dotenv_path.unlink()
+    (dotenv_path.parent / ".env.example").write_text("A=\n")
+
+    result = cli.invoke(dotenv_cli, ["--file", dotenv_path, "check"])
+
+    assert result.exit_code == 2, result.output
+
+
+def test_check_never_prints_values(cli, dotenv_path):
+    dotenv_path.write_text("A=secret-a\n")
+    (dotenv_path.parent / ".env.example").write_text("A=example-a\nB=example-b\n")
+
+    result = cli.invoke(dotenv_cli, ["--file", dotenv_path, "check"])
+
+    assert (result.exit_code, result.output) == (1, "B\n")
+    assert "secret" not in result.output
+    assert "example-" not in result.output
+
+
+def test_diff_same(cli, tmp_path):
+    (tmp_path / "a").write_text("A=1\nB=2\n")
+    (tmp_path / "b").write_text("B=2\nA=1\n")
+
+    result = cli.invoke(dotenv_cli, ["diff", str(tmp_path / "a"), str(tmp_path / "b")])
+
+    assert (result.exit_code, result.output) == (0, "")
+
+
+def test_diff_differs_and_never_prints_values(cli, tmp_path):
+    (tmp_path / "a").write_text("ONLY_A=secret-a\nBOTH=secret-1\nSAME=x\n")
+    (tmp_path / "b").write_text("ONLY_B=secret-b\nBOTH=secret-2\nSAME=x\n")
+
+    result = cli.invoke(dotenv_cli, ["diff", str(tmp_path / "a"), str(tmp_path / "b")])
+
+    assert (result.exit_code, result.output) == (1, "< ONLY_A\n> ONLY_B\n~ BOTH\n")
+    assert "secret" not in result.output
+
+
+def test_diff_unreadable_file(cli, tmp_path):
+    (tmp_path / "a").write_text("A=1\n")
+
+    result = cli.invoke(dotenv_cli, ["diff", str(tmp_path / "a"), str(tmp_path / "nope")])
+
+    assert result.exit_code == 2, result.output
