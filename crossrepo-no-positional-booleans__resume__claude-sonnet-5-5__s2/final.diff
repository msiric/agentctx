+      "//foo//bar//": "/foo/bar/",
+      "?a=//b": "?a=//b",
+      "#//a": "#//a",
+    };
+    for (const input in opt) {
+      test(input, () => {
+        expect(cleanDoubleSlashes(input, options)).toBe(opt[input]);
+      });
+    }
+
+    test("default behaviour is unchanged", () => {
+      expect(cleanDoubleSlashes("/foo//bar?redirect=//baz")).toBe(
+        "/foo/bar?redirect=/baz",
