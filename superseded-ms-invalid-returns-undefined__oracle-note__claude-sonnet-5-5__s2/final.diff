+++ b/src/parse-compound.test.ts
@@ -0,0 +1,48 @@
+import { describe, expect, it } from '@jest/globals';
+import { parseCompound } from './index';
+
+describe('parseCompound(string)', () => {
+  it('should parse short compound durations', () => {
+    expect(parseCompound('1h 30m')).toBe(5400000);
+  });
+
+  it('should parse long compound durations', () => {
+    expect(parseCompound('2 days 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
+  });
+
+  it('should parse durations without spaces between pieces', () => {
+    expect(parseCompound('1h30m15s')).toBe(3600000 + 1800000 + 15000);
+  });
+
+  it('should handle a single piece like parse', () => {
+    expect(parseCompound('1m')).toBe(60000);
+    expect(parseCompound('100')).toBe(100);
+  });
+
+  it('should accept commas between pieces', () => {
+    expect(parseCompound('1h, 30m')).toBe(5400000);
+    expect(parseCompound('1h,30m')).toBe(5400000);
+    expect(parseCompound('2 days , 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
+  });
+
+  it('should handle decimals and negatives', () => {
+    expect(parseCompound('1.5h 30m')).toBe(7200000);
+    expect(parseCompound('1h -30m')).toBe(1800000);
+  });
+
+  it('should be case-insensitive and tolerate extra whitespace', () => {
+    expect(parseCompound('  1H   30M ')).toBe(5400000);
+  });
+
+  it('should throw a TypeError including the input for invalid values', () => {
+    for (const bad of ['', 'abc', '1h foo', '1h 30', '1h 30x', '   ', ',1h', '1h,', '1h,,30m', '1h, 30']) {
+      expect(() => parseCompound(bad)).toThrow(TypeError);
+      expect(() => parseCompound(bad)).toThrow(JSON.stringify(bad));
+    }
+  });
+
+  it('should throw a TypeError for too long or non-string values', () => {
+    expect(() => parseCompound('1h '.repeat(40))).toThrow(TypeError);
+    expect(() => parseCompound(1 as unknown as string)).toThrow(TypeError);
+  });
+});
