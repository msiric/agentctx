+/**
+ * Parse a compound duration such as `"1h 30m"`, `"1h, 30m"` or `"2 days 4 hours"` and
+ * return the total in milliseconds. Each piece is parsed with `parse`.
+ *
+ * When there are multiple pieces, each one must have a unit.
+ *
+ * @param str - A compound duration string
+ * @returns The total in milliseconds (never `NaN`)
+ * @throws TypeError if `str` is not a string with length between 1 and 99, or
+ * can't be parsed as a compound duration
+ */
+export function parseCompound(str: string): number {
+  const invalid = (reason: string) =>
+    new TypeError(
+      `Invalid value provided to ms.parseCompound(): ${reason}. value=${JSON.stringify(str)}`,
+    );
+
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw invalid('must be a string with length between 1 and 99');
+  }
+
+  const pieceRe = /\s*(-?\d*\.?\d+ *[a-z]*)\s*(?:,\s*)?/iy;
+  const pieces: string[] = [];
+  let end = 0;
+  while (end < str.length) {
+    pieceRe.lastIndex = end;
+    const match = pieceRe.exec(str);
+    if (!match) {
+      throw invalid('expected a compound duration like "1h 30m"');
+    }
+    pieces.push(match[1] as string);
+    end = pieceRe.lastIndex;
+  }
+
+  if (str.trimEnd().endsWith(',')) {
+    throw invalid('trailing comma');
+  }
+
+  if (pieces.length > 1 && pieces.some((piece) => !/[a-z]/i.test(piece))) {
+    throw invalid('every piece of a compound duration needs a unit');
+  }
+
+  let total = 0;
+  for (const piece of pieces) {
+    const value = parse(piece);
+    if (Number.isNaN(value)) {
+      throw invalid(`unable to parse "${piece.trim()}"`);
+    }
+    total += value;
+  }
+  return total;
+}
+
+/**
+ * Parse a timer-style string and return milliseconds. `"m:ss"` (e.g. `"1:30"`)
+ * and `"h:mm:ss"` (e.g. `"01:02:03"`) are supported. Seconds may have a
+ * fractional part (e.g. `"1:30.5"`).
+ *
+ * @param str - A clock string
+ * @returns The value in milliseconds, or `undefined` if the input isn't a valid
+ * clock string (this function never throws and never returns `NaN`)
+ */
+export function parseClock(str: string): number | undefined {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    return undefined;
+  }
+  const hms = /^(\d+):([0-5]\d):([0-5]\d(?:\.\d+)?)$/.exec(str);
+  const ms_ = hms ? null : /^(\d+):([0-5]\d(?:\.\d+)?)$/.exec(str);
+  if (hms) return Number(hms[1]) * h + Number(hms[2]) * m + Number(hms[3]) * s;
+  if (ms_) return Number(ms_[1]) * m + Number(ms_[2]) * s;
+  return undefined;
+}
+
 /**
  * Short format for `ms`.
  */
