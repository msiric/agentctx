+test('onRetry runs only before an attempt that will happen, after shouldRetry', async () => {
+	const order = [];
+	const contexts = [];
+	let attempts = 0;
+
+	await assert.rejects(pRetry(async () => {
+		attempts++;
+		throw new Error(`fail ${attempts}`);
+	}, {
+		retries: 2,
+		minTimeout: 0,
+		onFailedAttempt() {
+			order.push('onFailedAttempt');
+		},
+		shouldRetry() {
+			order.push('shouldRetry');
+			return true;
+		},
+		async onRetry(context) {
+			order.push('onRetry');
+			contexts.push(context);
+			await delay(1);
+		},
+	}), {message: 'fail 3'});
+
+	assert.equal(attempts, 3);
+	assert.equal(contexts.length, 2, 'not called for the final failure');
+	assert.deepEqual(contexts.map(({attemptNumber}) => attemptNumber), [1, 2]);
+	assert.ok(Object.isFrozen(contexts[0]));
+	assert.deepEqual(order.slice(0, 3), ['onFailedAttempt', 'shouldRetry', 'onRetry']);
+});
+
+test('onRetry is not called when shouldRetry declines, for AbortError, or for a non-retriable TypeError', async () => {
+	let calls = 0;
+	const onRetry = () => {
+		calls++;
+	};
+
+	await assert.rejects(pRetry(async () => {
+		throw new Error('no');
+	}, {onRetry, shouldRetry: () => false}), {message: 'no'});
+
+	await assert.rejects(pRetry(async () => {
+		throw new AbortError('stop');
+	}, {onRetry}), {message: 'stop'});
+
+	await assert.rejects(pRetry(async () => {
+		throw new TypeError('broken');
+	}, {onRetry}), {message: 'broken'});
+
+	assert.equal(calls, 0);
+});
+
+test('onRetry is called for a retry that does not consume the budget', async () => {
+	let calls = 0;
+	let attempts = 0;
+
+	await pRetry(async () => {
+		attempts++;
+		if (attempts < 3) {
+			throw new Error('again');
+		}
+	}, {
+		retries: 1,
+		shouldConsumeRetry: () => false,
+		onRetry() {
+			calls++;
+		},
+	});
+
+	assert.equal(calls, 2);
+});
+
+test('onRetry can throw to abort retries', async () => {
+	const error = new Error('from onRetry');
+	let attempts = 0;
+
+	await assert.rejects(pRetry(async () => {
+		attempts++;
+		throw new Error('fail');
+	}, {
+		onRetry() {
+			throw error;
+		},
+	}), rejectsWith(error));
+
+	assert.equal(attempts, 1);
+});
