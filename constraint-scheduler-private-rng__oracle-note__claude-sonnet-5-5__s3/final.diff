+    def test_retry_backoff_and_give_up(self):
+        calls = []
+
+        def flaky():
+            calls.append(1)
+            raise RuntimeError("boom")
+
+        with mock_datetime(2014, 6, 28, 12, 0):
+            job = every().hour.do(flaky).retry(times=3, base_delay=30)
+        assert job.next_run == datetime.datetime(2014, 6, 28, 13, 0)
+        with mock.patch("schedule._jitter_rng.uniform", return_value=5) as uni:
+            now = job.next_run
+            # delays: 30*1+5, 30*2+5, 30*4+5
+            for i, delay in enumerate([35, 65, 125]):
+                with mock_datetime(2014, 6, 28, now.hour, now.minute, now.second):
+                    schedule.run_pending()
+                assert len(calls) == i + 1
+                assert job.next_run == now + datetime.timedelta(seconds=delay)
+                uni.assert_called_with(0, 30)
+                now = job.next_run
+            # 4th failure exhausts the retries: back to the normal schedule
+            with mock_datetime(2014, 6, 28, now.hour, now.minute, now.second):
+                schedule.run_pending()
+            assert len(calls) == 4
+            assert job._retries_done == 0
+            assert job.next_run == now + datetime.timedelta(hours=1)
+            # and no further retry is attempted before then
+            with mock_datetime(2014, 6, 28, now.hour, now.minute, now.second + 10):
+                schedule.run_pending()
+            assert len(calls) == 4
+
