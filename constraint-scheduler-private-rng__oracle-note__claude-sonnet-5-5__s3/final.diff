+    def test_jitter(self):
+        mock_job = make_mock_job()
+        with mock_datetime(2014, 6, 28, 12, 0):
+            base = datetime.datetime(2014, 6, 28, 12, 10)
+            offsets = [
+                (every(10).minutes.jitter(30).do(mock_job).next_run - base).total_seconds()
+                for _ in range(100)
+            ]
+            assert len(set(offsets)) > 1
+            assert min(offsets) >= 0
+            assert max(offsets) <= 30
+
+    def test_jitter_applied_each_run(self):
+        mock_job = make_mock_job()
+        with mock_datetime(2014, 6, 28, 12, 0):
+            job = every(10).minutes.jitter(30).do(mock_job)
+            with mock.patch("schedule._jitter_rng.uniform", return_value=7) as uni:
+                job._schedule_next_run()
+                uni.assert_called_once_with(0, 30)
+            assert job.next_run == datetime.datetime(2014, 6, 28, 12, 10, 7)
+
+    def test_jitter_zero_and_default(self):
