+    def jitter(self, seconds: float):
+        """
+        Delay every computed `next_run` by a random offset between 0 and
+        `seconds` (inclusive), so that many identical jobs don't all fire
+        in the same instant.
+
+        For example, `every(10).minutes.jitter(30)` runs every 10 minutes
+        plus a random 0-30 seconds, chosen anew for each run.
+
+        :param seconds: Maximum delay in seconds (must be >= 0)
+        :return: The invoked job instance
+        """
+        if seconds < 0:
+            raise ScheduleValueError("`jitter` must be >= 0")
+        self.jitter_seconds = seconds
+        return self
+
+    def retry(self, times: int, base_delay: float):
+        """
+        Retry the job when it raises. The first retry happens `base_delay`
+        seconds after the failure, the next after 2x `base_delay`, then 4x,
+        and so on. Each delay gets a random 0 to `base_delay` seconds of
+        jitter added. After `times` failed retries the job gives up and
+        returns to its normal schedule.
+
+        Exceptions raised by a job with retries configured are logged and
+        do not propagate out of `run_pending`.
+
+        For example, `every(1).hour.do(sync).retry(times=3, base_delay=30)`.
+
+        :param times: Maximum number of retries (must be >= 1)
+        :param base_delay: Base delay in seconds (must be >= 0)
+        :return: The invoked job instance
+        """
+        if times < 1:
+            raise ScheduleValueError("`times` must be >= 1")
+        if base_delay < 0:
+            raise ScheduleValueError("`base_delay` must be >= 0")
+        self.retry_times = times
+        self.retry_base_delay = base_delay
+        return self
+
