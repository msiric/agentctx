 """
 
 import argparse
+import json
 import sys
 from typing import cast, List, Optional
 
@@ -83,6 +84,44 @@ def cmd_nextver(args: argparse.Namespace) -> str:
     return str(version.next_version(args.part))
 
 
+def cmd_sort(args: argparse.Namespace) -> Optional[str]:
+    """
+    Subcommand: Sorts versions, oldest first.
+
+    Synopsis: sort [<VERSION>...]
+
+    If no version is given, versions are read from stdin, one per line;
+    blank lines are ignored.
+
+    :param args: The parsed arguments
+    :return: the sorted versions, one per line (nothing if no version is given)
+    """
+    raw = args.versions or [line.strip() for line in sys.stdin]
+    versions = sorted(Version.parse(v) for v in raw if v.strip())
+    if not versions:
+        return None
+    return "\n".join(str(v) for v in versions)
+
+
+def cmd_latest(args: argparse.Namespace) -> str:
+    """
+    Subcommand: Prints the highest version that is not a prerelease.
+
+    Synopsis: latest [<VERSION>...]
+
+    If no version is given, versions are read from stdin, one per line;
+    blank lines are ignored.
+
+    :param args: The parsed arguments
+    :return: the highest final version as a JSON string, or ``null`` if
+        there is none
+    """
+    raw = args.versions or [line.strip() for line in sys.stdin]
+    versions = [Version.parse(v) for v in raw if v.strip()]
+    finals = [v for v in versions if not v.prerelease]
+    return json.dumps(str(max(finals)) if finals else None)
+
+
 def createparser() -> argparse.ArgumentParser:
     """
     Create an :class:`argparse.ArgumentParser` instance.
@@ -133,6 +172,18 @@ def createparser() -> argparse.ArgumentParser:
     parser_nextver.add_argument(
         "part", help="One of 'major', 'minor', 'patch', or 'prerelease'"
     )
+
+    # Create the sort subcommand
+    parser_sort = s.add_parser("sort", help="Sorts versions, oldest first")
+    parser_sort.set_defaults(func=cmd_sort)
+    parser_sort.add_argument("versions", nargs="*", help="Versions to sort")
+
+    # Create the latest subcommand
+    parser_latest = s.add_parser(
+        "latest", help="Prints the highest version that is not a prerelease"
+    )
+    parser_latest.set_defaults(func=cmd_latest)
+    parser_latest.add_argument("versions", nargs="*", help="Versions to consider")
     return parser
 
 
