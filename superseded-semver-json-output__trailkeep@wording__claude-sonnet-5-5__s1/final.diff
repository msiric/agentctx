+def test_sort_prints_plain_lines_oldest_first(capsys):
+    assert main(["sort", "1.10.0", "1.2.0", "1.2.0-rc.1", "0.9.9+build"]) == 0
+    assert capsys.readouterr().out == "0.9.9+build\n1.2.0-rc.1\n1.2.0\n1.10.0\n"
