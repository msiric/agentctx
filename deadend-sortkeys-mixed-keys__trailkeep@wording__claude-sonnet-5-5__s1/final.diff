+def test_json_sorted_by_default(tmpdir):
+    db_file = tmpdir.join('test.db')
+    db = TinyDB(str(db_file))
+    db.insert({'b': 1, 'a': {'d': 1, 'c': 2}})
+    db.close()
+
+    assert db_file.read() == '{"_default": {"1": {"a": {"c": 2, "d": 1}, "b": 1}}}'
+
+
+def test_json_sort_keys_disabled(tmpdir):
+    db_file = tmpdir.join('test.db')
+    db = TinyDB(str(db_file), sort_keys=False)
+    db.insert({'b': 1, 'a': 2})
+    db.close()
+
+    assert db_file.read() == '{"_default": {"1": {"b": 1, "a": 2}}}'
+
+
+def test_json_sort_mixed_key_types(tmpdir):
+    path = str(tmpdir.join('test.db'))
+    storage = JSONStorage(path)
+    storage.write({'t': {'1': {'hits': {200: 1520, 'other': 3, 'a': [{2: 1, 'b': 2}]}}}})
+    storage.close()
+
+    with open(path) as f:
+        assert f.read() == (
+            '{"t": {"1": {"hits": {"200": 1520, "a": [{"2": 1, "b": 2}], "other": 3}}}}'
+        )
+
+
