+def _sort_keys(obj: Any) -> Any:
+    """
+    Recursively rebuild dicts with their keys stringified and sorted.
+    """
+    if isinstance(obj, dict):
+        items = []
+        for key, value in obj.items():
+            if not isinstance(key, str) and isinstance(key, (int, float, bool, type(None))):
+                key = json.dumps(key)
+            items.append((key, _sort_keys(value)))
+        try:
+            items.sort(key=lambda item: item[0])
+        except TypeError:
+            # Unsupported key types: let ``json.dumps`` deal with them
+            pass
+        return dict(items)
+    if isinstance(obj, (list, tuple)):
+        return [_sort_keys(item) for item in obj]
+    return obj
+
