     db.close()
+
+
+def test_to_csv_default_fields(db, tmp_path):
+    db.truncate()
+    db.insert({'a': 1, 'b': 'x'})
+    db.insert({'c': 3, 'a': 2})
+
+    path = tmp_path / 'out.csv'
+    db.to_csv(path)
+
+    assert path.read_text(encoding='utf-8').splitlines() == [
+        'a,b,c',
+        '1,x,',
+        '2,,3',
+    ]
+
+
+def test_to_csv_fields_select_and_order(db, tmp_path):
+    db.truncate()
+    db.insert({'a': 1, 'b': 2, 'c': 3})
+
+    path = tmp_path / 'out.csv'
+    db.to_csv(path, fields=['c', 'a', 'missing'])
+
+    assert path.read_text(encoding='utf-8').splitlines() == [
+        'c,a,missing',
+        '3,1,',
+    ]
+
+
+def test_to_csv_quoting_and_empty_table(db, tmp_path):
+    import csv
+
+    db.truncate()
+    path = tmp_path / 'empty.csv'
+    db.to_csv(path, fields=['a'])
+    assert path.read_text(encoding='utf-8').splitlines() == ['a']
+
+    db.insert({'a': 'x,y', 'b': 'line\nbreak'})
+    db.to_csv(path)
+    with open(path, newline='', encoding='utf-8') as f:
+        assert list(csv.reader(f)) == [['a', 'b'], ['x,y', 'line\nbreak']]
