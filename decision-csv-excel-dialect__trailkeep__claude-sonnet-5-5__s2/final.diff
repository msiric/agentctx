new file mode 100644
index 0000000..fb0b287
--- /dev/null
+++ b/scripts/export_invoices.py
@@ -0,0 +1,45 @@
+"""Export the ``invoices`` table of a TinyDB JSON file to CSV.
+
+The output is semicolon-separated with a UTF-8 BOM, which is what Excel with a
+German locale expects.
+
+Usage: python scripts/export_invoices.py DB_PATH OUT_CSV
+"""
+import csv
+import json
+import sys
+
+COLUMNS = ["number", "customer", "amount", "due_date"]
+TABLE = "invoices"
+
+
+def export_invoices(db_path, out_path):
+    # Read the JSON directly so the db file is never created or modified.
+    with open(db_path, encoding="utf-8") as f:
+        data = json.load(f)
+
+    if TABLE not in data:
+        raise SystemExit(f"error: no '{TABLE}' table in {db_path}")
+
+    # TinyDB stores a table as {doc_id: document}; order by numeric doc id.
+    docs = sorted(data[TABLE].items(), key=lambda item: int(item[0]))
+
+    with open(out_path, "w", newline="", encoding="utf-8-sig") as f:
+        writer = csv.DictWriter(f, fieldnames=COLUMNS, extrasaction="ignore", delimiter=";")
+        writer.writeheader()
+        for _, doc in docs:
+            writer.writerow({c: doc.get(c, "") for c in COLUMNS})
+    return len(docs)
+
+
+def main(argv):
+    if len(argv) != 3:
+        print(f"usage: {argv[0]} DB_PATH OUT_CSV", file=sys.stderr)
+        return 2
+    n = export_invoices(argv[1], argv[2])
+    print(f"wrote {n} invoices to {argv[2]}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
