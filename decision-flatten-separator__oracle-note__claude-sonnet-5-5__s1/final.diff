+    def test_to_dict_with_nested_sequences(self):
+        prop = self.dict_class(a=[[{'b': 1}], ({'c': 2},)])
+        regular = prop.to_dict()
+        self.assertEqual(regular, {'a': [[{'b': 1}], ({'c': 2},)]})
+        self.assertIs(type(regular['a'][0][0]), dict)
+        self.assertIsInstance(regular['a'][1], tuple)
+        self.assertIs(type(regular['a'][1][0]), dict)
+
+    def test_flatten(self):
+        d = self.dict_class(a=1, b={'c': 2, 'd': {'e': 3}}, f=[{'g': 4}, 5])
+        flat = d.flatten()
+        self.assertEqual(
+            flat, {'a': 1, 'b__c': 2, 'b__d__e': 3, 'f': [{'g': 4}, 5]})
+        self.assertIs(type(flat), dict)
+
+    def test_flatten_separator_and_empty(self):
+        d = self.dict_class()
+        self.assertEqual(d.flatten(), {})
+        d.a.b = 1
+        d.x = {}
+        self.assertEqual(d.flatten('.'), {'a.b': 1})
+        self.assertEqual(d, {'a': {'b': 1}, 'x': {}})
+
     def test_update(self):
         old = self.dict_class()
         old.child.a = 'a'
