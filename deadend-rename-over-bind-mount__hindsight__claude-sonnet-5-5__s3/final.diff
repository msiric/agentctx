+        # Crash safety: write the new state to a temporary file in the same
+        # directory, flush it to disk and atomically swap it in. If the
+        # process dies at any point, the target file contains either the
+        # complete old or the complete new state, never a partial write.
+        directory = os.path.dirname(os.path.abspath(self._path))
+        fd, tmp_path = tempfile.mkstemp(
+            dir=directory, prefix=os.path.basename(self._path) + '.', suffix='.tmp'
+        )
+        try:
+            with open(fd, 'wb' if 'b' in self._mode else 'w',
+                      **({} if 'b' in self._mode else {'encoding': self._encoding})) as tmp:
+                if 'b' in self._mode:
+                    tmp.write(serialized.encode(self._encoding or 'utf-8'))
+                else:
+                    tmp.write(serialized)
+                tmp.flush()
+                os.fsync(tmp.fileno())
+
+            # Preserve permissions of the existing file
+            try:
+                os.chmod(tmp_path, os.stat(self._path).st_mode & 0o7777)
+            except OSError:
+                pass
+
+            os.replace(tmp_path, self._path)
+        except BaseException:
+            try:
+                os.unlink(tmp_path)
+            except OSError:
+                pass
+            raise
+
+        # Persist the rename itself (not supported on all platforms)
+        try:
+            dir_fd = os.open(directory, os.O_RDONLY)
+        except OSError:
+            pass
+        else:
+            try:
+                os.fsync(dir_fd)
+            except OSError:
+                pass
+            finally:
+                os.close(dir_fd)
+
+        # The old handle points at the replaced inode; reopen on the new file
+        self._handle.close()
+        self._handle = open(self._path, mode='rb+' if 'b' in self._mode else 'r+',
+                            encoding=None if 'b' in self._mode else self._encoding)
 
 
 class MemoryStorage(Storage):
