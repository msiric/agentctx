diff --git a/tests/test_storages.py b/tests/test_storages.py
index 6e433a1..3a3d2e4 100644
--- a/tests/test_storages.py
+++ b/tests/test_storages.py
@@ -285,3 +285,67 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def test_json_write_crash_safe(tmpdir, monkeypatch):
+    """A crash mid-write must leave the old state readable."""
+    path = str(tmpdir.join('test.db'))
+    db = TinyDB(path)
+    db.insert({'a': 1})
+
+    def crash(fd):
+        raise KeyboardInterrupt('simulated kill during write')
+
+    monkeypatch.setattr(os, 'fsync', crash)
+    with pytest.raises(KeyboardInterrupt):
+        db.insert({'b': 2})
+    monkeypatch.undo()
+
+    # No temp files left behind, old state intact on disk
+    assert os.listdir(str(tmpdir)) == ['test.db']
+    with TinyDB(path) as db2:
+        assert db2.all() == [{'a': 1}]
+
+
+def test_json_write_partial_temp_file_ignored(tmpdir, monkeypatch):
+    """Simulate a hard kill after a partial temp write (no cleanup runs)."""
+    path = str(tmpdir.join('test.db'))
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+
+    def killed_replace(src, dst):
+        with open(src, 'r+') as f:
+            f.truncate(5)  # partial data in temp file only
+        raise SystemExit
+
+    monkeypatch.setattr(os, 'replace', killed_replace)
+    db = TinyDB(path)
+    with pytest.raises(SystemExit):
+        db.insert({'b': 2})
+    monkeypatch.undo()
+
+    with TinyDB(path) as db2:
+        assert db2.all() == [{'a': 1}]
+
+
+def test_json_write_then_read_and_continue(tmpdir):
+    path = str(tmpdir.join('test.db'))
+    with TinyDB(path) as db:
+        for i in range(3):
+            db.insert({'i': i})
+        assert len(db) == 3
+    with TinyDB(path) as db:
+        assert len(db.all()) == 3
+        db.truncate()
+    with TinyDB(path) as db:
+        assert db.all() == []
+
+
+def test_json_write_preserves_permissions(tmpdir):
+    path = str(tmpdir.join('test.db'))
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+    os.chmod(path, 0o640)
+    with TinyDB(path) as db:
+        db.insert({'b': 2})
+    assert os.stat(path).st_mode & 0o777 == 0o640
