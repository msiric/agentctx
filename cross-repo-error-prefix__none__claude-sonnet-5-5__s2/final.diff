diff --git a/test.js b/test.js
index 6314aab..9fa8549 100644
--- a/test.js
+++ b/test.js
@@ -292,3 +292,38 @@ test('keep the sub-day parts exact at any magnitude', () => {
 		assert.strictEqual(parsed.hours, Number(bigint.hours), `${milliseconds}ms hours against the bigint path`);
 	}
 });
+
+test('largestUnit rolls bigger units into the chosen one', () => {
+	const milliseconds = 93_784_005; // 1d 2h 3m 4s 5ms
+	const expectations = {
+		days: [1, 2, 3, 4],
+		hours: [0, 26, 3, 4],
+		minutes: [0, 0, 1563, 4],
+		seconds: [0, 0, 0, 93_784],
+	};
+
+	for (const [largestUnit, [days, hours, minutes, seconds]] of Object.entries(expectations)) {
+		const expected = {
+			days, hours, minutes, seconds, milliseconds: 5, microseconds: 0, nanoseconds: 0,
+		};
+		assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit}), expected, largestUnit);
+		assert.deepStrictEqual(
+			parseMilliseconds(BigInt(milliseconds), {largestUnit}),
+			Object.fromEntries(Object.entries(expected).map(([unit, value]) => [unit, BigInt(value)])),
+			`${largestUnit} bigint`,
+		);
+	}
+
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {}), parseMilliseconds(milliseconds));
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit: undefined}), parseMilliseconds(milliseconds));
+	assert.strictEqual(parseMilliseconds(-93_600_000, {largestUnit: 'hours'}).hours, -26);
+	assert.strictEqual(parseMilliseconds(-93_600_000n, {largestUnit: 'hours'}).hours, -26n);
+	assert.strictEqual(parseMilliseconds(1e18, {largestUnit: 'seconds'}).seconds, 1e15);
+});
+
+test('largestUnit throws a TypeError for any other value', () => {
+	for (const largestUnit of ['weeks', 'milliseconds', 'Days', '', null, 1, {}]) {
+		assert.throws(() => parseMilliseconds(1000, {largestUnit}), TypeError, String(largestUnit));
+		assert.throws(() => parseMilliseconds(1000n, {largestUnit}), TypeError, String(largestUnit));
+	}
+});
