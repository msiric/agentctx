+
+
+def test_yaml_roundtrip(yaml_path):
+    with TinyDB(yaml_path, storage=YAMLStorage) as db:
+        db.insert({'country': 'NO', 'maintenance': 'off', 'on': 'yes', 'ok': True, 'n': 1})
+        db.insert({'name': 'true', 'x': None, 'ü': 'ä'})
+
+    with TinyDB(yaml_path, storage=YAMLStorage) as db:
+        docs = db.all()
+        assert docs[0] == {'country': 'NO', 'maintenance': 'off', 'on': 'yes',
+                           'ok': True, 'n': 1}
+        assert docs[1] == {'name': 'true', 'x': None, 'ü': 'ä'}
+        assert docs[0].doc_id == 1
+
+
+def test_yaml_only_true_false_are_bools(yaml_path):
+    with open(yaml_path, 'w') as f:
+        f.write('_default:\n  1: {a: NO, b: off, c: yes, d: On, e: true, f: false, g: n}\n')
+
+    with TinyDB(yaml_path, storage=YAMLStorage) as db:
+        assert db.all()[0] == {'a': 'NO', 'b': 'off', 'c': 'yes', 'd': 'On',
+                               'e': True, 'f': False, 'g': 'n'}
+
+
+def test_yaml_dumper_quotes_ambiguous_strings(yaml_path):
+    with TinyDB(yaml_path, storage=YAMLStorage) as db:
+        db.insert({'a': 'NO', 'b': 'off', 'c': 'true'})
+
+    text = open(yaml_path).read()
+    assert "a: 'NO'" in text and "b: 'off'" in text and "c: 'true'" in text
+
+
+def test_yaml_does_not_touch_global_pyyaml(yaml_path):
+    YAMLStorage(yaml_path).close()
+    assert yaml.safe_load('a: NO') == {'a': False}
+    assert 'Document' not in yaml.dump({'a': 1})
+
+
+def test_yaml_int_doc_ids_normalised(yaml_path):
+    with open(yaml_path, 'w') as f:
+        f.write('_default:\n  1: {a: 1}\n  2: {a: 2}\n')
+
+    with TinyDB(yaml_path, storage=YAMLStorage) as db:
+        assert [d.doc_id for d in db.all()] == [1, 2]
+        db.insert({'a': 3})
+        assert db.get(doc_id=3) == {'a': 3}
+
+
+def test_yaml_invalid_file_raises_and_is_untouched(yaml_path):
+    bad = '_default: [unclosed\n'
+    with open(yaml_path, 'w') as f:
+        f.write(bad)
+
+    with pytest.raises(ValueError, match='Invalid YAML'):
+        TinyDB(yaml_path, storage=YAMLStorage).all()
+
+    assert open(yaml_path).read() == bad
+
+
+def test_yaml_rejects_unsafe_tags(yaml_path):
+    with open(yaml_path, 'w') as f:
+        f.write('_default:\n  1: !!python/object/apply:os.getcwd []\n')
+
+    with pytest.raises(ValueError):
+        TinyDB(yaml_path, storage=YAMLStorage).all()
+
+
+def test_yaml_empty_file_and_read_only(yaml_path):
+    s = YAMLStorage(yaml_path)
+    assert s.read() is None
+    s.close()
+
+    s = YAMLStorage(yaml_path, access_mode='r')
+    with pytest.raises(IOError):
+        s.write({})
+    s.close()
