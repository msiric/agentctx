+_BOOL_TAG = 'tag:yaml.org,2002:bool'
+_STRICT_BOOL = re.compile(r'^(?:true|false)$')
+
+
+def _make_yaml_classes():
+    """
+    Build the YAML loader/dumper (requires PyYAML).
+
+    The loader follows YAML 1.1 except for booleans: only ``true`` and
+    ``false`` are booleans, so values like ``NO`` or ``off`` stay strings.
+    The dumper keeps the stock resolvers, so such strings are quoted when
+    written and stay readable by other YAML 1.1 tools.
+    """
+    import yaml
+
+    class Loader(yaml.SafeLoader):
+        pass
+
+    # Copy the resolver table (it is shared with SafeLoader otherwise), drop
+    # the YAML 1.1 bool resolver and add a strict one.
+    Loader.yaml_implicit_resolvers = {
+        ch: [(tag, rx) for tag, rx in resolvers if tag != _BOOL_TAG]
+        for ch, resolvers in yaml.SafeLoader.yaml_implicit_resolvers.items()
+    }
+    Loader.add_implicit_resolver(_BOOL_TAG, _STRICT_BOOL, list('tf'))
+
+    class Dumper(yaml.SafeDumper):
+        pass
+
+    # ``Document`` (and any other dict subclass) is written as a plain mapping
+    Dumper.add_multi_representer(
+        dict, lambda dumper, data: dumper.represent_dict(dict(data))
+    )
+
+    return yaml, Loader, Dumper
+
+
+class YAMLStorage(FileStorage):
+    """
+    Store the data in a YAML file (requires PyYAML, ``pip install tinydb[yaml]``).
+
+    Only ``true`` and ``false`` are read as booleans; ``NO``, ``off``, ``yes``
+    etc. stay strings. Comments in the file are not preserved on write.
+    """
+
+    def __init__(self, path: str, create_dirs=False, encoding=None, access_mode='r+', **kwargs):
+        """
+        Create a new instance.
+
+        See :class:`FileStorage` for the file handling arguments.
+
+        :param path: Where to store the YAML data.
+        :param kwargs: Passed on to :func:`yaml.dump` when writing.
+        """
+
+        try:
+            self._yaml, self._loader, self._dumper = _make_yaml_classes()
+        except ImportError as e:
+            raise ImportError(
+                'YAMLStorage requires PyYAML: pip install tinydb[yaml]'
+            ) from e
+
+        super().__init__(path, create_dirs=create_dirs, encoding=encoding, access_mode=access_mode)
+
+        self.kwargs = kwargs
+
+    def read(self) -> Optional[dict[str, dict[str, Any]]]:
+        self._handle.seek(0)
+        content = self._handle.read()
+
+        if not content.strip():
+            return None
+
+        try:
+            data = self._yaml.load(content, Loader=self._loader)
+        except self._yaml.YAMLError as e:
+            # Do not return None here: the next write would wipe the file.
+            raise ValueError(f'Invalid YAML in {self._handle.name}: {e}') from e
+
+        if data is None:
+            return None
+
+        if not isinstance(data, dict):
+            raise ValueError(f'Invalid database in {self._handle.name}: expected a mapping')
+
+        # Doc IDs are strings, but a hand-edited ``1:`` loads as an int
+        for table in data.values():
+            if isinstance(table, dict):
+                for key in [k for k in table if not isinstance(k, str)]:
+                    new_key = str(key)
+                    if new_key in table:
+                        raise ValueError(
+                            f'Duplicate document ID {new_key!r} in {self._handle.name}'
+                        )
+                    table[new_key] = table.pop(key)
+
+        return data
+
+    def write(self, data: dict[str, dict[str, Any]]):
+        self._handle.seek(0)
+
+        kwargs = {'default_flow_style': False, 'allow_unicode': True, **self.kwargs}
+        serialized = self._yaml.dump(data, Dumper=self._dumper, **kwargs)
+
+        try:
+            self._handle.write(serialized)
+        except io.UnsupportedOperation:
+            raise IOError('Cannot write to the database. Access mode is "{0}"'.format(self._mode))
+
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+        self._handle.truncate()
+
