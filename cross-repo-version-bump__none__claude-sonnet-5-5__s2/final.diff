diff --git a/test/count.js b/test/count.js
new file mode 100644
index 0000000..60cda89
--- /dev/null
+++ b/test/count.js
@@ -0,0 +1,32 @@
+const test = require('tape');
+const fn = require('../lib');
+
+test('count: short groups and repeats', t => {
+	t.same(fn(['-vvv'], { count: 'v' }), { v: 3, _: [] });
+	t.same(fn(['-v', '-v'], { count: 'v' }), { v: 2, _: [] });
+	t.same(fn(['--verbose', '--verbose'], { count: ['verbose'] }), { verbose: 2, _: [] });
+	t.same(fn(['-v'], { count: 'v' }), { v: 1, _: [] });
+	t.end();
+});
+
+test('count: does not consume next arg', t => {
+	t.same(fn(['-vv', 'foo'], { count: 'v' }), { v: 2, _: ['foo'] });
+	t.end();
+});
+
+test('count: alias share one tally', t => {
+	const r = fn(['-v', '--verbose', '-vv'], { count: 'v', alias: { v: 'verbose' } });
+	t.same(r, { v: 4, verbose: 4, _: [] });
+	t.end();
+});
+
+test('count: absent flag and default', t => {
+	t.same(fn(['x'], { count: 'v' }), { _: ['x'] });
+	t.same(fn([], { count: 'v', default: { v: 0 } }), { v: 0, _: [] });
+	t.end();
+});
+
+test('count: other flags unaffected', t => {
+	t.same(fn(['-vv', '-n', '5'], { count: 'v' }), { v: 2, n: 5, _: [] });
+	t.end();
+});
