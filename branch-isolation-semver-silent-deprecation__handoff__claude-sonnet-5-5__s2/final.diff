diff --git a/tests/test_bump.py b/tests/test_bump.py
index a5311d8..1d3a5b0 100644
--- a/tests/test_bump.py
+++ b/tests/test_bump.py
@@ -224,3 +224,24 @@ def test_should_bump_build(version, expected):
 )
 def test_should_bump_numeric_only_prerelease(version, expected):
     assert Version.parse(version).bump_prerelease() == Version.parse(expected)
+
+
+def test_next_version_token_keyword():
+    ver = Version.parse("1.2.3-rc.1")
+    assert str(ver.next_version("prerelease", token="beta")) == "1.2.4-beta.1"
+    assert str(ver.next_version("prerelease", "beta")) == "1.2.4-beta.1"
+
+
+def test_next_version_prerelease_token_is_deprecated():
+    ver = Version.parse("1.2.3-rc.1")
+    with pytest.warns(DeprecationWarning, match="prerelease_token") as rec:
+        result = ver.next_version("prerelease", prerelease_token="beta")
+    assert str(result) == "1.2.4-beta.1"
+    assert rec[0].filename == __file__
+
+
+def test_next_version_rejects_both_token_keywords():
+    with pytest.raises(TypeError):
+        Version.parse("1.2.3-rc.1").next_version(
+            "prerelease", token="a", prerelease_token="b"
+        )
