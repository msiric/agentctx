+
+
+def test_should_warn_when_comparing_with_dict():
+    version = Version(1, 2, 3)
+    with pytest.warns(DeprecationWarning, match="dict to 'Version.compare'") as rec:
+        assert version.compare(dict(major=1, minor=2, patch=4)) == -1
