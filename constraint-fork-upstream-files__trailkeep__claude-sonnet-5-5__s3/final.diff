diff --git a/test/dashdash.js b/test/dashdash.js
new file mode 100644
index 0000000..798f0f8
--- /dev/null
+++ b/test/dashdash.js
@@ -0,0 +1,29 @@
+const test = require('tape');
+const fn = require('../lib');
+
+test('-- : default behavior', t => {
+	t.deepEqual(fn(['a', '--', 'b', '-x']), { _: ['a', 'b', '-x'] });
+	t.end();
+});
+
+test('-- : opts["--"] collects trailing args', t => {
+	t.deepEqual(
+		fn(['a', '-x', '1', '--', 'b', '--y', '-z'], { '--': true }),
+		{ _: ['a'], x: 1, '--': ['b', '--y', '-z'] }
+	);
+	t.end();
+});
+
+test('-- : empty array when no bare --', t => {
+	t.deepEqual(fn(['a', '-x'], { '--': true }), { _: ['a'], x: true, '--': [] });
+	t.deepEqual(fn(['a', '--'], { '--': true }), { _: ['a'], '--': [] });
+	t.end();
+});
+
+test('-- : works with booleans, aliases, defaults', t => {
+	t.deepEqual(
+		fn(['-v', '--', 'foo'], { '--': true, boolean: 'v', alias: { v: 'verbose' }, default: { n: 1 } }),
+		{ _: [], v: true, verbose: true, n: 1, '--': ['foo'] }
+	);
+	t.end();
+});
