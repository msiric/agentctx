+def test_yaml(tmpdir):
+    path = str(tmpdir.join('test.yaml'))
+    storage = YAMLStorage(path)
+    assert storage.read() is None
+
+    storage.write(doc)
+    assert doc == storage.read()
+    storage.close()
+
+
+def test_yaml_shrinking_file(tmpdir):
+    path = str(tmpdir.join('test.yaml'))
+    storage = YAMLStorage(path)
+    storage.write(doc)
+    storage.write({'a': 1})
+    assert storage.read() == {'a': 1}
+    storage.close()
+
+
+def test_yaml_kwargs(tmpdir):
+    db_file = tmpdir.join('test.yaml')
+    db = TinyDB(str(db_file), storage=YAMLStorage, default_flow_style=False,
+                sort_keys=True)
+    db.insert({'b': 1})
+    db.insert({'a': 1})
+    db.close()
+
+    assert db_file.read() == (
+        "_default:\n"
+        "  '1':\n"
+        "    b: 1\n"
+        "  '2':\n"
+        "    a: 1\n"
+    )
+
+
+def test_yaml_tinydb_roundtrip(tmpdir):
+    path = str(tmpdir.join('test.yaml'))
+
+    with TinyDB(path, storage=YAMLStorage) as db:
+        db.insert({'name': 'a', 'tags': ['x', 'y']})
+        db.table('other').insert({'n': 1})
+
+    with TinyDB(path, storage=YAMLStorage) as db:
+        assert db.search(where('name') == 'a') == [{'name': 'a', 'tags': ['x', 'y']}]
+        assert db.get(doc_id=1)['name'] == 'a'
+        assert db.table('other').all() == [{'n': 1}]
+
+
+def test_yaml_create_dirs(tmpdir):
+    path = str(tmpdir.join('a', 'b', 'test.yaml'))
+    with TinyDB(path, storage=YAMLStorage, create_dirs=True) as db:
+        db.insert({'x': 1})
+    assert os.path.exists(path)
+
+
+def test_yaml_readonly(tmpdir):
+    path = str(tmpdir.join('test.yaml'))
+    with open(path, 'w') as f:
+        f.write('{}\n')
+
+    storage = YAMLStorage(path, access_mode='r')
+    with pytest.raises(IOError):
+        storage.write(doc)
+    storage.close()
+
+
+def test_yaml_missing_dependency(tmpdir, monkeypatch):
+    import sys
+    monkeypatch.setitem(sys.modules, 'yaml', None)
+    with pytest.raises(ImportError, match='PyYAML'):
+        YAMLStorage(str(tmpdir.join('test.yaml')))
