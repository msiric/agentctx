+class YAMLStorage(_FileStorage):
+    """
+    Store the data in a YAML file.
+
+    Requires the optional `PyYAML <https://pypi.org/project/PyYAML/>`_
+    package. Data is read with ``yaml.safe_load`` and written with
+    ``yaml.safe_dump``, so only plain YAML types are supported.
+    """
+
+    def __init__(self, path: str, create_dirs=False, encoding=None, access_mode='r+', **kwargs):
+        """
+        Create a new instance.
+
+        Also creates the storage file, if it doesn't exist and the access mode
+        is appropriate for writing.
+
+        :param path: Where to store the YAML data.
+        :param access_mode: mode in which the file is opened (r, r+)
+        :param kwargs: Extra arguments passed to ``yaml.safe_dump``.
+        """
+
+        try:
+            import yaml  # noqa: F401
+        except ImportError as e:
+            raise ImportError(
+                'YAMLStorage requires PyYAML. Install it with `pip install pyyaml`.'
+            ) from e
+
+        super().__init__(path, create_dirs, encoding, access_mode, **kwargs)
+
+    def read(self) -> Optional[dict[str, dict[str, Any]]]:
+        import yaml
+
+        self._handle.seek(0, os.SEEK_END)
+        if not self._handle.tell():
+            # Empty file: let TinyDB initialize the database
+            return None
+
+        self._handle.seek(0)
+        return yaml.safe_load(self._handle)
+
+    def write(self, data: dict[str, dict[str, Any]]):
+        import yaml
+
+        self._handle.seek(0)
+
+        # Serialize first so a failure doesn't leave a half-written file
+        serialized = yaml.safe_dump(data, **self.kwargs)
+
+        try:
+            self._handle.write(serialized)
+        except io.UnsupportedOperation:
+            raise IOError('Cannot write to the database. Access mode is "{0}"'.format(self._mode))
+
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+        self._handle.truncate()
+
+
