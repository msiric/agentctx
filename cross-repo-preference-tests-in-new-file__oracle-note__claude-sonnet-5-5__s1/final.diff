index 0000000..eba6733
--- /dev/null
+++ b/keys.test.js
@@ -0,0 +1,46 @@
+/* eslint-disable camelcase -- Expected decamelized keys. */
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import {decamelizeKeys} from './index.js';
+
+test('decamelizeKeys', () => {
+	assert.deepEqual(decamelizeKeys({}), {});
+	assert.deepEqual(decamelizeKeys({fooBar: 1, bazQux: 'a'}), {foo_bar: 1, baz_qux: 'a'});
+});
+
+test('decamelizeKeys is shallow and leaves values untouched', () => {
+	const nested = {innerKey: 1};
+	const result = decamelizeKeys({outerKey: nested});
+	assert.deepEqual(result, {outer_key: nested});
+	assert.equal(result.outer_key, nested);
+});
+
+test('decamelizeKeys passes options through', () => {
+	assert.deepEqual(decamelizeKeys({fooBar: 1}, {separator: '-'}), {'foo-bar': 1});
+	assert.deepEqual(decamelizeKeys({testGUILabel: 1}, {preserveConsecutiveUppercase: true}), {test_GUI_label: 1});
+});
+
+test('decamelizeKeys returns a new object and ignores symbol keys', () => {
+	const symbol = Symbol('x');
+	const input = {ownKey: 2, [symbol]: 3};
+	const result = decamelizeKeys(input);
+	assert.deepEqual(result, {own_key: 2});
+	assert.notEqual(result, input);
+	assert.equal(input.ownKey, 2);
+});
+
+test('decamelizeKeys handles null-prototype objects and `__proto__` keys', () => {
+	const input = Object.create(null);
+	input.fooBar = 1;
+	assert.deepEqual(decamelizeKeys(input), {foo_bar: 1});
+
+	const result = decamelizeKeys(JSON.parse('{"__proto__": {"polluted": true}}'));
+	assert.equal(Object.getPrototypeOf(result), Object.prototype);
+	assert.equal(result.polluted, undefined);
+});
+
+test('decamelizeKeys throws for non-plain objects', () => {
+	for (const value of [null, undefined, 'a', 1, [], new Map(), new Date(), Object.create({inheritedKey: 1})]) {
+		assert.throws(() => decamelizeKeys(value), {name: 'TypeError'});
+	}
+});
