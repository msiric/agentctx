 export default function decamelize(string: string, options?: Options): string;
+
+/**
+Decamelize each own key of a plain object. The operation is shallow and values are left untouched.
+
+@param object - The plain object whose keys to decamelize.
+@param options - Options passed through to `decamelize`.
+
+@example
+```
+import {decamelizeKeys} from 'decamelize';
+
+decamelizeKeys({unicornRainbow: 1, fooBar: {bazQux: 2}});
+//=> {unicorn_rainbow: 1, foo_bar: {bazQux: 2}}
+
+decamelizeKeys({unicornRainbow: 1}, {separator: '-'});
+//=> {'unicorn-rainbow': 1}
+```
+*/
+export function decamelizeKeys<Value>(object: Record<string, Value>, options?: Options): Record<string, Value>;
