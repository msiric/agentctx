+test('onRetry runs only when another attempt follows, after the other callbacks', async () => {
+	const order = [];
+	let attempts = 0;
+
+	await assert.rejects(pRetry(async () => {
+		attempts++;
+		throw new Error('fail');
+	}, {
+		retries: 2,
+		minTimeout: 0,
+		shouldConsumeRetry() {
+			order.push('shouldConsumeRetry');
+		},
+		onFailedAttempt() {
+			order.push('onFailedAttempt');
+		},
+		shouldRetry() {
+			order.push('shouldRetry');
+			return true;
+		},
+		async onRetry(context) {
+			await delay(1);
+			order.push(`onRetry${context.attemptNumber}`);
+			assert.ok(Object.isFrozen(context));
+			assert.equal(context.error.message, 'fail');
+		},
+	}), {message: 'fail'});
+
+	assert.equal(attempts, 3);
+	assert.deepEqual(order, [
+		'shouldConsumeRetry',
+		'onFailedAttempt',
+		'shouldRetry',
+		'onRetry1',
+		'shouldConsumeRetry',
+		'onFailedAttempt',
+		'shouldRetry',
+		'onRetry2',
+		'shouldConsumeRetry',
+		'onFailedAttempt',
+	]);
+});
+
+test('onRetry is not called when no retry follows', async () => {
+	let calls = 0;
+	const onRetry = () => {
+		calls++;
+	};
+
+	await assert.rejects(pRetry(async () => {
+		throw new Error('x');
+	}, {retries: 0, onRetry}), {message: 'x'});
+	await assert.rejects(pRetry(async () => {
+		throw new Error('x');
+	}, {onRetry, shouldRetry: () => false}), {message: 'x'});
+	await assert.rejects(pRetry(async () => {
+		throw new TypeError('nope');
+	}, {onRetry}), {message: 'nope'});
+	await assert.rejects(pRetry(async () => {
+		throw new AbortError('stop');
+	}, {onRetry}), {message: 'stop'});
+
+	assert.equal(calls, 0);
+});
+
+test('onRetry is called when shouldConsumeRetry returns false', async () => {
