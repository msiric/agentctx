+def test_yaml(tmpdir):
+    path = str(tmpdir.join('test.yaml'))
+    storage = YAMLStorage(path)
+    assert storage.read() is None
+
+    storage.write(doc)
+    assert doc == storage.read()
+    storage.close()
+
+
+def test_yaml_shrinking_write(tmpdir):
+    path = str(tmpdir.join('test.yaml'))
+    storage = YAMLStorage(path)
+    storage.write(doc)
+    storage.write({'a': 1})
+    assert storage.read() == {'a': 1}
+    storage.close()
+
+    with open(path) as f:
+        assert yaml.safe_load(f) == {'a': 1}
+
+
+def test_yaml_tinydb(tmpdir):
+    path = str(tmpdir.join('test.yaml'))
+
+    with TinyDB(path, storage=YAMLStorage) as db:
+        db.insert({'a': 1})
+        db.table('t').insert({'b': 2})
+
+    with TinyDB(path, storage=YAMLStorage) as db:
+        assert db.all() == [{'a': 1}]
+        assert db.table('t').all() == [{'b': 2}]
+        assert db.search(where('a') == 1)
+
+
+def test_yaml_kwargs(tmpdir):
+    path = tmpdir.join('test.yaml')
+    with TinyDB(str(path), storage=YAMLStorage, default_flow_style=False,
+                sort_keys=False) as db:
+        db.insert({'b': 1, 'a': 2})
+
+    assert path.read().index('b:') < path.read().index('a:')
+
+
+def test_yaml_readonly(tmpdir):
+    path = str(tmpdir.join('test.yaml'))
+    YAMLStorage(path).close()
+
+    storage = YAMLStorage(path, access_mode='r')
+    with pytest.raises(IOError):
+        storage.write(doc)
+    storage.close()
+
+
+def test_yaml_create_dirs(tmpdir):
+    path = str(tmpdir.join('a', 'b', 'test.yaml'))
+    YAMLStorage(path, create_dirs=True).close()
+    assert os.path.exists(path)
