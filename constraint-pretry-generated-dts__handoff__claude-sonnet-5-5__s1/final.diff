+test('onRetry runs only when another attempt follows, after the other callbacks', async () => {
+	const order = [];
+	let calls = 0;
+
+	await assert.rejects(pRetry(async () => {
+		calls++;
+		throw new Error('fail');
+	}, {
+		retries: 2,
+		minTimeout: 0,
+		shouldConsumeRetry() {
+			order.push('shouldConsumeRetry');
+		},
+		onFailedAttempt() {
+			order.push('onFailedAttempt');
+		},
+		shouldRetry() {
+			order.push('shouldRetry');
+			return true;
+		},
+		async onRetry({attemptNumber, retriesLeft}) {
+			order.push(`onRetry:${attemptNumber}:${retriesLeft}`);
+		},
+	}), {message: 'fail'});
+
+	assert.equal(calls, 3);
+	assert.deepEqual(order.filter(item => item.startsWith('onRetry')), ['onRetry:1:2', 'onRetry:2:1']);
+	assert.deepEqual(order.slice(0, 4), ['shouldConsumeRetry', 'onFailedAttempt', 'shouldRetry', 'onRetry:1:2']);
+});
+
+test('onRetry gets the frozen context shared with onFailedAttempt', async () => {
+	let failedContext;
+	let retryContext;
+
+	await assert.rejects(pRetry(async () => {
+		throw new Error('fail');
+	}, {
+		retries: 1,
+		minTimeout: 0,
+		onFailedAttempt(context) {
+			failedContext ??= context;
+		},
+		onRetry(context) {
+			retryContext = context;
+		},
+	}), {message: 'fail'});
+
+	assert.equal(retryContext, failedContext);
+	assert.ok(Object.isFrozen(retryContext));
+});
+
