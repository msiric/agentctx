@@ -235,3 +235,26 @@ def test_cli_outfile_keeps_file_on_format_error(tmpdir, capsys):
     assert out_file.read() == "select 1"
     _, err = capsys.readouterr()
     assert err.startswith("[ERROR] Failed to format")
+
+
+def test_cli_check(tmpdir, capsys):
+    good = tmpdir.join('good.sql')
+    good.write('select 1')
+    bad = tmpdir.join('bad.sql')
+    bad.write('select 1')
+    args = ['--check', '-k', 'upper']
+    good.write('SELECT 1')
+    assert sqlparse.cli.main(args + [str(good)]) == 0
+    assert capsys.readouterr().out == ''
+    assert sqlparse.cli.main(args + [str(good), str(bad)]) == 1
+    assert capsys.readouterr().out == f'{bad}\n'
+    assert bad.read() == 'select 1'  # nothing written
+
+
+def test_cli_check_incompatible_options(tmpdir, capsys):
+    f = tmpdir.join('a.sql')
+    f.write('select 1')
+    assert sqlparse.cli.main(['--check', '--in-place', str(f)]) == 1
+    assert sqlparse.cli.main(['--check', '-o', str(tmpdir.join('o')),
+                              str(f)]) == 1
+    assert 'Cannot use --check' in capsys.readouterr().err
