+
+    @property
+    def _journal_path(self) -> str:
+        return self._path + '.journal'
+
+    def _write_journal(self, serialized: str) -> None:
+        # Journal format: sha256 hex digest of the payload, newline, payload.
+        # A journal with a matching digest is a complete copy of the new state.
+        # It is a separate file, so no rename of the database file is needed
+        # (renaming fails if the database file is a bind-mounted single file).
+        digest = hashlib.sha256(serialized.encode('utf-8')).hexdigest()
+        with open(self._journal_path, 'w', encoding='utf-8') as journal:
+            journal.write(digest + '\n' + serialized)
+            journal.flush()
+            os.fsync(journal.fileno())
+
+    def _remove_journal(self) -> None:
+        try:
+            os.remove(self._journal_path)
+        except FileNotFoundError:
+            pass
+
+    def _recover(self) -> None:
+        try:
+            with open(self._journal_path, 'r', encoding='utf-8') as journal:
+                content = journal.read()
+        except FileNotFoundError:
+            return
+
+        digest, _, payload = content.partition('\n')
+        valid = (
+            len(digest) == 64
+            and hashlib.sha256(payload.encode('utf-8')).hexdigest() == digest
+        )
+        if valid:
+            # The crash happened while (or after) the database file was
+            # being overwritten: re-apply the complete new state.
+            self._write_in_place(payload)
+        # Otherwise the crash happened while the journal itself was being
+        # written, which means the database file is still untouched.
+        self._remove_journal()
+
+    def _write_in_place(self, serialized: str) -> None:
+        self._handle.seek(0)
+        try:
+            self._handle.write(serialized)
+        except io.UnsupportedOperation:
+            raise IOError('Cannot write to the database. Access mode is "{0}"'.format(self._mode))
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+        # Remove data that is behind the new cursor in case the file has
+        # gotten shorter
+        self._handle.truncate()
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+
     def close(self) -> None:
         self._handle.close()
 
