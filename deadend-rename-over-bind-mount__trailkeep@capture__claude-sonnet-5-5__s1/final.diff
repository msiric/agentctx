--- a/tests/test_storages.py
+++ b/tests/test_storages.py
@@ -285,3 +285,78 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def _crash_write(path, data, crash_at, monkeypatch):
+    """Run a JSONStorage.write that dies (raises) at the given step."""
+    storage = JSONStorage(path)
+
+    class Crash(BaseException):
+        pass
+
+    def boom(*a, **k):
+        raise Crash()
+
+    if crash_at == 'after_journal':
+        monkeypatch.setattr(storage, '_write_in_place', boom)
+    elif crash_at == 'mid_db_write':
+        real = storage._write_in_place
+
+        def partial(serialized):
+            storage._handle.seek(0)
+            storage._handle.write(serialized[:len(serialized) // 2])
+            storage._handle.flush()
+            raise Crash()
+        monkeypatch.setattr(storage, '_write_in_place', partial)
+    elif crash_at == 'torn_journal':
+        def torn(serialized):
+            with open(storage._journal_path, 'w') as f:
+                f.write('abc\n' + serialized[:5])
+            raise Crash()
+        monkeypatch.setattr(storage, '_write_journal', torn)
+    try:
+        storage.write(data)
+    except Crash:
+        pass
+    # Simulate process death: no close(), no cleanup
+
+
+@pytest.mark.parametrize('crash_at', ['torn_journal', 'after_journal', 'mid_db_write'])
+def test_json_crash_safe_write(tmpdir, monkeypatch, crash_at):
+    path = str(tmpdir.join('db.json'))
+
+    db = TinyDB(path)
+    db.insert({'old': 1})
+    db.close()
+
+    new = {'_default': {'1': {'new': 2}, '2': {'new': 3}}}
+    _crash_write(path, new, crash_at, monkeypatch)
+    monkeypatch.undo()
+
+    db = TinyDB(path)  # must open and be readable
+    try:
+        docs = db.all()
+        assert docs in ([{'old': 1}], [{'new': 2}, {'new': 3}])
+        if crash_at == 'torn_journal':
+            assert docs == [{'old': 1}]
+        else:
+            assert docs == [{'new': 2}, {'new': 3}]
+    finally:
+        db.close()
+    assert not os.path.exists(path + '.journal')
+
+
+def test_json_write_does_not_replace_file(tmpdir, monkeypatch):
+    # Prod bind-mounts db.json as a single file, so rename/replace must
+    # never be used on it.
+    def no_rename(*a, **k):
+        raise OSError(16, 'Device or resource busy')
+    monkeypatch.setattr(os, 'replace', no_rename)
+    monkeypatch.setattr(os, 'rename', no_rename)
+
+    path = str(tmpdir.join('db.json'))
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+    with TinyDB(path) as db:
+        assert db.all() == [{'a': 1}]
+    assert not os.path.exists(path + '.journal')
