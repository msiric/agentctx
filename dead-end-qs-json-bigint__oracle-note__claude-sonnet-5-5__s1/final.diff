+test('parse `json` type', () => {
+	const parse = (query, key = 'filter') => queryString.parse(query, {types: {[key]: 'json'}})[key];
+	assert.deepEqual(parse('filter=%7B%22a%22%3A%5B1%2Ctrue%2Cnull%5D%7D'), {a: [1, true, null]});
+	assert.equal(parse('filter=5'), 5);
+	assert.equal(parse('filter=%22x%22'), 'x');
+	// Invalid JSON stays a string.
+	assert.equal(parse('filter=%7B'), '{');
+	assert.equal(parse('filter=abc'), 'abc');
+	assert.equal(parse('filter='), '');
+	assert.equal(parse('filter'), null);
+	// Integers beyond the safe range are exact.
+	assert.deepEqual(parse('filter=%7B%22accountId%22%3A1274593846275813376%7D'), {accountId: 1_274_593_846_275_813_376n});
+	assert.equal(parse('filter=-1274593846275813376'), -1_274_593_846_275_813_376n);
+	assert.deepEqual(parse('filter=%5B9007199254740991%2C9007199254740993%5D'), [9_007_199_254_740_991, 9_007_199_254_740_993n]);
+	assert.equal(parse('filter=1.5'), 1.5);
+	// Takes precedence over `parseNumbers` and `parseBooleans`.
+	assert.equal(queryString.parse('filter=abc&n=1', {parseNumbers: true, types: {filter: 'json'}}).filter, 'abc');
