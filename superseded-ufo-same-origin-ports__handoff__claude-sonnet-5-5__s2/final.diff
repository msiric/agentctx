 const TRAILING_SLASH_RE = /\/$|\/\?|\/#/;
 const JOIN_LEADING_SLASH_RE = /^\.?\//;
+const JOIN_SUFFIX_RE = /[#?]/;
 
 /**
  * Check if a path starts with `./` or `../`.
