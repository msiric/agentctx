diff --git a/test/same-origin.test.ts b/test/same-origin.test.ts
new file mode 100644
index 0000000..7a48deb
--- /dev/null
+++ b/test/same-origin.test.ts
@@ -0,0 +1,105 @@
+import { describe, expect, test } from "vitest";
+import { isSameOrigin } from "../src";
+
+describe("isSameOrigin", () => {
+  const sameOrigins = [
+    // Identical
+    ["https://example.com", "https://example.com"],
+    // Path, query and hash are ignored
+    ["https://example.com/foo", "https://example.com/bar"],
+    ["https://example.com/?a=1", "https://example.com/?b=2"],
+    ["https://example.com/#a", "https://example.com/#b"],
+    // Credentials are ignored
+    ["https://john:doe@example.com", "https://example.com"],
+    // Hostname is case-insensitive
+    ["https://EXAMPLE.com", "https://example.com"],
+    // Protocol is case-insensitive
+    ["HTTPS://example.com", "https://example.com"],
+    // Default ports are normalized
+    ["https://example.com:443", "https://example.com"],
+    ["http://example.com:80", "http://example.com"],
+    // Explicit ports compare equal when identical
+    ["https://example.com:443", "https://example.com:443/foo"],
+    ["http://example.com:8080", "http://example.com:8080/foo"],
+    // Trailing dot is NOT stripped (see notSameOrigins), but IDN/punycode is equal
+    ["https://тест.com", "https://xn--e1aybc.com"],
+    // IPv6
+    ["http://[::1]:3000/a", "http://[::1]:3000/b"],
+  ];
+
+  const notSameOrigins = [
+    // Protocol
+    ["http://example.com", "https://example.com"],
+    // Host
+    ["https://example.com", "https://example.org"],
+    ["https://example.com", "https://www.example.com"],
+    ["https://example.com", "https://example.com."],
+    // Port
+    ["https://example.com:8080", "https://example.com"],
+    ["https://example.com:8080", "https://example.com:8081"],
+    // 443 is not the default port of http
+    ["http://example.com:443", "http://example.com"],
+    // Look-alike hosts via userinfo
+    ["https://example.com@evil.com", "https://example.com"],
+    // Different IPv6 hosts
+    ["http://[::1]", "http://[::2]"],
+  ];
+
+  for (const [a, b] of sameOrigins) {
+    test(`${a} == ${b}`, () => {
+      expect(isSameOrigin(a, b)).toBe(true);
+      expect(isSameOrigin(b, a)).toBe(true);
+    });
+  }
+
+  for (const [a, b] of notSameOrigins) {
+    test(`${a} != ${b}`, () => {
+      expect(isSameOrigin(a, b)).toBe(false);
+      expect(isSameOrigin(b, a)).toBe(false);
+    });
+  }
+
+  describe("relative and protocol-less inputs", () => {
+    test("two relative paths have no origin and are not same-origin", () => {
+      expect(isSameOrigin("/foo", "/bar")).toBe(false);
+      expect(isSameOrigin("/foo", "/foo")).toBe(false);
+    });
+
+    test("relative vs absolute is not same-origin", () => {
+      expect(isSameOrigin("/foo", "https://example.com/foo")).toBe(false);
+      expect(isSameOrigin("https://example.com/foo", "/foo")).toBe(false);
+    });
+
+    test("protocol-relative URLs need a protocol to compare", () => {
+      expect(isSameOrigin("//example.com", "//example.com")).toBe(false);
+      expect(isSameOrigin("//example.com", "https://example.com")).toBe(false);
+    });
+  });
+
+  describe("opaque origins", () => {
+    test("non-hierarchical schemes are never same-origin", () => {
+      expect(isSameOrigin("data:text/plain,a", "data:text/plain,a")).toBe(
+        false,
+      );
+      expect(isSameOrigin("javascript:void(0)", "javascript:void(0)")).toBe(
+        false,
+      );
+      expect(isSameOrigin("mailto:a@example.com", "mailto:a@example.com")).toBe(
+        false,
+      );
+    });
+  });
+
+  describe("invalid input", () => {
+    test("empty or missing values are not same-origin", () => {
+      expect(isSameOrigin("", "")).toBe(false);
+      expect(isSameOrigin("", "https://example.com")).toBe(false);
+      expect(isSameOrigin(undefined as any, undefined as any)).toBe(false);
+    });
+
+    test("does not throw on malformed URLs", () => {
+      expect(() => isSameOrigin("http://", "http://")).not.toThrow();
+      expect(isSameOrigin("http://", "http://")).toBe(false);
+    });
+  });
+});
