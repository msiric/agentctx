diff --git a/test/same-origin.test.ts b/test/same-origin.test.ts
new file mode 100644
index 0000000..04b365d
--- /dev/null
+++ b/test/same-origin.test.ts
@@ -0,0 +1,206 @@
+import { describe, expect, test } from "vitest";
+import { isSameOrigin } from "../src";
+
+// Proposed semantics: two inputs are same-origin when both are absolute URLs
+// with a tuple-origin (scheme, host, port) that matches, loosely following the
+// WHATWG URL "origin" definition, with default ports normalized
+// (https://a.com == https://a.com:443; non-default ports still differ). Anything without a meaningful origin is never
+// same-origin (not even with itself), mirroring opaque origins on the web.
+
+describe("isSameOrigin", () => {
+  describe("same origin", () => {
+    const same = [
+      // Identical
+      ["https://example.com", "https://example.com"],
+      ["http://example.com", "http://example.com"],
+
+      // Path, query and fragment are ignored
+      ["https://example.com", "https://example.com/"],
+      ["https://example.com/foo", "https://example.com/bar"],
+      ["https://example.com/foo?a=1", "https://example.com/bar?b=2"],
+      ["https://example.com/#a", "https://example.com/#b"],
+
+      // Scheme and host are case-insensitive
+      ["HTTPS://example.com", "https://example.com"],
+      ["https://EXAMPLE.com", "https://example.com"],
+
+      // Default ports are equivalent to omitted ones
+      ["https://example.com", "https://example.com:443"],
+      ["http://example.com", "http://example.com:80"],
+      ["https://example.com:443/foo", "https://example.com/bar"],
+      ["ws://example.com", "ws://example.com:80"],
+      ["wss://example.com", "wss://example.com:443"],
+      ["ftp://example.com", "ftp://example.com:21"],
+
+      // Non-default ports must match
+      ["https://example.com:443", "https://example.com:443/foo"],
+      ["https://example.com:8080", "https://example.com:8080/foo"],
+      ["http://localhost:3000", "http://localhost:3000/api"],
+
+      // Userinfo is not part of the origin
+      ["https://user:pass@example.com", "https://example.com"],
+      ["https://a@example.com", "https://b@example.com"],
+
+      // Unicode and punycode forms of the same IDN host are equal
+      ["https://münchen.de", "https://xn--mnchen-3ya.de"],
+
+      // IPs and IPv6
+      ["http://127.0.0.1:3000", "http://127.0.0.1:3000/foo"],
+      ["http://[::1]:3000", "http://[::1]:3000/foo"],
+
+      // Other tuple-origin schemes
+      ["ws://example.com", "ws://example.com/chat"],
+      ["wss://example.com:8443", "wss://example.com:8443/chat"],
+      ["ftp://example.com", "ftp://example.com/pub"],
+    ];
+
+    for (const [a, b] of same) {
+      test(`${a} == ${b}`, () => {
+        expect(isSameOrigin(a, b)).toBe(true);
+        // Must be symmetric
+        expect(isSameOrigin(b, a)).toBe(true);
+      });
+    }
+  });
+
+  describe("different origin", () => {
+    const different = [
+      // Scheme
+      ["http://example.com", "https://example.com"],
+      ["ws://example.com", "wss://example.com"],
+
+      // Host
+      ["https://example.com", "https://example.org"],
+      ["https://example.com", "https://www.example.com"],
+      ["https://example.com", "https://sub.example.com"],
+      ["https://example.com", "https://example.com.evil.com"],
+      ["https://example.com", "https://notexample.com"],
+
+      // Port
+      ["https://example.com", "https://example.com:8443"],
+      ["https://example.com:3000", "https://example.com:3001"],
+      // Default port of a different scheme
+      ["https://example.com", "https://example.com:80"],
+      ["http://example.com", "http://example.com:443"],
+
+      // Userinfo tricks must not confuse the host
+      ["https://example.com", "https://example.com@evil.com"],
+      ["https://example.com@evil.com", "https://example.com"],
+      ["https://example.com:443@evil.com", "https://example.com"],
+
+      // Backslash is treated as a path separator by browsers for special schemes
+      ["https://example.com", "https://evil.com\\@example.com"],
+
+      // Trailing dot is a distinct host (matches browser origin behavior)
+      ["https://example.com", "https://example.com."],
+
+      // localhost vs loopback IPs are different hosts
+      ["http://localhost", "http://127.0.0.1"],
+      ["http://127.0.0.1", "http://[::1]"],
+    ];
+
+    for (const [a, b] of different) {
+      test(`${a} != ${b}`, () => {
+        expect(isSameOrigin(a, b)).toBe(false);
+        expect(isSameOrigin(b, a)).toBe(false);
+      });
+    }
+  });
+
+  describe("inputs without an origin are never same-origin", () => {
+    const noOrigin = [
+      // Relative / path-only (no origin to compare)
+      ["/foo", "/foo"],
+      ["foo", "foo"],
+      ["./foo", "./foo"],
+      ["../foo", "../foo"],
+      ["", ""],
+      ["?a=1", "?a=1"],
+      ["#hash", "#hash"],
+
+      // Relative vs absolute
+      ["/foo", "https://example.com/foo"],
+      ["https://example.com/foo", "/foo"],
+      ["", "https://example.com"],
+
+      // Protocol-relative has no scheme, so the origin is unknown
+      ["//example.com", "//example.com"],
+      ["//example.com", "https://example.com"],
+      ["https://example.com", "//example.com"],
+
+      // Opaque origins: each is unique, even when textually identical
+      ["data:text/plain,hello", "data:text/plain,hello"],
+      ["javascript:alert(1)", "javascript:alert(1)"],
+      // OPEN QUESTION: browsers give blob: URLs the origin of the embedded URL
+      ["blob:https://example.com/uuid", "blob:https://example.com/uuid"],
+      ["vbscript:foo", "vbscript:foo"],
+      ["about:blank", "about:blank"],
+      ["data:text/plain,hello", "https://example.com"],
+
+      // file: has an opaque origin per spec
+      ["file:///home/user/a.txt", "file:///home/user/a.txt"],
+      ["file:///a", "file:///b"],
+
+      // Missing host
+      ["https://", "https://"],
+    ];
+
+    for (const [a, b] of noOrigin) {
+      test(`${JSON.stringify(a)} !== ${JSON.stringify(b)}`, () => {
+        expect(isSameOrigin(a, b)).toBe(false);
+        expect(isSameOrigin(b, a)).toBe(false);
+      });
+    }
+  });
+
+  describe("leading whitespace and control characters", () => {
+    // Browsers strip leading/trailing C0 control chars and spaces, tabs and
+    // newlines are removed from anywhere in the URL.
+    test("trims surrounding whitespace", () => {
+      expect(isSameOrigin("  https://example.com", "https://example.com")).toBe(
+        true,
+      );
+      expect(isSameOrigin("https://example.com  ", "https://example.com")).toBe(
+        true,
+      );
+    });
+
+    test("strips embedded tab and newline", () => {
+      expect(isSameOrigin("https://exa\tmple.com", "https://example.com")).toBe(
+        true,
+      );
+      expect(isSameOrigin("https://example\n.com", "https://example.com")).toBe(
+        true,
+      );
+    });
+  });
+
+  describe("non-string input", () => {
+    test("returns false instead of throwing", () => {
+      // @ts-expect-error invalid input
+      expect(isSameOrigin(undefined, "https://example.com")).toBe(false);
+      // @ts-expect-error invalid input
+      expect(isSameOrigin("https://example.com", null)).toBe(false);
+      // @ts-expect-error invalid input
+      expect(isSameOrigin(undefined, undefined)).toBe(false);
+    });
+  });
+
+  describe("agreement with the platform URL implementation", () => {
+    // For well-formed absolute http(s) URLs the result must agree with
+    // `new URL(a).origin === new URL(b).origin`.
+    const pairs = [
+      ["https://example.com", "https://example.com/x"],
+      ["http://example.com:8080", "http://EXAMPLE.com:8080"],
+      ["https://example.com", "http://example.com"],
+      ["https://a.example.com", "https://b.example.com"],
+      ["https://user@example.com:8080/a?b#c", "https://example.com:8080"],
+    ];
+
+    for (const [a, b] of pairs) {
+      test(`${a} vs ${b}`, () => {
+        expect(isSameOrigin(a, b)).toBe(new URL(a).origin === new URL(b).origin);
+      });
+    }
+  });
+});
