+
+const TUPLE_ORIGIN_PROTOCOLS = new Set([
+  "http:",
+  "https:",
+  "ws:",
+  "wss:",
+  "ftp:",
+]);
+
+function getTupleOrigin(input: unknown): string | undefined {
+  if (typeof input !== "string") {
+    return undefined;
+  }
+  try {
+    // Absolute URLs only (throws for relative / protocol-relative inputs).
+    // Default ports are normalized: `https://a.com` == `https://a.com:443`.
+    const url = new URL(input);
+    if (TUPLE_ORIGIN_PROTOCOLS.has(url.protocol) && url.hostname) {
+      return url.origin;
+    }
+  } catch {
+    // Invalid URL
+  }
+}
+
+/**
+ * Checks if two URLs have the same origin (scheme, host and port).
+ *
+ * Default ports are equivalent to omitted ones (`https://a.com` and
+ * `https://a.com:443`), non-default ports differ. Inputs without a tuple
+ * origin (relative, protocol-relative, `data:`, `file:`, `blob:`, invalid...)
+ * are never same-origin.
+ *
+ * @example
+ * ```ts
+ * isSameOrigin("https://a.com/x", "https://a.com:443/y"); // true
+ * isSameOrigin("https://a.com", "https://a.com:8443"); // false
+ * ```
+ *
+ * @group utils
+ */
+export function isSameOrigin(a: string, b: string): boolean {
+  const originA = getTupleOrigin(a);
+  return originA !== undefined && originA === getTupleOrigin(b);
+}
