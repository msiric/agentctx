+def _key_order(key: Any):
+    # Numbers (and numeric strings, so document IDs keep their insertion
+    # order, e.g. "2" before "10") come first, then other keys as strings.
+    # ``json.dumps(sort_keys=True)`` can't do this: it raises ``TypeError``
+    # on mixed int/str keys.
+    if isinstance(key, (int, float)) and not isinstance(key, bool):
+        return 0, key, ''
+    if isinstance(key, str) and key.isascii() and key.isdecimal():
+        return 0, int(key), key
+    return 1, 0, str(key)
+
+
+def _sort_keys(obj: Any) -> Any:
+    if isinstance(obj, dict):
+        return {k: _sort_keys(obj[k]) for k in sorted(obj, key=_key_order)}
+    if isinstance(obj, (list, tuple)):
+        return [_sort_keys(v) for v in obj]
+    return obj
+
+
