+def test_json_sort_keys_default(tmpdir):
+    path = str(tmpdir.join('test.db'))
+    with TinyDB(path) as db:
+        db.insert({'b': 1, 'a': {'z': 1, 'y': 2}})
+    assert open(path).read() == (
+        '{"_default": {"1": {"a": {"y": 2, "z": 1}, "b": 1}}}'
+    )
+
+
+def test_json_sort_keys_disabled(tmpdir):
+    path = str(tmpdir.join('test.db'))
+    with TinyDB(path, sort_keys=False) as db:
+        db.insert({'b': 1, 'a': 2})
+    assert open(path).read() == '{"_default": {"1": {"b": 1, "a": 2}}}'
+
+
+def test_json_sort_keys_mixed_types(tmpdir):
+    path = str(tmpdir.join('test.db'))
+    with TinyDB(path) as db:
+        db.insert({'hits': {'other': 1, 200: 2, 3: 3}})
+    with TinyDB(path) as db:
+        assert db.all() == [{'hits': {'3': 3, '200': 2, 'other': 1}}]
+        assert list(db.all()[0]['hits']) == ['3', '200', 'other']
+
+
+def test_json_sort_keys_keeps_doc_order(tmpdir):
+    path = str(tmpdir.join('test.db'))
+    with TinyDB(path) as db:
+        db.insert_multiple([{'n': i} for i in range(12)])
+    with TinyDB(path) as db:
+        assert [d['n'] for d in db.all()] == list(range(12))
+
