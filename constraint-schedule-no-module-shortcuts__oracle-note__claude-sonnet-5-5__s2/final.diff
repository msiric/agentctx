+    def test_get_jobs_for(self):
+        def foo(x=None):
+            pass
+
+        def bar():
+            pass
+
+        j1 = every().second.do(foo)
+        j2 = every().minute.do(foo, x=1)
+        j3 = every().second.do(bar)
+
+        assert schedule.default_scheduler.get_jobs_for(foo) == [j1, j2]
+        assert schedule.default_scheduler.get_jobs_for(lambda: None) == []
+
+        for job in schedule.default_scheduler.get_jobs_for(foo):
+            schedule.cancel_job(job)
+        assert schedule.jobs == [j3]
+
+    def test_get_jobs_for_unscheduled_job(self):
+        def foo():
+            pass
+
+        every().second  # no .do() yet, so not in the scheduler
+        assert schedule.default_scheduler.get_jobs_for(foo) == []
+
+    def test_pause_and_resume(self):
+        calls = []
+        s = schedule.Scheduler()
+        a = s.every().second.do(lambda: calls.append("a")).tag("maint")
+        b = s.every().second.do(lambda: calls.append("b"))
+        c = s.every().second.do(lambda: calls.append("c")).tag("maint", "x")
+
+        with mock_datetime(2100, 1, 1, 0, 0, 0):
+            for job in (a, b, c):
+                job._schedule_next_run()
+        s.pause("maint")
+        assert a.paused and c.paused and not b.paused
+
+        with mock_datetime(2100, 1, 1, 0, 0, 5):
+            s.run_pending()
+            assert calls == ["b"]
+            # Jobs stay scheduled while paused
+            assert len(s.jobs) == 3
+
+            s.resume("maint")
+            assert not a.paused and not c.paused
+            # Stale next_run was rescheduled, so no catch-up run
+            assert a.next_run > datetime.datetime(2100, 1, 1, 0, 0, 5)
+            s.run_pending()
+            assert calls == ["b"]
+
+        with mock_datetime(2100, 1, 1, 0, 0, 7):
+            s.run_pending()
+            assert sorted(calls) == ["a", "b", "b", "c"]
+
+    def test_pause_unknown_tag(self):
+        s = schedule.Scheduler()
+        job = s.every().second.do(lambda: None)
+        s.pause("nope")
+        s.resume("nope")
+        assert not job.paused
+
