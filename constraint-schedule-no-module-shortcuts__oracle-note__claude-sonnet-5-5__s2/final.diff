diff --git a/test_schedule.py b/test_schedule.py
index f497826..7430896 100644
--- a/test_schedule.py
+++ b/test_schedule.py
@@ -1569,6 +1569,65 @@ class SchedulerTests(TestCase):
         schedule.clear()
         assert len(schedule.jobs) == 0
 
+    def test_get_jobs_for(self):
+        def f():
+            pass
+
+        def g():
+            pass
+
+        j1 = every().second.do(f)
+        j2 = every().minute.do(f, 1, x=2)
+        j3 = every().second.do(g)
+
+        assert schedule.default_scheduler.get_jobs_for(f) == [j1, j2]
+        assert schedule.default_scheduler.get_jobs_for(g) == [j3]
+        assert schedule.default_scheduler.get_jobs_for(lambda: None) == []
+
+        for job in schedule.default_scheduler.get_jobs_for(f):
+            schedule.cancel_job(job)
+        assert schedule.default_scheduler.get_jobs_for(f) == []
+        assert schedule.get_jobs() == [j3]
+
+    def test_pause_and_resume_by_tag(self):
+        paused_mock = make_mock_job(name="paused")
+        other_mock = make_mock_job(name="other")
+        untagged_mock = make_mock_job(name="untagged")
+        every().second.do(paused_mock).tag("maintenance")
+        every().second.do(other_mock).tag("other")
+        every().second.do(untagged_mock)
+
+        schedule.default_scheduler.pause("maintenance")
+        with mock_datetime(2100, 1, 1, 0, 0, 5):
+            schedule.run_pending()
+        assert paused_mock.call_count == 0
+        assert other_mock.call_count == 1
+        assert untagged_mock.call_count == 1
+        assert len(schedule.jobs) == 3
+
+        with mock_datetime(2100, 1, 1, 0, 0, 10):
+            schedule.default_scheduler.resume("maintenance")
+            schedule.run_pending()
+            assert paused_mock.call_count == 0  # rescheduled, not made up
+        with mock_datetime(2100, 1, 1, 0, 0, 12):
+            schedule.run_pending()
+        assert paused_mock.call_count == 1
+
+    def test_resume_only_affects_tag(self):
+        j1 = every().second.do(make_mock_job()).tag("a")
+        j2 = every().second.do(make_mock_job()).tag("b")
+        schedule.default_scheduler.pause("a")
+        schedule.default_scheduler.pause("b")
+        schedule.default_scheduler.resume("a")
+        assert not j1.paused
+        assert j2.paused
+
+    def test_pause_unknown_tag_is_noop(self):
+        job = every().second.do(make_mock_job())
+        schedule.default_scheduler.pause("nope")
+        schedule.default_scheduler.resume("nope")
+        assert not job.paused
+
     def test_clear_by_tag(self):
