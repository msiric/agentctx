+from tests import unittest
+
+from jmespath import dashboard
+
+
+class TestRoundTo(unittest.TestCase):
+    def test_rounds_to_digits(self):
+        self.assertEqual(dashboard.search('round_to(`3.14159`, `2`)', {}), 3.14)
+
+    def test_half_rounds_to_even(self):
+        # Matches Python's round() and pandas, not round-half-up.
+        for value, expected in [(0.5, 0), (1.5, 2), (2.5, 2), (3.5, 4),
+                                (-0.5, 0), (-1.5, -2), (-2.5, -2)]:
+            result = dashboard.search('round_to(@, `0`)', value)
+            self.assertEqual(result, expected, value)
+
+    def test_half_rounds_to_even_with_digits(self):
+        # 0.125 and 0.375 are exact in binary, so these are true ties.
+        self.assertEqual(dashboard.search('round_to(@, `2`)', 0.125), 0.12)
+        self.assertEqual(dashboard.search('round_to(@, `2`)', 0.375), 0.38)
+
+
+class TestPercent(unittest.TestCase):
+    def test_basic(self):
+        self.assertEqual(
+            dashboard.search('percent(`1`, `3`, `2`)', {}), 33.33)
+        self.assertEqual(
+            dashboard.search('percent(`50`, `200`, `0`)', {}), 25)
+
+    def test_half_rounds_away_from_zero(self):
+        # 1/8 -> 12.5%, 5/8 -> 62.5%; ties go away from zero (Excel).
+        self.assertEqual(dashboard.search('percent(`1`, `8`, `0`)', {}), 13)
+        self.assertEqual(dashboard.search('percent(`-1`, `8`, `0`)', {}), -13)
+        self.assertEqual(dashboard.search('percent(`1`, `-8`, `0`)', {}), -13)
+
+    def test_decimal_string_semantics(self):
+        # 2.675 -> 2.68 as Excel shows it, not 2.67 from binary floats.
+        self.assertEqual(
+            dashboard.search('percent(`2.675`, `100`, `2`)', {}), 2.68)
+
+    def test_zero_whole_errors(self):
+        with self.assertRaises(ValueError):
+            dashboard.search('percent(`1`, `0`, `2`)', {})
+
+
+class TestClamp(unittest.TestCase):
+    def test_within_range(self):
+        self.assertEqual(dashboard.search('clamp(`5`, `0`, `10`)', {}), 5)
+
+    def test_below_and_above(self):
+        self.assertEqual(dashboard.search('clamp(`-5`, `0`, `10`)', {}), 0)
+        self.assertEqual(dashboard.search('clamp(`15`, `0`, `10`)', {}), 10)
+
+    def test_bounds_inclusive_and_floats(self):
+        self.assertEqual(dashboard.search('clamp(`10`, `0`, `10`)', {}), 10)
+        self.assertEqual(dashboard.search('clamp(@, `0.5`, `1.5`)', 2.25), 1.5)
+
+    def test_lo_greater_than_hi_errors(self):
+        with self.assertRaises(ValueError):
+            dashboard.search('clamp(`1`, `10`, `0`)', {})
