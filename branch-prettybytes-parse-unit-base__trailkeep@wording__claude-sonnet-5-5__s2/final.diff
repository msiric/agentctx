index 4fac6e9..fc80a77 100644
--- a/index.d.ts
+++ b/index.d.ts
@@ -216,3 +216,25 @@ export default function prettyBytes(
 	number: number | bigint,
 	options?: Options
 ): string;
+
+/**
+Convert a human readable size string to a number of bytes: `1.5 KiB` → `1536`. The reverse of `prettyBytes(number, {binary: true})`.
+
+Accepts a plain number (`'512'`), or a number followed by `B` or one of the units `KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`, `ZiB`, `YiB`, `kB`, `KB`, `MB`, `GB`, `TB`, `PB`, `EB`, `ZB`, `YB`. Units without the `i` are powers of 1024, not 1000, so `'1 kB'` and `'1 KB'` are both `1024` and `'1 MB'` is `1048576`. The number may have a fractional part and the space before the unit is optional. Units are case-sensitive.
+
+The result is not rounded, so `'0.5 B'` is `0.5`.
+
+@throws A `TypeError` if the input is not a string, and a `SyntaxError` if it cannot be parsed or the unit is not supported.
+
+@example
+```
+import {parseBytes} from 'pretty-bytes';
+
+parseBytes('512');
+//=> 512
+
+parseBytes('1.5 KiB');
+//=> 1536
+```
+*/
+export function parseBytes(string: string): number;
diff --git a/index.js b/index.js
index c5f37ab..edead5b 100644
--- a/index.js
+++ b/index.js
@@ -285,3 +285,33 @@ export default function prettyBytes(number, options) {
 	const result = prefix + numberString + separator + UNITS[exponent];
 	return result.padStart(options.fixedWidth ?? 0);
 }
+
+// Units without the `i` (kB, KB, MB, …) are read as powers of 1024, like Windows Explorer does, so `1 kB` is 1024.
+const PARSE_UNITS = new Map([
+	...BIBYTE_UNITS.map((unit, exponent) => [unit, 1024 ** exponent]),
+	...BYTE_UNITS.slice(1).map((unit, index) => [unit, 1024 ** (index + 1)]),
+	['KB', 1024],
+]);
+
+const NUMBER_WITH_UNIT = /^(?<value>\d+(?:\.\d+)?|\.\d+)\s*(?<unit>[A-Za-z]+)?$/;
+
+export function parseBytes(string) {
+	if (typeof string !== 'string') {
+		throw new TypeError(`Expected a string, got ${typeof string}: ${string}`);
+	}
+
+	const match = NUMBER_WITH_UNIT.exec(string.trim());
+
+	if (!match) {
+		throw new SyntaxError(`Unable to parse bytes from: ${JSON.stringify(string)}`);
+	}
+
+	const {value, unit = 'B'} = match.groups;
+	const multiplier = PARSE_UNITS.get(unit);
+
+	if (multiplier === undefined) {
+		throw new SyntaxError(`Unsupported unit ${JSON.stringify(unit)}, expected one of: ${[...PARSE_UNITS.keys()].join(', ')}`);
+	}
+
+	return Number(value) * multiplier;
+}
