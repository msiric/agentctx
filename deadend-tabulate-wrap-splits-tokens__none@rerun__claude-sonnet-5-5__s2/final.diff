diff --git a/test/test_cli.py b/test/test_cli.py
index 154f1a2..13a14ba 100644
--- a/test/test_cli.py
+++ b/test/test_cli.py
@@ -483,3 +483,33 @@ def test_inprocess_jsonl_malformed_headers():
     )
     # output should still be produced (graceful fallback), with raw keys as headers
     assert out.strip() != ""
+
+
+def test_inprocess_wrap_option():
+    """In-process: -w / --wrap"""
+    text = "name description\nfoo a-long-description-here\n"
+    for opt in ["-w", "--wrap"]:
+        out = run_main_in_process([opt, "6", "-f", "grid"], input_text=text)
+        expected = """\
++------+--------+
+| name | descri |
+|      | ption  |
++------+--------+
+| foo  | a-long |
+|      | -descr |
+|      | iption |
+|      | -here  |
++------+--------+"""
+        assert_equal(out.splitlines(), expected.splitlines())
+
+
+def test_inprocess_wrap_invalid():
+    """In-process: --wrap rejects non-positive or non-integer widths"""
+    for bad in ["0", "-3", "abc"]:
+        with patch.object(sys, "argv", ["tabulate", "--wrap", bad]):
+            try:
+                _main()
+            except SystemExit as e:
+                assert_equal(e.code, 2)
+            else:
+                raise AssertionError("expected SystemExit")
