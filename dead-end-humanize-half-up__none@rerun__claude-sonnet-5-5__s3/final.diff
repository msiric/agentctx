+def gigabytes(num_bytes: float | str, precision: int = 1) -> str:
+    """Format a number of bytes as decimal gigabytes (10**9 bytes).
+
+    Examples:
+        ```pycon
+        >>> gigabytes(1_500_000_000)
+        '1.5 GB'
+        >>> gigabytes(1_234_567_890, precision=2)
+        '1.23 GB'
+        >>> gigabytes(500_000_000, precision=0)
+        '0 GB'
+
+        ```
+
+    Args:
+        num_bytes (int, float, str): Number of bytes.
+        precision (int): Number of digits after the decimal point.
+
+    Returns:
+        str: The value in gigabytes followed by " GB".
+    """
+    return f"{float(num_bytes) / 10**9:.{precision}f} GB"
