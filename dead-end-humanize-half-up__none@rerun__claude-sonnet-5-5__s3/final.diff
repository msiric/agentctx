+def percent(value: NumberOrString, precision: int = 1) -> str:
+    """Format a fraction as a percentage.
+
+    Examples:
+        ```pycon
+        >>> percent(0.125)
+        '12.5%'
+        >>> percent(0.5)
+        '50.0%'
+        >>> percent(0.5, 0)
+        '50%'
+        >>> percent(0.0625)
+        '6.3%'
+        >>> percent(1.5, 2)
+        '150.00%'
+        >>> percent("foo")
+        'foo'
+        >>> percent(None)
+        'None'
+
+        ```
+
+    Args:
+        value (int, float, str): Fraction to format, where 1 is 100%. Ties round half up
+            (away from zero), matching billing's invoices.
+        precision (int): Number of digits after the decimal point.
+
+    Returns:
+        str: The percentage, or the input as a string if it is not a number.
+    """
+    import math
+
+    try:
+        value = float(value)
+        if not math.isfinite(value):
+            return _format_not_finite(value)
+    except (ValueError, TypeError):
+        return str(value)
+    # Round half up on the shortest decimal repr of the float (what a human
+    # reads), not on its binary value, so 0.0125 -> '1.3%' rather than '1.2%'.
+    with decimal.localcontext() as ctx:
+        ctx.prec = 1000
+        pct = decimal.Decimal(repr(value)).scaleb(2)
+        pct = pct.quantize(
+            decimal.Decimal(1).scaleb(-int(precision)), rounding=decimal.ROUND_HALF_UP
+        )
+        return f"{pct:f}%"
+
