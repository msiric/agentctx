+
+def test_none_written_as_empty_string():
+    obj = {
+        "a": None,
+        "b": 1,
+        "table": {"x": None, "y": 2, "sub": {"z": None}},
+        "all_none": {"q": None},
+        "inline": [{"k": None, "v": 1}, {"k": None}],
+        "aot": [{"k": None, "v": 1, "pad": "x" * 100}],
+    }
+    out = tomli_w.dumps(obj)
+    assert "None" not in out
+    assert tomllib.loads(out) == {
+        "a": "",
+        "b": 1,
+        "table": {"x": "", "y": 2, "sub": {"z": ""}},
+        "all_none": {"q": ""},
+        "inline": [{"k": "", "v": 1}, {"k": ""}],
+        "aot": [{"k": "", "v": 1, "pad": "x" * 100}],
+    }
+
+
+def test_none_in_inline_table():
+    assert tomli_w.dumps({"a": [{"k": None, "v": 1}]}) == (
+        'a = [\n    { k = "", v = 1 },\n]\n'
+    )
+    assert tomli_w.dumps({"a": [{"k": None}]}) == 'a = [\n    { k = "" },\n]\n'
+
+
+def test_none_in_array():
+    assert tomli_w.dumps({"a": [1, None]}) == "a = [\n    1,\n    \"\",\n]\n"
+    assert tomli_w.dumps({"a": [None]}) == 'a = [\n    "",\n]\n'
+    assert tomli_w.dumps({"a": (None, None)}) == 'a = [\n    "",\n    "",\n]\n'
+
+
+def test_none_in_nested_array():
+    out = tomli_w.dumps({"a": [[None, 1], [None]], "t": {"b": [None]}})
+    assert tomllib.loads(out) == {"a": [["", 1], [""]], "t": {"b": [""]}}
+
+
+def test_none_dump_file(tmp_path):
+    p = tmp_path / "f.toml"
+    with p.open("wb") as f:
+        tomli_w.dump({"a": None, "b": 1}, f)
+    assert p.read_text() == 'a = ""\nb = 1\n'
+
+
+def test_pathlib_paths():
+    obj = {
+        "p": pathlib.PurePosixPath("/usr/local/bin"),
+        "win": pathlib.PureWindowsPath("C:/a/b"),
+        "arr": [pathlib.PurePosixPath("a/b")],
+        "t": {"q": pathlib.Path("rel/x")},
+    }
+    out = tomli_w.dumps(obj)
+    assert tomllib.loads(out) == {
+        "p": "/usr/local/bin",
+        "win": "C:\\a\\b",
+        "arr": ["a/b"],
+        "t": {"q": str(pathlib.Path("rel/x"))},
+    }
+    assert tomli_w.dumps({"p": pathlib.PurePosixPath("/a")}) == 'p = "/a"\n'
