+import unittest
+
+from jmespath import exceptions
+from jmespath import dashboard
+
+
+class TestRoundTo(unittest.TestCase):
+    def test_rounds_half_to_even(self):
+        # Matches Python's round() and pandas, which the dashboards are
+        # checked against. Halves go to the nearest even digit.
+        self.assertEqual(dashboard.search('round_to(`0.5`, `0`)', {}), 0)
+        self.assertEqual(dashboard.search('round_to(`1.5`, `0`)', {}), 2)
+        self.assertEqual(dashboard.search('round_to(`2.5`, `0`)', {}), 2)
+        self.assertEqual(dashboard.search('round_to(`3.5`, `0`)', {}), 4)
+        self.assertEqual(dashboard.search('round_to(`-2.5`, `0`)', {}), -2)
+        self.assertEqual(dashboard.search('round_to(`25`, `-1`)', {}), 20)
+        self.assertEqual(dashboard.search('round_to(`35`, `-1`)', {}), 40)
+
+    def test_digits(self):
+        self.assertEqual(
+            dashboard.search('round_to(a, `2`)', {'a': 3.14159}), 3.14)
+        self.assertEqual(dashboard.search('round_to(a, `-1`)', {'a': 1234}),
+                         1230)
+
+    def test_fractional_digits_rejected(self):
+        with self.assertRaises(exceptions.JMESPathError):
+            dashboard.search('round_to(`1`, `1.5`)', {})
+
+    def test_builtins_still_available(self):
+        self.assertEqual(dashboard.search('abs(a)', {'a': -1}), 1)
+
+
+class TestClamp(unittest.TestCase):
+    def test_within_range(self):
+        self.assertEqual(dashboard.search('clamp(`5`, `0`, `10`)', {}), 5)
+
+    def test_below_and_above(self):
+        self.assertEqual(dashboard.search('clamp(`-5`, `0`, `10`)', {}), 0)
+        self.assertEqual(dashboard.search('clamp(`15`, `0`, `10`)', {}), 10)
+
+    def test_bounds_inclusive_and_floats(self):
+        self.assertEqual(dashboard.search('clamp(`0`, `0`, `10`)', {}), 0)
+        self.assertEqual(dashboard.search('clamp(a, `0`, `1`)', {'a': 0.25}),
+                         0.25)
+
+    def test_lo_greater_than_hi_rejected(self):
+        with self.assertRaises(exceptions.JMESPathError):
+            dashboard.search('clamp(`5`, `10`, `0`)', {})
+
+
+class TestPercent(unittest.TestCase):
+    def test_basic(self):
+        self.assertEqual(dashboard.search('percent(`1`, `4`, `0`)', {}), 25)
+        self.assertEqual(dashboard.search('percent(`1`, `3`, `2`)', {}), 33.33)
+
+    def test_rounds_half_away_from_zero(self):
+        # Matches Excel, not Python's round(); differs from round_to().
+        s = dashboard.search
+        self.assertEqual(s('percent(`1`, `200`, `0`)', {}), 1)    # 0.5
+        self.assertEqual(s('percent(`3`, `200`, `0`)', {}), 2)    # 1.5
+        self.assertEqual(s('percent(`5`, `200`, `0`)', {}), 3)    # 2.5
+        self.assertEqual(s('percent(`-5`, `200`, `0`)', {}), -3)  # -2.5
+        self.assertEqual(s('percent(`1`, `8`, `1`)', {}), 12.5)
+        self.assertEqual(s('percent(`1`, `16`, `1`)', {}), 6.3)   # 6.25
+        self.assertEqual(s('percent(`1`, `8`, `-1`)', {}), 10)
+
+    def test_zero_whole_rejected(self):
+        with self.assertRaises(exceptions.JMESPathError):
+            dashboard.search('percent(`1`, `0`, `1`)', {})
+
+    def test_fractional_digits_rejected(self):
+        with self.assertRaises(exceptions.JMESPathError):
+            dashboard.search('percent(`1`, `2`, `1.5`)', {})
