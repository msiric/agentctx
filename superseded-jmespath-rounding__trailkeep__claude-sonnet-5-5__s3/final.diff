+"""JMESPath functions for the dashboards."""
+import decimal
+from decimal import Decimal
+
+from jmespath import parser
+from jmespath import exceptions
+from jmespath.functions import Functions, signature
+from jmespath.visitor import Options
+
+
+class DashboardFunctions(Functions):
+
+    @signature({'types': ['number']}, {'types': ['number']})
+    def _func_round_to(self, number, digits):
+        if digits != int(digits):
+            raise exceptions.JMESPathError(
+                'round_to() digits must be a whole number, got %r' % digits)
+        return round(number, int(digits))
+
+    @signature({'types': ['number']}, {'types': ['number']},
+               {'types': ['number']})
+    def _func_clamp(self, value, lo, hi):
+        if lo > hi:
+            raise exceptions.JMESPathError(
+                'clamp() lo must not be greater than hi, got lo=%r hi=%r'
+                % (lo, hi))
+        return max(lo, min(value, hi))
+
+    @signature({'types': ['number']}, {'types': ['number']},
+               {'types': ['number']})
+    def _func_percent(self, part, whole, digits):
+        if digits != int(digits):
+            raise exceptions.JMESPathError(
+                'percent() digits must be a whole number, got %r' % digits)
+        if whole == 0:
+            raise exceptions.JMESPathError('percent() whole must not be zero')
+        digits = int(digits)
+        # Round half away from zero (Excel behavior) on the decimal value,
+        # not the binary float. Deliberately not round_to(), which is
+        # half-to-even.
+        with decimal.localcontext() as ctx:
+            ctx.prec = 50
+            result = Decimal(str(part)) / Decimal(str(whole)) * 100
+            result = result.quantize(Decimal(1).scaleb(-digits),
+                                     rounding=decimal.ROUND_HALF_UP)
+        if digits <= 0:
+            return int(result)
+        return float(result)
+
+
+def search(expression, data, options=None):
+    """Like ``jmespath.search`` but with ``DashboardFunctions`` available."""
+    if options is None:
+        options = Options(custom_functions=DashboardFunctions())
+    elif options.custom_functions is None:
+        options = Options(dict_cls=options.dict_cls,
+                          custom_functions=DashboardFunctions())
+    return parser.Parser().parse(expression).search(data, options=options)
