+class TestRunPendingErrors:
+    def test_other_jobs_run_then_first_exception_raised(self):
+        ran = []
+
+        def bad(n):
+            raise ValueError(n)
+
+        s = schedule.Scheduler()
+        s.every().second.do(bad, "first")
