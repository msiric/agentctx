+/**
+ * Parse a compound duration such as `"1h 30m"`, `"1h, 30m"` or `"2 days 4 hours"` and
+ * return the total in milliseconds. Each piece is parsed with `parse`.
+ *
+ * @param str - A string made of one or more `<number><unit>` pieces
+ * @returns The summed value in milliseconds
+ * @throws TypeError if `str` isn't a string of length 1 to 99, or can't be
+ * parsed as one or more `<number><unit>` pieces. When there is more than one
+ * piece, every piece must have a unit.
+ */
+export function parseCompound(str: string): number {
+  const invalid = (reason: string) =>
+    new TypeError(
+      `Value provided to ms.parseCompound() ${reason}. value=${JSON.stringify(str)}`,
+    );
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw invalid('must be a string with length between 1 and 99');
+  }
+  const trimmed = str.trim();
+  const pieces: string[] = [];
+  let pos = 0;
+  for (const match of trimmed.matchAll(/-?\d*\.?\d+ *[a-z]*/gi)) {
+    // Pieces must be separated by whitespace and at most one comma, with
+    // nothing left over (so no leading, trailing, or doubled commas).
+    const separator = trimmed.slice(pos, match.index);
+    if (!(pieces.length > 0 ? /^\s*,?\s*$/ : /^$/).test(separator)) {
+      throw invalid('is not a valid compound duration');
+    }
+    pieces.push(match[0]);
+    pos = match.index + match[0].length;
+  }
+  if (pieces.length === 0 || trimmed.slice(pos) !== '') {
+    throw invalid('is not a valid compound duration');
+  }
+  if (pieces.length > 1 && pieces.some((piece) => /\d$/.test(piece))) {
+    throw invalid('must give a unit for every piece');
+  }
+  let total = 0;
+  for (const piece of pieces) {
+    const value = parse(piece);
+    if (Number.isNaN(value)) {
+      throw invalid(`contains an invalid piece ${JSON.stringify(piece)}`);
+    }
+    total += value;
+  }
+  return total;
+}
+
+/**
+ * Parse a timer-style string and return milliseconds. `"m:ss"` (e.g. `"1:30"`)
+ * and `"h:mm:ss"` (e.g. `"01:02:03"`) are supported. The first field may be any
+ * number of digits; the minutes and seconds after it must be two digits from 00
+ * to 59. Seconds may have a fractional part (e.g. `"1:30.5"`).
+ *
+ * @param str - A clock string such as `"1:30"` or `"01:02:03"`
+ * @returns The value in milliseconds
+ * @throws TypeError if `str` isn't a string of length 1 to 99 or isn't a valid
+ * `m:ss` or `h:mm:ss` value
+ */
+export function parseClock(str: string): number {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw new TypeError(
+      `Value provided to ms.parseClock() must be a string with length between 1 and 99. value=${JSON.stringify(str)}`,
+    );
+  }
+  const match =
+    /^(?:(?<first>\d+):)?(?<middle>\d+):(?<sec>\d{2}(?:\.\d+)?)$/.exec(
+      str.trim(),
+    );
+  const { first, middle, sec } = match?.groups ?? {};
+  // With three fields the middle one is minutes and must be two digits.
+  const minutesOk =
+    first === undefined ? true : middle.length === 2 && Number(middle) < 60;
+  if (!match || !minutesOk || Number(sec) >= 60) {
+    throw new TypeError(
+      `Value provided to ms.parseClock() must be in the form m:ss or h:mm:ss. value=${JSON.stringify(str)}`,
+    );
+  }
+  return first === undefined
+    ? Number(middle) * m + Number(sec) * s
+    : Number(first) * h + Number(middle) * m + Number(sec) * s;
+}
