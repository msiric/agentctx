+import { describe, expect, it } from '@jest/globals';
+import { parseClock } from './index';
+
+describe('parseClock(string)', () => {
+  it('should parse m:ss', () => {
+    expect(parseClock('1:30')).toBe(90000);
+    expect(parseClock('0:05')).toBe(5000);
+    expect(parseClock('00:00')).toBe(0);
+  });
+
+  it('should parse h:mm:ss', () => {
+    expect(parseClock('01:02:03')).toBe(3723000);
+    expect(parseClock('1:00:00')).toBe(3600000);
+  });
+
+  it('should allow minutes over 59 in m:ss', () => {
+    expect(parseClock('90:00')).toBe(5400000);
+  });
+
+  it('should allow fractional seconds', () => {
+    expect(parseClock('1:30.5')).toBe(90500);
+  });
+
+  it('should ignore surrounding whitespace', () => {
+    expect(parseClock(' 1:30 ')).toBe(90000);
+  });
+
+  it('should throw a TypeError for invalid values', () => {
+    for (const bad of [
+      '',
+      '90',
+      '1:5',
+      '1:60',
+      '1:75:00',
+      '1:2:03',
+      '1:02:60',
+      '1:2:3:4',
+      ':30',
+      '1:',
+      '-1:30',
+      '1:30m',
+      'abc',
+    ]) {
+      expect(() => parseClock(bad)).toThrow(TypeError);
+    }
+  });
+
+  it('should throw a TypeError for non-strings and overlong strings', () => {
+    expect(() => parseClock(undefined as any)).toThrow(TypeError);
+    expect(() => parseClock(90 as any)).toThrow(TypeError);
+    expect(() => parseClock('1:'.repeat(60) + '00')).toThrow(TypeError);
+  });
+});
