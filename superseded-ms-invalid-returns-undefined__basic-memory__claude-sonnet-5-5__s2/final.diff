+import { describe, expect, it } from '@jest/globals';
+import { parseCompound } from './index';
+
+describe('parseCompound(string)', () => {
+  it('should sum short units', () => {
+    expect(parseCompound('1h 30m')).toBe(5400000);
+  });
+
+  it('should sum long units with spaces', () => {
+    expect(parseCompound('2 days 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
+  });
+
+  it('should handle pieces without separators', () => {
+    expect(parseCompound('1h30m')).toBe(5400000);
+  });
+
+  it('should handle a single piece like parse', () => {
+    expect(parseCompound('100')).toBe(100);
+    expect(parseCompound('1.5h')).toBe(5400000);
+  });
+
+  it('should accept commas between pieces', () => {
+    expect(parseCompound('1h, 30m')).toBe(5400000);
+    expect(parseCompound('1h,30m')).toBe(5400000);
+    expect(parseCompound('2 days , 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
+  });
+
+  it('should ignore surrounding whitespace', () => {
+    expect(parseCompound('  1m 30s ')).toBe(90000);
+  });
+
+  it('should be case insensitive', () => {
+    expect(parseCompound('1H 30M')).toBe(5400000);
+  });
+
+  it('should support negative pieces', () => {
+    expect(parseCompound('1h -30m')).toBe(1800000);
+  });
+
+  it('should throw a TypeError including the input for bad input', () => {
+    for (const bad of [
+      '',
+      'abc',
+      'foo',
+      '1h foo',
+      '1h,, 30m',
+      ',1h 30m',
+      '1h 30m,',
+      '1h, 30',
+      '1h 30x',
+      '1h 30',
+    ]) {
+      expect(() => parseCompound(bad)).toThrow(TypeError);
+      expect(() => parseCompound(bad)).toThrow(JSON.stringify(bad));
+    }
+  });
+
+  it('should throw a TypeError for non-string and too long values', () => {
+    expect(() => parseCompound(undefined as unknown as string)).toThrow(
+      TypeError,
+    );
+    expect(() => parseCompound('1m '.repeat(40))).toThrow(TypeError);
+  });
+
+  it('should never return NaN', () => {
+    expect(parseCompound('1h 30m')).not.toBeNaN();
+  });
+});
