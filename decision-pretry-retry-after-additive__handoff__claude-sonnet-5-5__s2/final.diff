+// Seconds, as in the `Retry-After` header. Anything that is not a positive finite number is ignored, so a bad value falls back to the backoff alone instead of poisoning the delay with `NaN`.
+function getRetryAfter(error) {
+	const seconds = error.retryAfter;
+
+	return typeof seconds === 'number' && Number.isFinite(seconds) && seconds > 0 ? Math.ceil(seconds * 1000) : 0;
