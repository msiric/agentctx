+test('elapsedTime is provided in every callback context', async t => {
+	await withFakeTime(t);
+	const seen = {shouldConsumeRetry: [], onFailedAttempt: [], shouldRetry: []};
+
+	await assert.rejects(pRetry(
+		async () => {
+			throw new Error('test');
+		},
+		{
+			retries: 2,
+			minTimeout: 100,
+			factor: 2,
+			shouldConsumeRetry({elapsedTime}) {
+				seen.shouldConsumeRetry.push(elapsedTime);
+				return true;
+			},
+			onFailedAttempt({elapsedTime}) {
+				seen.onFailedAttempt.push(elapsedTime);
+			},
+			shouldRetry({elapsedTime}) {
+				seen.shouldRetry.push(elapsedTime);
+				return true;
+			},
+		},
+	), {message: 'test'});
+
+	// Waits are 100 and 200ms, so the failures happen at 0, 100 and 300ms. `shouldRetry` is not asked after the last one.
+	assert.deepEqual(seen.shouldConsumeRetry, [0, 100, 300]);
+	assert.deepEqual(seen.onFailedAttempt, [0, 100, 300]);
+	assert.deepEqual(seen.shouldRetry, [0, 100]);
+});
+
