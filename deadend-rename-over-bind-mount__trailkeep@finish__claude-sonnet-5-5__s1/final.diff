+    def _recover(self) -> None:
+        """
+        Recover from a crash during a previous write.
+
+        Every write first stores the new contents in a checksummed journal
+        file and only then overwrites the database file in place. If a valid
+        journal is left over, the in-place write may have been cut short, so
+        it is replayed. If the journal is incomplete, the database file was
+        not touched yet and is still intact, so the journal is dropped.
+        """
+        try:
+            with open(self._journal_path, 'rb') as journal:
+                raw = journal.read()
+        except FileNotFoundError:
+            return
+
+        checksum, _, payload = raw.partition(b'\n')
+        if hashlib.sha256(payload).hexdigest().encode() == checksum:
+            self._write_in_place(payload.decode('utf-8'))
+
+        os.remove(self._journal_path)
+
+    def _write_journal(self, serialized: str) -> None:
+        payload = serialized.encode('utf-8')
+        header = hashlib.sha256(payload).hexdigest().encode() + b'\n'
+
+        with open(self._journal_path, 'wb') as journal:
+            journal.write(header + payload)
+            journal.flush()
+            os.fsync(journal.fileno())
+
+        # Make the journal's directory entry durable
+        _fsync_dir(os.path.dirname(os.path.abspath(self._journal_path)))
+
+    def _write_in_place(self, serialized: str) -> None:
+        # Move the cursor to the beginning of the file just in case
+        self._handle.seek(0)
+
+        # Write the serialized data to the file
+        try:
+            self._handle.write(serialized)
+        except io.UnsupportedOperation:
+            raise IOError('Cannot write to the database. Access mode is "{0}"'.format(self._mode))
+
+        # Remove data that is behind the new cursor in case the file has
+        # gotten shorter
+        self._handle.truncate()
+
+        # Ensure the file has been written
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+
     def close(self) -> None:
         self._handle.close()
 
