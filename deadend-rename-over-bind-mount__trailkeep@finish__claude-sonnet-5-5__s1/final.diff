diff --git a/tests/test_storages.py b/tests/test_storages.py
index 6e433a1..16e1ca2 100644
--- a/tests/test_storages.py
+++ b/tests/test_storages.py
@@ -285,3 +285,101 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def _journal_bytes(serialized):
+    import hashlib
+    payload = serialized.encode('utf-8')
+    return hashlib.sha256(payload).hexdigest().encode() + b'\n' + payload
+
+
+def test_json_no_journal_left_after_write(tmpdir):
+    path = str(tmpdir.join('test.db'))
+    storage = JSONStorage(path)
+    storage.write(doc)
+    storage.close()
+    assert not os.path.exists(path + '.journal')
+
+
+def test_json_crash_while_writing_journal(tmpdir):
+    # Old state is intact, journal is truncated -> old state wins
+    path = str(tmpdir.join('test.db'))
+    storage = JSONStorage(path)
+    storage.write({'_default': {'1': {'a': 1}}})
+    storage.close()
+
+    with open(path + '.journal', 'wb') as f:
+        f.write(_journal_bytes(json.dumps({'new': 1}))[:-5])
+
+    db = TinyDB(path)
+    assert db.table('_default').all() == [{'a': 1}]
+    db.close()
+    assert not os.path.exists(path + '.journal')
+
+
+def test_json_crash_during_in_place_write(tmpdir):
+    # Valid journal, database file truncated mid-write -> new state wins
+    path = str(tmpdir.join('test.db'))
+    new = json.dumps({'_default': {'1': {'b': 2}}})
+    with open(path, 'w') as f:
+        f.write(new[:7])
+    with open(path + '.journal', 'wb') as f:
+        f.write(_journal_bytes(new))
+
+    db = TinyDB(path)
+    assert db.table('_default').all() == [{'b': 2}]
+    db.close()
+    assert not os.path.exists(path + '.journal')
+    with open(path) as f:
+        assert json.load(f) == {'_default': {'1': {'b': 2}}}
+
+
+def test_json_crash_simulated_in_write(tmpdir, monkeypatch):
+    # Kill the "process" at each step of write(); reopening must always work
+    path = str(tmpdir.join('test.db'))
+    db = TinyDB(path)
+    db.insert({'old': True})
+    db.close()
+
+    for target in ('_write_in_place', 'remove'):
+        db = TinyDB(path)
+        storage = db.storage
+
+        class Crash(BaseException):
+            pass
+
+        if target == '_write_in_place':
+            def boom(serialized):
+                # Simulate a torn write, then die
+                storage._handle.seek(0)
+                storage._handle.write(serialized[:5])
+                storage._handle.truncate()
+                storage._handle.flush()
+                raise Crash
+            monkeypatch.setattr(storage, '_write_in_place', boom)
+        else:
+            def boom(p):
+                raise Crash
+            monkeypatch.setattr(os, 'remove', boom)
+
+        with pytest.raises(Crash):
+            db.insert({'new': target})
+        monkeypatch.undo()
+        storage._handle.close()
+
+        db = TinyDB(path)
+        assert {'new': target} in db.all()
+        assert {'old': True} in db.all()
+        db.close()
+
+
+def test_json_read_only_does_not_write(tmpdir):
+    path = str(tmpdir.join('test.db'))
+    storage = JSONStorage(path)
+    storage.write(doc)
+    storage.close()
+
+    storage = JSONStorage(path, access_mode='r')
+    with pytest.raises(IOError):
+        storage.write(doc)
+    storage.close()
