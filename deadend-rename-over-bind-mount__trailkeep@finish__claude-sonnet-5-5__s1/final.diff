+def _fsync_dir(path: str) -> None:
+    """Best-effort fsync of a directory so new directory entries persist."""
+    try:
+        fd = os.open(path, os.O_RDONLY)
+    except OSError:
+        return
+    try:
+        os.fsync(fd)
+    except OSError:
+        pass
+    finally:
