+    def test_run_pending_runs_other_jobs_after_failure(self):
+        failing = make_mock_job("failing")
+        failing.side_effect = ValueError("first")
+        failing2 = make_mock_job("failing2")
+        failing2.side_effect = KeyError("second")
+        ok = make_mock_job("ok")
+        with mock_datetime(2010, 1, 6, 12, 15):
+            every().minute.do(failing)
+            every().minute.do(failing2)
+            every().minute.do(ok)
+        with mock_datetime(2010, 1, 6, 12, 17):
+            with self.assertRaises(ValueError):
+                schedule.run_pending()
+            assert failing.call_count == 1
+            assert failing2.call_count == 1
+            assert ok.call_count == 1
+
+    def test_failed_job_is_rescheduled(self):
+        failing = make_mock_job("failing")
+        failing.side_effect = ValueError("boom")
+        with mock_datetime(2010, 1, 6, 12, 15):
+            every().minute.do(failing)
+        with mock_datetime(2010, 1, 6, 12, 17):
+            with self.assertRaises(ValueError):
+                schedule.run_pending()
+            schedule.run_pending()  # not due again within the same tick
+            assert failing.call_count == 1
+
     def test_run_all(self):
