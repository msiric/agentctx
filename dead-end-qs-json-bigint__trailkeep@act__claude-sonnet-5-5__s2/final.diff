 //=> {age: 20, id: '01234', zipcode: '90210'}
 ```
 
+- `'json'`: Parse `filter` as JSON. A value that is not valid JSON stays a string:
+
+```js
+import queryString from 'query-string';
+
+queryString.parse('?filter=%7B%22status%22%3A%22open%22%7D&other=%7Bnope', {
+	types: {
+		filter: 'json',
+		other: 'json',
+	}
+});
+//=> {filter: {status: 'open'}, other: '{nope'}
+```
+
+Note: The value is decoded with `JSON.parse()`, so an integer above `Number.MAX_SAFE_INTEGER` loses precision. Send large IDs as strings inside the JSON.
+
 - `'string[]'`:  Parse `items` as an array of strings (overriding the `parseNumbers` option):
 
 ```js
