 });
+
+test('parses a value with the json type', () => {
+	assert.deepEqual(structuredClone(queryString.parse('filter=%7B%22status%22%3A%22open%22%7D', {types: {filter: 'json'}})), {filter: {status: 'open'}});
+	const types = {a: 'json', b: 'json', c: 'json'};
+	assert.deepEqual(structuredClone(queryString.parse('a=%5B1%2C2%5D&b=true&c=1', {types})), {a: [1, 2], b: true, c: 1});
+});
+
+test('the json type leaves a value that is not valid JSON as a string', () => {
+	assert.deepEqual(structuredClone(queryString.parse('filter=%7Bnope&other=007', {parseNumbers: true, types: {filter: 'json', other: 'json'}})), {filter: '{nope', other: '007'});
+	assert.deepEqual(structuredClone(queryString.parse('filter', {types: {filter: 'json'}})), {filter: null});
+});
