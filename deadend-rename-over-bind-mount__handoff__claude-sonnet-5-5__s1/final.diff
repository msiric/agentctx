@@ -119,6 +129,66 @@ class JSONStorage(Storage):
         # Open the file for reading/writing
         self._handle = open(path, mode=self._mode, encoding=encoding)
 
+        self._writable = '+' in self._mode
+        self._backup_path = backup_path if backup_path is not None else os.fspath(path) + '.bak'
+        if self._writable:
+            self._recover()
+
+    def _recover(self) -> None:
+        """
+        Restore the main file from the backup if a crash left it unreadable.
+        """
+        self._handle.seek(0, os.SEEK_END)
+        if not self._handle.tell():
+            return
+        self._handle.seek(0)
+        try:
+            json.load(self._handle)
+            return
+        except ValueError:
+            pass
+
+        try:
+            with open(self._backup_path, encoding=self._handle.encoding) as f:
+                content = f.read()
+            json.loads(content)
+        except (OSError, ValueError):
+            # No usable backup: leave the file alone, read() will raise
+            return
+
+        self._write_in_place(content)
+
+    def _write_backup(self, serialized: str) -> None:
+        tmp = self._backup_path + '.tmp'
+        with open(tmp, 'w', encoding=self._handle.encoding) as f:
+            f.write(serialized)
+            f.flush()
+            os.fsync(f.fileno())
+        os.replace(tmp, self._backup_path)
+        try:
+            dir_fd = os.open(os.path.dirname(os.path.abspath(self._backup_path)), os.O_RDONLY)
+        except OSError:  # e.g. Windows
+            return
+        try:
+            os.fsync(dir_fd)
+        finally:
+            os.close(dir_fd)
+
+    def _write_in_place(self, serialized: str) -> None:
+        self._handle.seek(0)
+        try:
+            self._handle.write(serialized)
+        except io.UnsupportedOperation:
+            raise IOError('Cannot write to the database. Access mode is "{0}"'.format(self._mode))
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+
+        # Remove data that is behind the new cursor in case the file has
+        # gotten shorter
+        self._handle.truncate()
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+
     def close(self) -> None:
         self._handle.close()
 
