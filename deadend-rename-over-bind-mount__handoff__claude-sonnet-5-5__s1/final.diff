index 6e433a1..98c0f11 100644
--- a/tests/test_storages.py
+++ b/tests/test_storages.py
@@ -285,3 +285,75 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def _crash_after(monkeypatch, nbytes):
+    """Make the in-place write die after ``nbytes`` have hit the file."""
+    import tinydb.storages as st
+
+    def crashing(self, serialized):
+        self._handle.seek(0)
+        self._handle.write(serialized[:nbytes])
+        self._handle.flush()
+        raise KeyboardInterrupt('simulated kill')
+
+    monkeypatch.setattr(st.JSONStorage, '_write_in_place', crashing)
+
+
+@pytest.mark.parametrize('nbytes', [0, 5, 10_000])
+def test_json_crash_during_write_recovers(tmp_path, monkeypatch, nbytes):
+    path = str(tmp_path / 'db.json')
+    db = TinyDB(path)
+    db.insert({'a': 1})
+    db.close()
+
+    with monkeypatch.context() as m:
+        _crash_after(m, nbytes)
+        db = TinyDB(path)
+        with pytest.raises(KeyboardInterrupt):
+            db.insert({'b': 2})
+        # process "dies": handle is never closed cleanly
+
+    db2 = TinyDB(path)
+    assert db2.all() in ([{'a': 1}], [{'a': 1}, {'b': 2}])
+    db2.insert({'c': 3})
+    assert {'c': 3} in db2.all()
+    db2.close()
+
+
+def test_json_crash_before_backup_replace_keeps_old(tmp_path, monkeypatch):
+    path = str(tmp_path / 'db.json')
+    db = TinyDB(path)
+    db.insert({'a': 1})
+    db.close()
+
+    def boom(src, dst):
+        raise KeyboardInterrupt('simulated kill')
+
+    db = TinyDB(path)
+    monkeypatch.setattr(os, 'replace', boom)
+    with pytest.raises(KeyboardInterrupt):
+        db.insert({'b': 2})
+    monkeypatch.undo()
+
+    assert TinyDB(path).all() == [{'a': 1}]
+
+
+def test_json_write_keeps_inode_and_custom_backup(tmp_path):
+    bak_dir = tmp_path / 'bak'
+    bak_dir.mkdir()
+    path = tmp_path / 'db.json'
+    db = TinyDB(str(path), backup_path=str(bak_dir / 'db.bak'))
+    ino = os.stat(path).st_ino
+    db.insert({'a': 1})
+    db.insert({'b': 2})
+    db.close()
+    assert os.stat(path).st_ino == ino
+    assert json.load(open(bak_dir / 'db.bak')) == json.load(open(path))
+
+
+def test_json_unrecoverable_corruption_still_raises(tmp_path):
+    path = tmp_path / 'db.json'
+    path.write_text('{"_default": {"1": {"a"')
+    with pytest.raises(ValueError):
+        TinyDB(str(path)).all()
