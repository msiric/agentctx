+    def test_to_dict_skip_none(self):
+        nested = {'a': None, 'b': 1,
+                  'c': {'d': None, 'e': 2, 'f': {'g': None}},
+                  'h': [{'i': None, 'j': 3}, None, ({'k': None},)]}
+        prop = self.dict_class(nested)
+        self.assertDictEqual(prop.to_dict(skip_none=True), {
+            'b': 1,
+            'c': {'e': 2, 'f': {}},
+            'h': [{'j': 3}, None, ({},)]})
+        self.assertIsInstance(prop.to_dict(skip_none=True)['h'][2], tuple)
+        # input is not mutated
+        self.assertIsNone(prop.a)
+        self.assertIn('d', prop.c)
+
+    def test_to_dict_keeps_none_by_default(self):
+        nested = {'a': None, 'b': [{'c': None}]}
