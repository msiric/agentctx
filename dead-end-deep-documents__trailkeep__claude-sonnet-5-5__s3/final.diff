+import copy
+
+import pytest
+
+from xmltodict import drop_keys, parse
+
+
+def test_removes_keys_at_any_depth():
+    doc = {'a': {'b': 1, 'c': {'b': 2, 'd': 3}}, 'b': 4}
+    assert drop_keys(doc, ['b']) == {'a': {'c': {'d': 3}}}
+
+
+def test_attribute_keys():
+    doc = parse('<r id="1"><i id="2" n="x">t</i><i id="3"/></r>')
+    assert drop_keys(doc, ['@id']) == {
+        'r': {'i': [{'@n': 'x', '#text': 't'}, {}]}}
+
+
+def test_prefix_must_match_exactly():
+    doc = {'r': {'@id': '1', 'id': '2'}}
+    assert drop_keys(doc, ['id']) == {'r': {'@id': '1'}}
+
+
+def test_dicts_inside_lists_and_scalar_lists():
+    doc = {'r': [{'x': 1, 'y': 2}, 'text', [{'x': 3}], None]}
+    assert drop_keys(doc, {'x'}) == {'r': [{'y': 2}, 'text', [{}], None]}
+
+
+def test_does_not_mutate_input():
+    doc = {'a': {'b': 1, 'c': [{'b': 2, 'd': 3}]}, 'b': 4}
+    snapshot = copy.deepcopy(doc)
+    result = drop_keys(doc, ['b'])
+    assert doc == snapshot
+    assert result is not doc
+    assert result['a'] is not doc['a']
+    assert result['a']['c'] is not doc['a']['c']
+    assert result['a']['c'][0] is not doc['a']['c'][0]
+
+
+def test_no_names_returns_equal_copy():
+    doc = {'a': [{'b': 1}]}
+    result = drop_keys(doc, [])
+    assert result == doc
+    assert result['a'] is not doc['a']
+
+
+def test_string_names_is_single_key_not_characters():
+    doc = {'ab': 1, 'a': 2, 'b': 3}
+    assert drop_keys(doc, 'ab') == {'a': 2, 'b': 3}
+
+
+def test_accepts_any_iterable():
+    assert drop_keys({'a': 1, 'b': 2, 'c': 3}, (n for n in 'ab')) == {'c': 3}
+
+
+def test_non_container_input_returned_as_is():
+    assert drop_keys('x', ['a']) == 'x'
+    assert drop_keys(None, ['a']) is None
+
+
+def test_removing_every_key_leaves_empty_dict():
+    assert drop_keys({'a': {'a': 1}}, ['a']) == {}
+
+
+def test_preserves_key_order():
+    doc = {'z': 1, 'drop': 0, 'a': 2, 'm': {'drop': 0, 'k': 1, 'b': 2}}
+    result = drop_keys(doc, ['drop'])
+    assert list(result) == ['z', 'a', 'm']
+    assert list(result['m']) == ['k', 'b']
+
+
+def test_deeply_nested_does_not_hit_recursion_limit():
+    depth = 3000
+    xml = ''.join('<e id="%d">' % i for i in range(depth)) + \
+        ''.join('</e>' for _ in range(depth))
+    doc = parse(xml)
+    result = drop_keys(doc, ['@id'])
+    node = result['e']
+    for _ in range(depth - 1):
+        assert node == {'e': node['e']}
+        node = node['e']
+    assert node == {}
