         self._write(f"<!--{escape(text)}-->")
 
 
+def drop_keys(doc, names):
+    """Return a copy of ``doc`` with every key in ``names`` removed at any depth.
+
+    Keys are matched exactly, so attribute keys need their prefix (e.g.
+    ``'@id'``). Dicts nested inside lists are handled too. The input is not
+    mutated. Implemented iteratively so deeply nested documents do not hit
+    the recursion limit.
+    """
+    if isinstance(names, (str, bytes)):
+        names = [names]
+    names = frozenset(names)
+
+    def shell(node):
+        return {} if isinstance(node, dict) else []
+
+    def is_container(node):
+        return isinstance(node, (dict, list))
+
+    if not is_container(doc):
+        return doc
+    result = shell(doc)
+    stack = [(doc, result)]
+    while stack:
+        src, dst = stack.pop()
+        items = src.items() if isinstance(src, dict) else enumerate(src)
+        for key, value in items:
+            if isinstance(src, dict) and key in names:
+                continue
+            if is_container(value):
+                child = shell(value)
+                stack.append((value, child))
+                value = child
+            if isinstance(dst, dict):
+                dst[key] = value
+            else:
+                dst.append(value)
+    return result
+
+
 def unparse(input_dict, output=None, encoding='utf-8', full_document=True,
