+
+test('parseBytes() - plain numbers and bytes', t => {
+	t.is(parseBytes('512'), 512);
+	t.is(parseBytes('512 B'), 512);
+	t.is(parseBytes('512B'), 512);
+	t.is(parseBytes('0'), 0);
+	t.is(parseBytes('  512 B  '), 512);
+	t.is(parseBytes('.5 B'), 0.5);
+});
+
+test('parseBytes() - binary units', t => {
+	for (const [exponent, unit] of BINARY_UNITS.entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1024 ** exponent);
+		t.is(parseBytes(`2${unit}`), 2 * (1024 ** exponent));
+		t.is(parseBytes(`1\u00A0${unit}`), 1024 ** exponent);
+	}
+});
+
+test('parseBytes() - fractional values', t => {
+	t.is(parseBytes('1.5 KiB'), 1536);
+	t.is(parseBytes('0.5 MiB'), 524_288);
+});
+
+test('parseBytes() - round trips prettyBytes', t => {
+	for (const bytes of [0, 1, 100, 1024, 1536, 1_048_576, 5_368_709_120]) {
+		t.is(parseBytes(prettyBytes(bytes, {binary: true})), bytes);
+	}
+});
+
+test('parseBytes() - units are case-sensitive', t => {
+	for (const input of ['1 kib', '1 KIB', '1 b', '1 kiB', '1 kb', '1 mB']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError});
+	}
+});
+
+test('parseBytes() - decimal units', t => {
+	for (const [exponent, unit] of DECIMAL_UNITS.entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1000 ** exponent);
+		t.is(parseBytes(`2${unit}`), 2 * (1000 ** exponent));
+	}
+
+	t.is(parseBytes('1.5 kB'), 1500);
+	t.is(parseBytes('1.5 MB'), 1_500_000);
+});
+
+test('parseBytes() - KB is an alias for kB', t => {
+	t.is(parseBytes('1 KB'), 1000);
+	t.is(parseBytes('2.5KB'), 2500);
+});
+
+test('parseBytes() - round trips prettyBytes with decimal units', t => {
+	for (const bytes of [0, 1, 100, 1000, 1500, 1_000_000, 5_000_000_000]) {
+		t.is(parseBytes(prettyBytes(bytes)), bytes);
+	}
+});
+
+test('parseBytes() - unknown units are rejected', t => {
+	for (const input of ['1 mB', '1 Mb', '1 gb', '1 K', '1 Kib', '1 bits']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError, message: /Unsupported unit/});
+	}
+});
+
+test('parseBytes() - invalid input', t => {
+	for (const input of ['', ' ', 'KiB', '1 2 KiB', '1..5', '1e3', '-1', '+1', '1,5 KiB', '1 KiB KiB', 'Infinity']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError});
+	}
+
+	for (const input of [undefined, null, 512, {}]) {
+		t.throws(() => parseBytes(input), {instanceOf: TypeError});
+	}
+});
