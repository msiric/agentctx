diff --git a/index.d.ts b/index.d.ts
index 4fac6e9..ecdff9c 100644
--- a/index.d.ts
+++ b/index.d.ts
@@ -216,3 +216,28 @@ export default function prettyBytes(
 	number: number | bigint,
 	options?: Options
 ): string;
+
+/**
+Convert a human readable size to a number of bytes: `1.5 KiB` → `1536`, `1.5 kB` → `1500`. The reverse of `prettyBytes`.
+
+Understands plain numbers (`'512'`), bytes (`'512 B'`), the decimal units `kB`, `MB`, `GB`, `TB`, `PB`, `EB`, `ZB`, and `YB` (base 1000, with `KB` accepted as an alias for `kB`), and the binary units `KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`, `ZiB`, and `YiB` (base 1024). Fractional values are allowed, the space between the number and the unit is optional, and units are case-sensitive.
+
+@param string - The size to parse.
+@returns The number of bytes.
+@throws A `TypeError` if the input is not a string, and a `SyntaxError` if it is not a valid size or uses an unsupported unit.
+
+@example
+```
+import {parseBytes} from 'pretty-bytes';
+
+parseBytes('512');
+//=> 512
+
+parseBytes('1.5 KiB');
+//=> 1536
+
+parseBytes('1.5 kB');
+//=> 1500
+```
+*/
+export function parseBytes(string: string): number;
diff --git a/index.js b/index.js
index c5f37ab..5fe690d 100644
--- a/index.js
+++ b/index.js
@@ -285,3 +285,41 @@ export default function prettyBytes(number, options) {
 	const result = prefix + numberString + separator + UNITS[exponent];
 	return result.padStart(options.fixedWidth ?? 0);
 }
+
+const BINARY_UNIT_EXPONENTS = new Map(BIBYTE_UNITS.map((unit, exponent) => [unit, exponent]));
+const DECIMAL_UNIT_EXPONENTS = new Map(BYTE_UNITS.map((unit, exponent) => [unit, exponent]));
+
+// `KB` is a common spelling of `kB`.
+DECIMAL_UNIT_EXPONENTS.set('KB', 1);
+
+const NUMBER_WITH_UNIT = /^(?<value>\d+(?:\.\d+)?|\.\d+)\s*(?<unit>[A-Za-z]+)?$/;
+
+/*
+The reverse of `prettyBytes`. Plain numbers, the decimal units (`kB`, `MB`, ... base 1000, plus `KB` as an alias for `kB`) and the binary units (`KiB`, `MiB`, ... base 1024) are understood. Units are otherwise case-sensitive, the same as the output of `prettyBytes`.
+*/
+export function parseBytes(string) {
+	if (typeof string !== 'string') {
+		throw new TypeError(`Expected a string, got ${typeof string}: ${string}`);
+	}
+
+	const match = NUMBER_WITH_UNIT.exec(string.trim());
+
+	if (!match) {
+		throw new SyntaxError(`Unable to parse a byte size from: ${JSON.stringify(string)}`);
+	}
+
+	const {value, unit = 'B'} = match.groups;
+	const binaryExponent = BINARY_UNIT_EXPONENTS.get(unit);
+
+	if (binaryExponent !== undefined) {
+		return Number(value) * (1024 ** binaryExponent);
+	}
+
+	const decimalExponent = DECIMAL_UNIT_EXPONENTS.get(unit);
+
+	if (decimalExponent === undefined) {
+		throw new SyntaxError(`Unsupported unit ${JSON.stringify(unit)} in: ${JSON.stringify(string)}`);
+	}
+
+	return Number(value) * (1000 ** decimalExponent);
+}
