@@ -2100,3 +2101,76 @@ def test_tuple_key_error_message_does_not_crash():
     with raises(SchemaError) as exc_info:
         Schema({("a", "b"): int}).validate({("a", "b"): "not-an-int"})
     assert "Key '('a', 'b')' error:" in exc_info.value.code
+
+
+def test_length_constructor():
+    with raises(TypeError):
+        Length()
+    with raises(ValueError):
+        Length(min=5, max=2)
+    assert repr(Length(min=3, max=40)) == "Length(min=3, max=40)"
+    assert repr(Length(max=4)) == "Length(max=4)"
+    assert Length(min=1).min == 1 and Length(min=1).max is None
+
+
+@mark.parametrize(
+    "value,size",
+    [("abc", 3), ("é", 2), ("日", 3), ("😀", 4), ("", 0)],
+)
+def test_length_counts_utf8_bytes(value, size):
+    assert Schema(Length(min=size, max=size)).validate(value) == value
+    if size > 0:
+        with raises(SchemaError):
+            Schema(Length(max=size - 1)).validate(value)
+    with raises(SchemaError):
+        Schema(Length(min=size + 1)).validate(value)
+
+
+def test_length_inclusive_bounds_and_message():
+    assert Schema(Length(min=2, max=4)).validate("ab") == "ab"
+    assert Schema(Length(min=2, max=4)).validate("abcd") == "abcd"
+    with raises(SchemaError) as e:
+        Schema(Length(max=2)).validate("éé")
+    assert "is 4 bytes in UTF-8 (2 characters), expected at most 2 bytes" in e.value.code
+    with raises(SchemaError) as e:
+        Schema(Length(min=3)).validate("a")
+    assert "at least 3 bytes" in e.value.code
+    with raises(SchemaError) as e:
+        Schema(Length(min=3, max=4)).validate("a")
+    assert "between 3 and 4 bytes" in e.value.code
+
+
+def test_length_truncates_long_data_in_message():
+    with raises(SchemaError) as e:
+        Schema(Length(max=5)).validate("x" * 5000)
+    assert len(e.value.code) < 200
+
+
+def test_length_rejects_non_str_and_surrogates():
+    for bad in (123, None, b"abc", ["a"], {"a": 1}):
+        with raises(SchemaError):
+            Schema(Length(max=10)).validate(bad)
+    with raises(SchemaError) as e:
+        Schema(Length(max=10)).validate("\ud800")
+    assert "not encodable as UTF-8" in e.value.code
+
+
+def test_length_custom_error():
+    with raises(SchemaError) as e:
+        Schema(Length(max=2, error="{!r} too long")).validate("abc")
+    assert e.value.code == "'abc' too long"
+    with raises(SchemaError) as e:
+        Schema(Length(max=2, error="{!r} bad")).validate(5)
+    assert e.value.code == "5 bad"
+
+
+def test_length_in_dict_and_and():
+    s = Schema({"name": And(str, Length(min=1, max=4))})
+    assert s.validate({"name": "abcd"}) == {"name": "abcd"}
+    with raises(SchemaError) as e:
+        s.validate({"name": "abcde"})
+    assert "Key 'name' error:" in e.value.code
+    assert "5 bytes in UTF-8" in e.value.code
+    with raises(SchemaError) as e:
+        Schema({"name": Length(max=2, error="name too long")}).validate({"name": "abc"})
+    assert e.value.code == "name too long"
