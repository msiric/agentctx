+class Length:
+    """
+    Validate that a string's size, counted in UTF-8 *bytes* (not characters),
+    lies within inclusive bounds. At least one of `min` and `max` is required.
+    """
+
+    _MAX_REPR = 40
+
+    def __init__(
+        self,
+        min: Union[int, None] = None,
+        max: Union[int, None] = None,
+        error: Union[str, None] = None,
+    ) -> None:
+        if min is None and max is None:
+            raise TypeError("Length requires at least one of 'min' or 'max'")
+        if min is not None and max is not None and min > max:
+            raise ValueError(f"Length min ({min}) must not be greater than max ({max})")
+        self._min: Union[int, None] = min
+        self._max: Union[int, None] = max
+        self._error: Union[str, None] = error
+
+    def __repr__(self) -> str:
+        parts = []
+        if self._min is not None:
+            parts.append(f"min={self._min}")
+        if self._max is not None:
+            parts.append(f"max={self._max}")
+        return f"{self.__class__.__name__}({', '.join(parts)})"
+
+    @property
+    def min(self) -> Union[int, None]:
+        """The inclusive minimum size in bytes, or None"""
+        return self._min
+
+    @property
+    def max(self) -> Union[int, None]:
+        """The inclusive maximum size in bytes, or None"""
+        return self._max
+
+    @classmethod
+    def _short(cls, data: Any) -> str:
+        text = repr(data)
+        if len(text) > cls._MAX_REPR:
+            text = text[: cls._MAX_REPR] + "..."
+        return text
+
+    def _expected(self) -> str:
+        if self._min is not None and self._max is not None:
+            return f"between {self._min} and {self._max} bytes"
+        if self._min is not None:
+            return f"at least {self._min} bytes"
+        return f"at most {self._max} bytes"
+
+    def validate(self, data: Any, **kwargs: Any) -> str:
+        """
+        Validates the UTF-8 byte size of data.
+        :param data: Data to be validated.
+        :return: Returns validated data.
+        """
+        e = self._error
+        custom = e.format(data) if e else None
+
+        if not isinstance(data, str):
+            raise SchemaError(f"{self._short(data)} should be instance of 'str'", custom)
+        try:
+            size = len(data.encode("utf-8"))
+        except UnicodeEncodeError:  # e.g. lone surrogates
+            raise SchemaError(f"{self._short(data)} is not encodable as UTF-8", custom)
+        if (self._min is not None and size < self._min) or (
+            self._max is not None and size > self._max
+        ):
+            raise SchemaError(
+                f"{self._short(data)} is {size} bytes in UTF-8 "
+                f"({len(data)} characters), expected {self._expected()}",
+                custom,
+            )
+        return data
+
+
