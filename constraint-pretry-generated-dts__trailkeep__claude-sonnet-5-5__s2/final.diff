+test('onRetry runs only when another attempt follows, after the other callbacks', async () => {
+	const order = [];
+	let attempts = 0;
+
+	await assert.rejects(pRetry(async () => {
+		attempts++;
+		throw new Error('fail');
+	}, {
+		retries: 2,
+		minTimeout: 0,
+		shouldConsumeRetry() {
+			order.push('shouldConsumeRetry');
+			return true;
+		},
+		onFailedAttempt() {
+			order.push('onFailedAttempt');
+		},
+		shouldRetry() {
+			order.push('shouldRetry');
+			return true;
+		},
+		onRetry({attemptNumber}) {
+			order.push(`onRetry ${attemptNumber}`);
+		},
+	}), {message: 'fail'});
+
+	assert.equal(attempts, 3);
+	assert.equal(order.filter(name => name.startsWith('onRetry')).length, 2);
+	assert.deepEqual(order.slice(0, 4), ['shouldConsumeRetry', 'onFailedAttempt', 'shouldRetry', 'onRetry 1']);
+	assert.equal(order.at(-1), 'onFailedAttempt');
+});
+
+test('onRetry gets the onFailedAttempt context and is awaited before the wait', {timeout: 60_000}, async t => {
+	await withFakeTime(t);
+	const failedContexts = [];
+	const retryContexts = [];
+	let attempts = 0;
+
+	await pRetry(async () => {
+		attempts++;
+		if (attempts < 3) {
+			throw new Error('fail');
+		}
+	}, {
+		onFailedAttempt(context) {
+			failedContexts.push(context);
+		},
+		async onRetry(context) {
+			await delay(10);
+			retryContexts.push(context);
+		},
+	});
+
+	assert.deepEqual(retryContexts, failedContexts);
+	assert.equal(retryContexts.length, 2);
+	assert.ok(Object.isFrozen(retryContexts[0]));
+});
+
+test('onRetry is not called when no retry follows', async () => {
+	const calls = [];
