+def test_none_values_as_empty_string():
+    obj = {
+        "a": None,
+        "b": 1,
+        "tbl": {"x": None, "y": 2},
+        "inline": {"x": None},
+        "aot": [{"p": None, "q": 1}],
+        "nested": {"inner": {"z": None, "w": "v"}},
+    }
+    out = tomli_w.dumps(obj)
+    assert "None" not in out
+    assert out == (
+        'a = ""\n'
+        "b = 1\n"
+        'aot = [\n    { p = "", q = 1 },\n]\n'
+        "\n[tbl]\n"
+        'x = ""\n'
+        "y = 2\n"
+        "\n[inline]\n"
+        'x = ""\n'
+        "\n[nested.inner]\n"
+        'z = ""\n'
+        'w = "v"\n'
+    )
+
+
+def test_none_in_array():
+    assert tomli_w.dumps({"arr": [1, None]}) == 'arr = [\n    1,\n    "",\n]\n'
+    assert tomli_w.dumps({"arr": [[None], [None, "a"]]}) == (
+        'arr = [\n    [\n        "",\n    ],\n    [\n        "",\n        "a",\n    ],\n]\n'
+    )
+    assert tomli_w.dumps({"t": (None,)}) == 't = [\n    "",\n]\n'
+
+
+def test_none_in_inline_table():
+    assert (
+        tomli_w.dumps({"arr": [{"a": None, "b": 1}]})
+        == 'arr = [\n    { a = "", b = 1 },\n]\n'
+    )
+
+
+def test_none_roundtrip():
+    import sys
+
+    if sys.version_info >= (3, 11):
+        import tomllib
+
+        obj = {"a": None, "l": [None, 1], "t": {"x": None}}
+        assert tomllib.loads(tomli_w.dumps(obj)) == {
+            "a": "",
+            "l": ["", 1],
+            "t": {"x": ""},
+        }
+
+
+def test_none_in_dump():
+    import io
+
+    fp = io.BytesIO()
+    tomli_w.dump({"a": None, "b": 1}, fp)
+    assert fp.getvalue() == b'a = ""\nb = 1\n'
+
+
+def test_pathlib_paths():
+    import pathlib
+
+    p = pathlib.PurePosixPath("/usr/local/bin")
+    assert tomli_w.dumps({"p": p}) == 'p = "/usr/local/bin"\n'
+    assert tomli_w.dumps({"p": pathlib.PurePosixPath("a/b")}) == 'p = "a/b"\n'
+    assert tomli_w.dumps({"t": {"p": p}, "l": [p]}) == (
+        'l = [\n    "/usr/local/bin",\n]\n\n[t]\np = "/usr/local/bin"\n'
+    )
+    assert tomli_w.dumps({"p": pathlib.PureWindowsPath("C:/x/y")}) == (
+        'p = "C:\\\\x\\\\y"\n'
+    )
+    assert tomli_w.dumps({"p": pathlib.Path("rel")}) == 'p = "rel"\n'
