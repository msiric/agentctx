+
+export interface ParsedDataURL {
+  /** Media type including any parameters (e.g. `text/plain;charset=utf-8`). Defaults to `text/plain`. */
+  mimeType: string;
+  /** Whether the payload is base64-encoded. */
+  base64: boolean;
+  /** The raw payload after the first comma (not percent- or base64-decoded). */
+  data: string;
+}
+
+/**
+ * Parses a `data:` URL into its `mimeType`, `base64` flag and raw `data` payload.
+ *
+ * Throws a `TypeError` if the input is not a valid `data:` URL.
+ *
+ * @example
+ *
+ * ```js
+ * parseDataURL("data:text/plain;base64,SGVsbG8=");
+ * // { mimeType: 'text/plain', base64: true, data: 'SGVsbG8=' }
+ *
+ * parseDataURL("data:,Hello");
+ * // { mimeType: 'text/plain', base64: false, data: 'Hello' }
+ * ```
+ *
+ * @group parsing_utils
+ *
+ * @param input - The data URL to parse.
+ */
+export function parseDataURL(input: string): ParsedDataURL {
+  const match = String(input).match(/^[\s\0]*data:([^,]*),([\s\S]*)$/i);
+  if (!match) {
+    throw new TypeError("Invalid data URL");
+  }
+  const [, meta, data] = match;
+  const parts = meta.split(";").map((p) => p.trim());
+  let base64 = false;
+  if (parts.length > 1 && parts.at(-1).toLowerCase() === "base64") {
+    base64 = true;
+    parts.pop();
+  }
+  const [type, ...params] = parts;
+  const mimeType = [type || "text/plain", ...params.filter(Boolean)].join(";");
+  return { mimeType, base64, data };
+}
