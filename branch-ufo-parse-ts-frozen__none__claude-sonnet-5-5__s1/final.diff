+
+describe("parseDataURL", () => {
+  const tests = [
+    ["data:,Hello", { mimeType: "text/plain", base64: false, data: "Hello" }],
+    [
+      "data:text/plain;base64,SGVsbG8=",
+      { mimeType: "text/plain", base64: true, data: "SGVsbG8=" },
+    ],
+    [
+      "data:text/html,<h1>Hi</h1>",
+      { mimeType: "text/html", base64: false, data: "<h1>Hi</h1>" },
+    ],
+    [
+      "data:text/plain;charset=utf-8,a%20b",
+      { mimeType: "text/plain;charset=utf-8", base64: false, data: "a%20b" },
+    ],
+    [
+      "data:;base64,SGk=",
+      { mimeType: "text/plain", base64: true, data: "SGk=" },
+    ],
+    [
+      "data:;charset=utf-8;base64,SGk=",
+      { mimeType: "text/plain;charset=utf-8", base64: true, data: "SGk=" },
+    ],
+    [
+      "DATA:image/png;BASE64,AAAA",
+      { mimeType: "image/png", base64: true, data: "AAAA" },
+    ],
+    [
+      "data:text/plain,a,b",
+      { mimeType: "text/plain", base64: false, data: "a,b" },
+    ],
+    ["data:text/plain,", { mimeType: "text/plain", base64: false, data: "" }],
+  ] as const;
+
+  for (const [input, out] of tests) {
+    test(input, () => {
+      expect(parseDataURL(input)).toEqual(out);
+    });
+  }
+
+  test("throws on invalid input", () => {
+    expect(() => parseDataURL("https://example.com")).toThrow(TypeError);
+    expect(() => parseDataURL("data:text/plain")).toThrow(TypeError);
+    expect(() => parseDataURL("")).toThrow(TypeError);
+  });
+});
