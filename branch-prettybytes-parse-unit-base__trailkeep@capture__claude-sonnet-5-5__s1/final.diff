+
+test('parseBytes: plain numbers and bytes', t => {
+	t.is(parseBytes('512'), 512);
+	t.is(parseBytes('512 B'), 512);
+	t.is(parseBytes('512B'), 512);
+	t.is(parseBytes('0'), 0);
+	t.is(parseBytes('  512  '), 512);
+	t.is(parseBytes('1.5'), 1.5);
+	t.is(parseBytes('.5 B'), 0.5);
+	t.is(parseBytes('+42 B'), 42);
+	t.is(parseBytes('-42 B'), -42);
+	t.true(Object.is(parseBytes('-0'), 0));
+});
+
+test('parseBytes: binary units', t => {
+	for (const [exponent, unit] of BINARY_UNITS.entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1024 ** exponent);
+		t.is(parseBytes(`1${unit}`), 1024 ** exponent);
+		t.is(parseBytes(`1\u00A0${unit}`), 1024 ** exponent);
+	}
+
+	t.is(parseBytes('1.5 KiB'), 1536);
+	t.is(parseBytes('0.5 MiB'), 524_288);
+	t.is(parseBytes('2.25 GiB'), 2.25 * (1024 ** 3));
+});
+
+test('parseBytes: round-trips prettyBytes output', t => {
+	for (const value of [0, 1, 512, 1024, 1536, 1024 ** 2, 5 * (1024 ** 4)]) {
+		t.is(parseBytes(prettyBytes(value, {binary: true})), value);
+		t.is(parseBytes(prettyBytes(value, {binary: true, space: false})), value);
+		t.is(parseBytes(prettyBytes(value, {binary: true, nonBreakingSpace: true})), value);
+	}
+});
+
+test('parseBytes: units are case-sensitive', t => {
+	for (const input of ['1 kib', '1 KIB', '1 kiB', '1 b', '1 mib']) {
+		t.throws(() => {
+			parseBytes(input);
+		}, {instanceOf: SyntaxError}, `${input}`);
+	}
+});
+
+test('parseBytes: units without the i are powers of 1024', t => {
+	for (const [exponent, unit] of ['B', 'kB', 'MB', 'GB', 'TB', 'PB', 'EB', 'ZB', 'YB'].entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1024 ** exponent);
+		t.is(parseBytes(`1${unit}`), 1024 ** exponent);
+	}
+
+	t.is(parseBytes('1 KB'), 1024);
+	t.is(parseBytes('1.5 kB'), 1536);
+	t.is(parseBytes('1 MB'), 1_048_576);
+});
+
+test('parseBytes: unknown units', t => {
+	for (const unit of ['kb', 'mB', 'Kb', 'k', 'Ki', 'K', 'M', 'kbit']) {
+		t.throws(() => parseBytes(`1 ${unit}`), {instanceOf: SyntaxError}, `${unit}`);
+	}
+});
+
+test('parseBytes: invalid input', t => {
+	for (const input of ['', ' ', 'KiB', 'abc', '1..5', '1.5.5', '1e3', '1 2 KiB', '--1', '1,5 KiB', 'NaN', 'Infinity', '0x10']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError}, `${JSON.stringify(input)}`);
+	}
+
+	for (const input of [undefined, null, 512, 1n, {}]) {
+		t.throws(() => parseBytes(input), {instanceOf: TypeError});
+	}
+
+	t.throws(() => parseBytes(`1${'0'.repeat(400)} B`), {instanceOf: RangeError});
+});
