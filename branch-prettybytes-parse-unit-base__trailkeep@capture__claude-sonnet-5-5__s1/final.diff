index 4fac6e9..48331b5 100644
--- a/index.d.ts
+++ b/index.d.ts
@@ -216,3 +216,29 @@ export default function prettyBytes(
 	number: number | bigint,
 	options?: Options
 ): string;
+
+/**
+Convert a human readable size string to a number of bytes: `1.5 KiB` → `1536`. The reverse of `prettyBytes`.
+
+Accepts a plain number (`'512'`), or a number followed by `B` or a unit, with optional whitespace between them. Fractional values and a leading sign are allowed. Units are case-sensitive.
+
+Both the binary units (`KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`, `ZiB`, `YiB`) and the units without the `i` (`kB`, `KB`, `MB`, `GB`, `TB`, `PB`, `EB`, `ZB`, `YB`) are powers of 1024, so `1 KB` and `1 kB` are both `1024`. This differs from `prettyBytes`, which uses powers of 1000 for those units unless `binary` is enabled.
+
+The result is not rounded, so `'1.5 B'` is `1.5`.
+
+@param string - The string to parse.
+@returns The number of bytes.
+@throws A `TypeError` if the input is not a string, a `SyntaxError` if it cannot be parsed or has an unsupported unit, and a `RangeError` if the result is not finite.
+
+@example
+```
+import {parseBytes} from 'pretty-bytes';
+
+parseBytes('512');
+//=> 512
+
+parseBytes('1.5 KiB');
+//=> 1536
+```
+*/
+export function parseBytes(string: string): number;
diff --git a/index.js b/index.js
index c5f37ab..e52fd22 100644
--- a/index.js
+++ b/index.js
@@ -285,3 +285,44 @@ export default function prettyBytes(number, options) {
 	const result = prefix + numberString + separator + UNITS[exponent];
 	return result.padStart(options.fixedWidth ?? 0);
 }
+
+// Units without the `i` (`KB`, `kB`, `MB`, …) are also powers of 1024, matching how sizes are shown in Windows Explorer.
+const PARSE_UNIT_EXPONENTS = new Map([
+	...BIBYTE_UNITS.map((unit, exponent) => [unit, exponent]),
+	...BYTE_UNITS.map((unit, exponent) => [unit, exponent]),
+	['KB', 1],
+]);
+
+// An optional sign, a decimal number (`512`, `1.5`, `.5`, `5.`), and an optional unit, separated by optional whitespace, including the non-breaking space `prettyBytes` can emit.
+const PARSE_PATTERN = /^([+-]?(?:\d+\.?\d*|\.\d+))[\s\u00A0]*([A-Za-z]*)$/;
+
+/*
+The reverse of `prettyBytes` for plain numbers and byte units. Both the binary units (`KiB`, `MiB`, …) and the units without the `i` (`kB`, `KB`, `MB`, …) are powers of 1024. Units are case-sensitive, like the output of `prettyBytes`.
+*/
+export function parseBytes(string) {
+	if (typeof string !== 'string') {
+		throw new TypeError(`Expected a string, got ${typeof string}: ${string}`);
+	}
+
+	const match = PARSE_PATTERN.exec(string.trim());
+
+	if (!match) {
+		throw new SyntaxError(`Cannot parse bytes from: ${JSON.stringify(string)}`);
+	}
+
+	const [, numberString, unit = ''] = match;
+	const exponent = unit === '' ? 0 : PARSE_UNIT_EXPONENTS.get(unit);
+
+	if (exponent === undefined) {
+		throw new SyntaxError(`Unsupported unit ${JSON.stringify(unit)} in: ${JSON.stringify(string)}`);
+	}
+
+	const bytes = Number(numberString) * (1024 ** exponent);
+
+	if (!Number.isFinite(bytes)) {
+		throw new RangeError(`Value is too large: ${JSON.stringify(string)}`);
+	}
+
+	// Normalize `-0` to `0`.
+	return bytes === 0 ? 0 : bytes;
+}
