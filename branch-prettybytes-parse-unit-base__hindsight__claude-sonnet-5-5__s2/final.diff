 	t.is(prettyBytes(1337, {fixedWidth: 8, nonBreakingSpace: true}), ' 1.34\u00A0kB');
 });
 
+test('parseBytes: plain numbers and bytes', t => {
+	t.is(parseBytes('512'), 512);
+	t.is(parseBytes('512 B'), 512);
+	t.is(parseBytes('512B'), 512);
+	t.is(parseBytes('0'), 0);
+	t.is(parseBytes('  512  '), 512);
+	t.is(parseBytes('.5 B'), 0.5);
+});
+
+test('parseBytes: binary units', t => {
+	for (const [exponent, unit] of BINARY_UNITS.entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1024 ** exponent, `${unit}`);
+		t.is(parseBytes(`2${unit}`), 2 * (1024 ** exponent), `${unit}`);
+	}
+});
+
+test('parseBytes: fractional values', t => {
+	t.is(parseBytes('1.5 KiB'), 1536);
+	t.is(parseBytes('0.5 MiB'), 524_288);
+	t.is(parseBytes('.25 KiB'), 256);
+});
+
+test('parseBytes: round-trips prettyBytes binary output', t => {
+	for (const bytes of [0, 1, 512, 1024, 1536, 1024 ** 3, 5 * (1024 ** 4)]) {
+		t.is(parseBytes(prettyBytes(bytes, {binary: true})), bytes);
+	}
+});
+
+test('parseBytes: units are case-sensitive', t => {
+	for (const input of ['1 kib', '1 KIB', '1 kiB', '1 mib', '1 b', '1 Kib', '1 kb', '1 mb', '1 Mb', '1 gB']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError}, `${input}`);
+	}
+});
+
+test('parseBytes: decimal units', t => {
+	for (const [exponent, unit] of DECIMAL_UNITS.entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1000 ** exponent, `${unit}`);
+		t.is(parseBytes(`2${unit}`), 2 * (1000 ** exponent), `${unit}`);
+	}
+
+	t.is(parseBytes('1.5 kB'), 1500);
+	t.is(parseBytes('1.5 MB'), 1_500_000);
+});
+
+test('parseBytes: KB is an alias for kB', t => {
+	t.is(parseBytes('1 KB'), 1000);
+	t.is(parseBytes('2.5KB'), 2500);
+});
+
+test('parseBytes: round-trips prettyBytes decimal output', t => {
+	for (const bytes of [0, 1, 999, 1000, 1500, 1_000_000, 5 * (1000 ** 4)]) {
+		t.is(parseBytes(prettyBytes(bytes)), bytes);
+	}
+});
+
+test('parseBytes: invalid input', t => {
+	for (const input of ['', ' ', 'KiB', '-1 KiB', '+1 KiB', '1..5 KiB', '1.5.2 KiB', '1,5 KiB', '1e3', '1 KiB KiB', '1 Ki', 'abc', '1 bit']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError}, `${JSON.stringify(input)}`);
+	}
+
+	for (const input of [1, undefined, null, {}]) {
+		t.throws(() => parseBytes(input), {instanceOf: TypeError});
+	}
+});
