index 48aa7b7..0975721 100644
--- a/readme.md
+++ b/readme.md
@@ -240,6 +240,34 @@ prettyBytes(100_000, {fixedWidth: 10});
 //=> ['    1 kB', '   10 kB', '  100 kB']
 ```
 
+### parseBytes(string)
+
+The reverse of `prettyBytes()`: returns the number of bytes for a size string.
+
+Accepts a plain number (`'512'`), or a number followed by one of these units:
+
+- `B`
+- Decimal, powers of 1000: `kB`, `MB`, `GB`, `TB`, `PB`, `EB`, `ZB`, `YB`
+- Binary, powers of 1024: `KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`, `ZiB`, `YiB`
+
+`KB` is accepted as an alias for `kB` and means 1000 bytes, not 1024. Fractional values are allowed, so `'1.5 KiB'` is `1536` and `'1.5 kB'` is `1500`. Units are case-sensitive (`mb` and `kib` are rejected) and the result is not rounded. Throws a `TypeError` for a non-string and a `SyntaxError` for anything that is not a valid size.
+
+```js
+import {parseBytes} from 'pretty-bytes';
+
+parseBytes('512');
+//=> 512
+
+parseBytes('1.5 kB');
+//=> 1500
+
+parseBytes('1.5 KiB');
+//=> 1536
+
+parseBytes(prettyBytes(1337));
+//=> 1340
+```
+
 ## FAQ
 
 ### Why kB and not KB?
