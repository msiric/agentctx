diff --git a/index.d.ts b/index.d.ts
index 4fac6e9..0874861 100644
--- a/index.d.ts
+++ b/index.d.ts
@@ -216,3 +216,16 @@ export default function prettyBytes(
 	number: number | bigint,
 	options?: Options
 ): string;
+
+/**
+Convert a size string to a number of bytes, the reverse of `prettyBytes()`: `'1.5 KiB'` → `1536` and `'1.5 kB'` → `1500`.
+
+Accepts a plain number (`'512'`), or a number followed by `B`, a binary unit (`KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`, `ZiB`, `YiB`; powers of 1024), or a decimal unit (`kB`, `MB`, `GB`, `TB`, `PB`, `EB`, `ZB`, `YB`; powers of 1000), with optional whitespace in between. Fractional values are allowed. Units are case-sensitive, and the result is not rounded.
+
+`KB` is accepted as an alias for `kB` and means 1000 bytes, not 1024.
+
+@param string - The size to parse.
+@returns The number of bytes.
+@throws A `TypeError` if the input is not a string, or a `SyntaxError` if it is not a valid size or uses an unsupported unit.
+*/
+export function parseBytes(string: string): number;
diff --git a/index.js b/index.js
index c5f37ab..afe8e78 100644
--- a/index.js
+++ b/index.js
@@ -285,3 +285,33 @@ export default function prettyBytes(number, options) {
 	const result = prefix + numberString + separator + UNITS[exponent];
 	return result.padStart(options.fixedWidth ?? 0);
 }
+
+// Decimal units are powers of 1000, matching `prettyBytes()` without `binary`. `KB` is accepted as an alias for `kB`.
+const PARSEABLE_UNITS = new Map([
+	...BIBYTE_UNITS.map((unit, exponent) => [unit, 1024 ** exponent]),
+	...BYTE_UNITS.slice(1).map((unit, index) => [unit, 1000 ** (index + 1)]),
+	['KB', 1000],
+]);
+
+const BYTES_PATTERN = /^(?<value>\d+(?:\.\d+)?|\.\d+)\s*(?<unit>[A-Za-z]+)?$/;
+
+export function parseBytes(string) {
+	if (typeof string !== 'string') {
+		throw new TypeError(`Expected a string, got \`${typeof string}\``);
+	}
+
+	const match = BYTES_PATTERN.exec(string.trim());
+
+	if (!match) {
+		throw new SyntaxError(`Invalid byte size: \`${string}\``);
+	}
+
+	const {value, unit = 'B'} = match.groups;
+	const multiplier = PARSEABLE_UNITS.get(unit);
+
+	if (multiplier === undefined) {
+		throw new SyntaxError(`Unsupported unit \`${unit}\` in \`${string}\`. Supported units: ${[...PARSEABLE_UNITS.keys()].join(', ')}`);
+	}
+
+	return Number(value) * multiplier;
+}
