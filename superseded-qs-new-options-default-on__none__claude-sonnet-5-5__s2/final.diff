diff --git a/test/parse.js b/test/parse.js
index 00a1abf..10d8f21 100644
--- a/test/parse.js
+++ b/test/parse.js
@@ -1492,3 +1492,40 @@ test('rejects an invalid `arrayFormatSeparator`', () => {
 
 	assert.deepEqual(structuredClone(queryString.parse('foo=a·b', {arrayFormat: 'separator', arrayFormatSeparator: '·'})), {foo: ['a', 'b']});
 });
+
+test('`ignoreEmpty` drops parameters with an empty value', () => {
+	assert.deepEqual(structuredClone(queryString.parse('?q=&page=2', {ignoreEmpty: true})), {page: '2'});
+	assert.deepEqual(structuredClone(queryString.parse('?q=&page=2')), {q: '', page: '2'});
+	assert.deepEqual(structuredClone(queryString.parse('?flag&q=&page=2', {ignoreEmpty: true})), {flag: null, page: '2'});
+	assert.deepEqual(structuredClone(queryString.parse('?q=&q=1&q=', {ignoreEmpty: true})), {q: '1'});
+	assert.deepEqual(structuredClone(queryString.parse('?q=', {ignoreEmpty: true})), {});
+	assert.deepEqual(structuredClone(queryString.parse('?q=%20&r=+', {ignoreEmpty: true})), {q: ' ', r: ' '});
+	assert.deepEqual(structuredClone(queryString.parse('?q=&r=1,,2', {ignoreEmpty: true, arrayFormat: 'comma'})), {r: ['1', '', '2']});
+});
+
+test('`ignoreEmpty` drops empty array items', () => {
+	assert.deepEqual(structuredClone(queryString.parse('?tag[]=&tag[]=a', {arrayFormat: 'bracket', ignoreEmpty: true})), {tag: ['a']});
+	assert.deepEqual(structuredClone(queryString.parse('?tag[]=', {arrayFormat: 'bracket', ignoreEmpty: true})), {});
+	assert.deepEqual(structuredClone(queryString.parse('?tag[]=&tag[]=a', {arrayFormat: 'bracket'})), {tag: ['', 'a']});
+});
+
+test('`stripTracking` drops the tracking parameters', () => {
+	assert.deepEqual(structuredClone(queryString.parse('?q=shoes&utm_source=a&utm_medium=b&fbclid=c&gclid=d', {stripTracking: true})), {q: 'shoes'});
+	assert.deepEqual(structuredClone(queryString.parse('?q=shoes&utm_source=a&fbclid=c&gclid=d')), {
+		q: 'shoes',
+		utm_source: 'a', // eslint-disable-line camelcase
+		fbclid: 'c',
+		gclid: 'd',
+	});
+	assert.deepEqual(structuredClone(queryString.parse('?UTM_Source=a&FBCLID=c&q=1', {stripTracking: true})), {q: '1'});
+	assert.deepEqual(structuredClone(queryString.parse('?utm_source&utm_x=1&q=1', {stripTracking: true})), {q: '1'});
+	assert.deepEqual(structuredClone(queryString.parse('?utm%5Fsource=a&q=1', {stripTracking: true})), {q: '1'});
+	assert.deepEqual(structuredClone(queryString.parse('?utm_tag[]=a&q=1', {stripTracking: true, arrayFormat: 'bracket'})), {q: '1'});
+	assert.deepEqual(structuredClone(queryString.parse('?utm=1&xutm_source=1&fbclid2=1&my_gclid=1', {stripTracking: true})), {
+		utm: '1',
+		xutm_source: '1', // eslint-disable-line camelcase
+		fbclid2: '1',
+		my_gclid: '1', // eslint-disable-line camelcase
+	});
+	assert.deepEqual(structuredClone(queryString.parse('?utm_source=a', {stripTracking: true})), {});
+});
