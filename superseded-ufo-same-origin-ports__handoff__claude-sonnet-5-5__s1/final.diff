 }
+
+function getOrigin(input: string | URL | null | undefined): string | undefined {
+  if (input === undefined || input === null || input === "") {
+    return undefined;
+  }
+  try {
+    // No base: relative and protocol-relative inputs throw
+    const { origin } = new URL(input);
+    // Opaque origins (data:, mailto:, javascript:, file:) serialize as "null"
+    return origin === "null" ? undefined : origin;
+  } catch {
+    return undefined;
+  }
+}
+
+/**
+ * Check if two URLs have the same origin (scheme, host and port).
+ *
+ * Path, query, hash and userinfo are ignored, and default ports are
+ * normalized (`https://a.com` matches `https://a.com:443`).
+ * Inputs without an absolute origin (relative, protocol-relative, opaque
+ * schemes, malformed or nullish) always return `false`.
+ *
+ * @example
+ * ```js
+ * isSameOrigin("https://a.com/x", "https://a.com/y"); // true
+ * isSameOrigin("https://a.com", "https://a.com:8443"); // false
+ * isSameOrigin("/a", "/a"); // false
+ * ```
+ */
+export function isSameOrigin(
+  a: string | URL | null | undefined,
+  b: string | URL | null | undefined,
+): boolean {
+  const originA = getOrigin(a);
+  return originA !== undefined && originA === getOrigin(b);
+}
