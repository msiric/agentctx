+++ b/test/same-origin.test.ts
@@ -0,0 +1,114 @@
+import { describe, expect, test } from "vitest";
+import { isSameOrigin } from "../src";
+
+// Proposed semantics: two inputs are same-origin when scheme, host and port
+// match. Default ports are normalized (https://a.com ~ https://a.com:443).
+// Path, query, hash and userinfo are ignored.
+// Inputs without an absolute origin (relative, protocol-relative, opaque
+// schemes) are never same-origin, even with themselves.
+
+describe("isSameOrigin", () => {
+  describe("same origin", () => {
+    test.each([
+      ["https://example.com", "https://example.com"],
+      ["https://example.com", "https://example.com/"],
+      ["https://example.com/a", "https://example.com/b"],
+      ["https://example.com/a?x=1#h", "https://example.com/b?y=2"],
+      ["http://localhost:3000/a", "http://localhost:3000/b"],
+      ["https://example.com:443/a", "https://example.com:443/b"],
+    ])("%s ~ %s", (a, b) => {
+      expect(isSameOrigin(a, b)).toBe(true);
+      expect(isSameOrigin(b, a)).toBe(true);
+    });
+
+    test("scheme and host are case-insensitive", () => {
+      expect(isSameOrigin("HTTPS://Example.COM/a", "https://example.com/b")).toBe(true);
+    });
+
+    test("userinfo is ignored", () => {
+      expect(isSameOrigin("https://user:pw@example.com/a", "https://example.com/b")).toBe(true);
+    });
+
+    test("IDN host matches its punycode form", () => {
+      expect(isSameOrigin("https://münchen.de", "https://xn--mnchen-3ya.de")).toBe(true);
+    });
+
+    test("trailing dot in host is NOT normalized (distinct origin)", () => {
+      expect(isSameOrigin("https://example.com.", "https://example.com")).toBe(false);
+    });
+  });
+
+  describe("default ports are normalized", () => {
+    test.each([
+      ["https://example.com", "https://example.com:443"],
+      ["http://example.com", "http://example.com:80"],
+      ["wss://example.com", "wss://example.com:443"],
+      ["ftp://example.com", "ftp://example.com:21"],
+      ["https://example.com/a", "https://example.com:443/a"],
+    ])("%s ~ %s", (a, b) => {
+      expect(isSameOrigin(a, b)).toBe(true);
+      expect(isSameOrigin(b, a)).toBe(true);
+    });
+
+    test("non-default ports still differ", () => {
+      expect(isSameOrigin("https://example.com", "https://example.com:8443")).toBe(false);
+      expect(isSameOrigin("https://example.com", "https://example.com:80")).toBe(false);
+    });
+  });
+
+  describe("different origin", () => {
+    test.each([
+      ["http://example.com", "https://example.com"], // scheme
+      ["https://example.com", "https://example.org"], // host
+      ["https://example.com", "https://www.example.com"], // subdomain
+      ["https://example.com", "https://sub.example.com"],
+      ["https://example.com", "https://example.com:8443"], // port
+      ["http://example.com:80", "http://example.com:8080"],
+      ["https://example.com:443", "http://example.com:443"], // port equal, scheme differs
+      ["https://example.com", "https://example.com.evil.com"], // suffix trick
+      ["https://example.com@evil.com", "https://example.com"], // userinfo trick
+      ["https://example.com", "wss://example.com"],
+    ])("%s !~ %s", (a, b) => {
+      expect(isSameOrigin(a, b)).toBe(false);
+      expect(isSameOrigin(b, a)).toBe(false);
+    });
+  });
+
+  describe("no absolute origin", () => {
+    test.each([
+      ["/a", "/a"], // relative paths
+      ["a/b", "a/b"],
+      ["", ""],
+      ["//example.com/a", "//example.com/b"], // protocol-relative
+      ["//example.com/a", "https://example.com/a"],
+      ["/a", "https://example.com/a"],
+      ["data:text/plain,hi", "data:text/plain,hi"], // opaque origins
+      ["mailto:a@example.com", "mailto:a@example.com"],
+      ["javascript:void(0)", "javascript:void(0)"],
+      ["file:///a", "file:///a"],
+    ])("%s vs %s is false", (a, b) => {
+      expect(isSameOrigin(a, b)).toBe(false);
+    });
+
+    test("nullish and non-string inputs are false", () => {
+      expect(isSameOrigin(undefined, "https://example.com")).toBe(false);
+      expect(isSameOrigin("https://example.com", undefined)).toBe(false);
+      expect(isSameOrigin(undefined, undefined)).toBe(false);
+    });
+  });
+
+  describe("URL objects", () => {
+    test("accepts URL instances alongside strings", () => {
+      expect(isSameOrigin(new URL("https://example.com/a"), "https://example.com/b")).toBe(true);
+      expect(isSameOrigin(new URL("https://example.com"), new URL("https://example.org"))).toBe(false);
+    });
+  });
+
+  describe("malformed input", () => {
+    test("does not throw, returns false", () => {
+      expect(isSameOrigin("http://", "http://")).toBe(false);
+      expect(isSameOrigin("https://exa mple.com", "https://exa mple.com")).toBe(false);
+      expect(isSameOrigin("https://example.com:99999", "https://example.com:99999")).toBe(false);
+    });
+  });
+});
