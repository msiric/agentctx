@@ -216,3 +216,30 @@ export default function prettyBytes(
 	number: number | bigint,
 	options?: Options
 ): string;
+
+/**
+Parse a human readable size string into a number of bytes. The reverse of `prettyBytes(number, {binary: true})`.
+
+Supported are plain numbers and the units `B`, `KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`, `ZiB`, and `YiB`. The units without the `i` (`kB` or `KB`, `MB`, `GB`, `TB`, `PB`, `EB`, `ZB`, `YB`) are read as powers of 1024, so `'1 MB'` is `1048576`. Units are case-sensitive. Fractional values are allowed, and the separator between the number and the unit is optional.
+
+Note: Fractional results are not rounded, so `'1.5 B'` is `1.5`.
+
+@param string - The string to parse, like `'1.5 KiB'`.
+@returns The number of bytes.
+@throws A `TypeError` if the input is not a string, and a `SyntaxError` if it cannot be parsed or has an unsupported unit.
+
+@example
+```
+import {parseBytes} from 'pretty-bytes';
+
+parseBytes('512');
+//=> 512
+
+parseBytes('1.5 KiB');
+//=> 1536
+
+parseBytes('1 MB');
+//=> 1048576
+```
+*/
+export function parseBytes(string: string): number;
diff --git a/index.js b/index.js
index c5f37ab..be4b02f 100644
--- a/index.js
+++ b/index.js
@@ -285,3 +285,38 @@ export default function prettyBytes(number, options) {
 	const result = prefix + numberString + separator + UNITS[exponent];
 	return result.padStart(options.fixedWidth ?? 0);
 }
+
+const BIBYTE_EXPONENTS = new Map(BIBYTE_UNITS.map((unit, index) => [unit, index]));
+
+// Units without the `i` are read as powers of 1024, like Windows Explorer does, not as powers of 1000.
+for (const [index, unit] of BYTE_UNITS.entries()) {
+	BIBYTE_EXPONENTS.set(unit, index);
+}
+
+BIBYTE_EXPONENTS.set('KB', 1);
+
+// Output of `prettyBytes` can be padded (`fixedWidth`) or signed, so surrounding whitespace and a leading sign are accepted. The separator is a space, a non-breaking space or nothing, the same as `prettyBytes` writes.
+const BYTES_PATTERN = /^(?<sign>[+-]?)(?<value>\d+(?:\.\d+)?|\.\d+)[ \u00A0]?(?<unit>[A-Za-z]*)$/;
+
+export function parseBytes(string) {
+	if (typeof string !== 'string') {
+		throw new TypeError(`Expected a string, got ${typeof string}: ${string}`);
+	}
+
+	const match = BYTES_PATTERN.exec(string.trim());
+
+	if (!match) {
+		throw new SyntaxError(`Unable to parse bytes from: ${JSON.stringify(string)}`);
+	}
+
+	const {sign, value, unit} = match.groups;
+	const exponent = unit === '' ? 0 : BIBYTE_EXPONENTS.get(unit);
+
+	if (exponent === undefined) {
+		throw new SyntaxError(`Unsupported unit ${JSON.stringify(unit)} in: ${JSON.stringify(string)}. Supported units are ${[...BIBYTE_EXPONENTS.keys()].join(', ')} (case-sensitive).`);
+	}
+
+	const bytes = Number(value) * (1024 ** exponent);
+
+	return sign === '-' && bytes !== 0 ? -bytes : bytes;
+}
