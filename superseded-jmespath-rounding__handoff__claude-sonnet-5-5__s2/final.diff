+from tests import unittest
+
+from jmespath import dashboard, exceptions
+
+
+class TestDashboardFunctions(unittest.TestCase):
+    def test_round_to(self):
+        self.assertEqual(dashboard.search('round_to(a, `2`)', {'a': 3.14159}), 3.14)
+        self.assertEqual(dashboard.search('round_to(a, `0`)', {'a': 2.6}), 3)
+
+    def test_round_to_is_half_to_even(self):
+        # Matches Python's round() and pandas, not round-half-up.
+        for value, expected in [(0.5, 0), (1.5, 2), (2.5, 2), (3.5, 4), (-2.5, -2)]:
+            self.assertEqual(
+                dashboard.search('round_to(a, `0`)', {'a': value}), expected)
+        self.assertEqual(dashboard.search('round_to(`2.5`, `0`)', {}), 2)
+
+    def test_round_to_rejects_bad_args(self):
+        with self.assertRaises(exceptions.JMESPathTypeError):
+            dashboard.search('round_to(a, `1.5`)', {'a': 1})
+        with self.assertRaises(exceptions.JMESPathTypeError):
+            dashboard.search('round_to(a, `1`)', {'a': 'x'})
+
+    def test_clamp(self):
+        for value, expected in [(5, 5), (-1, 0), (11, 10), (0, 0), (10, 10),
+                                (2.5, 2.5)]:
+            self.assertEqual(
+                dashboard.search('clamp(a, `0`, `10`)', {'a': value}), expected)
+
+    def test_clamp_rejects_bad_args(self):
+        with self.assertRaises(exceptions.JMESPathError):
+            dashboard.search('clamp(a, `10`, `0`)', {'a': 1})
+        with self.assertRaises(exceptions.JMESPathTypeError):
+            dashboard.search('clamp(a, `0`, `10`)', {'a': 'x'})
+
+    def test_percent(self):
+        self.assertEqual(
+            dashboard.search('percent(a, b, `1`)', {'a': 1, 'b': 3}), 33.3)
+        self.assertEqual(
+            dashboard.search('percent(a, b, `0`)', {'a': 1, 'b': 4}), 25)
+
+    def test_percent_rounds_half_away_from_zero(self):
+        # 0.5%, 1.5%, 2.5%, -2.5% at 0 digits
+        for part, expected in [(0.5, 1), (1.5, 2), (2.5, 3), (-2.5, -3),
+                               (-0.5, -1)]:
+            self.assertEqual(
+                dashboard.search('percent(a, `100`, `0`)', {'a': part}),
+                expected)
+        self.assertEqual(
+            dashboard.search('percent(a, `1000`, `1`)', {'a': 1.25}), 0.1)
+        self.assertEqual(
+            dashboard.search('percent(a, `200`, `2`)', {'a': 1.005}), 0.5)
+
+    def test_percent_rejects_bad_args(self):
+        with self.assertRaises(exceptions.JMESPathError):
+            dashboard.search('percent(a, `0`, `1`)', {'a': 1})
+        with self.assertRaises(exceptions.JMESPathTypeError):
+            dashboard.search('percent(a, `1`, `1.5`)', {'a': 1})
+        with self.assertRaises(exceptions.JMESPathTypeError):
+            dashboard.search('percent(a, `1`, `1`)', {'a': 'x'})
+
+    def test_builtins_still_available(self):
+        self.assertEqual(dashboard.search('abs(a)', {'a': -1}), 1)
