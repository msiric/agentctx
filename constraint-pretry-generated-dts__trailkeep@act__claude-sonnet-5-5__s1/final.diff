+test('onRetry runs only when another attempt follows, after onFailedAttempt and shouldRetry', async () => {
+	const order = [];
+	let calls = 0;
+
+	await assert.rejects(pRetry(async () => {
+		throw new Error(`fail ${++calls}`);
+	}, {
+		retries: 2,
+		minTimeout: 0,
+		onFailedAttempt({attemptNumber}) {
+			order.push(`failed ${attemptNumber}`);
+		},
+		shouldRetry() {
+			order.push('shouldRetry');
+			return true;
+		},
+		async onRetry(context) {
+			await Promise.resolve();
+			order.push(`retry ${context.attemptNumber}`);
