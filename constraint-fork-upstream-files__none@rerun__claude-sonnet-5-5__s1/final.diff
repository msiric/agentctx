diff --git a/test/dashdash.js b/test/dashdash.js
new file mode 100644
index 0000000..83d6936
--- /dev/null
+++ b/test/dashdash.js
@@ -0,0 +1,39 @@
+const test = require('tape');
+const fn = require('../lib');
+
+test('opts["--"]: args after -- go to argv["--"]', t => {
+	t.deepEqual(
+		fn(['a', '--foo', 'b', '--', 'c', '--d', '-e'], { '--': true }),
+		{ _: ['a'], foo: 'b', '--': ['c', '--d', '-e'] }
+	);
+	t.end();
+});
+
+test('opts["--"]: empty when nothing follows', t => {
+	t.deepEqual(fn(['a', '--'], { '--': true }), { _: ['a'], '--': [] });
+	t.end();
+});
+
+test('opts["--"]: absent when no bare -- present', t => {
+	t.deepEqual(fn(['a', '-x'], { '--': true }), { _: ['a'], x: true });
+	t.end();
+});
+
+test('opts["--"]: only the first -- is consumed', t => {
+	t.deepEqual(fn(['--', 'a', '--', 'b'], { '--': true }), { _: [], '--': ['a', '--', 'b'] });
+	t.end();
+});
+
+test('default (unset): args after -- go to argv._', t => {
+	t.deepEqual(fn(['a', '--', 'b', '-c']), { _: ['a', 'b', '-c'] });
+	t.deepEqual(fn(['a', '--', 'b'], { '--': false }), { _: ['a', 'b'] });
+	t.end();
+});
+
+test('opts["--"]: works with alias/default', t => {
+	t.deepEqual(
+		fn(['-f', '1', '--', 'x'], { '--': true, alias: { f: 'foo' }, default: { bar: 2 } }),
+		{ _: [], f: 1, foo: 1, bar: 2, '--': ['x'] }
+	);
+	t.end();
+});
