diff --git a/test/same-origin.test.ts b/test/same-origin.test.ts
new file mode 100644
index 0000000..bfe1029
--- /dev/null
+++ b/test/same-origin.test.ts
@@ -0,0 +1,131 @@
+import { describe, expect, test } from "vitest";
+import { isSameOrigin } from "../src";
+
+// Origin = protocol + hostname + port (path, query, hash and auth are ignored).
+// Explicit default ports (`:443` for https, `:80` for http) equal an omitted port.
+describe("isSameOrigin", () => {
+  describe("same origin", () => {
+    const cases: [string, string][] = [
+      ["https://example.com", "https://example.com"],
+      ["https://example.com", "https://example.com/"],
+      ["https://example.com/a", "https://example.com/b"],
+      ["https://example.com/a?x=1#h", "https://example.com/b?y=2#g"],
+      ["https://example.com:8080/a", "https://example.com:8080/b"],
+      ["http://localhost:3000", "http://localhost:3000/foo"],
+      ["http://127.0.0.1:3000/a", "http://127.0.0.1:3000/b"],
+      ["http://[::1]:3000/a", "http://[::1]:3000/b"],
+    ];
+    for (const [a, b] of cases) {
+      test(`${a} ~ ${b}`, () => {
+        expect(isSameOrigin(a, b)).toBe(true);
+        expect(isSameOrigin(b, a)).toBe(true); // symmetric
+      });
+    }
+  });
+
+  describe("normalization", () => {
+    const cases: [string, string][] = [
+      // protocol and host are case-insensitive
+      ["HTTPS://example.com", "https://example.com"],
+      ["https://EXAMPLE.com/a", "https://example.com/b"],
+      // default ports are equivalent to an omitted port
+      ["https://example.com", "https://example.com:443"],
+      ["https://example.com/a", "https://example.com:443/a"],
+      ["http://example.com", "http://example.com:80"],
+      // credentials are not part of the origin
+      ["https://user:pass@example.com/a", "https://example.com/b"],
+    ];
+    for (const [a, b] of cases) {
+      test(`${a} ~ ${b}`, () => {
+        expect(isSameOrigin(a, b)).toBe(true);
+        expect(isSameOrigin(b, a)).toBe(true);
+      });
+    }
+  });
+
+  describe("different origin", () => {
+    const cases: [string, string][] = [
+      // protocol
+      ["http://example.com", "https://example.com"],
+      // host
+      ["https://example.com", "https://example.org"],
+      ["https://example.com", "https://www.example.com"],
+      ["https://example.com", "https://sub.example.com"],
+      // lookalike / userinfo tricks
+      ["https://example.com", "https://example.com.evil.com"],
+      ["https://example.com", "https://evil.com@example.com.evil.com"],
+      ["https://example.com", "https://example.com@evil.com"],
+      // port
+      ["https://example.com", "https://example.com:8443"],
+      ["https://example.com:8080", "https://example.com:8081"],
+      // non-default / mismatched ports
+      ["http://example.com:443", "http://example.com"],
+      ["https://example.com:80", "https://example.com"],
+      ["http://example.com:443", "https://example.com:443"],
+    ];
+    for (const [a, b] of cases) {
+      test(`${a} !~ ${b}`, () => {
+        expect(isSameOrigin(a, b)).toBe(false);
+        expect(isSameOrigin(b, a)).toBe(false);
+      });
+    }
+  });
+
+  describe("relative and origin-less inputs", () => {
+    test("two relative paths have no origin -> false", () => {
+      expect(isSameOrigin("/a", "/b")).toBe(false);
+      expect(isSameOrigin("a", "a")).toBe(false);
+      expect(isSameOrigin("./a", "./a")).toBe(false);
+    });
+
+    test("relative vs absolute -> false", () => {
+      expect(isSameOrigin("/a", "https://example.com/a")).toBe(false);
+      expect(isSameOrigin("https://example.com/a", "/a")).toBe(false);
+    });
+
+    test("empty strings -> false", () => {
+      expect(isSameOrigin("", "")).toBe(false);
+      expect(isSameOrigin("", "https://example.com")).toBe(false);
+    });
+  });
+
+  describe("protocol-relative URLs", () => {
+    test("without a base there is no protocol -> false", () => {
+      expect(isSameOrigin("//example.com/a", "//example.com/b")).toBe(false);
+      expect(isSameOrigin("//example.com", "https://example.com")).toBe(false);
+    });
+  });
+
+  describe("opaque origins", () => {
+    test("non-hierarchical schemes never match, even to themselves", () => {
+      expect(isSameOrigin("mailto:a@example.com", "mailto:a@example.com")).toBe(
+        false,
+      );
+      expect(isSameOrigin("data:text/plain,hi", "data:text/plain,hi")).toBe(
+        false,
+      );
+      expect(isSameOrigin("javascript:alert(1)", "javascript:alert(1)")).toBe(
+        false,
+      );
+    });
+  });
+
+  describe("invalid input", () => {
+    test("does not throw", () => {
+      expect(() => isSameOrigin("http://", "http://")).not.toThrow();
+      expect(() => isSameOrigin("://", "https://example.com")).not.toThrow();
+    });
+
+    test("returns false", () => {
+      expect(isSameOrigin("http://", "http://")).toBe(false);
+      expect(isSameOrigin("://", "https://example.com")).toBe(false);
+    });
+
+    test("non-string input -> false", () => {
+      // @ts-expect-error invalid input
+      expect(isSameOrigin(undefined, "https://example.com")).toBe(false);
+      // @ts-expect-error invalid input
+      expect(isSameOrigin("https://example.com", null)).toBe(false);
+    });
+  });
+});
