 }
+
+function getOrigin(input: string): string | undefined {
+  if (typeof input !== "string") {
+    return undefined;
+  }
+  try {
+    const { origin } = new URL(input);
+    return origin === "null" ? undefined : origin;
+  } catch {
+    return undefined;
+  }
+}
+
+/**
+ * Check if two URLs share the same origin (protocol, host and port).
+ *
+ * Explicit default ports are normalized (`https://a.com:443` is the same
+ * origin as `https://a.com`). Relative, invalid and opaque-origin inputs
+ * (e.g. `mailto:`, `data:`) never match.
+ *
+ * @example
+ * ```js
+ * isSameOrigin("https://a.com/x", "https://a.com:443/y"); // true
+ * isSameOrigin("https://a.com", "https://b.com"); // false
+ * ```
+ *
+ * @group utils
+ */
+export function isSameOrigin(a: string, b: string): boolean {
+  const originA = getOrigin(a);
+  return originA !== undefined && originA === getOrigin(b);
+}
