''','''```

### Compound Format

Use `compound: true` to break a duration into several units, largest first:

```ts
ms(5400000, { compound: true })       // "1h 30m"
ms(90061000, { compound: true })      // "1d 1h 1m 1s"
ms(3605000, { compound: true })       // "1h 5s"
ms(-5400000, { compound: true })      // "-1h 30m"
```

- Parts are separated by a space and zero parts are skipped.
- Days are the largest unit (no weeks, months or years): `400d`, not `1y 35d`.
- Seconds are the smallest unit. Leftover milliseconds are dropped, so values under one second give `"0s"`.
- Negative values get a single leading `-`, unless the result is `"0s"`.
- `compound` takes precedence over `long`.
''',1)
open(p,'w').write(t)

p='src/format.test.ts'
t=open(p).read()
t=t.rstrip()
assert t.endswith('});')
t=t[:-3]+'''
  it('should take precedence over long', () => {
    expect(format(5400000, { compound: true, long: true })).toBe('1h 30m');
  });

  it('should not compound when compound is false', () => {
    expect(format(5400000, { compound: false })).toBe('2h');
    expect(format(5400000, { compound: false, long: true })).toBe('2 hours');
  });

  it('should roll over at unit boundaries', () => {
    expect(format(1000, { compound: true })).toBe('1s');
    expect(format(59999, { compound: true })).toBe('59s');
    expect(format(60000, { compound: true })).toBe('1m');
    expect(format(3599999, { compound: true })).toBe('59m 59s');
    expect(format(3600000, { compound: true })).toBe('1h');
    expect(format(86399999, { compound: true })).toBe('23h 59m 59s');
    expect(format(86400000, { compound: true })).toBe('1d');
  });

  it('should handle negative multi-unit values and boundaries', () => {
    expect(format(-90061000, { compound: true })).toBe('-1d 1h 1m 1s');
    expect(format(-1000, { compound: true })).toBe('-1s');
    expect(format(-999, { compound: true })).toBe('0s');
  });

  it('should truncate fractional milliseconds', () => {
    expect(format(1500.75, { compound: true })).toBe('1s');
  });

  it('should round-trip with parse for whole seconds', () => {
    expect(ms(ms('1h 30m' as never) || 0, { compound: true })).toBeDefined();
    expect(ms(ms('90m'), { compound: true })).toBe('1h 30m');
  });

  it('should throw on invalid input', () => {
    expect(() => format(NaN, { compound: true })).toThrow();
    expect(() => format(Infinity, { compound: true })).toThrow();
    expect(() => format('1' as never, { compound: true })).toThrow();
  });
});
'''
open(p,'w').write(t)
EOF)
