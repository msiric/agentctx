describe('format(number, { compound: true })', () => {
  it('should combine units, largest first', () => {
    expect(format(5400000, { compound: true })).toBe('1h 30m');
    expect(format(90061000, { compound: true })).toBe('1d 1h 1m 1s');
  });

  it('should skip zero parts', () => {
    expect(format(3600000 + 5000, { compound: true })).toBe('1h 5s');
    expect(format(2 * 86400000, { compound: true })).toBe('2d');
  });

  it('should drop leftover milliseconds', () => {
    expect(format(1999, { compound: true })).toBe('1s');
    expect(format(500, { compound: true })).toBe('0s');
    expect(format(0, { compound: true })).toBe('0s');
  });

  it('should not use weeks, months or years', () => {
    expect(format(400 * 86400000, { compound: true })).toBe('400d');
  });

  it('should support negative values', () => {
    expect(format(-5400000, { compound: true })).toBe('-1h 30m');
    expect(format(-500, { compound: true })).toBe('0s');
  });

  it('should work through ms()', () => {
    expect(ms(5400000, { compound: true })).toBe('1h 30m');
  });
});
