+/**
+ * Compound format for `ms`, e.g. `1h 30m`.
+ */
+function fmtCompound(ms: number): string {
+  let rest = Math.floor(Math.abs(ms) / s);
+  const parts: string[] = [];
+  for (const [size, name] of [
+    [d / s, 'd'],
+    [h / s, 'h'],
+    [m / s, 'm'],
+    [1, 's'],
+  ] as const) {
+    const count = Math.floor(rest / size);
+    rest -= count * size;
+    if (count > 0) {
+      parts.push(`${count}${name}`);
+    }
+  }
+  if (parts.length === 0) {
+    return '0s';
+  }
+  return `${ms < 0 ? '-' : ''}${parts.join(' ')}`;
+}
