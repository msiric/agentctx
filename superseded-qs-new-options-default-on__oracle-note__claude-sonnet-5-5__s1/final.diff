 Parse the value as a boolean type instead of string type if it's a boolean.
 
+##### ignoreEmpty
+
+Type: `boolean`\
+Default: `false`
+
+Drop parameters with an empty value, like `q=`. A key without `=`, like `flag`, has no value rather than an empty one, so it is kept.
+
+```js
+import queryString from 'query-string';
+
+queryString.parse('?q=&page=2', {ignoreEmpty: true});
+//=> {page: '2'}
+
+queryString.parse('?flag&q=', {ignoreEmpty: true});
+//=> {flag: null}
+```
+
+##### stripTracking
+
+Type: `boolean`\
+Default: `true`
+
+Drop the tracking parameters `utm_*`, `fbclid`, and `gclid`. The names are matched case-insensitively. Set it to `false` to keep them.
+
+```js
+import queryString from 'query-string';
+
+queryString.parse('?q=a&utm_source=x&fbclid=y&gclid=z');
+//=> {q: 'a'}
+
+queryString.parse('?q=a&utm_source=x', {stripTracking: false});
+//=> {q: 'a', utm_source: 'x'}
+```
+
 ##### types
 
 Type: `object`\
diff --git a/test/parse.js b/test/parse.js
index 00a1abf..9993947 100644
--- a/test/parse.js
+++ b/test/parse.js
@@ -1492,3 +1492,46 @@ test('rejects an invalid `arrayFormatSeparator`', () => {
 
 	assert.deepEqual(structuredClone(queryString.parse('foo=a·b', {arrayFormat: 'separator', arrayFormatSeparator: '·'})), {foo: ['a', 'b']});
 });
+
+test('`ignoreEmpty` drops parameters with an empty value', () => {
+	assert.deepEqual(structuredClone(queryString.parse('?q=&page=2', {ignoreEmpty: true})), {page: '2'});
+	assert.deepEqual(structuredClone(queryString.parse('?q=&page=2')), {q: '', page: '2'});
+	assert.deepEqual(structuredClone(queryString.parse('?q=&page=2', {ignoreEmpty: false})), {q: '', page: '2'});
+	assert.deepEqual(structuredClone(queryString.parse('?q=', {ignoreEmpty: true})), {});
+});
+
+test('`ignoreEmpty` keeps a key without `=`', () => {
+	assert.deepEqual(structuredClone(queryString.parse('?flag&q=', {ignoreEmpty: true})), {flag: null});
+});
+
+test('`ignoreEmpty` drops empty items of an array and keeps whitespace', () => {
+	assert.deepEqual(structuredClone(queryString.parse('a=1&a=&a=2', {ignoreEmpty: true})), {a: ['1', '2']});
+	assert.deepEqual(structuredClone(queryString.parse('a[]=&a[]=1', {ignoreEmpty: true, arrayFormat: 'bracket'})), {a: ['1']});
+	assert.deepEqual(structuredClone(queryString.parse('a=%20&b=+', {ignoreEmpty: true})), {a: ' ', b: ' '});
+});
+
+test('`stripTracking` drops `utm_*`, `fbclid`, and `gclid` by default', () => {
+	assert.deepEqual(structuredClone(queryString.parse('?q=a&utm_source=x&utm_medium=y&fbclid=1&gclid=2')), {q: 'a'});
+	assert.deepEqual(structuredClone(queryString.parse('?UTM_Source=x&FBCLID=1&utm%5Fcampaign=z&q=a')), {q: 'a'});
+	assert.deepEqual(structuredClone(queryString.parse('?utm_source&utm_term=a&utm_term=b&q=a')), {q: 'a'});
+});
+
+test('`stripTracking` keeps similar names', () => {
+	assert.deepEqual(structuredClone(queryString.parse('?utm=1&xutm_a=2&fbclid2=3&gclids=4')), {
+		fbclid2: '3',
+		gclids: '4',
+		utm: '1',
+		// eslint-disable-next-line camelcase
+		xutm_a: '2',
+	});
+});
+
+test('`stripTracking: false` keeps the tracking parameters', () => {
+	assert.deepEqual(structuredClone(queryString.parse('?q=a&utm_source=x&fbclid=1&gclid=2', {stripTracking: false})), {
+		fbclid: '1',
+		gclid: '2',
+		q: 'a',
+		// eslint-disable-next-line camelcase
+		utm_source: 'x',
+	});
+});
