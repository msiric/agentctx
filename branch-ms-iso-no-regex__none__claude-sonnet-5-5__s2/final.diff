+
+/**
+ * Format the given milliseconds as an ISO 8601 duration string.
+ *
+ * Days are the largest unit used, since months and years are ambiguous.
+ * Negative values are prefixed with `-` (a widely supported extension), and
+ * sub-second precision is emitted as a decimal fraction of the seconds.
+ *
+ * @example formatISO(5400000) // "PT1H30M"
+ * @example formatISO(90061000) // "P1DT1H1M1S"
+ *
+ * @param ms - milliseconds
+ * @returns The ISO 8601 duration string
+ */
+export function formatISO(ms: number): string {
+  if (typeof ms !== 'number' || !Number.isFinite(ms)) {
+    throw new Error('Value provided to ms.formatISO() must be of type number.');
+  }
+
+  let rest = Math.round(Math.abs(ms));
+  const days = Math.floor(rest / d);
+  rest -= days * d;
+  const hours = Math.floor(rest / h);
+  rest -= hours * h;
+  const minutes = Math.floor(rest / m);
+  rest -= minutes * m;
+  const seconds = Math.floor(rest / s);
+  const millis = rest - seconds * s;
+
+  let time = '';
+  if (hours) time += `${hours}H`;
+  if (minutes) time += `${minutes}M`;
+  if (seconds || millis) {
+    let frac = String(millis).padStart(3, '0');
+    while (frac.endsWith('0')) {
+      frac = frac.slice(0, -1);
+    }
+    time += `${seconds}${frac ? `.${frac}` : ''}S`;
+  }
+
+  if (!days && !time) {
+    return 'PT0S';
+  }
+
+  return `${ms < 0 ? '-' : ''}P${days ? `${days}D` : ''}${time ? `T${time}` : ''}`;
+}
+
+const ISO_DATE_UNITS: Record<string, number> = { W: w, D: d };
+const ISO_TIME_UNITS: Record<string, number> = { H: h, M: m, S: s };
+
+/**
+ * Parse an ISO 8601 duration string and return milliseconds. The inverse of
+ * `formatISO`.
+ *
+ * Supports weeks, days, hours, minutes and seconds, an optional leading `-` or
+ * `+`, and a decimal fraction (`.` or `,`) on the last component. Years and
+ * months are rejected because their length is ambiguous.
+ *
+ * @example parseISO("PT1H30M") // 5400000
+ * @example parseISO("P1DT1H1M1S") // 90061000
+ *
+ * @param str - An ISO 8601 duration string
+ * @returns The duration in milliseconds
+ * @throws Error if `str` is not a supported ISO 8601 duration
+ */
+export function parseISO(str: string): number {
+  const fail = (reason: string): never => {
+    throw new Error(
+      `Value provided to ms.parseISO() must be a valid ISO 8601 duration (${reason}). value=${JSON.stringify(str)}`,
+    );
+  };
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    return fail('expected a string with length between 1 and 99');
+  }
+
+  let i = 0;
+  let sign = 1;
+  if (str[i] === '-' || str[i] === '+') {
+    sign = str[i] === '-' ? -1 : 1;
+    i++;
+  }
+  if (str[i] !== 'P') return fail('must start with "P"');
+  i++;
+
+  let inTime = false;
+  let total = 0;
+  let count = 0;
+  let lastKey = -1;
+  let sawFraction = false;
+
+  while (i < str.length) {
+    if (str[i] === 'T') {
+      if (inTime) return fail('duplicate "T"');
+      inTime = true;
+      i++;
+      if (i === str.length) return fail('no components after "T"');
+      continue;
+    }
+
+    const start = i;
+    let digits = 0;
+    let hasFraction = false;
+    while (i < str.length) {
+      const c = str[i];
+      if (c >= '0' && c <= '9') {
+        digits++;
+      } else if ((c === '.' || c === ',') && !hasFraction && digits > 0) {
+        hasFraction = true;
+        digits = 0;
+      } else {
+        break;
+      }
+      i++;
+    }
+    if (i === start || digits === 0) return fail('malformed number');
+    if (i === str.length) return fail('missing unit designator');
+
+    if (sawFraction) return fail('only the last component may be fractional');
+    sawFraction = hasFraction;
+
+    const designator = str[i];
+    const units = inTime ? ISO_TIME_UNITS : ISO_DATE_UNITS;
+    const unit = units[designator];
+    if (unit === undefined) {
+      if (!inTime && (designator === 'Y' || designator === 'M')) {
+        return fail('years and months are not supported');
+      }
+      return fail(`unexpected "${designator}"`);
+    }
+    const key = 'WDHMS'.indexOf(designator);
+    if (key <= lastKey) return fail('components out of order');
+    lastKey = key;
+
+    total += Number.parseFloat(str.slice(start, i).replace(',', '.')) * unit;
+    count++;
+    i++;
+  }
+
+  if (count === 0) return fail('no components');
+  return sign * Math.round(total);
+}
