+def test_inprocess_wrap_option():
+    """In-process: -w / --wrap wraps long cell text"""
+    text = "a,b\n1,hello world foo bar\n"
+    expected = "\n".join(
+        [
+            "  a  b",
+            "---  -----",
+            "  1  hello",
+            "     world",
+            "     foo",
+            "     bar",
+        ]
+    )
+    for opt in ["-w", "--wrap"]:
+        out = run_main_in_process(["-1", "-s", ",", opt, "5"], input_text=text)
+        assert_equal(out.rstrip().splitlines(), expected.splitlines())
+
+
+def test_inprocess_wrap_invalid_width():
+    """In-process: --wrap rejects non-positive or non-numeric widths"""
+    for bad in ["0", "-3", "x"]:
+        with pytest.raises(SystemExit) as exc:
+            run_main_in_process(["--wrap", bad], input_text="a b\n")
+        assert exc.value.code == 3
