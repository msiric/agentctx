diff --git a/test/count.js b/test/count.js
new file mode 100644
index 0000000..b9814d0
--- /dev/null
+++ b/test/count.js
@@ -0,0 +1,42 @@
+const test = require('tape');
+const fn = require('../lib');
+
+test('count :: short flags', t => {
+	t.same(fn(['-vvv'], { count: 'v' }), { _: [], v: 3 });
+	t.same(fn(['-v', '-v'], { count: ['v'] }), { _: [], v: 2 });
+	t.same(fn(['-v'], { count: 'v' }), { _: [], v: 1 });
+	t.end();
+});
+
+test('count :: long flags', t => {
+	t.same(fn(['--verbose', '--verbose'], { count: 'verbose' }), { _: [], verbose: 2 });
+	t.end();
+});
+
+test('count :: does not consume values', t => {
+	t.same(fn(['-v', 'foo', '-v'], { count: 'v' }), { _: ['foo'], v: 2 });
+	t.end();
+});
+
+test('count :: mixed with other flags', t => {
+	t.same(fn(['-vvx', '--name', 'bob'], { count: 'v' }), { _: [], v: 2, x: true, name: 'bob' });
+	t.end();
+});
+
+test('count :: aliases share one count', t => {
+	const argv = fn(['-vv', '--verbose'], { count: 'v', alias: { v: 'verbose' } });
+	t.same(argv, { _: [], v: 3, verbose: 3 });
+	t.same(fn(['-v'], { count: 'verbose', alias: { v: 'verbose' } }), { _: [], v: 1, verbose: 1 });
+	t.end();
+});
+
+test('count :: absent flag and defaults', t => {
+	t.same(fn([], { count: 'v' }), { _: [] });
+	t.same(fn([], { count: 'v', default: { v: 0 } }), { _: [], v: 0 });
+	t.end();
+});
+
+test('count :: --no- resets to zero', t => {
+	t.same(fn(['-vv', '--no-v'], { count: 'v' }), { _: [], v: 0 });
+	t.end();
+});
