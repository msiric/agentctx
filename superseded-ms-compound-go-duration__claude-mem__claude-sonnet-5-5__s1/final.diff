+/**
+ * Compound format for `ms`, e.g. `1h 30m`.
+ */
+function fmtCompound(ms: number): string {
+  let remaining = Math.trunc(Math.abs(ms) / s);
+  const parts: string[] = [];
+  for (const [unit, size] of [
+    ['d', d / s],
+    ['h', h / s],
+    ['m', m / s],
+    ['s', 1],
+  ] as const) {
+    const count = Math.floor(remaining / size);
+    remaining -= count * size;
+    if (count > 0) {
+      parts.push(`${count}${unit}`);
+    }
+  }
+  if (parts.length === 0) {
+    return '0s';
+  }
+  return `${ms < 0 ? '-' : ''}${parts.join(' ')}`;
+}
