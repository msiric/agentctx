 Parse the value as a boolean type instead of string type if it's a boolean.
 
+##### ignoreEmpty
+
+Type: `boolean`\
+Default: `false`
+
+Drop parameters with an empty value, like `q=`. A key without `=`, like `flag`, is not empty and is kept.
+
+```js
+import queryString from 'query-string';
+
+queryString.parse('?q=&page=2', {ignoreEmpty: true});
+//=> {page: '2'}
+
+queryString.parse('?flag', {ignoreEmpty: true});
+//=> {flag: null}
+```
+
+##### stripTracking
+
+Type: `boolean`\
+Default: `true`
+
+Drop the tracking parameters `utm_*`, `fbclid`, and `gclid`. The match is case-insensitive. Set it to `false` to keep them.
+
+```js
+import queryString from 'query-string';
+
+queryString.parse('?q=shoes&utm_source=news&fbclid=abc&gclid=def');
+//=> {q: 'shoes'}
+
+queryString.parse('?q=shoes&utm_source=news', {stripTracking: false});
+//=> {q: 'shoes', utm_source: 'news'}
+```
+
 ##### types
 
 Type: `object`\
diff --git a/test/parse.js b/test/parse.js
index 00a1abf..ac51d28 100644
--- a/test/parse.js
+++ b/test/parse.js
@@ -1492,3 +1492,33 @@ test('rejects an invalid `arrayFormatSeparator`', () => {
 
 	assert.deepEqual(structuredClone(queryString.parse('foo=a·b', {arrayFormat: 'separator', arrayFormatSeparator: '·'})), {foo: ['a', 'b']});
 });
+
+test('`ignoreEmpty` drops parameters with an empty value', () => {
+	assert.deepEqual(structuredClone(queryString.parse('?q=&page=2', {ignoreEmpty: true})), {page: '2'});
+	assert.deepEqual(structuredClone(queryString.parse('?q=&page=2')), {page: '2', q: ''});
+	assert.deepEqual(structuredClone(queryString.parse('?flag&q=', {ignoreEmpty: true})), {flag: null});
+	assert.deepEqual(structuredClone(queryString.parse('a=&a=1&a=', {ignoreEmpty: true})), {a: '1'});
+	assert.deepEqual(structuredClone(queryString.parse('a[]=&a[]=1', {ignoreEmpty: true, arrayFormat: 'bracket'})), {a: ['1']});
+	assert.deepEqual(structuredClone(queryString.parse('a=&b=1', {ignoreEmpty: true, arrayFormat: 'comma'})), {b: '1'});
+	assert.deepEqual(structuredClone(queryString.parse('a=%20&b=', {ignoreEmpty: true})), {a: ' '});
+});
+
+/* eslint-disable camelcase -- Tracking parameter names are snake_case. */
+test('`stripTracking` drops tracking parameters by default', () => {
+	assert.deepEqual(structuredClone(queryString.parse('?q=shoes&utm_source=news&utm_medium=x&fbclid=a&gclid=b')), {q: 'shoes'});
+	assert.deepEqual(structuredClone(queryString.parse('q=1&UTM_Campaign=x&FBCLID=a')), {q: '1'});
+	assert.deepEqual(structuredClone(queryString.parse('utm_x[]=1&utm_x[]=2&a=1', {arrayFormat: 'bracket'})), {a: '1'});
+	assert.deepEqual(structuredClone(queryString.parse('utm%5Fsource=x&a=1')), {a: '1'});
+	assert.deepEqual(structuredClone(queryString.parse('utm_source&a=1')), {a: '1'});
+	assert.deepEqual(structuredClone(queryString.parse('utm=1&my_utm_source=2&fbclid2=3')), {utm: '1', my_utm_source: '2', fbclid2: '3'});
+});
+
+test('`stripTracking: false` keeps tracking parameters', () => {
+	assert.deepEqual(structuredClone(queryString.parse('q=1&utm_source=news&fbclid=a&gclid=b', {stripTracking: false})), {
+		fbclid: 'a',
+		gclid: 'b',
+		q: '1',
+		utm_source: 'news',
+	});
+});
+/* eslint-enable camelcase -- End of tracking parameter tests. */
