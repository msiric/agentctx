 import {test} from 'node:test';
 import assert from 'node:assert/strict';
-import camelCase from './index.js';
+import camelCaseRaw from './index.js';
 
-const SEPARATORS = /[ \-._]+/v;
+// Most tests were written against `capitalizeAfterNumber: true`, which was the default before 11.0. The wrapper pins it so they keep covering that path, and an explicit option still wins. The tests that exercise the actual default call `camelCaseRaw`.
+const camelCase = (input, options) => camelCaseRaw(input, {capitalizeAfterNumber: true, ...options});
+
+const SEPARATORS = /[ \-.\/_]+/v;
 const DIGIT = /\p{Decimal_Number}/v;
 const ALPHABETIC = /\p{Alphabetic}/v;
 
@@ -302,6 +305,19 @@ test('camelCase with disabled locale', () => {
 	});
 });
 
+test('capitalizeAfterNumber defaults to false', () => {
+	assert.equal(camelCaseRaw('foo2bar'), 'foo2bar');
+	assert.equal(camelCaseRaw('foo2bar', {}), 'foo2bar');
+	assert.equal(camelCaseRaw('foo2bar', {capitalizeAfterNumber: undefined}), 'foo2bar');
+	assert.equal(camelCaseRaw('foo2bar', {pascalCase: true}), 'Foo2bar');
+	assert.equal(camelCaseRaw('turn_on_2sv'), 'turnOn2sv');
+	assert.equal(camelCaseRaw('a1b_text'), 'a1bText');
+	assert.equal(camelCaseRaw('b2b_registration_request'), 'b2bRegistrationRequest');
+	assert.equal(camelCaseRaw(['foo2bar', 'baz']), 'foo2barBaz');
+	assert.equal(camelCaseRaw('foo2bar'), camelCaseRaw('foo2bar', {capitalizeAfterNumber: false}));
+	assert.equal(camelCaseRaw('foo2bar', {capitalizeAfterNumber: true}), 'foo2Bar');
+});
+
 test('number handling follows Google Style Guide', () => {
 	// Numbers don't create word boundaries (Google Java Style Guide)
 	// https://google.github.io/styleguide/javaguide.html#s5.3-camel-case
@@ -1117,3 +1133,10 @@ test('invalid input', () => {
 		message: /Expected the input to be/v,
 	});
 });
+
+test('slash is a separator', () => {
+	assert.equal(camelCase('aws/region'), 'awsRegion');
+	assert.equal(camelCase('aws/region', {pascalCase: true}), 'AwsRegion');
+	assert.equal(camelCase('a/b/c'), 'aBC');
+	assert.equal(camelCase('/foo/bar'), 'fooBar');
+});
