diff --git a/tests/test_storages.py b/tests/test_storages.py
index 6e433a1..4f76cb8 100644
--- a/tests/test_storages.py
+++ b/tests/test_storages.py
@@ -285,3 +285,23 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def test_json_sort_keys_default(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    db = TinyDB(path)
+    db.insert({'b': 1, 'a': 2})
+    db.close()
+    with open(path) as f:
+        content = f.read()
+    assert content.index('"a"') < content.index('"b"')
+
+
+def test_json_sort_keys_disabled(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    db = TinyDB(path, sort_keys=False)
+    db.insert({'b': 1, 'a': 2})
+    db.close()
+    with open(path) as f:
+        content = f.read()
+    assert content.index('"b"') < content.index('"a"')
