+        # Re-use the parsed data if the file is unchanged since we parsed it,
+        # so changes made by other processes are still picked up. Like with
+        # ``CachingMiddleware``, the returned object is shared between calls.
+        sig = self._signature()
+        if self._cache_sig == sig:
+            return self._cache_data
+
+        self._cache_sig = self._cache_data = None
+        data = self._read_file()
+
+        if sig[0] < time.time_ns() - self._RACY_WINDOW_NS:
+            self._cache_sig, self._cache_data = sig, data
+
+        return data
+
