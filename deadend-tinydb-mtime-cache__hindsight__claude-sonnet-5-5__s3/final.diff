+"""
+Benchmark TinyDB read performance on a large JSON database.
+
+Generates a db file of roughly --size-mb megabytes, then times:
+
+  * raw ``json.load`` of the file (the floor for any JSONStorage read)
+  * ``db.all()``
+  * ``db.search()`` with distinct (uncached) queries
+  * ``db.search()`` with a repeated query (served by the query cache)
+  * a cProfile breakdown of one uncached search
+
+Usage:  python scripts/bench_read.py [--size-mb 40] [--repeat 3] [--keep]
+"""
+
+import argparse
+import cProfile
+import json
+import os
+import pstats
+import random
+import sys
+import tempfile
+import time
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))
+
+from tinydb import TinyDB, where  # noqa: E402
+
+
+def make_doc(i, rng):
+    return {
+        'name': 'user-%d' % i,
+        'age': rng.randint(18, 90),
+        'email': 'user%d@example.com' % i,
+        'tags': [rng.choice(['a', 'b', 'c', 'd', 'e']) for _ in range(5)],
+        'address': {'city': rng.choice(['Berlin', 'Paris', 'Rome', 'Oslo']),
+                    'zip': str(rng.randint(10000, 99999))},
+        'bio': 'x' * 200,
+    }
+
+
+def generate(path, size_mb):
+    rng = random.Random(42)
+    target = size_mb * 1024 * 1024
+    table = {}
+    i = 1
+    approx = len(json.dumps(make_doc(0, rng))) + 12
+    n = target // approx
+    for i in range(1, n + 1):
+        table[str(i)] = make_doc(i, rng)
+    with open(path, 'w') as f:
+        json.dump({'_default': table}, f)
+    return n
+
+
+def timeit(label, fn, repeat):
+    times = []
+    result = None
+    for _ in range(repeat):
+        t = time.perf_counter()
+        result = fn()
+        times.append(time.perf_counter() - t)
+    print('%-38s best %8.1f ms   mean %8.1f ms' % (
+        label, min(times) * 1000, sum(times) / len(times) * 1000))
+    return result
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--size-mb', type=int, default=40)
+    ap.add_argument('--repeat', type=int, default=3)
+    ap.add_argument('--keep', action='store_true', help='keep the generated file')
+    args = ap.parse_args()
+
+    tmpdir = tempfile.mkdtemp(prefix='tinydb-bench-')
+    path = os.path.join(tmpdir, 'db.json')
+    try:
+        t = time.perf_counter()
+        n = generate(path, args.size_mb)
+        print('generated %d docs, %.1f MB in %.1fs\n' % (
+            n, os.path.getsize(path) / 1e6, time.perf_counter() - t))
+
+        def raw_load():
+            with open(path) as f:
+                return json.load(f)
+
+        timeit('raw json.load (floor)', raw_load, args.repeat)
+
+        with TinyDB(path) as db:
+            timeit('db.all()', db.all, args.repeat)
+
+            # Distinct conditions each time so the query cache never hits
+            counter = iter(range(10**6))
+            timeit('db.search() uncached',
+                   lambda: db.search(where('name') == 'user-%d' % next(counter)),
+                   args.repeat)
+
+            q = where('address')['city'] == 'Oslo'
+            db.search(q)  # prime cache
+            timeit('db.search() cached (same query)', lambda: db.search(q), args.repeat)
+
+            print('\ncProfile of one uncached search (top by tottime):')
+            prof = cProfile.Profile()
+            prof.enable()
+            db.search(where('name') == 'user-77')
+            prof.disable()
+            pstats.Stats(prof).sort_stats('tottime').print_stats(6)
+    finally:
+        if args.keep:
+            print('kept', path)
+        else:
+            os.remove(path)
+            os.rmdir(tmpdir)
+
+
+if __name__ == '__main__':
+    main()
