+
+
+def test_json_read_cache_sees_external_changes(tmpdir):
+    import os
+    import time
+
+    path = str(tmpdir.join('db.json'))
+    with open(path, 'w') as f:
+        json.dump({'_default': {'1': {'a': 1}}}, f)
+    old = time.time() - 100
+    os.utime(path, (old, old))
+
+    storage = JSONStorage(path)
+    first = storage.read()
+    assert storage.read() is first  # unchanged file: served from the cache
+
+    # Another process rewrites the file (same mtime, different size)
+    with open(path, 'w') as f:
+        json.dump({'_default': {'1': {'a': 1}, '2': {'a': 2}}}, f)
+    os.utime(path, (old, old))
+    assert len(storage.read()['_default']) == 2
+
+    storage.write({'_default': {}})
+    assert storage.read() == {'_default': {}}
+    storage.close()
