+def percent(value: NumberOrString, precision: int = 1) -> str:
+    """Return a fraction formatted as a percentage.
+
+    Examples:
+        ```pycon
+        >>> percent(0.125)
+        '12.5%'
+        >>> percent(0.5)
+        '50.0%'
+        >>> percent(1)
+        '100.0%'
+        >>> percent(0.12345, 2)
+        '12.35%'
+        >>> percent(0.0625)
+        '6.3%'
+        >>> percent(0.5, 0)
+        '50%'
+        >>> percent(-0.25)
+        '-25.0%'
+        >>> percent("foo")
+        'foo'
+        >>> percent(None)
+        'None'
+
+        ```
+
+    Args:
+        value (int, float, str): Fraction to format, where 1 means 100%.
+        precision (int): Number of digits after the decimal point.
+
+    Returns:
+        str: The percentage, or the input as a string if it is not a number.
+    """
+    import math
+
+    try:
+        value = float(value)
+        if not math.isfinite(value):
+            return _format_not_finite(value)
+    except (ValueError, TypeError):
+        return str(value)
+    # Round half up on the decimal repr (like billing), not half-even on the
+    # binary float: 0.0625 -> '6.3%', not '6.2%'.
+    with decimal.localcontext() as ctx:
+        ctx.rounding = decimal.ROUND_HALF_UP
+        ctx.prec = 400
+        result = format(decimal.Decimal(repr(value)) * 100, f".{int(precision)}f")
+    return result.replace(".", decimal_separator()) + "%"
+
