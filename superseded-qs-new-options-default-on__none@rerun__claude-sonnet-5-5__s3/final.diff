diff --git a/test/parse.js b/test/parse.js
index 00a1abf..4a14587 100644
--- a/test/parse.js
+++ b/test/parse.js
@@ -1492,3 +1492,49 @@ test('rejects an invalid `arrayFormatSeparator`', () => {
 
 	assert.deepEqual(structuredClone(queryString.parse('foo=a·b', {arrayFormat: 'separator', arrayFormatSeparator: '·'})), {foo: ['a', 'b']});
 });
+
+test('`ignoreEmpty` drops parameters with an empty value', () => {
+	assert.deepEqual(structuredClone(queryString.parse('?q=&page=2', {ignoreEmpty: true})), {page: '2'});
+	assert.deepEqual(structuredClone(queryString.parse('?q=&page=2')), {page: '2', q: ''});
+	assert.deepEqual(structuredClone(queryString.parse('?flag&q=', {ignoreEmpty: true})), {flag: null});
+	assert.deepEqual(structuredClone(queryString.parse('?a=%20&b=', {ignoreEmpty: true})), {a: ' '});
+	assert.deepEqual(structuredClone(queryString.parse('a=1&a=&a=2', {ignoreEmpty: true})), {a: ['1', '2']});
+	assert.deepEqual(structuredClone(queryString.parse('a=&b=1', {ignoreEmpty: true, arrayFormat: 'comma'})), {b: '1'});
+	assert.deepEqual(structuredClone(queryString.parse('a[]=&b=1', {ignoreEmpty: true, arrayFormat: 'bracket'})), {b: '1'});
+	assert.deepEqual(structuredClone(queryString.parse('q=', {ignoreEmpty: true})), {});
+});
+
+test('`ignoreEmpty` is opt-in', () => {
+	for (const options of [undefined, {}, {ignoreEmpty: false}, {ignoreEmpty: undefined}]) {
+		assert.deepEqual(structuredClone(queryString.parse('?q=&page=2', options)), {page: '2', q: ''});
+	}
+});
+
+/* eslint-disable camelcase -- Tracking parameter names are snake case. */
+test('`stripTracking` drops tracking parameters', () => {
+	assert.deepEqual(structuredClone(queryString.parse('?q=shoes&utm_source=news&utm_medium=x&fbclid=abc&gclid=def', {stripTracking: true})), {q: 'shoes'});
+	assert.deepEqual(structuredClone(queryString.parse('?q=shoes&utm_source=news&fbclid=abc&gclid=def')), {
+		fbclid: 'abc',
+		gclid: 'def',
+		q: 'shoes',
+		utm_source: 'news',
+	});
+	assert.deepEqual(structuredClone(queryString.parse('utm_source&utm_x=&a=1', {stripTracking: true})), {a: '1'});
+	assert.deepEqual(structuredClone(queryString.parse('utm%5Fsource=x&a=1', {stripTracking: true})), {a: '1'});
+	assert.deepEqual(structuredClone(queryString.parse('utm_tag[]=a&utm_tag[]=b&a=1', {stripTracking: true, arrayFormat: 'bracket'})), {a: '1'});
+	assert.deepEqual(structuredClone(queryString.parse('fbclid=a&gclid=b', {stripTracking: true})), {});
+	assert.deepEqual(structuredClone(queryString.parse('utm=1&xutm_a=2&fbclid2=3&my_gclid=4', {stripTracking: true})), {
+		fbclid2: '3',
+		my_gclid: '4',
+		utm: '1',
+		xutm_a: '2',
+	});
+});
+
+/* eslint-enable camelcase */
+
+test('`stripTracking` is opt-in', () => {
+	for (const options of [undefined, {}, {stripTracking: false}, {stripTracking: undefined}]) {
+		assert.deepEqual(structuredClone(queryString.parse('a=1&gclid=x', options)), {a: '1', gclid: 'x'});
+	}
+});
