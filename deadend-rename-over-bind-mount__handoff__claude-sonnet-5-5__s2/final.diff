--- a/tests/test_storages.py
+++ b/tests/test_storages.py
@@ -285,3 +285,79 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def test_json_crash_safe_torn_write(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    s = JSONStorage(path)
+    s.write({'_default': {'1': {'a': 1}}})
+    new = {'_default': {'1': {'a': 1}, '2': {'b': 'x' * 100}}}
+
+    # Simulate a crash mid-write: journal complete, db file truncated
+    s._write_journal(json.dumps(new))
+    s.close()
+    with open(path, 'r+') as f:
+        f.truncate(20)
+
+    s = JSONStorage(path)
+    assert s.read() == new
+    s.close()
+    with open(path) as f:  # file was repaired in place
+        assert json.load(f) == new
+
+
+def test_json_crash_safe_new_prefix_old_tail(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    s = JSONStorage(path)
+    s.write({'_default': {'1': {'a': 'y' * 200}}})
+    new = {'_default': {}}
+    s._write_journal(json.dumps(new))
+    s.close()
+    with open(path, 'r+') as f:  # new bytes written, truncate never ran
+        f.write(json.dumps(new))
+
+    s = JSONStorage(path)
+    assert s.read() == new
+    s.close()
+
+
+def test_json_crash_before_db_write_keeps_old_state(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    old = {'_default': {'1': {'a': 1}}}
+    s = JSONStorage(path)
+    s.write(old)
+    s.close()
+    with open(path + '.journal', 'w') as f:  # torn journal
+        f.write('deadbeef\n{"_defa')
+    s = JSONStorage(path)
+    assert s.read() == old
+    s.close()
+
+
+def test_json_corrupt_without_valid_journal_raises(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    with open(path, 'w') as f:
+        f.write('{"_default": {')
+    s = JSONStorage(path)
+    with pytest.raises(ValueError):
+        s.read()
+    s.close()
+
+
+def test_json_journal_does_not_rename_db_file(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    s = JSONStorage(path)
+    inode = os.stat(path).st_ino
+    s.write({'_default': {}})
+    s.write({'_default': {'1': {'a': 1}}})
+    s.close()
+    assert os.stat(path).st_ino == inode
+
+
+def test_json_unwritable_journal_warns(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    s = JSONStorage(path, journal_path=str(tmpdir.join('nodir', 'j')))
+    with pytest.warns(UserWarning, match='not crash-safe'):
+        s.write({'_default': {}})
+    assert s.read() == {'_default': {}}
+    s.close()
