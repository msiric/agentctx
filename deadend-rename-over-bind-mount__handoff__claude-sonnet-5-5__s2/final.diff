+    def _looks_like_same_file(self, payload: str) -> bool:
+        # Guard against "recovering" over a healthy file that was merely read
+        # with the wrong encoding: the raw leading bytes must match what we
+        # would have written.
+        enc = getattr(self._handle, 'encoding', None) or 'utf-8'
