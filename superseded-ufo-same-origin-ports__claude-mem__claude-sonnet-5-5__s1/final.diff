diff --git a/test/same-origin.test.ts b/test/same-origin.test.ts
new file mode 100644
index 0000000..a0ec1e5
--- /dev/null
+++ b/test/same-origin.test.ts
@@ -0,0 +1,96 @@
+import { describe, expect, test } from "vitest";
+import { isSameOrigin } from "../src";
+
+describe("isSameOrigin", () => {
+  const sameOrigin = [
+    // Path, query and hash are ignored
+    ["https://example.com", "https://example.com"],
+    ["https://example.com", "https://example.com/"],
+    ["https://example.com/foo", "https://example.com/bar"],
+    ["https://example.com/foo?a=1", "https://example.com/bar?b=2"],
+    ["https://example.com/#a", "https://example.com/#b"],
+
+    // Protocol and host are case-insensitive
+    ["HTTPS://example.com", "https://example.com"],
+    ["https://EXAMPLE.com", "https://example.com"],
+
+    // Identical explicit ports match
+    ["https://example.com:443", "https://example.com:443"],
+    ["https://example.com:8080/a", "https://example.com:8080/b"],
+
+    // Default ports are normalized
+    ["https://example.com", "https://example.com:443"],
+    ["http://example.com", "http://example.com:80"],
+
+    // Credentials are not part of the origin
+    ["https://user:pass@example.com", "https://example.com"],
+
+    // IDN / punycode
+    ["https://tést.com", "https://xn--tst-bma.com"],
+
+    // IPv6 hosts
+    ["http://[::1]:3000/a", "http://[::1]:3000/b"],
+  ];
+
+  const differentOrigin = [
+    // Different host
+    ["https://example.com", "https://example.org"],
+    ["https://example.com", "https://www.example.com"],
+    ["https://example.com", "https://example.com.evil.com"],
+    ["https://example.com", "https://evil.com/https://example.com"],
+    ["https://example.com@evil.com", "https://example.com"],
+
+    // Different protocol
+    ["http://example.com", "https://example.com"],
+    ["https://example.com", "ftp://example.com"],
+
+    // Different port
+    ["https://example.com:8080", "https://example.com"],
+    ["https://example.com:8080", "https://example.com:8081"],
+    ["http://example.com:443", "https://example.com:443"],
+    ["http://[::1]:3000", "http://[::1]:3001"],
+  ];
+
+  for (const [a, b] of sameOrigin) {
+    test(`${a} == ${b}`, () => {
+      expect(isSameOrigin(a, b)).toBe(true);
+      expect(isSameOrigin(b, a)).toBe(true); // symmetric
+    });
+  }
+
+  for (const [a, b] of differentOrigin) {
+    test(`${a} != ${b}`, () => {
+      expect(isSameOrigin(a, b)).toBe(false);
+      expect(isSameOrigin(b, a)).toBe(false); // symmetric
+    });
+  }
+
+  // Inputs with no determinable origin never match (even each other)
+  describe("no origin", () => {
+    const noOrigin = [
+      ["", ""],
+      ["/foo", "/foo"],
+      ["foo", "foo"],
+      ["/foo", "https://example.com/foo"],
+      ["https://example.com", ""],
+      ["mailto:a@example.com", "mailto:a@example.com"],
+      ["data:text/plain,hi", "data:text/plain,hi"],
+    ];
+    for (const [a, b] of noOrigin) {
+      test(`${JSON.stringify(a)} != ${JSON.stringify(b)}`, () => {
+        expect(isSameOrigin(a, b)).toBe(false);
+      });
+    }
+
+    test("undefined inputs", () => {
+      expect(isSameOrigin(undefined, undefined)).toBe(false);
+      expect(isSameOrigin("https://example.com", undefined)).toBe(false);
+    });
+  });
+
+  // Open questions to agree on before implementing
+  test.todo("protocol-relative URLs (//example.com) vs absolute URLs");
+  test.todo("scheme-less hosts (example.com/foo) — treated as paths?");
+  test.todo("trailing-dot hosts (example.com. vs example.com)");
+  test.todo("optional base argument for resolving relative inputs");
+});
