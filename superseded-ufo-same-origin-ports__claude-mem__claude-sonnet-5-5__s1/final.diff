+function getOrigin(input?: string): string | undefined {
+  if (!input) {
+    return undefined;
+  }
+  try {
+    // WHATWG URL normalizes case, punycode, credentials and default ports
+    const { origin } = new URL(input);
+    return origin === "null" ? undefined : origin;
+  } catch {
+    return undefined;
+  }
+}
+
+/**
+ * Check if two URLs have the same origin (protocol, host and port).
+ *
+ * Path, query, hash and credentials are ignored, and default ports (`:80` for http, `:443` for https) are normalized.
+ * Inputs without a determinable origin (relative paths, `mailto:`, `data:`, empty or `undefined`) never match.
+ *
+ * @example
+ * ```js
+ * isSameOrigin("https://example.com/foo", "https://example.com:443/bar"); // true
+ * isSameOrigin("https://example.com", "http://example.com"); // false
+ * ```
+ *
+ * @group utils
+ */
+export function isSameOrigin(a?: string, b?: string): boolean {
+  const originA = getOrigin(a);
+  return originA !== undefined && originA === getOrigin(b);
+}
