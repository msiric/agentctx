index 4fac6e9..4822e36 100644
--- a/index.d.ts
+++ b/index.d.ts
@@ -216,3 +216,26 @@ export default function prettyBytes(
 	number: number | bigint,
 	options?: Options
 ): string;
+
+/**
+Parse a human readable size string back into a number of bytes. The reverse of `prettyBytes`, for both its default and its `binary: true` output.
+
+Accepts a plain number (`'512'`), or a number followed by `B`, an SI unit (`kB`, `MB`, `GB`, `TB`, `PB`, `EB`, `ZB`, `YB`; powers of 1000) or a binary unit (`KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`, `ZiB`, `YiB`; powers of 1024), with an optional sign, a fractional value, and optional whitespace before the unit. `KB` is accepted as a spelling of `kB` (1000 bytes). Other than that, units are case-sensitive, and bit units are not supported.
+
+@throws A `TypeError` if the input is not a string, or a `SyntaxError` if it cannot be parsed or the unit is not supported.
+
+@example
+```
+import {parseBytes} from 'pretty-bytes';
+
+parseBytes('512');
+//=> 512
+
+parseBytes('1.5 kB');
+//=> 1500
+
+parseBytes('1.5 KiB');
+//=> 1536
+```
+*/
+export function parseBytes(string: string): number;
diff --git a/index.js b/index.js
index c5f37ab..8ca7986 100644
--- a/index.js
+++ b/index.js
@@ -285,3 +285,39 @@ export default function prettyBytes(number, options) {
 	const result = prefix + numberString + separator + UNITS[exponent];
 	return result.padStart(options.fixedWidth ?? 0);
 }
+
+// Binary units are powers of 1024 and SI units are powers of 1000. `KB` is accepted as a spelling of `kB`, so both mean 1000 bytes. Other than that, units are case-sensitive.
+const PARSE_UNITS = new Map([
+	...BIBYTE_UNITS.map((unit, exponent) => [unit, {base: 1024, exponent}]),
+	...BYTE_UNITS.map((unit, exponent) => [unit, {base: 1000, exponent}]),
+	['KB', {base: 1000, exponent: 1}],
+]);
+
+// An optional sign, a decimal number and an optional unit, which may be separated from the number by whitespace (a regular or non-breaking space, as `prettyBytes` writes it). Units are case-sensitive.
+const PARSE_PATTERN = /^([+-]?)(\d+(?:\.\d+)?|\.\d+)\s*(\S*)$/;
+
+export function parseBytes(string) {
+	if (typeof string !== 'string') {
+		throw new TypeError(`Expected a string, got ${typeof string}: ${string}`);
+	}
+
+	const match = PARSE_PATTERN.exec(string.trim());
+
+	if (!match) {
+		throw new SyntaxError(`Unable to parse bytes from: ${JSON.stringify(string)}`);
+	}
+
+	const [, sign, digits, unit = 'B'] = match;
+	const parsedUnit = PARSE_UNITS.get(unit || 'B');
+
+	if (parsedUnit === undefined) {
+		throw new SyntaxError(`Unsupported unit ${JSON.stringify(unit)} in: ${JSON.stringify(string)}`);
+	}
+
+	const {base, exponent} = parsedUnit;
+
+	// Scaling by a power of 1024 is exact, but `1.1 * 1000` is not `1100`, so SI values shift the decimal point instead.
+	const bytes = base === 1024 ? Number(digits) * (1024 ** exponent) : Number(`${digits}e${exponent * 3}`);
+
+	return sign === '-' && bytes !== 0 ? -bytes : bytes;
+}
