+
+test('parseBytes: plain numbers and bytes', t => {
+	t.is(parseBytes('0'), 0);
+	t.is(parseBytes('512'), 512);
+	t.is(parseBytes('512 B'), 512);
+	t.is(parseBytes('512B'), 512);
+	t.is(parseBytes('  512 B '), 512);
+	t.is(parseBytes('0.5'), 0.5);
+	t.is(parseBytes('.5 B'), 0.5);
+});
+
+test('parseBytes: binary units', t => {
+	for (const [exponent, unit] of BINARY_UNITS.entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1024 ** exponent);
+		t.is(parseBytes(`2${unit}`), 2 * (1024 ** exponent));
+	}
+
+	t.is(parseBytes('1.5 KiB'), 1536);
+	t.is(parseBytes('0.25 MiB'), 262_144);
+	t.is(parseBytes('1 YiB'), 2 ** 80);
+});
+
+test('parseBytes: signs', t => {
+	t.is(parseBytes('-1.5 KiB'), -1536);
+	t.is(parseBytes('+1.5 KiB'), 1536);
+	t.is(parseBytes('-0'), 0);
+	t.true(Object.is(parseBytes('-0 B'), 0));
+});
+
+test('parseBytes: round-trips prettyBytes binary output', t => {
+	for (const number of [0, 1, 512, 1536, 1024 ** 3, 5 * (1024 ** 5)]) {
+		t.is(parseBytes(prettyBytes(number, {binary: true})), number);
+	}
+});
+
+test('parseBytes: units are case-sensitive', t => {
+	for (const input of ['1 kib', '1 KIB', '1 b', '1 kiB', '1 mib', '1 mb', '1 gB']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError}, `${input}`);
+	}
+});
+
+test('parseBytes: SI units', t => {
+	for (const [exponent, unit] of ['B', 'kB', 'MB', 'GB', 'TB', 'PB', 'EB', 'ZB', 'YB'].entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1000 ** exponent, `${unit}`);
+		t.is(parseBytes(`2${unit}`), 2 * (1000 ** exponent), `${unit}`);
+	}
+
+	t.is(parseBytes('1 KB'), 1000);
+	t.is(parseBytes('1.1 kB'), 1100);
+	t.is(parseBytes('1.5 MB'), 1_500_000);
+	t.is(parseBytes('-2.5 GB'), -2_500_000_000);
+	t.is(parseBytes('1 YB'), 1e24);
+});
+
+test('parseBytes: SI and binary units differ', t => {
+	t.not(parseBytes('1 MB'), parseBytes('1 MiB'));
+	t.is(parseBytes('1 MB'), 1_000_000);
+	t.is(parseBytes('1 MiB'), 1_048_576);
+});
+
+test('parseBytes: round-trips prettyBytes SI output', t => {
+	for (const number of [0, 1, 512, 1500, 1_000_000, 2_500_000_000, 5e15]) {
+		t.is(parseBytes(prettyBytes(number)), number);
+	}
+});
+
+test('parseBytes: rejects unsupported units', t => {
+	for (const input of ['1 kb', '1 mB', '1 Mb', '1 gb', '1 bit', '1 kbit', '1 Kib', '1 K', '1 M']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError}, `${input}`);
+	}
+});
+
+test('parseBytes: rejects invalid input', t => {
+	for (const input of ['', ' ', 'KiB', 'abc', '1.', '1..5 KiB', '1 2 KiB', '1,5 KiB', '1e3', '--1', 'Infinity', 'NaN', '1 KiB B']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError}, `${input}`);
+	}
+
+	for (const input of [undefined, null, 5, 5n, {}]) {
+		t.throws(() => parseBytes(input), {instanceOf: TypeError});
+	}
+});
