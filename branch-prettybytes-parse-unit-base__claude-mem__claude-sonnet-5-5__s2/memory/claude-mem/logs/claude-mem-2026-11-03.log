[2026-11-03 03:21:34.739] [INFO ] [HOOK  ] → PostToolUse: Bash(cat >> index.js <<'EOF'

// Only the units `prettyBytes` writes with `binary: true` are read for now. The SI units (`kB`, `MB`, …) are deliberately left out until it is decided how they should be interpreted.
const PARSE_EXPONENTS = new Map(BIBYTE_UNITS.map((unit, exponent) => [unit, exponent]));

// An optional sign, a decimal number and an optional unit, which may be separated from the number by whitespace (a regular or non-breaking space, as `prettyBytes` writes it). Units are case-sensitive.
const PARSE_PATTERN = /^([+-]?)(\d+(?:\.\d+)?|\.\d+)\s*(\S*)$/;

export function parseBytes(string) {
	if (typeof string !== 'string') {
		throw new TypeError(`Expected a string, got ${typeof string}: ${string}`);
	}

	const match = PARSE_PATTERN.exec(string.trim());

	if (!match) {
		throw new SyntaxError(`Unable to parse bytes from: ${JSON.stringify(string)}`);
	}

	const [, sign, digits, unit = 'B'] = match;
	const exponent = PARSE_EXPONENTS.get(unit || 'B');

	if (exponent === undefined) {
		throw new SyntaxError(`Unsupported unit ${JSON.stringify(unit)} in: ${JSON.stringify(string)}`);
	}

	const bytes = Number(digits) * (1024 ** exponent);

	return sign === '-' && bytes !== 0 ? -bytes : bytes;
}
EOF
cat >> index.d.ts <<'EOF'

/**
Parse a human readable binary size string back into a number of bytes. The reverse of `prettyBytes(number, {binary: true})`.

Accepts a plain number (`'512'`), or a number followed by `B` or a binary unit (`KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`, `ZiB`, `YiB`), with an optional sign, a fractional value, and optional whitespace before the unit. Units are case-sensitive. SI units like `kB` and `MB` are not supported yet.

@throws A `TypeError` if the input is not a string, or a `SyntaxError` if it cannot be parsed or the unit is not supported.

@example
```
import {parseBytes} from 'pretty-bytes';

parseBytes('512');
//=> 512

parseBytes('1.5 KiB');
//=> 1536
```
*/
export function parseBytes(string: string): number;
EOF
cat >> index.test-d.ts <<'EOF'

expectType<number>(parseBytes('1.5 KiB'));
EOF
sed -i "s#^import prettyBytes from './index.js';#import prettyBytes, {parseBytes} from './index.js';#" index.test-d.ts test.js
cat >> test.js <<'EOF'

test('parseBytes: plain numbers and bytes', t => {
	t.is(parseBytes('0'), 0);
	t.is(parseBytes('512'), 512);
	t.is(parseBytes('512 B'), 512);
	t.is(parseBytes('512B'), 512);
	t.is(parseBytes('  512 B '), 512);
	t.is(parseBytes('0.5'), 0.5);
	t.is(parseBytes('.5 B'), 0.5);
});

test('parseBytes: binary units', t => {
	for (const [exponent, unit] of BINARY_UNITS.entries()) {
		t.is(parseBytes(`1 ${unit}`), 1024 ** exponent);
		t.is(parseBytes(`2${unit}`), 2 * (1024 ** exponent));
	}

	t.is(parseBytes('1.5 KiB'), 1536);
	t.is(parseBytes('0.25 MiB'), 262_144);
	t.is(parseBytes('1 YiB'), 2 ** 80);
});

test('parseBytes: signs', t => {
	t.is(parseBytes('-1.5 KiB'), -1536);
	t.is(parseBytes('+1.5 KiB'), 1536);
	t.is(parseBytes('-0'), 0);
	t.true(Object.is(parseBytes('-0 B'), 0));
});

test('parseBytes: round-trips prettyBytes binary output', t => {
	for (const number of [0, 1, 512, 1536, 1024 ** 3, 5 * (1024 ** 5)]) {
		t.is(parseBytes(prettyBytes(number, {binary: true})), number);
	}
});

test('parseBytes: units are case-sensitive', t => {
	for (const input of ['1 kib', '1 KIB', '1 b', '1 kiB', '1 mib']) {
		t.throws(() => parseBytes(input), {instanceOf: SyntaxError}, input);
	}
});

test('parseBytes: SI units are not supported yet', t => {
	for (const input of ['1 kB', '1 MB', '1 GB', '1 KB', '1 TB', '1 YB', '1 bit']) {
		t.throws(() => parseBytes(input), {instanceOf: SyntaxError}, input);
	}
});

test('parseBytes: rejects invalid input', t => {
	for (const input of ['', ' ', 'KiB', 'abc', '1.', '1..5 KiB', '1 2 KiB', '1,5 KiB', '1e3', '--1', 'Infinity', 'NaN', '1 KiB B']) {
		t.throws(() => parseBytes(input), {instanceOf: SyntaxError}, input);
	}

	for (const input of [undefined, null, 5, 5n, {}]) {
		t.throws(() => parseBytes(input), {instanceOf: TypeError});
	}
});
EOF
