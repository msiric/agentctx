test('parseBytes: round-trips prettyBytes binary output', t => {
	for (const number of [0, 1, 512, 1536, 1024 ** 3, 5 * (1024 ** 5)]) {
		t.is(parseBytes(prettyBytes(number, {binary: true})), number);
	}
});

test('parseBytes: units are case-sensitive', t => {
	for (const input of ['1 kib', '1 KIB', '1 b', '1 kiB', '1 mib']) {
		t.throws(() => parseBytes(input), {instanceOf: SyntaxError}, input);
	}
});

test('parseBytes: SI units are not supported yet', t => {
	for (const input of ['1 kB', '1 MB', '1 GB', '1 KB', '1 TB', '1 YB', '1 bit']) {
		t.throws(() => parseBytes(input), {instanceOf: SyntaxError}, input);
	}
});

test('parseBytes: rejects invalid input', t => {
	for (const input of ['', ' ', 'KiB', 'abc', '1.', '1..5 KiB', '1 2 KiB', '1,5 KiB', '1e3', '--1', 'Infinity', 'NaN', '1 KiB B']) {
		t.throws(() => parseBytes(input), {instanceOf: SyntaxError}, input);
	}

	for (const input of [undefined, null, 5, 5n, {}]) {
		t.throws(() => parseBytes(input), {instanceOf: TypeError});
	}
});
EOF
