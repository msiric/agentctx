+def test_get_default_used_when_missing(cli, dotenv_path):
+    result = cli.invoke(dotenv_cli, ["--file", dotenv_path, "get", "a", "--default", "d"])
+
+    assert (result.exit_code, result.output) == (0, "d\n")
+
+
+def test_get_default_used_when_no_value(cli, dotenv_path):
+    dotenv_path.write_text("a")
+
+    result = cli.invoke(dotenv_cli, ["--file", dotenv_path, "get", "a", "--default", "d"])
+
+    assert (result.exit_code, result.output) == (0, "d\n")
+
+
+def test_get_default_ignored_when_set(cli, dotenv_path):
+    dotenv_path.write_text("a=b")
+
+    result = cli.invoke(dotenv_cli, ["--file", dotenv_path, "get", "a", "--default", "d"])
+
+    assert (result.exit_code, result.output) == (0, "b\n")
+
+
+def test_get_default_ignored_for_empty_string(cli, dotenv_path):
+    dotenv_path.write_text("a=\n")
+
+    result = cli.invoke(dotenv_cli, ["--file", dotenv_path, "get", "a", "--default", "d"])
+
+    assert (result.exit_code, result.output) == (0, "\n")
+
+
+def test_get_empty_default(cli, dotenv_path):
+    result = cli.invoke(dotenv_cli, ["--file", dotenv_path, "get", "a", "--default", ""])
+
+    assert (result.exit_code, result.output) == (0, "\n")
+
+
+def test_get_default_does_not_mask_unreadable_file(cli):
+    result = cli.invoke(dotenv_cli, ["--file", "nx_file", "get", "a", "--default", "d"])
+
+    assert result.exit_code == 2
+
