@@ -49,6 +49,41 @@ def test_json_kwargs(tmpdir):
     db.close()
 
 
+def test_json_sort_keys_default(tmpdir):
+    path = str(tmpdir.join('test.db'))
+    storage = JSONStorage(path)
+    storage.write({'b': 1, 'a': {'d': 1, 'c': 2}})
+    storage.close()
+
+    assert open(path).read() == '{"a": {"c": 2, "d": 1}, "b": 1}'
+
+
+def test_json_sort_keys_disabled(tmpdir):
+    path = str(tmpdir.join('test.db'))
+    storage = JSONStorage(path, sort_keys=False)
+    storage.write({'b': 1, 'a': 2})
+    storage.close()
+
+    assert open(path).read() == '{"b": 1, "a": 2}'
+
+
+def test_json_sort_keys_mixed_key_types(tmpdir):
+    data = {'hits': {200: 1520, 'other': 3}}
+
+    # Default: falls back to unsorted instead of raising
+    path = str(tmpdir.join('a.db'))
+    storage = JSONStorage(path)
+    storage.write(data)
+    storage.close()
+    assert json.load(open(path)) == {'hits': {'200': 1520, 'other': 3}}
+
+    # Explicit sort_keys=True keeps json's behaviour
+    storage = JSONStorage(str(tmpdir.join('b.db')), sort_keys=True)
+    with pytest.raises(TypeError):
+        storage.write(data)
+    storage.close()
+
+
