+function doy(d) {
+	// day of year (1-366); uses UTC math on the local Y/M/D so DST can't skew it
+	return (Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()) - Date.UTC(d.getFullYear(), 0, 0)) / 864e5;
+}
