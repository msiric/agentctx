+    def _run_job_collecting(self, job: "Job", errors: List[Exception]) -> None:
+        # Keep running the remaining jobs if this one raises; the caller
+        # re-raises the first error once all jobs have run.
+        try:
+            self._run_job(job)
+        except Exception as e:
+            logger.exception("Job %s raised an exception", job)
+            errors.append(e)
+
+    @staticmethod
+    def _raise_first(errors: List[Exception]) -> None:
+        if errors:
+            if len(errors) > 1:
+                logger.error(
+                    "%i jobs failed; re-raising the first, others were logged",
+                    len(errors),
+                )
+            raise errors[0]
+
