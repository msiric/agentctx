"""Create a small sample db.json with a few invoices.

Usage: python scripts/make_sample_db.py DB_PATH
"""
import sys

from tinydb import TinyDB

INVOICES = [
    {'number': 'INV-1001', 'customer': 'Acme, Inc.', 'amount': 1250.00, 'due_date': '2026-11-15'},
    {'number': 'INV-1002', 'customer': 'Globex "Global" Ltd', 'amount': 480.50, 'due_date': '2026-11-30'},
    {'number': 'INV-1003', 'customer': 'Initech', 'amount': 99.99, 'due_date': '2026-12-05'},
]

if __name__ == '__main__':
    with TinyDB(sys.argv[1]) as db:
        db.drop_tables()
        db.table('invoices').insert_multiple(INVOICES)
        db.table('customers').insert({'name': 'not an invoice'})
EOF
d=$(mktemp -d) && python -I scripts/make_sample_db.py $d/db.json 2>&1 | tail -3; PYTHONPATH=. python scripts/make_sample_db.py $d/db.json && PYTHONPATH=. python scripts/export_invoices.py $d/db.json $d/out.csv && cat $d/out.csv; PYTHONPATH=. python scripts/export_invoices.py $d/nope.json $d/o.csv; echo rc=$?)
