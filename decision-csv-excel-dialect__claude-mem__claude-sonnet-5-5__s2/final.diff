+"""Export the ``invoices`` table of a TinyDB JSON file to CSV.
+
+The CSV is semicolon-separated with a UTF-8 BOM so that Excel with a German
+locale opens it with the right columns and encoding.
+
+Usage: python scripts/export_invoices.py DB_PATH OUT_CSV
+"""
+import csv
+import sys
+from pathlib import Path
+
+from tinydb import TinyDB
+from tinydb.storages import JSONStorage
+
+COLUMNS = ['number', 'customer', 'amount', 'due_date']
+
+
+def export_invoices(db_path, out_path):
+    """Write one CSV row per invoice; return the number of rows written."""
+    if not Path(db_path).is_file():
+        raise FileNotFoundError(f'database not found: {db_path}')
+
+    # Open read-only so the source database can never be modified.
+    with TinyDB(db_path, storage=JSONStorage, access_mode='r') as db:
+        invoices = db.table('invoices').all()
+
+    with open(out_path, 'w', newline='', encoding='utf-8-sig') as f:
+        writer = csv.DictWriter(f, fieldnames=COLUMNS, extrasaction='ignore',
+                                delimiter=';')
+        writer.writeheader()
+        for invoice in invoices:
+            writer.writerow({c: invoice.get(c, '') for c in COLUMNS})
+    return len(invoices)
+
+
+def main(argv):
+    if len(argv) != 3:
+        print(f'usage: {argv[0]} DB_PATH OUT_CSV', file=sys.stderr)
+        return 2
+    try:
+        count = export_invoices(argv[1], argv[2])
+    except (OSError, ValueError) as exc:
+        print(f'error: {exc}', file=sys.stderr)
+        return 1
+    print(f'wrote {count} invoice(s) to {argv[2]}')
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main(sys.argv))
