+        with open(path, 'w', newline='', encoding='utf-8') as f:
+            writer = csv.writer(f)
+            writer.writerow(columns)
+            for doc in docs:
+                writer.writerow(
+                    ['' if doc.get(c) is None else doc[c] for c in columns]
+                )
