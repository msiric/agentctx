+    def status(self) -> List[dict]:
+        """
+        Describe every scheduled job in a JSON-serialisable form.
+
+        :return: A list with one dict per job, with the keys ``job``
+                 (name of the job function), ``interval``, ``unit``,
+                 ``last_run`` and ``next_run``. Datetimes are epoch
+                 milliseconds as integers (naive datetimes are taken
+                 as local time), or None if not set (e.g. never run).
+        """
+
+        result = []
+        for job in self.jobs:
+            func = job.job_func
+            name = getattr(func, "__name__", None) or repr(func)
+            result.append(
+                {
+                    "job": name,
+                    "interval": job.interval,
+                    "unit": job.unit,
+                    "last_run": _epoch_ms(job.last_run),
+                    "next_run": _epoch_ms(job.next_run),
+                }
+            )
+        return result
