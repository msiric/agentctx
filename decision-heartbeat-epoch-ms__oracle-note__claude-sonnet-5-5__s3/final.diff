+    def test_status(self):
+        import json
+
+        def my_job():
+            pass
+
+        scheduler = schedule.Scheduler()
+        assert scheduler.status() == []
+        scheduler.every(5).minutes.do(my_job)
+        with mock_datetime(2024, 1, 1, 12, 0, 0):
+            scheduler.every().day.at("10:30").do(my_job)
+            first = scheduler.jobs[0]
+            first.last_run = datetime.datetime(2024, 1, 1, 11, 0, 0)
+        status = scheduler.status()
+        assert len(status) == 2
+        assert status[0]["job"] == "my_job"
+        assert status[0]["interval"] == 5
+        assert status[0]["unit"] == "minutes"
+        assert status[0]["last_run"] == int(
+            datetime.datetime(2024, 1, 1, 11, 0, 0).timestamp() * 1000
+        )
+        assert isinstance(status[0]["last_run"], int)
+        assert status[0]["next_run"] == round(first.next_run.timestamp() * 1000)
+        assert status[1]["unit"] == "days"
+        assert status[1]["last_run"] is None
+        assert status[1]["next_run"] == int(
+            datetime.datetime(2024, 1, 2, 10, 30, 0).timestamp() * 1000
+        )
+        json.dumps(status)
+
+    def test_heartbeat(self):
+        import json
+        import tempfile
+
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "heartbeat.json")
+            scheduler = schedule.Scheduler(heartbeat_path=path)
+
+            # No jobs: next_run is null
+            with mock_datetime(2024, 1, 1, 12, 0, 0):
+                scheduler.run_pending()
+                now_ms = int(datetime.datetime.now().timestamp() * 1000)
+            with open(path) as f:
+                beat = json.load(f)
+            assert beat == {"last_pass": now_ms, "next_run": None}
+            assert isinstance(beat["last_pass"], int)
+
+            # With jobs: next_run is the earliest, last_pass updates
+            with mock_datetime(2024, 1, 1, 12, 0, 0):
+                scheduler.every(10).minutes.do(lambda: None)
+                scheduler.every(5).minutes.do(lambda: None)
+            with mock_datetime(2024, 1, 1, 12, 1, 0):
+                scheduler.run_pending()
+                now_ms = int(datetime.datetime.now().timestamp() * 1000)
+            with open(path) as f:
+                beat = json.load(f)
+            assert beat["last_pass"] == now_ms
+            assert beat["next_run"] == int(
+                datetime.datetime(2024, 1, 1, 12, 5, 0).timestamp() * 1000
+            )
+            assert isinstance(beat["next_run"], int)
+            assert os.listdir(tmp) == ["heartbeat.json"]
+
+    def test_heartbeat_disabled_by_default(self):
