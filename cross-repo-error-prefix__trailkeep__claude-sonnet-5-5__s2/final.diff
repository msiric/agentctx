+test('largestUnit', () => {
+	const milliseconds = 93_784_005; // 1d 2h 3m 4s 5ms
+	const rest = {milliseconds: 5, microseconds: 0, nanoseconds: 0};
+
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit: 'days'}), parseMilliseconds(milliseconds));
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit: 'hours'}), {
+		days: 0, hours: 26, minutes: 3, seconds: 4, ...rest,
+	});
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit: 'minutes'}), {
+		days: 0, hours: 0, minutes: 1563, seconds: 4, ...rest,
+	});
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit: 'seconds'}), {
+		days: 0, hours: 0, minutes: 0, seconds: 93_784, ...rest,
+	});
+	assert.deepStrictEqual(parseMilliseconds(-milliseconds, {largestUnit: 'hours'}), {
+		days: 0, hours: -26, minutes: -3, seconds: -4, milliseconds: -5, microseconds: -0, nanoseconds: -0,
+	});
+
+	const bigRest = {milliseconds: 5n, microseconds: 0n, nanoseconds: 0n};
+	const bigint = BigInt(milliseconds);
+	assert.deepStrictEqual(parseMilliseconds(bigint, {largestUnit: 'hours'}), {
+		days: 0n, hours: 26n, minutes: 3n, seconds: 4n, ...bigRest,
+	});
+	assert.deepStrictEqual(parseMilliseconds(bigint, {largestUnit: 'minutes'}), {
+		days: 0n, hours: 0n, minutes: 1563n, seconds: 4n, ...bigRest,
+	});
+	assert.deepStrictEqual(parseMilliseconds(bigint, {largestUnit: 'seconds'}), {
+		days: 0n, hours: 0n, minutes: 0n, seconds: 93_784n, ...bigRest,
+	});
+	assert.deepStrictEqual(parseMilliseconds(bigint), parseMilliseconds(bigint, {largestUnit: 'days'}));
+});
+
+test('largestUnit errors', () => {
+	for (const largestUnit of ['weeks', 'day', '', null, 1, {}]) {
+		assert.throws(() => {
+			parseMilliseconds(1000, {largestUnit});
+		}, {name: 'TypeError', message: /^parse-ms: /v});
+
+		assert.throws(() => {
+			parseMilliseconds(1000n, {largestUnit});
+		}, TypeError);
+	}
+});
