#!/usr/bin/env python3
"""Assign about a third of the traps to held-out, deterministically.

    bench/tools/split-traps [COMMIT]   (default: the first commit that added bench/traps)

Each trap's rank is sha256(COMMIT + id). For each family with at least two
traps, the lowest-ranked one is a held-out candidate; candidates are taken in
rank order until a third of all traps are held out. The pilot is the three
lowest-ranked dev traps from three different non-control families. Writes
bench/plans/SPLIT.json. Nobody picks: the commit that adds the traps fixes
both, and later fixes to a trap don't change them.
"""
import glob, hashlib, json, os, subprocess, sys

BENCH = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
traps_dir = os.path.join(BENCH, "traps")
commit = sys.argv[1] if len(sys.argv) > 1 else subprocess.run(
    ["git", "log", "--reverse", "--format=%H", "--", traps_dir], cwd=BENCH, text=True, capture_output=True).stdout.split("\n")[0].strip()
if not commit:
    sys.exit("commit the traps first")
traps = [json.load(open(f)) for f in sorted(glob.glob(os.path.join(traps_dir, "*", "trap.json")))]
rank = lambda t: hashlib.sha256((commit + t["id"]).encode()).hexdigest()
fams = {}
for t in traps:
    fams.setdefault(t["family"], []).append(t)
candidates = sorted((min(ts, key=rank) for ts in fams.values() if len(ts) >= 2), key=rank)
held = {t["id"] for t in candidates[: round(len(traps) / 3)]}
dev = [t for t in traps if t["id"] not in held]
pilot, seen = [], set()
for t in sorted(dev, key=rank):
    if t["family"] != "control" and t["family"] not in seen and len(pilot) < 3:
        pilot.append(t["id"]); seen.add(t["family"])
split = {"commit": commit, "held_out": sorted(held), "dev": sorted(t["id"] for t in dev), "pilot": pilot}
json.dump(split, open(os.path.join(BENCH, "plans", "SPLIT.json"), "w"), indent=1)
print(json.dumps(split, indent=1))
