+class NonEmpty:
+    """
+    Rejects empty values: empty or whitespace-only strings and empty
+    containers. Returns the data unchanged otherwise.
+    """
+
+    def __init__(self, error: Union[str, None] = None) -> None:
+        self._error: Union[str, None] = error
+
+    def __repr__(self) -> str:
+        return f"{self.__class__.__name__}()"
+
+    def validate(self, data: Any, **kwargs: Any) -> Any:
+        if isinstance(data, str):
+            empty = not data.strip()
+        else:
+            try:
+                empty = len(data) == 0
+            except TypeError:
+                raise SchemaError(
+                    self._error or f"expected a string or a container, got {type(data).__name__}"
+                )
+        if empty:
+            raise SchemaError(self._error or "value must not be empty")
+        return data
+
+
+class Range:
+    """
+    Validates that a number lies within inclusive bounds.
+    Error messages never include the validated value.
+    """
+
+    def __init__(
+        self,
+        min: Union[int, float, None] = None,
+        max: Union[int, float, None] = None,
+        error: Union[str, None] = None,
+    ) -> None:
+        self._min = min
+        self._max = max
+        self._error: Union[str, None] = error
+
+    def __repr__(self) -> str:
+        return f"{self.__class__.__name__}(min={self._min!r}, max={self._max!r})"
+
+    def validate(self, data: Any, **kwargs: Any) -> Any:
+        if isinstance(data, bool) or not isinstance(data, (int, float)):
+            raise SchemaError(
+                self._error or f"expected a number, got {type(data).__name__}"
+            )
+        if self._min is not None and data < self._min:
+            raise SchemaError(self._error or f"value is below the minimum of {self._min!r}")
+        if self._max is not None and data > self._max:
+            raise SchemaError(self._error or f"value is above the maximum of {self._max!r}")
+        return data
+
+
+class OneOf:
+    """
+    Validates that the data equals one of the given choices.
+    Error messages never include the validated value.
+    """
+
+    def __init__(self, *choices: Any, error: Union[str, None] = None) -> None:
+        self._choices = choices
+        self._error: Union[str, None] = error
+
+    def __repr__(self) -> str:
+        return f"{self.__class__.__name__}({', '.join(map(repr, self._choices))})"
+
+    def validate(self, data: Any, **kwargs: Any) -> Any:
+        try:
+            ok = data in self._choices
+        except TypeError:
+            ok = False
+        if not ok:
+            raise SchemaError(
+                self._error
+                or "value is not one of the allowed choices: "
+                + ", ".join(map(repr, self._choices))
+            )
+        return data
+
+
 COMPARABLE, CALLABLE, VALIDATOR, TYPE, DICT, ITERABLE = range(6)
 
 
diff --git a/test_schema.py b/test_schema.py
index 4d78456..e362326 100644
--- a/test_schema.py
+++ b/test_schema.py
@@ -22,6 +22,9 @@ from schema import (
     Forbidden,
     Hook,
     Literal,
+    NonEmpty,
+    OneOf,
+    Range,
     Optional,
     Or,
     Regex,
@@ -2100,3 +2103,34 @@ def test_tuple_key_error_message_does_not_crash():
     with raises(SchemaError) as exc_info:
         Schema({("a", "b"): int}).validate({("a", "b"): "not-an-int"})
     assert "Key '('a', 'b')' error:" in exc_info.value.code
+
+
+def test_nonempty():
+    assert NonEmpty().validate("x") == "x"
+    assert NonEmpty().validate([1]) == [1]
+    for bad in ("", "   ", [], {}):
+        with SE:
+            NonEmpty().validate(bad)
+
+
+def test_range():
+    assert Range(0, 10).validate(0) == 0
+    assert Range(0, 10).validate(10) == 10
+    assert Range(min=1.5).validate(2) == 2
+    with SE:
+        Range(0, 10).validate(11)
+    with SE:
+        Range(min=0).validate(-1)
+    with SE:
+        Range(0, 10).validate("5")
+    with SE:
+        Range(0, 10).validate(True)
+
+
+def test_oneof():
+    assert OneOf("red", "green").validate("red") == "red"
+    with SE:
+        OneOf("red", "green").validate("blue")
+    assert Schema({"color": OneOf("red", "green")}).validate({"color": "green"}) == {
+        "color": "green"
+    }
