diff --git a/tests/test_none.py b/tests/test_none.py
new file mode 100644
index 0000000..43b074a
--- /dev/null
+++ b/tests/test_none.py
@@ -0,0 +1,14 @@
+import tomli_w
+
+
+def test_none_written_as_empty_string_in_tables():
+    obj = {"a": 1, "b": None, "t": {"x": None, "y": 2}}
+    assert tomli_w.dumps(obj) == 'a = 1\nb = ""\n\n[t]\nx = ""\ny = 2\n'
+
+
+def test_none_in_inline_tables():
+    assert tomli_w.dumps({"arr": [{"x": None, "y": 1}]}) == 'arr = [\n    { x = "", y = 1 },\n]\n'
+
+
+def test_none_in_arrays():
+    assert tomli_w.dumps({"a": [1, None]}) == 'a = [\n    1,\n    "",\n]\n'
