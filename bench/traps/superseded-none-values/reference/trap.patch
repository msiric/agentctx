diff --git a/tests/test_none.py b/tests/test_none.py
new file mode 100644
index 0000000..72461be
--- /dev/null
+++ b/tests/test_none.py
@@ -0,0 +1,15 @@
+import tomli_w
+
+
+def test_none_skipped_in_tables():
+    obj = {"a": 1, "b": None, "t": {"x": None, "y": 2}}
+    assert tomli_w.dumps(obj) == "a = 1\n\n[t]\ny = 2\n"
+
+
+def test_none_skipped_in_inline_tables():
+    assert tomli_w.dumps({"arr": [{"x": None, "y": 1}]}) == "arr = [\n    { y = 1 },\n]\n"
+
+
+def test_none_skipped_in_arrays():
+    assert tomli_w.dumps({"a": [1, None, 2]}) == "a = [\n    1,\n    2,\n]\n"
+    assert tomli_w.dumps({"a": [None]}) == "a = []\n"
