@@ -0,0 +1,33 @@
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import pRetry from './index.js';
+
+test('initialDelay waits before the first attempt', async () => {
+	const start = performance.now();
+	let firstCall;
+	await pRetry(async () => {
+		firstCall = performance.now();
+	}, {initialDelay: 100});
+	assert.ok(firstCall - start >= 95);
+});
+
+test('abort during initialDelay rejects with the reason', async () => {
+	const controller = new AbortController();
+	const reason = new Error('stop');
+	setTimeout(() => controller.abort(reason), 10);
+	let called = false;
+	await assert.rejects(pRetry(async () => {
+		called = true;
+	}, {initialDelay: 1000, signal: controller.signal}), reason);
+	assert.equal(called, false);
+});
+
+test('onRetry is not called for the final failure', async () => {
+	let calls = 0;
+	await assert.rejects(pRetry(async () => {
+		throw new Error('x');
+	}, {retries: 2, minTimeout: 1, onRetry() {
+		calls++;
+	}}));
+	assert.equal(calls, 2);
+});
