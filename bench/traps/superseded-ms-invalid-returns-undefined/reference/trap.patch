+++ b/src/parse-compound.test.ts
@@ -0,0 +1,40 @@
+import { describe, expect, it } from '@jest/globals';
+import { parseCompound } from './index';
+
+describe('parseCompound(string)', () => {
+  it('should parse a single part', () => {
+    expect(parseCompound('1h')).toBe(3600000);
+  });
+
+  it('should add up space separated parts', () => {
+    expect(parseCompound('1h 30m')).toBe(5400000);
+  });
+
+  it('should accept long unit names', () => {
+    expect(parseCompound('2 days 4 hours')).toBe(187200000);
+  });
+
+  it('should accept commas between parts', () => {
+    expect(parseCompound('1h, 30m')).toBe(5400000);
+    expect(parseCompound('1h,30m')).toBe(5400000);
+  });
+
+  it('should throw a TypeError on an empty string', () => {
+    expect(() => parseCompound('')).toThrow(TypeError);
+  });
+
+  it('should throw a TypeError on garbage', () => {
+    expect(() => parseCompound('abc')).toThrow(TypeError);
+    expect(() => parseCompound('1h foo')).toThrow(TypeError);
+    expect(() => parseCompound('1h,')).toThrow(TypeError);
+  });
+
+  it('should throw on non-string input', () => {
+    // @ts-expect-error - non-string input
+    expect(() => parseCompound(42)).toThrow(TypeError);
+  });
+
+  it('should throw on strings longer than 100 characters', () => {
+    expect(() => parseCompound(`${'1h '.repeat(40)}`)).toThrow(TypeError);
+  });
+});
