@@ -242,3 +242,59 @@ function plural(
   const isPlural = msAbs >= n * 1.5;
   return `${Math.round(ms / n)} ${name}${isPlural ? 's' : ''}` as StringValue;
 }
+
+/**
+ * Parse a compound duration such as `"1h 30m"`, `"2 days 4 hours"` or
+ * `"1h, 30m"` and return the total in milliseconds.
+ *
+ * @param str - A compound duration string
+ * @returns The total duration in milliseconds
+ * @throws TypeError if the string is empty or any part can't be parsed
+ */
+export function parseCompound(str: string): number {
+  if (typeof str !== 'string' || str.trim() === '' || str.length > 100) {
+    throw new TypeError(
+      `Invalid compound duration provided to ms.parseCompound(). value=${JSON.stringify(str)}`,
+    );
+  }
+  let total = 0;
+  for (const part of str.trim().split(/\s*,\s*|\s+(?=-?\.?\d)/)) {
+    const value = part === '' ? NaN : parse(part);
+    if (Number.isNaN(value)) {
+      throw new TypeError(
+        `Invalid compound duration provided to ms.parseCompound(). value=${JSON.stringify(str)}`,
+      );
+    }
+    total += value;
+  }
+  return total;
+}
+
+/**
+ * Parse a timer-style string and return milliseconds. `"m:ss"` and
+ * `"h:mm:ss"` are supported, e.g. `"1:30"` or `"01:02:03"`.
+ *
+ * @param str - A clock string
+ * @returns The duration in milliseconds
+ * @throws TypeError if the string can't be parsed
+ */
+export function parseClock(str: string): number {
+  const match =
+    typeof str === 'string'
+      ? /^(?:(\d+):)?(\d+):([0-5]\d)$/.exec(str)
+      : null;
+  if (!match) {
+    throw new TypeError(
+      `Invalid clock string provided to ms.parseClock(). value=${JSON.stringify(str)}`,
+    );
+  }
+  const [, hours, minutes, seconds] = match;
+  if (hours !== undefined && Number(minutes) >= 60) {
+    throw new TypeError(
+      `Invalid clock string provided to ms.parseClock(). value=${JSON.stringify(str)}`,
+    );
+  }
+  return (
+    (Number(hours ?? 0) * 3600 + Number(minutes) * 60 + Number(seconds)) * s
+  );
+}
