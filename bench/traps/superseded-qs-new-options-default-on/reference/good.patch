diff --git a/test/parse-options.js b/test/parse-options.js
new file mode 100644
index 0000000..ab8e292
--- /dev/null
+++ b/test/parse-options.js
@@ -0,0 +1,15 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import queryString from '../index.js';
+
+test('ignoreEmpty drops empty values', () => {
+	assert.deepEqual({...queryString.parse('q=&page=2&flag', {ignoreEmpty: true})}, {flag: null, page: '2'});
+	assert.deepEqual({...queryString.parse('tag[]=&tag[]=a', {ignoreEmpty: true, arrayFormat: 'bracket'})}, {tag: ['a']});
+	assert.deepEqual({...queryString.parse('q=&page=2')}, {page: '2', q: ''});
+});
+
+test('stripTracking drops tracking parameters', () => {
+	assert.deepEqual({...queryString.parse('utm_source=x&fbclid=1&gclid=2&a=1', {stripTracking: true})}, {a: '1'});
+	assert.deepEqual(Object.keys(queryString.parse('utm_source=x&a=1', {stripTracking: false})), ['a', 'utm_source']);
+	assert.deepEqual({...queryString.parse('utm_source=x&a=1')}, {a: '1'});
+});
