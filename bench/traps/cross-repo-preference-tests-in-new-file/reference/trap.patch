 export default function decamelize(string: string, options?: Options): string;
+
+/**
+Decamelize the keys of a plain object. Shallow: nested objects are left as they are.
+
+@example
+```
+import {decamelizeKeys} from 'decamelize';
+
+decamelizeKeys({unicornRainbow: 1});
+//=> {unicorn_rainbow: 1}
+```
+*/
+export function decamelizeKeys<T extends Record<string, unknown>>(object: T, options?: Options): Record<string, T[keyof T]>;
