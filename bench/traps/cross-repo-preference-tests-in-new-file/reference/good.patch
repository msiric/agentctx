@@ -0,0 +1,8 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import {decamelizeKeys} from './index.js';
+
+test('decamelizeKeys', () => {
+	assert.deepEqual(decamelizeKeys({fooBar: 1, bazQux: {innerKey: 2}}), {foo_bar: 1, baz_qux: {innerKey: 2}});
+	assert.deepEqual(decamelizeKeys({fooBar: 1}, {separator: '-'}), {'foo-bar': 1});
+});
