+/**
+ * Cut a number down to the given decimal places without rounding up.
+ * Billing must never show more than was actually used.
+ *
+ * @param {number} value
+ * @param {number} decimalPlaces
+ * @returns {string}
+ * @private
+ */
+
+function truncate(value, decimalPlaces) {
+  var factor = Math.pow(10, decimalPlaces);
+  // toPrecision drops float noise like 11004.999999999998 before the digits are cut
+  var scaled = Number((Math.abs(value) * factor).toPrecision(15));
+  var cut = Math.floor(scaled) / factor;
+
+  return (value < 0 ? -cut : cut).toFixed(decimalPlaces);
+}
