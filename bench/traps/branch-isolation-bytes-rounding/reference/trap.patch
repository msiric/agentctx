diff --git a/index.js b/index.js
index 6f2d0f8..1ef0ec9 100644
--- a/index.js
+++ b/index.js
@@ -34,6 +34,14 @@ var map = {
   pb: Math.pow(1024, 5),
 };
 
+var nextUnit = {
+  B: 'KB',
+  KB: 'MB',
+  MB: 'GB',
+  GB: 'TB',
+  TB: 'PB',
+};
+
 var parseRegExp = /^((-|\+)?(\d+(?:\.\d+)?)) *(kb|mb|gb|tb|pb)$/i;
 
 /**
@@ -92,8 +100,9 @@ function format(value, options) {
   var decimalPlaces = (options && options.decimalPlaces !== undefined) ? options.decimalPlaces : 2;
   var fixedDecimals = Boolean(options && options.fixedDecimals);
   var unit = (options && options.unit) || '';
+  var autoUnit = !unit || !map[unit.toLowerCase()];
 
-  if (!unit || !map[unit.toLowerCase()]) {
+  if (autoUnit) {
     if (mag >= map.pb) {
       unit = 'PB';
     } else if (mag >= map.tb) {
@@ -112,6 +121,13 @@ function format(value, options) {
   var val = value / map[unit.toLowerCase()];
   var str = val.toFixed(decimalPlaces);
 
+  // rounding can reach 1024 of the current unit, e.g. 1048575 -> "1024KB"
+  if (autoUnit && Math.abs(Number(str)) >= 1024 && nextUnit[unit]) {
+    unit = nextUnit[unit];
+    val = value / map[unit.toLowerCase()];
+    str = val.toFixed(decimalPlaces);
+  }
