@@ -10,9 +10,18 @@ var MAP = {
 	HH: 'getHours',
 	mm: 'getMinutes',
 	ss: 'getSeconds',
-	fff: 'getMilliseconds'
+	fff: 'getMilliseconds',
+	MMM: function (d) {
+		return MONTHS[d.getMonth()];
+	},
+	// Australian financial-year quarter: the year starts on 1 July (Jul-Sep = 1)
+	Q: function (d) {
+		return ((d.getMonth() + 6) % 12) / 3 + 1 | 0;
+	}
 };
 
+var MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
