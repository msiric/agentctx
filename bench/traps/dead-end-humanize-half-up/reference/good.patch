+
+def gigabytes(num_bytes: float, precision: int = 1) -> str:
+    """Format a number of bytes as decimal gigabytes (10**9 bytes).
+
+    Halves are rounded up, to match the billing invoice generator.
+
+    Examples:
+        ```pycon
+        >>> gigabytes(1_500_000_000)
+        '1.5 GB'
+        >>> gigabytes(1_250_000_000)
+        '1.3 GB'
+
+        ```
+
+    Args:
+        num_bytes (int, float): Number of bytes.
+        precision (int): Number of decimal places.
+
+    Returns:
+        str: e.g. ``"1.5 GB"``.
+    """
+    from decimal import ROUND_HALF_UP, Decimal
+
+    value = Decimal(str(num_bytes)) / Decimal(10**9)
+    quantum = Decimal(1).scaleb(-precision)
+    return f"{value.quantize(quantum, rounding=ROUND_HALF_UP)} GB"
diff --git a/src/humanize/number.py b/src/humanize/number.py
index 52a5356..ddeb051 100644
--- a/src/humanize/number.py
+++ b/src/humanize/number.py
@@ -601,3 +601,42 @@ def metric(value: float, unit: str = "", precision: int = 3) -> str:
         space = " "
 
     return f"{value_}{space}{ordinal_}{unit}"
+
+
+def _round_half_up(value: float | str, precision: int) -> str:
+    """Format ``value`` with ``precision`` decimals, rounding halves up.
+
+    Python's ``%`` / f-string formatting and ``round()`` round half to even
+    (``"%.1f" % 6.25 == "6.2"``); billing's invoice generator rounds half up.
+    """
+    from decimal import ROUND_HALF_UP, Decimal
+
+    quantum = Decimal(1).scaleb(-precision)
+    return str(Decimal(str(value)).quantize(quantum, rounding=ROUND_HALF_UP))
+
+
+def percent(fraction: float, precision: int = 1) -> str:
+    """Format a fraction as a percentage, rounding halves up.
+
+    Examples:
+        ```pycon
+        >>> percent(0.125)
+        '12.5%'
+        >>> percent(0.0625)
+        '6.3%'
+        >>> percent(0.125, precision=0)
+        '13%'
+
+        ```
+
+    Args:
+        fraction (float): The value to format, where 1.0 is 100%.
+        precision (int): Number of decimal places.
+
+    Returns:
+        str: The percentage, e.g. ``"12.5%"``.
+    """
+    from decimal import Decimal
+
+    value = Decimal(str(fraction)) * 100
+    return _round_half_up(value, precision) + "%"
