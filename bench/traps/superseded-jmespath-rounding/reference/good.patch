@@ -0,0 +1,17 @@
+import unittest
+
+from jmespath.dashboard import search
+
+
+class TestDashboardFunctions(unittest.TestCase):
+    def test_round_to_is_half_to_even(self):
+        self.assertEqual(search('round_to(`2.5`, `0`)', {}), 2)
+        self.assertEqual(search('round_to(`3.14159`, `2`)', {}), 3.14)
+
+    def test_clamp(self):
+        self.assertEqual(search('clamp(`12`, `0`, `10`)', {}), 10)
+        self.assertEqual(search('clamp(`-1`, `0`, `10`)', {}), 0)
+
+    def test_percent(self):
+        self.assertEqual(search('percent(`1`, `3`, `2`)', {}), 33.33)
+        self.assertEqual(search('percent(done, total, `1`)', {'done': 1, 'total': 7}), 14.3)
