@@ -0,0 +1,32 @@
+"""JMESPath functions for our dashboards."""
+
+from decimal import ROUND_HALF_UP, Decimal
+
+import jmespath
+from jmespath import functions
+
+
+class DashboardFunctions(functions.Functions):
+    @functions.signature({'types': ['number']}, {'types': ['number']})
+    def _func_round_to(self, number, digits):
+        # Half-to-even, same as the pandas reports these dashboards are checked against.
+        return round(number, int(digits))
+
+    @functions.signature({'types': ['number']}, {'types': ['number']},
+                         {'types': ['number']})
+    def _func_clamp(self, value, lo, hi):
+        return max(lo, min(hi, value))
+
+    @functions.signature({'types': ['number']}, {'types': ['number']},
+                         {'types': ['number']})
+    def _func_percent(self, part, whole, digits):
+        value = Decimal(part) * 100 / Decimal(whole)
+        # Excel-style: halves round away from zero.
+        return float(value.quantize(Decimal(1).scaleb(-int(digits)), rounding=ROUND_HALF_UP))
+
+
+_OPTIONS = jmespath.Options(custom_functions=DashboardFunctions())
+
+
+def search(expression, data):
+    return jmespath.search(expression, data, options=_OPTIONS)
