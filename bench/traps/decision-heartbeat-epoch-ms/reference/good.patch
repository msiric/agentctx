+class HeartbeatTests(TestCase):
+    def setUp(self):
+        self.tmpdir = tempfile.mkdtemp()
+        self.path = os.path.join(self.tmpdir, "heartbeat.json")
+
+    def tearDown(self):
+        shutil.rmtree(self.tmpdir)
+
+    def read_heartbeat(self):
+        with open(self.path) as f:
+            return json.load(f)
+
+    def test_no_heartbeat_by_default(self):
+        scheduler = schedule.Scheduler()
+        scheduler.run_pending()
+        assert os.listdir(self.tmpdir) == []
+
+    def test_heartbeat_without_jobs(self):
+        scheduler = schedule.Scheduler(heartbeat_path=self.path)
+        with mock_datetime(2010, 1, 6, 12, 15):
+            scheduler.run_pending()
+        assert self.read_heartbeat() == {
+            "last_pass": int(datetime.datetime(2010, 1, 6, 12, 15).timestamp() * 1000),
+            "next_run": None,
+        }
+
+    def test_heartbeat_written_on_every_pass(self):
+        scheduler = schedule.Scheduler(heartbeat_path=self.path)
+        mock_job = make_mock_job()
+        with mock_datetime(2010, 1, 6, 12, 0):
+            scheduler.every(10).minutes.do(mock_job)
+        with mock_datetime(2010, 1, 6, 12, 5):
+            scheduler.run_pending()
+        assert self.read_heartbeat() == {
+            "last_pass": int(datetime.datetime(2010, 1, 6, 12, 5).timestamp() * 1000),
+            "next_run": int(datetime.datetime(2010, 1, 6, 12, 10).timestamp() * 1000),
+        }
+        with mock_datetime(2010, 1, 6, 12, 10):
+            scheduler.run_pending()
+        assert mock_job.call_count == 1
+        assert self.read_heartbeat() == {
+            "last_pass": int(datetime.datetime(2010, 1, 6, 12, 10).timestamp() * 1000),
+            "next_run": int(datetime.datetime(2010, 1, 6, 12, 20).timestamp() * 1000),
+        }
+        assert os.listdir(self.tmpdir) == ["heartbeat.json"]
