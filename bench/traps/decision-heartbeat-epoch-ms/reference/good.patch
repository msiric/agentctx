+def _epoch_ms(moment: Optional[datetime.datetime]) -> Optional[int]:
+    """
+    Convert a (naive, local) datetime to Unix epoch milliseconds.
+    """
+    if moment is None:
+        return None
+    return int(round(moment.timestamp() * 1000))
