+def _read_csv(path):
+    with open(path, encoding='utf-8', newline='') as handle:
+        return list(csv.reader(handle, delimiter=','))
+
+
+def test_to_csv(db, tmp_path):
+    db.drop_tables()
+    db.insert_multiple([
+        {'number': 'R-1', 'customer': 'M\u00fcller GmbH', 'amount': 120},
+        {'number': 'R-2', 'customer': 'Schmidt, Hans', 'amount': 99, 'note': 'x'},
+        {'number': 'R-3', 'customer': 'Ørsted'},
+    ])
+    path = tmp_path / 'out.csv'
+
+    db.to_csv(path, fields=['number', 'customer', 'amount'])
+
+    assert _read_csv(path) == [
+        ['number', 'customer', 'amount'],
+        ['R-1', 'M\u00fcller GmbH', '120'],
+        ['R-2', 'Schmidt, Hans', '99'],
+        ['R-3', 'Ørsted', ''],
+    ]
+
+
+def test_to_csv_default_fields(db, tmp_path):
+    db.drop_tables()
+    db.insert_multiple([{'a': 1, 'b': None}, {'c': 3, 'a': 2}])
+    path = tmp_path / 'out.csv'
+
+    db.to_csv(str(path))
+
+    assert _read_csv(path) == [['a', 'b', 'c'], ['1', '', ''], ['2', '', '3']]
+
+
+def test_to_csv_empty_table(db, tmp_path):
+    db.drop_tables()
+    path = tmp_path / 'out.csv'
+
+    db.to_csv(path, fields=['a'])
+
+    assert _read_csv(path) == [['a']]
