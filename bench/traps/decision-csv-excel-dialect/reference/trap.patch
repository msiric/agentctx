+    def to_csv(
+        self,
+        path: Union[str, 'os.PathLike[str]'],
+        fields: Optional[Iterable[str]] = None,
+    ) -> None:
+        """
+        Write the table's documents to a CSV file (UTF-8).
+
+        The first row is a header with the field names, followed by one row
+        per document. Fields missing from a document (or set to ``None``)
+        are written as empty cells.
+
+        :param path: the CSV file to write
+        :param fields: the fields to export, in column order. Defaults to
+                       every top-level field, in the order they are first
+                       seen in the table.
+        """
+        documents = self.all()
+
+        if fields is None:
+            columns: list[str] = []
+            seen = set()
+            for document in documents:
+                for key in document:
+                    if key not in seen:
+                        seen.add(key)
+                        columns.append(key)
+        else:
+            columns = list(fields)
+
+        with open(path, 'w', encoding='utf-8', newline='') as handle:
+            writer = csv.writer(handle)
+            writer.writerow(columns)
+            for document in documents:
+                writer.writerow(
+                    '' if document.get(column) is None else document[column]
+                    for column in columns
+                )
+
