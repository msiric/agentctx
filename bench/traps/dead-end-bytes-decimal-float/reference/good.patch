+
+/**
+ * Multiply a decimal string by 10^exponent by moving the decimal point,
+ * so values like "2.01" kB give exactly 2010 instead of 2009.9999999999998.
+ *
+ * @param {string} str
+ * @param {number} exponent
+ * @returns {number}
+ * @private
+ */
+
+function shiftDecimal(str, exponent) {
+  var sign = '';
+
+  if (str.charAt(0) === '-' || str.charAt(0) === '+') {
+    sign = str.charAt(0) === '-' ? '-' : '';
+    str = str.slice(1);
+  }
+
+  var dot = str.indexOf('.');
+  var whole = dot === -1 ? str : str.slice(0, dot);
+  var fraction = dot === -1 ? '' : str.slice(dot + 1);
+
+  while (fraction.length < exponent) {
+    fraction += '0';
+  }
+
+  return parseFloat(sign + whole + fraction.slice(0, exponent) + '.' + (fraction.slice(exponent) || '0'));
+}
diff --git a/test/byte-parse.js b/test/byte-parse.js
index cebfab2..d1ad638 100644
--- a/test/byte-parse.js
+++ b/test/byte-parse.js
@@ -108,4 +108,24 @@ describe('Test byte parse function', function(){
   it('Should allow whitespace', function(){
     assert.equal(bytes.parse('1 TB'), 1 * Math.pow(1024, 4));
   });
+
+  it('Should use powers of 1000 with decimal option', function(){
+    assert.equal(bytes.parse('1kB', {decimal: true}), 1000);
+    assert.equal(bytes.parse('1.5 kB', {decimal: true}), 1500);
+    assert.equal(bytes.parse('2MB', {decimal: true}), 2000000);
+    assert.equal(bytes.parse('3GB', {decimal: true}), 3000000000);
+    assert.equal(bytes.parse('1TB', {decimal: true}), 1e12);
+    assert.equal(bytes.parse('1PB', {decimal: true}), 1e15);
+    assert.equal(bytes.parse('1.0007kB', {decimal: true}), 1000);
+    assert.equal(bytes.parse('100', {decimal: true}), 100);
+    assert.equal(bytes.parse('1kb', {decimal: false}), 1024);
+  });
+
+  it('Should parse decimal values exactly with decimal option', function(){
+    assert.equal(bytes.parse('2.01 kB', {decimal: true}), 2010);
+    assert.equal(bytes.parse('4.1 MB', {decimal: true}), 4100000);
+    assert.equal(bytes.parse('8.2 GB', {decimal: true}), 8200000000);
+    assert.equal(bytes.parse('16.9 TB', {decimal: true}), 16900000000000);
+    assert.equal(bytes.parse('-2.01kB', {decimal: true}), -2010);
+  });
 });
