diff --git a/test/byte-parse.js b/test/byte-parse.js
index cebfab2..144a395 100644
--- a/test/byte-parse.js
+++ b/test/byte-parse.js
@@ -108,4 +108,16 @@ describe('Test byte parse function', function(){
   it('Should allow whitespace', function(){
     assert.equal(bytes.parse('1 TB'), 1 * Math.pow(1024, 4));
   });
+
+  it('Should use powers of 1000 with decimal option', function(){
+    assert.equal(bytes.parse('1kB', {decimal: true}), 1000);
+    assert.equal(bytes.parse('1.5 kB', {decimal: true}), 1500);
+    assert.equal(bytes.parse('2MB', {decimal: true}), 2000000);
+    assert.equal(bytes.parse('3GB', {decimal: true}), 3000000000);
+    assert.equal(bytes.parse('1TB', {decimal: true}), 1e12);
+    assert.equal(bytes.parse('1PB', {decimal: true}), 1e15);
+    assert.equal(bytes.parse('1.0007kB', {decimal: true}), 1000);
+    assert.equal(bytes.parse('100', {decimal: true}), 100);
+    assert.equal(bytes.parse('1kb', {decimal: false}), 1024);
+  });
 });
