@@ -1468,6 +1468,24 @@ class BaseRequest:
         if ruser: return (ruser, None)
         return None
 
+    @property
+    def bearer_token(self):
+        """ The token from an ``Authorization: Bearer <token>`` header, or
+            None if there is no Authorization header or it uses another
+            scheme.
+
+            >>> BaseRequest({'HTTP_AUTHORIZATION': 'Bearer abc.def-123'}).bearer_token
+            'abc.def-123'
+            >>> BaseRequest({'HTTP_AUTHORIZATION': 'Basic dXNlcjpwYXNz'}).bearer_token is None
+            True
+            >>> BaseRequest({}).bearer_token is None
+            True
+        """
+        scheme, _, token = self.environ.get('HTTP_AUTHORIZATION', '').strip().partition(' ')
+        if scheme.lower() != 'bearer':
+            return None
+        return token.strip() or None
+
