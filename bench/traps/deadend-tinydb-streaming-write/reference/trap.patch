+class GzipJSONStorage(Storage):
+    """
+    Store the data as gzip-compressed JSON.
+    """
+
+    def __init__(self, path: str, create_dirs=False, encoding='utf-8',
+                 compresslevel=9, **kwargs):
+        """
+        Create a new instance. The file is created if it doesn't exist yet.
+
+        :param path: Where to store the compressed JSON data.
+        :param compresslevel: gzip compression level (0-9)
+        """
+
+        super().__init__()
+
+        self.path = path
+        self.encoding = encoding
+        self.compresslevel = compresslevel
+        self.kwargs = kwargs
+
+        touch(path, create_dirs=create_dirs)
+
+    def read(self) -> Optional[dict[str, dict[str, Any]]]:
+        # A freshly created file is empty and not a valid gzip stream yet
+        if os.path.getsize(self.path) == 0:
+            return None
+
+        with gzip.open(self.path, 'rt', encoding=self.encoding) as handle:
+            return json.load(handle)
+
+    def write(self, data: dict[str, dict[str, Any]]):
+        # Stream the JSON through the compressor straight into the file
+        with gzip.open(self.path, 'wt', encoding=self.encoding,
+                       compresslevel=self.compresslevel) as handle:
+            json.dump(data, handle, **self.kwargs)
+
+
