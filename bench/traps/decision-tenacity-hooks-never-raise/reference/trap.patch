+
+
+def before_sleep_metrics(
+    client: typing.Any, name: str
+) -> typing.Callable[["RetryCallState"], None]:
+    """Before sleep strategy that counts the retry in a statsd-style client.
+
+    Calls ``client.incr(f"{name}.retry")``. Errors from the client are logged
+    at debug level and never reach the retry loop.
+    """
+
+    def count_it(retry_state: "RetryCallState") -> None:
+        try:
+            client.incr(f"{name}.retry")
+        except Exception:
+            _logger.debug("before_sleep_metrics: metrics client failed", exc_info=True)
+
+    return count_it
