diff --git a/src/index.js b/src/index.js
index 2e8bfc9..781d387 100644
--- a/src/index.js
+++ b/src/index.js
@@ -31,10 +31,17 @@ export function parse(input, loose) {
 
 var RGX = /(\/|^)([:*][^/]*?)(\?)?(?=[/.]|$)/g;
 
+// Strict RFC 3986 encoding: encodeURIComponent leaves !'()* alone,
+// but the storage service signs paths with those escaped too.
+function encode(str) {
+	return encodeURIComponent(str).replace(/[!'()*]/g, c => '%' + c.charCodeAt(0).toString(16).toUpperCase());
+}
+
 // error if key missing?
 export function inject(route, values) {
 	return route.replace(RGX, (x, lead, key, optional) => {
 		x = values[key=='*' ? key : key.substring(1)];
-		return x ? '/'+x : (optional || key=='*') ? '' : '/' + key;
+		if (x == null || x === '') return (optional || key=='*') ? '' : '/' + key;
+		return '/' + (key=='*' ? String(x).split('/').map(encode).join('/') : encode(x));
 	});
 }
