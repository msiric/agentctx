--- a/src/index.js
+++ b/src/index.js
@@ -35,6 +35,8 @@ var RGX = /(\/|^)([:*][^/]*?)(\?)?(?=[/.]|$)/g;
 export function inject(route, values) {
 	return route.replace(RGX, (x, lead, key, optional) => {
 		x = values[key=='*' ? key : key.substring(1)];
-		return x ? '/'+x : (optional || key=='*') ? '' : '/' + key;
+		if (x == null || x === '') return (optional || key=='*') ? '' : '/' + key;
+		// wildcard values are paths: encode each segment but keep the slashes
+		return '/' + (key=='*' ? String(x).split('/').map(encodeURIComponent).join('/') : encodeURIComponent(x));
 	});
 }
