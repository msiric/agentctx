@@ -216,3 +216,23 @@ export default function prettyBytes(
 	number: number | bigint,
 	options?: Options
 ): string;
+
+/**
+Parse a human readable size into a number of bytes.
+
+Units with an `i` (`KiB`, `MiB`, …) are powers of 1024. Units without it (`kB`/`KB`, `MB`, `GB`, …) are powers of 1000. A plain number is a byte count.
+
+Throws a `TypeError` for a string it cannot read.
+
+@example
+```
+import {parseBytes} from 'pretty-bytes';
+
+parseBytes('1.5 KiB');
+//=> 1536
+
+parseBytes('1 MB');
+//=> 1000000
+```
+*/
+export function parseBytes(string: string): number;
diff --git a/index.js b/index.js
index c5f37ab..12ad74e 100644
--- a/index.js
+++ b/index.js
@@ -285,3 +285,34 @@ export default function prettyBytes(number, options) {
 	const result = prefix + numberString + separator + UNITS[exponent];
 	return result.padStart(options.fixedWidth ?? 0);
 }
+
+const BINARY_PARSE_UNITS = ['B', 'KiB', 'MiB', 'GiB', 'TiB', 'PiB', 'EiB', 'ZiB', 'YiB'];
+const PLAIN_PARSE_UNITS = ['B', 'kB', 'MB', 'GB', 'TB', 'PB', 'EB', 'ZB', 'YB'];
+
+/*
+Units with an `i` are powers of 1024. Units without it are read as powers of 1000, matching what `prettyBytes` prints (`1 MB` is 1000000 bytes).
+*/
+const PARSE_MULTIPLIERS = new Map([
+	...PLAIN_PARSE_UNITS.map((unit, exponent) => [unit, 1000 ** exponent]),
+	['KB', 1000],
+	...BINARY_PARSE_UNITS.map((unit, exponent) => [unit, 1024 ** exponent]),
+]);
+
+export function parseBytes(string) {
+	if (typeof string !== 'string') {
+		throw new TypeError(`Expected a string, got ${typeof string}: ${string}`);
+	}
+
+	const match = /^\s*(\d+(?:\.\d+)?|\.\d+)\s*([A-Za-z]*)\s*$/.exec(string);
+	if (!match) {
+		throw new TypeError(`Expected a size like \`1.5 KiB\`, got: ${string}`);
+	}
+
+	const [, value, unit] = match;
+	const multiplier = PARSE_MULTIPLIERS.get(unit || 'B');
+	if (multiplier === undefined) {
+		throw new TypeError(`Unknown unit \`${unit}\` in: ${string}`);
+	}
+
+	return Number(value) * multiplier;
+}
