 __all__ = ('Storage', 'JSONStorage', 'MemoryStorage')
 
 
+def _json_key(key: Any) -> Any:
+    """
+    Convert a dict key to the string ``json.dumps`` would write for it.
+
+    Keys of other types are returned unchanged so that ``json`` reports them
+    as usual.
+    """
+    if isinstance(key, str):
+        return key
+    if key is True:
+        return 'true'
+    if key is False:
+        return 'false'
+    if key is None:
+        return 'null'
+    if isinstance(key, (int, float)):
+        return json.dumps(key)
+    return key
+
+
+def _stringify_keys(value: Any) -> Any:
+    """
+    Recursively replace dict keys with their JSON string form.
+
+    ``json.dumps(..., sort_keys=True)`` compares the raw keys and raises a
+    ``TypeError`` for dicts that mix key types (e.g. ``{200: 1, 'other': 2}``).
+    JSON turns every key into a string anyway, so converting them first gives
+    the same document and makes the keys sortable.
+    """
+    if isinstance(value, dict):
+        return {_json_key(k): _stringify_keys(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [_stringify_keys(v) for v in value]
+    return value
+
