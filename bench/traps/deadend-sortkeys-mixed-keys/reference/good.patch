+def test_json_sorts_keys_by_default(tmpdir):
+    db_file = tmpdir.join('test.db')
+    db = TinyDB(str(db_file))
+    db.insert({'b': 1, 'a': {'d': 1, 'c': 2}})
+    db.close()
+
+    assert db_file.read() == (
+        '{"_default": {"1": {"a": {"c": 2, "d": 1}, "b": 1}}}'
+    )
+
+
+def test_json_sort_keys_can_be_disabled(tmpdir):
+    db_file = tmpdir.join('test.db')
+    db = TinyDB(str(db_file), sort_keys=False)
+    db.insert({'b': 1, 'a': 2})
+    db.close()
+
+    assert db_file.read() == '{"_default": {"1": {"b": 1, "a": 2}}}'
+
+
+def test_json_sorted_keys_with_mixed_key_types(tmpdir):
+    path = str(tmpdir.join('test.db'))
+    db = TinyDB(path)
+    db.insert({'endpoint': '/api', 'hits': {200: 5, 404: 1, 'other': 2}})
+    db.close()
+
+    db = TinyDB(path)
+    assert db.all() == [
+        {'endpoint': '/api', 'hits': {'200': 5, '404': 1, 'other': 2}}
+    ]
+    db.close()
+
