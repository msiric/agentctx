@@ -1147,3 +1147,19 @@ test('the options shape the output as documented', t => {
 		t.is(prettyBytes(value, {signed: true}), prefix + prettyBytes(Math.abs(value)));
 	}
 });
+
+test('unit option', t => {
+	t.is(prettyBytes(1337, {unit: 'MB'}), '0.00134 MB');
+	t.is(prettyBytes(1337, {unit: 'B'}), '1337 B');
+	t.is(prettyBytes(2e6, {bits: true, unit: 'Mbit'}), '2 Mbit');
+	t.throws(() => prettyBytes(1337, {unit: 'KiB'}), {instanceOf: TypeError});
+});
+
+test('significantDigits option', t => {
+	t.is(prettyBytes(1337, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4}), '1.337 kB');
+	t.is(prettyBytes(1999, {significantDigits: 1}), '2 kB');
+	for (const value of [0, -1, 2.5, Number.NaN, 'two', 101]) {
+		t.is(prettyBytes(1337, {significantDigits: value}), '1.34 kB');
+	}
+});
