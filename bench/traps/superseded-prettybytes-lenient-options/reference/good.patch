@@ -240,6 +240,44 @@ prettyBytes(100_000, {fixedWidth: 10});
 //=> ['    1 kB', '   10 kB', '  100 kB']
 ```
 
+##### unit
+
+Type: `string`\
+Default: `undefined`
+
+Always format the number in this unit instead of picking one automatically.
+
+Must be a unit of the unit system selected by `bits` and `binary`. Throws a `TypeError` otherwise.
+
+```js
+import prettyBytes from 'pretty-bytes';
+
+prettyBytes(1337, {unit: 'MB'});
+//=> '0.00134 MB'
+
+prettyBytes(1337, {unit: 'B'});
+//=> '1337 B'
+```
+
+##### significantDigits
+
+Type: `number`\
+Default: `3`
+
+The number of significant digits to round to. Only used when neither `minimumFractionDigits` nor `maximumFractionDigits` is set.
+
+Invalid values (anything but an integer between 1 and 100) are ignored, and the default is used instead.
+
+```js
+import prettyBytes from 'pretty-bytes';
+
+prettyBytes(1337, {significantDigits: 2});
+//=> '1.3 kB'
+
+prettyBytes(1337, {significantDigits: 4});
+//=> '1.337 kB'
+```
+
 ## FAQ
 
 ### Why kB and not KB?
