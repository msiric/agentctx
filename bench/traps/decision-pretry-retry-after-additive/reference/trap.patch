diff --git a/test-retry-after.js b/test-retry-after.js
new file mode 100644
index 0000000..7d00567
--- /dev/null
+++ b/test-retry-after.js
@@ -0,0 +1,26 @@
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import pRetry from './index.js';
+
+test('waits for retryAfter before the next attempt', async () => {
+	const times = [];
+	await pRetry(async attempt => {
+		times.push(performance.now());
+		if (attempt === 1) {
+			throw Object.assign(new Error('429'), {retryAfter: 0.1});
+		}
+	}, {retries: 1, minTimeout: 10, factor: 1});
+	assert.ok(times[1] - times[0] >= 95);
+});
+
+test('context has elapsedTime', async () => {
+	let elapsed;
+	await pRetry(async attempt => {
+		if (attempt === 1) {
+			throw new Error('x');
+		}
+	}, {retries: 1, minTimeout: 5, onFailedAttempt({elapsedTime}) {
+		elapsed = elapsedTime;
+	}});
+	assert.equal(typeof elapsed, 'number');
+});
