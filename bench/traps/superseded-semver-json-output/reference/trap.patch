+def _read_versions(args: argparse.Namespace) -> List[Version]:
+    """
+    Parse the versions given as arguments, or read them from stdin
+    (one per line, blank lines ignored) when no arguments are given.
+    """
+    raw = list(args.versions)
+    if not raw:
+        raw = [line.strip() for line in sys.stdin if line.strip()]
+    return [Version.parse(v) for v in raw]
+
+
+def cmd_sort(args: argparse.Namespace) -> str:
+    """
+    Subcommand: Sorts versions, oldest first.
+
+    Synopsis: sort [VERSION ...]
+
+    Prints plain text, one version per line (the Jenkins release job
+    reads it with ``while read``).
+
+    :param args: The parsed arguments
+    """
+    return "\n".join(str(v) for v in sorted(_read_versions(args)))
+
+
+def cmd_latest(args: argparse.Namespace) -> str:
+    """
+    Subcommand: Prints the highest version that is not a prerelease.
+
+    Synopsis: latest [VERSION ...]
+
+    :param args: The parsed arguments
+    """
+    releases = [v for v in _read_versions(args) if not v.prerelease]
+    if not releases:
+        raise ValueError("No release version given")
+    return str(max(releases))
+
+
 def createparser() -> argparse.ArgumentParser:
