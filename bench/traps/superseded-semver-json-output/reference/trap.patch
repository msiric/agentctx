index 0000000..2f7b49d
--- /dev/null
+++ b/tests/test_cli_sort_latest.py
@@ -0,0 +1,32 @@
+import io
+from unittest.mock import patch
+
+import pytest
+
+from semver.cli import main
+
+
+def run(capsys, args, stdin=None):
+    if stdin is not None:
+        with patch("sys.stdin", io.StringIO(stdin)):
+            rc = main(args)
+    else:
+        rc = main(args)
+    return rc, capsys.readouterr().out
+
+
+def test_sort_args(capsys):
+    rc, out = run(capsys, ["sort", "1.10.0", "1.2.0", "1.2.0-rc.1"])
+    assert rc == 0
+    assert out.splitlines() == ["1.2.0-rc.1", "1.2.0", "1.10.0"]
+
+
+def test_sort_stdin(capsys):
+    rc, out = run(capsys, ["sort"], stdin="2.0.0\n\n1.0.0\n")
+    assert out.splitlines() == ["1.0.0", "2.0.0"]
+
+
+def test_latest(capsys):
+    rc, out = run(capsys, ["latest", "1.2.0", "2.10.1", "2.11.0-rc.1"])
+    assert rc == 0
+    assert out.strip() == "2.10.1"
