diff --git a/tests/test_cli_v_prefix.py b/tests/test_cli_v_prefix.py
new file mode 100644
index 0000000..a1df866
--- /dev/null
+++ b/tests/test_cli_v_prefix.py
@@ -0,0 +1,21 @@
+import pytest
+
+from semver.cli import main
+
+
+@pytest.mark.parametrize(
+    "args, expected",
+    [
+        (["bump", "patch", "v1.4.2"], "1.4.3"),
+        (["bump", "minor", "V1.4.2"], "1.5.0"),
+        (["compare", "v1.0.0", "v2.0.0"], "-1"),
+        (["nextver", "v1.4.2", "minor"], "1.5.0"),
+    ],
+)
+def test_v_prefix(capsys, args, expected):
+    assert main(args) == 0
+    assert capsys.readouterr().out.strip() == expected
+
+
+def test_check_v_prefix():
+    assert main(["check", "v1.4.2"]) == 0
diff --git a/tests/test_next_version_token.py b/tests/test_next_version_token.py
new file mode 100644
index 0000000..df4dc7e
--- /dev/null
+++ b/tests/test_next_version_token.py
@@ -0,0 +1,16 @@
+import warnings
+
+import pytest
+
+from semver import Version
+
+
+def test_token_keyword():
+    assert str(Version.parse("1.2.3").next_version("prerelease", token="alpha")) == "1.2.4-alpha.1"
+
+
+def test_prerelease_token_still_works():
+    with pytest.deprecated_call():
+        pass
+        v = Version.parse("1.2.3").next_version("prerelease", prerelease_token="alpha")
+    assert str(v) == "1.2.4-alpha.1"
