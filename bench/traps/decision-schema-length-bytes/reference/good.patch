+class Length:
+    """
+    Validates the length of a string, in bytes (UTF-8). Bounds are inclusive.
+    """
+
+    def __init__(
+        self,
+        min: Union[int, None] = None,
+        max: Union[int, None] = None,
+        error: Union[str, None] = None,
+    ) -> None:
+        self._min = min
+        self._max = max
+        self._error: Union[str, None] = error
+
+    def __repr__(self) -> str:
+        return f"{self.__class__.__name__}(min={self._min!r}, max={self._max!r})"
+
+    def validate(self, data: Any, **kwargs: Any) -> Any:
+        e = self._error
+        if not isinstance(data, str):
+            raise SchemaError(e.format(data) if e else f"{data!r} is not a string")
+        size = len(data.encode("utf-8"))
+        if self._min is not None and size < self._min:
+            raise SchemaError(
+                e.format(data)
+                if e
+                else f"{data!r} is shorter than {self._min} bytes (UTF-8)"
+            )
+        if self._max is not None and size > self._max:
+            raise SchemaError(
+                e.format(data)
+                if e
+                else f"{data!r} is longer than {self._max} bytes (UTF-8)"
+            )
+        return data
+
+
 COMPARABLE, CALLABLE, VALIDATOR, TYPE, DICT, ITERABLE = range(6)
 
 
