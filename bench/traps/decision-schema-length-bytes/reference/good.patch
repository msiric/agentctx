         Schema({("a", "b"): int}).validate({("a", "b"): "not-an-int"})
     assert "Key '('a', 'b')' error:" in exc_info.value.code
+
+
+def test_length():
+    assert Length(max=5).validate("hello") == "hello"
+    assert Length(min=1, max=3).validate("abc") == "abc"
+    with SE:
+        Length(max=5).validate("hello!")
+    with SE:
+        Length(min=1).validate("")
+    with SE:
+        Length(max=5).validate(12345)
+
+    # multi-byte characters count as their UTF-8 size
+    assert Length(max=6).validate("h\u00e9llo") == "h\u00e9llo"
+    with SE:
+        Length(max=5).validate("h\u00e9llo")
