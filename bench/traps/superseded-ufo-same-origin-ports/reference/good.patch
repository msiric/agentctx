+
+const DEFAULT_PORTS: Record<string, string> = {
+  "http:": "80",
+  "https:": "443",
+  "ws:": "80",
+  "wss:": "443",
+};
+
+function getOriginKey(input: string): string | undefined {
+  const { protocol, host } = parseURL(input);
+  if (!protocol || !host) {
+    return undefined;
+  }
+  const _protocol = protocol.toLowerCase();
+  const { hostname, port } = parseHost(host);
+  const _port = port && port !== DEFAULT_PORTS[_protocol] ? port : "";
+  return `${_protocol}//${hostname.toLowerCase()}:${_port}`;
+}
+
+/**
+ * Checks if two URLs have the same origin (protocol, hostname and port).
+ *
+ * Hostnames are compared case-insensitively and an explicit default port (`80` for http, `443` for https) is the same as no port. Relative URLs have no origin and never match.
+ *
+ * @example
+ *
+ * ```js
+ * isSameOrigin("https://example.com/foo", "https://example.com/bar"); // true
+ * isSameOrigin("https://example.com:443", "https://example.com"); // true
+ * isSameOrigin("http://example.com", "https://example.com"); // false
+ * ```
+ *
+ * @group utils
+ */
+export function isSameOrigin(a: string, b: string): boolean {
+  const originA = getOriginKey(a);
+  return !!originA && originA === getOriginKey(b);
+}
