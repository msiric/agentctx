diff --git a/test/same-origin.test.ts b/test/same-origin.test.ts
new file mode 100644
index 0000000..d88be5c
--- /dev/null
+++ b/test/same-origin.test.ts
@@ -0,0 +1,34 @@
+import { describe, expect, test } from "vitest";
+import { isSameOrigin } from "../src";
+
+describe("isSameOrigin", () => {
+  const tests = [
+    // Same origin
+    { a: "https://example.com", b: "https://example.com", out: true },
+    { a: "https://example.com/foo?x=1#y", b: "https://example.com/bar", out: true },
+    { a: "https://EXAMPLE.com", b: "https://example.com", out: true },
+    { a: "http://localhost:3000/a", b: "http://localhost:3000/b", out: true },
+
+    // Different protocol, host or port
+    { a: "http://example.com", b: "https://example.com", out: false },
+    { a: "https://example.com", b: "https://example.org", out: false },
+    { a: "https://example.com", b: "https://sub.example.com", out: false },
+    { a: "https://example.com:8443", b: "https://example.com", out: false },
+    { a: "http://localhost:3000", b: "http://localhost:3001", out: false },
+
+    // An explicit default port is the same as no port
+    { a: "https://example.com:443", b: "https://example.com", out: true },
+    { a: "http://example.com:80/foo", b: "http://example.com/foo", out: true },
+    { a: "http://example.com:443", b: "https://example.com", out: false },
+
+    // Relative URLs have no origin
+    { a: "/foo", b: "/foo", out: false },
+  ];
+
+  for (const t of tests) {
+    test(`isSameOrigin(${JSON.stringify(t.a)}, ${JSON.stringify(t.b)}) === ${t.out}`, () => {
+      expect(isSameOrigin(t.a, t.b)).toBe(t.out);
+      expect(isSameOrigin(t.b, t.a)).toBe(t.out);
+    });
+  }
+});
