+/**
+ * Compound format for `ms`, compatible with Go's `time.ParseDuration`.
+ */
+function fmtCompound(ms: number): string {
+  const sign = ms < 0 ? '-' : '';
+  let rest = Math.floor(Math.abs(ms) / s);
+  const hours = Math.floor(rest / 3600);
+  rest -= hours * 3600;
+  const minutes = Math.floor(rest / 60);
+  const seconds = rest - minutes * 60;
+  let out = '';
+  if (hours) out += `${hours}h`;
+  if (minutes) out += `${minutes}m`;
+  if (seconds || !out) out += `${seconds}s`;
+  return sign + out;
+}
