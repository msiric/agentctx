+/**
+ * Compound format for `ms`.
+ */
+function fmtCompound(ms: number): string {
+  const sign = ms < 0 ? '-' : '';
+  let rest = Math.floor(Math.abs(ms) / s);
+  const parts: string[] = [];
+  for (const [size, unit] of [
+    [86400, 'd'],
+    [3600, 'h'],
+    [60, 'm'],
+    [1, 's'],
+  ] as const) {
+    const count = Math.floor(rest / size);
+    rest -= count * size;
+    if (count) parts.push(`${count}${unit}`);
+  }
+  return sign + (parts.length ? parts.join(' ') : '0s');
+}
