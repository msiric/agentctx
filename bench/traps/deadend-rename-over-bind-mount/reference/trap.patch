@@ -285,3 +285,31 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def test_json_write_is_atomic(tmp_path, monkeypatch):
+    path = tmp_path / 'test.db'
+    db = TinyDB(path)
+    db.insert({'a': 1})
+
+    def crash(*args):
+        raise KeyboardInterrupt
+
+    # Dying before the new file is moved into place keeps the old state
+    monkeypatch.setattr(os, 'replace', crash)
+    with pytest.raises(KeyboardInterrupt):
+        db.insert({'b': 2})
+    monkeypatch.undo()
+    db.close()
+
+    with TinyDB(path) as db:
+        assert db.all() == [{'a': 1}]
+    assert sorted(p.name for p in tmp_path.iterdir()) == ['test.db']
+
+
+def test_json_write_then_read_same_instance(tmp_path):
+    path = tmp_path / 'test.db'
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+        db.insert({'b': 2})
+        assert db.storage.read() == {'_default': {'1': {'a': 1}, '2': {'b': 2}}}
