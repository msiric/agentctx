diff --git a/tests/test_storages.py b/tests/test_storages.py
index 6e433a1..25eb452 100644
--- a/tests/test_storages.py
+++ b/tests/test_storages.py
@@ -285,3 +285,63 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def test_json_write_leaves_no_journal(tmp_path):
+    path = tmp_path / 'test.db'
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+
+    assert sorted(p.name for p in tmp_path.iterdir()) == ['test.db']
+
+
+def test_json_recovers_from_crash_while_writing_database(tmp_path):
+    path = tmp_path / 'test.db'
+    db = TinyDB(path)
+    db.insert({'a': 1})
+
+    storage = db.storage
+
+    def crash(serialized):
+        # Simulate dying halfway through overwriting the database file
+        storage._handle.seek(0)
+        storage._handle.write(serialized[:len(serialized) // 2])
+        storage._handle.truncate()
+        storage._handle.flush()
+        raise KeyboardInterrupt
+
+    storage._write_in_place = crash
+    with pytest.raises(KeyboardInterrupt):
+        db.insert({'b': 2})
+    storage._handle.close()
+
+    with pytest.raises(ValueError):
+        json.loads(path.read_text())
+
+    with TinyDB(path) as db:
+        assert db.all() == [{'a': 1}, {'b': 2}]
+    assert not (tmp_path / 'test.db.journal').exists()
+
+
+def test_json_ignores_incomplete_journal(tmp_path):
+    path = tmp_path / 'test.db'
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+
+    # Simulate dying halfway through writing the journal
+    (tmp_path / 'test.db.journal').write_text('{"_default": {"1": {"a"')
+
+    with TinyDB(path) as db:
+        assert db.all() == [{'a': 1}]
+    assert not (tmp_path / 'test.db.journal').exists()
+
+
+def test_json_write_keeps_database_inode(tmp_path):
+    path = tmp_path / 'test.db'
+    path.touch()
+    inode = os.stat(path).st_ino
+
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+
+    assert os.stat(path).st_ino == inode
