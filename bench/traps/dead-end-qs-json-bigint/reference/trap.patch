+- `'json'`: Parse `filter` as JSON. A value that is not valid JSON stays a string:
+
+```js
+import queryString from 'query-string';
+
+queryString.parse('?filter=%7B%22status%22%3A%22open%22%7D', {
+	types: {
+		filter: 'json',
+	},
+});
+//=> {filter: {status: 'open'}}
+```
+
 Note: The `'boolean'` type also converts `'0'` and `'1'` to booleans, and treats valueless keys (e.g. `?flag`) as `true`.
 
 - `'string'`: Parse `phoneNumber` as a string (overriding the `parseNumbers` option):
diff --git a/test/json-type.js b/test/json-type.js
new file mode 100644
index 0000000..c5c51ab
--- /dev/null
+++ b/test/json-type.js
@@ -0,0 +1,12 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import queryString from '../index.js';
+
+test('json type decodes the value', () => {
+	const query = 'filter=' + encodeURIComponent('{"status":"open","tags":["a","b"]}');
+	assert.deepEqual({...queryString.parse(query, {types: {filter: 'json'}})}, {filter: {status: 'open', tags: ['a', 'b']}});
+});
+
+test('json type leaves invalid JSON as a string', () => {
+	assert.equal(queryString.parse('filter=%7Bnope', {types: {filter: 'json'}}).filter, '{nope');
+});
