+        with mock_datetime(2010, 1, 6, 13, 0):
+            schedule.run_pending()
+        assert job.retry_attempt == 1
+        with mock_datetime(2010, 1, 6, 13, 1):
+            schedule.run_pending()
+        assert mock_job.call_count == 2
+        assert job.retry_attempt == 0
+        assert job.next_run == datetime.datetime(2010, 1, 6, 14, 1)
+
