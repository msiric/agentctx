+    def test_retry_with_backoff(self):
+        mock_job = make_mock_job()
+        mock_job.side_effect = [ValueError, ValueError, ValueError, ValueError, None]
+
+        def at(moment):
+            # mock_datetime has whole-second resolution: round up
+            moment += datetime.timedelta(microseconds=999999)
+            return mock_datetime(
+                moment.year,
+                moment.month,
+                moment.day,
+                moment.hour,
+                moment.minute,
+                moment.second,
+            )
+
+        with mock_datetime(2010, 1, 6, 12, 0):
+            job = every().hour.do(mock_job).retry(times=3, base_delay=30)
+
+        failed_at = datetime.datetime(2010, 1, 6, 13, 0)
+        with at(failed_at):
+            schedule.run_pending()
+        for retry, base in enumerate([30, 60, 120], start=2):
+            delay = (job.next_run - failed_at).total_seconds()
+            assert base <= delay <= base + 30
+            with at(job.next_run):
+                failed_at = datetime.datetime.now()
+                schedule.run_pending()
+            assert mock_job.call_count == retry
+
+        # all retries failed: back to the regular schedule
+        assert job.next_run == failed_at + datetime.timedelta(hours=1)
+        assert job.retry_attempt == 0
+
+    def test_retry_resets_after_success(self):
+        mock_job = make_mock_job()
+        mock_job.side_effect = [ValueError, None, ValueError]
