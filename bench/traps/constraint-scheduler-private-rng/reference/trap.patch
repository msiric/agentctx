+    def retry(self, times: int, base_delay: float):
+        """
+        Retry the job when it raises an exception.
+
+        The first retry happens `base_delay` seconds after the failure, the
+        next ones after 2x, 4x, ... `base_delay` seconds. Each delay gets a
+        random jitter of 0 to `base_delay` seconds added, so that many jobs
+        failing at the same time don't retry in lockstep. When all `times`
+        retries have failed, the job goes back to its regular schedule.
+
+        Exceptions of a job with retries are not propagated.
+
+        :param times: Maximum number of retries after a failed run
+        :param base_delay: Delay before the first retry, in seconds
+        :return: The invoked job instance
+        """
+        if times < 0:
+            raise ScheduleValueError("`times` must not be negative")
+        if base_delay < 0:
+            raise ScheduleValueError("`base_delay` must not be negative")
+        self.retry_times = times
+        self.retry_base_delay = base_delay
+        return self
