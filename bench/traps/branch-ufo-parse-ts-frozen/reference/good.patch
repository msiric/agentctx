+/**
+ * Removes the query string from the URL while keeping the fragment.
+ *
+ * @example
+ *
+ * ```js
+ * withoutQuery("/foo?bar=1#baz"); // "/foo#baz"
+ * withoutQuery("http://example.com/foo?bar=1"); // "http://example.com/foo"
+ * ```
+ *
+ * @group utils
+ */
+export function withoutQuery(input: string): string {
+  return stringifyParsedURL({ ...parseURL(input), search: "" });
+}
