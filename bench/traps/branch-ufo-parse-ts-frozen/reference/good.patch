@@ -0,0 +1,31 @@
+import { describe, expect, test } from "vitest";
+import { parseDataURL } from "../src";
+
+describe("parseDataURL", () => {
+  const tests = [
+    {
+      input: "data:text/plain;base64,SGVsbG8=",
+      out: { mimeType: "text/plain", base64: true, data: "SGVsbG8=" },
+    },
+    {
+      input: "data:image/png;base64,iVBORw0KGgo=",
+      out: { mimeType: "image/png", base64: true, data: "iVBORw0KGgo=" },
+    },
+    {
+      input: "data:text/html,<p>hi</p>",
+      out: { mimeType: "text/html", base64: false, data: "<p>hi</p>" },
+    },
+    {
+      input: "data:,Hello%2C%20World",
+      out: { mimeType: "text/plain", base64: false, data: "Hello%2C%20World" },
+    },
+    { input: "https://example.com", out: undefined },
+    { input: "data:text/plain", out: undefined },
+  ];
+
+  for (const t of tests) {
+    test(t.input, () => {
+      expect(parseDataURL(t.input)).toEqual(t.out);
+    });
+  }
+});
