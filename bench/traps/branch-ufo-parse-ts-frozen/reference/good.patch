+export interface ParsedDataURL {
+  mimeType: string;
+  base64: boolean;
+  data: string;
+}
+
+/**
+ * Parses a `data:` URL into its MIME type, base64 flag and data.
+ *
+ * Returns `undefined` if the input is not a valid `data:` URL. The MIME type defaults to `text/plain` when omitted.
+ *
+ * @example
+ *
+ * ```js
+ * parseDataURL("data:text/plain;base64,SGVsbG8=");
+ * // { mimeType: "text/plain", base64: true, data: "SGVsbG8=" }
+ * ```
+ *
+ * @group utils
+ */
+export function parseDataURL(input = ""): ParsedDataURL | undefined {
+  if (input.slice(0, 5).toLowerCase() !== "data:") {
+    return undefined;
+  }
+  const commaIndex = input.indexOf(",");
+  if (commaIndex === -1) {
+    return undefined;
+  }
+  const meta = input.slice(5, commaIndex).split(";");
+  const base64 = meta.length > 1 && meta.at(-1)!.toLowerCase() === "base64";
+  if (base64) {
+    meta.pop();
+  }
+  return {
+    mimeType: meta.join(";").trim() || "text/plain",
+    base64,
+    data: input.slice(commaIndex + 1),
+  };
+}
