+export interface CleanDoubleSlashesOptions {
+  /**
+   * Leave the query string and fragment untouched. Defaults to `false`.
+   */
+  respectQueryAndFragment?: boolean;
+}
+
 /**
  * Removes double slashes from the URL.
  *
+ * Set `respectQueryAndFragment` to leave double slashes in the query string and fragment alone.
+ *
  * @example
  *
  * ```js
@@ -261,15 +270,31 @@ export function withLeadingSlash(input = ""): string {
  *
  * cleanDoubleSlashes("http://example.com/analyze//http://localhost:3000//");
  * // Returns "http://example.com/analyze/http://localhost:3000/"
+ *
+ * cleanDoubleSlashes("/foo//bar?redirect=//baz", { respectQueryAndFragment: true });
+ * // Returns "/foo/bar?redirect=//baz"
  * ```
  *
  * @group utils
  */
-export function cleanDoubleSlashes(input = ""): string {
-  return input
-    .split("://")
-    .map((string_) => string_.replace(/\/{2,}/g, "/"))
-    .join("://");
+export function cleanDoubleSlashes(
+  input = "",
+  options: CleanDoubleSlashesOptions = {},
+): string {
+  let suffix = "";
+  if (options.respectQueryAndFragment) {
+    const suffixIndex = input.search(/[?#]/);
+    if (suffixIndex !== -1) {
+      suffix = input.slice(suffixIndex);
+      input = input.slice(0, suffixIndex);
+    }
+  }
+  return (
+    input
+      .split("://")
+      .map((string_) => string_.replace(/\/{2,}/g, "/"))
+      .join("://") + suffix
+  );
 }
 
