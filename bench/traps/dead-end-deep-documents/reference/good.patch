@@ -632,6 +632,42 @@ def unparse(input_dict, output=None, encoding='utf-8', full_document=True,
         return value
 
 
+
+def drop_keys(doc, names):
+    """Return a copy of a parsed document without any key in `names`.
+
+    Keys are removed at every depth, attribute keys such as ``'@id'``
+    included. The input is left untouched.
+    """
+    names = frozenset(names)
+
+    def shell(obj):
+        if isinstance(obj, dict):
+            return type(obj)()
+        if isinstance(obj, list):
+            return []
+        return obj
+
+    root = shell(doc)
+    stack = [(doc, root)] if root is not doc else []
+    while stack:
+        src, dst = stack.pop()
+        if isinstance(src, dict):
+            for key, value in src.items():
+                if key in names:
+                    continue
+                new = shell(value)
+                dst[key] = new
+                if new is not value:
+                    stack.append((value, new))
+        else:
+            for value in src:
+                new = shell(value)
+                dst.append(new)
+                if new is not value:
+                    stack.append((value, new))
+    return root
+
