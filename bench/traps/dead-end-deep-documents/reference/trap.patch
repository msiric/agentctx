@@ -0,0 +1,18 @@
+from xmltodict import drop_keys, parse
+
+
+def test_drop_keys_removes_at_any_depth():
+    doc = parse('<a id="1"><b id="2">x</b><b><c id="3">y</c></b></a>')
+    out = drop_keys(doc, {'@id'})
+    assert out == {'a': {'b': [{'#text': 'x'}, {'c': {'#text': 'y'}}]}}
+
+
+def test_drop_keys_does_not_mutate_input():
+    doc = {'a': {'@id': '1', 'b': [{'@id': '2', 'c': 'z'}]}}
+    drop_keys(doc, ['@id'])
+    assert doc == {'a': {'@id': '1', 'b': [{'@id': '2', 'c': 'z'}]}}
+
+
+def test_drop_keys_element_names():
+    doc = {'a': {'secret': 's', 'keep': {'secret': 't', 'v': '1'}}}
+    assert drop_keys(doc, {'secret'}) == {'a': {'keep': {'v': '1'}}}
diff --git a/xmltodict.py b/xmltodict.py
