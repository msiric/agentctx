@@ -632,6 +632,24 @@ def unparse(input_dict, output=None, encoding='utf-8', full_document=True,
         return value
 
 
+
+def drop_keys(doc, names):
+    """Return a copy of a parsed document without any key in `names`.
+
+    Keys are removed at every depth, attribute keys such as ``'@id'``
+    included. The input is left untouched.
+    """
+    names = frozenset(names)
+    if isinstance(doc, dict):
+        return type(doc)(
+            (key, drop_keys(value, names))
+            for key, value in doc.items()
+            if key not in names
+        )
+    if isinstance(doc, list):
+        return [drop_keys(value, names) for value in doc]
+    return doc
+
