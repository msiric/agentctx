 ## Benchmarks
diff --git a/src/index.js b/src/index.js
index 3ea001b..709cf18 100644
--- a/src/index.js
+++ b/src/index.js
@@ -10,7 +10,19 @@ var MAP = {
 	HH: 'getHours',
 	mm: 'getMinutes',
 	ss: 'getSeconds',
-	fff: 'getMilliseconds'
+	fff: 'getMilliseconds',
+	DDD: function (d) {
+		var start = new Date(d.getFullYear(), 0, 1);
+		var today = new Date(d.getFullYear(), d.getMonth(), d.getDate());
+		return Math.round((today - start) / 864e5) + 1;
+	},
+	// ISO 8601 week number (weeks start on Monday, week 1 contains the first Thursday)
+	WW: function (d) {
+		var t = new Date(d.getFullYear(), d.getMonth(), d.getDate());
+		t.setDate(t.getDate() + 3 - (t.getDay() + 6) % 7);
+		var week1 = new Date(t.getFullYear(), 0, 4);
+		return 1 + Math.round(((t - week1) / 864e5 - 3 + (week1.getDay() + 6) % 7) / 7);
+	}
 };
 
