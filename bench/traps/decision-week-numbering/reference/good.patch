 var RGX = /([^{]*?)\w(?=\})/g;
 
+// 1-based day of the year (DST-safe: compares calendar days, not hours)
+function dayOfYear(d) {
+	var y = d.getFullYear();
+	return Math.round((new Date(y, d.getMonth(), d.getDate()) - new Date(y, 0, 1)) / 864e5) + 1;
+}
+
 var MAP = {
 	YYYY: 'getFullYear',
 	YY: 'getYear',
@@ -10,7 +16,13 @@ var MAP = {
 	HH: 'getHours',
 	mm: 'getMinutes',
 	ss: 'getSeconds',
-	fff: 'getMilliseconds'
+	fff: 'getMilliseconds',
+	DDD: dayOfYear,
+	// Excel WEEKNUM(date, 2): weeks start on Monday, week 1 contains Jan 1st
+	WW: function (d) {
+		var offset = (new Date(d.getFullYear(), 0, 1).getDay() + 6) % 7;
+		return Math.floor((dayOfYear(d) - 1 + offset) / 7) + 1;
+	}
 };
 
