+import { describe, expect, it } from '@jest/globals';
+import { formatISO } from './index';
+
+describe('formatISO(number)', () => {
+  it('should format hours and minutes', () => {
+    expect(formatISO(5400000)).toBe('PT1H30M');
+  });
+
+  it('should format days with a time part', () => {
+    expect(formatISO(90061000)).toBe('P1DT1H1M1S');
+  });
+
+  it('should format whole days without a time part', () => {
+    expect(formatISO(2 * 86400000)).toBe('P2D');
+  });
+
+  it('should format fractional seconds', () => {
+    expect(formatISO(1500)).toBe('PT1.5S');
+  });
+
+  it('should format zero', () => {
+    expect(formatISO(0)).toBe('PT0S');
+  });
+
+  it('should format negative durations', () => {
+    expect(formatISO(-5400000)).toBe('-PT1H30M');
+  });
+
+  it('should throw on non-finite numbers', () => {
+    expect(() => formatISO(Number.NaN)).toThrow();
+    expect(() => formatISO(Number.POSITIVE_INFINITY)).toThrow();
+  });
+});
