diff --git a/addict/addict.py b/addict/addict.py
index 55e02d1..601460a 100644
--- a/addict/addict.py
+++ b/addict/addict.py
@@ -77,16 +77,33 @@ class Dict(dict):
     def to_dict(self):
         base = {}
         for key, value in self.items():
-            if isinstance(value, type(self)):
-                base[key] = value.to_dict()
-            elif isinstance(value, (list, tuple)):
-                base[key] = type(value)(
-                    item.to_dict() if isinstance(item, type(self)) else
-                    item for item in value)
-            else:
-                base[key] = value
+            base[key] = self._unhook(value)
         return base
 
+    @classmethod
+    def _unhook(cls, item):
+        if isinstance(item, Dict):
+            return item.to_dict()
+        elif isinstance(item, (list, tuple)):
+            return type(item)(cls._unhook(elem) for elem in item)
+        return item
+
+    def flatten(self, sep='__'):
+        """Return a plain dict with one entry per leaf value, keyed by the
+        nested key path joined with `sep`."""
+        flat = {}
+
+        def walk(prefix, mapping):
+            for key, value in mapping.items():
+                path = prefix + (str(key),)
+                if isinstance(value, dict) and value:
+                    walk(path, value)
+                else:
+                    flat[sep.join(path)] = self._unhook(value)
+
+        walk((), self)
+        return flat
+
     def copy(self):
         return copy.copy(self)
 
