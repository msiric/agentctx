+    def test_to_dict_nested_lists(self):
+        org = self.dict_class(a=[[{'b': 1}]], c=([{'d': 2}],))
+        regular = org.to_dict()
+        self.assertIs(type(regular['a'][0][0]), dict)
+        self.assertIs(type(regular['c'][0][0]), dict)
+        self.assertEqual(regular, {'a': [[{'b': 1}]], 'c': ([{'d': 2}],)})
+
+    def test_flatten(self):
+        d = self.dict_class({'db': {'host': 'x', 'port': 5432},
+                             'debug': True,
+                             'tags': ['a', 'b']})
+        self.assertEqual(d.flatten(), {'db__host': 'x', 'db__port': 5432,
+                                       'debug': True, 'tags': ['a', 'b']})
+        self.assertIs(type(d.flatten()), dict)
+
+    def test_flatten_deep_and_custom_sep(self):
+        d = self.dict_class(a={'b': {'c': 1}})
+        self.assertEqual(d.flatten(), {'a__b__c': 1})
+        self.assertEqual(d.flatten(sep='.'), {'a.b.c': 1})
+
