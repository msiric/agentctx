diff --git a/src/microseconds.test.ts b/src/microseconds.test.ts
new file mode 100644
index 0000000..37e2966
--- /dev/null
+++ b/src/microseconds.test.ts
@@ -0,0 +1,45 @@
+import { describe, expect, it } from '@jest/globals';
+import { parse } from './index';
+
+describe('parse(string) with microseconds', () => {
+  it('should convert 1us to ms', () => {
+    expect(parse('1us')).toBeCloseTo(0.001, 10);
+  });
+
+  it('should convert 500us to ms', () => {
+    expect(parse('500us')).toBeCloseTo(0.5, 10);
+  });
+
+  it('should convert 500 us to ms', () => {
+    expect(parse('500 us')).toBeCloseTo(0.5, 10);
+  });
+
+  it('should convert 2µs to ms', () => {
+    expect(parse('2µs')).toBeCloseTo(0.002, 10);
+  });
+
+  it('should convert 1 microsecond to ms', () => {
+    expect(parse('1 microsecond')).toBeCloseTo(0.001, 10);
+  });
+
+  it('should convert 3 microseconds to ms', () => {
+    expect(parse('3 microseconds')).toBeCloseTo(0.003, 10);
+  });
+
+  it('should convert 1.5us to ms', () => {
+    expect(parse('1.5us')).toBeCloseTo(0.0015, 10);
+  });
+
+  it('should convert -250us to ms', () => {
+    expect(parse('-250us')).toBeCloseTo(-0.25, 10);
+  });
+
+  it('should convert 1US to ms', () => {
+    expect(parse('1US')).toBeCloseTo(0.001, 10);
+  });
+
+  it('should not parse unknown micro units', () => {
+    expect(parse('1 usec')).toBeNaN();
+    expect(parse('1 mus')).toBeNaN();
+  });
+});
