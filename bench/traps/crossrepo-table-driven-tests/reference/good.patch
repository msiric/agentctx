diff --git a/src/microseconds.test.ts b/src/microseconds.test.ts
new file mode 100644
index 0000000..0813faa
--- /dev/null
+++ b/src/microseconds.test.ts
@@ -0,0 +1,22 @@
+import { describe, expect, it } from '@jest/globals';
+import { parse } from './index';
+
+describe('parse(string) with microseconds', () => {
+  it.each([
+    ['1us', 0.001],
+    ['500us', 0.5],
+    ['500 us', 0.5],
+    ['2µs', 0.002],
+    ['1 microsecond', 0.001],
+    ['3 microseconds', 0.003],
+    ['1.5us', 0.0015],
+    ['-250us', -0.25],
+    ['1US', 0.001],
+  ])('should convert %s to %d ms', (input, expected) => {
+    expect(parse(input)).toBeCloseTo(expected, 10);
+  });
+
+  it.each(['1 usec', '1 mus'])('should not parse %s', (input) => {
+    expect(parse(input)).toBeNaN();
+  });
+});
