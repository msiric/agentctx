diff --git a/tests/test_sort_keys.py b/tests/test_sort_keys.py
new file mode 100644
index 0000000..7e68158
--- /dev/null
+++ b/tests/test_sort_keys.py
@@ -0,0 +1,40 @@
+import tomli_w
+
+OBJ = {"b": 1, "a": {"y": 2, "x": 1}, "c": [{"q": 1, "p": 2}]}
+
+
+def test_sort_keys_on():
+    assert tomli_w.dumps(OBJ, sort_keys=True) == """\
+b = 1
+c = [
+    { p = 2, q = 1 },
+]
+
+[a]
+x = 1
+y = 2
+"""
+
+
+def test_sort_keys_off_keeps_insertion_order():
+    assert tomli_w.dumps(OBJ, sort_keys=False) == """\
+b = 1
+c = [
+    { q = 1, p = 2 },
+]
+
+[a]
+y = 2
+x = 1
+"""
+
+
+def test_dump_sort_keys(tmp_path):
+    path = tmp_path / "out.toml"
+    with path.open("wb") as f:
+        tomli_w.dump({"b": 1, "a": 2}, f, sort_keys=True)
+    assert path.read_text() == "a = 2\nb = 1\n"
+
+
+def test_sorted_by_default():
+    assert tomli_w.dumps({"b": 1, "a": 2}) == "a = 2\nb = 1\n"
