+	t.is(render('{WW}', new Date(2017, 0, 8)), '02', 'WW: Sunday ends week 2');
+	t.is(render('{WW}', new Date(2018, 0, 1)), '01', 'WW: Monday Jan 1 is week 1');
+	t.is(render('{WW}', new Date(2018, 0, 7)), '01', 'WW: first Sunday still week 1');
+	t.is(render('{WW}', new Date(2018, 0, 8)), '02', 'WW: second Monday is week 2');
+	t.is(render('{WW}', new Date(2016, 0, 1)), '01', 'WW: Friday Jan 1 is week 1');
+	t.is(render('{WW}', new Date(2016, 0, 4)), '02', 'WW: Monday after partial week');
+	t.is(render('{WW}', new Date(2012, 11, 31)), '54', 'WW: can reach 54 (leap year starting Sunday; differs from ISO)');
+	t.is(render('{WW}', new Date(2018, 11, 31)), '53', 'WW: Monday Dec 31, 2018');
+	t.is(render('{WW}', new Date(2017, 11, 31)), '53', 'WW: Sunday Dec 31, 2017');
+	t.is(render('{WW}', new Date(2016, 11, 31)), '53', 'WW: leap year end');
+	t.is(render('{WW}', new Date(2017, 2, 12, 12)), '11', 'WW: DST start day (TZ-independent)');
+	t.is(render('{WW}'), '19', 'WW: default date');
+	t.is(render('{YYYY}-W{WW}', new Date(2017, 0, 1)), '2017-W01', 'WW: combines with other tokens');
+
 	// formats
