+	// day of year
+	t.is(render('{DDD}', new Date(2017, 0, 1)), '001', 'DDD: first day of year');
+	t.is(render('{DDD}', new Date(2017, 11, 31)), '365', 'DDD: last day of common year');
+	t.is(render('{DDD}', new Date(2016, 1, 29)), '060', 'DDD: leap day');
+	t.is(render('{DDD}', new Date(2016, 2, 1)), '061', 'DDD: day after leap day');
