+	t.is(render('{DDD}', new Date(2017, 3, 10)), '100', 'DDD: no extra padding at 3 digits');
+	t.is(render('{DDD}', new Date(2017, 2, 12, 12)), '071', 'DDD: day of US DST start (TZ-independent)');
+	t.is(render('{DDD}', new Date(2017, 10, 5, 23, 59, 59)), '309', 'DDD: ignores time of day');
+	t.is(render('{YYYY}-{DDD}'), '2017-121', 'DDD: combines with other tokens');
+
+	// week number (Excel WEEKNUM(date, 2): Monday start, week 1 contains Jan 1)
