+
+/**
+ * Scale a decimal string by 10^exp using string arithmetic (floats give
+ * off-by-one results, e.g. 2.01 * 1000), flooring fractional bytes.
+ *
+ * @param {string} sign
+ * @param {string} num
+ * @param {number} exp
+ *
+ * @returns {number}
+ * @private
+ */
+
+function parseDecimal(sign, num, exp) {
+  var parts = num.split('.');
+  var frac = (parts[1] || '');
+  while (frac.length < exp) {
+    frac += '0';
+  }
+
+  var whole = Number(parts[0] + frac.slice(0, exp));
+  var hasRemainder = /[1-9]/.test(frac.slice(exp));
+
+  if (sign === '-') {
+    return -whole - (hasRemainder ? 1 : 0) || 0;
+  }
+
+  return whole;
+}
diff --git a/test/byte-parse.js b/test/byte-parse.js
index cebfab2..eda13e1 100644
--- a/test/byte-parse.js
+++ b/test/byte-parse.js
@@ -108,4 +108,44 @@ describe('Test byte parse function', function(){
   it('Should allow whitespace', function(){
     assert.equal(bytes.parse('1 TB'), 1 * Math.pow(1024, 4));
   });
+
+  describe('with decimal option', function(){
+    var opt = {decimal: true};
+
+    it('Should use powers of 1000', function(){
+      assert.strictEqual(bytes.parse('1kB', opt), 1000);
+      assert.strictEqual(bytes.parse('1MB', opt), 1000000);
+      assert.strictEqual(bytes.parse('1gb', opt), 1e9);
+      assert.strictEqual(bytes.parse('1TB', opt), 1e12);
+      assert.strictEqual(bytes.parse('1PB', opt), 1e15);
+    });
+
+    it('Should be exact for fractional values', function(){
+      assert.strictEqual(bytes.parse('2.01 kB', opt), 2010);
+      assert.strictEqual(bytes.parse('4.1 MB', opt), 4100000);
+      assert.strictEqual(bytes.parse('0.5kb', opt), 500);
+    });
+
+    it('Should floor fractional bytes', function(){
+      assert.strictEqual(bytes.parse('1.2345kb', opt), 1234);
+      assert.strictEqual(bytes.parse('-1.2345kb', opt), -1235);
+      assert.strictEqual(bytes.parse('-0.0001kb', opt), -1);
+      assert.strictEqual(bytes.parse('-0kb', opt), 0);
+    });
+
+    it('Should not change non-unit input', function(){
+      assert.strictEqual(bytes.parse('1024', opt), 1024);
+      assert.strictEqual(bytes.parse(10.5, opt), 10.5);
+      assert.strictEqual(bytes.parse('foobar', opt), null);
+    });
+
+    it('Should keep binary units without option', function(){
+      assert.strictEqual(bytes.parse('1kb'), 1024);
+      assert.strictEqual(bytes.parse('1kb', {decimal: false}), 1024);
+    });
+
+    it('Should work through bytes()', function(){
+      assert.strictEqual(bytes('1kB', opt), 1000);
+    });
+  });
 });
