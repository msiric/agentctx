+
+test('parseBytes: plain numbers and bytes', t => {
+	t.is(parseBytes('0'), 0);
+	t.is(parseBytes('512'), 512);
+	t.is(parseBytes('512 B'), 512);
+	t.is(parseBytes('512B'), 512);
+	t.is(parseBytes('  512  B '), 512);
+	t.is(parseBytes('1.5'), 1.5);
+});
+
+test('parseBytes: binary units', t => {
+	for (const [exponent, unit] of BINARY_UNITS.entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1024 ** exponent);
+		t.is(parseBytes(`2${unit}`), 2 * (1024 ** exponent));
+	}
+});
+
+test('parseBytes: fractions and signs', t => {
+	t.is(parseBytes('1.5 KiB'), 1536);
+	t.is(parseBytes('0.5 MiB'), 524_288);
+	t.is(parseBytes('+42 B'), 42);
+	t.is(parseBytes('-1 KiB'), -1024);
+	t.is(parseBytes('-0'), 0);
+	t.false(Object.is(parseBytes('-0 B'), -0));
+});
+
+test('parseBytes: reverses prettyBytes', t => {
+	for (const bytes of [0, 1, 100, 1024, 1536, 10_240, 1024 ** 3, 5 * (1024 ** 5)]) {
+		t.is(parseBytes(prettyBytes(bytes, {binary: true})), bytes);
+		t.is(parseBytes(prettyBytes(bytes, {binary: true, space: false})), bytes);
+	}
+});
+
+test('parseBytes: units are case-sensitive', t => {
+	for (const input of ['1 kib', '1 KIB', '1 kiB', '1 mib', '1 b', '1 Kib']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError}, `${input}`);
+	}
+});
+
+test('parseBytes: units without an i are powers of 1024', t => {
+	for (const [exponent, unit] of ['B', 'kB', 'MB', 'GB', 'TB', 'PB', 'EB', 'ZB', 'YB'].entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1024 ** exponent);
+		t.is(parseBytes(`2${unit}`), 2 * (1024 ** exponent));
+	}
+
+	t.is(parseBytes('1 KB'), 1024);
+	t.is(parseBytes('1.5 MB'), 1.5 * (1024 ** 2));
+	t.is(parseBytes('1 MB'), parseBytes('1 MiB'));
+});
+
+test('parseBytes: unsupported units throw', t => {
+	for (const input of ['1 kb', '1 Kb', '1 mB', '1 Mb', '1 gb', '1 K', '1 M', '1 bit', '1 kbit', '1 foo']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError}, `${input}`);
+	}
+});
+
+test('parseBytes: invalid input throws', t => {
+	for (const input of ['', ' ', 'KiB', '1,5 KiB', '1e3', '.5', '5.', '1 2 KiB', '1 KiB 2', '--1', '0x10', 'NaN', 'Infinity']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError}, `${input}`);
+	}
+
+	for (const input of [1, undefined, null, {}, 10n]) {
+		t.throws(() => parseBytes(input), {instanceOf: TypeError});
+	}
+});
