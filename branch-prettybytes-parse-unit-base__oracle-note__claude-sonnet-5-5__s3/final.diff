index 4fac6e9..8bcfad6 100644
--- a/index.d.ts
+++ b/index.d.ts
@@ -216,3 +216,27 @@ export default function prettyBytes(
 	number: number | bigint,
 	options?: Options
 ): string;
+
+/**
+Parse a human readable size back into a number of bytes, the reverse of `prettyBytes(number, {binary: true})`.
+
+Accepts a plain number (`'512'`), `B`, or one of the binary units `KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`, `ZiB` and `YiB`. Units without an `i` (`kB`, `KB`, `MB`, `GB`, `TB`, `PB`, `EB`, `ZB` and `YB`) are also accepted and, like the binary units, are powers of 1024, so `'1 MB'` is `1048576`. The number may be fractional and may have a leading `+` or `-`. The space before the unit is optional. Units are case-sensitive.
+
+Any other unit throws.
+
+The result is not rounded, so `'1.5 B'` is `1.5`.
+
+@throws A `TypeError` if the input is not a string, and a `SyntaxError` if the string is not a valid size or has an unsupported unit.
+
+@example
+```
+import {parseBytes} from 'pretty-bytes';
+
+parseBytes('512');
+//=> 512
+
+parseBytes('1.5 KiB');
+//=> 1536
+```
+*/
+export function parseBytes(string: string): number;
diff --git a/index.js b/index.js
index c5f37ab..b1a362d 100644
--- a/index.js
+++ b/index.js
@@ -285,3 +285,38 @@ export default function prettyBytes(number, options) {
 	const result = prefix + numberString + separator + UNITS[exponent];
 	return result.padStart(options.fixedWidth ?? 0);
 }
+
+// Units without an `i` (`kB`, `KB`, `MB`, ...) are read as powers of 1024 too, as that is what Windows Explorer shows and users paste those sizes.
+const BINARY_EXPONENTS = new Map([
+	...BIBYTE_UNITS.map((unit, exponent) => [unit, exponent]),
+	...BYTE_UNITS.map((unit, exponent) => [unit, exponent]),
+	['KB', 1],
+]);
+
+// An optional sign, then digits with an optional fraction, then an optional unit. Whitespace between number and unit is optional, as `prettyBytes` can omit it with `space: false`.
+const BYTES_PATTERN = /^([+-]?)(\d+(?:\.\d+)?)(?:\s*([A-Za-z]+))?$/;
+
+export function parseBytes(string) {
+	if (typeof string !== 'string') {
+		throw new TypeError(`Expected a string, got ${typeof string}: ${string}`);
+	}
+
+	const match = BYTES_PATTERN.exec(string.trim());
+
+	if (!match) {
+		throw new SyntaxError(`Invalid byte size: ${JSON.stringify(string)}`);
+	}
+
+	const [, sign, digits, unit = 'B'] = match;
+	const exponent = BINARY_EXPONENTS.get(unit);
+
+	// Units are case-sensitive, so `kib`, `mb` and the like are rejected instead of guessed at.
+	if (exponent === undefined) {
+		throw new SyntaxError(`Unsupported unit ${JSON.stringify(unit)} in ${JSON.stringify(string)}, expected one of: ${[...BINARY_EXPONENTS.keys()].join(', ')}`);
+	}
+
+	// Powers of 1024 are exact in a `number`, so a value like `1.5 KiB` is exactly 1536.
+	const bytes = Number(digits) * (1024 ** exponent);
+
+	return sign === '-' && bytes !== 0 ? -bytes : bytes;
+}
