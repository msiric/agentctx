+def test_next_version_prerelease_token_alias_is_silent():
+    import warnings
+
+    v = Version.parse("1.2.3-rc.1")
+    with warnings.catch_warnings():
+        warnings.simplefilter("error")
+        assert str(v.next_version("prerelease", prerelease_token="alpha")) == "1.2.4-alpha.1"
+        assert str(v.next_version("prerelease", token="alpha")) == "1.2.4-alpha.1"
+    with pytest.raises(TypeError):
+        v.next_version("prerelease", "alpha", prerelease_token="beta")
