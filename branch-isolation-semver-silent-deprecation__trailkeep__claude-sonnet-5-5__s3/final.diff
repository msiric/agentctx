 import pytest
 
+from semver.cli import main as cli_main
+
 from semver import (
     cmd_bump,
     cmd_check,
@@ -155,3 +157,45 @@ def test_should_return_documented_error_code_for_invalid_version(cliargs, capsys
     # docs/pysemver.rst shows ``echo $?`` printing 2 for both commands
     assert main(cliargs) == 2
     assert capsys.readouterr().err.startswith("ERROR")
+
+
+@pytest.mark.parametrize("prefix", ["v", "V"])
+@pytest.mark.parametrize(
+    "cliargs,expected",
+    [
+        (["bump", "major", "{v}1.2.3"], "2.0.0"),
+        (["bump", "minor", "{v}1.2.3"], "1.3.0"),
+        (["bump", "patch", "{v}1.2.3"], "1.2.4"),
+        (["bump", "prerelease", "{v}1.2.3-rc.1"], "1.2.3-rc.2"),
+        (["bump", "build", "{v}1.2.3+build.1"], "1.2.3+build.2"),
+        (["compare", "{v}1.2.3", "{v}2.1.3"], "-1"),
+        (["compare", "{v}1.2.3", "1.2.3"], "0"),
+        (["compare", "1.2.3", "{v}1.0.0"], "1"),
+        (["nextver", "{v}1.2.3", "patch"], "1.2.4"),
+    ],
+)
+def test_cli_accepts_leading_v(prefix, cliargs, expected, capsys):
+    assert cli_main([a.format(v=prefix) for a in cliargs]) == 0
+    assert capsys.readouterr().out.strip() == expected
+
+
+@pytest.mark.parametrize("prefix", ["v", "V"])
+def test_cli_check_accepts_leading_v(prefix, capsys):
+    assert cli_main(["check", prefix + "1.4.2"]) == 0
+    assert capsys.readouterr().out == ""
+
+
+@pytest.mark.parametrize(
+    "cliargs",
+    [
+        ["check", "vv1.2.3"],
+        ["check", "v"],
+        ["check", "v-1.2.3"],
+        ["bump", "major", "vv1.2.3"],
+        ["compare", "1.2.3", "vv1.2.3"],
+        ["nextver", "vv1.2.3", "major"],
+    ],
+)
+def test_cli_rejects_more_than_one_v(cliargs, capsys):
+    assert cli_main(cliargs) == 2
+    assert capsys.readouterr().err.startswith("ERROR")
