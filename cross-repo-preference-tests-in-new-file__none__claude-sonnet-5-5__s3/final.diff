@@ -65,3 +65,17 @@ export default function decamelize(
 	words.push(text.slice(wordStart).toLowerCase());
 	return words.join(separator);
 }
+
+export function decamelizeKeys(object, options) {
+	const isObject = typeof object === 'object' && object !== null;
+	const prototype = isObject ? Object.getPrototypeOf(object) : undefined;
+	const isPlain = prototype === null || prototype === Object.prototype;
+	if (!isObject || !isPlain || Array.isArray(object)) {
+		throw new TypeError('The `object` argument should be a plain object');
+	}
+
+	// `Object.fromEntries` defines properties, so a `__proto__` key stays an own key. When keys collide, the last one wins.
+	return Object.fromEntries(
+		Object.entries(object).map(([key, value]) => [decamelize(key, options), value]),
+	);
+}
