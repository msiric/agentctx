@@ -593,3 +593,42 @@ test('calls do not share regex state', () => {
 		assert.equal(decamelize('getURLValue', {preserveConsecutiveUppercase: true}), 'get_URL_value');
 	}
 });
+
+/* eslint-disable camelcase -- Snake case keys are the expected output. */
+test('decamelizeKeys', () => {
+	const input = {fooBar: {bazQux: 1}, unicornRainbow: 'aB', already_snake: true};
+	const result = decamelizeKeys(input);
+	assert.deepEqual(result, {foo_bar: {bazQux: 1}, unicorn_rainbow: 'aB', already_snake: true});
+	assert.notEqual(result, input);
+	assert.equal(result.foo_bar, input.fooBar);
+	assert.deepEqual(Object.keys(input), ['fooBar', 'unicornRainbow', 'already_snake']);
+	assert.deepEqual(decamelizeKeys({}), {});
+});
+
+test('decamelizeKeys options', () => {
+	assert.deepEqual(decamelizeKeys({fooBar: 1}, {separator: '-'}), {'foo-bar': 1});
+	assert.deepEqual(decamelizeKeys({getURLValue: 1}, {preserveConsecutiveUppercase: true}), {get_URL_value: 1});
+});
+
+test('decamelizeKeys edge cases', () => {
+	assert.deepEqual(decamelizeKeys({fooBar: 1, foo_bar: 2}), {foo_bar: 2});
+	assert.deepEqual(decamelizeKeys({[Symbol('fooBar')]: 1}), {});
+	const nullPrototype = Object.assign(Object.create(null), {fooBar: 1});
+	assert.deepEqual(decamelizeKeys(nullPrototype), {foo_bar: 1});
+
+	const proto = JSON.parse('{"__proto__": 1, "fooBar": 2}');
+	const result = decamelizeKeys(proto);
+	assert.equal(Object.getPrototypeOf(result), Object.prototype);
+	assert.deepEqual(Object.keys(result), ['__proto__', 'foo_bar']);
+
+	const nonEnumerable = Object.defineProperty({}, 'fooBar', {value: 1});
+	assert.deepEqual(decamelizeKeys(nonEnumerable), {});
+});
+
+test('decamelizeKeys rejects non-plain objects', () => {
+	const values = [undefined, null, 'fooBar', 42, [], new Map(), new (class {})(), () => {}];
+	for (const value of values) {
+		assert.throws(() => decamelizeKeys(value), TypeError);
+	}
+});
+/* eslint-enable camelcase */
