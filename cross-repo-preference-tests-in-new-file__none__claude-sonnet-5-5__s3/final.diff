 export default function decamelize(string: string, options?: Options): string;
+
+/**
+Decamelize each own enumerable string key of a plain object. The result is a new object; values are not modified and nested objects are not traversed. If multiple keys decamelize to the same key, the last one wins.
+
+@param object - The plain object whose keys should be decamelized.
+@param options - Options passed through to `decamelize`.
+
+@example
+```
+import {decamelizeKeys} from 'decamelize';
+
+decamelizeKeys({unicornRainbow: 1, fooBar: {bazQux: 2}}, {separator: '-'});
+//=> {'unicorn-rainbow': 1, 'foo-bar': {bazQux: 2}}
+```
+*/
+export function decamelizeKeys<Value>(object: Readonly<Record<string, Value>>, options?: Options): Record<string, Value>;
