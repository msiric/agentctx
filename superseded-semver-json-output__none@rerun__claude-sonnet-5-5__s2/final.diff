+
 from semver import (
     cmd_bump,
     cmd_check,
@@ -155,3 +158,88 @@ def test_should_return_documented_error_code_for_invalid_version(cliargs, capsys
     # docs/pysemver.rst shows ``echo $?`` printing 2 for both commands
     assert main(cliargs) == 2
     assert capsys.readouterr().err.startswith("ERROR")
+
+
+def test_sort_prints_one_version_per_line_oldest_first(capsys):
+    assert main(["sort", "1.10.0", "1.2.0", "1.2.0-rc.1", "0.9.9+b1"]) == 0
+    assert capsys.readouterr().out == "0.9.9+b1\n1.2.0-rc.1\n1.2.0\n1.10.0\n"
+
+
+def test_sort_without_versions_prints_nothing(capsys):
+    with patch("sys.stdin", io.StringIO("")):
+        assert main(["sort"]) == 0
+    assert capsys.readouterr().out == ""
+
+
+def test_sort_invalid_version_fails_without_output(capsys):
+    assert main(["sort", "1.0.0", "1.2"]) == 2
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert captured.err.startswith("ERROR")
+
+
+def test_cmd_sort_returns_newline_joined_string():
+    assert cmd_sort(Namespace(versions=["2.0.0", "1.0.0"])) == "1.0.0\n2.0.0"
+
+
+def test_sort_reads_stdin_when_no_arguments(capsys):
+    stdin = io.StringIO("1.10.0\n\n  \n1.2.0\r\n1.2.0-rc.1\n")
+    with patch("sys.stdin", stdin):
+        assert main(["sort"]) == 0
+    assert capsys.readouterr().out == "1.2.0-rc.1\n1.2.0\n1.10.0\n"
+
+
+def test_sort_ignores_stdin_when_arguments_given(capsys):
+    with patch("sys.stdin", io.StringIO("0.0.1\n")):
+        assert main(["sort", "2.0.0", "1.0.0"]) == 0
+    assert capsys.readouterr().out == "1.0.0\n2.0.0\n"
+
+
+def test_sort_invalid_version_on_stdin_fails_without_output(capsys):
+    with patch("sys.stdin", io.StringIO("1.0.0\nnope\n")):
+        assert main(["sort"]) == 2
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert captured.err.startswith("ERROR")
+
+
+def test_latest_prints_highest_non_prerelease(capsys):
+    assert main(["latest", "1.2.0", "1.10.0", "2.0.0-rc.1", "1.3.0+b1"]) == 0
+    assert capsys.readouterr().out == "1.10.0\n"
+
+
+def test_latest_keeps_build_metadata(capsys):
