+    assert capsys.readouterr().out == "1.1.0+build.5\n"
+
+
+def test_latest_reads_stdin_when_no_arguments(capsys):
+    with patch("sys.stdin", io.StringIO("1.2.0\n\n2.0.0-rc.1\n1.10.0\r\n")):
+        assert main(["latest"]) == 0
+    assert capsys.readouterr().out == "1.10.0\n"
+
+
+def test_latest_ignores_stdin_when_arguments_given(capsys):
+    with patch("sys.stdin", io.StringIO("9.9.9\n")):
+        assert main(["latest", "1.0.0", "1.1.0"]) == 0
+    assert capsys.readouterr().out == "1.1.0\n"
+
+
+@pytest.mark.parametrize("cliargs", [["1.0.0-rc.1", "2.0.0-alpha"], []])
