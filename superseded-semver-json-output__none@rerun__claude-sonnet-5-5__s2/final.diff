+pysemver sort
+~~~~~~~~~~~~~
+
+Sort versions, oldest first.
+
+.. code:: bash
+
+   pysemver sort [<VERSION>...]
+
+.. option:: <VERSION>
+
+    The versions to sort. If none are given, versions are read from
+    *standard in*, one per line; blank lines are ignored.
+
+The sorted versions are printed on *standard out* as plain text, one
+version per line, which makes the output easy to read in a shell loop::
+
+    $ pysemver sort 1.10.0 1.2.0 1.2.0-rc.1
+    1.2.0-rc.1
+    1.2.0
+    1.10.0
+    $ pysemver sort 1.10.0 1.2.0 | while read v; do echo "release $v"; done
+    release 1.2.0
+    release 1.10.0
+    $ printf '1.10.0\n\n1.2.0\n' | pysemver sort
+    1.2.0
+    1.10.0
+
+If any argument is not a valid version, an error message is printed
+and nothing is written to standard out. If no versions are given,
+nothing is printed (also when standard in is empty).
+
+
+pysemver latest
+~~~~~~~~~~~~~~~
+
+Print the highest version that is not a prerelease.
+
+.. code:: bash
+
+   pysemver latest [<VERSION>...]
+
+.. option:: <VERSION>
+
+    The versions to choose from. If none are given, versions are read from
+    *standard in*, one per line; blank lines are ignored.
+
+Build metadata is kept in the output::
+
+    $ pysemver latest 1.10.0 1.2.0 2.0.0-rc.1
+    1.10.0
+    $ printf '1.2.0\n1.3.0-rc.1\n' | pysemver latest
+    1.2.0
+
+If any version is invalid, or no version without a prerelease part is
+given (including empty input), an error message is printed, nothing is
+written to standard out, and the return code is ``2``.
+
+
 Return Code
 -----------
 
diff --git a/src/semver/cli.py b/src/semver/cli.py
index 43e101e..c4bc9ab 100644
--- a/src/semver/cli.py
+++ b/src/semver/cli.py
@@ -83,6 +83,57 @@ def cmd_nextver(args: argparse.Namespace) -> str:
     return str(version.next_version(args.part))
 
 
+def _read_versions(args: argparse.Namespace) -> List[str]:
+    """
+    Return the versions given as arguments, or else those read from
+    standard in, one per line (blank lines are ignored).
+    """
+    raw = args.versions
+    if not raw:
+        raw = [line.strip() for line in sys.stdin.read().splitlines()]
+        raw = [line for line in raw if line]
+    return cast(List[str], raw)
+
+
+def cmd_sort(args: argparse.Namespace) -> Optional[str]:
+    """
+    Subcommand: Sort versions, oldest first.
+
+    Synopsis: sort [<VERSION>...]
+
+    If no versions are given as arguments, they are read from standard in,
+    one per line. Blank lines are ignored.
+
+    :param args: The parsed arguments
+    :return: the sorted versions, one per line (None if no versions are given)
+    """
+    versions = sorted(Version.parse(v) for v in _read_versions(args))
+    if not versions:
+        return None
+    return "\n".join(str(v) for v in versions)
+
+
+def cmd_latest(args: argparse.Namespace) -> str:
+    """
+    Subcommand: Print the highest version that is not a prerelease.
+
+    Synopsis: latest [<VERSION>...]
+
+    If no versions are given as arguments, they are read from standard in,
+    one per line. Blank lines are ignored.
+
+    :param args: The parsed arguments
+    :return: the highest non-prerelease version
+    :raises ValueError: if a version is invalid or there is no
+        non-prerelease version
+    """
+    versions = [Version.parse(v) for v in _read_versions(args)]
+    releases = [v for v in versions if not v.prerelease]
+    if not releases:
+        raise ValueError("no version without a prerelease part given")
+    return str(max(releases))
+
+
 def createparser() -> argparse.ArgumentParser:
