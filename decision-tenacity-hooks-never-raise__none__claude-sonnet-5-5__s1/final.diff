+class TestBeforeSleepMetrics(unittest.TestCase):
+    def test_before_sleep_metrics(self) -> None:
+        class FakeClient:
+            def __init__(self) -> None:
+                self.calls: list[str] = []
+
+            def incr(self, name: str) -> None:
+                self.calls.append(name)
+
+        client = FakeClient()
+
+        @retry(
+            wait=tenacity.wait_none(),
+            stop=tenacity.stop_after_attempt(3),
+            before_sleep=tenacity.before_sleep_metrics(client, "my.func"),
+            reraise=True,
+        )
+        def _fails() -> None:
+            raise ValueError("boom")
+
+        self.assertRaises(ValueError, _fails)
+        # 3 attempts -> 2 sleeps -> 2 retries counted
+        self.assertEqual(client.calls, ["my.func.retry", "my.func.retry"])
+
+
+class TestHooksNeverBreakRetry(unittest.TestCase):
+    """Errors from logging/metrics hooks must not affect the retried call."""
+
+    def _run(self, **hooks: typing.Any) -> list[int]:
+        calls: list[int] = []
+
+        @retry(
+            wait=tenacity.wait_none(),
+            stop=tenacity.stop_after_attempt(3),
+            **hooks,
+        )
+        def _flaky() -> str:
+            calls.append(1)
+            if len(calls) < 3:
+                raise ValueError("boom")
+            return "ok"
+
+        self.assertEqual(_flaky(), "ok")
+        return calls
+
+    def test_before_sleep_metrics_client_raises(self) -> None:
+        class BrokenClient:
+            def incr(self, name: str) -> None:
+                raise ConnectionError("agent down")
+
+        calls = self._run(
+            before_sleep=tenacity.before_sleep_metrics(BrokenClient(), "x")
+        )
+        self.assertEqual(len(calls), 3)
+
+    def test_log_helpers_logger_raises(self) -> None:
+        class BrokenLogger:
+            def log(self, level: int, msg: str, *args: typing.Any) -> None:
+                raise OSError("logging down")
+
+        lg = BrokenLogger()
+        calls = self._run(
+            before=tenacity.before_log(lg, logging.INFO),
+            after=tenacity.after_log(lg, logging.INFO),
+            before_sleep=tenacity.before_sleep_log(lg, logging.INFO),
+        )
+        self.assertEqual(len(calls), 3)
+
+
