+class MetricsClientProtocol(typing.Protocol):
+    """
+    Protocol used by utils expecting a metrics client (eg: before_sleep_metrics).
+
+    Compatible with statsd, datadog, etc... clients exposing ``incr``.
+    """
+
+    def incr(self, name: str) -> typing.Any: ...
+
+
+_logger = logging.getLogger("tenacity")
+
+
+def call_quietly(fn: typing.Callable[..., typing.Any], *args: typing.Any) -> None:
+    """
+    Call a logging/metrics hook so that its failures never reach the retry.
+
+    Losing a log line or a metric is preferable to turning a retryable error
+    into a hard failure, so anything ``fn`` raises is logged at debug level.
+    """
+    try:
+        fn(*args)
+    except Exception:
+        _logger.debug("Ignoring error raised by %r", fn, exc_info=True)
+
