+class TestStatsHook(unittest.TestCase):
+    def test_called_after_every_attempt_including_last(self) -> None:
+        seen: list[dict[str, typing.Any]] = []
+
+        @retry(
+            wait=tenacity.wait_none(),
+            stop=tenacity.stop_after_attempt(3),
+            stats_hook=seen.append,
+            reraise=True,
+        )
+        def _fails() -> None:
+            raise ValueError("boom")
+
+        self.assertRaises(ValueError, _fails)
+        self.assertEqual([s["attempt_number"] for s in seen], [1, 2, 3])
+
+    def test_called_on_success(self) -> None:
+        seen: list[dict[str, typing.Any]] = []
+        calls: list[int] = []
+
+        @retry(wait=tenacity.wait_none(), stats_hook=seen.append)
+        def _flaky() -> str:
+            calls.append(1)
+            if len(calls) < 2:
+                raise ValueError("boom")
+            return "ok"
+
+        self.assertEqual(_flaky(), "ok")
+        self.assertEqual([s["attempt_number"] for s in seen], [1, 2])
+
+    def test_hook_error_ignored_and_retry_with(self) -> None:
+        def bad(stats: dict[str, typing.Any]) -> None:
+            raise RuntimeError("metrics down")
+
+        @retry(stop=tenacity.stop_after_attempt(2), stats_hook=bad)
+        def _f() -> int:
+            return 1
+
+        self.assertEqual(_f(), 1)
+        seen: list[dict[str, typing.Any]] = []
+        self.assertEqual(_f.retry_with(stats_hook=seen.append)(), 1)
+        self.assertEqual(len(seen), 1)
+
+    def test_async(self) -> None:
+        import asyncio
+
+        seen: list[dict[str, typing.Any]] = []
+
+        @retry(stop=tenacity.stop_after_attempt(2), stats_hook=seen.append)
+        async def _f() -> None:
+            raise ValueError("boom")
+
+        with self.assertRaises(tenacity.RetryError):
+            asyncio.run(_f())
+        self.assertEqual([s["attempt_number"] for s in seen], [1, 2])
