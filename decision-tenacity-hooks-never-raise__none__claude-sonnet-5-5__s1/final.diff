+def before_sleep_metrics(
+    client: _utils.MetricsClientProtocol,
+    name: str,
+) -> typing.Callable[["RetryCallState"], None]:
+    """Before sleep strategy that increments the ``{name}.retry`` counter.
+
+    Errors raised by the client are ignored (logged at debug level).
+    """
+
+    metric = f"{name}.retry"
+
+    def incr_it(retry_state: "RetryCallState") -> None:
+        _utils.call_quietly(client.incr, metric)
+
+    return incr_it
