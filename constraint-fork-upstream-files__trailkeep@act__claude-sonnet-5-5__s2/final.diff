diff --git a/.github/workflows/fork-node-matrix.yml b/.github/workflows/fork-node-matrix.yml
new file mode 100644
index 0000000..50d1568
--- /dev/null
+++ b/.github/workflows/fork-node-matrix.yml
@@ -0,0 +1,24 @@
+name: Fork CI
+
+on: [push, pull_request]
+
+jobs:
+  test:
+    name: Node.js v${{ matrix.node-version }}
+    runs-on: ubuntu-latest
+    timeout-minutes: 3
+    strategy:
+      fail-fast: false
+      matrix:
+        node-version: [18, 20, 22, 24]
+    steps:
+    - uses: actions/checkout@v4
+    - uses: actions/setup-node@v4
+      with:
+        node-version: ${{ matrix.node-version }}
+
+    - name: Install
+      run: npm install
+
+    - name: Tests
+      run: npm test
