diff --git a/test/dashdash.js b/test/dashdash.js
new file mode 100644
index 0000000..9aeecf4
--- /dev/null
+++ b/test/dashdash.js
@@ -0,0 +1,43 @@
+const test = require('tape');
+const fn = require('../lib');
+
+test('-- : default behavior (opts["--"] unset)', t => {
+	t.deepEqual(fn(['a', '--', 'b', '-c']), { _: ['a', 'b', '-c'] });
+	t.end();
+});
+
+test('-- : opts["--"] collects trailing args', t => {
+	t.deepEqual(
+		fn(['a', '--foo', 'bar', '--', 'b', '--baz', '-x'], { '--': true }),
+		{ _: ['a'], foo: 'bar', '--': ['b', '--baz', '-x'] }
+	);
+	t.end();
+});
+
+test('-- : empty array when no bare -- is present', t => {
+	t.deepEqual(fn(['a', '-b'], { '--': true }), { _: ['a'], b: true, '--': [] });
+	t.end();
+});
+
+test('-- : empty array when -- is last', t => {
+	t.deepEqual(fn(['a', '--'], { '--': true }), { _: ['a'], '--': [] });
+	t.end();
+});
+
+test('-- : only first bare -- is consumed', t => {
+	t.deepEqual(fn(['--', 'a', '--', 'b'], { '--': true }), { _: [], '--': ['a', '--', 'b'] });
+	t.end();
+});
+
+test('-- : values after -- are not parsed or coerced', t => {
+	t.deepEqual(fn(['--', '123', '--no-x'], { '--': true }), { _: [], '--': ['123', '--no-x'] });
+	t.end();
+});
+
+test('-- : works with other options', t => {
+	t.deepEqual(
+		fn(['-v', '--', 'x'], { '--': true, boolean: 'v', alias: { v: 'verbose' } }),
+		{ _: [], v: true, verbose: true, '--': ['x'] }
+	);
+	t.end();
+});
