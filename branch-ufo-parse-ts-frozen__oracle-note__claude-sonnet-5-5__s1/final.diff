+export interface ParsedDataURL {
+  /** MIME type (defaults to `text/plain` when omitted). Parameters such as `charset` are excluded. */
+  mimeType: string;
+  /** Whether the URL uses `;base64` encoding. */
+  base64: boolean;
+  /** Raw payload after the first comma (not decoded). */
+  data: string;
+}
+
+/**
+ * Parses a `data:` URL into its mime type, base64 flag and raw data.
+ *
+ * @example
+ * ```js
+ * parseDataURL("data:text/plain;base64,SGVsbG8="); // { mimeType: "text/plain", base64: true, data: "SGVsbG8=" }
+ * ```
+ *
+ * @param input - The `data:` URL to parse.
+ * @throws {TypeError} If the input is not a valid `data:` URL.
+ */
+export function parseDataURL(input: string): ParsedDataURL {
+  const match = /^\s*data:([^,]*),(.*)$/is.exec(input);
+  if (!match) {
+    throw new TypeError(`Invalid data URL: ${input}`);
+  }
+  const [, meta, data] = match;
+  const parts = meta.split(";").map((p) => p.trim());
+  const base64 =
+    parts.length > 1 && parts[parts.length - 1].toLowerCase() === "base64";
+  const mimeType = parts[0] || "text/plain";
+  return { mimeType, base64, data };
+}
