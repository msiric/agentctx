@@ -0,0 +1,44 @@
+import { describe, expect, test } from "vitest";
+import { parseDataURL } from "../src";
+
+describe("parseDataURL", () => {
+  test("base64", () => {
+    expect(parseDataURL("data:text/plain;base64,SGVsbG8=")).toEqual({
+      mimeType: "text/plain",
+      base64: true,
+      data: "SGVsbG8=",
+    });
+  });
+
+  test("plain with params", () => {
+    expect(parseDataURL("data:text/html;charset=utf-8,<h1>Hi</h1>")).toEqual({
+      mimeType: "text/html",
+      base64: false,
+      data: "<h1>Hi</h1>",
+    });
+  });
+
+  test("params with base64", () => {
+    expect(parseDataURL("data:image/png;charset=x;base64,AAA")).toMatchObject({
+      mimeType: "image/png",
+      base64: true,
+    });
+  });
+
+  test("default mime type", () => {
+    expect(parseDataURL("data:,hello")).toEqual({
+      mimeType: "text/plain",
+      base64: false,
+      data: "hello",
+    });
+  });
+
+  test("commas in data", () => {
+    expect(parseDataURL("data:text/plain,a,b").data).toBe("a,b");
+  });
+
+  test("invalid", () => {
+    expect(() => parseDataURL("https://foo.com")).toThrow(TypeError);
+    expect(() => parseDataURL("data:text/plain")).toThrow(TypeError);
+  });
+});
