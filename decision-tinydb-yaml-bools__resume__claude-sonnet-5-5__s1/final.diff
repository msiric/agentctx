+def test_yaml_storage_unicode_and_order(tmpdir):
+    path = str(tmpdir.join('test.yml'))
+    data = {'_default': {'1': {'z': u'こんにちは', 'a': 1}}}
+
+    storage = YAMLStorage(path)
+    storage.write(data)
+    storage.close()
+
+    content = open(path, encoding='utf-8').read()
+    assert u'こんにちは' in content
+    assert content.index('z:') < content.index('a:')  # keys not sorted
+
+    storage = YAMLStorage(path)
+    assert storage.read() == data
+    storage.close()
