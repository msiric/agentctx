+_YAML_BOOL_TAG = 'tag:yaml.org,2002:bool'
+_yaml_loader_cls: Any = None
+
+
+def _get_yaml_loader():
+    """
+    Build (once) a PyYAML safe loader that only treats ``true``/``false`` as
+    booleans.
+
+    PyYAML implements YAML 1.1, where ``yes``, ``no``, ``on``, ``off`` (and
+    single letters ``y``/``n``) are booleans, too. That turns hand-edited
+    values like ``country: NO`` into ``False``. Here only ``true`` and
+    ``false`` (any of ``true``, ``True``, ``TRUE``, ...) are booleans, all
+    other former booleans stay strings.
+    """
+
+    global _yaml_loader_cls
+
+    if _yaml_loader_cls is None:
+        try:
+            import yaml
+        except ImportError as e:
+            raise ImportError(
+                'YAMLStorage requires PyYAML. Install it with '
+                '`pip install tinydb[yaml]` or `pip install pyyaml`.'
+            ) from e
+
+        class _Loader(yaml.SafeLoader):
+            pass
+
+        # Copy the resolver table (it is shared with the parent class) and
+        # remove the YAML 1.1 bool resolver from it
+        _Loader.yaml_implicit_resolvers = {
+            first: [(tag, regexp) for tag, regexp in resolvers if tag != _YAML_BOOL_TAG]
+            for first, resolvers in yaml.SafeLoader.yaml_implicit_resolvers.items()
+        }
+        _Loader.add_implicit_resolver(
+            _YAML_BOOL_TAG,
+            re.compile(r'^(?:true|True|TRUE|false|False|FALSE)$'),
+            list('tTfF'),
+        )
+
+        _yaml_loader_cls = _Loader
+
+    return _yaml_loader_cls
+
+
+class YAMLStorage(FileStorage):
+    """
+    Store the data in a YAML file (requires PyYAML).
+
+    The file is meant to be hand-edited. It is loaded with a safe loader, so no
+    arbitrary Python objects can be created. Only ``true`` and ``false`` are
+    read as booleans; ``yes``, ``no``, ``on``, ``off`` etc. stay strings.
+    When writing, strings that YAML would otherwise read as something else
+    (e.g. ``'NO'`` or ``'off'``) are quoted.
+
+    **Note:** Comments in the file are not preserved when TinyDB writes to it.
+    """
+
+    def __init__(self, path: str, create_dirs=False, encoding='utf-8', access_mode='r+', **kwargs):
+        """
+        Create a new instance.
+
+        See :class:`FileStorage` for the handling of the file itself.
+
+        :param path: Where to store the YAML data.
+        :param kwargs: Extra arguments passed to ``yaml.safe_dump``.
+        """
+
+        # Fail early if PyYAML is missing
+        _get_yaml_loader()
+
+        super().__init__(path, create_dirs=create_dirs, encoding=encoding, access_mode=access_mode)
+
+        self.kwargs = kwargs
+
+    def read(self) -> Optional[dict[str, dict[str, Any]]]:
+        import yaml
+
+        self._handle.seek(0)
+        data = yaml.load(self._handle, Loader=_get_yaml_loader())
+
+        # An empty (or comment-only) file means the storage is uninitialized
+        if data is None:
+            return None
+
+        if not isinstance(data, dict):
+            raise ValueError(
+                'Invalid database file: expected a mapping at the top level, '
+                'got {0}'.format(type(data).__name__)
+            )
+
+        # TinyDB addresses documents by string IDs (as JSON keys are always
+        # strings), but a hand-edited ``1:`` is loaded as an int. Normalize
+        # the document IDs so lookups by ID work either way.
+        for name, table in data.items():
+            if isinstance(table, dict):
+                data[name] = {str(doc_id): doc for doc_id, doc in table.items()}
+
+        return data
+
+    def write(self, data: dict[str, dict[str, Any]]):
+        import yaml
+
+        options: dict[str, Any] = {
+            'sort_keys': False,
+            'default_flow_style': False,
+            'allow_unicode': True,
+        }
+        options.update(self.kwargs)
+
+        # Serialize first so a failure doesn't leave a half-written file
+        serialized = yaml.safe_dump(data, **options)
+
+        self._handle.seek(0)
+
+        try:
+            self._handle.write(serialized)
+        except io.UnsupportedOperation:
+            raise IOError('Cannot write to the database. Access mode is "{0}"'.format(self._mode))
+
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+
+        # Remove data that is behind the new cursor in case the file has
+        # gotten shorter
+        self._handle.truncate()
+
