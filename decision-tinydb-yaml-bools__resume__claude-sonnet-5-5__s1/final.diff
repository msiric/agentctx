+def test_yaml_storage_with_tinydb(tmpdir):
+    path = str(tmpdir.join('sub', 'test.yml'))
+
+    with TinyDB(path, storage=YAMLStorage, create_dirs=True) as db:
+        db.insert({'name': 'a', 'tags': ['x', 'y']})
+        db.insert({'name': 'b'})
+        db.update({'name': 'c'}, where('name') == 'b')
+        db.remove(where('name') == 'a')
+
+    with TinyDB(path, storage=YAMLStorage) as db:
+        assert db.all() == [{'name': 'c'}]
+
