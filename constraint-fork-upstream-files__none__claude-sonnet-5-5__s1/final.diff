diff --git a/test/index.js b/test/index.js
index 37abaa5..ab5bc64 100644
--- a/test/index.js
+++ b/test/index.js
@@ -328,3 +328,24 @@ test('flag boolean with default string & alias', t => {
 	t.is(typeof baz.two, 'boolean');
 	t.end();
 });
+
+test('opts[--]: args after -- go to argv[--]', t => {
+	const args = ['a', '--foo', 'x', '--', 'b', '--bar', '-c'];
+	t.same(fn(args, { '--': true }), { _:['a'], foo:'x', '--':['b', '--bar', '-c'] });
+	t.same(fn(args), { _:['a', 'b', '--bar', '-c'], foo:'x' }, 'default behavior unchanged');
+	t.same(fn(args, { '--': false }), { _:['a', 'b', '--bar', '-c'], foo:'x' }, 'false is unchanged');
+	t.end();
+});
+
+test('opts[--]: empty array when no -- is present', t => {
+	t.same(fn(['a', '--foo'], { '--': true }), { _:['a'], foo:true, '--':[] });
+	t.same(fn([], { '--': true }), { _:[], '--':[] });
+	t.same(fn(['--'], { '--': true }), { _:[], '--':[] });
+	t.end();
+});
+
+test('opts[--]: works with alias, default, boolean', t => {
+	const res = fn(['-f', '--', 'x', 'y'], { '--': true, alias: { f:'foo' }, boolean: 'foo', default: { n:1 } });
+	t.same(res, { _:[], f:true, foo:true, n:1, '--':['x', 'y'] });
+	t.end();
+});
