index 0000000..b2eda56
--- /dev/null
+++ b/.github/workflows/fork-ci.yml
@@ -0,0 +1,23 @@
+name: Fork CI
+
+on: [push, pull_request]
+
+jobs:
+  test:
+    name: Node.js v${{ matrix.nodejs }}
+    runs-on: ubuntu-latest
+    timeout-minutes: 3
+    strategy:
+      matrix:
+        nodejs: [18, 20, 22, 24]
+    steps:
+    - uses: actions/checkout@v4
+    - uses: actions/setup-node@v4
+      with:
+        node-version: ${{ matrix.nodejs }}
+
+    - name: Install
+      run: npm install
+
+    - name: Tests
+      run: npm test
