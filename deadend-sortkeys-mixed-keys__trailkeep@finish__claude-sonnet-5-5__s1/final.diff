+def _json_key(key):
+    """
+    Convert a dict key the way :mod:`json` does when serializing it, so that
+    keys of mixed types (e.g. ``200`` and ``'other'``) can be sorted together.
+    Keys of unsupported types are returned unchanged.
+    """
+    if isinstance(key, str):
+        return key
+    if key is True:
+        return 'true'
+    if key is False:
+        return 'false'
+    if key is None:
+        return 'null'
+    if isinstance(key, int):
+        return int.__repr__(key)
+    if isinstance(key, float):
+        if key != key:
+            return 'NaN'
+        if key in (float('inf'), float('-inf')):
+            return 'Infinity' if key > 0 else '-Infinity'
+        return float.__repr__(key)
+    return key
+
+
+def _sort_keys(obj):
+    """
+    Recursively stringify and sort dict keys. Used instead of
+    ``json.dumps(sort_keys=True)``, which raises ``TypeError`` for dicts
+    that mix key types.
+    """
+    if isinstance(obj, dict):
+        items = [(_json_key(k), _sort_keys(v)) for k, v in obj.items()]
+        if all(isinstance(k, str) for k, _ in items):
+            items.sort(key=lambda item: item[0])
+        return dict(items)
+    if isinstance(obj, (list, tuple)):
+        return [_sort_keys(v) for v in obj]
+    return obj
+
+
