+
+def _read_csv(path):
+    import csv
+
+    with open(path, newline='', encoding='utf-8') as f:
+        return list(csv.reader(f))
+
+
+def test_to_csv_default_fields(db, tmpdir):
+    db.truncate()
+    db.insert_multiple([{'a': 1, 'b': 'x'}, {'b': 'y', 'c': 3}, {}])
+    path = str(tmpdir.join('out.csv'))
+
+    db.to_csv(path)
+
+    assert _read_csv(path) == [
+        ['a', 'b', 'c'],
+        ['1', 'x', ''],
+        ['', 'y', '3'],
+        ['', '', ''],
+    ]
+
+
+def test_to_csv_selected_fields(db, tmpdir):
+    db.truncate()
+    db.insert_multiple([{'a': 1, 'b': 2, 'c': 3}, {'a': 4, 'c': 6}])
+    path = str(tmpdir.join('out.csv'))
+
+    db.to_csv(path, fields=['c', 'a', 'z'])
+
+    assert _read_csv(path) == [['c', 'a', 'z'], ['3', '1', ''], ['6', '4', '']]
+
+
+def test_to_csv_empty_table(db, tmpdir):
+    db.truncate()
+    path = str(tmpdir.join('out.csv'))
+
+    db.to_csv(path)
+    assert _read_csv(path) == []
+
+    db.to_csv(path, fields=['a', 'b'])
+    assert _read_csv(path) == [['a', 'b']]
+
+
+def test_to_csv_quoting_and_unicode(db, tmpdir):
+    db.truncate()
+    db.insert({'name': 'Müller, "Jo"\nX', 'n': None})
+    path = str(tmpdir.join('out.csv'))
+
+    db.to_csv(path)
+
+    assert _read_csv(path) == [['name', 'n'], ['Müller, "Jo"\nX', '']]
