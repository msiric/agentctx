+class Length:
+    """
+    Validates that a string has a length between min and max (inclusive).
+    Either bound may be None to leave that side unbounded.
+    """
+
+    def __init__(
+        self,
+        min: Union[int, None] = None,
+        max: Union[int, None] = None,
+        error: Union[str, None] = None,
+    ) -> None:
+        if min is not None and max is not None and min > max:
+            raise ValueError(f"min ({min!r}) must not be greater than max ({max!r})")
+        self._min: Union[int, None] = min
+        self._max: Union[int, None] = max
+        self._error: Union[str, None] = error
+
+    def __repr__(self) -> str:
+        return f"{self.__class__.__name__}(min={self._min!r}, max={self._max!r})"
+
+    def validate(self, data: str, **kwargs: Any) -> str:
+        """
+        Validates the length of a string.
+        :param data: Data to be validated.
+        :return: Returns validated data.
+        """
+        e = self._error
+
+        if not isinstance(data, str):
+            raise SchemaError(e.format(data) if e else f"{data!r} is not a string")
+        n = len(data)
+        if (self._min is not None and n < self._min) or (
+            self._max is not None and n > self._max
+        ):
+            if self._min is not None and self._max is not None:
+                expected = f"between {self._min} and {self._max}"
+            elif self._min is not None:
+                expected = f"at least {self._min}"
+            else:
+                expected = f"at most {self._max}"
+            raise SchemaError(
+                e.format(data)
+                if e
+                else f"{data!r} has length {n}, expected length {expected}"
+            )
+        return data
+
+
