+def test_length():
+    assert Length(2, 4).validate("ab") == "ab"
+    assert Length(2, 4).validate("abcd") == "abcd"
+    assert Length(min=2).validate("a" * 100) == "a" * 100
+    assert Length(max=2).validate("") == ""
+    assert Length().validate("anything") == "anything"
+    with SE:
+        Length(2, 4).validate("a")
+    with SE:
+        Length(2, 4).validate("abcde")
+    with SE:
+        Length(min=2).validate("a")
+    with SE:
+        Length(max=2).validate("abc")
+    with SE:
+        Length(max=2).validate(123)
+    with raises(ValueError):
+        Length(4, 2)
+
+
+def test_length_in_schema_and_error():
+    assert Schema({"k": Length(1, 3)}).validate({"k": "abc"}) == {"k": "abc"}
+    with SE:
+        Schema({"k": Length(1, 3)}).validate({"k": "abcd"})
+    with raises(SchemaError) as exc:
+        Length(max=1, error="too long: {}").validate("xy")
+    assert exc.value.code == "too long: xy"
+    with raises(SchemaError) as exc:
+        Length(2, 4).validate("a")
+    assert "between 2 and 4" in exc.value.code
