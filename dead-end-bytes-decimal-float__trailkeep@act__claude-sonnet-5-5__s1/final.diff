diff --git a/test/byte-parse.js b/test/byte-parse.js
index cebfab2..5102312 100644
--- a/test/byte-parse.js
+++ b/test/byte-parse.js
@@ -108,4 +108,48 @@ describe('Test byte parse function', function(){
   it('Should allow whitespace', function(){
     assert.equal(bytes.parse('1 TB'), 1 * Math.pow(1024, 4));
   });
+
+  describe('with {decimal: true}', function(){
+    var opts = {decimal: true};
+
+    it('Should use powers of 1000', function(){
+      assert.strictEqual(bytes.parse('1kB', opts), 1000);
+      assert.strictEqual(bytes.parse('1MB', opts), 1e6);
+      assert.strictEqual(bytes.parse('1GB', opts), 1e9);
+      assert.strictEqual(bytes.parse('1TB', opts), 1e12);
+      assert.strictEqual(bytes.parse('1PB', opts), 1e15);
+    });
+
+    it('Should leave bytes and unitless values alone', function(){
+      assert.strictEqual(bytes.parse('1b', opts), 1);
+      assert.strictEqual(bytes.parse('1024', opts), 1024);
+      assert.strictEqual(bytes.parse(1024, opts), 1024);
+    });
+
+    it('Should not be off by one on float error', function(){
+      assert.strictEqual(bytes.parse('2.01 kB', opts), 2010);
+      assert.strictEqual(bytes.parse('1.1 MB', opts), 1100000);
+    });
+
+    it('Should drop partial bytes', function(){
+      assert.strictEqual(bytes.parse('1.0005kB', opts), 1000);
+      assert.strictEqual(bytes.parse('0.5b', opts), 0);
+    });
+
+    it('Should accept negative values and whitespace', function(){
+      assert.strictEqual(bytes.parse('-1kB', opts), -1000);
+      assert.strictEqual(bytes.parse('1 kB', opts), 1000);
+    });
+
+    it('Should return null for invalid input', function(){
+      assert.strictEqual(bytes.parse('foo', opts), null);
+      assert.strictEqual(bytes.parse(null, opts), null);
+    });
+  });
+
+  it('Should keep powers of 1024 without or with falsy decimal option', function(){
+    assert.strictEqual(bytes.parse('1kB'), 1024);
+    assert.strictEqual(bytes.parse('1kB', {}), 1024);
+    assert.strictEqual(bytes.parse('1kB', {decimal: false}), 1024);
+  });
 });
