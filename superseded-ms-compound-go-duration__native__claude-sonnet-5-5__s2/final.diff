+describe('format(number, { compound: true })', () => {
+  it('should combine units, largest first', () => {
+    expect(format(5400000, { compound: true })).toBe('1h 30m');
+    expect(format(90061000, { compound: true })).toBe('1d 1h 1m 1s');
+  });
+
+  it('should skip zero parts', () => {
+    expect(format(3601000, { compound: true })).toBe('1h 1s');
+    expect(format(86400000, { compound: true })).toBe('1d');
+  });
+
+  it('should not go above days', () => {
+    expect(format(40 * 86400000, { compound: true })).toBe('40d');
+  });
+
+  it('should drop leftover milliseconds', () => {
+    expect(format(1999, { compound: true })).toBe('1s');
+    expect(format(500, { compound: true })).toBe('0s');
+    expect(format(-500, { compound: true })).toBe('0s');
+  });
+
+  it('should prefix negative values with -', () => {
+    expect(format(-5400000, { compound: true })).toBe('-1h 30m');
+  });
+
+  it('should be ignored when long is true', () => {
+    expect(format(5400000, { compound: true, long: true })).toBe('2 hours');
+  });
+
+  it('should handle unit boundaries', () => {
+    expect(format(999, { compound: true })).toBe('0s');
+    expect(format(1000, { compound: true })).toBe('1s');
+    expect(format(59999, { compound: true })).toBe('59s');
+    expect(format(60000, { compound: true })).toBe('1m');
+    expect(format(3599999, { compound: true })).toBe('59m 59s');
+    expect(format(3600000, { compound: true })).toBe('1h');
+    expect(format(86399999, { compound: true })).toBe('23h 59m 59s');
+  });
+
+  it('should handle zero and fractional values', () => {
+    expect(format(0, { compound: true })).toBe('0s');
+    expect(format(1500.7, { compound: true })).toBe('1s');
+  });
+
+  it('should use the short format when compound is false', () => {
+    expect(format(5400000, { compound: false })).toBe('2h');
+  });
+
+  it('should throw on invalid inputs', () => {
+    expect(() => format(NaN, { compound: true })).toThrow();
+    expect(() => format(Infinity, { compound: true })).toThrow();
+    expect(() => format(-Infinity, { compound: true })).toThrow();
