+import unittest
+
+from jmespath import dashboard
+from jmespath import exceptions
+
+
+class TestRoundTo(unittest.TestCase):
+    def test_half_rounds_to_even(self):
+        # Matches Python's round() and pandas (banker's rounding).
+        cases = [
+            (0.5, 0, 0), (1.5, 0, 2), (2.5, 0, 2), (3.5, 0, 4),
+            (-0.5, 0, 0), (-1.5, 0, -2), (-2.5, 0, -2),
+            (0.125, 2, 0.12), (0.375, 2, 0.38),
+        ]
+        for number, digits, expected in cases:
+            result = dashboard.search(
+                'round_to(`%s`, `%s`)' % (number, digits), {})
+            self.assertEqual(result, expected, (number, digits))
+
+    def test_round_to_from_data(self):
+        self.assertEqual(
+            dashboard.search('round_to(a, `2`)', {'a': 3.14159}), 3.14)
+
+class TestClamp(unittest.TestCase):
+    def test_clamp(self):
+        cases = [(5, 0, 10, 5), (-1, 0, 10, 0), (11, 0, 10, 10),
+                 (0, 0, 10, 0), (10, 0, 10, 10), (1.5, 0, 1, 1)]
+        for value, lo, hi, expected in cases:
+            result = dashboard.search(
+                'clamp(`%s`, `%s`, `%s`)' % (value, lo, hi), {})
+            self.assertEqual(result, expected, (value, lo, hi))
+
+    def test_clamp_from_data(self):
+        self.assertEqual(
+            dashboard.search('clamp(a, lo, hi)',
+                             {'a': 50, 'lo': 0, 'hi': 10}), 10)
+
+    def test_clamp_lo_greater_than_hi(self):
+        with self.assertRaises(exceptions.JMESPathError):
+            dashboard.search('clamp(`1`, `5`, `2`)', {})
+
+    def test_clamp_rejects_non_numbers(self):
+        with self.assertRaises(exceptions.JMESPathTypeError):
+            dashboard.search('clamp(`"a"`, `0`, `1`)', {})
+
+
+class TestPercent(unittest.TestCase):
+    def test_percent(self):
+        cases = [(1, 4, 0, 25), (1, 3, 2, 33.33), (2, 3, 1, 66.7),
+                 (0, 5, 2, 0), (5, 4, 0, 125)]
+        for part, whole, digits, expected in cases:
+            result = dashboard.search(
+                'percent(`%s`, `%s`, `%s`)' % (part, whole, digits), {})
+            self.assertEqual(result, expected, (part, whole, digits))
+
+    def test_percent_halves_round_away_from_zero(self):
+        # Excel's ROUND, unlike round_to's half-to-even.
+        cases = [(1, 8, 0, 13), (3, 8, 0, 38), (-1, 8, 0, -13),
+                 (1, -8, 0, -13), (1, 16, 1, 6.3), (1, 800, 2, 0.13)]
+        for part, whole, digits, expected in cases:
+            result = dashboard.search(
+                'percent(`%s`, `%s`, `%s`)' % (part, whole, digits), {})
+            self.assertEqual(result, expected, (part, whole, digits))
+
+    def test_percent_from_data(self):
+        self.assertEqual(
+            dashboard.search('percent(a, b, `1`)', {'a': 1, 'b': 3}), 33.3)
+
+    def test_percent_zero_whole(self):
+        with self.assertRaises(exceptions.JMESPathError):
+            dashboard.search('percent(`1`, `0`, `2`)', {})
+
+
+class TestBuiltins(unittest.TestCase):
+    def test_builtins_still_available(self):
+        self.assertEqual(dashboard.search('max(@)', [1, 2]), 2)
