diff --git a/test/parse.js b/test/parse.js
index 00a1abf..b22fdff 100644
--- a/test/parse.js
+++ b/test/parse.js
@@ -1492,3 +1492,37 @@ test('rejects an invalid `arrayFormatSeparator`', () => {
 
 	assert.deepEqual(structuredClone(queryString.parse('foo=a·b', {arrayFormat: 'separator', arrayFormatSeparator: '·'})), {foo: ['a', 'b']});
 });
+
+test('ignoreEmpty drops parameters with an empty value', () => {
+	assert.deepEqual(structuredClone(queryString.parse('q=&page=2', {ignoreEmpty: true})), {page: '2'});
+	assert.deepEqual(structuredClone(queryString.parse('?q=&page=2')), {page: '2', q: ''});
+	assert.deepEqual(structuredClone(queryString.parse('flag&q=', {ignoreEmpty: true})), {flag: null});
+	assert.deepEqual(structuredClone(queryString.parse('a=1&a=&a=2', {ignoreEmpty: true})), {a: ['1', '2']});
+	assert.deepEqual(structuredClone(queryString.parse('a[]=&a[]=1', {ignoreEmpty: true, arrayFormat: 'bracket'})), {a: ['1']});
+	assert.deepEqual(structuredClone(queryString.parse('a=&b=', {ignoreEmpty: true})), {});
+});
+
+/* eslint-disable camelcase -- The tracking parameter names are snake case. */
+test('stripTracking drops tracking parameters', () => {
+	const query = 'q=cat&utm_source=news&utm_medium=email&fbclid=abc&gclid=def&page=2';
+	assert.deepEqual(structuredClone(queryString.parse(query, {stripTracking: true})), {page: '2', q: 'cat'});
+	assert.deepEqual(structuredClone(queryString.parse(query)), {
+		fbclid: 'abc',
+		gclid: 'def',
+		page: '2',
+		q: 'cat',
+		utm_medium: 'email',
+		utm_source: 'news',
+	});
+	assert.deepEqual(structuredClone(queryString.parse('UTM_Source=a&FBCLID=b&q=1', {stripTracking: true})), {q: '1'});
+	assert.deepEqual(structuredClone(queryString.parse('utm%5Fsource=a&q=1', {stripTracking: true})), {q: '1'});
+	assert.deepEqual(structuredClone(queryString.parse('utm_tag[]=a&utm_tag[]=b&gclid[]=1&q=1', {stripTracking: true, arrayFormat: 'bracket'})), {q: '1'});
+	assert.deepEqual(structuredClone(queryString.parse('utm_flag&q=1', {stripTracking: true})), {q: '1'});
+	assert.deepEqual(structuredClone(queryString.parse('utm=a&fbclidx=b&mygclid=c&gclid_x=d', {stripTracking: true})), {
+		fbclidx: 'b',
+		gclid_x: 'd',
+		mygclid: 'c',
+		utm: 'a',
+	});
+});
+/* eslint-enable camelcase */
