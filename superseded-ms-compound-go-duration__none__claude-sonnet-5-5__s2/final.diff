+
+describe('compound', () => {
+  it.each([
+    [5400000, '1h 30m'],
+    [-5400000, '-1h 30m'],
+    [90061000, '1d 1h 1m 1s'],
+    [3600000, '1h'],
+    [3601999, '1h 1s'],
+    [999, '0s'],
+    [-999, '0s'],
+    [0, '0s'],
+    [86400000 * 40, '40d'],
+    [-1500, '-1s'],
+    [59999, '59s'],
+    [86399999, '23h 59m 59s'],
+    [86400000 + 60000, '1d 1m'],
+  ])('format(%d, { compound: true }) === %s', (input, expected) => {
+    expect(format(input, { compound: true })).toBe(expected);
+  });
+});
+
+describe('compound edge cases', () => {
+  it('takes precedence over long', () => {
+    expect(format(5400000, { compound: true, long: true })).toBe('1h 30m');
+  });
+
+  it('is ignored when false', () => {
+    expect(format(5400000, { compound: false })).toBe('2h');
+  });
+
+  it('works through ms()', () => {
+    expect(ms(5400000, { compound: true })).toBe('1h 30m');
+  });
+
+  it('still rejects non-finite numbers', () => {
+    expect(() => format(Infinity, { compound: true })).toThrow();
+    expect(() => format(NaN, { compound: true })).toThrow();
+  });
+});
