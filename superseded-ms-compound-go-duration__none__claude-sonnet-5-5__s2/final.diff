+describe('format(number, { compound: true })', () => {
+  it.each([
+    [5400000, '1h 30m'],
+    [7200000, '2h'],
+    [90061000, '1d 1h 1m 1s'],
+    [86400000 * 10 + 1000, '10d 1s'],
+    [1999, '1s'],
+    [999, '0s'],
+    [0, '0s'],
+    [-5400000, '-1h 30m'],
+    [-500, '0s'],
+    [-61000, '-1m 1s'],
+  ])('format(%d) === %s', (value, expected) => {
+    expect(format(value, { compound: true })).toBe(expected);
+  });
+
+  it('takes precedence over long', () => {
+    expect(format(5400000, { long: true, compound: true })).toBe('1h 30m');
+  });
+
+  it('is unchanged when compound is false', () => {
+    expect(format(5400000, { compound: false })).toBe('2h');
+  });
+
+  it('does not roll days up into larger units', () => {
+    expect(format(86400000 * 400, { compound: true })).toBe('400d');
+  });
+
+  it.each([NaN, Infinity, -Infinity, '1h' as unknown as number])(
+    'throws for invalid input %p',
+    (value) => {
+      expect(() => format(value, { compound: true })).toThrow();
+    },
+  );
+});
