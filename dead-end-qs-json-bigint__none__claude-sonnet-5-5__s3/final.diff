+
+test('`json` type', () => {
+	const types = {a: 'json'};
+	assert.deepEqual(structuredClone(queryString.parse('a=%7B%22b%22%3A%5B1%2C2%5D%7D', {types})), {a: {b: [1, 2]}});
+	assert.deepEqual(structuredClone(queryString.parse('a=1', {types, parseNumbers: false})), {a: 1});
+	assert.deepEqual(structuredClone(queryString.parse('a=true', {types})), {a: true});
+	assert.deepEqual(structuredClone(queryString.parse('a=null', {types})), {a: null});
+	assert.deepEqual(structuredClone(queryString.parse('a=%7Bnope', {types})), {a: '{nope'});
+	assert.deepEqual(structuredClone(queryString.parse('a=', {types})), {a: ''});
+	assert.deepEqual(structuredClone(queryString.parse('a', {types})), {a: null});
+	assert.deepEqual(structuredClone(queryString.parse('a=1&a=%5B2%5D', {types})), {a: [1, [2]]});
+});
