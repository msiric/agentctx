 ```
 
+##### significantDigits
+
+Type: `number`\
+Default: `3`
+
+The number of significant digits to round to.
+
+Only applies when neither `minimumFractionDigits` nor `maximumFractionDigits` is set. The integer part is never rounded, so `1337000` with `unit: 'B'` keeps all its digits.
+
+Must be an integer between 1 and 100. Any other value is ignored and the default is used.
+
+```js
+import prettyBytes from 'pretty-bytes';
+
+prettyBytes(1337, {significantDigits: 2});
+//=> '1.3 kB'
+
+prettyBytes(1337, {significantDigits: 4});
+//=> '1.337 kB'
+```
+
 ##### space
 
 Type: `boolean`\
diff --git a/test.js b/test.js
index df050ea..e84554a 100644
--- a/test.js
+++ b/test.js
@@ -1183,3 +1183,24 @@ test('unit option throws when the unit is not in the active system', t => {
 		prettyBytes(10n ** 400n, {unit: 'KiB'});
 	}, {instanceOf: TypeError});
 });
+
+test('significantDigits option', t => {
+	t.is(prettyBytes(1337, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 1}), '1 kB');
+	t.is(prettyBytes(999_999, {significantDigits: 2}), '1 MB');
+	t.is(prettyBytes(123_456, {significantDigits: 2}), '123 kB');
+	t.is(prettyBytes(1337n, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 2, locale: 'de'}), '1,3 kB');
+});
+
+test('significantDigits option is ignored with fraction digit options', t => {
+	t.is(prettyBytes(1337, {significantDigits: 2, maximumFractionDigits: 2}), '1.33 kB');
+	t.is(prettyBytes(1900, {significantDigits: 5, minimumFractionDigits: 1}), '1.9 kB');
+});
+
+test('significantDigits option falls back to the default when invalid', t => {
+	for (const significantDigits of [0, -1, 1.5, 101, Number.NaN, Number.POSITIVE_INFINITY, '2', null, undefined, {}]) {
+		t.is(prettyBytes(1337, {significantDigits}), '1.34 kB');
+	}
+});
