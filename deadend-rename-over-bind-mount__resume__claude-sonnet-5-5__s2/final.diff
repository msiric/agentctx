+    def _recover(self):
+        """
+        Recover from a crash during :meth:`write`.
+
+        Before the database file is overwritten in place, the complete new
+        content is written to a journal file (``<path>.new``). A journal that
+        parses as JSON is therefore always complete (a truncated JSON document
+        never parses), and the database file may be torn at this point, so we
+        replay the journal. A journal that doesn't parse was cut off before
+        the database file was touched, so it's discarded.
+        """
+        journal = self._journal_path
+        try:
+            with open(journal, encoding=self._encoding) as f:
+                content = f.read()
+        except FileNotFoundError:
+            return
+
+        try:
+            json.loads(content)
+        except ValueError:
+            os.unlink(journal)
+            return
+
+        with open(self._path, 'w', encoding=self._encoding) as f:
+            f.write(content)
+            f.flush()
+            os.fsync(f.fileno())
+        os.unlink(journal)
+
+    def _write_journal(self, serialized: str) -> bool:
