+
+
+def test_json_write_leaves_no_journal(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+    assert os.listdir(str(tmpdir)) == ['db.json']
+
+
+def test_json_recover_torn_db_file(tmpdir):
+    # Crash while overwriting db.json: journal is complete, db.json is torn
+    path = str(tmpdir.join('db.json'))
+    new = json.dumps(NEW)
+    with open(path, 'w') as f:
+        f.write(new[:10])
+    with open(path + '.new', 'w') as f:
+        f.write(new)
+
+    assert _read(path) == NEW
+    assert not os.path.exists(path + '.new')
+
+
+def test_json_discard_incomplete_journal(tmpdir):
+    # Crash while writing the journal: db.json is still the old state
+    path = str(tmpdir.join('db.json'))
+    with open(path, 'w') as f:
+        json.dump(OLD, f)
+    with open(path + '.new', 'w') as f:
+        f.write(json.dumps(NEW)[:20])
+
+    assert _read(path) == OLD
+    assert not os.path.exists(path + '.new')
+
+
+def test_json_discard_empty_journal(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    with open(path, 'w') as f:
+        json.dump(OLD, f)
+    open(path + '.new', 'w').close()
+
+    assert _read(path) == OLD
+
+
+@pytest.mark.parametrize('cut', [0, 1, 7, 'half', 'all-but-one'])
+def test_json_survives_process_killed_mid_write(tmpdir, cut):
+    """Kill a real process part-way through the in-place overwrite."""
+    import subprocess
+    import sys
+
+    path = str(tmpdir.join('db.json'))
+    with open(path, 'w') as f:
+        json.dump(OLD, f)
+
+    script = '''
+import json, os, sys
+sys.path.insert(0, sys.argv[1])
+from tinydb.storages import JSONStorage
+s = JSONStorage(sys.argv[2])
+real = s._handle
+cut = sys.argv[3]
+data = json.dumps(json.loads(sys.argv[4]))
+n = {"half": len(data) // 2, "all-but-one": len(data) - 1}.get(cut) or int(cut)
+
+class Dying:
+    def __getattr__(self, name):
+        return getattr(real, name)
+    def write(self, text):
+        real.write(text[:n]); real.flush(); os._exit(137)  # like an OOM kill
+
+s._handle = Dying()
+s.write(json.loads(sys.argv[4]))
+'''
+    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+    proc = subprocess.run(
+        [sys.executable, '-c', script, root, path, str(cut), json.dumps(NEW)]
+    )
+    assert proc.returncode == 137
+
+    assert _read(path) in (OLD, NEW)
+    assert _read(path) == NEW  # journal was complete, so the new state wins
+
+
+def test_json_unwritable_directory_falls_back(tmpdir, monkeypatch):
+    path = str(tmpdir.join('db.json'))
+    real_open = open
+
+    def fake_open(file, *args, **kwargs):
+        if str(file).endswith('.new') and args[:1] == ('w',):
+            raise PermissionError('read-only directory')
+        return real_open(file, *args, **kwargs)
+
+    with TinyDB(path) as db:
+        monkeypatch.setattr('builtins.open', fake_open)
+        with pytest.warns(UserWarning, match='without crash protection'):
+            db.insert({'a': 1})
+        monkeypatch.undo()
+        assert len(db) == 1
+    assert os.listdir(str(tmpdir)) == ['db.json']
