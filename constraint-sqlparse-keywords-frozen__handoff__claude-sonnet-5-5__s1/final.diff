+def test_check_reports_changed_files(tmpdir, capsys):
+    good = tmpdir.join('good.sql')
+    good.write('select 1\n')
+    bad = tmpdir.join('bad.sql')
+    bad.write('select 1\n')
+    # Formatting with -k upper changes only bad.sql's content
+    good.write('SELECT 1\n')
+    rc = sqlparse.cli.main(['--check', '-k', 'upper',
+                            str(good), str(bad)])
+    out = capsys.readouterr().out
+    assert rc == 1
+    assert out.splitlines() == [str(bad)]
+    assert bad.read() == 'select 1\n'  # nothing written
+
+
+def test_check_clean_exit_zero(tmpdir, capsys):
+    f = tmpdir.join('a.sql')
+    f.write('SELECT 1\n')
+    assert sqlparse.cli.main(['--check', '-k', 'upper', str(f)]) == 0
+    assert capsys.readouterr().out == ''
+
+
+def test_check_rejects_inplace(tmpdir, capsys):
+    f = tmpdir.join('a.sql')
+    f.write('select 1\n')
+    assert sqlparse.cli.main(['--check', '--in-place', str(f)]) == 1
+    assert f.read() == 'select 1\n'
