+"""Local keyword additions, kept out of keywords.py so that file can stay
+identical to upstream. Loaded by Lexer.default_initialization()."""
+
+from sqlparse import tokens
+
+KEYWORDS_LOCAL_SNOWFLAKE = {
+    'ASOF': tokens.Keyword,
+    'EXCLUDE': tokens.Keyword,
+    'MATCH_CONDITION': tokens.Keyword,
+    'MATCH_RECOGNIZE': tokens.Keyword,
+}
