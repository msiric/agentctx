+def test_none_written_as_empty_string():
+    obj = {
+        "a": None,
+        "b": 1,
+        "t": {"x": None, "y": 2},
+        "empty": {"only": None},
+        "aot": [{"k": None, "v": 1}],
+        "inline_arr": [{"k": None, "v": 1}, {"v": None}],
+    }
+    out = tomli_w.dumps(obj)
+    assert "None" not in out
+    assert tomllib.loads(out) == {
+        "a": "",
+        "b": 1,
+        "t": {"x": "", "y": 2},
+        "empty": {"only": ""},
+        "aot": [{"k": "", "v": 1}],
+        "inline_arr": [{"k": "", "v": 1}, {"v": ""}],
+    }
+
+
+def test_none_in_inline_table():
+    assert tomli_w.dumps({"a": [{"x": None, "y": 1}]}) == (
+        'a = [\n    { x = "", y = 1 },\n]\n'
+    )
+    assert tomli_w.dumps({"a": [{"x": None}]}) == 'a = [\n    { x = "" },\n]\n'
+
+
+def test_none_in_arrays():
+    assert tomli_w.dumps({"a": [1, None, 3]}) == "a = [\n    1,\n    \"\",\n    3,\n]\n"
+    assert tomllib.loads(tomli_w.dumps({"a": [None], "n": [[None, "x"]]})) == {
+        "a": [""],
+        "n": [["", "x"]],
+    }
+    assert tomllib.loads(tomli_w.dumps({"a": (None, None)})) == {"a": ["", ""]}
+
+
+def test_none_in_dump_file():
+    import io
+
+    buf = io.BytesIO()
+    tomli_w.dump({"a": None, "b": 1}, buf)
+    assert buf.getvalue() == b'a = ""\nb = 1\n'
+
+
+def test_pathlib_paths():
+    from pathlib import Path, PurePosixPath, PureWindowsPath
+
+    obj = {
+        "p": Path("/tmp/x"),
+        "posix": PurePosixPath("a/b"),
+        "win": PureWindowsPath("C:\\dir\\f.txt"),
+        "arr": [PurePosixPath("a")],
+        "t": {"q": PurePosixPath("c/d")},
+    }
+    out = tomli_w.dumps(obj)
+    assert tomllib.loads(out) == {
+        "p": str(Path("/tmp/x")),
+        "posix": "a/b",
+        "win": "C:\\dir\\f.txt",
+        "arr": ["a"],
+        "t": {"q": "c/d"},
+    }
