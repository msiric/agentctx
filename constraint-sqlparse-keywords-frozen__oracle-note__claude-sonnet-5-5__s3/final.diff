diff --git a/tests/test_cli.py b/tests/test_cli.py
index f33b534..2c4fc3a 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -235,3 +235,24 @@ def test_cli_outfile_keeps_file_on_format_error(tmpdir, capsys):
     assert out_file.read() == "select 1"
     _, err = capsys.readouterr()
     assert err.startswith("[ERROR] Failed to format")
+
+
+def test_cli_check(tmpdir, capsys):
+    bad = tmpdir.join('bad.sql')
+    bad.write('select * from foo')
+    good = tmpdir.join('good.sql')
+    good.write('select *\nfrom foo')
+
+    assert sqlparse.cli.main([str(good), '-r', '--check']) == 0
+    assert capsys.readouterr().out == ''
+
+    assert sqlparse.cli.main([str(good), str(bad), '-r', '--check']) == 1
+    assert capsys.readouterr().out == f'{bad}\n'
+    assert bad.read() == 'select * from foo'  # nothing written
+
+
+def test_cli_check_incompatible(tmpdir):
+    path = tmpdir.join('a.sql')
+    path.write('select 1')
+    assert sqlparse.cli.main([str(path), '--check', '--in-place']) == 1
+    assert sqlparse.cli.main([str(path), '--check', '-o', 'x']) == 1
