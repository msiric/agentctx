+##### significantDigits
+
+Type: `number`\
+Default: `3`
+
+The number of significant digits to round to when neither `minimumFractionDigits` nor `maximumFractionDigits` is set.
+
+Must be an integer between 1 and 100. Any other value is ignored and the default is used. Has no effect when a fraction digits option is set.
+
+```js
+import prettyBytes from 'pretty-bytes';
+
+prettyBytes(1337, {significantDigits: 2});
+//=> '1.3 kB'
+
+prettyBytes(1337, {significantDigits: 4});
+//=> '1.337 kB'
+```
+
 ##### minimumFractionDigits
 
 Type: `number`\
diff --git a/test.js b/test.js
index 4df338a..174592d 100644
--- a/test.js
+++ b/test.js
@@ -1198,3 +1198,27 @@ test('unit option throws for units outside the active system', t => {
 		prettyBytes(1337, {unit: undefined});
 	});
 });
+
+test('significantDigits option', t => {
+	t.is(prettyBytes(1337, {significantDigits: 1}), '1 kB');
+	t.is(prettyBytes(1337, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 3}), '1.34 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 10}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 2, bits: true}), '1.3 kbit');
+	t.is(prettyBytes(1337, {significantDigits: 2, locale: 'de'}), '1,3 kB');
+	t.is(prettyBytes(123_456, {significantDigits: 2}), '123 kB');
+	t.is(prettyBytes(999_999, {significantDigits: 2}), '1 MB');
+	t.is(prettyBytes(1337n, {significantDigits: 2}), '1.3 kB');
+});
+
+test('significantDigits option is ignored when fraction digits are set', t => {
+	t.is(prettyBytes(1337, {significantDigits: 2, maximumFractionDigits: 3}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4, minimumFractionDigits: 0, maximumFractionDigits: 1}), '1.3 kB');
+});
+
+test('significantDigits option ignores invalid values instead of throwing', t => {
+	for (const significantDigits of [0, -1, 1.5, 101, Number.NaN, Number.POSITIVE_INFINITY, '2', null, {}, 2n]) {
+		t.is(prettyBytes(1337, {significantDigits}), '1.34 kB');
+	}
+});
