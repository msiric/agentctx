+    @property
+    def bearer_token(self):
+        """ The token from an ``Authorization: Bearer <token>`` header, or
+            None if there is no Authorization header or it uses another
+            scheme. The scheme name is matched case-insensitively.
+
+            >>> from bottle import BaseRequest
+            >>> r = BaseRequest({'HTTP_AUTHORIZATION': 'Bearer abc123'})
+            >>> r.bearer_token
+            'abc123'
+            >>> BaseRequest({'HTTP_AUTHORIZATION': 'Basic Zm9v'}).bearer_token
+            >>> BaseRequest({}).bearer_token
+        """
+        scheme, _, token = self.environ.get('HTTP_AUTHORIZATION', '').partition(' ')
+        token = token.strip()
+        if scheme.lower() == 'bearer' and token:
+            return token
+        return None
+
