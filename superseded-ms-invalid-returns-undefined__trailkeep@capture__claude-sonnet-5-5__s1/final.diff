+import { describe, expect, it } from '@jest/globals';
+import { parseClock } from './index';
+
+describe('parseClock(string)', () => {
+  it('should parse m:ss', () => {
+    expect(parseClock('1:30')).toBe(90000);
+    expect(parseClock('0:05')).toBe(5000);
+    expect(parseClock('00:45')).toBe(45000);
+  });
+
+  it('should allow minutes above 59 in m:ss', () => {
+    expect(parseClock('90:00')).toBe(5400000);
+  });
+
+  it('should parse h:mm:ss', () => {
+    expect(parseClock('01:02:03')).toBe(3723000);
+    expect(parseClock('1:00:00')).toBe(3600000);
+    expect(parseClock('100:00:00')).toBe(360000000);
+  });
+
+  it('should parse fractional seconds', () => {
+    expect(parseClock('1:30.5')).toBe(90500);
+    expect(parseClock('0:00:01.25')).toBe(1250);
+  });
+
+  it('should ignore surrounding whitespace', () => {
+    expect(parseClock(' 1:30 ')).toBe(90000);
+  });
+
+  it('should return undefined for invalid input', () => {
+    for (const bad of [
+      '',
+      '90',
+      '1:5',
+      '1:60',
+      '1:60:00',
+      '1:75:00',
+      '1:2:03',
+      '1:02:03:04',
+      ':30',
+      '1:',
+      '-1:30',
+      '1h 30m',
+      'a:bc',
+    ]) {
+      expect(parseClock(bad)).toBeUndefined();
+    }
+  });
+
+  it('should return undefined for non-strings', () => {
+    expect(parseClock(90 as unknown as string)).toBeUndefined();
+    expect(parseClock(undefined as unknown as string)).toBeUndefined();
+  });
+});
