+/**
+ * Parse a compound duration such as `"1h 30m"`, `"1h, 30m"` or `"2 days 4 hours"` and
+ * return the total in milliseconds. Each piece must have a unit and is parsed
+ * with `parse`.
+ *
+ * @param str - A compound duration string
+ * @returns The total in milliseconds
+ * @throws TypeError if `str` is not a string or isn't a valid compound duration
+ */
+export function parseCompound(str: string): number {
+  const invalid = () =>
+    new TypeError(
+      `Value provided to ms.parseCompound() must be a compound duration like "1h 30m" or "1h, 30m". value=${JSON.stringify(str)}`,
+    );
+  if (typeof str !== 'string') {
+    throw invalid();
+  }
+  const trimmed = str.trim();
+  const unit = '-?\\d*\\.?\\d+ *[a-z]+';
+  if (!new RegExp(`^${unit}(?:\\s*,?\\s*${unit})*$`, 'i').test(trimmed)) {
+    throw invalid();
+  }
+  let total = 0;
+  for (const [piece] of trimmed.matchAll(new RegExp(unit, 'gi'))) {
+    const value = parse(piece);
+    if (Number.isNaN(value)) {
+      throw invalid();
+    }
+    total += value;
+  }
+  return total;
+}
+
+/**
+ * Parse a timer-style clock string and return the total in milliseconds.
+ * `"1:30"` is m:ss and `"01:02:03"` is h:mm:ss. Seconds may have a fractional
+ * part (`"1:30.5"`).
+ *
+ * Unlike `parseCompound`, this returns `undefined` for invalid input instead
+ * of throwing.
+ *
+ * @param str - A clock string
+ * @returns The total in milliseconds, or `undefined` if `str` isn't valid
+ */
+export function parseClock(str: string): number | undefined {
+  if (typeof str !== 'string') {
+    return undefined;
+  }
+  const match =
+    /^(?:(\d+):([0-5]\d)|(\d+)):([0-5]\d(?:\.\d+)?)$/.exec(str.trim());
+  if (!match) {
+    return undefined;
+  }
+  const [, hours, minutes, minutesOnly, seconds] = match;
+  if (hours !== undefined) {
+    return Number(hours) * h + Number(minutes) * m + Number(seconds) * s;
+  }
+  return Number(minutesOnly) * m + Number(seconds) * s;
+}
