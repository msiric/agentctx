 	number: number | bigint,
 	options?: Options
 ): string;
+
+/**
+Convert a human readable byte string to a number of bytes. The reverse of `prettyBytes()`.
+
+Supports plain numbers, the SI units (`B`, `kB`, `MB`, `GB`, `TB`, `PB`, `EB`, `ZB`, `YB`) and the binary units (`B`, `KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`, `ZiB`, `YiB`). SI units are strict powers of 1000, so `'1 MB'` is exactly `1000000`, and binary units are powers of 1024. `KB` is accepted as an alias of `kB` and also means 1000. Units are case-sensitive and the number may be fractional. The space before the unit is optional. A leading `+` or `-` is accepted.
+
+Bit units, localized numbers and exponent notation throw.
+
+@param string - The string to parse, like `'1.5 KiB'`.
+@returns The number of bytes. Not rounded, so a fractional result is possible, like `'0.5 B'` → `0.5`. Values beyond `Number.MAX_SAFE_INTEGER`, like `'1 YB'`, are the closest `number`.
+@throws A `SyntaxError` if the string is not a number with an optional supported unit.
+
+@example
+```
+import {parseBytes} from 'pretty-bytes';
+
+parseBytes('512');
+//=> 512
+
+parseBytes('1.5 KiB');
+//=> 1536
+
+parseBytes('1.5 MB');
+//=> 1500000
+```
+*/
+export function parseBytes(string: string): number;
diff --git a/index.js b/index.js
index c5f37ab..68fcc13 100644
--- a/index.js
+++ b/index.js
@@ -285,3 +285,43 @@ export default function prettyBytes(number, options) {
 	const result = prefix + numberString + separator + UNITS[exponent];
 	return result.padStart(options.fixedWidth ?? 0);
 }
+
+// Binary units are powers of 1024, which are exact in a `number`, so the multiplication adds no error of its own.
+const BINARY_MULTIPLIERS = new Map(BIBYTE_UNITS.map((unit, index) => [unit, 1024 ** index]));
+
+// SI units are powers of 1000 and are scaled in decimal (see `parseBytes`), so only the power of ten is stored. `KB` is accepted as an alias of `kB` and means 1000 bytes too, not 1024.
+const DECIMAL_EXPONENTS = new Map([...BYTE_UNITS.map((unit, index) => [unit, index * 3]), ['KB', 3]]);
+
+const SUPPORTED_PARSE_UNITS = [...BYTE_UNITS, 'KB', ...BIBYTE_UNITS.slice(1)];
+
+// Optional sign, digits with an optional fraction, then an optional unit. Both kinds of space that `prettyBytes` can write are accepted.
+const PARSE_PATTERN = /^([+-]?)(\d+(?:\.\d+)?|\.\d+)[ \u00A0]*([A-Za-z]*)$/;
+
+export function parseBytes(string) {
+	if (typeof string !== 'string') {
+		throw new TypeError(`Expected a string, got ${typeof string}`);
+	}
+
+	const match = PARSE_PATTERN.exec(string.trim());
+
+	if (!match) {
+		throw new SyntaxError(`Invalid byte string: ${JSON.stringify(string)}`);
+	}
+
+	const [, sign, value, unit = ''] = match;
+	const unitName = unit === '' ? 'B' : unit;
+	let result;
+
+	if (DECIMAL_EXPONENTS.has(unitName)) {
+		// Shift the decimal point in the digit string instead of multiplying, so `1.001 kB` is exactly `1001` and `1 MB` exactly `1000000`. `Number()` then rounds correctly once, which is the closest `number` for values like `1 YB` that are too large to be exact.
+		const [integer, fraction = ''] = value.split('.');
+		result = Number(`${integer}${fraction}e${DECIMAL_EXPONENTS.get(unitName) - fraction.length}`);
+	} else if (BINARY_MULTIPLIERS.has(unitName)) {
+		result = Number(value) * BINARY_MULTIPLIERS.get(unitName);
+	} else {
+		throw new SyntaxError(`Unsupported unit ${JSON.stringify(unit)} in ${JSON.stringify(string)}. Supported units: ${SUPPORTED_PARSE_UNITS.join(', ')}`);
+	}
+
+	// Avoids `-0`.
+	return sign === '-' && result !== 0 ? -result : result;
+}
