+
+test('parseBytes - plain numbers and bytes', t => {
+	t.is(parseBytes('512'), 512);
+	t.is(parseBytes('512 B'), 512);
+	t.is(parseBytes('512B'), 512);
+	t.is(parseBytes('  0  '), 0);
+	t.is(parseBytes('.5 KiB'), 512);
+});
+
+test('parseBytes - binary units', t => {
+	for (const [index, unit] of BINARY_UNITS.entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1024 ** index);
+	}
+
+	t.is(parseBytes('1.5 KiB'), 1536);
+	t.is(parseBytes('2.5MiB'), 2.5 * 1024 * 1024);
+	t.is(parseBytes('1 KiB'), 1024);
+});
+
+test('parseBytes - signs', t => {
+	t.is(parseBytes('-1 KiB'), -1024);
+	t.is(parseBytes('+1 KiB'), 1024);
+});
+
+test('parseBytes - round-trips prettyBytes binary output', t => {
+	t.is(parseBytes(prettyBytes(1536, {binary: true})), 1536);
+	t.is(parseBytes(prettyBytes(3 * (1024 ** 3), {binary: true})), 3 * (1024 ** 3));
+});
+
+test('parseBytes - units are case-sensitive', t => {
+	for (const input of ['1 kib', '1 KIB', '1 kiB', '1 b', '1 mib', '1 Kb', '1 gb']) {
+		t.throws(() => parseBytes(input), {instanceOf: TypeError});
+	}
+});
+
+test('parseBytes - decimal units are strict SI', t => {
+	const units = ['B', 'kB', 'MB', 'GB', 'TB', 'PB', 'EB', 'ZB', 'YB'];
+
+	for (const [index, unit] of units.entries()) {
+		t.is(parseBytes(`1 ${unit}`), Number(`1e${index * 3}`));
+	}
+
+	t.is(parseBytes('1 MB'), 1_000_000);
+	t.is(parseBytes('1 KB'), 1000);
+	t.is(parseBytes('1 kB'), 1000);
+	t.is(parseBytes('1.1 kB'), 1100);
+	t.is(parseBytes('0.3 MB'), 300_000);
+	t.is(parseBytes('-2.5GB'), -2_500_000_000);
+});
+
+test('parseBytes - round-trips prettyBytes decimal output', t => {
+	for (const bytes of [1000, 1500, 1_000_000, 2_340_000, 5e9, 7e12]) {
+		t.is(parseBytes(prettyBytes(bytes)), bytes);
+	}
+});
+
+test('parseBytes - bit units are not supported', t => {
+	for (const input of ['1 kbit', '1 Kibit', '1 Mbit', '1 mb', '1 Kb']) {
+		t.throws(() => parseBytes(input), {instanceOf: TypeError, message: /Unsupported unit/});
+	}
+});
+
+test('parseBytes - invalid input', t => {
+	for (const input of ['', ' ', 'KiB', 'abc', '1..5 KiB', '1,5 KiB', '1e3', '1 2 KiB', '1 KiB KiB', '--1', 'Infinity', 'NaN']) {
+		t.throws(() => parseBytes(input), {instanceOf: TypeError});
+	}
+
+	for (const input of [1, undefined, null, {}, 10n]) {
+		t.throws(() => parseBytes(input), {instanceOf: TypeError, message: /Expected a string/});
+	}
+});
