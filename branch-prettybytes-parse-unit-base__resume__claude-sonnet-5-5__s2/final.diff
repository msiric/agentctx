@@ -216,3 +216,23 @@ export default function prettyBytes(
 	number: number | bigint,
 	options?: Options
 ): string;
+
+/**
+Parse a human readable binary size string into a number of bytes. The reverse of `prettyBytes(number, {binary: true})`.
+
+Supports plain numbers (`'512'`), bytes (`'512 B'`), the decimal (SI) units `kB`, `MB`, `GB`, `TB`, `PB`, `EB`, `ZB`, `YB`, and the binary units `KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`, `ZiB`, `YiB`. Decimal units are exact powers of 1000, so `'1 MB'` is `1000000`. `KB` is accepted as an alias for `kB` and also means 1000. Fractional values are allowed. Units are case-sensitive. Bit units are not supported.
+
+@throws A `TypeError` if the input is not a string, cannot be parsed, or uses an unsupported unit.
+
+@example
+```
+import {parseBytes} from 'pretty-bytes';
+
+parseBytes('1.5 KiB');
+//=> 1536
+
+parseBytes('1.5 MB');
+//=> 1500000
+```
+*/
+export function parseBytes(string: string): number;
diff --git a/index.js b/index.js
index c5f37ab..931ba30 100644
--- a/index.js
+++ b/index.js
@@ -285,3 +285,36 @@ export default function prettyBytes(number, options) {
 	const result = prefix + numberString + separator + UNITS[exponent];
 	return result.padStart(options.fixedWidth ?? 0);
 }
+
+const BINARY_MULTIPLIERS = new Map(BIBYTE_UNITS.map((unit, index) => [unit, 1024 ** index]));
+
+// Strict SI: `kB` is exactly 1000 bytes. `KB` is accepted as an alias for `kB`, and means 1000, not 1024.
+// The value is scaled by a decimal exponent (`1.1e3`) rather than multiplied, so `1.1 kB` is exactly `1100`.
+const DECIMAL_EXPONENTS = new Map(BYTE_UNITS.map((unit, index) => [unit, index * 3]));
+DECIMAL_EXPONENTS.set('KB', 3);
+
+// Optional sign, digits with optional fraction, optional whitespace (incl. non-breaking), optional unit.
+const PARSE_PATTERN = /^(?<sign>[+-])?(?<value>\d+(?:\.\d+)?|\.\d+)(?:[\s\u00A0\u202F]*(?<unit>[A-Za-z]+))?$/;
+
+export function parseBytes(string) {
+	if (typeof string !== 'string') {
+		throw new TypeError(`Expected a string, got ${typeof string}: ${string}`);
+	}
+
+	const match = PARSE_PATTERN.exec(string.trim());
+
+	if (!match) {
+		throw new TypeError(`Unable to parse bytes from: ${JSON.stringify(string)}`);
+	}
+
+	const {sign, value, unit = 'B'} = match.groups;
+	const multiplier = BINARY_MULTIPLIERS.get(unit);
+	const exponent = DECIMAL_EXPONENTS.get(unit);
+
+	if (multiplier === undefined && exponent === undefined) {
+		throw new TypeError(`Unsupported unit ${JSON.stringify(unit)}. Supported units: ${[...new Set([...BYTE_UNITS, 'KB', ...BIBYTE_UNITS])].join(', ')}`);
+	}
+
+	const result = exponent === undefined || unit === 'B' ? Number(value) * (multiplier ?? 1) : Number(`${value}e${exponent}`);
+	return sign === '-' ? -result : result;
+}
