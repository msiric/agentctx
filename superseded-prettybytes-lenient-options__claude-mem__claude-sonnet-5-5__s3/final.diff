+##### significantDigits
+
+Type: `number`\
+Default: `3`
+
+The number of significant digits to round to. Only applies when neither `minimumFractionDigits` nor `maximumFractionDigits` is set.
+
+Must be an integer between 1 and 100. Any other value is ignored and the default is used. The integer part of the number is never shortened, so `123456` bytes with `significantDigits: 2` is still `123 kB`.
+
+```js
+import prettyBytes from 'pretty-bytes';
+
+prettyBytes(1337, {significantDigits: 2});
+//=> '1.3 kB'
+
+prettyBytes(1337, {significantDigits: 4});
+//=> '1.337 kB'
+```
+
 ##### locale
 
 Type: `boolean | string | string[]`\
diff --git a/test.js b/test.js
index cf37244..8d0c235 100644
--- a/test.js
+++ b/test.js
@@ -1176,3 +1176,28 @@ test('the options shape the output as documented', t => {
 		t.is(prettyBytes(value, {signed: true}), prefix + prettyBytes(Math.abs(value)));
 	}
 });
+
+test('significantDigits option changes the default rounding', t => {
+	t.is(prettyBytes(1337, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 3}), '1.34 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4}), '1.337 kB');
+	t.is(prettyBytes(1337n, {significantDigits: 1}), '1 kB');
+	t.is(prettyBytes(1337, {significantDigits: 2, locale: 'de'}), '1,3 kB');
+	t.is(prettyBytes(-1337, {significantDigits: 4, bits: true}), '-1.337 kbit');
+});
+
+test('significantDigits never shortens the integer part and still rolls over units', t => {
+	t.is(prettyBytes(123_456, {significantDigits: 2}), '123 kB');
+	t.is(prettyBytes(999_960, {significantDigits: 2}), '1 MB');
+});
+
+test('significantDigits is ignored when fraction digit options are set', t => {
+	t.is(prettyBytes(1337, {significantDigits: 2, maximumFractionDigits: 3}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4, minimumFractionDigits: 1, maximumFractionDigits: 1}), '1.3 kB');
+});
+
+test('significantDigits ignores invalid values instead of throwing', t => {
+	for (const significantDigits of [0, -1, 1.5, 101, Number.NaN, Number.POSITIVE_INFINITY, '2', null, undefined, {}]) {
+		t.is(prettyBytes(1337, {significantDigits}), '1.34 kB');
+	}
+});
