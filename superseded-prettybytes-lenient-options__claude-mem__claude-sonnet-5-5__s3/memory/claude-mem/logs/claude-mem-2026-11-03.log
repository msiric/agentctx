s=s.replace("""test('validates the options before""","""test('unit option forces the output unit', t => {
	t.is(prettyBytes(1337, {unit: 'MB'}), '0.00134 MB');
	t.is(prettyBytes(1337, {unit: 'B'}), '1337 B');
	t.is(prettyBytes(1337, {unit: 'kB'}), '1.34 kB');
	t.is(prettyBytes(999_999, {unit: 'kB'}), '1000 kB');
	t.is(prettyBytes(2048, {unit: 'KiB', binary: true}), '2 KiB');
	t.is(prettyBytes(1337, {unit: 'Mbit', bits: true}), '0.00134 Mbit');
	t.is(prettyBytes(2048, {unit: 'kibit', bits: true, binary: true}), '2 kibit');
	t.is(prettyBytes(0, {unit: 'GB'}), '0 GB');
	t.is(prettyBytes(-1500, {unit: 'B'}), '-1500 B');
	t.is(prettyBytes(10n ** 30n, {unit: 'B'}), '1000000000000000000000000000000 B');
	t.is(prettyBytes(1337, {unit: 'MB', maximumFractionDigits: 2}), '0 MB');
	t.is(prettyBytes(1337, {unit: undefined}), '1.34 kB');
});

test('unit option must belong to the active unit system', t => {
	t.throws(() => prettyBytes(1337, {unit: 'KiB'}), {instanceOf: TypeError});
	t.throws(() => prettyBytes(1337, {unit: 'kbit'}), {instanceOf: TypeError});
	t.throws(() => prettyBytes(1337, {unit: 'MB', binary: true}), {instanceOf: TypeError});
	t.throws(() => prettyBytes(1337, {unit: 'B', bits: true}), {instanceOf: TypeError});
	t.throws(() => prettyBytes(1337, {unit: 'mb'}), {instanceOf: TypeError});
	t.throws(() => prettyBytes(1337, {unit: 5}), {instanceOf: TypeError});
	t.throws(() => prettyBytes(1337, {unit: null}), {instanceOf: TypeError});
});

test('validates the options before""",1)
open(p,'w').write(s)
E
echo "expectType<string>(prettyBytes(1337, {unit: 'MB'}));" >> index.test-d.ts
