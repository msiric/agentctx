cat >> src/utils.ts <<'EOF'

const DEFAULT_PORTS: Record<string, string> = {
  "http:": "80",
  "https:": "443",
  "ws:": "80",
  "wss:": "443",
  "ftp:": "21",
};

function getOrigin(input: string): string | undefined {
  const parsed = parseURL(input);
  if (!parsed.protocol || parsed.protocol === "file:" || !parsed.host) {
    return undefined;
  }
  if ((parsed as { [k: symbol]: unknown })[Object.getOwnPropertySymbols(parsed)[0]]) {
    return undefined; // protocol-relative
  }
  const m = parsed.host.match(/^(.*?)(?::(\d*))?$/);
  const hostname = (m?.[1] ?? parsed.host).toLowerCase();
  let port = m?.[2] ?? "";
  if (hostname.startsWith("[") && !hostname.endsWith("]")) {
    return undefined;
  }
  if (!port || port === DEFAULT_PORTS[parsed.protocol]) {
    port = "";
  }
  return `${parsed.protocol}//${hostname}${port ? ":" + port : ""}`;
}

/**
 * Checks if two URLs have the same origin (scheme, host and port).
 *
 * Default ports are equal to an omitted port. Path, query, hash and userinfo
 * are ignored. Relative, protocol-relative and opaque (`data:`, `javascript:`…)
 * inputs have no origin and are never same-origin.
 *
 * @group utils
 */
export function isSameOrigin(a: string, b: string): boolean {
  const originA = getOrigin(a);
  return originA !== undefined && originA === getOrigin(b);
}
EOF
