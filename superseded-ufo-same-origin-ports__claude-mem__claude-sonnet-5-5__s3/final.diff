diff --git a/test/same-origin.test.ts b/test/same-origin.test.ts
new file mode 100644
index 0000000..3f9be21
--- /dev/null
+++ b/test/same-origin.test.ts
@@ -0,0 +1,141 @@
+import { describe, expect, test } from "vitest";
+import { isSameOrigin } from "../src";
+
+// Semantics follow the WHATWG "origin" concept: scheme + host + port, except
+// that a scheme's default port is equal to an omitted port (http/ws: 80,
+// https/wss: 443, ftp: 21). Defaults are scheme-specific.
+// Path, query, hash and userinfo never influence the result.
+describe("isSameOrigin", () => {
+  describe("same origin", () => {
+    const same = [
+      // Identical
+      ["https://example.com", "https://example.com"],
+      // Path, query and hash are ignored
+      ["https://example.com", "https://example.com/"],
+      ["https://example.com/foo", "https://example.com/bar"],
+      ["https://example.com/foo?a=1", "https://example.com/bar?b=2"],
+      ["https://example.com/#a", "https://example.com/#b"],
+      // Userinfo is ignored
+      ["https://user:pass@example.com", "https://example.com"],
+      ["https://a@example.com/x", "https://b@example.com/y"],
+      // Scheme and host are case-insensitive
+      ["HTTPS://EXAMPLE.COM", "https://example.com"],
+      ["https://Example.Com/Path", "https://example.com/Path"],
+      // Default ports equal the omitted port
+      ["https://example.com", "https://example.com:443"],
+      ["https://example.com/foo", "https://example.com:443/bar"],
+      ["http://example.com", "http://example.com:80"],
+      ["ws://example.com", "ws://example.com:80"],
+      ["wss://example.com", "wss://example.com:443"],
+      ["http://[::1]", "http://[::1]:80"],
+      // Identical explicit ports
+      ["https://example.com:443", "https://example.com:443/foo"],
+      ["http://localhost:3000", "http://localhost:3000/api"],
+      ["http://127.0.0.1:8080", "http://127.0.0.1:8080/"],
+      // IPv6
+      ["http://[::1]:3000", "http://[::1]:3000/foo"],
+      // Other schemes
+      ["ws://example.com", "ws://example.com"],
+      ["wss://example.com:8443", "wss://example.com:8443"],
+    ];
+
+    for (const [a, b] of same) {
+      test(`${a} == ${b}`, () => {
+        expect(isSameOrigin(a, b)).toBe(true);
+        // Symmetric
+        expect(isSameOrigin(b, a)).toBe(true);
+      });
+    }
+  });
+
+  describe("different origin", () => {
+    const different = [
+      // Scheme
+      ["http://example.com", "https://example.com"],
+      ["ws://example.com", "wss://example.com"],
+      // Host
+      ["https://example.com", "https://example.org"],
+      ["https://example.com", "https://www.example.com"],
+      ["https://a.example.com", "https://b.example.com"],
+      ["https://example.com", "https://example.com.evil.com"],
+      // Port
+      ["http://example.com", "http://example.com:8080"],
+      ["https://example.com", "https://example.com:444"],
+      ["http://localhost:3000", "http://localhost:3001"],
+      // Default port of another scheme is not a default
+      ["https://example.com", "https://example.com:80"],
+      ["http://example.com", "http://example.com:443"],
+      ["http://example.com:443", "https://example.com"],
+      // Userinfo tricks: the real host is what follows the "@"
+      ["https://example.com", "https://example.com@evil.com"],
+      ["https://example.com", "https://example.com:443@evil.com"],
+      // Backslash is treated as "/" in special schemes, so host ends at "\"
+      ["https://example.com", "https://evil.com\\@example.com"],
+      // IPv6
+      ["http://[::1]:3000", "http://[::1]:3001"],
+      ["http://[::1]", "http://[::2]"],
+    ];
+
+    for (const [a, b] of different) {
+      test(`${a} != ${b}`, () => {
+        expect(isSameOrigin(a, b)).toBe(false);
+        expect(isSameOrigin(b, a)).toBe(false);
+      });
+    }
+  });
+
+  describe("inputs without an origin", () => {
+    // Relative references have no origin of their own, so they can't be
+    // "same origin" as anything -- not even each other.
+    const noOrigin = [
+      ["/foo", "/foo"],
+      ["foo", "foo"],
+      ["", ""],
+      ["/foo", "https://example.com/foo"],
+      ["https://example.com/foo", "/foo"],
+      ["https://example.com", ""],
+      ["?a=1", "?a=1"],
+      ["#hash", "#hash"],
+    ];
+
+    for (const [a, b] of noOrigin) {
+      test(`${JSON.stringify(a)} != ${JSON.stringify(b)}`, () => {
+        expect(isSameOrigin(a, b)).toBe(false);
+      });
+    }
+  });
+
+  describe("opaque origins", () => {
+    // Per spec, opaque origins are never equal to anything, even themselves.
+    const opaque = [
+      ["data:text/plain,hello", "data:text/plain,hello"],
+      ["javascript:alert(1)", "javascript:alert(1)"],
+      ["javascript:alert(1)", "https://example.com"],
+      ["vbscript:foo", "vbscript:foo"],
+      ["  javascript:alert(1)", "javascript:alert(1)"],
+    ];
+
+    for (const [a, b] of opaque) {
+      test(`${a} != ${b}`, () => {
+        expect(isSameOrigin(a, b)).toBe(false);
+      });
+    }
+  });
+
+  describe("protocol-relative", () => {
+    // Without a scheme the origin is unknown; both sides must be absolute.
+    test("//example.com != //example.com", () => {
+      expect(isSameOrigin("//example.com", "//example.com")).toBe(false);
+    });
+    test("//example.com != https://example.com", () => {
+      expect(isSameOrigin("//example.com", "https://example.com")).toBe(false);
+    });
+  });
+
+  // Open questions to settle before implementing:
+  test.todo("blob:https://example.com/<uuid> inherits the origin of its URL");
+  test.todo("unicode and punycode hosts compare equal (тест.рф vs xn--e1aybc.xn--p1ai)");
+  test.todo("trailing-dot FQDN (example.com.) vs example.com");
+  test.todo("whitespace / control chars around the input are trimmed");
+  test.todo("optional base argument to resolve relative inputs against");
+});
