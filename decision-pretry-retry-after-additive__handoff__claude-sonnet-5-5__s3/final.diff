+// A server's `Retry-After` hint, in seconds, as set on the error by the caller's client. Anything that is not a usable number is ignored rather than rejected, since it comes from a failure that is already being handled.
+function calculateRetryAfter(error) {
+	const {retryAfter} = error;
+
+	return typeof retryAfter === 'number' && Number.isFinite(retryAfter) && retryAfter > 0
+		? Math.min(Math.ceil(retryAfter * 1000), maximumDelay)
+		: 0;
+}
