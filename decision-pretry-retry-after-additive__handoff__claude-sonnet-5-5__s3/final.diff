+test('elapsedTime is provided in every callback context', async () => {
+	const seen = {shouldConsumeRetry: [], onFailedAttempt: [], shouldRetry: []};
+	const record = name => ({elapsedTime}) => {
+		seen[name].push(elapsedTime);
+		return true;
+	};
+
+	await assert.rejects(pRetry(
+		async () => {
+			await delay(20);
+			throw new Error('test');
+		},
+		{
+			retries: 2,
+			minTimeout: 0,
+			shouldConsumeRetry: record('shouldConsumeRetry'),
+			onFailedAttempt: record('onFailedAttempt'),
+			shouldRetry: record('shouldRetry'),
+		},
+	), {message: 'test'});
+
+	for (const values of [seen.shouldConsumeRetry, seen.onFailedAttempt]) {
+		assert.equal(values.length, 3);
+		assert.ok(values.every(value => typeof value === 'number'));
+		// Each attempt takes at least ~20ms, with slack for timer rounding.
+		assert.ok(values[0] >= 15, `first is ${values[0]}`);
+		assert.ok(values.every((value, index) => index === 0 || value > values[index - 1]), 'increases');
+	}
+
+	assert.equal(seen.shouldRetry.length, 2);
+	assert.ok(seen.shouldRetry[0] >= 15);
+});
