+
+
+def test_check_nothing_missing(cli, dotenv_path):
+    dotenv_path.write_text("A=1\nB=2\nEXTRA=3\n")
+    (dotenv_path.parent / ".env.example").write_text("A=\nB=x\n")
+
+    result = cli.invoke(dotenv_cli, ["--file", dotenv_path, "check"])
+
+    assert (result.exit_code, result.output) == (0, "")
+
+
+def test_check_lists_missing_keys(cli, dotenv_path):
+    dotenv_path.write_text("A=1\n")
+    (dotenv_path.parent / ".env.example").write_text("A=\nB=\n# C=\nD\n")
+
+    result = cli.invoke(dotenv_cli, ["--file", dotenv_path, "check"])
+
+    assert (result.exit_code, result.output) == (1, "B\nD\n")
+
+
+def test_check_bare_and_empty_keys_count_as_present(cli, dotenv_path):
+    dotenv_path.write_text("A\nB=\n")
+    (dotenv_path.parent / ".env.example").write_text("A=1\nB=1\n")
+
+    result = cli.invoke(dotenv_cli, ["--file", dotenv_path, "check"])
+
+    assert (result.exit_code, result.output) == (0, "")
+
+
+def test_check_custom_example(cli, dotenv_path, tmp_path):
+    dotenv_path.write_text("A=1\n")
+    (dotenv_path.parent / ".env.example").write_text("IGNORED=\n")
+    other = tmp_path / "other.example"
+    other.write_text("A=\nB=\n")
+
+    result = cli.invoke(
+        dotenv_cli, ["--file", dotenv_path, "check", "--example", str(other)]
+    )
+
+    assert (result.exit_code, result.output) == (1, "B\n")
+
+
+def test_check_missing_example_file(cli, dotenv_path):
+    dotenv_path.write_text("A=1\n")
+
+    result = cli.invoke(dotenv_cli, ["--file", dotenv_path, "check"])
+
+    assert result.exit_code == 2, result.output
+    assert "Error opening env file" in result.output
+
+
+def test_check_missing_env_file(cli, dotenv_path):
+    (dotenv_path.parent / ".env.example").write_text("A=\n")
+    dotenv_path.unlink()
+
+    result = cli.invoke(dotenv_cli, ["--file", dotenv_path, "check"])
+
+    assert result.exit_code == 2, result.output
+
+
+def test_diff_identical(cli, tmp_path):
+    a, b = tmp_path / "a.env", tmp_path / "b.env"
+    a.write_text("A=1\nB=2\n")
+    b.write_text("B=2\nA=1\n")
+
+    result = cli.invoke(dotenv_cli, ["diff", str(a), str(b)])
+
+    assert (result.exit_code, result.output) == (0, "")
+
+
+def test_diff_reports_all_differences_without_values(cli, tmp_path):
+    a, b = tmp_path / "a.env", tmp_path / "b.env"
+    a.write_text("ONLY_A=1\nSAME=x\nDIFF=secret1\n")
+    b.write_text("SAME=x\nDIFF=secret2\nONLY_B=1\n")
+
+    result = cli.invoke(dotenv_cli, ["diff", str(a), str(b)])
+
+    assert (result.exit_code, result.output) == (1, "< ONLY_A\n> ONLY_B\n~ DIFF\n")
+
+
+def test_diff_bare_key_differs_from_empty_value(cli, tmp_path):
+    a, b = tmp_path / "a.env", tmp_path / "b.env"
+    a.write_text("A\n")
+    b.write_text("A=\n")
+
+    result = cli.invoke(dotenv_cli, ["diff", str(a), str(b)])
+
+    assert (result.exit_code, result.output) == (1, "~ A\n")
+
+
+def test_diff_missing_file(cli, tmp_path):
+    a = tmp_path / "a.env"
+    a.write_text("A=1\n")
+
+    result = cli.invoke(dotenv_cli, ["diff", str(a), str(tmp_path / "nope")])
+
+    assert result.exit_code == 2, result.output
+    assert "Error opening env file" in result.output
