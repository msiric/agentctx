diff --git a/tests/test_storages.py b/tests/test_storages.py
index 6e433a1..e3acc41 100644
--- a/tests/test_storages.py
+++ b/tests/test_storages.py
@@ -285,3 +285,91 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def test_json_write_crash_leaves_old_state(tmpdir, monkeypatch):
+    path = str(tmpdir.join('db.json'))
+
+    db = TinyDB(path)
+    db.insert({'a': 1})
+
+    def crash(*args, **kwargs):
+        raise KeyboardInterrupt  # simulates dying right before the rename
+
+    monkeypatch.setattr(os, 'replace', crash)
+    with pytest.raises(KeyboardInterrupt):
+        db.insert({'b': 2})
+    monkeypatch.undo()
+
+    # No temp files are left behind and the old state is intact
+    assert os.listdir(str(tmpdir)) == ['db.json']
+    with TinyDB(path) as db2:
+        assert db2.all() == [{'a': 1}]
+
+
+def test_json_write_crash_during_serialization(tmpdir):
+    path = str(tmpdir.join('db.json'))
+
+    db = TinyDB(path)
+    db.insert({'a': 1})
+
+    with pytest.raises(TypeError):
+        db.insert({'b': object()})
+
+    with TinyDB(path) as db2:
+        assert db2.all() == [{'a': 1}]
+
+
+def test_json_write_crash_mid_file_write(tmpdir, monkeypatch):
+    path = str(tmpdir.join('db.json'))
+
+    db = TinyDB(path)
+    db.insert({'a': 1})
+
+    def crash(fd):
+        raise OSError('simulated crash during fsync')
+
+    monkeypatch.setattr(os, 'fsync', crash)
+    with pytest.raises(OSError):
+        db.insert({'b': 2})
+    monkeypatch.undo()
+
+    assert os.listdir(str(tmpdir)) == ['db.json']
+    with TinyDB(path) as db2:
+        assert db2.all() == [{'a': 1}]
+
+
+def test_json_write_keeps_working_after_replace(tmpdir):
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+        db.insert({'b': 2})
+        assert len(db) == 2
+
+    with TinyDB(path) as db:
+        assert db.all() == [{'a': 1}, {'b': 2}]
+
+
+@pytest.mark.skipif(os.name == 'nt', reason='POSIX permissions')
+def test_json_write_preserves_permissions(tmpdir):
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path) as db:
+        os.chmod(path, 0o640)
+        db.insert({'a': 1})
+
+    assert os.stat(path).st_mode & 0o777 == 0o640
+
+
+@pytest.mark.skipif(os.name == 'nt', reason='symlinks')
+def test_json_write_follows_symlink(tmpdir):
+    real = tmpdir.join('real.json')
+    link = tmpdir.join('link.json')
+    os.symlink(str(real), str(link))
+
+    with TinyDB(str(link)) as db:
+        db.insert({'a': 1})
+
+    assert os.path.islink(str(link))
+    assert json.loads(real.read())['_default']['1'] == {'a': 1}
