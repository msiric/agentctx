diff --git a/test/count.js b/test/count.js
new file mode 100644
index 0000000..2a23278
--- /dev/null
+++ b/test/count.js
@@ -0,0 +1,39 @@
+const test = require('tape');
+const fn = require('../lib');
+
+test('count :: short group', t => {
+	t.deepEqual(fn(['-vvv'], { count: 'v' }), { v: 3, _: [] });
+	t.end();
+});
+
+test('count :: long repeated', t => {
+	t.deepEqual(fn(['--verbose', '--verbose'], { count: ['verbose'] }), { verbose: 2, _: [] });
+	t.end();
+});
+
+test('count :: single and mixed', t => {
+	t.deepEqual(fn(['-v'], { count: 'v' }), { v: 1, _: [] });
+	t.deepEqual(fn(['-v', '-vv', '--other'], { count: 'v' }), { v: 3, other: true, _: [] });
+	t.end();
+});
+
+test('count :: does not consume next arg', t => {
+	t.deepEqual(fn(['-v', 'foo', '-v'], { count: 'v' }), { v: 2, _: ['foo'] });
+	t.end();
+});
+
+test('count :: aliases are summed', t => {
+	const res = fn(['-v', '--verbose', '-vv'], { count: 'v', alias: { v: 'verbose' } });
+	t.deepEqual(res, { v: 4, verbose: 4, _: [] });
+	const res2 = fn(['-v', '--verbose'], { count: 'verbose', alias: { v: 'verbose' } });
+	t.deepEqual(res2, { v: 2, verbose: 2, _: [] });
+	t.end();
+});
+
+test('count :: absent, default, negation', t => {
+	t.deepEqual(fn(['a'], { count: 'v' }), { _: ['a'] });
+	t.deepEqual(fn([], { count: 'v', default: { v: 0 } }), { v: 0, _: [] });
+	t.deepEqual(fn(['--no-v'], { count: 'v' }), { v: 0, _: [] });
+	t.deepEqual(fn(['-vv', '--no-v', '-v'], { count: 'v' }), { v: 1, _: [] });
+	t.end();
+});
