--- a/test_schedule.py
+++ b/test_schedule.py
@@ -1569,6 +1569,58 @@ class SchedulerTests(TestCase):
         schedule.clear()
         assert len(schedule.jobs) == 0
 
+    def test_get_jobs_for(self):
+        def job_a(*args):
+            pass
+
+        def job_b():
+            pass
+
+        j1 = every().second.do(job_a)
+        j2 = every().minute.do(job_a, 1, 2)
+        j3 = every().second.do(job_b)
+        assert schedule.default_scheduler.get_jobs_for(job_a) == [j1, j2]
+        assert schedule.default_scheduler.get_jobs_for(job_b) == [j3]
+        assert schedule.default_scheduler.get_jobs_for(lambda: None) == []
+        schedule.cancel_job(j1)
+        assert schedule.default_scheduler.get_jobs_for(job_a) == [j2]
+
+    def test_get_jobs_for_ignores_unconfigured_jobs(self):
+        scheduler = schedule.Scheduler()
+        scheduler.every()  # job without do()
+        assert scheduler.get_jobs_for(lambda: None) == []
+
+    def test_pause_and_resume_by_tag(self):
+        paused = make_mock_job(name="paused")
+        other = make_mock_job(name="other")
+        with mock_datetime(2020, 1, 1, 10, 0, 0):
+            every().second.do(paused).tag("maint")
+            every().second.do(other).tag("other")
+            schedule.pause("maint")
+        with mock_datetime(2020, 1, 1, 10, 0, 5):
+            schedule.run_pending()
+            assert paused.call_count == 0
+            assert other.call_count == 1
+        with mock_datetime(2020, 1, 1, 10, 0, 10):
+            schedule.resume("maint")
+            schedule.run_pending()
+            assert paused.call_count == 1
+            assert other.call_count == 2
+
+    def test_pause_keeps_jobs_scheduled(self):
+        job = every().second.do(make_mock_job()).tag("maint")
+        schedule.pause("maint")
+        assert job in schedule.get_jobs("maint")
+        assert job.paused
+        schedule.resume("maint")
+        assert not job.paused
+
+    def test_pause_unknown_tag_is_noop(self):
+        job = every().second.do(make_mock_job()).tag("a")
+        schedule.pause("nope")
+        schedule.resume("nope")
+        assert not job.paused
+
     def test_clear_by_tag(self):
         every().second.do(make_mock_job(name="job1")).tag("tag1")
         every().second.do(make_mock_job(name="job2")).tag("tag1", "tag2")
