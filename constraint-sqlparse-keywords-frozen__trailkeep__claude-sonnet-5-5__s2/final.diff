diff --git a/tests/test_cli.py b/tests/test_cli.py
index f33b534..1ed756a 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -235,3 +235,28 @@ def test_cli_outfile_keeps_file_on_format_error(tmpdir, capsys):
     assert out_file.read() == "select 1"
     _, err = capsys.readouterr()
     assert err.startswith("[ERROR] Failed to format")
+
+
+def test_check_reports_files_that_would_change(tmpdir, capsys):
+    changed = tmpdir.join('changed.sql')
+    changed.write('select 1\n')
+    clean = tmpdir.join('clean.sql')
+    clean.write('SELECT 1\n')
+    rc = sqlparse.cli.main(['-k', 'upper', '--check',
+                            str(changed), str(clean)])
+    assert rc == 1
+    assert capsys.readouterr().out == f'{changed}\n'
+    assert changed.read() == 'select 1\n'  # nothing written
+
+
+def test_check_clean_exits_zero(tmpdir, capsys):
+    clean = tmpdir.join('clean.sql')
+    clean.write('SELECT 1\n')
+    assert sqlparse.cli.main(['-k', 'upper', '--check', str(clean)]) == 0
+    assert capsys.readouterr().out == ''
+
+
+def test_check_incompatible_with_inplace(tmpdir):
+    f = tmpdir.join('a.sql')
+    f.write('select 1\n')
+    assert sqlparse.cli.main(['--check', '--in-place', str(f)]) == 1
