+@pytest.mark.parametrize('word', [
+    'exclude', 'match_recognize', 'asof', 'match_condition'])
+def test_local_snowflake_keywords(word):
+    from sqlparse import tokens as T
+    tok = sqlparse.parse(word)[0].tokens[0]
+    assert tok.ttype is T.Keyword
+    assert sqlparse.format(f'select * {word} (a)', keyword_case='upper') \
+        == f'SELECT * {word.upper()} (a)'
