diff --git a/sqlparse/extra_keywords.py b/sqlparse/extra_keywords.py
new file mode 100644
index 0000000..dcf7ad0
--- /dev/null
+++ b/sqlparse/extra_keywords.py
@@ -0,0 +1,15 @@
+"""Locally maintained keywords.
+
+Kept out of ``keywords.py`` so that file stays identical to upstream.
+These are registered on the default lexer in
+``Lexer.default_initialization``.
+"""
+
+from sqlparse import tokens
+
+KEYWORDS_LOCAL = {
+    'EXCLUDE': tokens.Keyword,
+    'MATCH_RECOGNIZE': tokens.Keyword,
+    'ASOF': tokens.Keyword,
+    'MATCH_CONDITION': tokens.Keyword,
+}
