     db.close()
+
+
+def test_to_csv_default_fields(db, tmp_path):
+    import csv
+
+    table = db.table('csv')
+    table.insert({'a': 1, 'b': 'x'})
+    table.insert({'b': 'y', 'c': 3})
+
+    path = tmp_path / 'out.csv'
+    table.to_csv(path)
+
+    with open(path, newline='', encoding='utf-8') as f:
+        rows = list(csv.reader(f))
+
+    assert rows == [['a', 'b', 'c'], ['1', 'x', ''], ['', 'y', '3']]
+
+
+def test_to_csv_fields_select_and_order(db, tmp_path):
+    import csv
+
+    table = db.table('csv')
+    table.insert({'a': 1, 'b': 'x'})
+    table.insert({'b': 'y'})
+
+    path = tmp_path / 'out.csv'
+    table.to_csv(path, fields=['b', 'z', 'a'])
+
+    with open(path, newline='', encoding='utf-8') as f:
+        rows = list(csv.reader(f))
+
+    assert rows == [['b', 'z', 'a'], ['x', '', '1'], ['y', '', '']]
+
+
+def test_to_csv_empty_table_and_quoting(db, tmp_path):
+    import csv
+
+    table = db.table('csv')
+    path = tmp_path / 'empty.csv'
+    table.to_csv(path, fields=['a'])
+    assert path.read_text(encoding='utf-8').splitlines() == ['a']
+
+    table.insert({'a': 'he said "hi", ok\nbye'})
+    table.to_csv(path)
+    with open(path, newline='', encoding='utf-8') as f:
+        assert list(csv.reader(f)) == [['a'], ['he said "hi", ok\nbye']]
