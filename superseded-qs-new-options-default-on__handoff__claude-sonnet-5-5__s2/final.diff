 Parse the value as a boolean type instead of string type if it's a boolean.
 
+##### ignoreEmpty
+
+Type: `boolean`\
+Default: `false`
+
+```js
+import queryString from 'query-string';
+
+queryString.parse('?q=&page=2', {ignoreEmpty: true});
+//=> {page: '2'}
+
+queryString.parse('?flag&q=', {ignoreEmpty: true});
+//=> {flag: null}
+```
+
+Drop parameters with an empty value. A key without `=` (like `?flag`) is not empty, so it is kept.
+
+##### stripTracking
+
+Type: `boolean`\
+Default: `true`
+
+```js
+import queryString from 'query-string';
+
+queryString.parse('?q=a&utm_source=x&fbclid=1&gclid=2');
+//=> {q: 'a'}
+
+queryString.parse('?q=a&utm_source=x', {stripTracking: false});
+//=> {q: 'a', utm_source: 'x'}
+```
+
+Drop tracking parameters: `utm_*`, `fbclid`, and `gclid`. The key is matched case-insensitively. Set it to `false` to keep them.
+
 ##### types
 
 Type: `object`\
diff --git a/test/parse.js b/test/parse.js
index 00a1abf..37031dd 100644
--- a/test/parse.js
+++ b/test/parse.js
@@ -1492,3 +1492,20 @@ test('rejects an invalid `arrayFormatSeparator`', () => {
 
 	assert.deepEqual(structuredClone(queryString.parse('foo=a·b', {arrayFormat: 'separator', arrayFormatSeparator: '·'})), {foo: ['a', 'b']});
 });
+
+test('parse - `ignoreEmpty` drops parameters with an empty value', () => {
+	assert.deepEqual(structuredClone(queryString.parse('?q=&page=2', {ignoreEmpty: true})), {page: '2'});
+	assert.deepEqual(structuredClone(queryString.parse('?flag&q=', {ignoreEmpty: true})), {flag: null});
+	assert.deepEqual(structuredClone(queryString.parse('q=', {ignoreEmpty: true})), {});
+	assert.deepEqual(structuredClone(queryString.parse('a[]=&a[]=1&b=', {ignoreEmpty: true, arrayFormat: 'bracket'})), {a: ['1']});
+	assert.deepEqual(structuredClone(queryString.parse('q=&page=2')), {page: '2', q: ''});
+});
+
+test('parse - `stripTracking` drops tracking parameters by default', () => {
+	assert.deepEqual(structuredClone(queryString.parse('?q=a&utm_source=x&utm_medium=y&fbclid=1&gclid=2')), {q: 'a'});
+	assert.deepEqual(structuredClone(queryString.parse('?UTM_Source=x&FBCLID=1&q=a')), {q: 'a'});
+	assert.deepEqual(structuredClone(queryString.parse('?utm_source&q=a')), {q: 'a'});
+	assert.deepEqual(structuredClone(queryString.parse('?utm%5Fsource=x&q=a')), {q: 'a'});
+	assert.deepEqual(structuredClone(queryString.parse('?utmx=1&fbclid2=1&xgclid=1')), {utmx: '1', fbclid2: '1', xgclid: '1'});
+	assert.deepEqual(structuredClone(queryString.parse('?q=a&utm_source=x&fbclid=1', {stripTracking: false})), Object.fromEntries([['fbclid', '1'], ['q', 'a'], ['utm_source', 'x']]));
+});
