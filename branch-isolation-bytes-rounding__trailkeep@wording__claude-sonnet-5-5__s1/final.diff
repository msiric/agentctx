@@ -127,6 +127,30 @@ function format(value, options) {
   return str + unitSeparator + unit;
 }
 
+/**
+ * Format a number with a fixed count of decimals, truncating (toward zero)
+ * instead of rounding, so the displayed size never exceeds the actual size.
+ *
+ * @param {number} val
+ * @param {number} decimalPlaces
+ * @returns {string}
+ * @private
+ */
+
+function truncate(val, decimalPlaces) {
+  if (Math.abs(val) >= 1e21) {
+    return val.toFixed(decimalPlaces);
+  }
+
+  // toFixed with many digits yields the exact expansion, which is then cut
+  var places = Math.max(0, Math.floor(decimalPlaces));
+  var exact = val.toFixed(Math.min(100, places + 30));
+  var dot = exact.indexOf('.');
+  var cut = places === 0 ? dot : dot + 1 + places;
+
+  return exact.slice(0, cut).padEnd(cut, '0');
+}
