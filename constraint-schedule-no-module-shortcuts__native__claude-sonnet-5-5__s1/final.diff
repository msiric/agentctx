diff --git a/test_schedule.py b/test_schedule.py
index f497826..6114b54 100644
--- a/test_schedule.py
+++ b/test_schedule.py
@@ -1569,6 +1569,91 @@ class SchedulerTests(TestCase):
         schedule.clear()
         assert len(schedule.jobs) == 0
 
+    def test_get_jobs_for(self):
+        def foo():
+            pass
+
+        def bar(x=None):
+            pass
+
+        class Obj:
+            def method(self):
+                pass
+
+        obj = Obj()
+        scheduler = schedule.Scheduler()
+        j1 = scheduler.every().second.do(foo)
+        j2 = scheduler.every().minute.do(foo)
+        j3 = scheduler.every().second.do(bar, x=1)
+        j4 = scheduler.every().second.do(obj.method)
+
+        assert scheduler.get_jobs_for(foo) == [j1, j2]
+        assert scheduler.get_jobs_for(bar) == [j3]
+        assert scheduler.get_jobs_for(obj.method) == [j4]
+        assert scheduler.get_jobs_for(lambda: None) == []
+
+        scheduler.cancel_job(j1)
+        assert scheduler.get_jobs_for(foo) == [j2]
+
+        assert schedule.Scheduler().get_jobs_for(foo) == []
+
+    def test_pause_and_resume_by_tag(self):
+        scheduler = schedule.Scheduler()
+        paused_mock = make_mock_job(name="paused")
+        other_mock = make_mock_job(name="other")
+        untagged_mock = make_mock_job(name="untagged")
+        scheduler.every().second.do(paused_mock).tag("maint")
+        scheduler.every().second.do(other_mock).tag("other")
+        scheduler.every().second.do(untagged_mock)
+
+        scheduler.pause("maint")
+        with mock_datetime(2100, 1, 1, 0, 0, 0):
+            scheduler.run_pending()
+        assert paused_mock.call_count == 0
+        assert other_mock.call_count == 1
+        assert untagged_mock.call_count == 1
+        assert len(scheduler.jobs) == 3  # pausing does not cancel
+
+        scheduler.resume("maint")
+        with mock_datetime(2100, 1, 1, 0, 0, 5):
+            scheduler.run_pending()
+        assert paused_mock.call_count == 1
+
+    def test_pause_unknown_tag_is_noop(self):
+        scheduler = schedule.Scheduler()
+        mock_job = make_mock_job()
+        scheduler.every().second.do(mock_job)
+        scheduler.pause("nope")
+        scheduler.resume("nope")
+        with mock_datetime(2100, 1, 1, 0, 0, 0):
+            scheduler.run_pending()
+        assert mock_job.call_count == 1
+
+    def test_paused_jobs_ignored_by_next_run(self):
+        scheduler = schedule.Scheduler()
+        scheduler.every().second.do(make_mock_job()).tag("a")
+        scheduler.every().hour.do(make_mock_job()).tag("b")
+        scheduler.pause("a")
+        assert scheduler.get_next_run() == scheduler.get_jobs("b")[0].next_run
+        assert scheduler.get_next_run("a") is None
+        scheduler.pause("b")
+        assert scheduler.get_next_run() is None
+        assert scheduler.idle_seconds is None
+        scheduler.resume("a")
+        assert scheduler.get_next_run() is not None
+
+    def test_module_level_pause_resume(self):
+        mock_job = make_mock_job()
+        every().second.do(mock_job).tag("t")
+        schedule.pause("t")
+        with mock_datetime(2100, 1, 1, 0, 0, 0):
+            schedule.run_pending()
+        assert mock_job.call_count == 0
+        schedule.resume("t")
+        with mock_datetime(2100, 1, 1, 0, 0, 5):
+            schedule.run_pending()
+        assert mock_job.call_count == 1
+
     def test_clear_by_tag(self):
         every().second.do(make_mock_job(name="job1")).tag("tag1")
         every().second.do(make_mock_job(name="job2")).tag("tag1", "tag2")
