+++ b/test_schema.py
@@ -21,6 +21,7 @@ from schema import (
     Const,
     Forbidden,
     Hook,
+    Length,
     Literal,
     Optional,
     Or,
@@ -2100,3 +2101,80 @@ def test_tuple_key_error_message_does_not_crash():
     with raises(SchemaError) as exc_info:
         Schema({("a", "b"): int}).validate({("a", "b"): "not-an-int"})
     assert "Key '('a', 'b')' error:" in exc_info.value.code
+
+
+def test_length_bounds_are_inclusive():
+    assert Length(min=2, max=4).validate("ab") == "ab"
+    assert Length(min=2, max=4).validate("abcd") == "abcd"
+    assert Length(max=0).validate("") == ""
+    with SE:
+        Length(min=2, max=4).validate("a")
+    with SE:
+        Length(min=2, max=4).validate("abcde")
+    assert Length(min=2).validate("a" * 1000) == "a" * 1000
+    assert Length(max=3).validate("") == ""
+
+
+def test_length_counts_utf8_bytes():
+    # "é" is 1 character but 2 bytes
+    assert Length(max=2).validate("é") == "é"
+    with raises(SchemaError) as e:
+        Length(max=3).validate("éé")
+    assert "byte length 4 exceeds maximum of 3 bytes" in e.value.code
+    with SE:
+        Length(min=3).validate("é")
+    assert Length(max=4).validate("😀") == "😀"
+    with SE:
+        Length(max=3).validate("😀")
+
+
+def test_length_bytes_and_other_types():
+    assert Length(max=3).validate(b"abc") == b"abc"
+    with SE:
+        Length(max=2).validate(b"abc")
+    for bad in (1, None, [1, 2], {"a": 1}, ("a",)):
+        with SE:
+            Length(max=10).validate(bad)
+    with SE:
+        Length(max=10).validate("\ud800")  # lone surrogate
+
+
+def test_length_invalid_arguments():
+    for kwargs in (
+        {},
+        {"min": -1},
+        {"max": -1},
+        {"min": True},
+        {"max": 1.5},
+        {"min": "1"},
+        {"min": 5, "max": 4},
+    ):
+        with raises(ValueError):
+            Length(**kwargs)
+
+
+def test_length_message_does_not_echo_data():
+    with raises(SchemaError) as e:
+        Length(max=3).validate("secret-value")
+    assert "secret" not in e.value.code
+
+
+def test_length_in_schema():
+    s = Schema({"name": Length(max=3)})
+    assert s.validate({"name": "abc"}) == {"name": "abc"}
+    with raises(SchemaError) as e:
+        s.validate({"name": "abcd"})
+    assert "Key 'name' error" in e.value.code
+    assert "byte length 4 exceeds maximum of 3 bytes" in e.value.code
+    assert Schema(And(str, Length(min=1, max=3))).validate("ab") == "ab"
+
+
+def test_length_custom_error_overrides_auto_messages():
+    s = Schema({"name": Length(max=3, error="name {!r} too long")})
+    with raises(SchemaError) as e:
+        s.validate({"name": "abcd"})
+    assert e.value.code == "name 'abcd' too long"
+
+
+def test_length_repr():
+    assert repr(Length(min=1, max=2)) == "Length(min=1, max=2)"
