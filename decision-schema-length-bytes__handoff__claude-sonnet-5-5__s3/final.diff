+class Length:
+    """
+    Validate the size of a string, with inclusive bounds.
+
+    Sizes are measured in UTF-8 **bytes**, not characters, so that values fit
+    byte-sized database columns (e.g. Oracle ``VARCHAR2(n BYTE)``). ``bytes``
+    data is taken as already encoded. Anything else is rejected.
+    """
+
+    def __init__(
+        self,
+        min: Union[int, None] = None,
+        max: Union[int, None] = None,
+        error: Union[str, None] = None,
+    ) -> None:
+        if min is None and max is None:
+            raise ValueError("Length needs at least one of min or max")
+        for name, value in (("min", min), ("max", max)):
+            if value is None:
+                continue
+            if isinstance(value, bool) or not isinstance(value, int):
+                raise ValueError(f"Length {name} must be an int, not {value!r}")
+            if value < 0:
+                raise ValueError(f"Length {name} must not be negative, got {value}")
+        if min is not None and max is not None and min > max:
+            raise ValueError(f"Length min ({min}) is greater than max ({max})")
+        self._min: Union[int, None] = min
+        self._max: Union[int, None] = max
+        self._error: Union[str, None] = error
+
+    def __repr__(self) -> str:
+        return f"{self.__class__.__name__}(min={self._min!r}, max={self._max!r})"
+
+    def validate(self, data: Any, **kwargs: Any) -> Any:
+        """
+        Validates the UTF-8 byte length of data.
+        :param data: str or bytes to be validated.
+        :return: Returns validated data.
+        """
+        if isinstance(data, bytes):
+            size = len(data)
+        elif isinstance(data, str):
+            try:
+                size = len(data.encode("utf-8"))
+            except UnicodeEncodeError:
+                self._fail(data, "string cannot be encoded as UTF-8")
+        else:
+            self._fail(data, f"expected str or bytes, got {type(data).__name__}")
+
+        if self._min is not None and size < self._min:
+            self._fail(
+                data, f"byte length {size} is below minimum of {self._min} bytes"
+            )
+        if self._max is not None and size > self._max:
+            self._fail(
+                data, f"byte length {size} exceeds maximum of {self._max} bytes"
+            )
+        return data
+
+    def _fail(self, data: Any, message: str) -> NoReturn:
+        # Like Schema: the auto message goes in autos, a custom error in errors
+        # (where it overrides every auto message). Data is never echoed.
+        raise SchemaError(
+            [message], [self._error.format(data) if self._error else None]
+        )
+
+
 class Use:
     """
     For more general use cases, you can use the Use class to transform
