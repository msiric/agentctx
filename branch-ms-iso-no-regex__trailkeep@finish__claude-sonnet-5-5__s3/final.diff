@@ -242,3 +242,136 @@ function plural(
   const isPlural = msAbs >= n * 1.5;
   return `${Math.round(ms / n)} ${name}${isPlural ? 's' : ''}` as StringValue;
 }
+
+/**
+ * Format the given milliseconds as an ISO 8601 duration, e.g. `PT1H30M`.
+ *
+ * Days are the largest unit used, since months and years are ambiguous.
+ * Values are rounded to the nearest millisecond, zero is `PT0S`, and negative
+ * values are prefixed with `-` (e.g. `-PT1H`).
+ *
+ * @param ms - milliseconds
+ * @returns The ISO 8601 duration string
+ * @throws Error if `ms` is not a finite number
+ */
+export function formatISO(ms: number): string {
+  if (typeof ms !== 'number' || !Number.isFinite(ms)) {
+    throw new Error('Value provided to ms.formatISO() must be of type number.');
+  }
+
+  let rest = Math.round(Math.abs(ms));
+  if (rest === 0) {
+    return 'PT0S';
+  }
+
+  const days = Math.floor(rest / d);
+  rest %= d;
+  const hours = Math.floor(rest / h);
+  rest %= h;
+  const minutes = Math.floor(rest / m);
+  rest %= m;
+  const seconds = Math.floor(rest / s);
+  const millis = rest % s;
+
+  let time = '';
+  if (hours) time += `${hours}H`;
+  if (minutes) time += `${minutes}M`;
+  if (seconds || millis) {
+    const frac = millis
+      ? `.${String(millis).padStart(3, '0').replace(/0+$/, '')}`
+      : '';
+    time += `${seconds}${frac}S`;
+  }
+
+  return `${ms < 0 ? '-' : ''}P${days ? `${days}D` : ''}${time ? `T${time}` : ''}`;
+}
+
+const isDigit = (c: string | undefined): boolean =>
+  c !== undefined && c >= '0' && c <= '9';
+
+/**
+ * Parse an ISO 8601 duration, e.g. `PT1H30M`, and return milliseconds. This is
+ * the inverse of `formatISO`.
+ *
+ * Supports an optional leading `-` or `+`, the designators `Y`, `M`, `W`, `D`
+ * (before `T`) and `H`, `M`, `S` (after `T`), and a decimal fraction (`.` or
+ * `,`) on any component. Years and months use the same average lengths as
+ * `parse`. The result is rounded to the nearest millisecond.
+ *
+ * @param str - The ISO 8601 duration string
+ * @returns The duration in milliseconds
+ * @throws Error if `str` is not a valid ISO 8601 duration
+ */
+export function parseISO(str: string): number {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw new Error(
+      `Value provided to ms.parseISO() must be a string with length between 1 and 99. value=${JSON.stringify(str)}`,
+    );
+  }
+  const invalid = (): never => {
+    throw new Error(
+      `Invalid ISO 8601 duration passed to ms.parseISO(). value=${JSON.stringify(str)}`,
+    );
+  };
+
+  let i = 0;
+  let sign = 1;
+  if (str[i] === '-' || str[i] === '+') {
+    if (str[i] === '-') sign = -1;
+    i++;
+  }
+  if (str[i] !== 'P') return invalid();
+  i++;
+
+  const dateUnits: Record<string, number> = { Y: y, M: mo, W: w, D: d };
+  const timeUnits: Record<string, number> = { H: h, M: m, S: s };
+  let units = dateUnits;
+  let inTime = false;
+  let total = 0;
+  let components = 0;
+  let lastRank = -1;
+
+  while (i < str.length) {
+    if (str[i] === 'T') {
+      if (inTime) return invalid();
+      inTime = true;
+      units = timeUnits;
+      i++;
+      // 'T' must be followed by at least one component.
+      if (i >= str.length) return invalid();
+      continue;
+    }
+
+    const start = i;
+    while (isDigit(str[i])) i++;
+    const intDigits = i - start;
+    let fracDigits = 0;
+    if (str[i] === '.' || str[i] === ',') {
+      i++;
+      const fracStart = i;
+      while (isDigit(str[i])) i++;
+      fracDigits = i - fracStart;
+      if (fracDigits === 0) return invalid();
+    }
+    if (intDigits === 0 && fracDigits === 0) return invalid();
+
+    const value = Number(str.slice(start, i).replace(',', '.'));
+    const designator = str[i];
+    const unit = designator === undefined ? undefined : units[designator];
+    if (unit === undefined || designator === undefined) return invalid();
+    i++;
+
+    // Designators must appear in order (e.g. no `P1D1Y`, no repeats).
+    const rank = inTime
+      ? 'YMWDHMS'.lastIndexOf(designator)
+      : 'YMWDHMS'.indexOf(designator);
+    if (rank <= lastRank) return invalid();
+    lastRank = rank;
+
+    total += value * unit;
+    components++;
+  }
+
+  if (components === 0) return invalid();
+  return sign * Math.round(total);
+}
