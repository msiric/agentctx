index 0000000..d484be3
--- /dev/null
+++ b/src/parse-iso.test.ts
@@ -0,0 +1,83 @@
+import { describe, expect, it } from '@jest/globals';
+import { formatISO, parseISO } from './index';
+
+describe('parseISO(string)', () => {
+  it('should parse hours and minutes', () => {
+    expect(parseISO('PT1H30M')).toBe(5400000);
+  });
+
+  it('should parse days, hours, minutes and seconds', () => {
+    expect(parseISO('P1DT1H1M1S')).toBe(90061000);
+  });
+
+  it('should parse zero', () => {
+    expect(parseISO('PT0S')).toBe(0);
+  });
+
+  it('should parse days and weeks', () => {
+    expect(parseISO('P1D')).toBe(86400000);
+    expect(parseISO('P2W')).toBe(14 * 86400000);
+  });
+
+  it('should treat M as months before T and minutes after', () => {
+    expect(parseISO('PT5M')).toBe(300000);
+    expect(parseISO('P1M')).toBe((365.25 * 86400000) / 12);
+  });
+
+  it('should parse fractional seconds', () => {
+    expect(parseISO('PT1.5S')).toBe(1500);
+    expect(parseISO('PT0,25S')).toBe(250);
+    expect(parseISO('PT0.0005S')).toBe(1);
+  });
+
+  it('should parse signs', () => {
+    expect(parseISO('-PT1H')).toBe(-3600000);
+    expect(parseISO('+PT1H')).toBe(3600000);
+  });
+
+  it('should round-trip with formatISO', () => {
+    for (const v of [
+      0,
+      1,
+      999,
+      1500,
+      5400000,
+      90061001,
+      -7200000,
+      400 * 86400000,
+    ]) {
+      expect(parseISO(formatISO(v))).toBe(v);
+    }
+  });
+
+  it('should throw on invalid input', () => {
+    for (const bad of [
+      '',
+      'P',
+      'PT',
+      'PT1',
+      'PT1X',
+      '1H',
+      'T1H',
+      'P1H',
+      'PT1D',
+      'P1D1Y',
+      'PT1H1H',
+      'PT1M1H',
+      'P1DT',
+      'PTT1H',
+      'PT.S',
+      'PT1.S',
+      'PT-1H',
+      'P 1D',
+      'pt1h',
+    ]) {
+      expect(() => parseISO(bad)).toThrow();
+    }
+  });
+
+  it('should throw on non-string or overlong input', () => {
+    expect(() => parseISO(undefined as unknown as string)).toThrow();
+    expect(() => parseISO(`PT${'1'.repeat(200)}S`)).toThrow();
+  });
+});
