+import { describe, expect, it } from '@jest/globals';
+import { parseClock } from './index';
+
+describe('parseClock(string)', () => {
+  it('should parse m:ss', () => {
+    expect(parseClock('1:30')).toBe(90000);
+    expect(parseClock('0:05')).toBe(5000);
+    expect(parseClock('0:00')).toBe(0);
+  });
+
+  it('should allow minutes of 60 or more in m:ss', () => {
+    expect(parseClock('90:00')).toBe(5400000);
+  });
+
+  it('should parse h:mm:ss', () => {
+    expect(parseClock('01:02:03')).toBe(3723000);
+    expect(parseClock('1:00:00')).toBe(3600000);
+    expect(parseClock('100:59:59')).toBe(100 * 3600000 + 59 * 60000 + 59000);
+  });
+
+  it('should throw when seconds or minutes are out of range', () => {
+    expect(() => parseClock('1:60')).toThrow(TypeError);
+    expect(() => parseClock('1:60:00')).toThrow(TypeError);
+    expect(() => parseClock('1:00:60')).toThrow(TypeError);
+  });
+
+  it('should throw on malformed input', () => {
+    for (const bad of [
+      '',
+      '1',
+      '1:3',
+      '1:030',
+      ':30',
+      '1:',
+      '1:2:3',
+      '1:30:',
+      'a:bc',
+      '1:30 ',
+      '-1:30',
+      '1:30:00:00',
+    ]) {
+      expect(() => parseClock(bad)).toThrow(TypeError);
+    }
+  });
+
+  it('should throw on non-string input', () => {
+    // @ts-expect-error testing runtime behavior
+    expect(() => parseClock(90)).toThrow(TypeError);
+    // @ts-expect-error testing runtime behavior
+    expect(() => parseClock(undefined)).toThrow(TypeError);
+  });
+
+  it('should include the input in the error message', () => {
+    expect(() => parseClock('nope')).toThrow('value="nope"');
+  });
+});
