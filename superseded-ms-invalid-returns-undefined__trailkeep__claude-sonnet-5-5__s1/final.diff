+/**
+ * Parse a compound duration such as `"1h 30m"`, `"1h, 30m"` or `"2 days 4 hours"` and
+ * return the total in milliseconds. Each piece is parsed with `parse`.
+ *
+ * @param str - A compound duration string
+ * @returns The total in milliseconds (never `NaN`)
+ * @throws TypeError if `str` is not a valid compound duration (including the
+ * input in the message). When more than one piece is given, every piece must
+ * have a unit.
+ */
+export function parseCompound(str: string): number {
+  const invalid = (reason: string) =>
+    new TypeError(
+      `Invalid value provided to ms.parseCompound(): ${reason}. value=${JSON.stringify(str)}`,
+    );
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw invalid('must be a string with length between 1 and 99');
+  }
+  const piece = /\s*(-?\d*\.?\d+)\s*([a-z]*)\s*(,?)\s*/iy;
+  const pieces: string[] = [];
+  let end = 0;
+  while (end < str.length) {
+    piece.lastIndex = end;
+    const match = piece.exec(str);
+    if (!match) {
+      throw invalid('expected a number followed by a unit');
+    }
+    // Reject a bare number mixed with other pieces, e.g. "1h 30".
+    if (
+      match[2] === '' &&
+      (pieces.length > 0 || piece.lastIndex < str.length)
+    ) {
+      throw invalid('every piece of a compound duration needs a unit');
+    }
+    // A comma may separate pieces, but cannot trail the last one.
+    if (match[3] && piece.lastIndex >= str.length) {
+      throw invalid('unexpected trailing comma');
+    }
+    pieces.push(`${match[1]}${match[2]}`);
+    end = piece.lastIndex;
+  }
+  let total = 0;
+  for (const p of pieces) {
+    const value = parse(p);
+    if (Number.isNaN(value)) {
+      throw invalid(`unknown unit in "${p}"`);
+    }
+    total += value;
+  }
+  return total;
+}
+
+/**
+ * Parse a timer-style clock string and return milliseconds. `"m:ss"` (e.g.
+ * `"1:30"`) and `"h:mm:ss"` (e.g. `"01:02:03"`) are supported.
+ *
+ * @param str - A clock string
+ * @returns The total in milliseconds
+ * @throws TypeError if `str` is not a valid clock string. Seconds must be
+ * two digits and below 60; in `h:mm:ss`, minutes must be two digits and below 60.
+ */
+export function parseClock(str: string): number {
+  const invalid = (reason: string) =>
+    new TypeError(
+      `Invalid value provided to ms.parseClock(): ${reason}. value=${JSON.stringify(str)}`,
+    );
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw invalid('must be a string with length between 1 and 99');
+  }
+  const match = /^(?:(\d+):(\d{2})|(\d+):(\d{2}):(\d{2}))$/.exec(str);
+  if (!match) {
+    throw invalid('expected "m:ss" or "h:mm:ss"');
+  }
+  const [hours, minutes, seconds] = match[3]
+    ? [Number(match[3]), Number(match[4]), Number(match[5])]
+    : [0, Number(match[1]), Number(match[2])];
+  if (seconds >= 60 || (match[3] && minutes >= 60)) {
+    throw invalid('minutes and seconds must be below 60');
+  }
+  return hours * h + minutes * m + seconds * s;
+}
