+import { describe, expect, it } from '@jest/globals';
+import { parseCompound } from './index';
+
+describe('parseCompound(string)', () => {
+  it('should sum compact pieces', () => {
+    expect(parseCompound('1h 30m')).toBe(5400000);
+  });
+
+  it('should sum long-form pieces with spaces', () => {
+    expect(parseCompound('2 days 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
+  });
+
+  it('should handle pieces without separators', () => {
+    expect(parseCompound('1h30m')).toBe(5400000);
+  });
+
+  it('should accept commas between pieces', () => {
+    expect(parseCompound('1h, 30m')).toBe(5400000);
+    expect(parseCompound('1h,30m')).toBe(5400000);
+    expect(parseCompound('2 days, 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
+  });
+
+  it('should handle a single piece like parse', () => {
+    expect(parseCompound('1m')).toBe(60000);
+    expect(parseCompound('100')).toBe(100);
+  });
+
+  it('should handle decimals and negatives', () => {
+    expect(parseCompound('1.5h 30m')).toBe(7200000);
+    expect(parseCompound('1h -30m')).toBe(1800000);
+  });
+
+  it('should be case-insensitive and trim whitespace', () => {
+    expect(parseCompound('  1H 30M ')).toBe(5400000);
+  });
+
+  it('should throw a TypeError including the input for invalid input', () => {
+    for (const input of ['abc', '1h foo', '1h 30', '1h 30x', '   ', '', '1h,', ',1h', '1h,,30m', '1,5h']) {
+      expect(() => parseCompound(input)).toThrow(TypeError);
+      expect(() => parseCompound(input)).toThrow(JSON.stringify(input));
+    }
+  });
+
+  it('should throw a TypeError for non-string or too long input', () => {
+    expect(() => parseCompound('1h '.repeat(40))).toThrow(TypeError);
+    // @ts-expect-error testing runtime validation
+    expect(() => parseCompound(1)).toThrow(TypeError);
+  });
+});
