diff --git a/test_schedule.py b/test_schedule.py
index f497826..4c8875e 100644
--- a/test_schedule.py
+++ b/test_schedule.py
@@ -1597,3 +1597,27 @@ class SchedulerTests(TestCase):
         scheduler.every()
         scheduler.every(10).seconds
         scheduler.run_pending()
+
+
+class FailingJobTest(TestCase):
+    def test_run_pending_runs_all_then_raises_first_error(self):
+        calls = []
+
+        def boom(n):
+            calls.append(n)
+            raise ValueError(n)
+
+        def ok():
+            calls.append("ok")
+
+        s = schedule.Scheduler()
+        s.every().second.do(boom, 1)
+        s.every().second.do(ok)
+        s.every().second.do(boom, 2)
+        with mock_datetime(2100, 1, 1, 0, 0, 5):
+            with self.assertRaises(ValueError) as cm:
+                s.run_pending()
+        self.assertEqual(cm.exception.args, (1,))
+        self.assertEqual(sorted(map(str, calls)), ["1", "2", "ok"])
+        # failed jobs were rescheduled, not left due
+        self.assertTrue(all(j.last_run is not None for j in s.jobs))
