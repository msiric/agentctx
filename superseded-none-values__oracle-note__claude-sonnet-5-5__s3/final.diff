diff --git a/tests/test_valid.py b/tests/test_valid.py
index 5413ac9..278009c 100644
--- a/tests/test_valid.py
+++ b/tests/test_valid.py
@@ -58,3 +58,71 @@ def replace_nans(cont: dict | list) -> dict | list:
 )
 def test_obj_to_str_mapping(obj, expected_str, multiline_strings):
     assert tomli_w.dumps(obj, multiline_strings=multiline_strings) == expected_str
+
+
+def test_none_values_written_as_empty_string():
+    obj = {
+        "a": 1,
+        "b": None,
+        "t": {"x": None, "y": 2},
+        "only_none": {"z": None},
+        "aot": [{"k": None, "v": 1}, {"k": None}],
+        "arr_of_inline": [{"k": None, "v": 1}],
+        "nested_inline": [[{"k": None, "v": 1}]],
+    }
+    out = tomli_w.dumps(obj)
+    assert tomli.loads(out) == {
+        "a": 1,
+        "b": "",
+        "t": {"x": "", "y": 2},
+        "only_none": {"z": ""},
+        "aot": [{"k": "", "v": 1}, {"k": ""}],
+        "arr_of_inline": [{"k": "", "v": 1}],
+        "nested_inline": [[{"k": "", "v": 1}]],
+    }
+
+
+def test_none_in_array():
+    assert tomli_w.dumps({"a": [1, None]}) == 'a = [\n    1,\n    "",\n]\n'
+    assert tomli.loads(tomli_w.dumps({"a": [None, [None], (None,)]})) == {
+        "a": ["", [""], [""]]
+    }
+
+
+def test_none_in_inline_table():
+    out = tomli_w.dumps({"a": [[{"x": None}]]})
+    assert out == 'a = [\n    [\n        { x = "" },\n    ],\n]\n'
+
+
+def test_none_in_dump():
+    import io
+
+    buf = io.BytesIO()
+    tomli_w.dump({"a": None, "b": 1}, buf)
+    assert buf.getvalue() == b'a = ""\nb = 1\n'
+
+
+def test_pathlib_paths():
+    import pathlib
+
+    obj = {
+        "p": pathlib.PurePosixPath("/usr/local/bin"),
+        "rel": pathlib.Path("a/b.txt"),
+        "list": [pathlib.PurePosixPath("x"), pathlib.PurePosixPath("y z")],
+        "t": {"q": pathlib.PurePosixPath('we"ird\\name')},
+    }
+    out = tomli_w.dumps(obj)
+    assert out.startswith('p = "/usr/local/bin"\n')
+    assert tomli.loads(out) == {
+        "p": "/usr/local/bin",
+        "rel": str(pathlib.Path("a/b.txt")),
+        "list": ["x", "y z"],
+        "t": {"q": 'we"ird\\name'},
+    }
+
+
+def test_pathlib_windows_path():
+    import pathlib
+
+    out = tomli_w.dumps({"p": pathlib.PureWindowsPath("C:/a/b")})
+    assert tomli.loads(out) == {"p": "C:\\a\\b"}
