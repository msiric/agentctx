@@ -216,3 +216,30 @@ export default function prettyBytes(
 	number: number | bigint,
 	options?: Options
 ): string;
+
+/**
+Parse a human readable binary size string into a number of bytes. The reverse of `prettyBytes(number, {binary: true})`.
+
+Accepts a plain number (`'512'`), or a number followed by `B` or a unit: `KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`, `ZiB`, `YiB`, or the same without the `i` (`kB`/`KB`, `MB`, `GB`, `TB`, `PB`, `EB`, `ZB`, `YB`). The number may be fractional and may be separated from the unit by whitespace. Units are case-sensitive.
+
+Units without the `i` are treated as powers of 1024 (`'1 kB'` is `1024`, `'1 MB'` is `1048576`), matching what Windows Explorer shows. Note that this differs from `prettyBytes`, which uses powers of 1000 for them.
+
+The result is not rounded, so `'0.5 B'` is `0.5`. Values above `Number.MAX_SAFE_INTEGER` bytes are not exact.
+
+@throws A `TypeError` if the input is not a string, and a `SyntaxError` if it cannot be parsed or has an unsupported unit.
+
+@example
+```
+import {parseBytes} from 'pretty-bytes';
+
+parseBytes('512');
+//=> 512
+
+parseBytes('1.5 KiB');
+//=> 1536
+
+parseBytes('1 MB');
+//=> 1048576
+```
+*/
+export function parseBytes(string: string): number;
diff --git a/index.js b/index.js
index c5f37ab..e08a007 100644
--- a/index.js
+++ b/index.js
@@ -285,3 +285,35 @@ export default function prettyBytes(number, options) {
 	const result = prefix + numberString + separator + UNITS[exponent];
 	return result.padStart(options.fixedWidth ?? 0);
 }
+
+// Units without the `i` (`kB`, `KB`, `MB`, ...) are read as powers of 1024, like Windows Explorer shows them. This intentionally differs from `prettyBytes`, which uses powers of 1000 for them.
+const PARSE_MULTIPLIERS = new Map([
+	...BIBYTE_UNITS.map((unit, index) => [unit, 1024 ** index]),
+	...BYTE_UNITS.map((unit, index) => [unit, 1024 ** index]),
+	['KB', 1024],
+]);
+
+const PARSE_PATTERN = /^(?<sign>[+-]?)(?<value>\d+(?:\.\d+)?|\.\d+)\s*(?<unit>[A-Za-z]+)?$/;
+
+export function parseBytes(string) {
+	if (typeof string !== 'string') {
+		throw new TypeError(`Expected a string, got ${typeof string}`);
+	}
+
+	const match = PARSE_PATTERN.exec(string.trim());
+
+	if (!match) {
+		throw new SyntaxError(`Cannot parse bytes from: ${JSON.stringify(string)}`);
+	}
+
+	const {sign, value, unit = 'B'} = match.groups;
+	const multiplier = PARSE_MULTIPLIERS.get(unit);
+
+	if (multiplier === undefined) {
+		throw new SyntaxError(`Unsupported unit ${JSON.stringify(unit)}, expected one of: ${[...PARSE_MULTIPLIERS.keys()].join(', ')}`);
+	}
+
+	const bytes = Number(value) * multiplier;
+
+	return sign === '-' && bytes !== 0 ? -bytes : bytes;
+}
