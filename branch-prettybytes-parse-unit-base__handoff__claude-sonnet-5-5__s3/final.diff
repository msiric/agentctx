+
+test('parseBytes - plain numbers and bytes', t => {
+	t.is(parseBytes('512'), 512);
+	t.is(parseBytes('512 B'), 512);
+	t.is(parseBytes('512B'), 512);
+	t.is(parseBytes('0'), 0);
+	t.is(parseBytes('  42 B  '), 42);
+});
+
+test('parseBytes - binary units', t => {
+	for (const [index, unit] of BINARY_UNITS.entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1024 ** index);
+		t.is(parseBytes(`2${unit}`), 2 * (1024 ** index));
+	}
+});
+
+test('parseBytes - fractions', t => {
+	t.is(parseBytes('1.5 KiB'), 1536);
+	t.is(parseBytes('.5 KiB'), 512);
+	t.is(parseBytes('0.5 B'), 0.5);
+});
+
+test('parseBytes - whitespace and signs', t => {
+	t.is(parseBytes('1 KiB'), 1024);
+	t.is(parseBytes('1 \t KiB'), 1024);
+	t.is(parseBytes('-1 KiB'), -1024);
+	t.is(parseBytes('+1 KiB'), 1024);
+	t.true(Object.is(parseBytes('-0'), 0));
+});
+
+test('parseBytes - round trips prettyBytes binary output', t => {
+	for (const bytes of [0, 1, 512, 1024, 1536, 10_240, 1024 ** 3]) {
+		t.is(parseBytes(prettyBytes(bytes, {binary: true})), bytes);
+	}
+});
+
+test('parseBytes - units are case-sensitive', t => {
+	for (const input of ['1 kib', '1 KIB', '1 kiB', '1 b', '1 Kib']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError});
+	}
+});
+
+test('parseBytes - units without the i are powers of 1024', t => {
+	for (const [index, unit] of DECIMAL_UNITS.entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1024 ** index);
+		t.is(parseBytes(`1.5${unit}`), 1.5 * (1024 ** index));
+	}
+
+	t.is(parseBytes('1 KB'), 1024);
+	t.is(parseBytes('1 kB'), 1024);
+	t.is(parseBytes('1 MB'), 1_048_576);
+});
+
+test('parseBytes - rejects incomplete or misspelled units', t => {
+	for (const unit of ['K', 'Ki', 'kb', 'mB', 'Mb', 'gb', 'KIB']) {
+		t.throws(() => parseBytes(`1 ${unit}`), {instanceOf: SyntaxError, message: /Unsupported unit/});
+	}
+});
+
+test('parseBytes - rejects malformed input', t => {
+	for (const input of ['', ' ', 'KiB', '1.', '1.2.3', '1e3', '1,5 KiB', '--1', '1 2 KiB', 'Infinity', 'NaN', '0x10']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError});
+	}
+});
+
+test('parseBytes - rejects non-strings', t => {
+	for (const input of [512, undefined, null, 1n, {}]) {
+		t.throws(() => parseBytes(input), {instanceOf: TypeError});
+	}
+});
