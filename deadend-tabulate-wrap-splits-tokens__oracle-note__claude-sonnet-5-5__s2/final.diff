     )
     # output should still be produced (graceful fallback), with raw keys as headers
     assert out.strip() != ""
+
+
+def test_inprocess_wrap_option():
+    """In-process: --wrap breaks only at whitespace, keeps long tokens whole"""
+    data = 'id,msg\nTICKET-12345-ABCDEF,"see https://x.io/a/long/url now ok"\n'
+    out = run_main_in_process(["-r", "csv", "-1", "--wrap", "10"], input_text=data)
+    lines = out.splitlines()
+    assert "TICKET-12345-ABCDEF" in lines[2]
+    assert any("https://x.io/a/long/url" in line for line in lines)
+    assert len(lines) > 3
+
+
+def test_inprocess_wrap_invalid():
+    """In-process: --wrap needs a positive integer"""
+    import pytest
+
+    for bad in ["0", "x"]:
+        with pytest.raises(SystemExit) as exc_info:
+            run_main_in_process(["--wrap", bad], input_text="a b\n")
+        assert exc_info.value.code == 2
