@@ -285,3 +285,102 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def test_json_write_crash_before_replace_keeps_old_state(tmpdir, monkeypatch):
+    path = str(tmpdir.join('db.json'))
+
+    db = TinyDB(path)
+    db.insert({'a': 1})
+
+    def crash(*args, **kwargs):
+        raise KeyboardInterrupt('simulated kill')
+
+    monkeypatch.setattr(os, 'replace', crash)
+    with pytest.raises(KeyboardInterrupt):
+        db.insert({'a': 2})
+    monkeypatch.undo()
+
+    # Database file is intact and no temp files are left behind
+    assert os.listdir(str(tmpdir)) == ['db.json']
+    with TinyDB(path) as db2:
+        assert db2.all() == [{'a': 1}]
+
+
+def test_json_write_crash_during_write_keeps_old_state(tmpdir, monkeypatch):
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+
+    # Simulate a kill mid-write: fsync of the temp file never completes
+    def crash(fd):
+        raise MemoryError('simulated OOM')
+
+    db = TinyDB(path)
+    monkeypatch.setattr(os, 'fsync', crash)
+    with pytest.raises(MemoryError):
+        db.insert({'a': 2})
+    monkeypatch.undo()
+
+    with TinyDB(path) as db2:
+        assert db2.all() == [{'a': 1}]
+
+
+def test_json_stale_temp_file_is_ignored(tmpdir):
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+
+    # Leftover from a process that was killed mid-write
+    with open(str(tmpdir.join('db.json.abc.tmp')), 'w') as f:
+        f.write('{"_default": {"1": {"a"')
+
+    with TinyDB(path) as db:
+        assert db.all() == [{'a': 1}]
+        db.insert({'a': 2})
+        assert len(db) == 2
+
+
+def test_json_serialization_error_keeps_old_state(tmpdir):
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+        with pytest.raises(TypeError):
+            db.insert({'a': object()})
+
+    with TinyDB(path) as db:
+        assert db.all() == [{'a': 1}]
+    assert os.listdir(str(tmpdir)) == ['db.json']
+
+
+def test_json_write_keeps_permissions_and_symlink(tmpdir):
+    real = tmpdir.mkdir('real').join('db.json')
+    link = tmpdir.join('link.json')
+    real.write('')
+    os.chmod(str(real), 0o600)
+    os.symlink(str(real), str(link))
+
+    with TinyDB(str(link)) as db:
+        db.insert({'a': 1})
+        db.insert({'a': 2})
+
+    assert os.path.islink(str(link))
+    assert os.stat(str(real)).st_mode & 0o777 == 0o600
+    with TinyDB(str(real)) as db:
+        assert len(db) == 2
+
+
+def test_json_many_writes_shrinking_file(tmpdir):
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path) as db:
+        for i in range(20):
+            db.insert({'i': i, 'pad': 'x' * 100})
+        db.truncate()
+        db.insert({'i': 0})
+
+    with open(path) as f:
+        json.load(f)
