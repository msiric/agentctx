diff --git a/test/test_cli.py b/test/test_cli.py
index 154f1a2..05396aa 100644
--- a/test/test_cli.py
+++ b/test/test_cli.py
@@ -483,3 +483,23 @@ def test_inprocess_jsonl_malformed_headers():
     )
     # output should still be produced (graceful fallback), with raw keys as headers
     assert out.strip() != ""
+
+
+def test_inprocess_wrap_option():
+    """In-process: --wrap wraps at whitespace, never splitting long words"""
+    text = "id,note\nTICKET-12345,hello brave new world http://example.com/a-b-c\n"
+    out = run_main_in_process(["-r", "csv", "--headers", "firstrow", "--wrap", "10"], input_text=text)
+    assert "TICKET-12345" in out
+    assert "http://example.com/a-b-c" in out
+    assert "hello" in out and "hello brave" not in out
+
+
+def test_inprocess_wrap_invalid():
+    """In-process: --wrap needs a positive integer (exit 2)"""
+    for bad in ["0", "-3", "abc"]:
+        try:
+            run_main_in_process(["--wrap", bad], input_text="a b\n")
+        except SystemExit as e:
+            assert_equal(e.code, 2)
+        else:
+            raise AssertionError("expected SystemExit")
