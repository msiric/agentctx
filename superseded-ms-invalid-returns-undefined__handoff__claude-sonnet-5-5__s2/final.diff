@@ -242,3 +242,68 @@ function plural(
   const isPlural = msAbs >= n * 1.5;
   return `${Math.round(ms / n)} ${name}${isPlural ? 's' : ''}` as StringValue;
 }
+
+/**
+ * Parse a compound duration such as `"1h 30m"`, `"1h, 30m"` or `"2 days 4 hours"` and
+ * return the total in milliseconds. Each piece is parsed with `parse`, so
+ * the same units are supported. A single value (e.g. `"1h"` or `"100"`) is
+ * also accepted. When there are multiple pieces, every piece needs a unit.
+ *
+ * @param str - A compound duration string
+ * @returns The total in milliseconds (never `NaN`)
+ * @throws TypeError if `str` is not a valid duration string
+ */
+export function parseCompound(str: string): number {
+  const invalid = () =>
+    new TypeError(
+      `Value provided to ms.parseCompound() must be a valid duration string of length 1 to 99. value=${JSON.stringify(str)}`,
+    );
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw invalid();
+  }
+  const input = str.trim();
+  if (input.length === 0) {
+    throw invalid();
+  }
+  const pieceRe = '-?\\d*\\.?\\d+ *[a-z]+';
+  const compound = new RegExp(
+    `^${pieceRe}(?:\\s*,?\\s*${pieceRe})*$`,
+    'i',
+  ).test(input);
+  const pieces = compound
+    ? (input.match(/-?\d*\.?\d+ *[a-z]+/gi) as string[])
+    : [input];
+  const total = pieces.reduce((sum, piece) => sum + parse(piece), 0);
+  if (Number.isNaN(total)) {
+    throw invalid();
+  }
+  return total;
+}
+
+/**
+ * Parse a timer-style clock string and return the total in milliseconds.
+ * `"m:ss"` (e.g. `"1:30"`) and `"h:mm:ss"` (e.g. `"01:02:03"`) are supported.
+ * Seconds (and minutes, when hours are present) must be two digits, `00`-`59`.
+ * In `"m:ss"` the minutes may exceed 59 (e.g. `"90:00"`).
+ *
+ * Unlike `parseCompound`, bad input returns `undefined` instead of throwing.
+ *
+ * @param str - A clock string
+ * @returns The total in milliseconds, or `undefined` if `str` is not a valid clock string
+ */
+export function parseClock(str: string): number | undefined {
+  if (typeof str !== 'string') {
+    return undefined;
+  }
+  const hms = /^(\d{1,6}):([0-5]\d):([0-5]\d)$/.exec(str);
+  if (hms) {
+    return (
+      (Number(hms[1]) * 3600 + Number(hms[2]) * 60 + Number(hms[3])) * 1000
+    );
+  }
+  const ms = /^(\d{1,6}):([0-5]\d)$/.exec(str);
+  if (ms) {
+    return (Number(ms[1]) * 60 + Number(ms[2])) * 1000;
+  }
+  return undefined;
+}
