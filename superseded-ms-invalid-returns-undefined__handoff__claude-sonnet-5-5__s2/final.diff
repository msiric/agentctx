+++ b/src/parse-compound.test.ts
@@ -0,0 +1,61 @@
+import { describe, expect, it } from '@jest/globals';
+import { parseCompound } from './index';
+
+describe('parseCompound(string)', () => {
+  it('should parse compact pieces', () => {
+    expect(parseCompound('1h 30m')).toBe(5400000);
+  });
+
+  it('should parse long pieces with spaces', () => {
+    expect(parseCompound('2 days 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
+  });
+
+  it('should parse pieces without separators', () => {
+    expect(parseCompound('1h30m')).toBe(5400000);
+  });
+
+  it('should accept commas between pieces', () => {
+    expect(parseCompound('1h, 30m')).toBe(5400000);
+    expect(parseCompound('1h,30m')).toBe(5400000);
+    expect(parseCompound('2 days , 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
+  });
+
+  it('should be case insensitive', () => {
+    expect(parseCompound('1H 30M')).toBe(5400000);
+  });
+
+  it('should handle decimals', () => {
+    expect(parseCompound('1.5h 30s')).toBe(5430000);
+  });
+
+  it('should handle a single value like parse', () => {
+    expect(parseCompound('1m')).toBe(60000);
+    expect(parseCompound('100')).toBe(100);
+  });
+
+  it('should tolerate surrounding whitespace', () => {
+    expect(parseCompound('  1h 30m ')).toBe(5400000);
+  });
+
+  it('should throw a TypeError including the input for invalid strings', () => {
+    for (const bad of [
+      'abc',
+      '1h foo',
+      '1h 30',
+      '1x 2y',
+      '   ',
+      '1h,',
+      ',1h',
+      '1h,,30m',
+    ]) {
+      expect(() => parseCompound(bad)).toThrow(TypeError);
+      expect(() => parseCompound(bad)).toThrow(JSON.stringify(bad));
+    }
+  });
+
+  it('should throw a TypeError for non-strings, empty and overlong strings', () => {
+    expect(() => parseCompound('')).toThrow(TypeError);
+    expect(() => parseCompound(1 as unknown as string)).toThrow(TypeError);
+    expect(() => parseCompound('1h '.repeat(40))).toThrow(TypeError);
+  });
+});
