@@ -483,3 +483,22 @@ def test_inprocess_jsonl_malformed_headers():
     )
     # output should still be produced (graceful fallback), with raw keys as headers
     assert out.strip() != ""
+
+
+def test_inprocess_wrap_option():
+    """In-process: --wrap wraps long cells without splitting tokens"""
+    text = "id,notes\nSUPPORT-2024-118233,one two three four five six\n"
+    out = run_main_in_process(["-r", "csv", "-1", "--wrap", "10"], input_text=text)
+    assert "SUPPORT-2024-118233" in out
+    assert "one two" in out and "three four" in out
+    assert max(len(l) for l in out.splitlines()[2:]) <= 19 + 2 + 10
+
+
+def test_inprocess_wrap_invalid():
+    """In-process: --wrap with a non-positive/non-integer value exits with code 2"""
+    import pytest
+
+    for bad in ["0", "-3", "abc"]:
+        with pytest.raises(SystemExit) as exc_info:
+            run_main_in_process(["--wrap", bad], input_text="a b\n")
+        assert exc_info.value.code == 2
