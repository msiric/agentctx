+test('onRetry runs only when another attempt follows', async () => {
+	const order = [];
+	const contexts = [];
+	let calls = 0;
+	const failure = new Error('fail');
+
+	await assert.rejects(pRetry(async () => {
+		calls++;
+		throw failure;
+	}, {
+		retries: 2,
+		minTimeout: 0,
+		onFailedAttempt() {
+			order.push('onFailedAttempt');
+		},
+		shouldRetry() {
+			order.push('shouldRetry');
+			return true;
+		},
+		async onRetry(context) {
+			order.push('onRetry');
+			contexts.push(context);
+		},
+	}), rejectsWith(failure));
+
+	assert.equal(calls, 3);
+	assert.deepEqual(order, [
+		'onFailedAttempt',
+		'shouldRetry',
+		'onRetry',
+		'onFailedAttempt',
+		'shouldRetry',
+		'onRetry',
+		'onFailedAttempt',
+	]);
+	assert.deepEqual(contexts.map(({attemptNumber}) => attemptNumber), [1, 2]);
+	assert.ok(Object.isFrozen(contexts[0]));
+});
+
+test('onRetry is not called when no retry follows', async () => {
+	let count = 0;
+	const onRetry = () => {
+		count++;
+	};
+
+	await assert.rejects(pRetry(async () => {
+		throw new Error('fail');
+	}, {retries: 0, onRetry}), {message: 'fail'});
+
+	await assert.rejects(pRetry(async () => {
+		throw new Error('fail');
+	}, {
+		retries: 3, minTimeout: 0, shouldRetry: () => false, onRetry,
+	}), {message: 'fail'});
+
+	await assert.rejects(pRetry(async () => {
+		throw new TypeError('nope');
+	}, {retries: 3, minTimeout: 0, onRetry}), TypeError);
+
+	await assert.rejects(pRetry(async () => {
+		throw new AbortError('stop');
+	}, {retries: 3, minTimeout: 0, onRetry}), {message: 'stop'});
+
+	assert.equal(count, 0);
+});
+
+test('onRetry is called when shouldConsumeRetry returns false', async () => {
+	let calls = 0;
+	let count = 0;
+
+	await pRetry(async () => {
+		calls++;
+		if (calls < 3) {
+			throw new Error('fail');
+		}
+	}, {
+		retries: 1,
+		minTimeout: 0,
+		shouldConsumeRetry: () => false,
+		onRetry() {
+			count++;
+		},
+	});
+
+	assert.equal(count, 2);
+});
+
+test('onRetry throwing or rejecting aborts the retries', async () => {
+	const thrown = new Error('from onRetry');
+
+	const callbacks = [
+		() => {
+			throw thrown;
+		},
+		async () => {
+			throw thrown;
+		},
+	];
+
+	for (const onRetry of callbacks) {
+		let calls = 0;
+		await assert.rejects(pRetry(async () => {
+			calls++;
+			throw new Error('fail');
+		}, {retries: 5, minTimeout: 0, onRetry}), rejectsWith(thrown));
+		assert.equal(calls, 1);
+	}
+});
+
+test('onRetry that aborts the signal prevents the next attempt', async () => {
+	const controller = new AbortController();
+	let calls = 0;
+
+	await assert.rejects(pRetry(async () => {
+		calls++;
+		throw new Error('fail');
+	}, {
+		retries: 5,
+		minTimeout: 0,
+		signal: controller.signal,
+		onRetry() {
+			controller.abort();
+		},
+	}), {name: 'AbortError'});
+
+	assert.equal(calls, 1);
+});
+
+test('initialDelay waits before the first attempt', async t => {
+	await withFakeTime(t);
+	const start = performance.now();
+	let firstAttemptAt;
+
+	await pRetry(async () => {
+		firstAttemptAt = performance.now() - start;
+	}, {initialDelay: 500});
+
+	assert.ok(firstAttemptAt >= 500);
+});
+
+test('initialDelay defaults to no wait', async () => {
+	let calls = 0;
+	await pRetry(async () => {
+		calls++;
+	});
+	assert.equal(calls, 1);
+});
+
+test('initialDelay rejects with the abort reason when aborted during the wait', async () => {
+	const controller = new AbortController();
+	const reason = new Error('stop');
+	let calls = 0;
+
+	const promise = pRetry(async () => {
+		calls++;
+	}, {initialDelay: 10_000, signal: controller.signal});
+
+	setTimeout(() => {
+		controller.abort(reason);
+	}, 10);
+
+	await assert.rejects(promise, rejectsWith(reason));
+	assert.equal(calls, 0);
+});
+
+test('throws on invalid initialDelay', async () => {
