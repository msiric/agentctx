test('maxUnit caps the unit', t => {
	t.is(prettyBytes(2e12, {maxUnit: 'GB'}), '2000 GB');
	t.is(prettyBytes(2e12, {maxUnit: 'TB'}), '2 TB');
	t.is(prettyBytes(2e12, {maxUnit: 'YB'}), '2 TB');
	t.is(prettyBytes(1500, {maxUnit: 'B'}), '1500 B');
	t.is(prettyBytes(-2e12, {maxUnit: 'GB'}), '-2000 GB');
	t.is(prettyBytes(2e12, {maxUnit: 'GB', locale: 'de', minimumFractionDigits: 1}), '2000,0 GB');
	t.is(prettyBytes(999_999_999, {maxUnit: 'MB'}), '1000 MB');
	t.is(prettyBytes(999_999_999, {maxUnit: 'kB'}), '1000000 kB');
	t.is(prettyBytes(2n * 10n ** 12n, {maxUnit: 'GB'}), '2000 GB');
	t.is(prettyBytes(10n ** 30n, {maxUnit: 'MB'}), `1${'0'.repeat(24)} MB`);
});

test('maxUnit uses the unit names of the selected system', t => {
	t.is(prettyBytes(2 * (1024 ** 4), {binary: true, maxUnit: 'GiB'}), '2048 GiB');
	t.is(prettyBytes(2e12, {bits: true, maxUnit: 'Gbit'}), '2000 Gbit');
	t.is(prettyBytes(2 * (1024 ** 4), {bits: true, binary: true, maxUnit: 'Gibit'}), '2048 Gibit');
});

test('maxUnit throws for a unit outside the selected system', t => {
	t.throws(() => prettyBytes(1, {maxUnit: 'GiB'}), {instanceOf: TypeError});
	t.throws(() => prettyBytes(1, {binary: true, maxUnit: 'GB'}), {instanceOf: TypeError});
	t.throws(() => prettyBytes(1, {bits: true, maxUnit: 'GB'}), {instanceOf: TypeError});
	t.throws(() => prettyBytes(1, {maxUnit: 'gb'}), {instanceOf: TypeError});
	t.throws(() => prettyBytes(1, {maxUnit: 3}), {instanceOf: TypeError});
	t.throws(() => prettyBytes(1, {maxUnit: null}), {instanceOf: TypeError});
});
"""
open(p,'w').write(s)
