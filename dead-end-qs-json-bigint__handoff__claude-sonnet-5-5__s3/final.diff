--- a/test/parse.js
+++ b/test/parse.js
@@ -1492,3 +1492,26 @@ test('rejects an invalid `arrayFormatSeparator`', () => {
 
 	assert.deepEqual(structuredClone(queryString.parse('foo=a·b', {arrayFormat: 'separator', arrayFormatSeparator: '·'})), {foo: ['a', 'b']});
 });
+
+test('types option: json', () => {
+	const types = {filter: 'json'};
+	assert.deepEqual(queryString.parse('filter=%7B%22a%22%3A%5B1%2C2%5D%7D', {types}).filter, {a: [1, 2]});
+	assert.equal(queryString.parse('filter=5', {types}).filter, 5);
+	assert.equal(queryString.parse('filter=true', {types}).filter, true);
+	assert.equal(queryString.parse('filter=null', {types}).filter, null);
+	assert.equal(queryString.parse('filter=%22x%22', {types}).filter, 'x');
+
+	// Invalid JSON stays a string.
+	assert.equal(queryString.parse('filter=%7Bnope', {types}).filter, '{nope');
+	assert.equal(queryString.parse('filter=abc', {types}).filter, 'abc');
+	assert.equal(queryString.parse('filter=', {types}).filter, '');
+
+	// A valueless key stays `null`, and other keys are untouched.
+	assert.equal(queryString.parse('filter', {types}).filter, null);
+	assert.equal(queryString.parse('other=%7B%7D', {types}).other, '{}');
+
+	// Overrides `parseNumbers`, and applies to each item of an array.
+	assert.equal(queryString.parse('filter=1', {types, parseNumbers: true}).filter, 1);
+	assert.deepEqual(structuredClone(queryString.parse('filter=1&filter=%7B%7D&filter=x', {types}).filter), [1, {}, 'x']);
+	assert.deepEqual(structuredClone(queryString.parse('filter=%5B1%5D', {types, arrayFormat: 'comma'}).filter), [1]);
+});
