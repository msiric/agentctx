index 2361505..f92423e 100644
--- a/test-timing.js
+++ b/test-timing.js
@@ -906,3 +906,114 @@ test('unref is not applied unless the option is set', {timeout: 30_000}, async t
 
 	assert.ok(!isUnrefCalled);
 });
+
+test('context carries elapsedTime since pRetry was called', async t => {
+	const clock = await withFakeTime(t);
+	const consumeTimes = [];
+	const failedTimes = [];
+	const retryTimes = [];
+
+	await assert.rejects(pRetry(async () => {
+		throw new Error('fail');
+	}, {
+		retries: 2,
+		minTimeout: 100,
+		factor: 2,
+		shouldConsumeRetry({elapsedTime}) {
+			consumeTimes.push(elapsedTime);
+			return true;
+		},
+		onFailedAttempt({elapsedTime}) {
+			failedTimes.push(elapsedTime);
+		},
+		shouldRetry({elapsedTime}) {
+			retryTimes.push(elapsedTime);
+			return true;
+		},
+	}), {message: 'fail'});
+
+	// Waits of 100 and 200 ms pass between the three attempts.
+	assert.deepEqual(consumeTimes, [0, 100, 300]);
+	assert.deepEqual(failedTimes, [0, 100, 300]);
+	assert.deepEqual(retryTimes, [0, 100]);
+	assert.equal(clock.now(), 300);
+});
+
+test('retryAfter (seconds) is added to the backoff delay', async t => {
+	const delays = collapseDelays(t);
+	const seen = [];
+
+	await assert.rejects(pRetry(async () => {
+		throw Object.assign(new Error('rate limited'), {retryAfter: 2});
+	}, {
+		retries: 2,
+		minTimeout: 100,
+		factor: 2,
+		onFailedAttempt({retryDelay}) {
+			seen.push(retryDelay);
+		},
+	}), /rate limited|x/v);
+
+	assert.deepEqual(delays, [2100, 2200]);
+	// The last failure has no retry after it.
+	assert.deepEqual(seen, [2100, 2200, 0]);
+});
+
+test('retryAfter is not capped by maxTimeout, the backoff is', async t => {
+	const delays = collapseDelays(t);
+
+	await assert.rejects(pRetry(async () => {
+		throw Object.assign(new Error('rate limited'), {retryAfter: 5});
+	}, {retries: 1, minTimeout: 1000, maxTimeout: 300}), /rate limited|x/v);
+
+	assert.deepEqual(delays, [5300]);
+});
+
+test('invalid retryAfter values are ignored', async t => {
+	const delays = collapseDelays(t);
+
+	for (const retryAfter of ['5', -1, 0, NaN, Infinity, null]) {
+		await assert.rejects(pRetry(async () => {
+			throw Object.assign(new Error('x'), {retryAfter});
+		}, {retries: 1, minTimeout: 10}), /rate limited|x/v);
+	}
+
+	assert.deepEqual(delays, Array.from({length: 6}, () => 10));
+});
+
+test('retryAfter is waited out when the failure does not consume a retry', async t => {
+	const delays = collapseDelays(t);
+	let attempts = 0;
+
+	const result = await pRetry(async () => {
+		attempts++;
+		if (attempts < 3) {
+			throw Object.assign(new Error('rate limited'), {retryAfter: 1});
+		}
+
+		return 'ok';
+	}, {retries: 1, minTimeout: 500, shouldConsumeRetry: () => false});
+
+	assert.equal(result, 'ok');
+	assert.deepEqual(delays, [1000, 1000]);
+});
+
+test('retryAfter is clamped to maxRetryTime', async t => {
+	const {delays} = await withFakeTime(t);
+
+	await assert.rejects(pRetry(async () => {
+		throw Object.assign(new Error('rate limited'), {retryAfter: 60});
+	}, {retries: 3, minTimeout: 100, maxRetryTime: 1000}), /rate limited|x/v);
+
+	assert.deepEqual(delays, [1000]);
+});
+
+test('a huge retryAfter does not overflow the timer', async t => {
+	const delays = collapseDelays(t);
+
+	await assert.rejects(pRetry(async () => {
+		throw Object.assign(new Error('x'), {retryAfter: 1e12});
+	}, {retries: 1, minTimeout: 10}), /rate limited|x/v);
+
+	assert.deepEqual(delays, [(2 ** 31) - 1]);
+});
