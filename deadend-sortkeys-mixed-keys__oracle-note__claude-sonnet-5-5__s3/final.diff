+def _json_key(key: Any) -> str:
+    """
+    Return the string a dict key turns into when serialized by ``json``.
+
+    Keys of unsupported types are returned as ``None`` by the caller's sort
+    key helper so that ``json`` can decide whether to skip or reject them.
+    """
+    if isinstance(key, str):
+        return key
+    return json.dumps(key)
+
+
+def _sort_keys(obj: Any) -> Any:
+    """
+    Recursively sort dict keys by their JSON string form.
+
+    Unlike ``json.dumps(sort_keys=True)`` this also works for dicts with keys
+    of mixed types (e.g. ``int`` and ``str``). Keys of types JSON cannot
+    represent are kept at the end so ``json`` can handle them as usual.
+    """
+    if isinstance(obj, dict):
+        supported = []
+        other = []
+        for key, value in obj.items():
+            if key is None or isinstance(key, (str, int, float, bool)):
+                supported.append((_json_key(key), key, value))
+            else:
+                other.append((key, value))
+
+        # Sorting only on the string form keeps the sort stable and never
+        # compares keys of different types
+        supported.sort(key=lambda item: item[0])
+
+        result = {key: _sort_keys(value) for _, key, value in supported}
+        result.update((key, _sort_keys(value)) for key, value in other)
+        return result
+
+    if isinstance(obj, (list, tuple)):
+        return [_sort_keys(item) for item in obj]
+
+    return obj
+
+
