+def test_json_sorted_by_default(tmpdir):
+    db_file = tmpdir.join('test.db')
+    db = TinyDB(str(db_file))
+    db.insert({'b': 1, 'a': {'z': 1, 'y': [{'d': 1, 'c': 2}]}})
+    db.close()
+
+    assert db_file.read() == (
+        '{"_default": {"1": {"a": {"y": [{"c": 2, "d": 1}], "z": 1}, '
+        '"b": 1}}}'
+    )
+
+
+def test_json_sort_keys_false(tmpdir):
+    db_file = tmpdir.join('test.db')
+    db = TinyDB(str(db_file), sort_keys=False)
+    db.insert({'b': 1, 'a': 2})
+    db.close()
+
+    assert db_file.read() == '{"_default": {"1": {"b": 1, "a": 2}}}'
+
+
+def test_json_sort_mixed_key_types(tmpdir):
+    path = str(tmpdir.join('test.db'))
+    storage = JSONStorage(path)
+    storage.write({'t': {'other': 1, 500: 2, 200: 3}})
+    storage.close()
+
+    with open(path) as f:
+        assert f.read() == '{"t": {"200": 3, "500": 2, "other": 1}}'
+
+    # An explicit sort_keys=True must cope with mixed keys too
+    storage = JSONStorage(path, sort_keys=True)
+    storage.write({'t': {'other': 1, 200: 3}})
+    storage.close()
+
