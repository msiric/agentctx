 ```
 
+- `'json'`: Parse `filter` as JSON. A value that is not valid JSON stays a string. With an array format or a repeated key, each item is parsed:
+
+```js
+import queryString from 'query-string';
+
+queryString.parse('?filter=%7B%22a%22%3A1%7D&bad=%7Boops', {
+	types: {
+		filter: 'json',
+		bad: 'json',
+	}
+});
+//=> {bad: '{oops', filter: {a: 1}}
+```
+
 - `'Function'`: Provide a custom function as the parameter type. The parameter's value will equal the function's return value. When used with array formats (like `comma`, `separator`, `bracket`, etc.), the function is applied to each array element individually.
 
 ```js
diff --git a/test/parse.js b/test/parse.js
index 00a1abf..e348098 100644
--- a/test/parse.js
+++ b/test/parse.js
@@ -1492,3 +1492,18 @@ test('rejects an invalid `arrayFormatSeparator`', () => {
 
 	assert.deepEqual(structuredClone(queryString.parse('foo=a·b', {arrayFormat: 'separator', arrayFormatSeparator: '·'})), {foo: ['a', 'b']});
 });
+
+test('`json` type', () => {
+	const types = {filter: 'json'};
+	assert.deepEqual(structuredClone(queryString.parse('filter=%7B%22a%22%3A%5B1%2C2%5D%7D', {types})), {filter: {a: [1, 2]}});
+	assert.deepEqual(structuredClone(queryString.parse('filter=1&x=2', {types, parseNumbers: true})), {filter: 1, x: 2});
+	assert.deepEqual(structuredClone(queryString.parse('filter=null', {types})), {filter: null});
+	assert.deepEqual(structuredClone(queryString.parse('filter=true', {types})), {filter: true});
+	// Invalid JSON stays a string, even with `parseNumbers` or `parseBooleans`.
+	assert.deepEqual(structuredClone(queryString.parse('filter=%7Boops', {types})), {filter: '{oops'});
+	assert.deepEqual(structuredClone(queryString.parse('filter=abc', {types, parseNumbers: true, parseBooleans: true})), {filter: 'abc'});
+	assert.deepEqual(structuredClone(queryString.parse('filter=', {types})), {filter: ''});
+	assert.deepEqual(structuredClone(queryString.parse('filter', {types})), {filter: null});
+	assert.deepEqual(structuredClone(queryString.parse('filter=1&filter=%7B%7D&filter=x', {types})), {filter: [1, {}, 'x']});
+	assert.deepEqual(structuredClone(queryString.parse('filter=1,2', {types, arrayFormat: 'comma'})), {filter: [1, 2]});
+});
