+def test_none_values_skipped():
+    obj = {"a": None, "b": 1, "t": {"x": None, "y": 2}, "e": {"z": None}}
+    assert tomli_w.dumps(obj) == "b = 1\n\n[t]\ny = 2\n\n[e]\n"
+
+
+def test_none_values_skipped_inline_table():
+    obj = {"arr": [{"a": None, "b": 1}, {"c": None}], "inl": {"k": {"n": None, "v": 1}}}
+    actual = tomli_w.dumps(obj)
+    assert tomli.loads(actual) == {
+        "arr": [{"b": 1}, {}],
+        "inl": {"k": {"v": 1}},
+    }
+    assert "{ b = 1 }" in actual and "{}" in actual
+
+
+def test_none_values_skipped_dump(tmp_path):
+    path = tmp_path / "f.toml"
+    with path.open("wb") as f:
+        tomli_w.dump({"a": None, "b": 1}, f)
+    assert path.read_text() == "b = 1\n"
+
+
+def test_pathlib_paths():
+    import pathlib
+
+    obj = {
+        "p": pathlib.PurePosixPath("/usr/local/bin"),
+        "rel": pathlib.Path("a/b.txt"),
+        "arr": [pathlib.PurePosixPath("x/y")],
+        "t": {"q": pathlib.PurePosixPath("with \"quote\"")},
+    }
+    actual = tomli_w.dumps(obj)
+    assert tomli.loads(actual) == {
+        "p": "/usr/local/bin",
+        "rel": str(pathlib.Path("a/b.txt")),
+        "arr": ["x/y"],
+        "t": {"q": 'with "quote"'},
+    }
+
+
+def test_none_in_array_skipped():
+    obj = {"a": [1, None, 2], "b": [None], "c": [[None, 1], [None]], "d": (None, "x")}
+    actual = tomli_w.dumps(obj)
+    assert tomli.loads(actual) == {"a": [1, 2], "b": [], "c": [[1], []], "d": ["x"]}
+
+
+def test_none_in_array_of_tables():
+    obj = {"arr": [{"a": 1}, None, {"b": None}]}
+    actual = tomli_w.dumps(obj)
+    assert tomli.loads(actual) == {"arr": [{"a": 1}, {}]}
