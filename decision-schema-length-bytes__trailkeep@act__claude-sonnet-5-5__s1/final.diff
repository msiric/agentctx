diff --git a/test_schema.py b/test_schema.py
index 4d78456..e5b1872 100644
--- a/test_schema.py
+++ b/test_schema.py
@@ -21,6 +21,7 @@ from schema import (
     Const,
     Forbidden,
     Hook,
+    Length,
     Literal,
     Optional,
     Or,
@@ -2100,3 +2101,46 @@ def test_tuple_key_error_message_does_not_crash():
     with raises(SchemaError) as exc_info:
         Schema({("a", "b"): int}).validate({("a", "b"): "not-an-int"})
     assert "Key '('a', 'b')' error:" in exc_info.value.code
+
+
+def test_length_counts_utf8_bytes():
+    assert Length(min=1, max=5).validate("abcde") == "abcde"
+    assert Length(max=2).validate("é") == "é"  # 2 bytes
+    with raises(SchemaError) as e:
+        Length(max=2).validate("éa")  # 3 bytes, 2 chars
+    assert "3 bytes" in e.value.args[0] and "éa" not in e.value.args[0]
+
+
+def test_length_bounds_inclusive_and_optional():
+    assert Length(min=2).validate("ab") == "ab"
+    assert Length(max=2).validate("ab") == "ab"
+    assert Length().validate("") == ""
+    with raises(SchemaError):
+        Length(min=2).validate("a")
+    with raises(SchemaError):
+        Length(max=0).validate("a")
+
+
+def test_length_non_string_and_bad_bounds():
+    with raises(SchemaError):
+        Length(max=5).validate(123)
+    with raises(SchemaError):
+        Length(max=5).validate(b"abc")
+    for kwargs in ({"min": -1}, {"max": 1.5}, {"min": 3, "max": 2}, {"min": True}):
+        with raises(ValueError):
+            Length(**kwargs)
+
+
+def test_length_in_schema_and_error_message():
+    assert Schema({"name": Length(max=3)}).validate({"name": "abc"}) == {"name": "abc"}
+    with raises(SchemaError) as e:
+        Schema(Length(max=3), error="too long").validate("abcd")
+    assert e.value.code == "too long"
+    with raises(SchemaError) as e:
+        Schema(Length(max=3, error="bad {!r}")).validate("abcd")
+    assert e.value.errors[-1] == "bad 'abcd'"
+
+
+def test_length_json_schema():
+    assert Schema(Length(min=1, max=5)).json_schema("x")["maxLength"] == 5
+    assert "minLength" not in Schema(Length(min=1, max=5)).json_schema("x")
