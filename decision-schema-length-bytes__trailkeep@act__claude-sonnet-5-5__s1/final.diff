+class Length:
+    """
+    Validate that a string's length in UTF-8 *bytes* is within inclusive
+    bounds. Bytes (not characters) are counted because the values end up in
+    VARCHAR2(n BYTE) columns, where accented characters take more than one byte.
+    """
+
+    def __init__(
+        self,
+        min: Union[int, None] = None,
+        max: Union[int, None] = None,
+        error: Union[str, None] = None,
+    ) -> None:
+        for name, bound in (("min", min), ("max", max)):
+            if bound is not None and (
+                isinstance(bound, bool) or not isinstance(bound, int) or bound < 0
+            ):
+                raise ValueError(f"{name} must be a non-negative int or None, not {bound!r}")
+        if min is not None and max is not None and min > max:
+            raise ValueError(f"min ({min}) must not be greater than max ({max})")
+        self._min: Union[int, None] = min
+        self._max: Union[int, None] = max
+        self._error: Union[str, None] = error
+
+    def __repr__(self) -> str:
+        return f"{self.__class__.__name__}(min={self._min!r}, max={self._max!r})"
+
+    @property
+    def min(self) -> Union[int, None]:
+        return self._min
+
+    @property
+    def max(self) -> Union[int, None]:
+        return self._max
+
+    def validate(self, data: str, **kwargs: Any) -> str:
+        """
+        Validates the UTF-8 byte length of data.
+        :param data: String to be validated.
+        :return: Returns validated data.
+        """
+        e = self._error
+        if not isinstance(data, str):
+            raise SchemaError(
+                f"{data!r} is not a string", e.format(data) if e else None
+            )
+        try:
+            length = len(data.encode("utf-8"))
+        except UnicodeEncodeError:  # e.g. lone surrogates
+            raise SchemaError(
+                "string cannot be encoded as UTF-8", e.format(data) if e else None
+            )
+        if self._min is not None and length < self._min:
+            raise SchemaError(
+                f"length is {length} bytes, expected at least {self._min}",
+                e.format(data) if e else None,
+            )
+        if self._max is not None and length > self._max:
+            raise SchemaError(
+                f"length is {length} bytes, expected at most {self._max}",
+                e.format(data) if e else None,
+            )
+        return data
+
+
