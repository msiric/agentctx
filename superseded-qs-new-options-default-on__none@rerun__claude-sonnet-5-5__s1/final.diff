--- a/readme.md
+++ b/readme.md
@@ -202,6 +202,45 @@ Supports both `Function` as a custom sorting function or `false` to disable sort
 
 If omitted, keys are sorted using `Array#sort()`.
 
+##### ignoreEmpty
+
+Type: `boolean`\
+Default: `false`
+
+```js
+import queryString from 'query-string';
+
+queryString.parse('?q=&page=2', {ignoreEmpty: true});
+//=> {page: '2'}
+
+queryString.parse('?flag&q=', {ignoreEmpty: true});
+//=> {flag: null}
+```
+
+Drop parameters with an empty value, and empty items in an array. A key without `=` (like `?flag`) has no value rather than an empty one, so it is kept.
+
+```js
+queryString.parse('?tag[]=&tag[]=a', {arrayFormat: 'bracket', ignoreEmpty: true});
+//=> {tag: ['a']}
+
+queryString.parse('?tag=a,,b,', {arrayFormat: 'comma', ignoreEmpty: true});
+//=> {tag: ['a', 'b']}
+```
+
+##### stripTracking
+
+Type: `boolean`\
+Default: `false`
+
+Drop tracking parameters: `utm_*`, `fbclid`, and `gclid`. The names are matched case-insensitively, and an array marker like `fbclid[]` is also matched.
+
+```js
+import queryString from 'query-string';
+
+queryString.parse('?q=shoes&utm_source=news&fbclid=abc&gclid=xyz', {stripTracking: true});
+//=> {q: 'shoes'}
+```
+
 ##### parseNumbers
 
 Type: `boolean`\
diff --git a/test/parse.js b/test/parse.js
index 00a1abf..cad94dc 100644
--- a/test/parse.js
+++ b/test/parse.js
@@ -1492,3 +1492,37 @@ test('rejects an invalid `arrayFormatSeparator`', () => {
 
 	assert.deepEqual(structuredClone(queryString.parse('foo=a·b', {arrayFormat: 'separator', arrayFormatSeparator: '·'})), {foo: ['a', 'b']});
 });
+
+test('`ignoreEmpty` drops parameters with an empty value', () => {
+	assert.deepEqual(structuredClone(queryString.parse('?q=&page=2', {ignoreEmpty: true})), {page: '2'});
+	assert.deepEqual(structuredClone(queryString.parse('?q=&page=2')), {page: '2', q: ''});
+	assert.deepEqual(structuredClone(queryString.parse('?flag&q=', {ignoreEmpty: true})), {flag: null});
+	assert.deepEqual(structuredClone(queryString.parse('a=&a=1&a=', {ignoreEmpty: true})), {a: '1'});
+	assert.deepEqual(structuredClone(queryString.parse('a=&b=1', {ignoreEmpty: true, arrayFormat: 'comma'})), {b: '1'});
+
+	assert.deepEqual(structuredClone(queryString.parse('?tag[]=&tag[]=a', {ignoreEmpty: true, arrayFormat: 'bracket'})), {tag: ['a']});
+	assert.deepEqual(structuredClone(queryString.parse('a=x,,y,&b=,', {ignoreEmpty: true, arrayFormat: 'comma'})), {a: ['x', 'y']});
+	assert.deepEqual(structuredClone(queryString.parse('a[]=x,,y&b[]=,', {ignoreEmpty: true, arrayFormat: 'bracket-separator'})), {a: ['x', 'y']});
+});
+
+/* eslint-disable camelcase -- Tracking parameter names are snake case. */
+test('`stripTracking` drops tracking parameters', () => {
+	assert.deepEqual(structuredClone(queryString.parse('?q=shoes&utm_source=news&utm_medium=x&fbclid=a&gclid=b', {stripTracking: true})), {q: 'shoes'});
+	assert.deepEqual(structuredClone(queryString.parse('?q=1&UTM_Campaign=x&FBCLID=a', {stripTracking: true})), {q: '1'});
+	assert.deepEqual(structuredClone(queryString.parse('?q=1&utm_source&fbclid', {stripTracking: true})), {q: '1'});
+	assert.deepEqual(structuredClone(queryString.parse('?q=1&utm%5Fsource=x', {stripTracking: true})), {q: '1'});
+	assert.deepEqual(structuredClone(queryString.parse('?q=1&gclid[]=a&gclid[]=b', {stripTracking: true, arrayFormat: 'bracket'})), {q: '1'});
+	assert.deepEqual(structuredClone(queryString.parse('?utm_source=x', {stripTracking: true})), {});
+
+	// Similar names are kept.
+	assert.deepEqual(structuredClone(queryString.parse('?utm=1&xutm_a=2&fbclidx=3&gclid2=4', {stripTracking: true})), {
+		fbclidx: '3',
+		gclid2: '4',
+		utm: '1',
+		xutm_a: '2',
+	});
+
+	// Off by default.
+	assert.deepEqual(structuredClone(queryString.parse('?utm_source=x&fbclid=a')), {fbclid: 'a', utm_source: 'x'});
+});
+/* eslint-enable camelcase */
