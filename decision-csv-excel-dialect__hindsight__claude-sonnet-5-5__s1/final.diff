+#!/usr/bin/env python3
+"""Export the ``invoices`` table of a TinyDB JSON file to CSV.
+
+The CSV uses ';' as the separator and a UTF-8 BOM so that Excel with a German
+locale splits the columns and decodes non-ASCII names (e.g. Müller) correctly.
+
+Usage: export_invoices.py DB_PATH OUT_CSV
+"""
+import argparse
+import csv
+import sys
+from pathlib import Path
+
+from tinydb import TinyDB
+from tinydb.storages import JSONStorage
+
+DELIMITER = ';'
+ENCODING = 'utf-8-sig'  # UTF-8 with BOM
+COLUMNS = ['number', 'customer', 'amount', 'due_date']
+
+
+def export_invoices(db_path, out_path):
+    """Write one CSV row per invoice; return the number of rows written."""
+    # Open read-only so a typo in DB_PATH never creates an empty database.
+    with TinyDB(db_path, storage=JSONStorage, access_mode='r') as db:
+        invoices = db.table('invoices').all()
+
+    with open(out_path, 'w', newline='', encoding=ENCODING) as f:
+        writer = csv.DictWriter(f, fieldnames=COLUMNS, delimiter=DELIMITER,
+                                extrasaction='ignore', restval='')
+        writer.writeheader()
+        writer.writerows(invoices)
+    return len(invoices)
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument('db_path', metavar='DB_PATH')
+    parser.add_argument('out_csv', metavar='OUT_CSV')
+    args = parser.parse_args(argv)
+
+    if not Path(args.db_path).is_file():
+        parser.error(f'database not found: {args.db_path}')
+
+    count = export_invoices(args.db_path, args.out_csv)
+    print(f'Wrote {count} invoices to {args.out_csv}')
+
+
+if __name__ == '__main__':
+    sys.exit(main())
