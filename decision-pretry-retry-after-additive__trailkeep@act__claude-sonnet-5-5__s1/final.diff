@@ -165,6 +166,15 @@ In the example above, `RateLimitError`s will not decrement the available `retrie
 > [!WARNING]
 > Failures that do not consume a retry also do not count towards `retries`, so returning `false` on every failure means `pRetry` never runs out of attempts. `maxRetryTime` is then the only bound, and it defaults to `Infinity`. Pair this option with `maxRetryTime`, or return `false` only for failures you expect to stop eventually. These retries also have no delay, so an operation that fails without waiting on a timer or I/O runs back to back without yielding to the event loop, and a `signal` aborted from a timer or an event cannot stop it.
 
+##### Retry-After
+
+If the error an attempt throws has a numeric `retryAfter` (in seconds), `pRetry` waits that long **in addition to** the normal backoff delay before the next attempt. It is added rather than substituted so that many clients given the same `retryAfter` do not all come back at the same instant.
+
+- `maxTimeout` caps the backoff only, not `retryAfter`.
+- If the wait would exceed the remaining `maxRetryTime`, `pRetry` rejects with the error instead of retrying early, since an early attempt would be rejected again.
+- A `retryAfter` that is not a finite number above `0` is ignored.
+- `retryAfter` is only the one thrown by the failed attempt; an `HTTP-date` form must be converted to seconds by your code.
+
 ##### retries
 
 Type: `number`\
diff --git a/test.js b/test.js
index 20c9a47..00f51fe 100644
--- a/test.js
+++ b/test.js
@@ -1284,3 +1284,146 @@ try {
 		await removeTemporaryScript(temporaryFile);
 	}
 });
+
+test('callbacks get elapsedTime since pRetry was called', async () => {
+	const seen = {consume: [], failed: [], retry: []};
+	const start = performance.now();
+
+	await assert.rejects(pRetry(async () => {
+		await delay(20);
+		throw new Error('fail');
+	}, {
+		retries: 2,
+		minTimeout: 30,
+		factor: 1,
+		shouldConsumeRetry({elapsedTime}) {
+			seen.consume.push(elapsedTime);
+		},
+		onFailedAttempt({elapsedTime}) {
+			seen.failed.push(elapsedTime);
+		},
+		shouldRetry({elapsedTime}) {
+			seen.retry.push(elapsedTime);
+			return true;
+		},
+	}), {message: 'fail'});
+
+	const total = performance.now() - start;
+
+	// `shouldRetry` is not asked once the retries have run out.
+	assert.equal(seen.consume.length, 3);
+	assert.equal(seen.failed.length, 3);
+	assert.equal(seen.retry.length, 2);
+
+	for (const times of Object.values(seen)) {
+		assert.ok(times.length >= 2);
+		assert.ok(times[0] >= 15, `first failure after the 20ms operation: ${times[0]}`);
+		assert.ok(times[1] >= times[0] + 40, 'includes the previous attempt and retry delay');
+		assert.ok(times.at(-1) <= total);
+	}
+});
+
+function retryAfterError(retryAfter) {
+	const error = new Error('rate limited');
+	error.retryAfter = retryAfter;
+	return error;
+}
+
+test('retryAfter is waited in addition to the backoff', async () => {
+	const delays = [];
+	let calls = 0;
+	const start = performance.now();
+
+	await pRetry(async () => {
+		if (++calls === 1) {
+			throw retryAfterError(0.1);
+		}
+	}, {
+		minTimeout: 50,
+		randomize: false,
+		onFailedAttempt({retryDelay}) {
+			delays.push(retryDelay);
+		},
+	});
+
+	assert.deepEqual(delays, [150]);
+	assert.ok(performance.now() - start >= 145);
+});
+
+test('maxTimeout caps the backoff but not retryAfter', async () => {
+	const delays = [];
+
+	await assert.rejects(pRetry(async () => {
+		throw retryAfterError(1);
+	}, {
+		retries: 1,
+		minTimeout: 5000,
+		maxTimeout: 10,
+		onFailedAttempt({retryDelay}) {
+			delays.push(retryDelay);
+		},
+		shouldRetry: () => false,
+	}), {message: 'rate limited'});
+
+	assert.deepEqual(delays, [1010]);
+});
+
+test('invalid retryAfter values are ignored', async () => {
+	for (const value of [undefined, '1', -1, 0, NaN, Infinity, null]) {
+		const delays = [];
+
+		await assert.rejects(pRetry(async () => {
+			throw retryAfterError(value);
+		}, {
+			retries: 1,
+			minTimeout: 1,
+			onFailedAttempt({retryDelay}) {
+				delays.push(retryDelay);
+			},
+		}), {message: 'rate limited'});
+
+		assert.deepEqual(delays, [1, 0], `retryAfter: ${String(value)}`);
+	}
+});
+
+test('retryAfter is not applied when no retry follows', async () => {
+	const delays = [];
+
+	await assert.rejects(pRetry(async () => {
+		throw retryAfterError(60);
+	}, {
+		retries: 0,
+		onFailedAttempt({retryDelay}) {
+			delays.push(retryDelay);
+		},
+	}), {message: 'rate limited'});
+
+	assert.deepEqual(delays, [0]);
+});
+
+test('gives up instead of retrying early when retryAfter exceeds maxRetryTime', async () => {
+	let calls = 0;
+	const start = performance.now();
+
+	await assert.rejects(pRetry(async () => {
+		calls++;
+		throw retryAfterError(30);
+	}, {
+		minTimeout: 1,
+		maxRetryTime: 200,
+	}), {message: 'rate limited'});
+
+	assert.equal(calls, 1);
+	assert.ok(performance.now() - start < 1000);
+});
+
+test('retryAfter wait can be aborted', async () => {
+	const controller = new AbortController();
+	setTimeout(() => {
+		controller.abort(new Error('stop'));
+	}, 20);
+
+	await assert.rejects(pRetry(async () => {
+		throw retryAfterError(30);
+	}, {signal: controller.signal}), {message: 'stop'});
+});
