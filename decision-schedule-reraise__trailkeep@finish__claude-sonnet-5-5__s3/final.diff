+    def test_run_all_delay_only_between_jobs(self):
+        mock_job = make_mock_job()
+        every().minute.do(mock_job)
+        every().hour.do(mock_job)
+        every().day.at("11:00").do(mock_job)
+        with mock.patch("schedule.time.sleep") as mock_sleep:
+            schedule.run_all(delay_seconds=5)
+        assert mock_job.call_count == 3
+        assert mock_sleep.call_count == 2
+
+    def test_run_pending_runs_all_then_reraises_first_error(self):
+        ok_job = make_mock_job()
+        bad1 = make_mock_job("bad1")
+        bad1.side_effect = ValueError("first")
+        bad2 = make_mock_job("bad2")
+        bad2.side_effect = KeyError("second")
+        every().second.do(bad1)
+        every().second.do(bad2)
+        every().second.do(ok_job)
+        with mock_datetime(2100, 1, 1, 0, 0, 5):
+            with self.assertRaises(ValueError):
+                schedule.run_pending()
+            assert ok_job.call_count == 1
+            assert bad2.call_count == 1
+            # failed jobs were rescheduled, so they are not due again
+            assert not any(j.should_run for j in schedule.jobs)
