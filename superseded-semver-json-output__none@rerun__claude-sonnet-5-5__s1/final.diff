--- a/tests/test_pysemver-cli.py
+++ b/tests/test_pysemver-cli.py
@@ -1,3 +1,4 @@
+import io
 from argparse import Namespace
 from contextlib import contextmanager
 from unittest.mock import patch
@@ -155,3 +156,88 @@ def test_should_return_documented_error_code_for_invalid_version(cliargs, capsys
     # docs/pysemver.rst shows ``echo $?`` printing 2 for both commands
     assert main(cliargs) == 2
     assert capsys.readouterr().err.startswith("ERROR")
+
+
+def test_sort_prints_one_version_per_line_oldest_first(capsys):
+    assert main(["sort", "1.10.0", "1.2.0", "1.2.0-rc.1", "0.9.9"]) == 0
+    captured = capsys.readouterr()
+    assert captured.out == "0.9.9\n1.2.0-rc.1\n1.2.0\n1.10.0\n"
+    assert captured.err == ""
+
+
+def test_sort_single_version(capsys):
+    assert main(["sort", "1.2.3"]) == 0
+    assert capsys.readouterr().out == "1.2.3\n"
+
+
+def test_sort_invalid_version_prints_nothing_on_stdout(capsys):
+    assert main(["sort", "1.2.3", "bogus"]) == 2
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert "ERROR" in captured.err
+
+
+def test_sort_reads_stdin_when_no_arguments(capsys):
+    with patch("sys.stdin", io.StringIO("1.10.0\n\n  1.2.0 \n1.2.0-rc.1\n\n")):
+        assert main(["sort"]) == 0
+    assert capsys.readouterr().out == "1.2.0-rc.1\n1.2.0\n1.10.0\n"
+
+
+def test_sort_ignores_stdin_when_arguments_given(capsys):
+    with patch("sys.stdin", io.StringIO("0.0.1\n")):
+        assert main(["sort", "2.0.0", "1.0.0"]) == 0
+    assert capsys.readouterr().out == "1.0.0\n2.0.0\n"
+
+
+def test_sort_invalid_version_on_stdin_is_an_error(capsys):
+    with patch("sys.stdin", io.StringIO("1.2.3\nbogus\n")):
+        assert main(["sort"]) == 2
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert "ERROR" in captured.err
+
+
+def test_sort_empty_stdin_prints_nothing(capsys):
+    with patch("sys.stdin", io.StringIO("\n\n")):
+        assert main(["sort"]) == 0
+    assert capsys.readouterr().out == ""
+
+
+def test_latest_ignores_prereleases(capsys):
+    assert main(["latest", "1.2.0", "2.0.0-rc.1", "1.10.0", "1.9.0"]) == 0
+    captured = capsys.readouterr()
+    assert captured.out == "1.10.0\n"
+    assert captured.err == ""
+
+
+def test_latest_ignores_build_only_difference_in_prerelease_check(capsys):
+    assert main(["latest", "1.0.0+build.5", "1.0.0-alpha"]) == 0
+    assert capsys.readouterr().out == "1.0.0+build.5\n"
+
+
+def test_latest_reads_stdin_when_no_arguments(capsys):
+    with patch("sys.stdin", io.StringIO("1.2.0\n\n 1.3.0 \n1.4.0-beta\n")):
+        assert main(["latest"]) == 0
+    assert capsys.readouterr().out == "1.3.0\n"
+
+
+def test_latest_ignores_stdin_when_arguments_given(capsys):
+    with patch("sys.stdin", io.StringIO("9.9.9\n")):
+        assert main(["latest", "1.0.0", "2.0.0"]) == 0
+    assert capsys.readouterr().out == "2.0.0\n"
+
+
+@pytest.mark.parametrize("args", [["1.0.0-rc.1", "2.0.0-alpha"], []])
+def test_latest_without_stable_version_is_an_error(args, capsys):
+    with patch("sys.stdin", io.StringIO("")):
+        assert main(["latest", *args]) == 2
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert "ERROR" in captured.err
+
+
+def test_latest_invalid_version_is_an_error(capsys):
+    assert main(["latest", "1.2.3", "bogus"]) == 2
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert "ERROR" in captured.err
