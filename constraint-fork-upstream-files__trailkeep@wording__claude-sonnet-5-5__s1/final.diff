diff --git a/test/dashes.js b/test/dashes.js
new file mode 100644
index 0000000..92ceff4
--- /dev/null
+++ b/test/dashes.js
@@ -0,0 +1,31 @@
+const test = require('tape');
+const mri = require('../lib');
+
+test('opts["--"]: args after -- go to argv["--"]', t => {
+	const argv = mri(['a', '-x', '1', '--', 'b', '--c', '-d'], { '--': true });
+	t.same(argv, { _: ['a'], x: 1, '--': ['b', '--c', '-d'] });
+	t.end();
+});
+
+test('opts["--"]: empty array when no -- present', t => {
+	t.same(mri(['a', '--foo'], { '--': true }), { _: ['a'], foo: true, '--': [] });
+	t.end();
+});
+
+test('opts["--"]: nothing after --', t => {
+	t.same(mri(['a', '--'], { '--': true }), { _: ['a'], '--': [] });
+	t.end();
+});
+
+test('without opts["--"]: args after -- go to argv._', t => {
+	const argv = mri(['a', '--', 'b', '--c']);
+	t.same(argv, { _: ['a', 'b', '--c'] });
+	t.false('--' in argv);
+	t.end();
+});
+
+test('opts["--"]: works with aliases and defaults', t => {
+	const argv = mri(['-f', '2', '--', 'x'], { '--': true, alias: { f: 'foo' }, default: { bar: 1 } });
+	t.same(argv, { _: [], f: 2, foo: 2, bar: 1, '--': ['x'] });
+	t.end();
+});
