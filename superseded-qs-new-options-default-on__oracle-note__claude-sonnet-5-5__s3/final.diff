@@ -1,3 +1,4 @@
+/* eslint-disable camelcase -- The tracking parameter names are not camel case. */
 /* eslint-disable node-test/no-conditional-assertion -- Many tests here are table-driven, so the assertions sit inside a loop over the cases. The loop always runs, and every case is checked. */
 import test from 'node:test';
 import assert from 'node:assert/strict';
@@ -1492,3 +1493,44 @@ test('rejects an invalid `arrayFormatSeparator`', () => {
 
 	assert.deepEqual(structuredClone(queryString.parse('foo=a·b', {arrayFormat: 'separator', arrayFormatSeparator: '·'})), {foo: ['a', 'b']});
 });
+
+test('`ignoreEmpty` drops parameters with an empty value', t => {
+	t.assert.deepStrictEqual({...queryString.parse('?q=&page=2', {ignoreEmpty: true})}, {page: '2'});
+	t.assert.deepStrictEqual({...queryString.parse('q=&q=a&r=', {ignoreEmpty: true})}, {q: 'a'});
+	t.assert.deepStrictEqual({...queryString.parse('?flag&q=', {ignoreEmpty: true})}, {flag: null});
+	t.assert.deepStrictEqual({...queryString.parse('?q=', {ignoreEmpty: true})}, {});
+	t.assert.deepStrictEqual({...queryString.parse('q=&r=1', {ignoreEmpty: true, arrayFormat: 'comma'})}, {r: '1'});
+	t.assert.deepStrictEqual({...queryString.parse('q=&page=2')}, {page: '2', q: ''});
+	t.assert.deepStrictEqual({...queryString.parse('q=&page=2', {ignoreEmpty: false})}, {page: '2', q: ''});
+});
+
+test('`ignoreEmpty` drops empty array items', t => {
+	for (const arrayFormat of ['bracket', 'index', 'bracket-separator']) {
+		const key = arrayFormat === 'index' ? 'tag[0]' : 'tag[]';
+		t.assert.deepStrictEqual({...queryString.parse(`?${key}=&${key}=a`, {arrayFormat, ignoreEmpty: true})}, {tag: ['a']});
+	}
+
+	t.assert.deepStrictEqual({...queryString.parse('?tag[]=&tag[]=a', {arrayFormat: 'bracket'})}, {tag: ['', 'a']});
+});
+
+test('`stripTracking` drops tracking parameters by default', t => {
+	t.assert.deepStrictEqual({...queryString.parse('?q=a&utm_source=x&utm_medium=y&fbclid=1&gclid=2')}, {q: 'a'});
+	t.assert.deepStrictEqual({...queryString.parse('?UTM_Source=x&FBCLID=1&q=a')}, {q: 'a'});
+	t.assert.deepStrictEqual({...queryString.parse('?utm%5Fsource=x&utm_tag[]=1&q=a', {arrayFormat: 'bracket'})}, {q: 'a'});
+	t.assert.deepStrictEqual({...queryString.parse('?utm_source&q=a')}, {q: 'a'});
+	t.assert.deepStrictEqual({...queryString.parse('?utm=1&xutm_source=1&fbclid2=1&my_gclid=1')}, {
+		fbclid2: '1',
+		my_gclid: '1',
+		utm: '1',
+		xutm_source: '1',
+	});
+});
+
+test('`stripTracking: false` keeps tracking parameters', t => {
+	t.assert.deepStrictEqual({...queryString.parse('?q=a&utm_source=x&fbclid=1&gclid=2', {stripTracking: false})}, {
+		fbclid: '1',
+		gclid: '2',
+		q: 'a',
+		utm_source: 'x',
+	});
+});
