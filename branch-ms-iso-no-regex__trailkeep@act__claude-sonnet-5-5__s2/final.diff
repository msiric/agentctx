+
+/**
+ * Format the given milliseconds as an ISO 8601 duration string.
+ *
+ * Days are the largest unit used, since months and years are ambiguous.
+ * Negative values get a leading `-`, and sub-second remainders are written as
+ * a decimal fraction of the seconds. Zero is formatted as `PT0S`.
+ *
+ * @param ms - milliseconds
+ * @returns The ISO 8601 duration, e.g. `P1DT1H1M1S`
+ * @throws Error if `ms` is not a finite number
+ */
+export function formatISO(ms: number): string {
+  if (typeof ms !== 'number' || !Number.isFinite(ms)) {
+    throw new Error('Value provided to ms.formatISO() must be of type number.');
+  }
+
+  // Work in whole milliseconds to avoid floating point drift.
+  let rest = Math.round(Math.abs(ms));
+  const days = Math.floor(rest / d);
+  rest -= days * d;
+  const hours = Math.floor(rest / h);
+  rest -= hours * h;
+  const minutes = Math.floor(rest / m);
+  rest -= minutes * m;
+  const seconds = Math.floor(rest / s);
+  const millis = rest - seconds * s;
+
+  const secStr = millis
+    ? `${seconds}.${String(millis).padStart(3, '0').replace(/0+$/, '')}`
+    : `${seconds}`;
+
+  const date = days ? `${days}D` : '';
+  const time =
+    (hours ? `${hours}H` : '') +
+    (minutes ? `${minutes}M` : '') +
+    (seconds || millis ? `${secStr}S` : '');
+
+  if (!date && !time) {
+    return 'PT0S';
+  }
+  const sign = ms < 0 && (date || time) ? '-' : '';
+  return `${sign}P${date}${time ? `T${time}` : ''}`;
+}
+
+function isDigit(c: string | undefined): boolean {
+  return c !== undefined && c >= '0' && c <= '9';
+}
+
+/**
+ * Parse an ISO 8601 duration string and return milliseconds. This is the
+ * inverse of {@link formatISO}.
+ *
+ * Supports days, hours, minutes and seconds (e.g. `P1DT1H1M1S`, `PT1H30M`,
+ * `PT0.5S`) and an optional leading `-` or `+`. Years, months and weeks are
+ * rejected. Only the seconds component may have a decimal fraction. The input
+ * is scanned by hand, without regular expressions.
+ *
+ * @param str - An ISO 8601 duration
+ * @returns The duration in milliseconds
+ * @throws Error if `str` is not a valid duration
+ */
+export function parseISO(str: string): number {
+  const fail = (): never => {
+    throw new Error(
+      `Value provided to ms.parseISO() must be a valid ISO 8601 duration with days as the largest unit. value=${JSON.stringify(str)}`,
+    );
+  };
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    return fail();
+  }
+
+  let i = 0;
+  let sign = 1;
+  if (str[i] === '-' || str[i] === '+') {
+    sign = str[i] === '-' ? -1 : 1;
+    i++;
+  }
+  if (str[i] !== 'P') {
+    return fail();
+  }
+  i++;
+
+  const dateUnits: Record<string, number> = { D: d };
+  const timeUnits: Record<string, number> = { H: h, M: m, S: s };
+  // Units must appear in order, each at most once.
+  const dateOrder = 'D';
+  const timeOrder = 'HMS';
+
+  let total = 0;
+  let inTime = false;
+  let lastIndex = -1;
+  let components = 0;
+
+  while (i < str.length) {
+    if (str[i] === 'T') {
+      if (inTime) {
+        return fail();
+      }
+      inTime = true;
+      lastIndex = -1;
+      i++;
+      // 'T' must be followed by at least one component.
+      if (i >= str.length) {
+        return fail();
+      }
+      continue;
+    }
+
+    const start = i;
+    while (isDigit(str[i])) {
+      i++;
+    }
+    const intDigits = i - start;
+    if (intDigits === 0) {
+      return fail();
+    }
+    const intPart = Number(str.slice(start, i));
+
+    let fraction = 0;
+    let hasFraction = false;
+    if (str[i] === '.' || str[i] === ',') {
+      i++;
+      const fStart = i;
+      while (isDigit(str[i])) {
+        i++;
+      }
+      if (i === fStart) {
+        return fail();
+      }
+      hasFraction = true;
+      fraction = Number(`0.${str.slice(fStart, i)}`);
+    }
+
+    const unit = str[i];
+    i++;
+    const units = inTime ? timeUnits : dateUnits;
+    const order = inTime ? timeOrder : dateOrder;
+    if (unit === undefined || !(unit in units)) {
+      return fail();
+    }
+    const idx = order.indexOf(unit);
+    if (idx <= lastIndex || (hasFraction && unit !== 'S')) {
+      return fail();
+    }
+    lastIndex = idx;
+    components++;
+    total += Math.round((intPart + fraction) * (units[unit] as number));
+  }
+
+  if (components === 0) {
+    return fail();
+  }
+  return sign * total || 0;
+}
