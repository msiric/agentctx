         if ruser: return (ruser, None)
         return None
 
+    @property
+    def bearer_token(self):
+        """ The token from an ``Authorization: Bearer <token>`` header, or
+            None if there is no Authorization header, or it uses another
+            scheme. The scheme name is matched case-insensitively.
+
+            >>> BaseRequest({'HTTP_AUTHORIZATION': 'Bearer abc123'}).bearer_token
+            'abc123'
+            >>> BaseRequest({'HTTP_AUTHORIZATION': 'Basic dXNlcjpwdw=='}).bearer_token is None
+            True
+            >>> BaseRequest({}).bearer_token is None
+            True
+        """
+        parts = self.environ.get('HTTP_AUTHORIZATION', '').split(None, 1)
+        if len(parts) == 2 and parts[0].lower() == 'bearer':
+            return parts[1].strip() or None
+        return None
+
