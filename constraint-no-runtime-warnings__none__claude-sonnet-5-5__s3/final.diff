+    def test_ttl_setter(self):
+        cache = TTLCache[int, int, int](maxsize=3, ttl=5, timer=Timer())
+        cache[1] = 1  # expires at 5
+
+        cache.ttl = 2
+        self.assertEqual(2, cache.ttl)
+        cache[2] = 2  # expires at 2; existing item is unaffected
+
+        cache.timer.tick()
+        self.assertEqual({1, 2}, set(cache))
+        cache.timer.tick()
+        self.assertEqual({1}, set(cache))
+        self.assertEqual(1, len(cache))  # shorter-lived item evicted first
+        self.assertNotIn(2, cache)
+
+        cache.ttl = 10
+        cache[3] = 3  # expires at 12
+        cache.timer.tick()
+        cache.timer.tick()
+        cache.timer.tick()  # time 5
+        self.assertEqual({3}, set(cache))
+        self.assertEqual(1, len(cache))
+
     def test_ttl_timer(self):
         cache = TTLCache[int, int, int](maxsize=2, ttl=2, timer=Timer())
         self.assertEqual(cache.timer.time, 0)
