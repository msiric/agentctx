+    def _failing_job(self, fail_times):
+        calls = []
+
+        def func():
+            calls.append(1)
+            if len(calls) <= fail_times:
+                raise RuntimeError("flaky")
+
+        return func, calls
+
+    def test_retry_backoff_delays(self):
+        func, calls = self._failing_job(10)
+        with mock_datetime(2014, 6, 28, 12, 0, 0):
+            job = every(1).hour.retry(times=3, base_delay=30).do(func)
+        t0 = datetime.datetime(2014, 6, 28, 13, 0, 0)
+        with mock_datetime(2014, 6, 28, 13, 0, 0):
+            for base in (30, 60, 120):
+                with mock.patch.object(job._jitter_rng, "uniform", return_value=7) as uni:
+                    job.run()
+                    uni.assert_called_once_with(0, 30)
+                assert job.next_run == t0 + datetime.timedelta(seconds=base + 7)
+        assert len(calls) == 3
+
+    def test_retry_gives_up_and_resumes_schedule(self):
+        func, calls = self._failing_job(10)
+        with mock_datetime(2014, 6, 28, 12, 0, 0):
+            job = every(1).hour.retry(times=2, base_delay=30).do(func)
+        with mock_datetime(2014, 6, 28, 13, 0, 0):
+            job.run()
+            job.run()
+            assert job.next_run != datetime.datetime(2014, 6, 28, 14, 0, 0)
+            job.run()  # third failure: 2 retries exhausted
+            assert job.next_run == datetime.datetime(2014, 6, 28, 14, 0, 0)
+        assert len(calls) == 3
+        assert job._retry_attempts == 0
+
+    def test_retry_success_resets(self):
+        func, calls = self._failing_job(1)
+        with mock_datetime(2014, 6, 28, 12, 0, 0):
+            job = every(1).hour.retry(times=3, base_delay=30).do(func)
+        with mock_datetime(2014, 6, 28, 13, 0, 0):
+            job.run()
+            assert job._retry_attempts == 1
+            job.run()
+            assert job._retry_attempts == 0
+            assert job.next_run == datetime.datetime(2014, 6, 28, 14, 0, 0)
+
+    def test_retry_run_pending_does_not_raise(self):
+        func, calls = self._failing_job(10)
+        with mock_datetime(2014, 6, 28, 12, 0, 0):
