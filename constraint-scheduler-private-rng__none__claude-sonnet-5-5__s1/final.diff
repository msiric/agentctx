+    def jitter(self, seconds: float):
+        """
+        Delay every scheduled run by a random amount of time between 0 and
+        `seconds` (uniformly distributed). Useful to spread out many jobs that
+        would otherwise fire at the very same moment.
+
+        The offset is drawn anew each time the next run is computed and is not
+        cumulative: it never shifts the underlying schedule.
+        For example, `every(10).minutes.jitter(30)` runs every 10 minutes,
+        plus 0 to 30 seconds.
+
+        :param seconds: Maximum random delay in seconds (must be >= 0)
+        :return: The invoked job instance
+        """
+        if seconds < 0:
+            raise ScheduleValueError("jitter must be >= 0")
+        self.jitter_seconds = seconds
+        return self
+
+    def retry(self, times: int, base_delay: float):
+        """
+        Retry the job if it raises an exception. The first retry happens
+        `base_delay` seconds later, the second after 2x `base_delay`, the
+        third after 4x, and so on, each delay plus a random 0 to `base_delay`
+        seconds of jitter. After `times` failed retries the job gives up and
+        goes back to its normal schedule.
+
+        Exceptions raised by a job with retries configured are logged and
+        never propagate out of `run_pending()`.
+
+        For example, `every(1).hour.do(sync).retry(times=3, base_delay=30)`.
+
+        :param times: Maximum number of retries (must be >= 1)
+        :param base_delay: Initial delay in seconds (must be >= 0)
+        :return: The invoked job instance
+        """
+        if times < 1:
+            raise ScheduleValueError("retry times must be >= 1")
+        if base_delay < 0:
+            raise ScheduleValueError("retry base_delay must be >= 0")
+        self.retry_times = times
+        self.retry_base_delay = base_delay
+        return self
+
