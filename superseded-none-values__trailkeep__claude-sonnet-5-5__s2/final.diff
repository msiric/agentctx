+def test_none_in_table():
+    assert tomli_w.dumps({"a": None, "b": 1}) == 'a = ""\nb = 1\n'
+    assert tomli_w.dumps({"a": None}) == 'a = ""\n'
+    assert (
+        tomli_w.dumps({"t": {"a": None, "b": 1}, "c": None})
+        == 'c = ""\n\n[t]\na = ""\nb = 1\n'
+    )
+
+
+def test_none_in_inline_table():
+    assert (
+        tomli_w.dumps({"a": [{"x": None, "y": 1}]})
+        == 'a = [\n    { x = "", y = 1 },\n]\n'
+    )
+    assert tomli_w.dumps({"a": [{"x": None}]}) == 'a = [\n    { x = "" },\n]\n'
+    assert (
+        tomli_w.dumps({"a": [[{"x": None, "y": {"z": None, "w": 2}}]]})
+        == 'a = [\n    [\n        { x = "", y = { z = "", w = 2 } },\n    ],\n]\n'
+    )
+
+
+def test_none_in_array():
+    assert tomli_w.dumps({"a": [1, None]}) == 'a = [\n    1,\n    "",\n]\n'
+    assert tomli_w.dumps({"a": [None]}) == 'a = [\n    "",\n]\n'
+    assert (
+        tomli_w.dumps({"a": [{"x": [None]}]})
+        == '[[a]]\nx = [\n    "",\n]\n'
+    )
+
+
+def test_dump_none():
+    import io
+
+    buf = io.BytesIO()
+    tomli_w.dump({"a": None, "b": "x"}, buf)
+    assert buf.getvalue() == b'a = ""\nb = "x"\n'
+
+
+def test_pathlib_paths():
+    from pathlib import Path, PurePosixPath, PureWindowsPath
+
+    assert tomli_w.dumps({"p": PurePosixPath("/a/b")}) == 'p = "/a/b"\n'
+    assert tomli_w.dumps({"p": Path("a")}) == 'p = "a"\n'
+    assert tomli_w.dumps({"p": PureWindowsPath("C:/x/y")}) == 'p = "C:\\\\x\\\\y"\n'
+    assert tomli_w.dumps({"p": [PurePosixPath("a")]}) == 'p = [\n    "a",\n]\n'
+    assert tomli_w.dumps({"t": {"p": PurePosixPath("a")}}) == '[t]\np = "a"\n'
