 ```
 
+##### significantDigits
+
+Type: `number`\
+Default: `3`
+
+The number of significant digits to round to. Only applies when neither [`minimumFractionDigits`](#minimumfractiondigits) nor [`maximumFractionDigits`](#maximumfractiondigits) is set.
+
+Whole digits are never dropped, so `123456` bytes with `significantDigits: 2` is still `123 kB`.
+
+Must be an integer between 1 and 100. Throws a `TypeError` for invalid values.
+
+```js
+import prettyBytes from 'pretty-bytes';
+
+prettyBytes(1337, {significantDigits: 2});
+//=> '1.3 kB'
+
+prettyBytes(1337, {significantDigits: 4});
+//=> '1.337 kB'
+```
+
 ##### space
 
 Type: `boolean`\
diff --git a/test.js b/test.js
index ed5a122..a336b85 100644
--- a/test.js
+++ b/test.js
@@ -1178,3 +1178,25 @@ test('unit option must belong to the active unit system', t => {
 		t.throws(() => prettyBytes(1337, options), {instanceOf: TypeError});
 	}
 });
+
+test('significantDigits option changes the default rounding', t => {
+	t.is(prettyBytes(1337, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 3}), '1.34 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 1}), '1 kB');
+	t.is(prettyBytes(123_456, {significantDigits: 2}), '123 kB');
+	t.is(prettyBytes(999_999, {significantDigits: 2}), '1 MB');
+	t.is(prettyBytes(1337n, {significantDigits: 4}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4, locale: 'de'}), '1,337 kB');
+});
+
+test('significantDigits is ignored when fraction digit options are set', t => {
+	t.is(prettyBytes(1337, {significantDigits: 2, maximumFractionDigits: 3}), '1.337 kB');
+	t.is(prettyBytes(1900, {significantDigits: 5, minimumFractionDigits: 1}), '1.9 kB');
+});
+
+test('significantDigits must be an integer between 1 and 100', t => {
+	for (const significantDigits of [0, -1, 1.5, 101, '3', null, Number.NaN]) {
+		t.throws(() => prettyBytes(1337, {significantDigits}), {instanceOf: TypeError});
+	}
+});
