diff --git a/test/count.js b/test/count.js
new file mode 100644
index 0000000..b2d76aa
--- /dev/null
+++ b/test/count.js
@@ -0,0 +1,38 @@
+const test = require('tape');
+const fn = require('../lib');
+
+test('count :: short flags', t => {
+	t.same(fn(['-vvv'], { count: 'v' }), { _: [], v: 3 });
+	t.same(fn(['-v', '-v'], { count: ['v'] }), { _: [], v: 2 });
+	t.same(fn(['-v'], { count: 'v' }), { _: [], v: 1 });
+	t.end();
+});
+
+test('count :: long flags', t => {
+	t.same(fn(['--verbose', '--verbose'], { count: 'verbose' }), { _: [], verbose: 2 });
+	t.end();
+});
+
+test('count :: does not consume next arg', t => {
+	t.same(fn(['-v', 'foo', '-v'], { count: 'v' }), { _: ['foo'], v: 2 });
+	t.end();
+});
+
+test('count :: aliases are summed', t => {
+	const argv = fn(['-v', '--verbose', '-vv'], { count: 'v', alias: { v: 'verbose' } });
+	t.same(argv, { _: [], v: 4, verbose: 4 });
+	t.end();
+});
+
+test('count :: mixed with other flags', t => {
+	const argv = fn(['-vvx', 'y'], { count: 'v' });
+	t.same(argv, { _: [], v: 2, x: 'y' });
+	t.end();
+});
+
+test('count :: absent, default, and --no-', t => {
+	t.same(fn(['-x'], { count: 'v' }), { _: [], x: true });
+	t.same(fn([], { count: 'v', default: { v: 0 } }), { _: [], v: 0 });
+	t.same(fn(['-v', '--no-v'], { count: 'v' }), { _: [], v: 0 });
+	t.end();
+});
