         if access_mode not in ('r', 'rb', 'r+', 'rb+'):
@@ -119,6 +122,71 @@ class JSONStorage(Storage):
         # Open the file for reading/writing
         self._handle = open(path, mode=self._mode, encoding=encoding)
 
+        # Finish (or discard) a write that was interrupted by a crash
+        if self._handle.writable():
+            self._recover()
+
+    def _recover(self) -> None:
+        """
+        Recover from a crash that happened during a previous write.
+
+        A complete journal holds the full new state, so it is replayed (this
+        is idempotent). An incomplete or corrupt journal means the crash
+        happened before the database file was touched, so the database file
+        still holds the old state and the journal is simply dropped.
+        """
+        try:
+            with open(self._journal_path, 'rb') as journal:
+                raw = journal.read()
+        except FileNotFoundError:
+            return
+
+        digest, sep, payload = raw.partition(b'\n')
+        if sep and hashlib.sha256(payload).hexdigest().encode() == digest:
+            self._overwrite(payload.decode(self._handle.encoding))
+
+        self._remove_journal()
+
+    def _remove_journal(self) -> None:
+        try:
+            os.remove(self._journal_path)
+        except FileNotFoundError:
+            pass
+
+    def _write_journal(self, serialized: str) -> None:
+        payload = serialized.encode(self._handle.encoding)
+        digest = hashlib.sha256(payload).hexdigest().encode()
+
+        with open(self._journal_path, 'wb') as journal:
+            journal.write(digest + b'\n' + payload)
+            journal.flush()
+            os.fsync(journal.fileno())
+
+        # Make the journal's directory entry durable (not possible everywhere)
+        try:
+            fd = os.open(os.path.dirname(os.path.abspath(self._journal_path)), os.O_RDONLY)
+        except OSError:
+            return
+        try:
+            os.fsync(fd)
+        except OSError:
+            pass
+        finally:
+            os.close(fd)
+
+    def _overwrite(self, serialized: str) -> None:
+        """Overwrite the database file in place (never replaces the file)."""
+        self._handle.seek(0)
+        self._handle.write(serialized)
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+
+        # Remove data that is behind the new cursor in case the file has
+        # gotten shorter
+        self._handle.truncate()
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+
     def close(self) -> None:
         self._handle.close()
 
