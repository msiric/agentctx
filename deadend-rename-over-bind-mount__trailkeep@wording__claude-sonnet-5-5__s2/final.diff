diff --git a/tests/test_storages.py b/tests/test_storages.py
index 6e433a1..26b5c8c 100644
--- a/tests/test_storages.py
+++ b/tests/test_storages.py
@@ -285,3 +285,149 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+# --- Crash safety -----------------------------------------------------------
+
+OLD = {'_default': {'1': {'v': 'old' * 1000}}}
+NEW = {'_default': {'1': {'v': 'new'}}}
+
+
+def _journal_bytes(data):
+    import hashlib
+    payload = json.dumps(data).encode()
+    return hashlib.sha256(payload).hexdigest().encode() + b'\n' + payload
+
+
+@pytest.fixture
+def dbpath(tmp_path):
+    path = str(tmp_path / 'db.json')
+    storage = JSONStorage(path)
+    storage.write(OLD)
+    storage.close()
+    return path
+
+
+def _reopen(path):
+    storage = JSONStorage(path)
+    try:
+        return storage.read()
+    finally:
+        storage.close()
+
+
+def test_write_leaves_no_journal(dbpath):
+    storage = JSONStorage(dbpath)
+    storage.write(NEW)
+    storage.close()
+    assert not os.path.exists(dbpath + '.journal')
+    assert _reopen(dbpath) == NEW
+
+
+def test_write_modifies_file_in_place(dbpath, monkeypatch):
+    # db.json may be a bind mount, so it must never be renamed/replaced
+    def forbidden(*a, **k):
+        raise AssertionError('file must not be replaced')
+    monkeypatch.setattr(os, 'replace', forbidden)
+    monkeypatch.setattr(os, 'rename', forbidden)
+
+    inode = os.stat(dbpath).st_ino
+    storage = JSONStorage(dbpath)
+    storage.write(NEW)
+    storage.close()
+    assert os.stat(dbpath).st_ino == inode
+
+
+def test_crash_while_writing_journal_keeps_old_state(dbpath):
+    # Torn journal, database file untouched
+    with open(dbpath + '.journal', 'wb') as f:
+        f.write(_journal_bytes(NEW)[:-5])
+    assert _reopen(dbpath) == OLD
+    assert not os.path.exists(dbpath + '.journal')
+
+
+def test_crash_with_empty_journal_keeps_old_state(dbpath):
+    open(dbpath + '.journal', 'wb').close()
+    assert _reopen(dbpath) == OLD
+
+
+def test_crash_during_in_place_write_rolls_forward(dbpath):
+    # Complete journal, database file truncated mid-write
+    with open(dbpath + '.journal', 'wb') as f:
+        f.write(_journal_bytes(NEW))
+    with open(dbpath, 'r+') as f:
+        f.truncate(10)
+    assert _reopen(dbpath) == NEW
+    assert not os.path.exists(dbpath + '.journal')
+
+
+def test_crash_before_truncate_rolls_forward(dbpath):
+    # New data written over the start of the (longer) old data
+    with open(dbpath + '.journal', 'wb') as f:
+        f.write(_journal_bytes(NEW))
+    with open(dbpath, 'r+') as f:
+        f.write(json.dumps(NEW))
+    assert _reopen(dbpath) == NEW
+
+
+def test_crash_after_write_before_journal_removal(dbpath):
+    with open(dbpath + '.journal', 'wb') as f:
+        f.write(_journal_bytes(OLD))
+    assert _reopen(dbpath) == OLD
+    assert not os.path.exists(dbpath + '.journal')
+
+
+def test_corrupt_journal_is_ignored(dbpath):
+    data = bytearray(_journal_bytes(NEW))
+    data[-3] ^= 0xFF
+    with open(dbpath + '.journal', 'wb') as f:
+        f.write(bytes(data))
+    assert _reopen(dbpath) == OLD
+
+
+@pytest.mark.parametrize('failing', ['write', 'truncate'])
+def test_simulated_crash_in_write(dbpath, monkeypatch, failing):
+    storage = JSONStorage(dbpath)
+    handle = storage._handle
+
+    class Crash(Exception):
+        pass
+
+    class Proxy:
+        def __getattr__(self, name):
+            return getattr(handle, name)
+
+        def write(self, s):
+            if failing == 'write':
+                handle.write(s[:len(s) // 2])
+                handle.flush()
+                raise Crash
+            return handle.write(s)
+
+        def truncate(self, *a):
+            raise Crash
+
+    storage._handle = Proxy()
+    with pytest.raises(Crash):
+        storage.write(NEW)
+    handle.close()
+
+    assert _reopen(dbpath) == NEW
+
+
+def test_tinydb_survives_interrupted_write(dbpath):
+    with open(dbpath + '.journal', 'wb') as f:
+        f.write(_journal_bytes(NEW))
+    with open(dbpath, 'r+') as f:
+        f.truncate(7)
+    with TinyDB(dbpath) as db:
+        assert db.all() == [{'v': 'new'}]
+
+
+def test_read_only_mode_does_not_touch_journal(dbpath):
+    with open(dbpath + '.journal', 'wb') as f:
+        f.write(_journal_bytes(NEW))
+    storage = JSONStorage(dbpath, access_mode='r')
+    assert storage.read() == OLD
+    storage.close()
+    assert os.path.exists(dbpath + '.journal')
