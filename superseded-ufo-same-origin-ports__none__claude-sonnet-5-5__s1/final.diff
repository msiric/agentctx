+
+function _parseOrigin(input: unknown) {
+  if (typeof input !== "string" || !input) {
+    return;
+  }
+  let url: URL;
+  try {
+    url = new URL(input);
+  } catch {
+    return;
+  }
+  // Opaque origins (data:, javascript:, blob:, mailto:, ...) are never equal
+  if (!url.host || url.origin === "null") {
+    return;
+  }
+  // Ports are compared strictly (as written) with no default-port normalization
+  const authority = input
+    .replace(/\\/g, "/")
+    .replace(/^[^:]+:\/\//, "")
+    .split(/[#/?]/)[0]
+    .split("@")
+    .pop()!;
+  const port = authority.match(/:(\d+)$/)?.[1] ?? "";
+  return `${url.protocol}//${url.hostname}:${port}`;
+}
+
+/**
+ * Check if two URLs have the same origin (protocol, host and port).
+ *
+ * Ports are compared as written (an omitted port is not equal to the default port).
+ * Relative URLs and opaque origins (`data:`, `javascript:`, ...) are never same-origin.
+ *
+ * @example
+ * ```js
+ * isSameOrigin("https://example.com/a", "https://example.com/b"); // true
+ * isSameOrigin("https://example.com", "https://example.com:443"); // false
+ * ```
+ *
+ * @group utils
+ */
+export function isSameOrigin(a: string, b: string): boolean {
+  const originA = _parseOrigin(a);
+  return !!originA && originA === _parseOrigin(b);
+}
