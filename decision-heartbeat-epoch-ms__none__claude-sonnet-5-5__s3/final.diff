+    def _write_heartbeat(self) -> None:
+        if self.heartbeat_path is None:
+            return
+        data = {
+            "last_pass": _epoch_ms(datetime.datetime.now()),
+            "next_run": _epoch_ms(self.get_next_run()),
+        }
+        # Write to a temp file and rename so readers never see partial JSON.
+        tmp_path = f"{os.fspath(self.heartbeat_path)}.tmp"
+        try:
+            with open(tmp_path, "w") as f:
+                json.dump(data, f)
+            os.replace(tmp_path, self.heartbeat_path)
+        except OSError:
+            # Monitoring problems must not stop the jobs from running.
+            logger.exception("Could not write heartbeat to %s", self.heartbeat_path)
 
