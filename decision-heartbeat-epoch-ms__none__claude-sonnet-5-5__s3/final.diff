+    def test_heartbeat(self):
+        import json
+        import tempfile
+
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "hb.json")
+            s = schedule.Scheduler(heartbeat_path=path)
+
+            # No jobs: written, next_run is null
+            before = int(time.time() * 1000)
+            s.run_pending()
+            with open(path) as f:
+                data = json.load(f)
+            assert set(data) == {"last_pass", "next_run"}
+            assert before <= data["last_pass"] <= int(time.time() * 1000)
+            assert data["next_run"] is None
+
+            # With jobs: next_run is the earliest upcoming run
+            s.every(5).minutes.do(make_mock_job("a"))
+            s.every(1).minutes.do(make_mock_job("b"))
+            s.run_pending()
+            with open(path) as f:
+                data = json.load(f)
+            assert type(data["last_pass"]) is int
+            expected = min(j.next_run for j in s.jobs)
+            assert data["next_run"] == int(expected.timestamp() * 1000)
+            assert not os.path.exists(path + ".tmp")
+
