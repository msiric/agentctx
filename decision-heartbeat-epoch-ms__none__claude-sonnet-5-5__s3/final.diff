+    def test_status(self):
+        import json
+
+        def my_job():
+            pass
+
+        s = schedule.Scheduler()
+        s.every(5).minutes.do(my_job)
+        s.every().day.at("10:30").do(make_mock_job("other"))
+        before = s.status()
+        assert json.loads(json.dumps(before)) == before
+        assert len(before) == 2
+        assert before[0]["job"] == "my_job"
+        assert before[0]["interval"] == 5
+        assert before[0]["unit"] == "minutes"
+        assert before[0]["last_run"] is None
+        job0 = s.jobs[0]
+        assert before[0]["next_run"] == int(job0.next_run.timestamp() * 1000)
+        assert type(before[0]["next_run"]) is int
+        assert before[1]["job"] == "other"
+        assert before[1]["unit"] == "days"
+
+        s.run_all()
+        after = s.status()
+        assert type(after[0]["last_run"]) is int
+        assert after[0]["last_run"] == int(s.jobs[0].last_run.timestamp() * 1000)
+        assert json.loads(json.dumps(after)) == after
