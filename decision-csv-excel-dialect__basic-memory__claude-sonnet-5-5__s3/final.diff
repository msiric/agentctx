+        path: Union[str, 'PathLike[str]'],
+        fields: Optional[Iterable[str]] = None
+    ) -> None:
+        """
+        Export the table to a CSV file (UTF-8, comma separated).
+
+        The first row is a header, followed by one row per document.
+
+        :param path: the file to write
+        :param fields: the columns to write, in order. Defaults to all
+                       top-level keys in first-seen order.
+        """
+
+        docs = self.all()
+
+        if fields is None:
+            columns: list[str] = []
+            seen = set()
+            for doc in docs:
