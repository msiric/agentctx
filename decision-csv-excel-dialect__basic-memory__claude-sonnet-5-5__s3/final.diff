+
+
+def test_to_csv_default_fields(db, tmp_path):
+    import csv
+    db.truncate()
+    db.insert({'a': 1, 'b': 'x'})
+    db.insert({'c': 3, 'a': 2})
+    path = tmp_path / 'out.csv'
+    db.to_csv(path)
+
+    with open(path, newline='', encoding='utf-8') as f:
+        rows = list(csv.reader(f))
+    assert rows == [['a', 'b', 'c'], ['1', 'x', ''], ['2', '', '3']]
+
+
+def test_to_csv_fields(db, tmp_path):
+    import csv
+    db.truncate()
+    db.insert({'a': 1, 'b': 'x, "y"'})
+    path = tmp_path / 'out.csv'
+    db.to_csv(path, fields=['b', 'z', 'a'])
+
+    with open(path, newline='', encoding='utf-8') as f:
+        rows = list(csv.reader(f))
+    assert rows == [['b', 'z', 'a'], ['x, "y"', '', '1']]
+
+
+def test_to_csv_empty_table(db, tmp_path):
+    db.truncate()
+    path = tmp_path / 'out.csv'
+    db.to_csv(path, fields=['a'])
+    assert path.read_bytes() == b'a\r\n'
