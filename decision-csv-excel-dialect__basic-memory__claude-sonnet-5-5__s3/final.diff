diff --git a/scripts/export_invoices.py b/scripts/export_invoices.py
new file mode 100644
index 0000000..520f09e
--- /dev/null
+++ b/scripts/export_invoices.py
@@ -0,0 +1,48 @@
+#!/usr/bin/env python3
+"""Export the ``invoices`` table of a TinyDB JSON file to CSV.
+
+Usage: python scripts/export_invoices.py DB_PATH OUT_CSV
+
+Writes one row per invoice with the columns number, customer, amount, due_date.
+The CSV uses semicolons and a UTF-8 BOM so Excel with a German locale opens it
+correctly.
+The database file is only read, never modified.
+"""
+import csv
+import json
+import sys
+
+COLUMNS = ["number", "customer", "amount", "due_date"]
+
+
+def export_invoices(db_path: str, out_path: str) -> int:
+    with open(db_path, encoding="utf-8") as f:
+        data = json.load(f)
+
+    invoices = data.get("invoices")
+    if invoices is None:
+        raise SystemExit(f"error: no 'invoices' table in {db_path}")
+
+    # TinyDB stores a table as {doc_id: document}; sort by numeric id so the
+    # output follows insertion order.
+    rows = [invoices[k] for k in sorted(invoices, key=int)]
+
+    with open(out_path, "w", newline="", encoding="utf-8-sig") as f:
+        writer = csv.DictWriter(f, fieldnames=COLUMNS, extrasaction="ignore",
+                                restval="", delimiter=";")
+        writer.writeheader()
+        writer.writerows(rows)
+    return len(rows)
+
+
+def main(argv: list[str]) -> int:
+    if len(argv) != 3:
+        print(f"usage: {argv[0]} DB_PATH OUT_CSV", file=sys.stderr)
+        return 2
+    count = export_invoices(argv[1], argv[2])
+    print(f"Wrote {count} invoices to {argv[2]}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
