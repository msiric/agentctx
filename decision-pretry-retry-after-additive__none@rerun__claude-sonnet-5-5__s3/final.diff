+test('the context carries elapsedTime since pRetry was called', async t => {
+	await withFakeTime(t);
+	const observations = [];
+
+	await assert.rejects(pRetry(async () => {
+		throw new Error('fail');
+	}, {
+		retries: 2,
+		minTimeout: 100,
+		factor: 2,
+		shouldConsumeRetry({elapsedTime}) {
+			observations.push(['shouldConsumeRetry', elapsedTime]);
+		},
+		onFailedAttempt({elapsedTime}) {
+			observations.push(['onFailedAttempt', elapsedTime]);
+		},
+		shouldRetry({elapsedTime}) {
+			observations.push(['shouldRetry', elapsedTime]);
+			return true;
+		},
+	}), {message: 'fail'});
+
+	// Waits of 100 and 200 are charged, so the three attempts start at 0, 100 and 300. `shouldRetry` shares the `onFailedAttempt` context, and is not called on the last failure.
+	assert.deepEqual(observations, [
+		['shouldConsumeRetry', 0],
+		['onFailedAttempt', 0],
+		['shouldRetry', 0],
+		['shouldConsumeRetry', 100],
+		['onFailedAttempt', 100],
+		['shouldRetry', 100],
+		['shouldConsumeRetry', 300],
+		['onFailedAttempt', 300],
+	]);
+});
+
+test('retryAfter on the error (in seconds) raises the delay', async t => {
+	await withFakeTime(t);
