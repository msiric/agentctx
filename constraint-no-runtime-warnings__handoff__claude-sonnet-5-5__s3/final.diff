 from cachetools import TTLCache
 
@@ -84,6 +85,38 @@ class TTLCacheTest(unittest.TestCase, CacheTestMixin):
         self.assertEqual(0, len(cache))
         self.assertEqual(set(), set(cache))
 
+    def test_ttl_setter(self):
+        timer = Timer()
+        cache = TTLCache[int, int, int](maxsize=3, ttl=2, timer=timer)
+        cache[1] = 1
+        cache.ttl = 5
+        self.assertEqual(5, cache.ttl)
+        cache[2] = 2
+
+        timer.time = 2  # item 1 expired under the old ttl
+        cache.expire()
+        self.assertNotIn(1, cache)
+        self.assertIn(2, cache)
+
+        timer.time = 4  # item 2 lives for the new ttl
+        cache.expire()
+        self.assertIn(2, cache)
+
+        timer.time = 5
+        cache.expire()
+        self.assertNotIn(2, cache)
+
+    def test_expire_time_keyword(self):
+        cache = TTLCache[int, int, int](maxsize=2, ttl=2, timer=Timer())
+        cache[1] = 1
+        self.assertEqual([], cache.expire(now=1))
+        self.assertEqual([(1, 1)], cache.expire(now=2))
+        cache[2] = 2
+        # deprecated alias must keep working, silently
+        with warnings.catch_warnings():
+            warnings.simplefilter("error")
+            self.assertEqual([(2, 2)], cache.expire(time=2))
+
     def test_ttl_timer(self):
         cache = TTLCache[int, int, int](maxsize=2, ttl=2, timer=Timer())
         self.assertEqual(cache.timer.time, 0)
