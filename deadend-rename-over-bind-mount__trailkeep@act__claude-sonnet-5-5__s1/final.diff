diff --git a/tests/test_storages.py b/tests/test_storages.py
index 6e433a1..7243be9 100644
--- a/tests/test_storages.py
+++ b/tests/test_storages.py
@@ -285,3 +285,96 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def _journal_bytes(serialized):
+    import hashlib
+    payload = serialized.encode('utf-8')
+    return hashlib.sha256(payload).hexdigest().encode() + b'\n' + payload
+
+
+def test_json_no_journal_left_after_write(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    db = TinyDB(path)
+    db.insert({'a': 1})
+    db.close()
+    assert not os.path.exists(path + '.journal')
+
+
+def test_json_crash_mid_write_recovers_new_state(tmpdir, monkeypatch):
+    path = str(tmpdir.join('db.json'))
+    db = TinyDB(path)
+    db.insert({'a': 1})
+    db.close()
+
+    # Simulate dying after writing only part of the data in place
+    db = TinyDB(path)
+    storage = db.storage
+
+    def crash(serialized):
+        storage._handle.seek(0)
+        storage._handle.write(serialized[:5])
+        storage._handle.truncate()
+        storage._handle.flush()
+        raise KeyboardInterrupt  # stands in for kill -9
+
+    monkeypatch.setattr(storage, '_write_in_place', crash)
+    with pytest.raises(KeyboardInterrupt):
+        db.insert({'b': 2})
+    storage._handle.close()
+
+    with pytest.raises(ValueError):
+        json.load(open(path))  # file is truncated/corrupt on disk
+
+    db = TinyDB(path)
+    assert db.all() == [{'a': 1}, {'b': 2}]
+    db.close()
+    assert not os.path.exists(path + '.journal')
+
+
+@pytest.mark.parametrize('cut', [0, 10, 70, -1])
+def test_json_crash_while_writing_journal_keeps_old_state(tmpdir, cut):
+    path = str(tmpdir.join('db.json'))
+    db = TinyDB(path)
+    db.insert({'a': 1})
+    db.close()
+
+    full = _journal_bytes('{"_default": {"1": {"a": 1}, "2": {"b": 2}}}')
+    with open(path + '.journal', 'wb') as f:
+        f.write(full[:cut])  # partial journal; db file untouched
+
+    db = TinyDB(path)
+    assert db.all() == [{'a': 1}]
+    db.close()
+    assert not os.path.exists(path + '.journal')
+
+
+def test_json_write_modifies_file_in_place(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    db = TinyDB(path)
+    inode = os.stat(path).st_ino
+    db.insert({'a': 1})
+    assert os.stat(path).st_ino == inode
+    db.close()
+
+
+def test_json_write_does_not_use_rename(tmpdir, monkeypatch):
+    def forbidden(*a, **k):
+        raise OSError(16, 'Device or resource busy')
+    monkeypatch.setattr(os, 'rename', forbidden)
+    monkeypatch.setattr(os, 'replace', forbidden)
+    db = TinyDB(str(tmpdir.join('db.json')))
+    db.insert({'a': 1})
+    db.close()
+
+
+def test_json_readonly_open_ignores_journal(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    db = TinyDB(path)
+    db.insert({'a': 1})
+    db.close()
+    with open(path + '.journal', 'wb') as f:
+        f.write(b'junk')
+    db = TinyDB(path, access_mode='r')
+    assert db.all() == [{'a': 1}]
+    db.close()
