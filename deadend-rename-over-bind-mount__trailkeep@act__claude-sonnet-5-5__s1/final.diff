+    # Crash safety
+    # ------------
+    # The database file is modified in place (it must not be replaced via
+    # rename, since it may be a bind-mounted single file). To survive a crash
+    # in the middle of the in-place write, the new contents are first stored
+    # in a redo journal (``<path>.journal``) and fsynced. Layout: one header
+    # line with the SHA-256 of the payload, followed by the payload.
+    #
+    # * Crash before the journal is complete: its checksum doesn't match, the
+    #   database file was not touched yet -> discard journal (old state).
+    # * Crash during the in-place write: the journal is valid -> replay it on
+    #   the next open (new state).
+
+    def _write_journal(self, serialized: str) -> None:
+        payload = serialized.encode(self._journal_encoding)
+        header = hashlib.sha256(payload).hexdigest().encode('ascii') + b'\n'
+        fd = os.open(self._journal_path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o644)
+        try:
+            os.write(fd, header + payload)
+            os.fsync(fd)
+        finally:
+            os.close(fd)
+        self._fsync_dir()
+
+    def _remove_journal(self) -> None:
+        try:
+            os.remove(self._journal_path)
+        except FileNotFoundError:
+            return
+        self._fsync_dir()
+
+    def _fsync_dir(self) -> None:
+        try:
+            fd = os.open(os.path.dirname(os.path.abspath(self._journal_path)), os.O_RDONLY)
+        except OSError:  # e.g. platforms that can't open directories
+            return
+        try:
+            os.fsync(fd)
+        except OSError:
+            pass
+        finally:
+            os.close(fd)
+
+    def _recover(self) -> None:
+        try:
+            with open(self._journal_path, 'rb') as f:
+                content = f.read()
+        except FileNotFoundError:
+            return
+
+        digest, sep, payload = content.partition(b'\n')
+        valid = (
+            bool(sep)
+            and digest == hashlib.sha256(payload).hexdigest().encode('ascii')
+        )
+        if valid:
+            self._write_in_place(payload.decode(self._journal_encoding))
+        self._remove_journal()
+
+    def _write_in_place(self, serialized: str) -> None:
         # Move the cursor to the beginning of the file just in case
