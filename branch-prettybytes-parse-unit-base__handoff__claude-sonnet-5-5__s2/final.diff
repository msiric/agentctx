+/**
+Parse a byte string into a number of bytes. The reverse of `prettyBytes(bytes, {binary: true})`.
+
+Supports plain numbers and `B`, `KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`, `ZiB`, `YiB`. The units without the `i` (`KB` or `kB`, `MB`, `GB`, `TB`, `PB`, `EB`, `ZB`, `YB`) are also accepted and mean powers of 1024, so `1 kB` is `1024`, which differs from `prettyBytes`. Units are case-sensitive. Fractional values are allowed and the result is rounded to a whole number of bytes.
+
+@throws {TypeError} If the input is not a string.
+@throws {SyntaxError} If the string is malformed or uses an unsupported unit.
+
+@example
+```
+import {parseBytes} from 'pretty-bytes';
+
+parseBytes('1.5 KiB');
+//=> 1536
+```
+*/
+export function parseBytes(string: string): number;
diff --git a/index.js b/index.js
index c5f37ab..ab94e89 100644
--- a/index.js
+++ b/index.js
@@ -285,3 +285,34 @@ export default function prettyBytes(number, options) {
 	const result = prefix + numberString + separator + UNITS[exponent];
 	return result.padStart(options.fixedWidth ?? 0);
 }
+
+// Units without the `i` are powers of 1024 here (Windows Explorer style), unlike `prettyBytes`, which uses powers of 1000 for them.
+const PARSE_ALIASES = new Map([
+	['KB', 'KiB'],
+	['kB', 'KiB'],
+	...BIBYTE_UNITS.slice(2).map(unit => [`${unit[0]}B`, unit]),
+]);
+
+const PARSE_PATTERN = /^(?<number>[+-]?(?:\d+(?:\.\d*)?|\.\d+))\s*(?<unit>[A-Za-z]+)?$/;
+
+export function parseBytes(string) {
+	if (typeof string !== 'string') {
+		throw new TypeError(`Expected a string, got \`${typeof string}\``);
+	}
+
+	const match = PARSE_PATTERN.exec(string.trim());
+
+	if (!match) {
+		throw new SyntaxError(`Invalid byte string: \`${string}\``);
+	}
+
+	const {number, unit = 'B'} = match.groups;
+	const exponent = BIBYTE_UNITS.indexOf(PARSE_ALIASES.get(unit) ?? unit);
+
+	if (exponent === -1) {
+		throw new SyntaxError(`Unsupported unit \`${unit}\` in: \`${string}\``);
+	}
+
+	// Bytes are whole numbers, so fractional results (for example `1.1 KiB`) are rounded.
+	return Math.round(Number(number) * (1024 ** exponent)) || 0;
+}
