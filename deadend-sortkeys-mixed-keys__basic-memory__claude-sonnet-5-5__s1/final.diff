@@ -49,6 +49,26 @@ def test_json_kwargs(tmpdir):
     db.close()
 
 
+def test_json_sort_keys_default(tmpdir):
+    path = str(tmpdir.join('test.db'))
+    storage = JSONStorage(path)
+    storage.write({'b': 1, 'a': 2, 'c': {'z': 1, 'y': 2}})
+    storage.close()
+
+    with open(path) as f:
+        assert f.read() == '{"a": 2, "b": 1, "c": {"y": 2, "z": 1}}'
+
+
+def test_json_sort_keys_disabled(tmpdir):
+    path = str(tmpdir.join('test.db'))
+    storage = JSONStorage(path, sort_keys=False)
+    storage.write({'b': 1, 'a': 2})
+    storage.close()
+
+    with open(path) as f:
+        assert f.read() == '{"b": 1, "a": 2}'
+
+
