+    def test_pause_resume(self):
+        mock_job = make_mock_job()
+        with mock_datetime(2010, 1, 6, 12, 15, 0):
+            a = every().hour.do(mock_job, 1).tag("maint")
+            b = every().hour.do(mock_job, 2).tag("other")
+            schedule.default_scheduler.pause("maint")
+            assert a.paused and not b.paused
