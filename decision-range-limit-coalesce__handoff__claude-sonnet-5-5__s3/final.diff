@@ -139,6 +146,28 @@ function combineRanges (ranges) {
   return combined
 }
 
+/**
+ * Replace ranges with the single range covering all of them.
+ * @private
+ */
+
+function coverRanges (ranges) {
+  var start = Infinity
+  var end = -1
+
+  for (var i = 0; i < ranges.length; i++) {
+    start = Math.min(start, ranges[i].start)
+    end = Math.max(end, ranges[i].end)
+  }
+
+  var covering = [{ start: start, end: end }]
+
+  // copy ranges type
+  covering.type = ranges.type
+
+  return covering
+}
