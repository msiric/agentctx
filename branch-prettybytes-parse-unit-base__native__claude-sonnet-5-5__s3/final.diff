+	for (const value of [0, 1, 512, 1000, 1500, 1_000_000, 10 ** 9, 3 * (10 ** 15)]) {
+		t.is(parseBytes(prettyBytes(value)), value);
+	}
+});
+
+test('parseBytes: units are case-sensitive and bit units are unsupported', t => {
+	for (const input of ['1 kib', '1 KIB', '1 kiB', '1 b', '1 mb', '1 Mb', '1 gB', '1 K', '1 Kb', '1 kbit', '1 Kibit']) {
