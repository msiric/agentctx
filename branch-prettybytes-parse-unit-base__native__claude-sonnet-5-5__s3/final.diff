--- a/index.d.ts
+++ b/index.d.ts
@@ -216,3 +216,26 @@ export default function prettyBytes(
 	number: number | bigint,
 	options?: Options
 ): string;
+
+/**
+Parse a byte string into a number of bytes: `'1.5 KiB'` → `1536`, `'1.5 kB'` → `1500`.
+
+Accepts a non-negative decimal number, optionally followed by a space and one of the decimal units `B`, `kB` (or `KB`), `MB`, `GB`, `TB`, `PB`, `EB`, `ZB`, `YB` (base 1000) or the binary units `KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`, `ZiB`, `YiB` (base 1024). Without a unit, bytes are assumed. Units are case-sensitive.
+
+@throws A `TypeError` if the input is not a string, is not a valid byte string, or uses an unsupported unit (such as `mb` or `Kbit`).
+
+@example
+```
+import {parseBytes} from 'pretty-bytes';
+
+parseBytes('512');
+//=> 512
+
+parseBytes('1.5 KiB');
+//=> 1536
+
+parseBytes('1.5 MB');
+//=> 1500000
+```
+*/
+export function parseBytes(string: string): number;
diff --git a/index.js b/index.js
index c5f37ab..40df5d7 100644
--- a/index.js
+++ b/index.js
@@ -285,3 +285,34 @@ export default function prettyBytes(number, options) {
 	const result = prefix + numberString + separator + UNITS[exponent];
 	return result.padStart(options.fixedWidth ?? 0);
 }
+
+// Decimal units use base 1000 (`1 MB` is 1,000,000 bytes) and binary units use base 1024. `KB` is accepted as an alias for `kB`. Units are case-sensitive.
+const PARSE_UNITS = new Map([
+	...BYTE_UNITS.map((unit, exponent) => [unit, 1000 ** exponent]),
+	...BIBYTE_UNITS.map((unit, exponent) => [unit, 1024 ** exponent]),
+	['KB', 1000],
+]);
+
+// Plain decimal digits with an optional fraction, then an optional unit. A regular or non-breaking space may separate them, matching what `prettyBytes` writes.
+const BYTES_PATTERN = /^(?<value>\d+(?:\.\d+)?|\.\d+)(?:[ \u00A0]*(?<unit>[A-Za-z]+))?$/;
+
+export function parseBytes(string) {
+	if (typeof string !== 'string') {
+		throw new TypeError(`Expected a string, got \`${typeof string}\``);
+	}
+
+	const match = BYTES_PATTERN.exec(string.trim());
+
+	if (!match) {
+		throw new TypeError(`Invalid byte string: \`${string}\``);
+	}
+
+	const {value, unit = 'B'} = match.groups;
+	const multiplier = PARSE_UNITS.get(unit);
+
+	if (multiplier === undefined) {
+		throw new TypeError(`Unsupported unit: \`${unit}\``);
+	}
+
+	return Number(value) * multiplier;
+}
