+    @property
+    def bearer_token(self):
+        """ The token from an ``Authorization: Bearer <token>`` header, or
+            None if there is no such header or it uses another scheme. The
+            scheme name is matched case-insensitively.
+
+            >>> BaseRequest({'HTTP_AUTHORIZATION': 'Bearer abc.123'}).bearer_token
+            'abc.123'
+            >>> BaseRequest({'HTTP_AUTHORIZATION': 'Basic Zm9vOmJhcg=='}).bearer_token is None
+            True
+        """
+        header = self.environ.get('HTTP_AUTHORIZATION', '')
+        scheme, _, token = header.strip().partition(' ')
+        token = token.strip()
+        if scheme.lower() == 'bearer' and token:
+            return token
+        return None
+
