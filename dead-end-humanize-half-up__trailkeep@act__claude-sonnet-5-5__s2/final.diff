+def percent(value: NumberOrString, precision: int = 1) -> str:
+    """Return a fraction formatted as a percentage.
+
+    Examples:
+        ```pycon
+        >>> percent(0.125)
+        '12.5%'
+        >>> percent(0.5)
+        '50.0%'
+        >>> percent(1)
+        '100.0%'
+        >>> percent(0.12345, 2)
+        '12.35%'
+        >>> percent(0.0625)
+        '6.3%'
+        >>> percent(0.5, 0)
+        '50%'
+        >>> percent("0.25")
+        '25.0%'
+        >>> percent("foo")
+        'foo'
+        >>> percent(None)
+        'None'
+
+        ```
+
+    Args:
+        value (int, float, str): Fraction to format, where 1 is 100%.
+        precision (int): Number of decimal places.
+
+    Returns:
+        str: The value as a percentage, or the input as a string if it is not a number.
+    """
+    import math
+    from decimal import ROUND_HALF_UP, Context, Decimal, localcontext
+
+    try:
+        value = float(value)
+        if not math.isfinite(value):
+            return _format_not_finite(value)
+    except (ValueError, TypeError):
+        return str(value)
+    # Round half up on the decimal repr, as billing does: binary float
+    # formatting would give 6.2 for 6.25 (round-half-even).
+    # The context precision must cover the largest floats (~1e308).
+    precision = int(precision)
+    with localcontext(Context(prec=330 + precision)):
+        exp = Decimal(1).scaleb(-precision)
+        scaled = (Decimal(repr(value)) * 100).quantize(exp, rounding=ROUND_HALF_UP)
+    return f"{scaled:.{int(precision)}f}%"
