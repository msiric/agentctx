 from __future__ import annotations
 
+import typing
+
 import pytest
 
 import humanize
@@ -101,3 +103,30 @@ def test_naturalsize(test_args: list[int] | list[int | bool], expected: str) ->
         test_args[0] = f"-{test_args[0]}"
 
     assert humanize.naturalsize(*test_args) == "-" + expected
+
+
+@pytest.mark.parametrize(
+    "test_args, expected",
+    [
+        ([1500000000], "1.5 GB"),
+        ([10**9], "1.0 GB"),
+        ([0], "0.0 GB"),
+        (["2500000000"], "2.5 GB"),
+        ([-1500000000], "-1.5 GB"),
+        ([1250000000], "1.3 GB"),
+        ([1350000000], "1.4 GB"),
+        ([1250000000, 1], "1.3 GB"),
+        ([2500000000, 0], "3 GB"),
+        ([1234567890, 3], "1.235 GB"),
+        ([10**9, 0], "1 GB"),
+        ([10**12], "1000.0 GB"),
+        (["foo"], "foo"),
+        ([None], "None"),
+        ([float("nan")], "NaN"),
+        ([float("inf")], "+Inf"),
+        ([float("-inf")], "-Inf"),
+    ],
+    ids=str,
+)
+def test_gigabytes(test_args: list[typing.Any], expected: str) -> None:
+    assert humanize.gigabytes(*test_args) == expected
