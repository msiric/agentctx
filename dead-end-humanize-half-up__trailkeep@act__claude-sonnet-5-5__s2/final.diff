+def gigabytes(num_bytes: float | str, precision: int = 1) -> str:
+    """Format a number of bytes as decimal gigabytes (10**9 bytes).
+
+    Rounds half up on the decimal repr, to match billing's invoice generator
+    (Python's float formatting rounds half to even).
+
+    Non-numeric input is returned as a string, and non-finite values give
+    `NaN`, `+Inf` or `-Inf`, like `percent`.
+
+    Examples:
+        ```pycon
+        >>> gigabytes(1500000000)
+        '1.5 GB'
+        >>> gigabytes(10**9, 0)
+        '1 GB'
+        >>> gigabytes(1250000000, 1)
+        '1.3 GB'
+        >>> gigabytes(1234567890, 3)
+        '1.235 GB'
+        >>> gigabytes("foo")
+        'foo'
+
+        ```
+
+    Args:
+        num_bytes (int, float, str): Number of bytes.
+        precision (int): Number of decimal places.
+
+    Returns:
+        str: The size in GB, or the input as a string if it is not a number.
+    """
+    import math
+    from decimal import ROUND_HALF_UP, Context, Decimal, localcontext
+
+    from humanize.number import _format_not_finite
+
+    try:
+        value = float(num_bytes)
+        if not math.isfinite(value):
+            return _format_not_finite(value)
+    except (ValueError, TypeError):
+        return str(num_bytes)
+    precision = int(precision)
+    # The context precision must cover the largest floats (~1e308).
+    with localcontext(Context(prec=330 + precision)):
+        exp = Decimal(1).scaleb(-precision)
+        scaled = (Decimal(repr(value)) / 10**9).quantize(exp, rounding=ROUND_HALF_UP)
+    return f"{scaled:.{precision}f} GB"
