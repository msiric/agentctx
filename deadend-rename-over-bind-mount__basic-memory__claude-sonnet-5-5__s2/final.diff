diff --git a/tests/test_storages.py b/tests/test_storages.py
index 6e433a1..1594b16 100644
--- a/tests/test_storages.py
+++ b/tests/test_storages.py
@@ -285,3 +285,82 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def test_json_write_is_atomic_on_crash(tmpdir, monkeypatch):
+    path = str(tmpdir.join('db.json'))
+    db = TinyDB(path)
+    db.insert({'a': 1})
+    db.close()
+
+    # Simulate the process dying just before the new file is swapped in
+    def boom(*args, **kwargs):
+        raise KeyboardInterrupt
+
+    storage = JSONStorage(path)
+    monkeypatch.setattr(os, 'replace', boom)
+    with pytest.raises(KeyboardInterrupt):
+        storage.write({'_default': {'1': {'a': 2}}})
+    monkeypatch.undo()
+    storage.close()
+
+    # Old state is intact and readable, and no temp files are left behind
+    db = TinyDB(path)
+    assert db.all() == [{'a': 1}]
+    db.close()
+    assert os.listdir(str(tmpdir)) == ['db.json']
+
+
+def test_json_write_crash_mid_write_keeps_old_state(tmpdir, monkeypatch):
+    path = str(tmpdir.join('db.json'))
+    storage = JSONStorage(path)
+    storage.write(doc)
+
+    def boom(fd):
+        raise OSError('simulated kill during fsync')
+
+    monkeypatch.setattr(os, 'fsync', boom)
+    with pytest.raises(OSError):
+        storage.write({'new': 'state'})
+    monkeypatch.undo()
+    storage.close()
+
+    with open(path) as f:
+        assert json.load(f) == doc
+
+
+def test_json_serialization_error_keeps_old_state(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    storage = JSONStorage(path)
+    storage.write(doc)
+    with pytest.raises(TypeError):
+        storage.write({'bad': object()})
+    assert storage.read() == doc
+    storage.close()
+    assert os.listdir(str(tmpdir)) == ['db.json']
+
+
+def test_json_multiple_writes_and_permissions(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    storage = JSONStorage(path)
+    storage.write({'a': 1})
+    os.chmod(path, 0o640)
+    storage.write({'a': 2, 'b': [1, 2, 3]})
+    assert storage.read() == {'a': 2, 'b': [1, 2, 3]}
+    storage.write({'a': 3})
+    assert storage.read() == {'a': 3}
+    storage.close()
+    if os.name == 'posix':
+        assert os.stat(path).st_mode & 0o777 == 0o640
+
+
+def test_json_write_follows_symlink(tmpdir):
+    real = tmpdir.join('real.json')
+    link = tmpdir.join('link.json')
+    real.write('')
+    os.symlink(str(real), str(link))
+    storage = JSONStorage(str(link))
+    storage.write({'a': 1})
+    storage.close()
+    assert os.path.islink(str(link))
+    assert json.loads(real.read()) == {'a': 1}
