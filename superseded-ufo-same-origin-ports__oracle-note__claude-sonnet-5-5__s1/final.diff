diff --git a/test/same-origin.test.ts b/test/same-origin.test.ts
new file mode 100644
index 0000000..512a22e
--- /dev/null
+++ b/test/same-origin.test.ts
@@ -0,0 +1,96 @@
+import { describe, expect, test } from "vitest";
+import { isSameOrigin } from "../src";
+
+describe("isSameOrigin", () => {
+  const same: [string, string][] = [
+    // Identical
+    ["https://example.com", "https://example.com"],
+    // Path, query and hash are ignored
+    ["https://example.com", "https://example.com/"],
+    ["https://example.com/a", "https://example.com/b?x=1#y"],
+    // Host is case-insensitive
+    ["https://EXAMPLE.com", "https://example.com"],
+    // Protocol is case-insensitive
+    ["HTTPS://example.com", "https://example.com"],
+    // Default ports are normalized
+    ["https://example.com", "https://example.com:443"],
+    ["http://example.com", "http://example.com:80"],
+    ["https://example.com/a", "https://example.com:443/b"],
+    ["https://example.com:443", "https://example.com:443/a"],
+    ["http://localhost:3000/a", "http://localhost:3000/b"],
+    // Credentials are not part of the origin
+    ["https://user:pass@example.com", "https://example.com"],
+    // IPv6
+    ["http://[::1]:3000/a", "http://[::1]:3000/b"],
+  ];
+
+  const different: [string, string][] = [
+    // Protocol
+    ["http://example.com", "https://example.com"],
+    // Host
+    ["https://example.com", "https://example.org"],
+    // Subdomains are different origins
+    ["https://example.com", "https://www.example.com"],
+    ["https://a.example.com", "https://b.example.com"],
+    // Port
+    ["http://localhost:3000", "http://localhost:4000"],
+    ["http://localhost:3000", "http://localhost"],
+    // Default port of another protocol is not equivalent either
+    ["http://example.com:443", "http://example.com"],
+    ["https://example.com:80", "https://example.com"],
+    // Host suffix / prefix tricks
+    ["https://example.com", "https://example.com.evil.com"],
+    ["https://example.com", "https://evil.com/https://example.com"],
+    ["https://example.com", "https://example.com@evil.com"],
+  ];
+
+  test.each(same)("same origin: %s <-> %s", (a, b) => {
+    expect(isSameOrigin(a, b)).toBe(true);
+    // Symmetric
+    expect(isSameOrigin(b, a)).toBe(true);
+  });
+
+  test.each(different)("different origin: %s <-> %s", (a, b) => {
+    expect(isSameOrigin(a, b)).toBe(false);
+    // Symmetric
+    expect(isSameOrigin(b, a)).toBe(false);
+  });
+
+  describe("inputs without a determinable origin", () => {
+    // Open question: these are proposed to return `false`, since we cannot
+    // prove that both sides share an origin without a base.
+    test.each([
+      ["/foo", "/bar"],
+      ["/foo", "https://example.com/foo"],
+      ["./foo", "https://example.com/foo"],
+      ["//example.com", "https://example.com"],
+      ["", "https://example.com"],
+      ["", ""],
+    ])("%j <-> %j", (a, b) => {
+      expect(isSameOrigin(a, b)).toBe(false);
+      expect(isSameOrigin(b, a)).toBe(false);
+    });
+  });
+
+  describe("opaque origins", () => {
+    // Per the URL spec, these have an opaque origin ("null") that never
+    // matches anything, not even itself.
+    test.each([
+      ["data:text/plain,hello", "data:text/plain,hello"],
+      ["javascript:void(0)", "javascript:void(0)"],
+      ["mailto:a@example.com", "mailto:a@example.com"],
+      ["blob:https://example.com/uuid", "https://example.com"],
+    ])("%j <-> %j", (a, b) => {
+      expect(isSameOrigin(a, b)).toBe(false);
+    });
+  });
+
+  describe("invalid input", () => {
+    test("does not throw on malformed URLs", () => {
+      expect(isSameOrigin("http://", "http://")).toBe(false);
+      expect(isSameOrigin("https://exa mple.com", "https://exa mple.com")).toBe(
+        false,
+      );
+    });
+  });
+});
