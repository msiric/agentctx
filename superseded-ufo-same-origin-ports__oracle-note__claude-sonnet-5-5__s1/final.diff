+
+/**
+ * Checks whether two URLs share the same origin (protocol, host and port).
+ *
+ * Default ports are normalized (`https://a.com` equals `https://a.com:443`).
+ * Relative URLs and URLs with an opaque origin (`data:`, `blob:`, ...) never match.
+ */
+export function isSameOrigin(a: string, b: string): boolean {
+  const originA = _getOrigin(a);
+  return originA !== undefined && originA === _getOrigin(b);
+}
+
+function _getOrigin(input: string): string | undefined {
+  try {
+    const url = new URL(input);
+    if (url.protocol === "blob:") {
+      return undefined;
+    }
+    return url.origin === "null" ? undefined : url.origin;
+  } catch {
+    return undefined;
+  }
+}
