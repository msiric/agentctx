 export default function decamelize(string: string, options?: Options): string;
+
+/**
+Decamelize each own key of a plain object. The operation is shallow: values are left untouched.
+
+@param object - The plain object whose keys should be decamelized.
+@param options - Options passed through to `decamelize`.
+@returns A new object.
+
+@example
+```
+import {decamelizeKeys} from 'decamelize';
+
+decamelizeKeys({fooBar: 1, bazQux: {innerKey: 2}});
+//=> {foo_bar: 1, baz_qux: {innerKey: 2}}
+
+decamelizeKeys({fooBar: 1}, {separator: '-'});
+//=> {'foo-bar': 1}
+```
+*/
+export function decamelizeKeys(object: Record<string, unknown>, options?: Options): Record<string, unknown>;
