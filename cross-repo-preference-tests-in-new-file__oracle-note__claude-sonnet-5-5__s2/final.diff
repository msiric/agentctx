+/* eslint-disable camelcase -- Expected output keys are snake_case. */
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import {decamelizeKeys} from './index.js';
+
+test('decamelizeKeys', () => {
+	assert.deepEqual(decamelizeKeys({}), {});
+	assert.deepEqual(decamelizeKeys({fooBar: 1, bazQux: 2}), {foo_bar: 1, baz_qux: 2});
+});
+
+test('decamelizeKeys is shallow and leaves values untouched', () => {
+	const inner = {innerKey: 1};
+	const result = decamelizeKeys({outerKey: inner});
+	assert.deepEqual(result, {outer_key: inner});
+	assert.equal(result.outer_key, inner);
+});
+
+test('decamelizeKeys passes options through', () => {
+	assert.deepEqual(decamelizeKeys({fooBar: 1}, {separator: '-'}), {'foo-bar': 1});
+	assert.deepEqual(decamelizeKeys({getURLValue: 1}, {preserveConsecutiveUppercase: true}), {get_URL_value: 1});
+});
+
+test('decamelizeKeys returns a new object and does not mutate the input', () => {
+	const input = {fooBar: 1};
+	const result = decamelizeKeys(input);
+	assert.notEqual(result, input);
+	assert.deepEqual(input, {fooBar: 1});
+});
+
+test('decamelizeKeys skips non-enumerable keys', () => {
+	const input = {ownKey: 2};
+	Object.defineProperty(input, 'hiddenKey', {value: 1, enumerable: false});
+	assert.deepEqual(decamelizeKeys(input), {own_key: 2});
+});
+
+test('decamelizeKeys handles null-prototype objects and `__proto__` keys', () => {
+	const input = Object.create(null);
+	input.fooBar = 1;
+	assert.deepEqual(decamelizeKeys(input), {foo_bar: 1});
+
+	const result = decamelizeKeys(JSON.parse('{"__proto__": 1}'));
+	assert.equal(Object.getPrototypeOf(result), Object.prototype);
+	assert.equal(Object.keys(result)[0], '__proto__');
+});
+
+test('decamelizeKeys rejects non-plain objects', () => {
+	for (const value of [null, undefined, 'foo', 1, [], new Map(), new Date(), () => {}]) {
+		assert.throws(() => decamelizeKeys(value), TypeError);
+	}
+});
