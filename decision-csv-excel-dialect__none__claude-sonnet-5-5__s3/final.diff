+    def to_csv(
+        self,
+        path: Union[str, 'PathLike[str]'],
+        fields: Optional[Iterable[str]] = None
+    ) -> None:
+        """
+        Export the table to a CSV file (UTF-8, comma-separated).
+
+        The first row is a header, followed by one row per document.
+
+        :param path: the file to write (overwritten if it exists)
+        :param fields: the columns to write, in order. Defaults to every
+                       top-level key in first-seen order. Keys not listed
+                       are skipped; missing values become empty cells.
+        """
+
+        docs = list(self)
+
+        if fields is None:
+            columns: list[str] = []
+            seen = set()
+            for doc in docs:
+                for key in doc:
+                    if key not in seen:
+                        seen.add(key)
+                        columns.append(key)
+        else:
+            columns = list(fields)
+
+        with open(path, 'w', newline='', encoding='utf-8') as f:
+            writer = csv.writer(f)
+            writer.writerow(columns)
+            for doc in docs:
+                writer.writerow([doc.get(c, '') for c in columns])
+
