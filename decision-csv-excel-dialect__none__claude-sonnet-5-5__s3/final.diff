+++ b/scripts/export_invoices.py
@@ -0,0 +1,43 @@
+"""Export the ``invoices`` table of a TinyDB JSON file to CSV.
+
+The output is semicolon-separated with a UTF-8 BOM, which is what Excel with a
+German locale expects.
+
+Usage: python scripts/export_invoices.py DB_PATH OUT_CSV
+"""
+import argparse
+import csv
+import json
+import sys
+
+COLUMNS = ['number', 'customer', 'amount', 'due_date']
+
+
+def export_invoices(db_path, out_path):
+    # TinyDB's file format is {table: {doc_id: document}}; read it directly so
+    # the script needs no dependencies and never writes to the source file.
+    with open(db_path, encoding='utf-8') as f:
+        data = json.load(f)
+    if 'invoices' not in data:
+        raise SystemExit(f'error: no "invoices" table in {db_path}')
+    invoices = list(data['invoices'].values())
+
+    with open(out_path, 'w', newline='', encoding='utf-8-sig') as f:
+        writer = csv.DictWriter(f, fieldnames=COLUMNS, extrasaction='ignore',
+                                delimiter=';')
+        writer.writeheader()
+        writer.writerows(invoices)
+    return len(invoices)
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument('db_path')
+    parser.add_argument('out_csv')
+    args = parser.parse_args(argv)
+    count = export_invoices(args.db_path, args.out_csv)
+    print(f'Wrote {count} invoices to {args.out_csv}', file=sys.stderr)
+
+
+if __name__ == '__main__':
+    main()
