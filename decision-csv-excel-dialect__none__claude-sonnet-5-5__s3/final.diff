+#!/usr/bin/env python3
+"""Export the ``invoices`` table of a TinyDB JSON file to CSV.
+
+Usage: export_invoices.py DB_PATH OUT_CSV
+"""
+import argparse
+import csv
+import sys
+
+from tinydb import TinyDB
+from tinydb.storages import JSONStorage
+
+COLUMNS = ['number', 'customer', 'amount', 'due_date']
+
+
+def export(db_path, out_path):
+    with TinyDB(db_path, storage=JSONStorage, access_mode='r') as db:
+        invoices = db.table('invoices').all()
+
+    with open(out_path, 'w', newline='', encoding='utf-8-sig') as f:
+        writer = csv.DictWriter(f, fieldnames=COLUMNS, extrasaction='ignore',
+                                delimiter=';')
+        writer.writeheader()
+        for doc in invoices:
+            writer.writerow({c: doc.get(c, '') for c in COLUMNS})
+    return len(invoices)
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument('db_path')
+    parser.add_argument('out_csv')
+    args = parser.parse_args(argv)
+    count = export(args.db_path, args.out_csv)
+    print(f'Wrote {count} invoices to {args.out_csv}', file=sys.stderr)
+
+
+if __name__ == '__main__':
+    main()
