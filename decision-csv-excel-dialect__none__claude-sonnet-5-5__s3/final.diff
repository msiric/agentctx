@@ -197,3 +197,52 @@ def test_persist_empty_does_not_wipe_existing_data(tmpdir):
     assert len(table) == 1
     assert table.all() == [{'a': 1}]
     db.close()
+
+
+def _read_csv(path):
+    import csv
+    with open(path, newline='', encoding='utf-8') as f:
+        return list(csv.reader(f))
+
+
+def test_to_csv_default_fields(db, tmp_path):
+    out = tmp_path / 'out.csv'
+    db.to_csv(out)
+
+    assert _read_csv(out) == [['int', 'char'], ['1', 'a'], ['1', 'b'], ['1', 'c']]
+
+
+def test_to_csv_first_seen_order_and_missing(db, tmp_path):
+    db.truncate()
+    db.insert({'b': 1})
+    db.insert({'a': 2, 'b': 3})
+    out = tmp_path / 'out.csv'
+    db.to_csv(out)
+
+    assert _read_csv(out) == [['b', 'a'], ['1', ''], ['3', '2']]
+
+
+def test_to_csv_fields_select_and_order(db, tmp_path):
+    out = tmp_path / 'out.csv'
+    db.to_csv(out, fields=['char', 'nope'])
+
+    assert _read_csv(out) == [['char', 'nope'], ['a', ''], ['b', ''], ['c', '']]
+
+
+def test_to_csv_quoting_and_unicode(db, tmp_path):
+    db.truncate()
+    db.insert({'name': 'Müller, "Hans"\nJr', 'n': 0})
+    out = tmp_path / 'out.csv'
+    db.to_csv(out)
+
+    assert _read_csv(out) == [['name', 'n'], ['Müller, "Hans"\nJr', '0']]
+
+
+def test_to_csv_empty_table(db, tmp_path):
+    db.truncate()
+    out = tmp_path / 'out.csv'
+    db.to_csv(out)
+    assert _read_csv(out) == [[]]
+
+    db.to_csv(out, fields=['a'])
+    assert _read_csv(out) == [['a']]
