     db.close()
+
+
+def _read_csv(path):
+    import csv
+    with open(path, newline='', encoding='utf-8') as f:
+        return list(csv.reader(f))
+
+
+def test_to_csv_default_fields(db, tmp_path):
+    db.truncate()
+    db.insert({'a': 1, 'b': 'x'})
+    db.insert({'c': 3, 'a': 2})
+    path = tmp_path / 'out.csv'
+
+    db.table('_default').to_csv(path)
+
+    assert _read_csv(path) == [['a', 'b', 'c'], ['1', 'x', ''], ['2', '', '3']]
+
+
+def test_to_csv_selected_fields(db, tmp_path):
+    db.truncate()
+    db.insert({'a': 1, 'b': 'x', 'c': 3})
+    path = tmp_path / 'out.csv'
+
+    db.table('_default').to_csv(path, fields=['c', 'a', 'zzz'])
+
+    assert _read_csv(path) == [['c', 'a', 'zzz'], ['3', '1', '']]
+
+
+def test_to_csv_empty_table(db, tmp_path):
+    db.truncate()
+    path = tmp_path / 'out.csv'
+
+    db.table('_default').to_csv(path, fields=['a'])
+
+    assert _read_csv(path) == [['a']]
+
+
+def test_to_csv_quoting_and_unicode(db, tmp_path):
+    db.truncate()
+    db.insert({'a': 'x,"y"\nz', 'b': 'é'})
+    path = tmp_path / 'out.csv'
+
+    db.table('_default').to_csv(path)
+
+    assert _read_csv(path) == [['a', 'b'], ['x,"y"\nz', 'é']]
