     db.close()
+
+
+def test_to_csv_default_fields(db, tmp_path):
+    import csv
+    db.drop_tables()
+    table = db.table('csv')
+    table.insert({'a': 1, 'b': 'x'})
+    table.insert({'c': 'ü,"q"', 'a': 2})
+    path = tmp_path / 'out.csv'
+    table.to_csv(str(path))
+
+    with open(path, newline='', encoding='utf-8') as f:
+        rows = list(csv.reader(f))
+    assert rows == [['a', 'b', 'c'], ['1', 'x', ''], ['2', '', 'ü,"q"']]
+
+
+def test_to_csv_fields_select_and_order(db, tmp_path):
+    import csv
+    table = db.table('csv')
+    table.insert({'a': 1, 'b': 2})
+    table.insert({'a': 3})
+    path = tmp_path / 'out.csv'
+    table.to_csv(str(path), fields=['b', 'a', 'zzz'])
+
+    with open(path, newline='', encoding='utf-8') as f:
+        rows = list(csv.reader(f))
+    assert rows == [['b', 'a', 'zzz'], ['2', '1', ''], ['', '3', '']]
+
+
+def test_to_csv_empty_table(db, tmp_path):
+    path = tmp_path / 'out.csv'
+    db.table('empty').to_csv(str(path), fields=['a'])
+    assert path.read_text(encoding='utf-8').splitlines() == ['a']
