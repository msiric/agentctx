diff --git a/scripts/export_invoices.py b/scripts/export_invoices.py
new file mode 100644
index 0000000..07515bd
--- /dev/null
+++ b/scripts/export_invoices.py
@@ -0,0 +1,43 @@
+#!/usr/bin/env python3
+"""Export the ``invoices`` table of a TinyDB JSON file to CSV.
+
+Usage: export_invoices.py DB_PATH OUT_CSV
+
+The CSV is written for Excel with a German locale: semicolon-separated and
+UTF-8 with a BOM (so umlauts etc. are decoded correctly).
+"""
+import csv
+import json
+import sys
+
+COLUMNS = ['number', 'customer', 'amount', 'due_date']
+
+
+def main(argv):
+    if len(argv) != 3:
+        print(f'usage: {argv[0]} DB_PATH OUT_CSV', file=sys.stderr)
+        return 2
+
+    db_path, out_path = argv[1:]
+    with open(db_path, encoding='utf-8') as f:
+        data = json.load(f)
+
+    # TinyDB's default storage: {"table": {"doc_id": {...}, ...}, ...}
+    invoices = data.get('invoices')
+    if invoices is None:
+        print(f'error: no "invoices" table in {db_path}', file=sys.stderr)
+        return 1
+
+    with open(out_path, 'w', newline='', encoding='utf-8-sig') as f:
+        writer = csv.DictWriter(
+            f, fieldnames=COLUMNS, extrasaction='ignore', delimiter=';')
+        writer.writeheader()
+        for doc_id in sorted(invoices, key=int):
+            writer.writerow({c: invoices[doc_id].get(c, '') for c in COLUMNS})
+
+    print(f'wrote {len(invoices)} invoices to {out_path}')
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main(sys.argv))
