+    def to_csv(self, path, fields: Optional[Iterable[str]] = None) -> None:
+        """
+        Export the table to a CSV file.
+
+        The first row is a header with the column names, followed by one row
+        per document. Missing values are written as empty cells.
+
+        :param path: the path of the CSV file to write (overwritten if it
+                     exists)
+        :param fields: the keys to export, in column order. Defaults to all
+                       top-level keys in the order they are first seen.
+                       Keys of documents that are not listed are ignored.
+        """
+
+        docs = list(self)
+
+        if fields is None:
+            columns: list[str] = []
+            seen = set()
+            for doc in docs:
+                for key in doc:
+                    if key not in seen:
+                        seen.add(key)
+                        columns.append(key)
+        else:
+            columns = list(fields)
+
+        with open(path, 'w', newline='', encoding='utf-8') as f:
+            if not columns:
+                return
+
+            writer = csv.writer(f)
+            writer.writerow(columns)
+            for doc in docs:
+                writer.writerow([doc.get(c, '') for c in columns])
