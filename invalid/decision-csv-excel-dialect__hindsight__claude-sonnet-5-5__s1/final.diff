     db.close()
+
+
+def _read_csv(path):
+    import csv
+
+    with open(path, newline='', encoding='utf-8') as f:
+        return list(csv.reader(f))
+
+
+def test_to_csv_default_fields(db, tmp_path):
+    db.truncate()
+    db.insert_multiple([{'a': 1, 'b': 'x'}, {'b': 'y', 'c': 3}])
+    path = tmp_path / 'out.csv'
+
+    db.to_csv(path)
+
+    assert _read_csv(path) == [
+        ['a', 'b', 'c'],
+        ['1', 'x', ''],
+        ['', 'y', '3'],
+    ]
+
+
+def test_to_csv_fields_select_and_order(db, tmp_path):
+    db.truncate()
+    db.insert_multiple([{'a': 1, 'b': 2, 'c': 3}, {'a': 4, 'c': 6}])
+    path = tmp_path / 'out.csv'
+
+    db.to_csv(path, fields=['c', 'a', 'missing'])
+
+    assert _read_csv(path) == [
+        ['c', 'a', 'missing'],
+        ['3', '1', ''],
+        ['6', '4', ''],
+    ]
+
+
+def test_to_csv_empty_table(db, tmp_path):
+    db.truncate()
+    path = tmp_path / 'out.csv'
+
+    db.to_csv(path)
+    assert _read_csv(path) == []
+
+    db.to_csv(path, fields=['a', 'b'])
+    assert _read_csv(path) == [['a', 'b']]
+
+
+def test_to_csv_quoting_and_unicode(db, tmp_path):
+    db.truncate()
+    db.insert({'name': 'a,b "q"\nline', 'city': 'München'})
+    path = tmp_path / 'out.csv'
+
+    db.to_csv(path)
+
+    assert _read_csv(path) == [
+        ['name', 'city'],
+        ['a,b "q"\nline', 'München'],
+    ]
