@@ -0,0 +1,53 @@
+#!/usr/bin/env python3
+"""Export the ``invoices`` table of a TinyDB JSON file to CSV.
+
+Usage: python scripts/export_invoices.py DB_PATH OUT_CSV
+"""
+import csv
+import json
+import sys
+
+COLUMNS = ['number', 'customer', 'amount', 'due_date']
+
+# Finance opens the file in Excel with a German locale: it expects ';' as the
+# list separator and a UTF-8 BOM ('utf-8-sig') to detect the encoding.
+DELIMITER = ';'
+ENCODING = 'utf-8-sig'
+
+
+def export_invoices(db_path, out_path):
+    with open(db_path, encoding='utf-8') as f:
+        data = json.load(f)
+
+    # TinyDB layout: {table_name: {doc_id: {field: value, ...}, ...}, ...}
+    table = data.get('invoices', {})
+
+    def sort_key(item):
+        doc_id = item[0]
+        return (0, int(doc_id)) if str(doc_id).isdigit() else (1, str(doc_id))
+
+    with open(out_path, 'w', newline='', encoding=ENCODING) as f:
+        writer = csv.DictWriter(f, fieldnames=COLUMNS, delimiter=DELIMITER,
+                                extrasaction='ignore')
+        writer.writeheader()
+        for _, doc in sorted(table.items(), key=sort_key):
+            writer.writerow({c: doc.get(c, '') for c in COLUMNS})
+
+    return len(table)
+
+
+def main(argv):
+    if len(argv) != 3:
+        print(f'usage: {argv[0]} DB_PATH OUT_CSV', file=sys.stderr)
+        return 2
+    try:
+        count = export_invoices(argv[1], argv[2])
+    except (OSError, json.JSONDecodeError) as e:
+        print(f'error: {e}', file=sys.stderr)
+        return 1
+    print(f'Wrote {count} invoices to {argv[2]}')
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main(sys.argv))
