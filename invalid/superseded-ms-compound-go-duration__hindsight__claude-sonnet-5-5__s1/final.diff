+ */
+function fmtCompound(ms: number): StringValue {
+  let rest = Math.floor(Math.abs(ms) / s);
+  const parts: string[] = [];
+  for (const [unit, size] of [
+    ['d', d / s],
+    ['h', h / s],
+    ['m', m / s],
+    ['s', 1],
+  ] as const) {
+    const count = Math.floor(rest / size);
+    rest -= count * size;
+    if (count > 0) {
