+def test_yaml_storage(tmpdir):
+    pytest.importorskip('yaml')
+
+    path = str(tmpdir.join('test.yaml'))
+    with TinyDB(path, storage=YAMLStorage) as db:
+        db.insert(doc)
+        db.update({'name': 'foo'})
+
+        assert db.all() == [{**doc, 'name': 'foo'}]
+        assert db.contains(where('name') == 'foo')
+
+    # No Python-specific tags, so the file stays safe-loadable
+    assert '!' not in tmpdir.join('test.yaml').read()
+
+    # Data persists across instances
+    with TinyDB(path, storage=YAMLStorage) as db:
+        assert len(db) == 1
+        assert db.get(where('name') == 'foo') == {**doc, 'name': 'foo'}
+        db.truncate()
+
+    with TinyDB(path, storage=YAMLStorage) as db:
+        assert len(db) == 0
+
+
+def test_yaml_storage_empty_and_kwargs(tmpdir):
+    pytest.importorskip('yaml')
+
+    path = str(tmpdir.join('test.yaml'))
+    storage = YAMLStorage(path, sort_keys=False)
+    assert storage.read() is None
+
+    storage.write({'b': 1, 'a': 2})
+    assert tmpdir.join('test.yaml').read().splitlines() == ['b: 1', 'a: 2']
+    assert storage.read() == {'b': 1, 'a': 2}
+
+    # Shrinking the data truncates the file
+    storage.write({'a': 1})
+    assert storage.read() == {'a': 1}
+    storage.close()
+
+
+def test_yaml_storage_read_only(tmpdir):
+    pytest.importorskip('yaml')
+
+    path = str(tmpdir.join('test.yaml'))
+    YAMLStorage(path).close()
+
+    storage = YAMLStorage(path, access_mode='r')
+    with pytest.raises(IOError):
+        storage.write({'a': 1})
+    storage.close()
+
+
+def test_yaml_storage_create_dirs(tmpdir):
+    pytest.importorskip('yaml')
+
+    path = str(tmpdir.join('sub', 'dir', 'test.yaml'))
+    with TinyDB(path, storage=YAMLStorage, create_dirs=True) as db:
+        db.insert({'a': 1})
+    assert os.path.exists(path)
