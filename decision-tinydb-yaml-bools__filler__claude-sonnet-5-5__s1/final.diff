+def test_yaml(tmpdir):
+    path = str(tmpdir.join('test.yaml'))
+    storage = YAMLStorage(path)
+    assert storage.read() is None
+
+    storage.write(doc)
+    assert doc == storage.read()
+    storage.close()
+
+
+def test_yaml_shrinking_write(tmpdir):
+    path = str(tmpdir.join('test.yaml'))
+    storage = YAMLStorage(path)
+    storage.write(doc)
+    storage.write({'a': 1})
+    assert storage.read() == {'a': 1}
+    storage.close()
+
+    with open(path) as f:
+        assert f.read() == 'a: 1\n'
+
+
+def test_yaml_with_tinydb(tmpdir):
+    path = str(tmpdir.join('test.yaml'))
+
+    with TinyDB(path, storage=YAMLStorage) as db:
+        db.insert({'a': 1})
+        db.insert({'a': 2})
+        db.table('other').insert({'b': 'x'})
+
+    with TinyDB(path, storage=YAMLStorage) as db:
+        assert db.all() == [{'a': 1}, {'a': 2}]
+        assert db.search(where('a') == 2) == [{'a': 2}]
+        assert db.table('other').all() == [{'b': 'x'}]
+        assert db.get(doc_id=2) == {'a': 2}
+
+
+def test_yaml_kwargs(tmpdir):
+    path = str(tmpdir.join('test.yaml'))
+    db = TinyDB(path, storage=YAMLStorage, default_flow_style=False, sort_keys=True)
+    db.insert({'b': 1, 'a': 2})
+    db.close()
+
+    with open(path) as f:
+        assert f.read() == "_default:\n  '1':\n    a: 2\n    b: 1\n"
+
+
+def test_yaml_readonly(tmpdir):
+    path = str(tmpdir.join('test.yaml'))
+    with open(path, 'w') as f:
+        f.write('_default: {}\n')
+
+    storage = YAMLStorage(path, access_mode='r')
+    assert storage.read() == {'_default': {}}
+    with pytest.raises(IOError):
+        storage.write({})
+    storage.close()
+
+
+def test_yaml_create_dirs(tmpdir):
+    path = str(tmpdir.join('sub', 'dir', 'test.yaml'))
+    YAMLStorage(path, create_dirs=True).close()
+    assert os.path.exists(path)
