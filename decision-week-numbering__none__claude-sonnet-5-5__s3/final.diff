diff --git a/src/index.js b/src/index.js
index 3ea001b..ff0fb5b 100644
--- a/src/index.js
+++ b/src/index.js
@@ -7,6 +7,17 @@ var MAP = {
 		return d.getMonth() + 1;
 	},
 	DD: 'getDate',
+	DDD: function (d) {
+		// day of year (1-366); UTC math avoids DST skew
+		var y = d.getFullYear();
+		return (Date.UTC(y, d.getMonth(), d.getDate()) - Date.UTC(y, 0, 1)) / 864e5 + 1;
+	},
+	WW: function (d) {
+		// ISO 8601 week number (1-53): weeks start Monday, week 1 contains Jan 4th
+		var t = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));
+		t.setUTCDate(t.getUTCDate() + 4 - (t.getUTCDay() || 7)); // nearest Thursday
+		return Math.ceil(((t - Date.UTC(t.getUTCFullYear(), 0, 1)) / 864e5 + 1) / 7);
+	},
 	HH: 'getHours',
 	mm: 'getMinutes',
 	ss: 'getSeconds',
