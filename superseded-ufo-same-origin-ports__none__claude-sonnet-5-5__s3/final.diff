@@ -773,3 +782,49 @@ export function withoutHost(input: string) {
   const parsed = parseURL(input);
   return (parsed.pathname || "/") + parsed.search + parsed.hash;
 }
+
+const SAME_ORIGIN_RE = /^([a-z][\d+.a-z-]*):\/\/([^#/?\\]*)/i;
+const SAME_ORIGIN_PORT_RE = /:(\d*)$/;
+const SAME_ORIGIN_PROTOCOLS = new Set(["http", "https", "ws", "wss", "ftp"]);
+
+// Returns "scheme://host[:port]" with the port as written, or undefined
+function getOriginTuple(input: unknown): string | undefined {
+  if (typeof input !== "string" || /[\u0000- ]/.test(input)) {
+    return undefined;
+  }
+  const match = input.match(SAME_ORIGIN_RE);
+  if (!match) {
+    return undefined;
+  }
+  const protocol = match[1]!.toLowerCase();
+  if (!SAME_ORIGIN_PROTOCOLS.has(protocol)) {
+    return undefined;
+  }
+  const authority = match[2]!.slice(match[2]!.lastIndexOf("@") + 1);
+  let hostname: string;
+  try {
+    // Validates the URL and normalizes case / IDNA
+    hostname = new URL(`${protocol}://${authority}`).hostname;
+  } catch {
+    return undefined;
+  }
+  if (!hostname) {
+    return undefined;
+  }
+  const port = authority.match(SAME_ORIGIN_PORT_RE)?.[1];
+  return `${protocol}://${hostname}${port ? `:${Number(port)}` : ""}`;
+}
+
+/**
+ * Checks whether two absolute URLs share the same origin (scheme, host and port).
+ *
+ * Ports are compared as written (`https://a.com` and `https://a.com:443` differ).
+ * Relative, protocol-relative, invalid and opaque-origin URLs are never same-origin.
+ */
+export function isSameOrigin(
+  a: string | undefined,
+  b: string | undefined,
+): boolean {
+  const originA = getOriginTuple(a);
+  return originA !== undefined && originA === getOriginTuple(b);
+}
