diff --git a/test/same-origin.test.ts b/test/same-origin.test.ts
new file mode 100644
index 0000000..b0a42a5
--- /dev/null
+++ b/test/same-origin.test.ts
@@ -0,0 +1,117 @@
+import { describe, expect, test } from "vitest";
+import { isSameOrigin } from "../src";
+
+// Proposed semantics: two URLs are same-origin when scheme, host and port all
+// match. Ports are compared strictly as written: no default-port
+// normalization, so "https://a.com" !== "https://a.com:443". Path, query, hash
+// and userinfo are ignored. Anything without a tuple origin is never same-origin.
+
+describe("isSameOrigin", () => {
+  describe("same origin", () => {
+    test.each([
+      ["https://example.com", "https://example.com"],
+      ["https://example.com", "https://example.com/"],
+      ["https://example.com/a", "https://example.com/b"],
+      ["https://example.com/a?x=1", "https://example.com/b?y=2"],
+      ["https://example.com/#a", "https://example.com/#b"],
+      ["http://localhost:3000/a", "http://localhost:3000/b"],
+      ["http://127.0.0.1:8080", "http://127.0.0.1:8080/x"],
+      ["http://[::1]:8080/a", "http://[::1]:8080/b"],
+    ])("%s ~ %s", (a, b) => {
+      expect(isSameOrigin(a, b)).toBe(true);
+      expect(isSameOrigin(b, a)).toBe(true); // symmetric
+    });
+
+    test("is reflexive", () => {
+      expect(isSameOrigin("https://example.com/a", "https://example.com/a")).toBe(true);
+    });
+  });
+
+  describe("normalization (case and userinfo only)", () => {
+    test.each([
+      ["scheme is case-insensitive", "HTTPS://example.com", "https://example.com"],
+      ["host is case-insensitive", "https://EXAMPLE.com", "https://example.com"],
+      ["userinfo is ignored", "https://user:pass@example.com", "https://example.com"],
+      ["different userinfo", "https://a@example.com", "https://b@example.com"],
+    ])("%s", (_name, a, b) => {
+      expect(isSameOrigin(a, b)).toBe(true);
+    });
+  });
+
+  describe("different origin", () => {
+    test.each([
+      ["different scheme", "http://example.com", "https://example.com"],
+      ["different host", "https://example.com", "https://example.org"],
+      ["subdomain", "https://example.com", "https://www.example.com"],
+      ["different port", "https://example.com:8443", "https://example.com"],
+      ["explicit default port is NOT normalized (https)", "https://example.com:443", "https://example.com"],
+      ["explicit default port is NOT normalized (http)", "http://example.com:80/a", "http://example.com/b"],
+      ["explicit default port is NOT normalized (ws)", "ws://example.com:80", "ws://example.com"],
+      ["explicit default port is NOT normalized (wss)", "wss://example.com:443", "wss://example.com"],
+      ["explicit non-default port", "http://example.com:8080", "http://example.com"],
+      ["default port of other scheme", "http://example.com:443", "http://example.com"],
+      ["ws vs http", "ws://example.com", "http://example.com"],
+      ["userinfo host spoof", "https://example.com@evil.com", "https://example.com"],
+      ["suffix host", "https://example.com.evil.com", "https://example.com"],
+      ["prefix host", "https://evilexample.com", "https://example.com"],
+      ["trailing dot host", "https://example.com.", "https://example.com"],
+      ["ipv4 vs hostname", "http://127.0.0.1", "http://localhost"],
+    ])("%s", (_name, a, b) => {
+      expect(isSameOrigin(a, b)).toBe(false);
+      expect(isSameOrigin(b, a)).toBe(false);
+    });
+  });
+
+  describe("relative and protocol-relative inputs", () => {
+    // Without a base there is nothing to resolve against, so these have no
+    // origin of their own and must not match anything.
+    test.each([
+      ["/foo", "/bar"],
+      ["foo", "foo"],
+      ["./foo", "./foo"],
+      ["", ""],
+      ["/foo", "https://example.com/foo"],
+      ["https://example.com/foo", "/foo"],
+    ])("%j vs %j is false", (a, b) => {
+      expect(isSameOrigin(a, b)).toBe(false);
+    });
+
+    test("protocol-relative URLs are not comparable (OPEN QUESTION)", () => {
+      expect(isSameOrigin("//example.com", "//example.com")).toBe(false);
+      expect(isSameOrigin("//example.com", "https://example.com")).toBe(false);
+    });
+  });
+
+  describe("opaque / non-tuple origins", () => {
+    test.each([
+      ["data:text/plain,hi", "data:text/plain,hi"],
+      ["javascript:alert(1)", "javascript:alert(1)"],
+      ["mailto:a@example.com", "mailto:a@example.com"],
+      ["blob:https://example.com/uuid", "blob:https://example.com/uuid"],
+      ["file:///a", "file:///a"],
+    ])("%s is never same-origin, even with itself", (a, b) => {
+      expect(isSameOrigin(a, b)).toBe(false);
+    });
+  });
+
+  describe("invalid / missing input", () => {
+    test.each([
+      [undefined, undefined],
+      [undefined, "https://example.com"],
+      ["https://example.com", undefined],
+      [null as any, "https://example.com"],
+      ["https://", "https://"],
+      ["http://exa mple.com", "http://exa mple.com"],
+      ["https://example.com:99999", "https://example.com:99999"],
+    ])("%j vs %j is false and does not throw", (a, b) => {
+      expect(() => isSameOrigin(a as any, b as any)).not.toThrow();
+      expect(isSameOrigin(a as any, b as any)).toBe(false);
+    });
+  });
+
+  describe("internationalized hosts (OPEN QUESTION)", () => {
+    test("unicode and punycode forms are equal", () => {
+      expect(isSameOrigin("https://münchen.de", "https://xn--mnchen-3ya.de")).toBe(true);
+    });
+  });
+});
