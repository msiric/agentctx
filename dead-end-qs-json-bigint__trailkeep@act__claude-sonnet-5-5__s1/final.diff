diff --git a/test/parse.js b/test/parse.js
index 00a1abf..c2faec5 100644
--- a/test/parse.js
+++ b/test/parse.js
@@ -1492,3 +1492,50 @@ test('rejects an invalid `arrayFormatSeparator`', () => {
 
 	assert.deepEqual(structuredClone(queryString.parse('foo=a·b', {arrayFormat: 'separator', arrayFormatSeparator: '·'})), {foo: ['a', 'b']});
 });
+
+test('`json` type decodes the value as JSON', () => {
+	const query = `filter=${encodeURIComponent('{"status":"open","ids":[1,2],"n":null}')}&list=%5B1%2C%222%22%5D&num=42&flag=true&text=%22hi%22`;
+	assert.deepEqual(structuredClone(queryString.parse(query, {
+		types: {
+			filter: 'json', list: 'json', num: 'json', flag: 'json', text: 'json',
+		},
+	})), {
+		filter: {status: 'open', ids: [1, 2], n: null},
+		list: [1, '2'],
+		num: 42,
+		flag: true,
+		text: 'hi',
+	});
+});
+
+test('`json` type keeps a value that is not valid JSON as a string', () => {
+	assert.deepEqual(structuredClone(queryString.parse('a=%7Bnope&b=&c=abc&d=%7B%22a%22', {
+		types: {
+			a: 'json', b: 'json', c: 'json', d: 'json',
+		},
+	})), {
+		a: '{nope', b: '', c: 'abc', d: '{"a"',
+	});
+});
+
+test('`json` type keeps a valueless key as `null`', () => {
+	assert.deepEqual(structuredClone(queryString.parse('a', {types: {a: 'json'}})), {a: null});
+});
+
+test('`json` type only applies to its key and takes precedence over `parseNumbers`', () => {
+	assert.deepEqual(structuredClone(queryString.parse('a=1&b=%7B%7D', {parseNumbers: true, types: {b: 'json'}})), {a: 1, b: {}});
+});
+
+test('`json` type keeps a value with an integer that would be rounded as a string', () => {
+	const options = {types: {a: 'json'}};
+	assert.deepEqual(structuredClone(queryString.parse('a=1274593846275813376', options)), {a: '1274593846275813376'});
+	const rounded = encodeURIComponent('{"accountId":1274593846275813376}');
+	assert.deepEqual(structuredClone(queryString.parse(`a=${rounded}`, options)), {a: '{"accountId":1274593846275813376}'});
+	const quoted = encodeURIComponent('{"accountId":"1274593846275813376"}');
+	assert.deepEqual(structuredClone(queryString.parse(`a=${quoted}`, options)), {a: {accountId: '1274593846275813376'}});
+	assert.deepEqual(structuredClone(queryString.parse('a=9007199254740991&b=1e400', {types: {a: 'json', b: 'json'}})), {a: 9_007_199_254_740_991, b: '1e400'});
+});
+
+test('`json` type is applied to each item of a repeated key', () => {
+	assert.deepEqual(structuredClone(queryString.parse('a=1&a=%7B%7D&a=x', {types: {a: 'json'}})), {a: [1, {}, 'x']});
+});
