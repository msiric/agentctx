+// Returns `undefined` when the value is not valid JSON, or when it has an integer literal outside the safe range, like `1274593846275813377`. `JSON.parse()` rounds those to the nearest double, and a neighbouring ID would decode to the same number, so decoding would silently change the number, so the caller keeps the string.
+function parseJson(value) {
+	let isLossy = false;
+	let result;
+	try {
+		result = JSON.parse(value, (key, parsed, {source}) => {
+			if (typeof parsed === 'number' && (!Number.isFinite(parsed) || (/^-?\d+$/v.test(source) && !Number.isSafeInteger(parsed)))) {
+				isLossy = true;
+			}
+
+			return parsed;
+		});
+	} catch {
+		return undefined;
+	}
+
+	return isLossy ? undefined : result;
+}
+
 function parseValue(value, options, type) {
+	if (type === 'json') {
+		if (typeof value === 'string') {
+			const parsed = parseJson(value);
+			if (parsed !== undefined) {
+				return parsed;
+			}
+		}
+
+		return value;
+	}
+
 	if (type === 'string' && typeof value === 'string') {
 		return value;
 	}
