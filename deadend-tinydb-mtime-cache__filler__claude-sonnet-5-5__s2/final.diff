+"""
+Benchmark TinyDB read performance on a large JSON database.
+
+Usage: python scripts/bench_read.py [--size-mb 40] [--repeat 5] [--path FILE] [--keep]
+
+Generates a db of roughly --size-mb, then times db.all(), an uncached
+search, a repeated (query-cache hit) search, and the raw json.load, and
+prints a cProfile breakdown of one uncached search.
+"""
+import argparse
+import cProfile
+import json
+import os
+import pstats
+import random
+import statistics
+import sys
+import tempfile
+import time
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))
+
+from tinydb import TinyDB, where  # noqa: E402
+
+
+def generate(path, size_mb):
+    rng = random.Random(0)
+    target = size_mb * 1024 * 1024
+    docs, size, i = {}, 0, 0
+    while size < target:
+        i += 1
+        doc = {
+            'name': 'user%d' % i,
+            'age': rng.randint(1, 90),
+            'tags': [rng.choice('abcdefgh') * 5 for _ in range(5)],
+            'address': {'city': 'city%d' % rng.randint(1, 500), 'zip': rng.randint(10000, 99999)},
+            'bio': ''.join(rng.choices('abcdefghij ', k=200)),
+        }
+        docs[str(i)] = doc
+        size += 330  # rough estimate; real size checked after dump
+    with open(path, 'w') as f:
+        json.dump({'_default': docs}, f)
+    return len(docs)
+
+
+def timeit(fn, repeat):
+    times = []
+    for _ in range(repeat):
+        t = time.perf_counter()
+        fn()
+        times.append(time.perf_counter() - t)
+    return statistics.median(times), min(times)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--size-mb', type=float, default=40)
+    ap.add_argument('--repeat', type=int, default=5)
+    ap.add_argument('--path')
+    ap.add_argument('--keep', action='store_true')
+    a = ap.parse_args()
+
+    tmpdir = None
+    path = a.path
+    if not path:
+        tmpdir = tempfile.mkdtemp()
+        path = os.path.join(tmpdir, 'bench.json')
+    if not os.path.exists(path) or not a.path:
+        n = generate(path, a.size_mb)
+    print('db: %s (%.1f MB)' % (path, os.path.getsize(path) / 1e6))
+
+    db = TinyDB(path)
+    print('docs: %d' % len(db))
+
+    def row(label, fn):
+        med, best = timeit(fn, a.repeat)
+        print('%-34s median %8.1f ms   best %8.1f ms' % (label, med * 1e3, best * 1e3))
+
+    with open(path) as f:
+        raw = f.read()
+    row('json.loads only (floor)', lambda: json.loads(raw))
+    row('storage.read()', db.storage.read)
+    row('db.all()', db.all)
+
+    counter = iter(range(10**9))
+    row('search (uncached, new query each)', lambda: db.search(where('age') == (next(counter) % 90) + 1000))
+    q = where('age') == 42
+    db.search(q)
+    row('search (query-cache hit)', lambda: db.search(q))
+    row('db.get(doc_id=1)', lambda: db.get(doc_id=1))
+
+    print('\ncProfile of one uncached search:')
+    pr = cProfile.Profile()
+    pr.enable()
+    db.search(where('age') == -1)
+    pr.disable()
+    pstats.Stats(pr).sort_stats('cumulative').print_stats(8)
+
+    db.close()
+    if not a.keep and tmpdir:
+        os.remove(path)
+        os.rmdir(tmpdir)
+
+
+if __name__ == '__main__':
+    main()
