+def gigabytes(num_bytes: float | str, precision: int = 1) -> str:
+    """Format a number of bytes as decimal gigabytes (10**9 bytes).
+
+    Always uses GB, regardless of magnitude.
+
+    Examples:
+        ```pycon
+        >>> gigabytes(1500000000)
+        '1.5 GB'
+        >>> gigabytes(2 * 10**9, 0)
+        '2 GB'
+        >>> gigabytes(123456789, 3)
+        '0.123 GB'
+        >>> gigabytes(-1500000000)
+        '-1.5 GB'
+        >>> gigabytes("foo")
+        'foo'
+
+        ```
+
+    Args:
+        num_bytes (int, float, str): Number of bytes.
+        precision (int): Number of digits after the decimal point.
+
+    Returns:
+        str: The size in GB, or the input as a string if it is not a number.
+    """
+    import math
+
+    from humanize.number import _format_not_finite
+
+    try:
+        value = float(num_bytes)
+    except (ValueError, TypeError):
+        return str(num_bytes)
+    if not math.isfinite(value):
+        return _format_not_finite(value)
+    return f"{value / 10**9:.{int(precision)}f} GB"
diff --git a/src/humanize/number.py b/src/humanize/number.py
