--- a/src/humanize/number.py
+++ b/src/humanize/number.py
@@ -601,3 +601,55 @@ def metric(value: float, unit: str = "", precision: int = 3) -> str:
         space = " "
 
     return f"{value_}{space}{ordinal_}{unit}"
+
+
+def percent(value: NumberOrString, precision: int = 1) -> str:
+    """Format a fraction as a percentage.
+
+    Examples:
+        ```pycon
+        >>> percent(0.125)
+        '12.5%'
+        >>> percent(0.5)
+        '50.0%'
+        >>> percent(1)
+        '100.0%'
+        >>> percent(0.12345, 2)
+        '12.35%'
+        >>> percent(0.0625)
+        '6.3%'
+        >>> percent(0.125, 0)
+        '13%'
+        >>> percent(0.5, 0)
+        '50%'
+        >>> percent("0.25")
+        '25.0%'
+        >>> percent("foo")
+        'foo'
+
+        ```
+
+    Args:
+        value (int, float, str): Fraction to format, where 1 is 100%.
+        precision (int): Number of digits after the decimal point. Ties round
+            half up (away from zero), e.g. 6.25 becomes 6.3.
+
+    Returns:
+        str: The percentage, or the input as a string if it is not a number.
+    """
+    import decimal
+    import math
+
+    try:
+        value = float(value)
+        if not math.isfinite(value):
+            return _format_not_finite(value)
+    except (ValueError, TypeError):
+        return str(value)
+    # Round half up on the decimal repr (not binary float, and not
+    # round-half-even) so ties come out as invoices print them.
+    exact = decimal.Decimal(repr(value)) * 100
+    rounded = exact.quantize(
+        decimal.Decimal(1).scaleb(-int(precision)), rounding=decimal.ROUND_HALF_UP
+    )
+    return f"{rounded:f}%"
diff --git a/tests/test_filesize.py b/tests/test_filesize.py
index 645751b..8af6723 100644
--- a/tests/test_filesize.py
+++ b/tests/test_filesize.py
@@ -2,6 +2,8 @@
 
 from __future__ import annotations
 
+import typing
+
 import pytest
 
 import humanize
@@ -101,3 +103,32 @@ def test_naturalsize(test_args: list[int] | list[int | bool], expected: str) ->
         test_args[0] = f"-{test_args[0]}"
 
     assert humanize.naturalsize(*test_args) == "-" + expected
+
+
+@pytest.mark.parametrize(
+    "test_args, expected",
+    [
+        ([1_500_000_000], "1.5 GB"),
+        ([0], "0.0 GB"),
+        ([10**9], "1.0 GB"),
+        ([10**12], "1000.0 GB"),
+        ([123_456_789], "0.1 GB"),
+        ([123_456_789, 3], "0.123 GB"),
+        ([2 * 10**9, 0], "2 GB"),
+        ([1_500_000_000.0], "1.5 GB"),
+        (["1500000000"], "1.5 GB"),
+        ([-1_500_000_000], "-1.5 GB"),
+        (["foo"], "foo"),
+        ([None], "None"),
+        ([float("nan")], "NaN"),
+        ([float("inf")], "+Inf"),
+        ([float("-inf")], "-Inf"),
+    ],
+    ids=str,
+)
+def test_gigabytes(test_args: list[typing.Any], expected: str) -> None:
+    assert humanize.gigabytes(*test_args) == expected
+
+
+def test_gigabytes_precision_keyword() -> None:
+    assert humanize.gigabytes(1_234_000_000, precision=2) == "1.23 GB"
