+class TestStatsHook(unittest.TestCase):
+    def test_called_after_every_attempt_including_last(self) -> None:
+        seen: list[tuple[int, float]] = []
+        thing = NoneReturnUntilAfterCount(2)
+        retrying = Retrying(
+            wait=tenacity.wait_fixed(0.01),
+            stop=tenacity.stop_after_attempt(5),
+            retry=tenacity.retry_if_result(lambda r: r is None),
+            stats_hook=lambda st: seen.append((st["attempt_number"], st["idle_for"])),
+        )
+        retrying(thing.go)
+        self.assertEqual([a for a, _ in seen], [1, 2, 3])
+
+    def test_called_when_giving_up(self) -> None:
+        calls: list[int] = []
+
+        @retry(
+            stop=tenacity.stop_after_attempt(2),
+            reraise=True,
+            stats_hook=lambda st: calls.append(st["attempt_number"]),
+        )
+        def fail() -> None:
+            raise ValueError
+
+        with self.assertRaises(ValueError):
+            fail()
+        self.assertEqual(calls, [1, 2])
+
+    def test_hook_error_is_ignored(self) -> None:
