+@contextlib.contextmanager
+def swallow_hook_errors(what: str) -> typing.Iterator[None]:
+    """
+    Keep a failing logging/metrics call from affecting the retried call.
+
+    Any ``Exception`` raised inside the block is logged at debug level and
+    dropped, so a broken logger or metrics client never turns a retryable
+    failure (or a success) into a different outcome.
+    """
+    try:
+        yield
+    except Exception:
+        _logger.debug("Ignoring error raised by %s", what, exc_info=True)
+
