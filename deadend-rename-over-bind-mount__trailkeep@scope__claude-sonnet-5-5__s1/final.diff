index 6e433a1..9f6d6e3 100644
--- a/tests/test_storages.py
+++ b/tests/test_storages.py
@@ -285,3 +285,74 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def _crash_writes(path, monkeypatch, fail_at):
+    """Open a storage and make the write die at the given step."""
+    storage = JSONStorage(path)
+    storage.write({'_default': {'1': {'a': 1}}})
+
+    def boom(*args, **kwargs):
+        raise KeyboardInterrupt('simulated crash')
+
+    monkeypatch.setattr(storage, fail_at, boom)
+    with pytest.raises(KeyboardInterrupt):
+        storage.write({'_default': {'1': {'a': 2}, '2': {'b': 3}}})
+    storage._handle.close()
+
+
+def test_crash_before_in_place_write(tmpdir, monkeypatch):
+    path = str(tmpdir.join('db.json'))
+    _crash_writes(path, monkeypatch, '_write_in_place')
+
+    # Journal is complete, so the interrupted write is replayed
+    db = TinyDB(path)
+    assert len(db) == 2
+    assert not os.path.exists(path + '.journal')
+    db.close()
+
+
+def test_crash_during_journal_write(tmpdir, monkeypatch):
+    path = str(tmpdir.join('db.json'))
+    storage = JSONStorage(path)
+    storage.write({'_default': {'1': {'a': 1}}})
+    storage._handle.close()
+
+    # Simulate a torn journal: database file untouched
+    with open(path + '.journal', 'wb') as f:
+        f.write(b'deadbeef\n{"_default": {"1": {"a"')
+
+    db = TinyDB(path)
+    assert db.all() == [{'a': 1}]
+    assert not os.path.exists(path + '.journal')
+    db.close()
+
+
+def test_crash_mid_in_place_write(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    storage = JSONStorage(path)
+    storage.write({'_default': {'1': {'a': 1}}})
+    storage._handle.close()
+
+    new = json.dumps({'_default': {'1': {'a': 2}, '2': {'b': 3}}})
+    storage = JSONStorage(path)
+    storage._write_journal(new)
+    storage._handle.close()
+    # Database file truncated halfway, as after an OOM kill
+    with open(path, 'w') as f:
+        f.write(new[:10])
+
+    db = TinyDB(path)
+    assert len(db) == 2
+    db.close()
+
+
+def test_write_leaves_no_journal_and_keeps_inode(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    db = TinyDB(path)
+    inode = os.stat(path).st_ino
+    db.insert({'x': 1})
+    db.insert({'x': 2})
+    assert os.stat(path).st_ino == inode  # written in place, no rename
+    assert not os.path.exists(path + '.journal')
+    db.close()
