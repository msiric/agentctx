         # Open the file for reading/writing
         self._handle = open(path, mode=self._mode, encoding=encoding)
+        self._journal_path = str(path) + '.journal'
+
+        if self._handle.writable():
+            self._recover()
+
+    def _recover(self) -> None:
+        """
+        Finish or discard a write that was interrupted by a crash.
+
+        Before every in-place write, the new contents are saved to a journal
+        file (checksummed). If the journal is complete, the interrupted write
+        is replayed; if it is incomplete, the database file was never touched
+        and the journal is simply discarded.
+        """
+        try:
+            with open(self._journal_path, 'rb') as journal:
+                raw = journal.read()
+        except FileNotFoundError:
+            return
+
+        digest, _, payload = raw.partition(b'\n')
+        if hashlib.sha256(payload).hexdigest().encode() == digest:
+            self._write_in_place(payload.decode('utf-8'))
+
+        os.remove(self._journal_path)
+
+    def _write_in_place(self, serialized: str) -> None:
+        self._handle.seek(0)
+        self._handle.write(serialized)
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+
+        # Remove data that is behind the new cursor in case the file has
+        # gotten shorter
+        self._handle.truncate()
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+
+    def _write_journal(self, serialized: str) -> None:
+        payload = serialized.encode('utf-8')
+        digest = hashlib.sha256(payload).hexdigest().encode()
+        with open(self._journal_path, 'wb') as journal:
+            journal.write(digest + b'\n' + payload)
+            journal.flush()
+            os.fsync(journal.fileno())
+
+        # Make the journal's directory entry durable (best effort)
+        try:
+            fd = os.open(os.path.dirname(os.path.abspath(self._journal_path)), os.O_RDONLY)
+            try:
+                os.fsync(fd)
+            finally:
+                os.close(fd)
+        except OSError:
+            pass
 
     def close(self) -> None:
         self._handle.close()
