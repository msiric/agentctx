diff --git a/test/same-origin.test.ts b/test/same-origin.test.ts
new file mode 100644
index 0000000..b42acd9
--- /dev/null
+++ b/test/same-origin.test.ts
@@ -0,0 +1,164 @@
+import { describe, expect, test } from "vitest";
+import { isSameOrigin } from "../src";
+
+// Proposed semantics (to be agreed before implementation):
+// - Origin = protocol + hostname + port (like the WHATWG `URL.origin`).
+// - Path, query, hash and credentials (user:pass@) are ignored.
+// - Protocol and hostname are case-insensitive.
+// - Default ports are normalized: `https://example.com` and
+//   `https://example.com:443` (and http with :80) are the same origin.
+//   Non-default ports must match exactly.
+// - Inputs without an origin (relative paths, protocol-relative, opaque
+//   schemes like data:/blob:/javascript:, empty/invalid) are never same-origin,
+//   not even with themselves.
+
+describe("isSameOrigin", () => {
+  const same: [string, string][] = [
+    ["https://example.com", "https://example.com"],
+    ["https://example.com", "https://example.com/"],
+    // path, query and hash are ignored
+    ["https://example.com/a", "https://example.com/b"],
+    ["https://example.com/a?x=1", "https://example.com/b?y=2"],
+    ["https://example.com/#a", "https://example.com/#b"],
+    // credentials are ignored
+    ["https://user:pass@example.com", "https://example.com"],
+    // case-insensitive protocol and host
+    ["HTTPS://EXAMPLE.COM", "https://example.com"],
+    ["https://Example.com/Path", "https://example.com/path"],
+    ["http://example.com:8080", "http://example.com:8080/x"],
+    // IPs and localhost
+    // default ports are normalized
+    ["https://example.com", "https://example.com:443"],
+    ["http://example.com", "http://example.com:80"],
+    ["wss://example.com", "wss://example.com:443"],
+    ["https://example.com:443", "https://example.com/x"],
+    ["http://localhost:3000/a", "http://localhost:3000/b"],
+    ["http://127.0.0.1:3000", "http://127.0.0.1:3000/x"],
+    ["http://[::1]:3000", "http://[::1]:3000/x"],
+  ];
+
+  for (const [a, b] of same) {
+    test(`same: ${a} === ${b}`, () => {
+      expect(isSameOrigin(a, b)).toBe(true);
+      // symmetric
+      expect(isSameOrigin(b, a)).toBe(true);
+    });
+  }
+
+  const different: [string, string][] = [
+    // protocol
+    ["http://example.com", "https://example.com"],
+    ["ws://example.com", "wss://example.com"],
+    // host
+    ["https://example.com", "https://example.org"],
+    ["https://example.com", "https://www.example.com"],
+    ["https://example.com", "https://example.com.evil.com"],
+    ["https://example.com", "https://sub.example.com"],
+    // port
+    ["https://example.com", "https://example.com:8443"],
+    ["http://example.com", "http://example.com:8080"],
+    ["http://example.com:80", "https://example.com:80"],
+    ["https://example.com:443", "http://example.com:443"],
+    // userinfo trick: real host is evil.com
+    ["https://example.com", "https://example.com@evil.com"],
+    ["https://example.com", "https://example.com:pass@evil.com"],
+    // backslash is treated as a slash for special schemes, host is evil.com
+    ["https://example.com", "https://evil.com\\@example.com"],
+    // IPv4 vs. IPv6 loopback
+    ["http://127.0.0.1", "http://[::1]"],
+  ];
+
+  for (const [a, b] of different) {
+    test(`different: ${a} !== ${b}`, () => {
+      expect(isSameOrigin(a, b)).toBe(false);
+      expect(isSameOrigin(b, a)).toBe(false);
+    });
+  }
+
+  describe("ports", () => {
+    test("explicit default port equals an omitted port", () => {
+      expect(isSameOrigin("https://example.com", "https://example.com:443")).toBe(
+        true,
+      );
+      expect(isSameOrigin("http://example.com:80", "http://example.com")).toBe(
+        true,
+      );
+    });
+
+    test("default port of another scheme is not normalized", () => {
+      expect(isSameOrigin("https://example.com", "https://example.com:80")).toBe(
+        false,
+      );
+      expect(isSameOrigin("http://example.com", "http://example.com:443")).toBe(
+        false,
+      );
+    });
+  });
+
+  describe("inputs without an origin", () => {
+    const noOrigin = [
+      "",
+      "/",
+      "/path",
+      "./path",
+      "../path",
+      "path",
+      "?query",
+      "#hash",
+      // protocol-relative: origin depends on the base, so unknown here
+      "//example.com",
+      // opaque origins
+      "data:text/plain,hello",
+      "blob:https://example.com/uuid",
+      "javascript:alert(1)",
+      "mailto:a@example.com",
+    ];
+
+    for (const input of noOrigin) {
+      test(`never same-origin: ${JSON.stringify(input)}`, () => {
+        expect(isSameOrigin(input, input)).toBe(false);
+        expect(isSameOrigin(input, "https://example.com")).toBe(false);
+        expect(isSameOrigin("https://example.com", input)).toBe(false);
+      });
+    }
+
+    test("undefined / null / empty", () => {
+      expect(isSameOrigin(undefined, undefined)).toBe(false);
+      expect(isSameOrigin(undefined, "https://example.com")).toBe(false);
+      expect(isSameOrigin("https://example.com", undefined)).toBe(false);
+      expect(isSameOrigin(null, null)).toBe(false);
+    });
+  });
+
+  describe("whitespace / control characters", () => {
+    test("leading whitespace and control chars do not bypass the check", () => {
+      expect(isSameOrigin(" https://example.com", "https://example.com")).toBe(
+        true,
+      );
+      expect(isSameOrigin("\0https://evil.com", "https://example.com")).toBe(
+        false,
+      );
+      expect(isSameOrigin("\thttps://example.com", "https://example.com")).toBe(
+        true,
+      );
+    });
+  });
+
+  describe("internationalized hosts", () => {
+    test("unicode and punycode forms are equal", () => {
+      expect(isSameOrigin("https://münchen.de", "https://xn--mnchen-3ya.de")).toBe(
+        true,
+      );
+    });
+  });
+
+  describe("trailing dot", () => {
+    // Open question: a trailing-dot FQDN is technically a different origin
+    // for browsers. Proposed: treat as different (no normalization).
+    test("example.com. is a different origin than example.com", () => {
+      expect(isSameOrigin("https://example.com.", "https://example.com")).toBe(
+        false,
+      );
+    });
+  });
+});
