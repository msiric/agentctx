 }
+
+function _getOrigin(input: string | null | undefined): string | undefined {
+  if (!input) {
+    return undefined;
+  }
+  try {
+    const url = new URL(input);
+    // Opaque origins (data:, javascript:, mailto:, ...) have no host.
+    // `blob:` inherits the origin of its payload, but is never treated as one.
+    if (!url.host || url.protocol === "blob:") {
+      return undefined;
+    }
+    // `URL.origin` lowercases protocol/host, punycodes the host and drops
+    // default ports (https:443, http:80), so explicit default ports match.
+    return url.origin;
+  } catch {
+    return undefined;
+  }
+}
+
+/**
+ * Check if two URLs have the same origin (protocol + hostname + port).
+ *
+ * Path, query, hash and credentials are ignored. Default ports are normalized
+ * (`https://a.com` equals `https://a.com:443`); other ports must match.
+ * Inputs without an origin (relative, protocol-relative, opaque, empty) are
+ * never same-origin.
+ *
+ * @group utils
+ */
+export function isSameOrigin(
+  a: string | null | undefined,
+  b: string | null | undefined,
+): boolean {
+  const originA = _getOrigin(a);
+  return originA !== undefined && originA === _getOrigin(b);
+}
