diff --git a/test/same-origin.test.ts b/test/same-origin.test.ts
new file mode 100644
index 0000000..b7ffeb8
--- /dev/null
+++ b/test/same-origin.test.ts
@@ -0,0 +1,179 @@
+import { describe, expect, test } from "vitest";
+import { isSameOrigin } from "../src";
+
+// Semantics (proposed): two inputs are same-origin when both are absolute URLs
+// with a tuple-origin (scheme, host, port) and all three match.
+//  - scheme and host are case-insensitive
+//  - ports are compared strictly: no default-port normalization, so
+//    `https://x` and `https://x:443` are NOT the same origin
+//  - userinfo, path, query and hash are ignored
+//  - inputs without an origin (relative, protocol-relative, opaque) never match,
+//    not even against themselves. We can't know what they resolve against.
+
+describe("isSameOrigin", () => {
+  describe("same origin", () => {
+    const cases: [string, string][] = [
+      ["https://example.com", "https://example.com"],
+      ["https://example.com", "https://example.com/"],
+      ["https://example.com/a", "https://example.com/b"],
+      ["https://example.com/a?x=1#h", "https://example.com/b?y=2#g"],
+      ["http://example.com:8080/a", "http://example.com:8080/b"],
+      ["https://user:pass@example.com/a", "https://example.com/b"],
+      ["https://a@example.com", "https://b@example.com"],
+      ["http://[::1]:3000/a", "http://[::1]:3000/b"],
+    ];
+    for (const [a, b] of cases) {
+      test(`${a} ~ ${b}`, () => {
+        expect(isSameOrigin(a, b)).toBe(true);
+        expect(isSameOrigin(b, a)).toBe(true); // symmetric
+      });
+    }
+  });
+
+  describe("case-insensitivity", () => {
+    const cases: [string, string][] = [
+      ["HTTPS://example.com", "https://example.com"],
+      ["https://EXAMPLE.com", "https://example.com"],
+      ["https://Example.COM/A", "https://example.com/a"], // path case is irrelevant
+    ];
+    for (const [a, b] of cases) {
+      test(`${a} ~ ${b}`, () => {
+        expect(isSameOrigin(a, b)).toBe(true);
+      });
+    }
+  });
+
+  // Strict port comparison: no default-port normalization. An omitted port is
+  // never equal to an explicit one, even if it is the scheme's default.
+  describe("ports are compared strictly", () => {
+    const different: [string, string][] = [
+      ["https://example.com", "https://example.com:443"],
+      ["http://example.com", "http://example.com:80"],
+      ["wss://example.com", "wss://example.com:443"],
+      ["ws://example.com", "ws://example.com:80"],
+      ["https://example.com", "https://example.com:80"],
+      ["http://example.com", "http://example.com:443"],
+      ["https://example.com", "https://example.com:8443"],
+    ];
+    for (const [a, b] of different) {
+      test(`${a} !~ ${b}`, () => {
+        expect(isSameOrigin(a, b)).toBe(false);
+        expect(isSameOrigin(b, a)).toBe(false);
+      });
+    }
+
+    test("identical explicit default ports still match", () => {
+      expect(
+        isSameOrigin("https://example.com:443/a", "https://example.com:443/b"),
+      ).toBe(true);
+    });
+  });
+
+  describe("different origin", () => {
+    const cases: [string, string][] = [
+      // scheme
+      ["http://example.com", "https://example.com"],
+      ["ws://example.com", "http://example.com"],
+      // host
+      ["https://example.com", "https://example.org"],
+      ["https://example.com", "https://www.example.com"],
+      ["https://a.example.com", "https://example.com"],
+      ["https://example.com", "https://example.com.evil.com"],
+      // port
+      ["http://localhost:3000", "http://localhost:4000"],
+      ["http://localhost", "http://localhost:3000"],
+      // userinfo trick: real host is evil.com
+      ["https://example.com@evil.com", "https://example.com"],
+      ["https://example.com:443@evil.com", "https://example.com"],
+      // IPv6 / IPv4
+      ["http://[::1]:3000", "http://127.0.0.1:3000"],
+      ["http://[::1]:3000", "http://[::1]:3001"],
+    ];
+    for (const [a, b] of cases) {
+      test(`${a} !~ ${b}`, () => {
+        expect(isSameOrigin(a, b)).toBe(false);
+        expect(isSameOrigin(b, a)).toBe(false);
+      });
+    }
+  });
+
+  describe("inputs without an origin never match", () => {
+    const originless = [
+      "",
+      "/",
+      "/path",
+      "path/to",
+      "./path",
+      "../path",
+      "?q=1",
+      "#hash",
+      "//example.com", // protocol-relative: scheme unknown
+      "//example.com/path",
+    ];
+    for (const input of originless) {
+      test(`${JSON.stringify(input)} vs absolute`, () => {
+        expect(isSameOrigin(input, "https://example.com")).toBe(false);
+        expect(isSameOrigin("https://example.com", input)).toBe(false);
+      });
+      test(`${JSON.stringify(input)} vs itself`, () => {
+        expect(isSameOrigin(input, input)).toBe(false);
+      });
+    }
+  });
+
+  describe("opaque origins never match", () => {
+    const opaque = [
+      "data:text/plain,hello",
+      "javascript:alert(1)",
+      "vbscript:msgbox",
+      "blob:https://example.com/uuid",
+      "mailto:a@example.com",
+      "file:///etc/passwd", // file: has an opaque origin
+    ];
+    for (const input of opaque) {
+      test(`${input} vs itself`, () => {
+        expect(isSameOrigin(input, input)).toBe(false);
+      });
+      test(`${input} vs https://example.com`, () => {
+        expect(isSameOrigin(input, "https://example.com")).toBe(false);
+      });
+    }
+  });
+
+  describe("tricky inputs", () => {
+    test("leading whitespace / control chars are stripped like browsers do", () => {
+      expect(
+        isSameOrigin("  https://example.com/a", "https://example.com"),
+      ).toBe(true);
+      expect(isSameOrigin("\0https://example.com", "https://example.com")).toBe(
+        true,
+      );
+    });
+
+    test("backslash is a path separator for special schemes", () => {
+      // WHATWG: host is example.com, rest is the path
+      expect(
+        isSameOrigin("https://example.com\\@evil.com", "https://example.com"),
+      ).toBe(true);
+      expect(isSameOrigin("https:\\\\example.com", "https://example.com")).toBe(
+        true,
+      );
+      expect(isSameOrigin("https:\\\\evil.com", "https://example.com")).toBe(
+        false,
+      );
+    });
+
+    test("trailing dot in host is NOT normalized", () => {
+      // Browsers treat these as distinct origins
+      expect(isSameOrigin("https://example.com.", "https://example.com")).toBe(
+        false,
+      );
+    });
+
+    test("non-string / nullish input returns false instead of throwing", () => {
+      expect(isSameOrigin(undefined as any, "https://example.com")).toBe(false);
+      expect(isSameOrigin("https://example.com", null as any)).toBe(false);
+      expect(isSameOrigin(undefined as any, undefined as any)).toBe(false);
+    });
+  });
+});
