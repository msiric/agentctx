@@ -773,3 +788,56 @@ export function withoutHost(input: string) {
   const parsed = parseURL(input);
   return (parsed.pathname || "/") + parsed.search + parsed.hash;
 }
+
+const SAME_ORIGIN_PORT_RE = /:(\d+)$/;
+
+function getTupleOrigin(input: unknown): string | undefined {
+  if (typeof input !== "string") {
+    return undefined;
+  }
+  let url: URL;
+  try {
+    url = new URL(input);
+  } catch {
+    return undefined;
+  }
+  // Opaque origins (data:, javascript:, file:, ...). `blob:` inherits the
+  // origin of its inner URL per WHATWG, but is never treated as same-origin here.
+  if (url.origin === "null" || url.protocol === "blob:") {
+    return undefined;
+  }
+  // `URL` drops default ports, so read the explicit port from the raw authority.
+  // Scheme is special here (non-opaque origin), so `\` acts as `/`.
+  // eslint-disable-next-line no-control-regex
+  const raw = input.replace(/^[\u0000- ]+/, "").replace(/[\t\n\r]/g, "");
+  const authority = raw
+    .slice(raw.indexOf(":") + 1)
+    .replace(/^[/\\]+/, "")
+    .split(/[/\\?#]/, 1)[0]
+    .split("@")
+    .pop()!;
+  const port = SAME_ORIGIN_PORT_RE.exec(authority)?.[1];
+  return `${url.protocol}//${url.hostname}:${port === undefined ? "" : Number(port)}`;
+}
+
+/**
+ * Checks if two URLs have the same origin (scheme, host and port).
+ *
+ * Ports are compared strictly (`https://x` and `https://x:443` differ).
+ * Userinfo, path, query and hash are ignored. Inputs without a tuple origin
+ * (relative, protocol-relative, opaque such as `data:` or `file:`) never match.
+ *
+ * @example
+ *
+ * ```js
+ * isSameOrigin("https://example.com/a", "https://example.com/b"); // true
+ * isSameOrigin("https://example.com", "https://example.com:8080"); // false
+ * isSameOrigin("/a", "/a"); // false
+ * ```
+ *
+ * @group utils
+ */
+export function isSameOrigin(a: string, b: string): boolean {
+  const originA = getTupleOrigin(a);
+  return originA !== undefined && originA === getTupleOrigin(b);
+}
