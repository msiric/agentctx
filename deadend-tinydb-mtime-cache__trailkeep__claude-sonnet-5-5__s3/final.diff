@@ -136,10 +143,24 @@ class JSONStorage(Storage):
             # Return the cursor to the beginning of the file
             self._handle.seek(0)
 
-            # Load the JSON contents of the file
-            return json.load(self._handle)
+            # Reading the raw contents is cheap compared to parsing them, and
+            # comparing them detects changes made by other processes
+            raw = self._handle.read()
