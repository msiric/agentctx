diff --git a/test/dashdash.js b/test/dashdash.js
new file mode 100644
index 0000000..6ff379e
--- /dev/null
+++ b/test/dashdash.js
@@ -0,0 +1,27 @@
+const test = require('tape');
+const fn = require('../lib');
+
+test('-- option: collects args after bare --', t => {
+	t.deepEqual(
+		fn(['a', '--foo', 'x', '--', '--bar', 'b', '-c'], { '--': true }),
+		{ _: ['a'], foo: 'x', '--': ['--bar', 'b', '-c'] }
+	);
+	t.end();
+});
+
+test('-- option: empty array when no bare --', t => {
+	t.deepEqual(fn(['a', '-x'], { '--': true }), { _: ['a'], x: true, '--': [] });
+	t.deepEqual(fn(['a', '--'], { '--': true }), { _: ['a'], '--': [] });
+	t.end();
+});
+
+test('-- option: values are not coerced', t => {
+	t.deepEqual(fn(['--', '1', 'true'], { '--': true })['--'], ['1', 'true']);
+	t.end();
+});
+
+test('-- option: unset keeps default behavior', t => {
+	t.deepEqual(fn(['a', '--', '--b', 'c']), { _: ['a', '--b', 'c'] });
+	t.deepEqual(fn(['--', 'b'], { '--': false }), { _: ['b'] });
+	t.end();
+});
