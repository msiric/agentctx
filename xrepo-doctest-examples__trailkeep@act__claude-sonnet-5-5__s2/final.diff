+def statement_types(sql: str, encoding: str | None = None) -> list[str]:
+    """Return the type of each statement in *sql*, in order.
+
+    Each entry is what :meth:`~sqlparse.sql.Statement.get_type` returns
+    for the corresponding statement found by :func:`parse`.
+
+    >>> statement_types("select 1; insert into t values (1)")
+    ['SELECT', 'INSERT']
+
+    :param sql: A string containing one or more SQL statements.
+    :param encoding: The encoding of the statement (optional).
+    :returns: A list of strings such as ``'SELECT'`` or ``'UNKNOWN'``.
+    """
+    return [stmt.get_type() for stmt in parse(sql, encoding)]
+
+
 def parsestream(
     stream: str | IO[str], encoding: str | None = None
 ) -> Generator[sql.Statement, None, None]:
