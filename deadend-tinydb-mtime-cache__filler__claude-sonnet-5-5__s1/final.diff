@@ -0,0 +1,117 @@
+"""
+Benchmark TinyDB read performance on a large JSON database.
+
+Usage: python scripts/bench_read.py [--size-mb 40] [--path /tmp/bench.json] [--keep]
+
+Generates a database of roughly ``--size-mb`` megabytes, then times
+``db.all()`` and ``db.search()`` and breaks the cost down into JSON parsing,
+Document wrapping and query evaluation.
+"""
+import argparse
+import json
+import os
+import random
+import string
+import sys
+import tempfile
+import time
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))
+
+from tinydb import TinyDB, Query  # noqa: E402
+from tinydb.table import Document  # noqa: E402
+
+
+def timed(fn, repeat=3):
+    best = float('inf')
+    result = None
+    for _ in range(repeat):
+        start = time.perf_counter()
+        result = fn()
+        best = min(best, time.perf_counter() - start)
+    return best, result
+
+
+def generate(path, size_mb, seed=0):
+    rng = random.Random(seed)
+    words = [''.join(rng.choices(string.ascii_lowercase, k=8)) for _ in range(500)]
+
+    def make_doc():
+        return {
+            'name': rng.choice(words),
+            'age': rng.randint(0, 100),
+            'tags': rng.sample(words, 5),
+            'bio': ' '.join(rng.choices(words, k=20)),
+            'nested': {'x': rng.random(), 'y': rng.random()},
+        }
+
+    # Estimate the serialized size of one document, then generate enough
+    sample = sum(len(json.dumps(make_doc())) + 10 for _ in range(1000)) / 1000
+    count = int(size_mb * 1024 * 1024 / sample)
+    docs = {str(i): make_doc() for i in range(1, count + 1)}
+    with open(path, 'w') as f:
+        json.dump({'_default': docs}, f)
+    return count
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--size-mb', type=float, default=40)
+    ap.add_argument('--path', default=os.path.join(tempfile.gettempdir(), 'tinydb_bench.json'))
+    ap.add_argument('--keep', action='store_true')
+    args = ap.parse_args()
+
+    t0 = time.perf_counter()
+    n = generate(args.path, args.size_mb)
+    real = os.path.getsize(args.path) / 1024 / 1024
+    print(f'generated {n} docs, {real:.1f} MB in {time.perf_counter() - t0:.1f}s\n')
+
+    db = TinyDB(args.path)
+    q = Query()
+    rows = []
+
+    # Breakdown of the pieces
+    def raw_read():
+        with open(args.path) as f:
+            return f.read()
+    t_io, text = timed(raw_read)
+    t_parse, data = timed(lambda: json.loads(text))
+    table = data['_default']
+    t_wrap = timed(lambda: [Document(d, int(k)) for k, d in table.items()])[0]
+    cond = q.age > 90
+    t_query = timed(lambda: [d for d in table.values() if cond(d)])[0]
+
+    # End-to-end
+    t_storage = timed(db.storage.read)[0]
+    t_all = timed(db.all)[0]
+
+    def search_fresh():
+        db.clear_cache()
+        return db.search(q.age > 90)
+    t_search = timed(search_fresh)[0]
+    db.search(q.age > 90)
+    t_cached = timed(lambda: db.search(q.age > 90))[0]
+    t_other = timed(lambda: db.search(q.name == 'zzz'), repeat=1)[0]
+
+    rows = [
+        ('file read() only', t_io),
+        ('json.loads only', t_parse),
+        ('wrap docs in Document', t_wrap),
+        ('evaluate query on parsed data', t_query),
+        ('--- end to end ---', None),
+        ('storage.read()', t_storage),
+        ('db.all()', t_all),
+        ('db.search() uncached', t_search),
+        ('db.search() same query, cached', t_cached),
+        ('db.search() new query', t_other),
+    ]
+    for label, t in rows:
+        print(f'{label:34s}' + ('' if t is None else f'{t * 1000:10.1f} ms'))
+
+    db.close()
+    if not args.keep:
+        os.remove(args.path)
+
+
+if __name__ == '__main__':
+    main()
