+    def _run_jobs(self, jobs: List["Job"], delay_seconds: int = 0) -> None:
+        """
+        Run every job in ``jobs``, even if some raise. After all have run,
+        the first exception is re-raised (the others are logged).
+        """
+        first_exc: Optional[Exception] = None
+        for i, job in enumerate(jobs):
+            try:
+                self._run_job(job)
+            except Exception as exc:
+                if first_exc is None:
+                    first_exc = exc
+                else:
+                    logger.error("Job %s raised: %r", job, exc, exc_info=True)
+            if delay_seconds and i < len(jobs) - 1:
+                time.sleep(delay_seconds)
+        if first_exc is not None:
+            raise first_exc
