+    def test_run_pending_no_exception_when_all_succeed(self):
+        ok1, ok2 = make_mock_job("ok1"), make_mock_job("ok2")
+        with mock_datetime(2010, 1, 6, 12, 15, 0):
+            every().second.do(ok1)
+            every().second.do(ok2)
+        with mock_datetime(2010, 1, 6, 12, 15, 2):
+            schedule.run_pending()
+        assert ok1.call_count == 1
+        assert ok2.call_count == 1
+
+    def test_run_pending_runs_other_jobs_when_one_fails(self):
+        ok1, ok2 = make_mock_job("ok1"), make_mock_job("ok2")
+        bad = make_mock_job("bad")
+        bad.side_effect = ValueError("boom")
+        with mock_datetime(2010, 1, 6, 12, 15, 0):
+            every().second.do(ok1)
+            failing = every().second.do(bad)
+            every().second.do(ok2)
+        with mock_datetime(2010, 1, 6, 12, 15, 2):
+            with self.assertRaises(ValueError) as cm:
+                schedule.run_pending()
+            assert str(cm.exception) == "boom"
+            assert ok1.call_count == 1
+            assert bad.call_count == 1
+            assert ok2.call_count == 1
+            # failed job was rescheduled, so it is not retried immediately
+            assert failing.last_run is not None
+            assert failing.next_run > datetime.datetime.now()
+            schedule.run_pending()
+            assert bad.call_count == 1
+
+    def test_run_pending_raises_first_of_multiple_failures(self):
+        bad1, bad2, ok = (make_mock_job(n) for n in ("bad1", "bad2", "ok"))
+        bad1.side_effect = ValueError("first")
+        bad2.side_effect = KeyError("second")
+        with mock_datetime(2010, 1, 6, 12, 15, 0):
+            every().second.do(bad1)
+            every().second.do(bad2)
+            every().second.do(ok)
+        with mock_datetime(2010, 1, 6, 12, 15, 2):
+            with self.assertRaises(ValueError):
+                schedule.run_pending()
+        assert bad1.call_count == bad2.call_count == ok.call_count == 1
+
+    def test_run_all_runs_other_jobs_when_one_fails(self):
+        bad, ok = make_mock_job("bad"), make_mock_job("ok")
+        bad.side_effect = ValueError("boom")
+        every().minute.do(bad)
+        every().minute.do(ok)
+        with self.assertRaises(ValueError):
+            schedule.run_all()
+        assert ok.call_count == 1
+
     def test_run_all(self):
