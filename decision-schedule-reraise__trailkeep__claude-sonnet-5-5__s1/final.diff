diff --git a/test_schedule.py b/test_schedule.py
index f497826..2a04846 100644
--- a/test_schedule.py
+++ b/test_schedule.py
@@ -1597,3 +1597,71 @@ class SchedulerTests(TestCase):
         scheduler.every()
         scheduler.every(10).seconds
         scheduler.run_pending()
+
+    def test_run_pending_continues_after_job_error(self):
+        scheduler = schedule.Scheduler()
+        ran = []
+
+        def bad(name):
+            ran.append(name)
+            raise ValueError(name)
+
+        def good():
+            ran.append("good")
+
+        scheduler.every().second.do(bad, "bad1")
+        scheduler.every().second.do(good)
+        scheduler.every().second.do(bad, "bad2")
+        with mock_datetime(2024, 1, 1, 0, 0, 0):
+            scheduler.run_pending()  # nothing due yet
+        with mock_datetime(2024, 1, 1, 0, 0, 5):
+            scheduler.jobs[0].next_run = datetime.datetime(2024, 1, 1)
+            scheduler.jobs[1].next_run = datetime.datetime(2024, 1, 1)
+            scheduler.jobs[2].next_run = datetime.datetime(2024, 1, 1)
+            with self.assertRaises(ValueError) as cm:
+                scheduler.run_pending()
+        assert str(cm.exception) == "bad1"
+        assert sorted(ran) == ["bad1", "bad2", "good"]
+        for job in scheduler.jobs:
+            assert job.last_run is not None
+            assert job.next_run > datetime.datetime(2024, 1, 1)
+
+    def test_run_all_continues_after_job_error(self):
+        scheduler = schedule.Scheduler()
+        ran = []
+
+        def bad():
+            ran.append("bad")
+            raise ValueError("bad")
+
+        scheduler.every().second.do(bad)
+        scheduler.every().second.do(lambda: ran.append("good"))
+        with self.assertRaises(ValueError):
+            scheduler.run_all()
+        assert ran == ["bad", "good"]
+        assert all(job.last_run is not None for job in scheduler.jobs)
+
+    def test_base_exception_stops_run_pending(self):
+        scheduler = schedule.Scheduler()
+        ran = []
+
+        def interrupt():
+            raise KeyboardInterrupt()
+
+        scheduler.every().second.do(interrupt)
+        scheduler.every().second.do(lambda: ran.append("later"))
+        with self.assertRaises(KeyboardInterrupt):
+            scheduler.run_all()
+        assert ran == []
+
+    def test_failed_job_past_until_is_cancelled(self):
+        scheduler = schedule.Scheduler()
+
+        def bad():
+            raise ValueError()
+
+        with mock_datetime(2024, 1, 1, 0, 0, 0):
+            scheduler.every().hour.until(datetime.datetime(2024, 1, 1, 0, 30)).do(bad)
+            with self.assertRaises(ValueError):
+                scheduler.run_all()
+        assert scheduler.jobs == []
