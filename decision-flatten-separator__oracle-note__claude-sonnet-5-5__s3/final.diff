index 55e02d1..388d359 100644
--- a/addict/addict.py
+++ b/addict/addict.py
@@ -77,16 +77,41 @@ class Dict(dict):
     def to_dict(self):
         base = {}
         for key, value in self.items():
-            if isinstance(value, type(self)):
-                base[key] = value.to_dict()
-            elif isinstance(value, (list, tuple)):
-                base[key] = type(value)(
-                    item.to_dict() if isinstance(item, type(self)) else
-                    item for item in value)
-            else:
-                base[key] = value
+            base[key] = self._hook_to_dict(value)
         return base
 
+    @classmethod
+    def _hook_to_dict(cls, item):
+        if isinstance(item, cls):
+            return item.to_dict()
+        elif isinstance(item, (list, tuple)):
+            return type(item)(cls._hook_to_dict(i) for i in item)
+        return item
+
+    def flatten(self, separator='__'):
+        """Return a plain dict with one entry per leaf value.
+
+        Nested keys are joined with `separator` (default '__'). Lists and
+        other non-dict values are leaves and are returned unchanged. An empty
+        nested dict is kept as a leaf so no key is silently lost.
+        """
+        flat = {}
+        for key, value in self.items():
+            key = str(key)
+            if isinstance(value, dict) and value:
+                for sub_key, sub_value in self._hook_flatten(
+                        value, separator).items():
+                    flat[key + separator + sub_key] = sub_value
+            else:
+                flat[key] = value
+        return flat
+
+    @classmethod
+    def _hook_flatten(cls, value, separator):
+        if isinstance(value, cls):
+            return value.flatten(separator)
+        return cls(value).flatten(separator)
+
     def copy(self):
         return copy.copy(self)
 
