 });
+
+test('the context carries elapsedTime since pRetry was called', async t => {
+	await withFakeTime(t);
+
+	const seen = {consume: [], failed: [], retry: []};
+
+	await assert.rejects(pRetry(async () => {
+		throw new Error('fail');
+	}, {
+		retries: 2,
+		minTimeout: 100,
+		factor: 2,
+		shouldConsumeRetry({elapsedTime}) {
+			seen.consume.push(elapsedTime);
+		},
+		onFailedAttempt({elapsedTime}) {
+			seen.failed.push(elapsedTime);
+		},
+		shouldRetry({elapsedTime}) {
+			seen.retry.push(elapsedTime);
+			return true;
+		},
+	}), {message: 'fail'});
+
+	// Waits of 100ms and 200ms happen between the three attempts.
+	assert.deepEqual(seen.consume, [0, 100, 300]);
+	assert.deepEqual(seen.failed, [0, 100, 300]);
+	assert.deepEqual(seen.retry, [0, 100]);
+});
+
+test('retryAfter on the error is added to the backoff', async t => {
+	await withFakeTime(t);
+
+	const delays = [];
+	const times = [];
+	const start = performance.now();
+
+	await assert.rejects(pRetry(async () => {
+		times.push(performance.now() - start);
+		throw Object.assign(new Error('rate limited'), {retryAfter: 2});
+	}, {
+		retries: 2,
+		minTimeout: 100,
+		factor: 2,
+		onFailedAttempt({retryDelay}) {
+			delays.push(retryDelay);
+		},
+	}), {message: 'rate limited'});
+
+	assert.deepEqual(delays, [2100, 2200, 0]);
+	assert.deepEqual(times, [0, 2100, 4300]);
+});
+
+test('invalid retryAfter values are ignored', async t => {
+	await withFakeTime(t);
+
+	for (const retryAfter of ['5', -1, 0, NaN, Infinity, null]) {
+		const delays = [];
+
+		await assert.rejects(pRetry(async () => {
+			throw Object.assign(new Error('fail'), {retryAfter});
+		}, {
+			retries: 1,
+			minTimeout: 100,
+			onFailedAttempt({retryDelay}) {
+				delays.push(retryDelay);
+			},
+		}), {message: 'fail'});
+
+		assert.deepEqual(delays, [100, 0], String(retryAfter));
+	}
+});
+
+test('retryAfter is still bounded by maxRetryTime', async t => {
+	await withFakeTime(t);
+
+	const start = performance.now();
+
+	await assert.rejects(pRetry(async () => {
+		throw Object.assign(new Error('fail'), {retryAfter: 60});
+	}, {
+		retries: 5,
+		minTimeout: 100,
+		maxRetryTime: 1000,
+	}), {message: 'fail'});
+
+	assert.ok(performance.now() - start <= 1000);
+});
