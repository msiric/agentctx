+import { describe, expect, it } from '@jest/globals';
+import { parseClock } from './index';
+
+describe('parseClock(string)', () => {
+  it('should parse m:ss', () => {
+    expect(parseClock('1:30')).toBe(90000);
+    expect(parseClock('0:00')).toBe(0);
+    expect(parseClock('0:05')).toBe(5000);
+    expect(parseClock('00:59')).toBe(59000);
+  });
+
+  it('should allow minutes over 59 in m:ss', () => {
+    expect(parseClock('90:00')).toBe(5400000);
+    expect(parseClock('120:15')).toBe(120 * 60000 + 15000);
+  });
+
+  it('should parse h:mm:ss', () => {
+    expect(parseClock('01:02:03')).toBe(3723000);
+    expect(parseClock('1:02:03')).toBe(3723000);
+    expect(parseClock('0:00:00')).toBe(0);
+    expect(parseClock('10:59:59')).toBe(10 * 3600000 + 59 * 60000 + 59000);
+    expect(parseClock('100:00:00')).toBe(100 * 3600000);
+  });
+
+  it('should return undefined for out-of-range minutes or seconds', () => {
+    expect(parseClock('1:60')).toBeUndefined();
+    expect(parseClock('1:99')).toBeUndefined();
+    expect(parseClock('1:60:00')).toBeUndefined();
+    expect(parseClock('1:00:60')).toBeUndefined();
+  });
+
+  it('should return undefined for malformed input', () => {
+    expect(parseClock('')).toBeUndefined();
+    expect(parseClock('90')).toBeUndefined();
+    expect(parseClock('1:5')).toBeUndefined();
+    expect(parseClock('1:2:3')).toBeUndefined();
+    expect(parseClock(':30')).toBeUndefined();
+    expect(parseClock('1:')).toBeUndefined();
+    expect(parseClock('1:30:')).toBeUndefined();
+    expect(parseClock('1:30:00:00')).toBeUndefined();
+    expect(parseClock('-1:30')).toBeUndefined();
+    expect(parseClock('1:30.5')).toBeUndefined();
+    expect(parseClock('a:bc')).toBeUndefined();
+    expect(parseClock(' 1:30')).toBeUndefined();
+    expect(parseClock('1:30\n')).toBeUndefined();
+  });
+
+  it('should return undefined (not throw) for non-string input', () => {
+    // @ts-expect-error testing runtime behavior
+    expect(parseClock(undefined)).toBeUndefined();
+    // @ts-expect-error testing runtime behavior
+    expect(parseClock(null)).toBeUndefined();
+    // @ts-expect-error testing runtime behavior
+    expect(parseClock(130)).toBeUndefined();
+    // @ts-expect-error testing runtime behavior
+    expect(parseClock({})).toBeUndefined();
+  });
+});
