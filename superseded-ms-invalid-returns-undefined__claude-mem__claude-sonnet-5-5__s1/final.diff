+++ b/src/parse-compound.test.ts
@@ -0,0 +1,52 @@
+import { describe, expect, it } from '@jest/globals';
+import { parseCompound } from './index';
+
+describe('parseCompound(string)', () => {
+  it('should parse a single value like parse', () => {
+    expect(parseCompound('1h')).toBe(3600000);
+    expect(parseCompound('100')).toBe(100);
+    expect(parseCompound('2 days')).toBe(172800000);
+  });
+
+  it('should sum short units', () => {
+    expect(parseCompound('1h 30m')).toBe(5400000);
+    expect(() => parseCompound('1h30m')).toThrow(TypeError);
+  });
+
+  it('should sum long units separated from numbers', () => {
+    expect(parseCompound('2 days 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
+  });
+
+  it('should handle mixed spacing, case and extra whitespace', () => {
+    expect(parseCompound('  1 H   30m  15 Seconds ')).toBe(
+      3600000 + 1800000 + 15000,
+    );
+  });
+
+  it('should handle decimals and negatives', () => {
+    expect(parseCompound('1.5h 30m')).toBe(7200000);
+    expect(parseCompound('-1h 30m')).toBe(-1800000);
+  });
+
+  it('should accept commas between parts', () => {
+    expect(parseCompound('1h, 30m')).toBe(5400000);
+    expect(parseCompound('1h,30m')).toBe(5400000);
+    expect(parseCompound('2 days, 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
+    expect(parseCompound('1h, 30m,')).toBe(5400000);
+  });
+
+  it('should reject commas inside numbers or with no parts', () => {
+    expect(() => parseCompound('1,5h')).toThrow(TypeError);
+    expect(() => parseCompound(',')).toThrow(TypeError);
+  });
+
+  it('should throw a TypeError including the input on bad input', () => {
+    expect(() => parseCompound('')).toThrow(TypeError);
+    expect(() => parseCompound('   ')).toThrow(TypeError);
+    expect(() => parseCompound('abc')).toThrow('value="abc"');
+    expect(() => parseCompound('1h foo')).toThrow(TypeError);
+    expect(() => parseCompound('1h foo')).toThrow('value="1h foo"');
+    expect(() => parseCompound(null as unknown as string)).toThrow(TypeError);
+    expect(() => parseCompound('1'.repeat(101))).toThrow(TypeError);
+  });
+});
