+/**
+ * Parse a compound duration such as `"1h 30m"` or `"2 days 4 hours"` and
+ * return the total in milliseconds. Each piece is parsed with {@link parse}.
+ *
+ * @param str - A string of one or more durations separated by whitespace and/or commas
+ * @returns The total in milliseconds (never `NaN`)
+ * @throws TypeError if `str` is not a string, is empty, or any piece can't be
+ * parsed. The message includes the input.
+ */
+export function parseCompound(str: string): number {
+  const invalid = () =>
+    new TypeError(
+      `Value provided to ms.parseCompound() is not a valid compound duration. value=${JSON.stringify(str)}`,
+    );
+  if (typeof str !== 'string' || str.trim().length === 0) {
+    throw invalid();
+  }
+  // Commas are allowed between parts ("1h, 30m"), but not inside a number
+  // ("1,5h"), where the intent is ambiguous.
+  if (/\d,\d/.test(str)) {
+    throw invalid();
+  }
+  const tokens = str.split(/[\s,]+/).filter(Boolean);
+  if (tokens.length === 0) {
+    throw invalid();
+  }
+  let total = 0;
+  for (let i = 0; i < tokens.length; i++) {
+    let piece = tokens[i] as string;
+    // Re-join "2 days" style pieces: a bare number followed by a unit word.
+    const next = tokens[i + 1];
+    if (
+      next !== undefined &&
+      /^-?\d*\.?\d+$/.test(piece) &&
+      /^[a-z]+$/i.test(next)
+    ) {
+      piece = `${piece} ${next}`;
+      i++;
+    }
+    let value: number;
+    try {
+      value = parse(piece);
+    } catch {
+      // e.g. a piece longer than parse() allows
+      throw invalid();
+    }
+    if (Number.isNaN(value)) {
+      throw invalid();
+    }
+    total += value;
+  }
+  return total;
+}
+
+const CLOCK_REGEX = /^(?:(\d+):([0-5]\d)|(\d+):([0-5]\d):([0-5]\d))$/;
+
+/**
+ * Parse a timer-style string and return milliseconds. `"m:ss"` (e.g. `"1:30"`)
+ * and `"h:mm:ss"` (e.g. `"01:02:03"`) are supported. In `m:ss` the minutes are
+ * unbounded (`"90:00"` is valid); seconds and, in `h:mm:ss`, minutes must be
+ * two digits in the range 00–59.
+ *
+ * Unlike {@link parseCompound}, this does not throw on invalid input.
+ *
+ * @param str - A clock string such as `"1:30"` or `"01:02:03"`
+ * @returns The total in milliseconds, or `undefined` if the input is invalid
+ */
+export function parseClock(str: string): number | undefined {
+  if (typeof str !== 'string') {
+    return undefined;
+  }
+  const match = CLOCK_REGEX.exec(str);
+  if (!match) {
+    return undefined;
+  }
+  const [h, m, s] =
+    match[3] === undefined
+      ? [0, Number(match[1]), Number(match[2])]
+      : [Number(match[3]), Number(match[4]), Number(match[5])];
+  return ((h * 60 + m) * 60 + s) * 1000;
+}
