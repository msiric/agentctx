p='src/index.ts'
t=open(p).read()
a=t.index("/**\n * Parse a compound")
b=t.index("/**\n * Parse the given StringValue")
new='''/**
 * Parse a compound duration such as `"1h 30m"` or `"2 days 4 hours"` and
 * return the total in milliseconds. Each piece is parsed with {@link parse}.
 *
 * @param str - A string of one or more durations separated by whitespace
 * @returns The total in milliseconds (never `NaN`)
 * @throws TypeError if `str` is not a string, is empty, or any piece can't be
 * parsed. The message includes the input.
 */
export function parseCompound(str: string): number {
  const invalid = () =>
    new TypeError(
      `Value provided to ms.parseCompound() is not a valid compound duration. value=${JSON.stringify(str)}`,
    );
  if (typeof str !== 'string' || str.trim().length === 0) {
    throw invalid();
  }
  const tokens = str.trim().split(/\\s+/);
  let total = 0;
  for (let i = 0; i < tokens.length; i++) {
    let piece = tokens[i] as string;
    // Re-join "2 days" style pieces: a bare number followed by a unit word.
    const next = tokens[i + 1];
    if (
      next !== undefined &&
      /^-?\\d*\\.?\\d+$/.test(piece) &&
      /^[a-z]+$/i.test(next)
    ) {
      piece = `${piece} ${next}`;
      i++;
    }
    let value: number;
    try {
      value = parse(piece);
    } catch {
      // e.g. a piece longer than parse() allows
      throw invalid();
    }
    if (Number.isNaN(value)) {
      throw invalid();
    }
    total += value;
  }
  return total;
}

