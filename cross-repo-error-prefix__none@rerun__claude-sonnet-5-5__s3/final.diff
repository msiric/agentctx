 ```
 
+## API
+
+### parseMilliseconds(milliseconds, options?)
+
+Accepts a finite number or a bigint. Returns an object with the same type of values.
+
+#### options
+
+Type: `object`
+
+##### largestUnit
+
+Type: `'days' | 'hours' | 'minutes' | 'seconds'`\
+Default: `'days'`
+
+The largest unit to include. Bigger units roll into it, and the ones above it are `0`.
+
+```js
+parseMilliseconds(93_600_000, {largestUnit: 'hours'});
+//=> {days: 0, hours: 26, minutes: 0, …}
+```
+
+Throws a `TypeError` for any other value.
+
 ## Related
 
 - [to-milliseconds](https://github.com/sindresorhus/to-milliseconds) - The inverse of this module
diff --git a/test.js b/test.js
index 6314aab..de0d63f 100644
--- a/test.js
+++ b/test.js
@@ -292,3 +292,42 @@ test('keep the sub-day parts exact at any magnitude', () => {
 		assert.strictEqual(parsed.hours, Number(bigint.hours), `${milliseconds}ms hours against the bigint path`);
 	}
 });
+
+test('largestUnit rolls bigger units into it', () => {
+	const milliseconds = 93_784_005; // 1d 2h 3m 4s 5ms
+
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit: 'days'}), parseMilliseconds(milliseconds));
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit: 'hours'}), {
+		days: 0, hours: 26, minutes: 3, seconds: 4, milliseconds: 5, microseconds: 0, nanoseconds: 0,
+	});
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit: 'minutes'}), {
+		days: 0, hours: 0, minutes: 1563, seconds: 4, milliseconds: 5, microseconds: 0, nanoseconds: 0,
+	});
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit: 'seconds'}), {
+		days: 0, hours: 0, minutes: 0, seconds: 93_784, milliseconds: 5, microseconds: 0, nanoseconds: 0,
+	});
+});
+
+test('largestUnit works with bigint', () => {
+	assert.deepStrictEqual(parseMilliseconds(93_784_005n, {largestUnit: 'hours'}), {
+		days: 0n, hours: 26n, minutes: 3n, seconds: 4n, milliseconds: 5n, microseconds: 0n, nanoseconds: 0n,
+	});
+	assert.deepStrictEqual(parseMilliseconds(93_784_005n, {largestUnit: 'seconds'}), {
+		days: 0n, hours: 0n, minutes: 0n, seconds: 93_784n, milliseconds: 5n, microseconds: 0n, nanoseconds: 0n,
+	});
+	assert.strictEqual(parseMilliseconds(-93_784_005n, {largestUnit: 'minutes'}).minutes, -1563n);
+});
+
+test('largestUnit keeps sign and sub-millisecond parts', () => {
+	const parsed = parseMilliseconds(-3_600_000.5, {largestUnit: 'minutes'});
+	assert.equal(parsed.minutes, -60);
+	assert.equal(parsed.milliseconds, -0);
+	assert.equal(parsed.microseconds, -500);
+});
+
+test('largestUnit rejects invalid values', () => {
+	for (const largestUnit of ['weeks', 'day', 'milliseconds', '', null, 1, {}]) {
+		assert.throws(() => parseMilliseconds(1000, {largestUnit}), TypeError, String(largestUnit));
+		assert.throws(() => parseMilliseconds(1000n, {largestUnit}), TypeError, String(largestUnit));
+	}
+});
