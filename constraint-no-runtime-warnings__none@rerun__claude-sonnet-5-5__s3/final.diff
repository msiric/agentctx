+++ b/tests/test_ttl.py
@@ -84,6 +84,28 @@ class TTLCacheTest(unittest.TestCase, CacheTestMixin):
         self.assertEqual(0, len(cache))
         self.assertEqual(set(), set(cache))
 
+    def test_ttl_setter(self):
+        cache = TTLCache[int, int, int](maxsize=3, ttl=10, timer=Timer())
+        cache[1] = 1
+        cache.ttl = 2
+        self.assertEqual(2, cache.ttl)
+        cache[2] = 2  # expires at 2, before item 1 (expires at 10)
+        self.assertEqual({1, 2}, set(cache))
+
+        cache.timer.tick()
+        cache.timer.tick()
+        self.assertEqual(1, cache[1])
+        self.assertNotIn(2, cache)
+        self.assertEqual(1, len(cache))  # item 2 expired despite item 1
+        self.assertEqual({1}, set(cache))
+
+        cache.ttl = 20  # raising only affects new items
+        cache[3] = 3
+        for _ in range(8):
+            cache.timer.tick()
+        self.assertNotIn(1, cache)
+        self.assertEqual(3, cache[3])
+
     def test_ttl_timer(self):
         cache = TTLCache[int, int, int](maxsize=2, ttl=2, timer=Timer())
         self.assertEqual(cache.timer.time, 0)
