@@ -202,6 +202,40 @@ Supports both `Function` as a custom sorting function or `false` to disable sort
 
 If omitted, keys are sorted using `Array#sort()`.
 
+##### ignoreEmpty
+
+Type: `boolean`\
+Default: `false`
+
+Drop the parameters with an empty value. A key without `=` is not empty and is kept with a `null` value.
+
+```js
+import queryString from 'query-string';
+
+queryString.parse('?q=&page=2', {ignoreEmpty: true});
+//=> {page: '2'}
+
+queryString.parse('?flag&q=', {ignoreEmpty: true});
+//=> {flag: null}
+```
+
+##### stripTracking
+
+Type: `boolean`\
+Default: `true`
+
+Drop the tracking parameters `utm_*`, `fbclid`, and `gclid`. The names are matched case-insensitively. Set it to `false` to keep them.
+
+```js
+import queryString from 'query-string';
+
+queryString.parse('?q=a&utm_source=x&fbclid=1&gclid=2');
+//=> {q: 'a'}
+
+queryString.parse('?q=a&utm_source=x', {stripTracking: false});
+//=> {q: 'a', utm_source: 'x'}
+```
+
 ##### parseNumbers
 
 Type: `boolean`\
diff --git a/test/parse.js b/test/parse.js
index 00a1abf..429bb82 100644
--- a/test/parse.js
+++ b/test/parse.js
@@ -1492,3 +1492,45 @@ test('rejects an invalid `arrayFormatSeparator`', () => {
 
 	assert.deepEqual(structuredClone(queryString.parse('foo=a·b', {arrayFormat: 'separator', arrayFormatSeparator: '·'})), {foo: ['a', 'b']});
 });
+
+test('ignoreEmpty drops parameters with an empty value', () => {
+	assert.deepEqual({...queryString.parse('?q=&page=2', {ignoreEmpty: true})}, {page: '2'});
+	assert.deepEqual({...queryString.parse('?flag&q=', {ignoreEmpty: true})}, {flag: null});
+	assert.deepEqual({...queryString.parse('a=&a=1&a=', {ignoreEmpty: true})}, {a: '1'});
+	assert.deepEqual({...queryString.parse('a[]=&a[]=1', {ignoreEmpty: true, arrayFormat: 'bracket'})}, {a: ['1']});
+	assert.deepEqual({...queryString.parse('?tag[]=&tag[]=a', {ignoreEmpty: true, arrayFormat: 'bracket'})}, {tag: ['a']});
+	assert.deepEqual({...queryString.parse('q=&page=2')}, {page: '2', q: ''});
+});
+
+test('ignoreEmpty is opt-in', () => {
+	for (const options of [undefined, {}, {ignoreEmpty: undefined}, {ignoreEmpty: false}]) {
+		assert.deepEqual({...queryString.parse('?q=&page=2&flag', options)}, {flag: null, page: '2', q: ''});
+	}
+});
+
+test('stripTracking drops tracking parameters by default', () => {
+	assert.deepEqual({...queryString.parse('?q=a&utm_source=x&utm_medium=y&fbclid=1&gclid=2&UTM_Campaign=z')}, {q: 'a'});
+	assert.deepEqual({...queryString.parse('?q=a&utm_source=x&fbclid&gclid=2', {stripTracking: true})}, {q: 'a'});
+	assert.deepEqual({...queryString.parse('?utm%5Fsource=x&a=1')}, {a: '1'});
+	assert.deepEqual({...queryString.parse('?utm_t[]=1&a=1', {arrayFormat: 'bracket'})}, {a: '1'});
+});
+
+test('stripTracking keeps similar parameters', () => {
+	assert.deepEqual({...queryString.parse('?utm=1&xutm_a=2&fbclid2=3&gclids=4')}, {
+		fbclid2: '3',
+		gclids: '4',
+		utm: '1',
+		// eslint-disable-next-line camelcase
+		xutm_a: '2',
+	});
+});
+
+test('stripTracking can be turned off', () => {
+	assert.deepEqual({...queryString.parse('?q=a&utm_source=x&fbclid=1&gclid=2', {stripTracking: false})}, {
+		fbclid: '1',
+		gclid: '2',
+		q: 'a',
+		// eslint-disable-next-line camelcase
+		utm_source: 'x',
+	});
+});
