+/**
+ * Compound short format for `ms`, e.g. `1h30m`.
+ * Compatible with Go's `time.ParseDuration` (no spaces, hours are the largest unit).
+ */
+function fmtCompound(ms: number): StringValue {
+  let remaining = Math.floor(Math.abs(ms) / s);
+  const parts: string[] = [];
+  for (const [unit, size] of [
+    ['h', h / s],
+    ['m', m / s],
+    ['s', 1],
+  ] as const) {
+    const count = Math.floor(remaining / size);
+    remaining -= count * size;
+    if (count > 0) {
+      parts.push(`${count}${unit}`);
+    }
+  }
+  if (parts.length === 0) {
+    return '0s';
+  }
+  return `${ms < 0 ? '-' : ''}${parts.join('')}` as StringValue;
+}
