diff --git a/test/count.js b/test/count.js
new file mode 100644
index 0000000..7f10c04
--- /dev/null
+++ b/test/count.js
@@ -0,0 +1,32 @@
+const test = require('tape');
+const fn = require('../lib');
+
+test('count: repeated short flags', t => {
+	t.same(fn(['-vvv'], { count: 'v' }), { v: 3, _: [] });
+	t.same(fn(['-v', '-v'], { count: ['v'] }), { v: 2, _: [] });
+	t.end();
+});
+
+test('count: repeated long flags', t => {
+	t.same(fn(['--verbose', '--verbose'], { count: 'verbose' }), { verbose: 2, _: [] });
+	t.same(fn(['--verbose'], { count: 'verbose' }), { verbose: 1, _: [] });
+	t.end();
+});
+
+test('count: does not consume next argument', t => {
+	t.same(fn(['-v', 'foo', '-v'], { count: 'v' }), { v: 2, _: ['foo'] });
+	t.end();
+});
+
+test('count: aliases share the total', t => {
+	const opts = { count: 'v', alias: { v: 'verbose' } };
+	t.same(fn(['-v', '--verbose', '-vv'], opts), { v: 4, verbose: 4, _: [] });
+	t.end();
+});
+
+test('count: mixed with other flags, absent and default', t => {
+	t.same(fn(['-vvx', 'a'], { count: 'v' }), { v: 2, x: 'a', _: [] });
+	t.same(fn([], { count: 'v' }), { _: [] });
+	t.same(fn([], { count: 'v', default: { v: 0 } }), { v: 0, _: [] });
+	t.end();
+});
