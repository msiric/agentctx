diff --git a/tests/test_storages.py b/tests/test_storages.py
index 6e433a1..8bfa241 100644
--- a/tests/test_storages.py
+++ b/tests/test_storages.py
@@ -285,3 +285,108 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+class _Crash(BaseException):
+    """Stands in for the process being killed."""
+
+
+def _journal(path):
+    return str(path) + '.journal'
+
+
+def test_crash_while_writing_journal_keeps_old_state(tmpdir, monkeypatch):
+    path = str(tmpdir.join('db.json'))
+
+    db = TinyDB(path)
+    db.insert({'a': 1})
+
+    def partial_journal(self, serialized):
+        # Simulate dying after only a part of the journal reached the disk
+        with open(self._journal_path, 'wb') as f:
+            f.write(b'TINYDB-JOURNAL-1 abc 99\n' + serialized.encode()[:5])
+        raise _Crash()
+
+    monkeypatch.setattr(JSONStorage, '_write_journal', partial_journal)
+    with pytest.raises(_Crash):
+        db.insert({'a': 2})
+    monkeypatch.undo()
+
+    with TinyDB(path) as db2:
+        assert db2.all() == [{'a': 1}]
+    assert not os.path.exists(_journal(path))
+
+
+def test_crash_while_overwriting_db_gives_new_state(tmpdir, monkeypatch):
+    path = str(tmpdir.join('db.json'))
+
+    db = TinyDB(path)
+    db.insert({'a': 1})
+
+    def partial_write(self, serialized):
+        # Simulate dying after half of the new contents were written
+        self._handle.seek(0)
+        self._handle.write(serialized[:len(serialized) // 2])
+        self._handle.truncate()
+        self._handle.flush()
+        raise _Crash()
+
+    monkeypatch.setattr(JSONStorage, '_write_in_place', partial_write)
+    with pytest.raises(_Crash):
+        db.insert({'a': 2})
+    monkeypatch.undo()
+
+    # The database file is now truncated garbage...
+    with open(path) as f:
+        with pytest.raises(ValueError):
+            json.load(f)
+
+    # ...but opening it again recovers the new state from the journal
+    with TinyDB(path) as db2:
+        assert db2.all() == [{'a': 1}, {'a': 2}]
+    assert not os.path.exists(_journal(path))
+
+
+def test_crash_before_journal_removal_is_harmless(tmpdir, monkeypatch):
+    path = str(tmpdir.join('db.json'))
+
+    db = TinyDB(path)
+    db.insert({'a': 1})
+
+    def no_remove(self):
+        raise _Crash()
+
+    monkeypatch.setattr(JSONStorage, '_remove_journal', no_remove)
+    with pytest.raises(_Crash):
+        db.insert({'a': 2})
+    monkeypatch.undo()
+
+    assert os.path.exists(_journal(path))
+    with TinyDB(path) as db2:
+        assert db2.all() == [{'a': 1}, {'a': 2}]
+    assert not os.path.exists(_journal(path))
+
+
+def test_shrinking_write_leaves_no_trailing_data(tmpdir):
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path) as db:
+        db.insert_multiple({'a': i} for i in range(50))
+        db.truncate()
+
+    with TinyDB(path) as db:
+        assert db.all() == []
+
+
+def test_read_only_mode_ignores_journal(tmpdir):
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+
+    with open(_journal(path), 'wb') as f:
+        f.write(b'garbage')
+
+    with TinyDB(path, access_mode='r') as db:
+        assert db.all() == [{'a': 1}]
+    assert os.path.exists(_journal(path))
