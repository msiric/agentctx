+    # Crash safety
+    #
+    # The database file is updated in place (renaming a file over it is not
+    # possible e.g. when it is a bind-mounted single file). To make that safe,
+    # the new contents are first written to a journal file and fsynced. Only
+    # then the database file is overwritten and the journal removed:
+    #
+    # * crash while writing the journal -> journal is incomplete (checksum
+    #   mismatch) and discarded, the database file still has the old state
+    # * crash while overwriting the database -> journal is complete and gets
+    #   replayed on the next open, the database file gets the new state
+    #
+    # This requires the directory of the database file to be writable.
+
+    _JOURNAL_MAGIC = b'TINYDB-JOURNAL-1'
+
+    def _write_journal(self, serialized: str) -> None:
+        payload = serialized.encode('utf-8')
+        header = b'%s %s %d\n' % (
+            self._JOURNAL_MAGIC, hashlib.sha256(payload).hexdigest().encode(), len(payload)
+        )
+        with open(self._journal_path, 'wb') as journal:
+            journal.write(header + payload)
+            journal.flush()
+            os.fsync(journal.fileno())
+        self._fsync_dir()
+
+    def _read_journal(self) -> Optional[str]:
+        """Return the journal's payload, or ``None`` if missing/incomplete."""
+        try:
+            with open(self._journal_path, 'rb') as journal:
+                raw = journal.read()
+        except FileNotFoundError:
+            return None
+
+        header, sep, payload = raw.partition(b'\n')
+        parts = header.split(b' ')
