+            if (not sep or len(parts) != 3 or parts[0] != self._JOURNAL_MAGIC
+                    or int(parts[2]) != len(payload)
+                    or hashlib.sha256(payload).hexdigest().encode() != parts[1]):
+                return None
+            return payload.decode('utf-8')
+        except ValueError:
+            return None
+
+    def _remove_journal(self) -> None:
+        try:
