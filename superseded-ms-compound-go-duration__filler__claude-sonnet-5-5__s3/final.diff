+describe('format(number, { compound: true })', () => {
+  it('should combine units, largest first, skipping zeros', () => {
+    expect(format(5400000, { compound: true })).toBe('1h 30m');
+    expect(format(90061000, { compound: true })).toBe('1d 1h 1m 1s');
+    expect(format(86400000 + 5000, { compound: true })).toBe('1d 5s');
+    expect(format(1000, { compound: true })).toBe('1s');
+  });
+
+  it('should cap at days and drop milliseconds', () => {
+    expect(format(40 * 86400000 + 999, { compound: true })).toBe('40d');
+    expect(format(1999, { compound: true })).toBe('1s');
+    expect(format(500, { compound: true })).toBe('0s');
+  });
+
+  it('should support negative values', () => {
+    expect(format(-5400000, { compound: true })).toBe('-1h 30m');
+  });
+});
