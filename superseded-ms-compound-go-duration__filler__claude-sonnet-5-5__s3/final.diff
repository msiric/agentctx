+    const { ms } = await import('./index');
+    expect(ms(5400000, { compound: true })).toBe('1h 30m');
+  });
+
+  it('should be ignored when long is set', () => {
+    expect(format(5400000, { long: true, compound: true })).toBe('2 hours');
+  });
+
+  it('should not add a sign for negative sub-second values', () => {
+    expect(format(-500, { compound: true })).toBe('0s');
+  });
+
+  it('should leave the default output unchanged', () => {
+    expect(format(5400000, { compound: false })).toBe('2h');
+  });
+});
+
+describe('format(number, { compound: true }) boundaries', () => {
+  it('should format exact unit boundaries as a single unit', () => {
+    expect(format(60000, { compound: true })).toBe('1m');
+    expect(format(3600000, { compound: true })).toBe('1h');
+    expect(format(86400000, { compound: true })).toBe('1d');
+  });
+
+  it('should roll over just below a boundary', () => {
+    expect(format(59999, { compound: true })).toBe('59s');
+    expect(format(3599999, { compound: true })).toBe('59m 59s');
+  });
+
