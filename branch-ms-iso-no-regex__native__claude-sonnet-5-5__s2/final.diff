@@ -242,3 +242,158 @@ function plural(
   const isPlural = msAbs >= n * 1.5;
   return `${Math.round(ms / n)} ${name}${isPlural ? 's' : ''}` as StringValue;
 }
+
+/**
+ * Format the given milliseconds as an ISO 8601 duration string.
+ *
+ * Days are the largest unit used, since months and years are ambiguous.
+ * Fractional milliseconds are rounded, sub-second values use a decimal
+ * fraction of seconds (e.g. `PT1.5S`), zero is `PT0S`, and negative values get
+ * a leading `-` (e.g. `-PT1H`), which is a common extension to ISO 8601.
+ *
+ * @param ms - milliseconds
+ * @returns The ISO 8601 duration, e.g. `PT1H30M` or `P1DT1H1M1S`
+ * @throws Error if `ms` is not a finite number
+ */
+export function formatISO(ms: number): string {
+  if (typeof ms !== 'number' || !Number.isFinite(ms)) {
+    throw new Error('Value provided to ms.formatISO() must be of type number.');
+  }
+
+  const total = Math.round(Math.abs(ms));
+  if (total === 0) {
+    return 'PT0S';
+  }
+
+  const days = Math.floor(total / d);
+  const hours = Math.floor((total % d) / h);
+  const minutes = Math.floor((total % h) / m);
+  const seconds = Math.floor((total % m) / s);
+  const millis = total % s;
+
+  let time = '';
+  if (hours) {
+    time += `${hours}H`;
+  }
+  if (minutes) {
+    time += `${minutes}M`;
+  }
+  if (seconds || millis) {
+    let fraction = '';
+    if (millis) {
+      // Drop trailing zeros without a regex (PT1.050S -> PT1.05S).
+      let digits = String(millis).padStart(3, '0');
+      while (digits.endsWith('0')) {
+        digits = digits.slice(0, -1);
+      }
+      fraction = `.${digits}`;
+    }
+    time += `${seconds}${fraction}S`;
+  }
+
+  return `${ms < 0 ? '-' : ''}P${days ? `${days}D` : ''}${time ? `T${time}` : ''}`;
+}
+
+const isDigit = (c: string | undefined): boolean =>
+  c !== undefined && c >= '0' && c <= '9';
+
+/**
+ * Parse an ISO 8601 duration string and return milliseconds.
+ *
+ * This is the inverse of {@link formatISO}. Supported designators are `W`, `D`,
+ * `H`, `M` and `S` (in that order, with `T` before the time part). Years and
+ * months are ambiguous and are rejected. A leading `-` or `+` is accepted, and
+ * components may have a decimal fraction (`.` or `,`), e.g. `PT1.5S`.
+ *
+ * Implemented as a hand-written scanner (no regular expressions).
+ *
+ * @param str - An ISO 8601 duration, e.g. `PT1H30M` or `P1DT1H1M1S`
+ * @returns The duration in milliseconds, or `NaN` if the string can't be parsed
+ * @throws Error if `str` is not a string with length between 1 and 99
+ */
+export function parseISO(str: string): number {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw new Error(
+      `Value provided to ms.parseISO() must be a string with length between 1 and 99. value=${JSON.stringify(str)}`,
+    );
+  }
+
+  let i = 0;
+  let sign = 1;
+  if (str[i] === '-' || str[i] === '+') {
+    sign = str[i] === '-' ? -1 : 1;
+    i++;
+  }
+  if (str[i] !== 'P') {
+    return NaN;
+  }
+  i++;
+
+  const dateUnits: Record<string, number> = { W: w, D: d };
+  const timeUnits: Record<string, number> = { H: h, M: m, S: s };
+  const dateOrder = ['W', 'D'];
+  const timeOrder = ['H', 'M', 'S'];
+
+  let total = 0;
+  let inTime = false;
+  let lastIndex = -1;
+  let components = 0;
+  let timeComponents = 0;
+
+  while (i < str.length) {
+    if (str[i] === 'T') {
+      if (inTime) {
+        return NaN;
+      }
+      inTime = true;
+      lastIndex = -1;
+      i++;
+      continue;
+    }
+
+    // Number: digits, optionally followed by a separator and more digits.
+    const start = i;
+    while (isDigit(str[i])) {
+      i++;
+    }
+    if (i === start) {
+      return NaN;
+    }
+    if (str[i] === '.' || str[i] === ',') {
+      i++;
+      const fractionStart = i;
+      while (isDigit(str[i])) {
+        i++;
+      }
+      if (i === fractionStart) {
+        return NaN;
+      }
+    }
+    const n = parseFloat(str.slice(start, i).replace(',', '.'));
+
+    const designator = str[i];
+    i++;
+    if (designator === undefined) {
+      return NaN;
+    }
+    const order = inTime ? timeOrder : dateOrder;
+    const units = inTime ? timeUnits : dateUnits;
+    const index = order.indexOf(designator);
+    if (index === -1 || index <= lastIndex) {
+      return NaN;
+    }
+    lastIndex = index;
+    total += n * (units[designator] as number);
+    components++;
+    if (inTime) {
+      timeComponents++;
+    }
+  }
+
+  // Need at least one component, and `T` must be followed by one.
+  if (components === 0 || (inTime && timeComponents === 0)) {
+    return NaN;
+  }
+
+  return sign * total;
+}
