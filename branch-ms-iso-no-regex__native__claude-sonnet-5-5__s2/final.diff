index 0000000..3ddfa3f
--- /dev/null
+++ b/src/parse-iso.test.ts
@@ -0,0 +1,80 @@
+import { describe, expect, it } from '@jest/globals';
+import { formatISO, parseISO } from './index';
+
+describe('parseISO(string)', () => {
+  it('should parse hours and minutes', () => {
+    expect(parseISO('PT1H30M')).toBe(5400000);
+  });
+
+  it('should parse days, hours, minutes and seconds', () => {
+    expect(parseISO('P1DT1H1M1S')).toBe(90061000);
+  });
+
+  it('should parse single components', () => {
+    expect(parseISO('P1D')).toBe(86400000);
+    expect(parseISO('P2W')).toBe(2 * 7 * 86400000);
+    expect(parseISO('PT1H')).toBe(3600000);
+    expect(parseISO('PT1M')).toBe(60000);
+    expect(parseISO('PT1S')).toBe(1000);
+    expect(parseISO('P1DT1S')).toBe(86401000);
+  });
+
+  it('should parse zero', () => {
+    expect(parseISO('PT0S')).toBe(0);
+    expect(parseISO('P0D')).toBe(0);
+  });
+
+  it('should parse fractional seconds', () => {
+    expect(parseISO('PT1.5S')).toBe(1500);
+    expect(parseISO('PT1,5S')).toBe(1500);
+    expect(parseISO('PT0.001S')).toBe(1);
+    expect(parseISO('PT1.05S')).toBe(1050);
+  });
+
+  it('should parse signs', () => {
+    expect(parseISO('-PT1H')).toBe(-3600000);
+    expect(parseISO('+PT1H')).toBe(3600000);
+  });
+
+  it('should round-trip with formatISO', () => {
+    for (const v of [0, 1, 999, 1000, 1050, 5400000, 90061001, -3600000]) {
+      expect(parseISO(formatISO(v))).toBe(v);
+    }
+  });
+
+  it('should return NaN for invalid input', () => {
+    for (const bad of [
+      'P',
+      'PT',
+      'P1DT',
+      '1H',
+      'pt1h',
+      'PT1',
+      'PT1X',
+      'PT.5S',
+      'PT1.S',
+      'PTS',
+      'P1Y',
+      'P1M',
+      'P1H',
+      'PT1D',
+      'PT1M1H',
+      'P1D1W',
+      'PT1HT1M',
+      'PT1H1H',
+      'P1DT1H ',
+      '-',
+      '--PT1H',
+      'PT-1H',
+    ]) {
+      expect(parseISO(bad)).toBeNaN();
+    }
+  });
+
+  it('should throw for non-strings, empty and overlong strings', () => {
+    expect(() => parseISO('')).toThrow();
+    expect(() => parseISO(undefined as any)).toThrow();
+    expect(() => parseISO(1 as any)).toThrow();
+    expect(() => parseISO(`PT${'1'.repeat(100)}S`)).toThrow();
+  });
+});
