+"""Benchmark TinyDB read paths on a large JSON db.
+
+Usage: python scripts/bench_read.py [target_mb=40] [repeats=5]
+"""
+import cProfile
+import json
+import os
+import pstats
+import sys
+import tempfile
+import time
+
+from tinydb import TinyDB, where
+from tinydb.storages import JSONStorage
+
+
+def build(path, target_mb):
+    docs = {}
+    size, i = 0, 1
+    while size < target_mb * 1024 * 1024:
+        d = {'name': f'user{i}', 'age': i % 90, 'email': f'user{i}@example.com',
+             'tags': ['a', 'b', 'c'], 'address': {'city': f'city{i % 500}', 'zip': str(10000 + i % 90000)},
+             'bio': 'lorem ipsum dolor sit amet ' * 4}
+        docs[str(i)] = d
+        size += len(json.dumps(d)) + 8
+        i += 1
+    with open(path, 'w') as f:
+        json.dump({'_default': docs}, f)
+    return len(docs)
+
+
+def best(fn, repeats):
+    ts = []
+    for _ in range(repeats):
+        t = time.perf_counter()
+        fn()
+        ts.append(time.perf_counter() - t)
+    return min(ts)
+
+
+def main():
+    mb = float(sys.argv[1]) if len(sys.argv) > 1 else 40
+    repeats = int(sys.argv[2]) if len(sys.argv) > 2 else 5
+    with tempfile.TemporaryDirectory() as tmp:
+        path = os.path.join(tmp, 'big.json')
+        n = build(path, mb)
+        print(f'db: {n} docs, {os.path.getsize(path) / 1e6:.1f} MB')
+
+        st = JSONStorage(path)
+        print(f'raw JSONStorage.read():  {best(st.read, repeats) * 1000:8.1f} ms')
+        st.close()
+
+        db = TinyDB(path)
+        q = where('address')['city'] == 'city42'
+
+        def cold_search():
+            db.table('_default').clear_cache()
+            return db.search(q)
+
+        print(f'db.all():                {best(db.all, repeats) * 1000:8.1f} ms')
+        print(f'db.search() cold cache:  {best(cold_search, repeats) * 1000:8.1f} ms')
+        print(f'db.search() warm cache:  {best(lambda: db.search(q), repeats) * 1000:8.1f} ms')
+        print(f'db.get(doc_id=1):        {best(lambda: db.get(doc_id=1), repeats) * 1000:8.1f} ms')
+
+        print('\ncProfile of db.all() + cold search (top 8 by tottime):')
+        pr = cProfile.Profile()
+        pr.enable()
+        db.all()
+        cold_search()
+        pr.disable()
+        pstats.Stats(pr).sort_stats('tottime').print_stats(8)
+        db.close()
+
+
+if __name__ == '__main__':
+    main()
