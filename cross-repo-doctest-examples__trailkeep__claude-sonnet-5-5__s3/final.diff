 # -*- coding: utf-8 -*-
+import unittest
 import bottle
 from .tools import ServerTestBase
 
@@ -10,3 +11,30 @@ class TestBasicAuth(ServerTestBase):
         def test(): return {}
         self.assertStatus(401)
         self.assertHeader('Www-Authenticate', 'Basic realm="private"')
+
+
+class TestBearerToken(unittest.TestCase):
+
+    def token(self, header=None):
+        environ = {} if header is None else {'HTTP_AUTHORIZATION': header}
+        return bottle.BaseRequest(environ).bearer_token
+
+    def test_bearer(self):
+        self.assertEqual('abc.def-123', self.token('Bearer abc.def-123'))
+
+    def test_scheme_case_insensitive(self):
+        self.assertEqual('abc', self.token('bearer abc'))
+        self.assertEqual('abc', self.token('BEARER abc'))
+
+    def test_no_header(self):
+        self.assertEqual(None, self.token())
+
+    def test_other_scheme(self):
+        self.assertEqual(None, self.token('Basic dXNlcjpwdw=='))
+
+    def test_missing_token(self):
+        self.assertEqual(None, self.token('Bearer'))
+        self.assertEqual(None, self.token('Bearer '))
+
+    def test_scheme_prefix_only(self):
+        self.assertEqual(None, self.token('Bearerabc'))
