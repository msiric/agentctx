+class TestRunPendingErrors:
+    def test_run_pending_runs_all_then_raises_first(self):
+        ran = []
+
+        def bad(name):
+            ran.append(name)
+            raise ValueError(name)
+
+        with mock_datetime(2010, 1, 6, 12, 15, 0):
+            s = schedule.Scheduler()
+            s.every().second.do(bad, "a")
+            s.every().second.do(lambda: ran.append("ok"))
+            s.every().second.do(bad, "b")
+        with mock_datetime(2010, 1, 6, 12, 15, 5):
+            with pytest.raises(ValueError) as cm:
+                s.run_pending()
+        assert str(cm.value) == "a"
+        assert sorted(ran) == ["a", "b", "ok"]
