+def percent(value: NumberOrString, precision: int = 1) -> str:
+    """Format a fraction as a percentage.
+
+    Examples:
+        ```pycon
+        >>> percent(0.125)
+        '12.5%'
+        >>> percent(0.5)
+        '50.0%'
+        >>> percent(1, 0)
+        '100%'
+        >>> percent(0.0625)
+        '6.3%'
+        >>> percent(0.125, 0)
+        '13%'
+        >>> percent("0.256", 2)
+        '25.60%'
+        >>> percent("foo")
+        'foo'
+        >>> percent(None)
+        'None'
+
+        ```
+
+    Args:
+        value (int, float, str): Fraction to format, where 1 is 100%.
+        precision (int): Number of decimal places.
+
+    Returns:
+        str: The percentage, rounded half up, or the input as a string if it is not a number.
+    """
+    import math
+
+    try:
+        value = float(value)
+        if not math.isfinite(value):
+            return _format_not_finite(value)
+    except (ValueError, TypeError):
+        return str(value)
+    # Round half up on the decimal representation, matching billing's
+    # invoices. Binary float formatting would round half to even (and be
+    # skewed by representation error), e.g. 0.125 -> "12%" at precision 0.
+    ctx = decimal.Context(prec=400, rounding=decimal.ROUND_HALF_UP)
+    exact = ctx.multiply(decimal.Decimal(repr(value)), 100)
+    rounded = ctx.quantize(exact, decimal.Decimal(1).scaleb(-int(precision)))
+    return f"{rounded:f}%"
+
