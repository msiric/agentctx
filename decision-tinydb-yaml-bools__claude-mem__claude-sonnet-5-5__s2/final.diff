+@requires_yaml
+def test_yaml_readwrite(tmpdir):
+    path = str(tmpdir.join('test.yml'))
+
+    with TinyDB(path, storage=YAMLStorage) as db:
+        db.insert({'int': 1, 'str': 'text', 'list': [1, 2], 'ünï': 'çödé'})
+        db.insert({'flag': True, 'none': None})
+
+    with TinyDB(path, storage=YAMLStorage) as db:
+        assert len(db) == 2
+        assert db.get(doc_id=1) == {'int': 1, 'str': 'text', 'list': [1, 2],
+                                    'ünï': 'çödé'}
+        assert db.get(doc_id=2) == {'flag': True, 'none': None}
+        assert db.search(where('int') == 1)
+
+    with open(path, encoding='utf-8') as f:
+        content = f.read()
+    assert 'çödé' in content
+    assert content.startswith('_default:')
+
+
+@requires_yaml
+def test_yaml_empty_and_comment_only_file(tmpdir):
+    path = str(tmpdir.join('test.yml'))
+
+    storage = YAMLStorage(path)
+    assert storage.read() is None
+    storage.close()
+
+    with open(path, 'w') as f:
+        f.write('# nothing here yet\n')
+
+    storage = YAMLStorage(path)
+    assert storage.read() is None
+    storage.close()
+
+
+@requires_yaml
+def test_yaml_string_ids_round_trip(tmpdir):
+    path = str(tmpdir.join('test.yml'))
+
+    with TinyDB(path, storage=YAMLStorage) as db:
+        db.insert({'a': 1})
+        db.insert({'a': 2})
+
+    with TinyDB(path, storage=YAMLStorage) as db:
+        assert [d.doc_id for d in db.all()] == [1, 2]
