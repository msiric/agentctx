+    doc = {'a': 'NO', 'b': 'off', 'c': 'true', 'd': '123', 'e': 'null',
+           'f': '', 'g': 'multi\nline'}
+
+    with TinyDB(path, storage=YAMLStorage) as db:
+        db.insert(doc)
+
+    with TinyDB(path, storage=YAMLStorage) as db:
+        assert db.get(doc_id=1) == doc
