+
+@requires_yaml
+def test_yaml_does_not_construct_python_objects(tmpdir):
+    path = str(tmpdir.join('test.yml'))
+
+    with open(path, 'w') as f:
+        f.write('_default:\n  "1": !!python/object/apply:os.getcwd []\n')
+
+    with pytest.raises(yaml.YAMLError):
