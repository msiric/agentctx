+
+@requires_yaml
+def test_yaml_shrinking_file_is_truncated(tmpdir):
+    path = str(tmpdir.join('test.yml'))
+
+    with TinyDB(path, storage=YAMLStorage) as db:
+        for i in range(20):
+            db.insert({'value': 'x' * 50, 'i': i})
+        db.truncate()
+
+    with TinyDB(path, storage=YAMLStorage) as db:
+        assert len(db) == 0
+
+
+@requires_yaml
+def test_yaml_read_only_mode(tmpdir):
+    path = str(tmpdir.join('test.yml'))
+
+    with TinyDB(path, storage=YAMLStorage) as db:
+        db.insert({'a': 1})
+
+    with TinyDB(path, storage=YAMLStorage, access_mode='r') as db:
+        assert db.all() == [{'a': 1}]
+        with pytest.raises(IOError):
+            db.insert({'a': 2})
+
+
+@requires_yaml
+def test_yaml_create_dirs(tmpdir):
+    path = str(tmpdir.join('a', 'b', 'test.yml'))
+
+    with TinyDB(path, storage=YAMLStorage, create_dirs=True) as db:
+        db.insert({'a': 1})
+
+    assert os.path.exists(path)
