def _make_yaml_loader(yaml):
    """
    Build a safe YAML loader that follows the YAML 1.2 core schema for
    booleans.

    PyYAML implements YAML 1.1, where unquoted ``yes``, ``no``, ``on``, ``off``
    (and ``y``/``n``) are booleans. In hand-edited files this silently turns
    values like ``country: NO`` into ``False``. This loader only treats
    ``true``/``false`` (in the casings ``true``, ``True``, ``TRUE`` and the
    same for ``false``) as booleans.
    """

    class _Loader(yaml.SafeLoader):
        pass

    # Copy the resolver table so we don't modify the one shared with SafeLoader
    resolvers = {
        char: [(tag, regexp) for tag, regexp in entries
               if tag != 'tag:yaml.org,2002:bool']
        for char, entries in yaml.SafeLoader.yaml_implicit_resolvers.items()
    }
    _Loader.yaml_implicit_resolvers = resolvers
    _Loader.add_implicit_resolver(
        'tag:yaml.org,2002:bool',
        re.compile(r'^(?:true|True|TRUE|false|False|FALSE)$'),
        list('tTfF'),
    )

    return _Loader


class YAMLStorage(FileStorage):
    """
    Store the data in a YAML file.

    Requires `PyYAML <https://pyyaml.org/>`_ to be installed. Data is loaded
    with a safe loader, so arbitrary Python objects can't be constructed from
    the file. Only ``true`` and ``false`` are read as booleans, so unquoted
    values such as ``NO`` or ``off`` in hand-edited files stay strings.
    """

    def __init__(self, path: str, create_dirs=False, encoding=None, access_mode='r+', **kwargs):
        """
        Create a new instance.

        Also creates the storage file, if it doesn't exist and the access mode
        is appropriate for writing.

        **Note:** Using an access mode other than `r` or `r+` will probably
        lead to data loss or data corruption!

        :param path: Where to store the YAML data.
        :param access_mode: mode in which the file is opened (r, r+)
        :param kwargs: Extra arguments for ``yaml.safe_dump``.
        :type access_mode: str
        """

        try:
            import yaml
        except ImportError as e:
            raise ImportError('YAMLStorage requires PyYAML: pip install pyyaml') from e

        super().__init__(path, create_dirs=create_dirs, encoding=encoding,
                         access_mode=access_mode)

        self._yaml = yaml
        self._loader = _make_yaml_loader(yaml)
        self.kwargs = kwargs

    def read(self) -> Optional[dict[str, dict[str, Any]]]:
        self._handle.seek(0)

        # An empty file, or one that only contains comments, loads as ``None``
        # which tells TinyDB to initialize the database
        return self._yaml.load(self._handle, Loader=self._loader)

    def write(self, data: dict[str, dict[str, Any]]):
        self._handle.seek(0)

        options = {'default_flow_style': False, 'sort_keys': False,
                   'allow_unicode': True}
        options.update(self.kwargs)
        serialized = self._yaml.safe_dump(data, **options)

        try:
            self._handle.write(serialized)
        except io.UnsupportedOperation:
            raise IOError('Cannot write to the database. Access mode is "{0}"'.format(self._mode))

        self._handle.flush()
        os.fsync(self._handle.fileno())

        # Remove data that is behind the new cursor in case the file has
        # gotten shorter
        self._handle.truncate()
'''
