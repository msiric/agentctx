+
+/**
+ * Checks if two URLs have the same origin (scheme, host and port).
+ *
+ * - Scheme and host are case-insensitive, default ports are normalized.
+ * - Userinfo, path, query and hash are ignored.
+ * - Relative URLs only match other relative URLs; protocol-relative URLs
+ *   (`//host`) only match other protocol-relative URLs with the same host.
+ * - Opaque origins (`data:`, `javascript:`, `mailto:`...) and malformed
+ *   absolute URLs are never same-origin.
+ *
+ * @example
+ * ```js
+ * isSameOrigin("https://example.com/a", "https://example.com:443/b"); // true
+ * isSameOrigin("https://example.com", "http://example.com"); // false
+ * ```
+ *
+ * @group utils
+ */
+export function isSameOrigin(a: string, b: string): boolean {
+  const originA = _getOriginKey(a);
+  const originB = _getOriginKey(b);
+  if (originA === undefined || originB === undefined) {
+    return false;
+  }
+  return originA === originB;
+}
+
+// Returns a comparable key, "" for relative URLs, or undefined if no valid origin.
+function _getOriginKey(input: string): string | undefined {
+  try {
+    if (input.startsWith("//")) {
+      return "//" + new URL("http:" + input).host;
+    }
+    if (hasProtocol(input)) {
+      const { origin } = new URL(input);
+      return origin === "null" ? undefined : origin;
+    }
+  } catch {
+    return undefined;
+  }
+  return "";
+}
