diff --git a/test/same-origin.test.ts b/test/same-origin.test.ts
new file mode 100644
index 0000000..e1a718d
--- /dev/null
+++ b/test/same-origin.test.ts
@@ -0,0 +1,125 @@
+import { describe, expect, test } from "vitest";
+import { isSameOrigin } from "../src";
+
+describe("isSameOrigin", () => {
+  const sameOrigins = [
+    // Identical
+    ["https://example.com", "https://example.com"],
+    // Path, query and hash are ignored
+    ["https://example.com/foo", "https://example.com/bar"],
+    ["https://example.com/foo?a=1#x", "https://example.com"],
+    // Host is case-insensitive
+    ["https://EXAMPLE.com", "https://example.com"],
+    // Scheme is case-insensitive
+    ["HTTPS://example.com", "https://example.com"],
+    // Default ports are normalized
+    ["https://example.com:443", "https://example.com"],
+    ["http://example.com:80", "http://example.com"],
+    ["wss://example.com:443", "wss://example.com"],
+    ["ws://example.com:80", "ws://example.com"],
+    // Identical explicit ports
+    ["https://example.com:443/a", "https://example.com:443/b"],
+    ["http://example.com:80", "http://example.com:80"],
+    // Explicit non-default ports
+    ["https://example.com:8080/a", "https://example.com:8080/b"],
+    // Userinfo is not part of the origin
+    ["https://user:pass@example.com", "https://example.com"],
+    // IP hosts
+    ["http://127.0.0.1:3000/a", "http://127.0.0.1:3000/b"],
+    ["http://[::1]:3000", "http://[::1]:3000/x"],
+    // Punycode (IDN) equivalence
+    ["https://тест.com", "https://xn--e1aybc.com"],
+  ];
+
+  const differentOrigins = [
+    // Different scheme
+    ["http://example.com", "https://example.com"],
+    ["ws://example.com", "wss://example.com"],
+    // Different host
+    ["https://example.com", "https://example.org"],
+    // Subdomains are different origins
+    ["https://example.com", "https://www.example.com"],
+    ["https://a.example.com", "https://b.example.com"],
+    // Different port
+    ["https://example.com:8080", "https://example.com"],
+    ["https://example.com:8080", "https://example.com:8081"],
+    // Non-default explicit port vs omitted port
+    ["http://example.com:443", "http://example.com"],
+    ["https://example.com:80", "https://example.com"],
+    // Lookalike hosts
+    ["https://example.com", "https://example.com.evil.com"],
+    ["https://example.com@evil.com", "https://example.com"],
+  ];
+
+  for (const [a, b] of sameOrigins) {
+    test(`${a} == ${b}`, () => {
+      expect(isSameOrigin(a, b)).toBe(true);
+      // Symmetric
+      expect(isSameOrigin(b, a)).toBe(true);
+    });
+  }
+
+  for (const [a, b] of differentOrigins) {
+    test(`${a} != ${b}`, () => {
+      expect(isSameOrigin(a, b)).toBe(false);
+      expect(isSameOrigin(b, a)).toBe(false);
+    });
+  }
+
+  describe("relative and non-absolute inputs", () => {
+    // Open question: relative URLs have no origin of their own.
+    // Proposed: a relative input never matches an absolute one, and two
+    // relative inputs are considered same-origin (both inherit the base).
+    test("relative vs absolute is false", () => {
+      expect(isSameOrigin("/foo", "https://example.com/foo")).toBe(false);
+      expect(isSameOrigin("https://example.com/foo", "/foo")).toBe(false);
+    });
+
+    test("relative vs relative is true", () => {
+      expect(isSameOrigin("/foo", "/bar")).toBe(true);
+      expect(isSameOrigin("foo?a=1", "#hash")).toBe(true);
+    });
+
+    // Open question: protocol-relative URLs (`//host`) have a host but no scheme.
+    // Proposed: they only match when the host (and port) matches, and the
+    // other side is also protocol-relative.
+    test("protocol-relative", () => {
+      expect(isSameOrigin("//example.com/a", "//example.com/b")).toBe(true);
+      expect(isSameOrigin("//example.com", "//example.org")).toBe(false);
+      expect(isSameOrigin("//example.com", "https://example.com")).toBe(false);
+    });
+  });
+
+  describe("opaque / special origins", () => {
+    // Proposed: origins that serialize to "null" are never same-origin,
+    // not even with themselves (matches the web platform).
+    test("data: and javascript: are never same-origin", () => {
+      expect(isSameOrigin("data:text/plain,hi", "data:text/plain,hi")).toBe(
+        false,
+      );
+      expect(isSameOrigin("javascript:void(0)", "javascript:void(0)")).toBe(
+        false,
+      );
+    });
+
+    test("mailto: / tel: are never same-origin", () => {
+      expect(isSameOrigin("mailto:a@b.com", "mailto:a@b.com")).toBe(false);
+      expect(isSameOrigin("tel:+123", "tel:+123")).toBe(false);
+    });
+  });
+
+  describe("invalid / empty input", () => {
+    test("empty strings", () => {
+      // Two empty (relative) inputs follow the relative-vs-relative rule.
+      expect(isSameOrigin("", "")).toBe(true);
+      expect(isSameOrigin("", "https://example.com")).toBe(false);
+    });
+
+    test("malformed absolute URLs do not throw and return false", () => {
+      expect(isSameOrigin("https://", "https://")).toBe(false);
+      expect(isSameOrigin("http://exa mple.com", "http://exa mple.com")).toBe(
+        false,
+      );
+    });
+  });
+});
