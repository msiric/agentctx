+def test_gzip_json(tmpdir):
+    import gzip
+    from tinydb.storages import GzipJSONStorage
+
+    path = str(tmpdir.join('test.db.gz'))
+
+    with TinyDB(path, storage=GzipJSONStorage) as db:
+        db.insert_multiple({'int': i, 'text': 'x' * 100} for i in range(100))
+        db.remove(where('int') < 90)
+
+    with TinyDB(path, storage=GzipJSONStorage) as db:
+        assert len(db) == 10
+
+    # The file really is gzip and shrank after removal
+    with gzip.open(path) as f:
+        assert b'"int": 95' in f.read()
