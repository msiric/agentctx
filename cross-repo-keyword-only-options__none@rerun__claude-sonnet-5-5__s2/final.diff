+    def test_to_dict_skip_none(self):
+        prop = self.dict_class({
+            'a': None,
+            'b': 1,
+            'c': {'d': None, 'e': 2, 'f': {'g': None}},
+            'h': [{'i': None, 'j': 3}, None, 4],
+            'k': ({'l': None},),
+        })
+        self.assertDictEqual(prop.to_dict(skip_none=True), {
+            'b': 1,
+            'c': {'e': 2, 'f': {}},
+            'h': [{'j': 3}, None, 4],
+            'k': ({},),
+        })
+
+    def test_to_dict_skip_none_default_off(self):
+        nested = {'a': None, 'b': {'c': None}, 'd': [{'e': None}]}
+        prop = self.dict_class(nested)
+        self.assertDictEqual(prop.to_dict(), nested)
+        self.assertDictEqual(prop.to_dict(skip_none=False), nested)
+
     def test_update(self):
