 ```
 
+## API
+
+### parseMilliseconds(milliseconds, options?)
+
+Accepts a finite `number` or a `bigint`. Throws a `TypeError` for anything else.
+
+#### options
+
+##### largestUnit
+
+Type: `'days' | 'hours' | 'minutes' | 'seconds'`\
+Default: `'days'`
+
+The largest unit to include. Larger units roll into it, so units above it are `0`. Any other value throws a `TypeError`.
+
 ## Related
 
 - [to-milliseconds](https://github.com/sindresorhus/to-milliseconds) - The inverse of this module
diff --git a/test.js b/test.js
index 6314aab..8642959 100644
--- a/test.js
+++ b/test.js
@@ -292,3 +292,50 @@ test('keep the sub-day parts exact at any magnitude', () => {
 		assert.strictEqual(parsed.hours, Number(bigint.hours), `${milliseconds}ms hours against the bigint path`);
 	}
 });
+
+test('largestUnit rolls larger units into the chosen one', () => {
+	const milliseconds = 93_784_005; // 1d 2h 3m 4s 5ms
+	const zero = {microseconds: 0, nanoseconds: 0};
+
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit: 'days'}), parseMilliseconds(milliseconds));
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit: 'hours'}), {
+		days: 0, hours: 26, minutes: 3, seconds: 4, milliseconds: 5, ...zero,
+	});
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit: 'minutes'}), {
+		days: 0, hours: 0, minutes: 1563, seconds: 4, milliseconds: 5, ...zero,
+	});
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit: 'seconds'}), {
+		days: 0, hours: 0, minutes: 0, seconds: 93_784, milliseconds: 5, ...zero,
+	});
+	const negative = parseMilliseconds(-milliseconds, {largestUnit: 'hours'});
+	assert.deepStrictEqual(
+		[negative.days, negative.hours, negative.minutes, negative.seconds, negative.milliseconds],
+		[0, -26, -3, -4, -5],
+	);
+	assert.deepStrictEqual(parseMilliseconds(1.5, {largestUnit: 'seconds'}), {
+		days: 0, hours: 0, minutes: 0, seconds: 0, milliseconds: 1, microseconds: 500, nanoseconds: 0,
+	});
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {}), parseMilliseconds(milliseconds));
+});
+
+test('largestUnit works with bigint', () => {
+	const milliseconds = 93_784_005n;
+
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit: 'hours'}), {
+		days: 0n, hours: 26n, minutes: 3n, seconds: 4n, milliseconds: 5n, microseconds: 0n, nanoseconds: 0n,
+	});
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit: 'minutes'}), {
+		days: 0n, hours: 0n, minutes: 1563n, seconds: 4n, milliseconds: 5n, microseconds: 0n, nanoseconds: 0n,
+	});
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit: 'seconds'}), {
+		days: 0n, hours: 0n, minutes: 0n, seconds: 93_784n, milliseconds: 5n, microseconds: 0n, nanoseconds: 0n,
+	});
+	assert.strictEqual(parseMilliseconds(-milliseconds, {largestUnit: 'hours'}).hours, -26n);
+});
+
+test('largestUnit rejects invalid values', () => {
+	for (const largestUnit of ['milliseconds', 'weeks', 'Days', '', null, 1, {}]) {
+		assert.throws(() => parseMilliseconds(1000, {largestUnit}), TypeError, String(largestUnit));
+		assert.throws(() => parseMilliseconds(1000n, {largestUnit}), TypeError, String(largestUnit));
+	}
+});
