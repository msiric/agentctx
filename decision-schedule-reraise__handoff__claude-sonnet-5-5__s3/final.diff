+    def _run_job_collecting(self, job: "Job", errors: List[BaseException]) -> None:
+        # A raising job must not prevent the other due jobs from running.
+        try:
+            self._run_job(job)
+        except Exception as exc:
+            logger.exception("Job %s raised an exception", job)
+            errors.append(exc)
+
+    @staticmethod
+    def _raise_first(errors: List[BaseException]) -> None:
+        # Re-raise the first error once all jobs ran; later ones are only logged
+        # (ExceptionGroup needs Python 3.11+).
+        if errors:
+            raise errors[0]
