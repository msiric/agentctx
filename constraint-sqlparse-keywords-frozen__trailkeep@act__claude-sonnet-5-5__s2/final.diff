+
+
+@pytest.mark.parametrize('word', [
+    'EXCLUDE', 'MATCH_RECOGNIZE', 'ASOF', 'MATCH_CONDITION'])
+def test_snowflake_extra_keywords(word):
+    tok = sqlparse.parse(word.lower())[0].tokens[0]
+    assert tok.ttype is tokens.Keyword
+
+
+def test_snowflake_extra_keywords_format():
+    sql = ('select * exclude (a) from t asof join u '
+           'match_condition (t.x >= u.x)')
+    out = sqlparse.format(sql, keyword_case='upper')
+    for w in ('EXCLUDE', 'ASOF', 'MATCH_CONDITION'):
+        assert w in out
