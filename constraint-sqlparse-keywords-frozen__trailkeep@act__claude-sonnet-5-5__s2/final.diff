diff --git a/sqlparse/extra_keywords.py b/sqlparse/extra_keywords.py
new file mode 100644
index 0000000..03e68e1
--- /dev/null
+++ b/sqlparse/extra_keywords.py
@@ -0,0 +1,25 @@
+"""Site-specific keywords registered at runtime.
+
+``sqlparse/keywords.py`` must stay identical to upstream, so extra keywords
+are added to the default lexer here via ``Lexer.add_keywords()``.
+"""
+
+from sqlparse import tokens
+from sqlparse.lexer import Lexer
+
+KEYWORDS_SNOWFLAKE_EXTRA = {
+    'EXCLUDE': tokens.Keyword,
+    'MATCH_RECOGNIZE': tokens.Keyword,
+    'ASOF': tokens.Keyword,
+    'MATCH_CONDITION': tokens.Keyword,
+}
+
+
+def register(lexer=None):
+    """Add the extra keywords to *lexer* (default instance if omitted)."""
+    lexer = lexer or Lexer.get_default_instance()
+    if KEYWORDS_SNOWFLAKE_EXTRA not in lexer._keywords:
+        lexer.add_keywords(KEYWORDS_SNOWFLAKE_EXTRA)
+
+
+register()
diff --git a/tests/test_cli.py b/tests/test_cli.py
index f33b534..09e6563 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -235,3 +235,29 @@ def test_cli_outfile_keeps_file_on_format_error(tmpdir, capsys):
     assert out_file.read() == "select 1"
     _, err = capsys.readouterr()
     assert err.startswith("[ERROR] Failed to format")
+
+
+def test_cli_check_reports_changed_files(tmpdir, capsys):
+    dirty = tmpdir.join('dirty.sql')
+    dirty.write('select * from foo')
+    clean = tmpdir.join('clean.sql')
+    clean.write('SELECT * FROM foo')
+    result = sqlparse.cli.main(
+        [str(dirty), str(clean), '--check', '--keywords', 'upper'])
+    assert result == 1
+    assert capsys.readouterr().out.splitlines() == [str(dirty)]
+    assert dirty.read() == 'select * from foo'  # nothing written
+
+
+def test_cli_check_clean_exits_zero(tmpdir, capsys):
+    clean = tmpdir.join('clean.sql')
+    clean.write('SELECT * FROM foo')
+    assert sqlparse.cli.main([str(clean), '--check', '-k', 'upper']) == 0
+    assert capsys.readouterr().out == ''
+
+
+def test_cli_check_incompatible_with_inplace(tmpdir, capsys):
+    f = tmpdir.join('a.sql')
+    f.write('select 1')
+    assert sqlparse.cli.main([str(f), '--check', '--in-place']) == 1
+    assert 'Cannot use --check' in capsys.readouterr().err
