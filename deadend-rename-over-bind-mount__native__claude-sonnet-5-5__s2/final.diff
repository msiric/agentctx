--- a/tests/test_storages.py
+++ b/tests/test_storages.py
@@ -285,3 +285,68 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def test_json_write_is_atomic_on_crash(tmpdir, monkeypatch):
+    path = str(tmpdir.join('db.json'))
+
+    db = TinyDB(path)
+    db.insert({'a': 1})
+
+    # Simulate the process dying right before the rename
+    def boom(*args, **kwargs):
+        raise KeyboardInterrupt
+
+    monkeypatch.setattr(os, 'replace', boom)
+    with pytest.raises(KeyboardInterrupt):
+        db.insert({'b': 2})
+    monkeypatch.undo()
+    db.close()
+
+    # Old state is intact and readable, and no temp files are left behind
+    with TinyDB(path) as db2:
+        assert db2.all() == [{'a': 1}]
+    assert os.listdir(str(tmpdir)) == ['db.json']
+
+
+def test_json_write_crash_mid_serialization(tmpdir):
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+        with pytest.raises(TypeError):
+            db.insert({'b': object()})
+
+    with TinyDB(path) as db:
+        assert db.all() == [{'a': 1}]
+
+
+def test_json_leftover_tmp_file_is_ignored(tmpdir):
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+
+    # A partial temp file from a killed process must not affect the database
+    tmpdir.join('db.json.abc.tmp').write('{"_default": {"1": {"a"')
+
+    with TinyDB(path) as db:
+        assert db.all() == [{'a': 1}]
+        db.insert({'b': 2})
+        assert len(db) == 2
+
+
+def test_json_write_keeps_permissions_and_symlink(tmpdir):
+    real = tmpdir.join('real.json')
+    link = tmpdir.join('link.json')
+    real.write('')
+    os.chmod(str(real), 0o640)
+    os.symlink(str(real), str(link))
+
+    with TinyDB(str(link)) as db:
+        db.insert({'a': 1})
+        db.insert({'b': 2})
+
+    assert os.path.islink(str(link))
+    assert os.stat(str(real)).st_mode & 0o777 == 0o640
+    assert len(json.loads(real.read())['_default']) == 2
