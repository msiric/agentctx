+
+function getOrigin(input: unknown): string | undefined {
+  if (typeof input !== "string") {
+    return undefined;
+  }
+  try {
+    const url = new URL(input);
+    // Opaque origins (data:, javascript:, file:, ...) serialize as "null".
+    // `blob:` URLs inherit the origin of their payload, but are never treated as same-origin.
+    if (url.origin === "null" || url.protocol === "blob:") {
+      return undefined;
+    }
+    return url.origin;
+  } catch {
+    // Relative, protocol-relative and empty inputs have no origin
+    return undefined;
+  }
+}
+
+/**
+ * Checks if two URLs have the same origin (protocol, hostname and port).
+ *
+ * - Path, query, hash and userinfo are ignored.
+ * - Protocol and hostname are case-insensitive.
+ * - Default ports are normalized: `https://example.com` and `https://example.com:443` match (same for `:80` on `http`).
+ * - Inputs without an absolute origin (relative, protocol-relative, empty) and opaque origins (`data:`, `javascript:`, `blob:`, `file:`) never match.
+ *
+ * @example
+ *
+ * ```js
+ * isSameOrigin("https://example.com/a", "https://example.com:443/b"); // true
+ * isSameOrigin("https://example.com", "https://www.example.com"); // false
+ * ```
+ *
+ * @group utils
+ */
+export function isSameOrigin(a: string, b: string): boolean {
+  const originA = getOrigin(a);
+  return originA !== undefined && originA === getOrigin(b);
+}
