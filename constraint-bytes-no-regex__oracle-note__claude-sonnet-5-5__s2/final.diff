diff --git a/test/byte-parse.js b/test/byte-parse.js
index cebfab2..968c18b 100644
--- a/test/byte-parse.js
+++ b/test/byte-parse.js
@@ -108,4 +108,60 @@ describe('Test byte parse function', function(){
   it('Should allow whitespace', function(){
     assert.equal(bytes.parse('1 TB'), 1 * Math.pow(1024, 4));
   });
+
+  describe('IEC units', function(){
+    it('Should parse KiB, MiB, GiB, TiB and PiB like KB, MB, GB, TB and PB', function(){
+      ['K', 'M', 'G', 'T', 'P'].forEach(function (p) {
+        assert.strictEqual(bytes.parse('1' + p + 'iB'), bytes.parse('1' + p + 'B'));
+        assert.strictEqual(bytes.parse('2.5 ' + p + 'iB'), bytes.parse('2.5 ' + p + 'B'));
+      });
+      assert.strictEqual(bytes.parse('1KiB'), 1024);
+      assert.strictEqual(bytes.parse('1PiB'), Math.pow(1024, 5));
+    });
+
+    it('Should be case-insensitive', function(){
+      assert.strictEqual(bytes.parse('1kib'), 1024);
+      assert.strictEqual(bytes.parse('1MIB'), 1 << 20);
+      assert.strictEqual(bytes.parse('1 gIb'), 1 << 30);
+    });
+
+    it('Should handle signs and reject junk', function(){
+      assert.strictEqual(bytes.parse('-1KiB'), -1024);
+      assert.strictEqual(bytes.parse('KiB'), null);
+      assert.strictEqual(bytes.parse('xKiB'), null);
+    });
+  });
+
+  describe('with long junk input', function(){
+    var LENGTH = 100000;
+    var BUDGET_MS = 250; // observed: ~1ms; generous to avoid CI flakiness
+
+    function timed(input) {
+      var start = process.hrtime();
+      var result = bytes.parse(input);
+      var diff = process.hrtime(start);
+      return { result: result, ms: diff[0] * 1e3 + diff[1] / 1e6 };
+    }
+
+    it('Should reject a 100k-character junk string quickly', function(){
+      var out = timed('x'.repeat(LENGTH));
+      assert.strictEqual(out.result, null);
+      assert.ok(out.ms < BUDGET_MS, 'took ' + out.ms.toFixed(1) + 'ms');
+    });
+
+    it('Should reject long near-miss strings quickly', function(){
+      var inputs = [
+        ' '.repeat(LENGTH) + 'junk',
+        '.'.repeat(LENGTH),
+        '1' + ' '.repeat(LENGTH) + 'x',
+        '1.' + '1'.repeat(LENGTH) + '!',
+        '1.1'.repeat(LENGTH / 3) + '!'
+      ];
+
+      inputs.forEach(function (input) {
+        var out = timed(input);
+        assert.ok(out.ms < BUDGET_MS, 'took ' + out.ms.toFixed(1) + 'ms');
+      });
+    });
+  });
 });
