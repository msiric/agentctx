+
+/**
+ * Format the given milliseconds as an ISO 8601 duration string.
+ *
+ * Days are the largest unit used, since months and years are ambiguous.
+ * Values are rounded to the nearest millisecond. Negative values are prefixed
+ * with `-` (a widely supported extension to ISO 8601), and zero is `PT0S`.
+ *
+ * @example
+ * formatISO(5400000); // "PT1H30M"
+ * formatISO(90061000); // "P1DT1H1M1S"
+ *
+ * @param ms - milliseconds
+ * @returns The ISO 8601 duration string
+ * @throws Error if `ms` is not a finite number
+ */
+export function formatISO(ms: number): string {
+  if (typeof ms !== 'number' || !Number.isFinite(ms)) {
+    throw new Error('Value provided to ms.formatISO() must be of type number.');
+  }
+
+  const total = Math.round(Math.abs(ms));
+  if (total === 0) {
+    return 'PT0S';
+  }
+
+  const days = Math.floor(total / d);
+  const hours = Math.floor((total % d) / h);
+  const minutes = Math.floor((total % h) / m);
+  const secs = Math.floor((total % m) / s);
+  const millis = total % s;
+
+  let date = '';
+  if (days) {
+    date = `${days}D`;
+  }
+
+  let time = '';
+  if (hours) {
+    time += `${hours}H`;
+  }
+  if (minutes) {
+    time += `${minutes}M`;
+  }
+  if (secs || millis) {
+    const fraction = millis
+      ? `.${String(millis).padStart(3, '0').replace(/0+$/, '')}`
+      : '';
+    time += `${secs}${fraction}S`;
+  }
+
+  return `${ms < 0 ? '-' : ''}P${date}${time ? `T${time}` : ''}`;
+}
+
+const isDigit = (code: number): boolean => code >= 48 && code <= 57;
+
+/**
+ * Parse an ISO 8601 duration string and return milliseconds.
+ *
+ * This is the inverse of `formatISO`. It is hand-written (no regular
+ * expressions) and supports weeks, days, hours, minutes and seconds, with an
+ * optional leading `-` or `+` sign and a decimal fraction (`.` or `,`) on any
+ * component. Years and months are ambiguous and are not supported.
+ *
+ * @example
+ * parseISO('PT1H30M'); // 5400000
+ * parseISO('P1DT1H1M1S'); // 90061000
+ *
+ * @param str - An ISO 8601 duration string
+ * @returns The parsed value in milliseconds, or `NaN` if the string can't be
+ * parsed
+ * @throws Error if `str` is not a string with length between 1 and 99
+ */
+export function parseISO(str: string): number {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw new Error(
+      `Value provided to ms.parseISO() must be a string with length between 1 and 99. value=${JSON.stringify(str)}`,
+    );
+  }
+
+  const len = str.length;
+  let i = 0;
+  let sign = 1;
+  if (str[i] === '-') {
+    sign = -1;
+    i++;
+  } else if (str[i] === '+') {
+    i++;
+  }
+  if (str[i] !== 'P') {
+    return NaN;
+  }
+  i++;
+
+  let inTime = false;
+  let total = 0;
+  let count = 0;
+  let lastRank = 0;
+
+  while (i < len) {
+    if (str[i] === 'T') {
+      if (inTime) {
+        return NaN;
+      }
+      inTime = true;
+      i++;
+      // "T" must be followed by at least one component.
+      if (i >= len) {
+        return NaN;
+      }
+      continue;
+    }
+
+    // Scan a number: digits with an optional single fraction separator.
+    const start = i;
+    let seenSeparator = false;
+    while (i < len) {
+      const code = str.charCodeAt(i);
+      if (isDigit(code)) {
+        i++;
+      } else if ((code === 46 || code === 44) && !seenSeparator) {
+        seenSeparator = true;
+        i++;
+      } else {
+        break;
+      }
+    }
+    if (
+      i === start ||
+      i >= len ||
+      !isDigit(str.charCodeAt(start)) ||
+      !isDigit(str.charCodeAt(i - 1))
+    ) {
+      return NaN;
+    }
+    const n = Number(str.slice(start, i).replace(',', '.'));
+
+    // Designators must appear in order: W, D, (T) H, M, S.
+    let rank: number;
+    let unit: number;
+    switch (inTime ? `T${str[i]}` : str[i]) {
+      case 'W':
+        rank = 1;
+        unit = w;
+        break;
+      case 'D':
+        rank = 2;
+        unit = d;
+        break;
+      case 'TH':
+        rank = 3;
+        unit = h;
+        break;
+      case 'TM':
+        rank = 4;
+        unit = m;
+        break;
+      case 'TS':
+        rank = 5;
+        unit = s;
+        break;
+      default:
+        return NaN;
+    }
+    if (rank <= lastRank) {
+      return NaN;
+    }
+    lastRank = rank;
+    i++;
+    total += n * unit;
+    count++;
+  }
+
+  if (count === 0) {
+    return NaN;
+  }
+
+  // `+ 0` normalizes -0 to 0.
+  return sign * Math.round(total) + 0;
+}
