 ```
 
+##### significantDigits
+
+Type: `number`\
+Default: `3`
+
+The number of significant digits to round to. Only applies when neither `minimumFractionDigits` nor `maximumFractionDigits` is set.
+
+The integer part is never rounded away, so `123` bytes is still `123 B` with `significantDigits: 2`.
+
+Must be an integer between 1 and 100. Throws a `TypeError` for invalid values.
+
+```js
+import prettyBytes from 'pretty-bytes';
+
+prettyBytes(1337, {significantDigits: 2});
+//=> '1.3 kB'
+
+prettyBytes(1337, {significantDigits: 4});
+//=> '1.337 kB'
+```
+
 ##### unit
 
 Type: `string`\
diff --git a/test.js b/test.js
index bfdf321..ed1ee96 100644
--- a/test.js
+++ b/test.js
@@ -1183,3 +1183,27 @@ test('unit must belong to the active unit system', t => {
 		t.throws(() => prettyBytes(1337, {...options, unit}), {instanceOf: TypeError}, `${unit} with ${JSON.stringify(options)}`);
 	}
 });
+
+test('significantDigits changes the default rounding', t => {
+	t.is(prettyBytes(1337, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 3}), '1.34 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 1}), '1 kB');
+	t.is(prettyBytes(123, {significantDigits: 1}), '123 B');
+	t.is(prettyBytes(123_456, {significantDigits: 5}), '123.46 kB');
+	t.is(prettyBytes(999_999, {significantDigits: 4}), '1 MB');
+	t.is(prettyBytes(1337n, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 2, locale: 'de'}), '1,3 kB');
+	t.is(prettyBytes(1337, {significantDigits: undefined}), '1.34 kB');
+});
+
+test('significantDigits is ignored when fraction digits are set', t => {
+	t.is(prettyBytes(1337, {significantDigits: 2, maximumFractionDigits: 2}), '1.33 kB');
+	t.is(prettyBytes(1900, {significantDigits: 1, minimumFractionDigits: 3}), '1.900 kB');
+});
+
+test('significantDigits must be an integer between 1 and 100', t => {
+	for (const value of [0, -1, 1.5, 101, Number.NaN, '3', null]) {
+		t.throws(() => prettyBytes(1337, {significantDigits: value}), {instanceOf: TypeError}, `${value}`);
+	}
+});
