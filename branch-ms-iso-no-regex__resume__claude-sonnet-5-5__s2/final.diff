@@ -0,0 +1,80 @@
+import { describe, expect, it } from '@jest/globals';
+import { formatISO, parseISO } from './index';
+
+describe('parseISO(string)', () => {
+  it('should parse the examples', () => {
+    expect(parseISO('PT1H30M')).toBe(5400000);
+    expect(parseISO('P1DT1H1M1S')).toBe(90061000);
+  });
+
+  it('should parse zero', () => {
+    expect(parseISO('PT0S')).toBe(0);
+    expect(parseISO('P0D')).toBe(0);
+  });
+
+  it('should parse single components', () => {
+    expect(parseISO('PT1S')).toBe(1000);
+    expect(parseISO('PT1M')).toBe(60000);
+    expect(parseISO('PT1H')).toBe(3600000);
+    expect(parseISO('P1D')).toBe(86400000);
+    expect(parseISO('P1W')).toBe(604800000);
+  });
+
+  it('should distinguish months from minutes', () => {
+    expect(parseISO('P1M')).not.toBe(parseISO('PT1M'));
+    expect(parseISO('PT1M')).toBe(60000);
+    expect(parseISO('P1M')).toBeCloseTo(30.4375 * 86400000, -1);
+  });
+
+  it('should parse years using the average year length', () => {
+    expect(parseISO('P1Y')).toBe(Math.round(365.25 * 86400000));
+  });
+
+  it('should parse fractional seconds with . or ,', () => {
+    expect(parseISO('PT1.5S')).toBe(1500);
+    expect(parseISO('PT0,001S')).toBe(1);
+    expect(parseISO('PT1.1S')).toBe(1100);
+  });
+
+  it('should parse negative durations', () => {
+    expect(parseISO('-PT1H30M')).toBe(-5400000);
+    expect(parseISO('-P1D')).toBe(-86400000);
+  });
+
+  it('should be case insensitive', () => {
+    expect(parseISO('pt1h30m')).toBe(5400000);
+  });
+
+  it('should round-trip with formatISO', () => {
+    for (const value of [0, 1, 999, 1000, 1500, 5400000, 90061001, -5400000]) {
+      expect(parseISO(formatISO(value))).toBe(value);
+    }
+  });
+
+  it('should return NaN for invalid strings', () => {
+    for (const value of [
+      '',
+      'P',
+      'PT',
+      'P1DT',
+      '1H30M',
+      'PT1H30',
+      'PT30M1H',
+      'PT1H1H',
+      'P1H',
+      'PT1D',
+      'PT-1H',
+      'PT1H ',
+      ' PT1H',
+      'PT.5S',
+      'hello',
+    ]) {
+      expect(parseISO(value)).toBeNaN();
+    }
+  });
+
+  it('should return NaN for non-strings and overly long input', () => {
+    expect(parseISO(undefined as unknown as string)).toBeNaN();
+    expect(parseISO(`PT${'1'.repeat(100)}S`)).toBeNaN();
+  });
+});
