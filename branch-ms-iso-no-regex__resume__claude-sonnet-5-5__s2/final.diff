@@ -242,3 +242,98 @@ function plural(
   const isPlural = msAbs >= n * 1.5;
   return `${Math.round(ms / n)} ${name}${isPlural ? 's' : ''}` as StringValue;
 }
+
+/**
+ * Format the given milliseconds as an ISO 8601 duration string, e.g.
+ * `PT1H30M` or `P1DT1H1M1S`. Days are the largest unit used, since months and
+ * years are ambiguous in length. Negative values are prefixed with `-`, and
+ * sub-second precision is expressed as a decimal fraction of the seconds.
+ * Values are rounded to the nearest millisecond.
+ *
+ * @param ms - milliseconds
+ * @returns The ISO 8601 duration string
+ * @throws Error if `ms` is not a finite number
+ */
+export function formatISO(ms: number): string {
+  if (typeof ms !== 'number' || !Number.isFinite(ms)) {
+    throw new Error('Value provided to ms.formatISO() must be of type number.');
+  }
+
+  let rest = Math.round(Math.abs(ms));
+  const days = Math.floor(rest / d);
+  rest -= days * d;
+  const hours = Math.floor(rest / h);
+  rest -= hours * h;
+  const minutes = Math.floor(rest / m);
+  rest -= minutes * m;
+  const seconds = Math.floor(rest / s);
+  const millis = rest - seconds * s;
+
+  let time = '';
+  if (hours) time += `${hours}H`;
+  if (minutes) time += `${minutes}M`;
+  if (seconds || millis) {
+    const fraction = millis
+      ? `.${String(millis).padStart(3, '0').replace(/0+$/, '')}`
+      : '';
+    time += `${seconds}${fraction}S`;
+  }
+
+  if (!days && !time) {
+    return 'PT0S';
+  }
+
+  const sign = ms < 0 && Math.round(Math.abs(ms)) > 0 ? '-' : '';
+  return `${sign}P${days ? `${days}D` : ''}${time ? `T${time}` : ''}`;
+}
+
+/**
+ * Parse an ISO 8601 duration string such as `PT1H30M` or `P1DT1H1M1S` and
+ * return the total in milliseconds. This is the inverse of `formatISO`.
+ * Years, months, weeks, days, hours, minutes and seconds are supported, the
+ * smallest component may have a decimal fraction (`.` or `,`), and a leading
+ * `-` negates the whole duration. Years and months use the same average
+ * lengths as `parse()`. The result is rounded to the nearest millisecond.
+ *
+ * @param str - An ISO 8601 duration string
+ * @returns The duration in milliseconds, or `NaN` if the string can't be
+ * parsed
+ */
+export function parseISO(str: string): number {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    return NaN;
+  }
+  const match =
+    /^(?<sign>-)?P(?!$)(?:(?<years>\d+(?:[.,]\d+)?)Y)?(?:(?<months>\d+(?:[.,]\d+)?)M)?(?:(?<weeks>\d+(?:[.,]\d+)?)W)?(?:(?<days>\d+(?:[.,]\d+)?)D)?(?:T(?=\d)(?:(?<hours>\d+(?:[.,]\d+)?)H)?(?:(?<minutes>\d+(?:[.,]\d+)?)M)?(?:(?<seconds>\d+(?:[.,]\d+)?)S)?)?$/i.exec(
+      str,
+    );
+
+  if (!match?.groups) {
+    return NaN;
+  }
+
+  const g = match.groups as Record<
+    | 'sign'
+    | 'years'
+    | 'months'
+    | 'weeks'
+    | 'days'
+    | 'hours'
+    | 'minutes'
+    | 'seconds',
+    string | undefined
+  >;
+  const n = (value: string | undefined) =>
+    parseFloat((value ?? '0').replace(',', '.'));
+  const total = Math.round(
+    n(g.years) * y +
+      n(g.months) * mo +
+      n(g.weeks) * w +
+      n(g.days) * d +
+      n(g.hours) * h +
+      n(g.minutes) * m +
+      n(g.seconds) * s,
+  );
+
+  return g.sign ? -total : total;
+}
