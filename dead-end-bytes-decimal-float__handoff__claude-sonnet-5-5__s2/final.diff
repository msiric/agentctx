+/**
+ * Scale a decimal digit string by 10^exp using exact digit arithmetic
+ * (no float error), flooring toward negative infinity.
+ *
+ * @param {string} sign
+ * @param {string} digits e.g. "2.01"
+ * @param {number} exp
+ *
+ * @returns {number}
+ * @private
+ */
+
+function parseDecimal(sign, digits, exp) {
+  var parts = digits.split('.');
+  var frac = parts[1] || '';
+
+  while (frac.length < exp) {
+    frac += '0';
+  }
+
+  var whole = Number(parts[0] + frac.slice(0, exp));
+  var dropped = /[1-9]/.test(frac.slice(exp));
+
+  if (sign === '-') {
+    return -whole - (dropped ? 1 : 0);
+  }
+
+  return whole;
+}
diff --git a/test/byte-parse.js b/test/byte-parse.js
index cebfab2..303da18 100644
--- a/test/byte-parse.js
+++ b/test/byte-parse.js
@@ -108,4 +108,47 @@ describe('Test byte parse function', function(){
   it('Should allow whitespace', function(){
     assert.equal(bytes.parse('1 TB'), 1 * Math.pow(1024, 4));
   });
+
+  describe('with decimal option', function(){
+    var opts = {decimal: true};
+
+    it('Should use powers of 1000', function(){
+      assert.strictEqual(bytes.parse('1kB', opts), 1000);
+      assert.strictEqual(bytes.parse('1 MB', opts), 1000000);
+      assert.strictEqual(bytes.parse('1GB', opts), 1e9);
+      assert.strictEqual(bytes.parse('1tb', opts), 1e12);
+      assert.strictEqual(bytes.parse('1PB', opts), 1e15);
+    });
+
+    it('Should be exact for vendor values', function(){
+      assert.strictEqual(bytes.parse('2.01 kB', opts), 2010);
+      assert.strictEqual(bytes.parse('4.1 MB', opts), 4100000);
+      assert.strictEqual(bytes.parse('8.2 GB', opts), 8200000000);
+      assert.strictEqual(bytes.parse('16.9 TB', opts), 16900000000000);
+    });
+
+    it('Should floor fractional bytes', function(){
+      assert.strictEqual(bytes.parse('1.0001kB', opts), 1000);
+      assert.strictEqual(bytes.parse('1.0009999kB', opts), 1000);
+      assert.strictEqual(bytes.parse('-1.0001kB', opts), -1001);
+      assert.strictEqual(bytes.parse('-1.5kB', opts), -1500);
+      assert.strictEqual(bytes.parse('+2kB', opts), 2000);
+    });
+
+    it('Should not change non-unit input', function(){
+      assert.strictEqual(bytes.parse('1024', opts), 1024);
+      assert.strictEqual(bytes.parse('foobar', opts), null);
+      assert.strictEqual(bytes.parse(10.5, opts), 10.5);
+    });
+
+    it('Should leave default behavior unchanged', function(){
+      assert.strictEqual(bytes.parse('1kB'), 1024);
+      assert.strictEqual(bytes.parse('1kB', {}), 1024);
+      assert.strictEqual(bytes.parse('1kB', {decimal: false}), 1024);
+    });
+
+    it('Should be forwarded by bytes()', function(){
+      assert.strictEqual(bytes('1kB', opts), 1000);
+    });
+  });
 });
