diff --git a/test/count.js b/test/count.js
new file mode 100644
index 0000000..064144d
--- /dev/null
+++ b/test/count.js
@@ -0,0 +1,53 @@
+const test = require('tape');
+const fn = require('../lib');
+
+test('count :: short group', t => {
+	t.is(fn(['-vvv'], { count: 'v' }).v, 3);
+	t.is(fn(['-v', '-v'], { count: ['v'] }).v, 2);
+	t.end();
+});
+
+test('count :: long repeated', t => {
+	t.is(fn(['--verbose', '--verbose'], { count: 'verbose' }).verbose, 2);
+	t.is(fn(['--verbose'], { count: 'verbose' }).verbose, 1);
+	t.end();
+});
+
+test('count :: does not consume next arg', t => {
+	const argv = fn(['-vv', 'foo', '-v', 'bar'], { count: 'v' });
+	t.is(argv.v, 3);
+	t.same(argv._, ['foo', 'bar']);
+	t.end();
+});
+
+test('count :: mixed with other flags', t => {
+	const argv = fn(['-vax', 'hi', '-v'], { count: 'v' });
+	t.is(argv.v, 2);
+	t.is(argv.a, true);
+	t.is(argv.x, 'hi');
+	t.end();
+});
+
+test('count :: aliases share one count', t => {
+	const argv = fn(['-v', '--verbose', '-vv'], { alias: { v: 'verbose' }, count: 'v' });
+	t.is(argv.v, 4);
+	t.is(argv.verbose, 4);
+	const argv2 = fn(['-vv', '--verbose'], { alias: { v: 'verbose' }, count: 'verbose' });
+	t.is(argv2.v, 3);
+	t.is(argv2.verbose, 3);
+	t.end();
+});
+
+test('count :: absent, default, and --no-', t => {
+	t.is(fn(['-a'], { count: 'v' }).v, undefined);
+	t.is(fn([], { count: 'v', default: { v: 1 } }).v, 1);
+	t.is(fn(['-vv', '--no-v'], { count: 'v' }).v, 0);
+	t.end();
+});
+
+test('count :: unknown still applies', t => {
+	const bad = [];
+	fn(['-v', '-x'], { alias: { v: 'verbose' }, count: 'v', unknown: f => bad.push(f) });
+	t.same(bad, ['-x']);
+	t.end();
+});
