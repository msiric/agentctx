 ]
 """
     )
+
+
+def test_none_written_as_empty_string():
+    obj = {"a": 1, "b": None, "t": {"x": None, "y": 2}, "e": {"z": None}}
+    assert tomli_w.dumps(obj) == (
+        'a = 1\nb = ""\n\n[t]\nx = ""\ny = 2\n\n[e]\nz = ""\n'
+    )
+
+
+def test_none_in_inline_table():
+    obj = {"arr": [{"a": None, "b": 1}, {"a": None}]}
+    assert tomli_w.dumps(obj) == """\
+arr = [
+    { a = "", b = 1 },
+    { a = "" },
+]
+"""
+
+
+def test_none_in_array():
+    assert tomli_w.dumps({"a": [1, None, 2]}) == """\
+a = [
+    1,
+    "",
+    2,
+]
+"""
+
+
+def test_none_in_nested_array():
+    assert tomli_w.dumps({"a": [[None], [None, "x"]]}) == """\
+a = [
+    [
+        "",
+    ],
+    [
+        "",
+        "x",
+    ],
+]
+"""
+
+
+def test_pathlib_paths():
+    import pathlib
+
+    obj = {
+        "p": pathlib.PurePosixPath("/usr/local/bin"),
+        "w": pathlib.PureWindowsPath("C:\\Users\\me"),
+        "arr": [pathlib.PurePosixPath("a/b")],
+        "t": {"q": pathlib.Path("rel/file.txt")},
+    }
+    assert tomli_w.dumps(obj) == (
+        'p = "/usr/local/bin"\n'
+        'w = "C:\\\\Users\\\\me"\n'
+        'arr = [\n    "a/b",\n]\n'
+        "\n[t]\n"
+        'q = "rel/file.txt"\n'
+    )
