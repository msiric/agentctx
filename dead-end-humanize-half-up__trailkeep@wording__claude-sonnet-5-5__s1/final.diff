+def percent(value: NumberOrString, precision: int = 1) -> str:
+    """Return a fraction formatted as a percentage.
+
+    Examples:
+        ```pycon
+        >>> percent(0.125)
+        '12.5%'
+        >>> percent(0.5)
+        '50.0%'
+        >>> percent(1)
+        '100.0%'
+        >>> percent(0.12345, 2)
+        '12.35%'
+        >>> percent(0.5, 0)
+        '50%'
+        >>> percent(0.0625)
+        '6.3%'
+        >>> percent("0.25")
+        '25.0%'
+        >>> percent("foo")
+        'foo'
+        >>> percent(None)
+        'None'
+
+        ```
+
+    Args:
+        value (int, float, str): Fraction to format, where 1 is 100%.
+        precision (int): Number of digits after the decimal point. Ties
+            round half up (away from zero), matching billing's invoices.
+
+    Returns:
+        str: The percentage, or the input as a string if it is not a number.
+    """
+    import math
+
+    try:
+        value = float(value)
+        if not math.isfinite(value):
+            return _format_not_finite(value)
+    except (ValueError, TypeError):
+        return str(value)
+    # Round half up on the decimal repr of the input, as billing does.
+    # Float formatting would round 0.0625 -> "6.2" (binary/half-even).
+    exp = Decimal(1).scaleb(-int(precision))
+    pct = (Decimal(repr(value)) * 100).quantize(exp, rounding=ROUND_HALF_UP)
+    return f"{pct:.{int(precision)}f}%"
+
