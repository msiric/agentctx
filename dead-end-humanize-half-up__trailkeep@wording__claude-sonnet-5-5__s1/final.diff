+def gigabytes(num_bytes: float | str, precision: int = 1) -> str:
+    """Format a number of bytes as decimal gigabytes (10**9 bytes).
+
+    Examples:
+        ```pycon
+        >>> gigabytes(1500000000)
+        '1.5 GB'
+        >>> gigabytes(10**9, 0)
+        '1 GB'
+        >>> gigabytes(1234567890, 2)
+        '1.23 GB'
+        >>> gigabytes("foo")
+        'foo'
+
+        ```
+
+    Args:
+        num_bytes (int, float, str): Number of bytes.
+        precision (int): Number of digits after the decimal point. Ties
+            round half up (away from zero), matching billing's invoices.
+
+    Returns:
+        str: The size in GB, or the input as a string if it is not a number.
+    """
+    import math
+
+    from humanize.number import _format_not_finite
+
+    try:
+        value = float(num_bytes)
+        if not math.isfinite(value):
+            return _format_not_finite(value)
+    except (ValueError, TypeError):
+        return str(num_bytes)
+    # Round half up on the decimal repr of the input, as billing does.
+    digits = int(precision)
+    exp = Decimal(1).scaleb(-digits)
+    gb = Decimal(repr(value)).scaleb(-9).quantize(exp, rounding=ROUND_HALF_UP)
+    return f"{gb:.{digits}f} GB"
