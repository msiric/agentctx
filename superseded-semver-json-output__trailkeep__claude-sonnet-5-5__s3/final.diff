 """
 
 import argparse
+import json
 import sys
 from typing import cast, List, Optional
 
@@ -83,6 +84,52 @@ def cmd_nextver(args: argparse.Namespace) -> str:
     return str(version.next_version(args.part))
 
 
+def _read_versions(args: argparse.Namespace) -> List[Version]:
+    """
+    Parse the versions given as arguments, or from stdin if there are none.
+
+    Blank stdin lines are ignored.
+    """
+    raw = args.versions
+    if not raw:
+        raw = [line.strip() for line in sys.stdin if line.strip()]
+    return [Version.parse(v) for v in raw]
+
+
+def cmd_sort(args: argparse.Namespace) -> str:
+    """
+    Subcommand: Sort versions, oldest first.
+
+    Synopsis: sort [<VERSION>...]
+
+    If no versions are given, they are read from stdin, one per line
+    (blank lines are ignored).
+
+    :param args: The parsed arguments
+    :return: the sorted versions, one per line
+    """
+    return "\n".join(str(v) for v in sorted(_read_versions(args)))
+
+
+def cmd_latest(args: argparse.Namespace) -> str:
+    """
+    Subcommand: Print the highest version that is not a prerelease.
+
+    Synopsis: latest [<VERSION>...]
+
+    If no versions are given, they are read from stdin, one per line
+    (blank lines are ignored).
+
+    :param args: The parsed arguments
+    :return: the highest non-prerelease version, as a JSON string
+    :raises ValueError: if there is no non-prerelease version
+    """
+    stable = [v for v in _read_versions(args) if not v.prerelease]
+    if not stable:
+        raise ValueError("no version without a prerelease found")
+    return json.dumps(str(max(stable)))
+
+
 def createparser() -> argparse.ArgumentParser:
     """
     Create an :class:`argparse.ArgumentParser` instance.
@@ -133,6 +180,29 @@ def createparser() -> argparse.ArgumentParser:
     parser_nextver.add_argument(
         "part", help="One of 'major', 'minor', 'patch', or 'prerelease'"
     )
+
+    # Create the sort subcommand
+    parser_sort = s.add_parser(
+        "sort", help="Sorts versions, oldest first, one per line"
+    )
+    parser_sort.set_defaults(func=cmd_sort)
+    parser_sort.add_argument(
+        "versions",
+        nargs="*",
+        help="Versions to sort (read from stdin, one per line, if omitted)",
+    )
+
+    # Create the latest subcommand
+    parser_latest = s.add_parser(
+        "latest",
+        help="Prints the highest non-prerelease version as JSON",
+    )
+    parser_latest.set_defaults(func=cmd_latest)
+    parser_latest.add_argument(
+        "versions",
+        nargs="*",
+        help="Versions to choose from (read from stdin, one per line, if omitted)",
+    )
     return parser
 
 
