+import io
 from argparse import Namespace
 from contextlib import contextmanager
 from unittest.mock import patch
 
 import pytest
 
+from semver.cli import cmd_latest, cmd_sort
 from semver import (
     cmd_bump,
     cmd_check,
@@ -155,3 +157,101 @@ def test_should_return_documented_error_code_for_invalid_version(cliargs, capsys
     # docs/pysemver.rst shows ``echo $?`` printing 2 for both commands
     assert main(cliargs) == 2
     assert capsys.readouterr().err.startswith("ERROR")
+
+
+def test_sort_parses_versions():
+    result = createparser().parse_args(["sort", "1.2.3", "1.0.0"])
+    assert result.versions == ["1.2.3", "1.0.0"]
+
+
+def test_sort_prints_plain_lines_oldest_first(capsys):
+    assert main(["sort", "1.10.0", "1.2.0", "1.2.0-rc.1", "0.9.0"]) == 0
+    out = capsys.readouterr().out
+    assert out == "0.9.0\n1.2.0-rc.1\n1.2.0\n1.10.0\n"
+
+
+def test_sort_single_version(capsys):
+    assert main(["sort", "1.2.3"]) == 0
+    assert capsys.readouterr().out == "1.2.3\n"
+
+
+def test_cmd_sort_returns_newline_joined_string():
+    assert cmd_sort(Namespace(versions=["2.0.0", "1.0.0"])) == "1.0.0\n2.0.0"
+
+
+def test_sort_invalid_version_prints_nothing_on_stdout(capsys):
+    assert main(["sort", "1.0.0", "1.2"]) == 2
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert captured.err.startswith("ERROR")
+
+
+def test_sort_reads_stdin_without_arguments(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO("1.10.0\n\n  \n1.2.0\n1.2.0-rc.1\n"))
+    assert main(["sort"]) == 0
+    assert capsys.readouterr().out == "1.2.0-rc.1\n1.2.0\n1.10.0\n"
+
+
+def test_sort_stdin_invalid_version_is_an_error(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO("1.0.0\nnope\n"))
+    assert main(["sort"]) == 2
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert captured.err.startswith("ERROR")
+
+
+def test_sort_arguments_take_precedence_over_stdin(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO("9.9.9\n"))
+    assert main(["sort", "2.0.0", "1.0.0"]) == 0
+    assert capsys.readouterr().out == "1.0.0\n2.0.0\n"
+
+
+def test_latest_parses_versions():
+    result = createparser().parse_args(["latest", "1.2.3", "1.0.0"])
+    assert result.versions == ["1.2.3", "1.0.0"]
+
+
+def test_latest_prints_highest_stable_version_as_json(capsys):
+    assert main(["latest", "1.2.0", "1.10.0", "2.0.0-rc.1", "0.9.0"]) == 0
+    assert capsys.readouterr().out == '"1.10.0"\n'
+
+
+def test_cmd_latest_returns_json_string():
+    assert cmd_latest(Namespace(versions=["1.0.0", "2.0.0"])) == '"2.0.0"'
+
+
+def test_latest_keeps_build_metadata(capsys):
+    assert main(["latest", "1.0.0", "1.1.0+build.5"]) == 0
+    assert capsys.readouterr().out == '"1.1.0+build.5"\n'
+
+
+def test_latest_reads_stdin_without_arguments(capsys, monkeypatch):
