+test('onRetry runs only when another attempt follows, after onFailedAttempt', async () => {
+	const events = [];
+	let attempts = 0;
+
+	await assert.rejects(pRetry(async () => {
+		attempts++;
+		throw fixtureError;
+	}, {
+		retries: 2,
+		minTimeout: 0,
+		onFailedAttempt({attemptNumber}) {
+			events.push(`failed${attemptNumber}`);
+		},
+		onRetry({attemptNumber, retriesLeft, retryDelay}) {
+			events.push(`retry${attemptNumber}:${retriesLeft}:${retryDelay}`);
+		},
+	}), rejectsWith(fixtureError));
+
+	assert.equal(attempts, 3);
+	assert.deepEqual(events, ['failed1', 'retry1:2:0', 'failed2', 'retry2:1:0', 'failed3']);
+});
+
+test('onRetry is awaited before the next attempt', async () => {
+	const events = [];
+	let attempts = 0;
+
+	await pRetry(async () => {
+		events.push('run');
+		if (++attempts === 1) {
+			throw fixtureError;
+		}
+	}, {
+		minTimeout: 0,
+		async onRetry() {
+			await delay(20);
+			events.push('retry');
+		},
+	});
+
+	assert.deepEqual(events, ['run', 'retry', 'run']);
+});
+
+test('onRetry is not called when shouldRetry returns false, or for AbortError', async () => {
+	let calls = 0;
+	const onRetry = () => {
+		calls++;
+	};
+
+	await assert.rejects(pRetry(async () => {
+		throw fixtureError;
+	}, {shouldRetry: () => false, onRetry}), rejectsWith(fixtureError));
+
+	await assert.rejects(pRetry(async () => {
+		throw new AbortError(fixtureError);
+	}, {onRetry}), rejectsWith(fixtureError));
+
+	assert.equal(calls, 0);
+});
+
+test('onRetry is called when shouldConsumeRetry returns false', async () => {
+	let calls = 0;
+	let attempts = 0;
+
+	await pRetry(async () => {
+		if (++attempts === 1) {
+			throw fixtureError;
+		}
+	}, {
+		retries: 1,
+		shouldConsumeRetry: () => false,
+		onRetry() {
+			calls++;
+		},
+	});
+
+	assert.equal(calls, 1);
+});
+
+test('onRetry can throw to abort retries', async () => {
+	const error = new Error('thrown from onRetry');
+	let attempts = 0;
+
+	await assert.rejects(pRetry(async () => {
+		attempts++;
+		throw fixtureError;
+	}, {
+		onRetry() {
+			throw error;
+		},
+	}), rejectsWith(error));
+
+	assert.equal(attempts, 1);
+});
+
