diff --git a/test/dashdash.js b/test/dashdash.js
new file mode 100644
index 0000000..06195cf
--- /dev/null
+++ b/test/dashdash.js
@@ -0,0 +1,41 @@
+const test = require('tape');
+const fn = require('../lib');
+
+test('opts["--"]: args after -- go to argv["--"]', t => {
+	const argv = fn(['a', '--foo', 'bar', '--', 'b', '--baz', '-x'], { '--': true });
+	t.deepEqual(argv, { _: ['a'], foo: 'bar', '--': ['b', '--baz', '-x'] });
+	t.end();
+});
+
+test('opts["--"]: empty array when no -- present', t => {
+	t.deepEqual(fn(['a', '-x'], { '--': true }), { _: ['a'], x: true, '--': [] });
+	t.deepEqual(fn([], { '--': true }), { _: [], '--': [] });
+	t.end();
+});
+
+test('opts["--"]: nothing after --', t => {
+	t.deepEqual(fn(['a', '--'], { '--': true }), { _: ['a'], '--': [] });
+	t.end();
+});
+
+test('opts["--"]: only first -- is the separator', t => {
+	t.deepEqual(fn(['a', '--', 'b', '--', 'c'], { '--': true }), { _: ['a'], '--': ['b', '--', 'c'] });
+	t.end();
+});
+
+test('opts["--"]: values after -- are not parsed or coerced', t => {
+	t.deepEqual(fn(['--', '123', '--no-x'], { '--': true }), { _: [], '--': ['123', '--no-x'] });
+	t.end();
+});
+
+test('opts["--"] unset: old behavior preserved', t => {
+	t.deepEqual(fn(['a', '--', 'b'], {}), { _: ['a', 'b'] });
+	t.deepEqual(fn(['a', '--', 'b'], { '--': false }), { _: ['a', 'b'] });
+	t.end();
+});
+
+test('opts["--"] works with alias, boolean, and default', t => {
+	const argv = fn(['-f', '--', 'x'], { '--': true, alias: { f: 'force' }, boolean: ['force'], default: { n: 1 } });
+	t.deepEqual(argv, { _: [], f: true, force: true, n: 1, '--': ['x'] });
+	t.end();
+});
