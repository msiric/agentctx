diff --git a/test/test_cli.py b/test/test_cli.py
index 154f1a2..ba66e27 100644
--- a/test/test_cli.py
+++ b/test/test_cli.py
@@ -483,3 +483,26 @@ def test_inprocess_jsonl_malformed_headers():
     )
     # output should still be produced (graceful fallback), with raw keys as headers
     assert out.strip() != ""
+
+
+def test_inprocess_jsonl_skips_blank_lines():
+    """In-process: blank lines in JSONL input are ignored"""
+    out = run_main_in_process(
+        ["-r", "jsonl", "-f", "tsv"], input_text='{"a": 1}\n\n{"a": 2}\n\n\n'
+    )
+    assert [l.strip() for l in out.splitlines()] == ["a", "1", "2"]
+
+
+def test_inprocess_jsonl_missing_key_default_marker():
+    """jsonl records lacking a key get "." with no extra flags"""
+    out = run_main_in_process(
+        ["-r", "jsonl", "-f", "tsv"], input_text='{"a": 1, "b": 2}\n{"a": 3}\n\n'
+    )
+    assert out.splitlines()[-1].split("\t")[-1].strip() == "."
+
+
+def test_inprocess_jsonl_missingval_override():
+    out = run_main_in_process(
+        ["-r", "jsonl", "-f", "tsv", "-m", "NA"], input_text='{"a": 1, "b": 2}\n{"a": 3}\n'
+    )
+    assert out.splitlines()[-1].split("\t")[-1].strip() == "NA"
