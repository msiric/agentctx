new file mode 100644
index 0000000..46eee00
--- /dev/null
+++ b/scripts/export_invoices.py
@@ -0,0 +1,41 @@
+#!/usr/bin/env python3
+"""Export the ``invoices`` table of a TinyDB db.json file to CSV.
+
+Usage: export_invoices.py DB_PATH OUT_CSV
+
+Output is semicolon-delimited UTF-8 with a BOM, which German-locale Excel opens correctly.
+"""
+import csv
+import json
+import sys
+
+COLUMNS = ["number", "customer", "amount", "due_date"]
+
+
+def main(argv):
+    if len(argv) != 3:
+        print(f"usage: {argv[0]} DB_PATH OUT_CSV", file=sys.stderr)
+        return 2
+    db_path, out_path = argv[1], argv[2]
+
+    with open(db_path, encoding="utf-8") as f:
+        data = json.load(f)
+
+    if "invoices" not in data:
+        print(f"error: no 'invoices' table in {db_path}", file=sys.stderr)
+        return 1
+
+    # TinyDB stores a table as {doc_id: document}
+    docs = data["invoices"].values()
+
+    with open(out_path, "w", newline="", encoding="utf-8-sig") as f:
+        writer = csv.DictWriter(f, fieldnames=COLUMNS, extrasaction="ignore", delimiter=";")
+        writer.writeheader()
+        writer.writerows(docs)
+
+    print(f"wrote {len(docs)} invoices to {out_path}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
