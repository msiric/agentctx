grep -n "Optional" tinydb/table.py | head -3
cat >> tests/test_tables.py <<'EOF'


def test_to_csv_default_fields(db, tmp_path):
    import csv

    table = db.table('csv')
    table.insert({'a': 1, 'b': 'x'})
    table.insert({'b': 'y, "q"', 'c': 3})

    path = tmp_path / 'out.csv'
    table.to_csv(path)

    with open(path, newline='', encoding='utf-8') as f:
        rows = list(csv.reader(f))

    assert rows == [['a', 'b', 'c'], ['1', 'x', ''], ['', 'y, "q"', '3']]


def test_to_csv_fields_select_and_order(db, tmp_path):
    table = db.table('csv')
    table.insert({'a': 1, 'b': 2})

    path = tmp_path / 'out.csv'
    table.to_csv(path, fields=['b', 'missing', 'a'])

    assert path.read_text(encoding='utf-8').splitlines() == ['b,missing,a', '2,,1']


def test_to_csv_empty_table(db, tmp_path):
    path = tmp_path / 'out.csv'
    db.table('empty').to_csv(path, fields=['a'])

    assert path.read_text(encoding='utf-8').splitlines() == ['a']
