@@ -0,0 +1,48 @@
+"""JMESPath functions for the dashboards."""
+from decimal import Decimal, ROUND_HALF_UP
+
+from jmespath import parser
+from jmespath.functions import Functions, signature
+from jmespath.visitor import Options
+
+
+class DashboardFunctions(Functions):
+
+    @signature({'types': ['number']}, {'types': ['number']})
+    def _func_round_to(self, number, digits):
+        # ``digits`` must be a whole number (JSON has one number type, so
+        # 2.0 is accepted); anything else yields null.
+        if digits != int(digits):
+            return None
+        return round(number, int(digits))
+
+    @signature({'types': ['number']}, {'types': ['number']},
+               {'types': ['number']})
+    def _func_clamp(self, value, lo, hi):
+        # An inverted range (lo > hi) has no sensible answer; yield null.
+        if lo > hi:
+            return None
+        return max(lo, min(value, hi))
+
+    @signature({'types': ['number']}, {'types': ['number']},
+               {'types': ['number']})
+    def _func_percent(self, part, whole, digits):
+        # Null for a zero ``whole`` or non-integer ``digits``.
+        if whole == 0 or digits != int(digits):
+            return None
+        # Finance compares against Excel, which rounds half away from zero,
+        # so don't use round() here (round_to keeps half-to-even on purpose).
+        # Work in Decimal from the printed values to avoid float artifacts.
+        ratio = Decimal(str(part)) / Decimal(str(whole)) * 100
+        exp = Decimal(1).scaleb(-int(digits))
+        return float(ratio.quantize(exp, rounding=ROUND_HALF_UP))
+
+
+def search(expression, data, options=None):
+    """Like ``jmespath.search`` but with the dashboard functions enabled."""
+    if options is None:
+        options = Options(custom_functions=DashboardFunctions())
+    elif options.custom_functions is None:
+        options = Options(dict_cls=options.dict_cls,
+                          custom_functions=DashboardFunctions())
+    return parser.Parser().parse(expression).search(data, options=options)
diff --git a/tests/test_dashboard.py b/tests/test_dashboard.py
