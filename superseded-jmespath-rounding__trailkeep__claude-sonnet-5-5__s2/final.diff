@@ -0,0 +1,62 @@
+from tests import unittest
+
+from jmespath import dashboard, exceptions
+
+
+class TestDashboardFunctions(unittest.TestCase):
+    def test_round_to(self):
+        self.assertEqual(dashboard.search('round_to(a, `2`)', {'a': 3.14159}), 3.14)
+
+    def test_round_to_negative_digits(self):
+        self.assertEqual(dashboard.search('round_to(a, `-1`)', {'a': 14}), 10)
+
+    def test_non_integer_digits_is_null(self):
+        self.assertIsNone(dashboard.search('round_to(a, `1.5`)', {'a': 1}))
+
+    def test_type_error(self):
+        with self.assertRaises(exceptions.JMESPathTypeError):
+            dashboard.search('round_to(a, `1`)', {'a': 'x'})
+
+    def test_builtins_still_available(self):
+        self.assertEqual(dashboard.search('max(a)', {'a': [1, 2]}), 2)
+
+    def test_round_to_is_half_to_even(self):
+        # Dashboards are checked against pandas reports, which round
+        # half-to-even like Python's round().
+        for value, expected in [(0.5, 0), (1.5, 2), (2.5, 2), (3.5, 4), (-2.5, -2)]:
+            self.assertEqual(
+                dashboard.search('round_to(a, `0`)', {'a': value}), expected)
+        self.assertEqual(dashboard.search('round_to(a, `1`)', {'a': 0.25}), 0.2)
+
+    def test_clamp(self):
+        for value, expected in [(5, 5), (-3, 0), (15, 10), (0, 0), (10, 10)]:
+            self.assertEqual(
+                dashboard.search('clamp(a, `0`, `10`)', {'a': value}), expected)
+
+    def test_clamp_inverted_range_is_null(self):
+        self.assertIsNone(dashboard.search('clamp(a, `10`, `0`)', {'a': 5}))
+
+    def test_percent(self):
+        self.assertEqual(
+            dashboard.search('percent(a, b, `1`)', {'a': 1, 'b': 3}), 33.3)
+
+    def test_percent_rounds_half_away_from_zero(self):
+        # Finance compares against Excel: half away from zero, unlike round_to.
+        for part, whole, expected in [(1, 8, 13.0), (-1, 8, -13.0),
+                                      (5, 8, 63.0), (1, 16, 6.0),
+                                      (0.5, 100, 1.0), (-0.5, 100, -1.0)]:
+            self.assertEqual(
+                dashboard.search('percent(a, b, `0`)', {'a': part, 'b': whole}),
+                expected)
+        self.assertEqual(
+            dashboard.search('percent(a, b, `1`)', {'a': 1, 'b': 16}), 6.3)
+
+    def test_percent_zero_whole_is_null(self):
+        self.assertIsNone(dashboard.search('percent(a, `0`, `1`)', {'a': 1}))
+
+    def test_percent_non_integer_digits_is_null(self):
+        self.assertIsNone(dashboard.search('percent(a, `2`, `1.5`)', {'a': 1}))
+
+    def test_clamp_type_error(self):
+        with self.assertRaises(exceptions.JMESPathTypeError):
+            dashboard.search('clamp(a, `0`, `10`)', {'a': 'x'})
