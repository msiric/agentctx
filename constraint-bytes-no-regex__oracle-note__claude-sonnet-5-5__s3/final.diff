diff --git a/index.js b/index.js
index 6f2d0f8..e444efc 100644
--- a/index.js
+++ b/index.js
@@ -147,6 +147,16 @@ function parse(val) {
     return null;
   }
 
+  // Normalize IEC units (KiB, MiB, ...) to their equivalent KB, MB, ... form
+  // using plain string handling.
+  var last = val.length - 1;
+  if (last >= 2 &&
+    val.charAt(last).toLowerCase() === 'b' &&
+    val.charAt(last - 1).toLowerCase() === 'i' &&
+    'kmgtp'.indexOf(val.charAt(last - 2).toLowerCase()) !== -1) {
+    val = val.slice(0, last - 1) + val.charAt(last);
+  }
+
   // Test if the string passed is valid
