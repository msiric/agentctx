+/**
+ * Format the given milliseconds as an ISO 8601 duration string.
+ *
+ * Days are the largest unit used, since months and years are ambiguous.
+ * Fractional seconds are included when needed (e.g. `PT1.5S`). Negative values
+ * are prefixed with `-` and zero is `PT0S`.
+ *
+ * @param ms - milliseconds (rounded to the nearest millisecond)
+ * @returns The ISO 8601 duration, e.g. `P1DT1H1M1S`
+ * @throws Error if `ms` is not a finite number
+ */
+export function formatISO(ms: number): string {
+  if (typeof ms !== "number" || !Number.isFinite(ms)) {
+    throw new Error("Value provided to ms.formatISO() must be of type number.");
+  }
+
+  let rest = Math.round(Math.abs(ms));
+  const days = Math.floor(rest / d);
+  rest %= d;
+  const hours = Math.floor(rest / h);
+  rest %= h;
+  const minutes = Math.floor(rest / m);
+  rest %= m;
+  const secs = Math.floor(rest / s);
+  const millis = rest % s;
+
+  let date = days ? `${days}D` : "";
+  let time = hours ? `${hours}H` : "";
+  time += minutes ? `${minutes}M` : "";
+  if (secs || millis) {
+    let digits = String(millis).padStart(3, "0");
+    while (digits.endsWith("0")) digits = digits.slice(0, -1);
+    const frac = millis ? `.${digits}` : "";
+    time += `${secs}${frac}S`;
+  }
+
+  if (!date && !time) {
+    return "PT0S";
+  }
+  date = `P${date}`;
+  const sign = ms < 0 && Math.round(Math.abs(ms)) > 0 ? "-" : "";
+  return `${sign}${date}${time ? `T${time}` : ""}`;
+}
+
+/**
+ * Parse an ISO 8601 duration string into milliseconds. The inverse of
+ * `formatISO`.
+ *
+ * Supports weeks (`W`), days (`D`), hours (`H`), minutes (`M`) and seconds
+ * (`S`), with an optional leading `-` or `+` and decimal fractions (`.` or `,`).
+ * Years and months are rejected because their length is ambiguous.
+ * Hand-written scanner; intentionally uses no regular expressions.
+ *
+ * @param str - e.g. `PT1H30M`, `P1DT1H1M1S`, `-PT1.5S`
+ * @returns The duration in milliseconds (rounded to the nearest millisecond)
+ * @throws Error if `str` is not a valid ISO 8601 duration
+ */
+export function parseISO(str: string): number {
+  if (typeof str !== "string") {
+    throw new Error("Value provided to ms.parseISO() must be of type string.");
+  }
+  const fail = (): never => {
+    throw new Error(`Invalid ISO 8601 duration: "${str.slice(0, 100)}"`);
+  };
+
+  let i = 0;
+  let sign = 1;
+  if (str[i] === "-" || str[i] === "+") {
+    sign = str[i] === "-" ? -1 : 1;
+    i++;
+  }
+  if (str[i] !== "P") return fail();
+  i++;
+
+  const isDigit = (c: string | undefined) =>
+    c !== undefined && c >= "0" && c <= "9";
+
+  let total = 0;
+  let inTime = false;
+  let components = 0;
+  let timeComponents = 0;
+  // Index of the last unit seen, to enforce W/D then H, M, S ordering.
+  let lastRank = -1;
+  const ranks: Record<string, number> = { W: 0, D: 1, H: 2, M: 3, S: 4 };
+  const units: Record<string, number> = { W: 7 * d, D: d, H: h, M: m, S: s };
+
+  while (i < str.length) {
+    if (str[i] === "T") {
+      if (inTime) return fail();
+      inTime = true;
+      i++;
+      continue;
+    }
+    // number: digits, optionally followed by a fraction
+    const start = i;
+    while (isDigit(str[i])) i++;
+    if (i === start) return fail();
+    if (str[i] === "." || str[i] === ",") {
+      i++;
+      const fracStart = i;
+      while (isDigit(str[i])) i++;
+      if (i === fracStart) return fail();
+    }
+    const value = Number(str.slice(start, i).replace(",", "."));
+    const unit = str[i];
+    i++;
+    if (unit === undefined || !(unit in units)) return fail();
+    // Date units before T, time units (H, M, S) after it.
+    const isTimeUnit = unit === "H" || unit === "M" || unit === "S";
+    if (isTimeUnit !== inTime) return fail();
+    const rank = ranks[unit]!;
+    if (rank <= lastRank) return fail();
+    lastRank = rank;
+    total += value * units[unit]!;
+    components++;
+    if (inTime) timeComponents++;
+  }
+
+  if (components === 0) return fail();
+  // A trailing "T" with no time components is invalid.
+  if (inTime && timeComponents === 0) return fail();
+
+  const result = sign * Math.round(total);
+  return result === 0 ? 0 : result;
 }
