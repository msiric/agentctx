 ```
 
+##### significantDigits
+
+Type: `number`\
+Default: `3`
+
+The number of significant digits to round to.
+
+Only applies when neither `minimumFractionDigits` nor `maximumFractionDigits` is set. Integer digits are never dropped, so the number is never rounded below a whole value.
+
+Must be an integer between 1 and 100. Any other value is ignored and the default is used.
+
+```js
+import prettyBytes from 'pretty-bytes';
+
+prettyBytes(1337, {significantDigits: 2});
+//=> '1.3 kB'
+
+prettyBytes(1337, {significantDigits: 4});
+//=> '1.337 kB'
+```
+
 ##### locale
 
 Type: `boolean | string | string[]`\
diff --git a/test.js b/test.js
index 89bd028..b2e7e4d 100644
--- a/test.js
+++ b/test.js
@@ -1195,3 +1195,25 @@ test('unit must belong to the active unit system', t => {
 		prettyBytes(10n ** 400n, {unit: 'KiB'});
 	}, {instanceOf: TypeError, message: /Expected unit to be one of B, kB/});
 });
+
+test('significantDigits', t => {
+	t.is(prettyBytes(1337, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 3}), '1.34 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 1}), '1 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4, locale: 'de'}), '1,337 kB');
+	t.is(prettyBytes(999_999, {significantDigits: 2}), '1 MB');
+	t.is(prettyBytes(123_456, {significantDigits: 1}), '123 kB');
+	t.is(prettyBytes((10n ** 30n) + 1n, {significantDigits: 2}), prettyBytes((10n ** 30n) + 1n));
+});
+
+test('significantDigits is ignored when fraction digit options are set', t => {
+	t.is(prettyBytes(1337, {significantDigits: 2, maximumFractionDigits: 3}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4, minimumFractionDigits: 0, maximumFractionDigits: 1}), '1.3 kB');
+});
+
+test('invalid significantDigits is ignored', t => {
+	for (const significantDigits of [0, -1, 101, 2.5, Number.NaN, Number.POSITIVE_INFINITY, '2', null, {}, [], true, 2n]) {
+		t.is(prettyBytes(1337, {significantDigits}), '1.34 kB', `${String(significantDigits)}`);
+	}
+});
