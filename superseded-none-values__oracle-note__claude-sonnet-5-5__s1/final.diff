 )
 def test_obj_to_str_mapping(obj, expected_str, multiline_strings):
     assert tomli_w.dumps(obj, multiline_strings=multiline_strings) == expected_str
+
+
+def test_none_values_as_empty_string():
+    assert tomli_w.dumps({"a": None, "b": 1}) == 'a = ""\nb = 1\n'
+    assert tomli_w.dumps({"a": None}) == 'a = ""\n'
+    assert tomli_w.dumps({"t": {"a": None, "b": 1}}) == '[t]\na = ""\nb = 1\n'
+
+
+def test_none_in_arrays():
+    assert tomli_w.dumps({"a": [1, None]}) == 'a = [\n    1,\n    "",\n]\n'
+    assert tomli_w.dumps({"a": [[None]]}) == (
+        'a = [\n    [\n        "",\n    ],\n]\n'
+    )
+
+
+def test_none_in_inline_tables():
+    assert (
+        tomli_w.dumps({"l": [{"a": None, "b": 1}, {"a": None}]})
+        == 'l = [\n    { a = "", b = 1 },\n    { a = "" },\n]\n'
+    )
+    assert tomli_w.dumps({"l": [{"b": [None]}]}) == '[[l]]\nb = [\n    "",\n]\n'
+
+
+def test_none_dump():
+    import io
+
+    buf = io.BytesIO()
+    tomli_w.dump({"a": None, "b": {"c": None, "d": 2}}, buf)
+    assert buf.getvalue() == b'a = ""\n\n[b]\nc = ""\nd = 2\n'
+
+
+def test_pathlib_paths():
+    import pathlib
+
+    assert (
+        tomli_w.dumps({"p": pathlib.PurePosixPath("/a/b"), "l": [pathlib.PurePosixPath("c")]})
+        == 'p = "/a/b"\nl = [\n    "c",\n]\n'
+    )
+    assert (
+        tomli_w.dumps({"t": {"p": pathlib.PurePosixPath("x y")}}) == '[t]\np = "x y"\n'
+    )
+    assert tomli_w.dumps({"p": pathlib.Path("rel/file.txt")}) == (
+        f'p = "{pathlib.Path("rel/file.txt")}"\n'.replace("\\", "\\\\")
+    )
+    assert tomli_w.dumps({"p": pathlib.PureWindowsPath("C:/a")}) == 'p = "C:\\\\a"\n'
