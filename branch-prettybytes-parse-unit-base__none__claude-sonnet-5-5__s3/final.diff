diff --git a/index.d.ts b/index.d.ts
index 4fac6e9..998f235 100644
--- a/index.d.ts
+++ b/index.d.ts
@@ -216,3 +216,32 @@ export default function prettyBytes(
 	number: number | bigint,
 	options?: Options
 ): string;
+
+/**
+Convert a byte string to a number of bytes: `'1.5 KiB'` → `1536`, `'1.5 kB'` → `1500`. The reverse of `prettyBytes`.
+
+Accepts a plain number (`'512'`), or a number followed by a unit, optionally separated by whitespace. The number may be fractional and may have a leading `+` or `-`.
+
+Supported units are `B`, the SI units `kB` (or `KB`), `MB`, `GB`, `TB`, `PB`, `EB`, `ZB`, and `YB` (powers of 1000), and the binary units `KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`, `ZiB`, and `YiB` (powers of 1024). Units are case-sensitive.
+
+Bits, localized numbers, and exponent notation are not supported yet.
+
+@param string - The string to parse.
+@returns The number of bytes.
+@throws A `TypeError` if the input is not a string, is not in the format above, or uses an unsupported unit. A `RangeError` if the value is too large for a `number`.
+
+@example
+```
+import {parseBytes} from 'pretty-bytes';
+
+parseBytes('512');
+//=> 512
+
+parseBytes('1.5 kB');
+//=> 1500
+
+parseBytes('1.5 KiB');
+//=> 1536
+```
+*/
+export function parseBytes(string: string): number;
diff --git a/index.js b/index.js
index c5f37ab..89a3958 100644
--- a/index.js
+++ b/index.js
@@ -285,3 +285,40 @@ export default function prettyBytes(number, options) {
 	const result = prefix + numberString + separator + UNITS[exponent];
 	return result.padStart(options.fixedWidth ?? 0);
 }
+
+// The SI units (`kB`, `MB`, …) are powers of 1000, matching what `prettyBytes` writes by default, and the binary units (`KiB`, `MiB`, …) are powers of 1024. `KB` is accepted as an alias for `kB`.
+const PARSE_MULTIPLIERS = new Map([
+	...BYTE_UNITS.map((unit, exponent) => [unit, 1000 ** exponent]),
+	...BIBYTE_UNITS.map((unit, exponent) => [unit, 1024 ** exponent]),
+	['KB', 1000],
+]);
+
+// A sign, a number with an optional fraction, and an optional unit, which may be separated by whitespace (including the non-breaking space `prettyBytes` can emit). Units are case-sensitive.
+const PARSE_PATTERN = /^([+-])?(\d+(?:\.\d+)?|\.\d+)(?:\s*([^\s\d.+-]+))?$/;
+
+export function parseBytes(string) {
+	if (typeof string !== 'string') {
+		throw new TypeError(`Expected a string, got ${typeof string}: ${string}`);
+	}
+
+	const match = PARSE_PATTERN.exec(string.trim());
+
+	if (!match) {
+		throw new TypeError(`Unable to parse bytes from: ${JSON.stringify(string)}`);
+	}
+
+	const [, sign, digits, unit = 'B'] = match;
+	const multiplier = PARSE_MULTIPLIERS.get(unit);
+
+	if (multiplier === undefined) {
+		throw new TypeError(`Unsupported unit ${JSON.stringify(unit)}, expected one of: ${[...PARSE_MULTIPLIERS.keys()].join(', ')}`);
+	}
+
+	const result = Number(digits) * multiplier;
+
+	if (!Number.isFinite(result)) {
+		throw new RangeError(`The value is too large to represent: ${JSON.stringify(string)}`);
+	}
+
+	return sign === '-' && result !== 0 ? -result : result;
+}
