+
+test('parseBytes: plain numbers and bytes', t => {
+	t.is(parseBytes('0'), 0);
+	t.is(parseBytes('512'), 512);
+	t.is(parseBytes('512 B'), 512);
+	t.is(parseBytes('512B'), 512);
+	t.is(parseBytes('  512   B  '), 512);
+	t.is(parseBytes('512 B'), 512);
+	t.is(parseBytes('.5'), 0.5);
+	t.is(parseBytes('1.5 B'), 1.5);
+});
+
+test('parseBytes: binary units', t => {
+	for (const [exponent, unit] of BINARY_UNITS.entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1024 ** exponent);
+		t.is(parseBytes(`2${unit}`), 2 * (1024 ** exponent));
+	}
+
+	t.is(parseBytes('1.5 KiB'), 1536);
+	t.is(parseBytes('0.5 MiB'), 524_288);
+	t.is(parseBytes('1.25 GiB'), 1.25 * (1024 ** 3));
+});
+
+test('parseBytes: signs', t => {
+	t.is(parseBytes('-1 KiB'), -1024);
+	t.is(parseBytes('+1 KiB'), 1024);
+	t.is(parseBytes(' 0 B'), 0);
+	t.true(Object.is(parseBytes('-0 B'), 0));
+});
+
+test('parseBytes: reads what prettyBytes writes in binary mode', t => {
+	for (const value of [0, 1, 512, 1024, 1536, 1024 ** 3, 3.5 * (1024 ** 5), -2048]) {
+		t.is(parseBytes(prettyBytes(value, {binary: true})), value);
+	}
+});
+
+test('parseBytes: units are case-sensitive', t => {
+	for (const input of ['1 kib', '1 KIB', '1 kiB', '1 mib', '1 b', '1 gib', '1 KIb']) {
+		t.throws(() => parseBytes(input), {instanceOf: TypeError, message: /Unsupported unit/}, `${input}`);
+	}
+});
+
+test('parseBytes: SI units', t => {
+	for (const [exponent, unit] of DECIMAL_UNITS.entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1000 ** exponent);
+		t.is(parseBytes(`2${unit}`), 2 * (1000 ** exponent));
+	}
+
+	t.is(parseBytes('1 KB'), 1000);
+	t.is(parseBytes('1.5 kB'), 1500);
+	t.is(parseBytes('1.5 MB'), 1_500_000);
+});
+
+test('parseBytes: reads what prettyBytes writes by default', t => {
+	for (const value of [0, 1, 512, 1000, 1500, 10 ** 9, 3.5 * (10 ** 15), -2000]) {
+		t.is(parseBytes(prettyBytes(value)), value);
+	}
+});
+
+test('parseBytes: SI unit case variants and bits are not supported', t => {
+	for (const input of ['1 kb', '1 Kb', '1 mB', '1 mb', '1 gB', '1 kbit', '1 Kibit']) {
+		t.throws(() => parseBytes(input), {instanceOf: TypeError, message: /Unsupported unit/}, `${input}`);
+	}
+});
+
+test('parseBytes: rejects malformed input', t => {
+	for (const input of ['', ' ', 'KiB', 'abc', '1,5 KiB', '1.', '1e3', '1e3 KiB', '--1', '1 2 KiB', '1 KiB KiB', '1_000', '0x10', 'Infinity', 'NaN', '1 +KiB']) {
+		t.throws(() => parseBytes(input), {instanceOf: TypeError}, `${JSON.stringify(input)}`);
+	}
+
+	for (const input of [1, null, undefined, {}, [], 10n]) {
+		t.throws(() => parseBytes(input), {instanceOf: TypeError, message: /Expected a string/});
+	}
+});
+
+test('parseBytes: rejects values too large for a number', t => {
+	t.throws(() => parseBytes('9'.repeat(400)), {instanceOf: RangeError});
+	t.throws(() => parseBytes(`1${'0'.repeat(305)} YiB`), {instanceOf: RangeError});
+});
