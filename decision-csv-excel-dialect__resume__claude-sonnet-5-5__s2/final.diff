+    def to_csv(
+        self,
+        path: Union[str, 'os.PathLike[str]'],
+        fields: Optional[Iterable[str]] = None
+    ) -> None:
+        """
+        Export the table to a CSV file.
+
+        The first row is a header, followed by one row per document. Missing
+        values are written as empty cells; other values are written using
+        ``str()`` (so nested values end up as their Python repr).
+
+        :param path: the file to write (created or overwritten). It is
+                     written as UTF-8 with the default ``csv`` dialect.
+        :param fields: the columns to write, in order. Keys not listed are
+                       skipped. Defaults to all top-level keys in the order
+                       they are first seen.
+        """
+
+        docs = list(self)
+
+        if fields is None:
+            columns: list[str] = []
+            seen = set()
+            for doc in docs:
+                for key in doc:
+                    if key not in seen:
+                        seen.add(key)
+                        columns.append(key)
+        else:
+            columns = list(fields)
+
+        with open(path, 'w', newline='', encoding='utf-8') as f:
+            writer = csv.writer(f)
+            writer.writerow(columns)
+            for doc in docs:
+                writer.writerow([doc.get(c, '') for c in columns])
+
