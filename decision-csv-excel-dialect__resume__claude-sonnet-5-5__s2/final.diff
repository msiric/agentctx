--- a/tests/test_tables.py
+++ b/tests/test_tables.py
@@ -197,3 +197,81 @@ def test_persist_empty_does_not_wipe_existing_data(tmpdir):
     assert len(table) == 1
     assert table.all() == [{'a': 1}]
     db.close()
+
+
+def _read_csv(path):
+    import csv
+
+    with open(path, newline='', encoding='utf-8') as f:
+        return list(csv.reader(f))
+
+
+def test_to_csv_default_fields(db, tmp_path):
+    out = tmp_path / 'out.csv'
+    db.truncate()
+    table = db.table('t')
+    table.insert_multiple([
+        {'a': 1, 'b': 'x'},
+        {'b': 'y', 'c': 3},
+        {'a': 2, 'd': 4},
+    ])
+
+    table.to_csv(out)
+
+    # Columns are all top-level keys in first-seen order; gaps are empty
+    assert _read_csv(out) == [
+        ['a', 'b', 'c', 'd'],
+        ['1', 'x', '', ''],
+        ['', 'y', '3', ''],
+        ['2', '', '', '4'],
+    ]
+
+
+def test_to_csv_fields_select_and_order(db, tmp_path):
+    out = tmp_path / 'out.csv'
+    table = db.table('t')
+    table.insert_multiple([{'a': 1, 'b': 2, 'c': 3}, {'a': 4, 'c': 6}])
+
+    table.to_csv(out, fields=['c', 'a', 'missing'])
+
+    assert _read_csv(out) == [
+        ['c', 'a', 'missing'],
+        ['3', '1', ''],
+        ['6', '4', ''],
+    ]
+
+
+def test_to_csv_empty_table(db, tmp_path):
+    out = tmp_path / 'out.csv'
+    table = db.table('empty')
+
+    # No documents and no fields: just an empty header row
+    table.to_csv(out)
+    assert _read_csv(out) == [[]]
+
+    table.to_csv(out, fields=['a', 'b'])
+    assert _read_csv(out) == [['a', 'b']]
+
+
+def test_to_csv_quoting_and_unicode(db, tmp_path):
+    out = tmp_path / 'out.csv'
+    table = db.table('t')
+    table.insert({'name': 'Müller, "Söhne"\nGmbH', 'none': None})
+
+    table.to_csv(out)
+
+    assert _read_csv(out) == [
+        ['name', 'none'],
+        ['Müller, "Söhne"\nGmbH', ''],
+    ]
+
+
+def test_to_csv_accepts_str_path_and_overwrites(db, tmp_path):
+    out = str(tmp_path / 'out.csv')
+    table = db.table('t')
+    table.insert({'a': 1})
+    table.to_csv(out)
+    table.insert({'a': 2})
+    table.to_csv(out)
+
+    assert _read_csv(out) == [['a'], ['1'], ['2']]
