                 click.echo(f"{prefix}{k}={v}")
 
 
+@cli.command()
+@click.pass_context
+@click.option(
+    "--example",
+    type=click.Path(file_okay=True),
+    default=None,
+    help="Location of the example file, defaults to .env.example next to the .env file.",
+)
+def check(ctx: click.Context, example: Any) -> None:
+    """
+    List keys defined in the example file but missing from the .env file.
+
+    Exits with code 1 if any key is missing. A key without a value (`FOO`)
+    counts as present.
+    """
+    file = ctx.obj["FILE"]
+    if file is None:
+        print("Error: no .env file location available.", file=sys.stderr)
+        sys.exit(2)
+    if example is None:
+        example = os.path.join(os.path.dirname(file), ".env.example")
+    else:
+        example = os.path.expanduser(example)
+
+    with stream_file(file) as stream:
+        actual = dotenv_values(stream=stream, interpolate=False)
+    with stream_file(example) as stream:
+        expected = dotenv_values(stream=stream, interpolate=False)
+
+    missing = [k for k in expected if k not in actual]
+    for k in missing:
+        click.echo(k)
+    if missing:
+        sys.exit(1)
+
+
+@cli.command()
+@click.argument("a", type=click.Path(file_okay=True))
+@click.argument("b", type=click.Path(file_okay=True))
+def diff(a: str, b: str) -> None:
+    """
+    Show how two env files differ, by key name only (values are never printed).
+
+    Prints keys only in A (`< KEY`), keys only in B (`> KEY`) and keys whose
+    values differ (`~ KEY`). Exits with code 1 if the files differ, 0 otherwise.
+    """
+    with stream_file(os.path.expanduser(a)) as stream:
+        values_a = dotenv_values(stream=stream, interpolate=False)
+    with stream_file(os.path.expanduser(b)) as stream:
+        values_b = dotenv_values(stream=stream, interpolate=False)
+
+    only_a = sorted(k for k in values_a if k not in values_b)
+    only_b = sorted(k for k in values_b if k not in values_a)
+    changed = sorted(k for k in values_a if k in values_b and values_a[k] != values_b[k])
+
+    for k in only_a:
+        click.echo(f"< {k}")
+    for k in only_b:
+        click.echo(f"> {k}")
+    for k in changed:
+        click.echo(f"~ {k}")
+    if only_a or only_b or changed:
+        sys.exit(1)
+
+
 @cli.command(name="set")
 @click.pass_context
 @click.argument("key", required=True)
