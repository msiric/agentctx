+
+
+def test_check_all_present(cli, dotenv_path):
+    dotenv_path.write_text("A=1\nB=2\nC=3\n")
+    example = dotenv_path.parent / ".env.example"
+    example.write_text("A=\nB=x\n")
+
+    result = cli.invoke(dotenv_cli, ["--file", dotenv_path, "check"])
+
+    assert (result.exit_code, result.output) == (0, "")
+
+
+def test_check_lists_missing_keys(cli, dotenv_path):
+    dotenv_path.write_text("A=1\n")
+    (dotenv_path.parent / ".env.example").write_text("A=\nB=\n# C=\nD\n")
+
+    result = cli.invoke(dotenv_cli, ["--file", dotenv_path, "check"])
+
+    assert (result.exit_code, result.output) == (1, "B\nD\n")
+
+
+def test_check_bare_key_counts_as_present(cli, dotenv_path):
+    dotenv_path.write_text("A\n")
+    (dotenv_path.parent / ".env.example").write_text("A=1\n")
+
+    result = cli.invoke(dotenv_cli, ["--file", dotenv_path, "check"])
+
+    assert (result.exit_code, result.output) == (0, "")
+
+
+def test_check_custom_example(cli, dotenv_path):
+    dotenv_path.write_text("A=1\n")
+    other = dotenv_path.parent / "other.example"
+    other.write_text("A=\nB=${A}\n")
+
+    result = cli.invoke(
+        dotenv_cli, ["--file", dotenv_path, "check", "--example", str(other)]
+    )
+
+    assert (result.exit_code, result.output) == (1, "B\n")
+
+
+def test_check_missing_example_file(cli, dotenv_path):
+    dotenv_path.write_text("A=1\n")
+
+    result = cli.invoke(dotenv_cli, ["--file", dotenv_path, "check"])
+
+    assert result.exit_code == 2, result.output
+    assert "Error opening env file" in result.output
+
+
+def test_check_missing_env_file(cli, tmp_path):
+    (tmp_path / ".env.example").write_text("A=\n")
+
+    result = cli.invoke(dotenv_cli, ["--file", str(tmp_path / "nx.env"), "check"])
+
+    assert result.exit_code == 2, result.output
+
+
+def test_check_never_prints_values(cli, dotenv_path):
+    dotenv_path.write_text("A=secret-env-value\nbad line secret-bad\n")
+    (dotenv_path.parent / ".env.example").write_text(
+        "A=secret-example-value\nB=secret-example-b\n"
+    )
+
+    result = cli.invoke(dotenv_cli, ["--file", dotenv_path, "check"])
+
+    assert result.exit_code == 1
+    assert result.output == "B\n"
+    assert "secret" not in result.output
+
+
+def test_diff_same(cli, tmp_path):
+    a, b = tmp_path / "a", tmp_path / "b"
+    a.write_text("A=1\nB=2\n")
+    b.write_text("B=2\nA=1\n")
+
+    result = cli.invoke(dotenv_cli, ["diff", str(a), str(b)])
+
+    assert (result.exit_code, result.output) == (0, "")
+
+
+def test_diff_reports_keys_only(cli, tmp_path):
+    a, b = tmp_path / "a", tmp_path / "b"
+    a.write_text("ONLY_A=secret1\nSAME=1\nDIFF=secret2\n")
+    b.write_text("ONLY_B=secret3\nSAME=1\nDIFF=secret4\n")
+
+    result = cli.invoke(dotenv_cli, ["diff", str(a), str(b)])
+
+    assert (result.exit_code, result.output) == (1, "< ONLY_A\n> ONLY_B\n~ DIFF\n")
+    assert "secret" not in result.output
+
+
+def test_diff_missing_file(cli, tmp_path):
+    a = tmp_path / "a"
+    a.write_text("A=1\n")
+
+    result = cli.invoke(dotenv_cli, ["diff", str(a), str(tmp_path / "nope")])
+
+    assert result.exit_code == 2
