+import unittest
+
+from jmespath import exceptions
+from jmespath.dashboard import search
+
+
+class TestRoundTo(unittest.TestCase):
+    def test_rounds_half_to_even(self):
+        # Matches Python's round() and pandas, not round-half-up.
+        cases = [
+            (0.5, 0, 0), (1.5, 0, 2), (2.5, 0, 2), (3.5, 0, 4),
+            (-0.5, 0, 0), (-1.5, 0, -2), (-2.5, 0, -2),
+            (0.125, 2, 0.12), (0.375, 2, 0.38),
+            (25, -1, 20), (35, -1, 40),
+        ]
+        for number, digits, expected in cases:
+            result = search('round_to(n, `%s`)' % digits, {'n': number})
+            self.assertEqual(result, expected, (number, digits))
+
+    def test_literal_arguments(self):
+        self.assertEqual(search('round_to(`2.5`, `0`)', {}), 2)
+
+    def test_regular_rounding(self):
+        self.assertEqual(search('round_to(n, `2`)', {'n': 3.14159}), 3.14)
+
+    def test_digits_must_be_integer(self):
+        with self.assertRaises(exceptions.JMESPathTypeError):
+            search('round_to(`1`, `1.5`)', {})
+
+    def test_builtin_functions_still_available(self):
+        self.assertEqual(search('abs(n)', {'n': -1}), 1)
+
+
+class TestClamp(unittest.TestCase):
+    def test_clamps_to_range(self):
+        cases = [(5, 5), (-3, 0), (15, 10), (0, 0), (10, 10), (2.5, 2.5)]
+        for value, expected in cases:
+            result = search('clamp(n, `0`, `10`)', {'n': value})
+            self.assertEqual(result, expected, value)
+
+    def test_lo_greater_than_hi(self):
+        with self.assertRaises(exceptions.JMESPathError):
+            search('clamp(`1`, `10`, `0`)', {})
+
+    def test_non_number(self):
+        with self.assertRaises(exceptions.JMESPathTypeError):
+            search('clamp(`"a"`, `0`, `10`)', {})
+
+
+if __name__ == '__main__':
+    unittest.main()
+
+
+class TestPercent(unittest.TestCase):
+    def test_basic(self):
+        self.assertEqual(search('percent(`1`, `4`, `0`)', {}), 25)
+        self.assertEqual(search('percent(a, b, `1`)', {'a': 1, 'b': 3}), 33.3)
+
+    def test_rounds_half_away_from_zero(self):
+        cases = [(1, 8, 0, 13), (-1, 8, 0, -13), (1, 16, 1, 6.3),
+                 (-1, 16, 1, -6.3), (1.005, 100, 1, 1.0),
+                 (2.5, 100, 0, 3), (1, 8, 1, 12.5)]
+        for part, whole, digits, expected in cases:
+            result = search('percent(`%s`, `%s`, `%s`)' % (part, whole, digits), {})
+            self.assertEqual(result, expected, (part, whole, digits))
+
+    def test_zero_whole(self):
+        with self.assertRaises(exceptions.JMESPathError):
+            search('percent(`1`, `0`, `1`)', {})
+
+    def test_digits_must_be_integer(self):
+        with self.assertRaises(exceptions.JMESPathTypeError):
+            search('percent(`1`, `2`, `1.5`)', {})
