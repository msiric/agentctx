+"""Custom JMESPath functions for the dashboards."""
+from decimal import Decimal, ROUND_HALF_UP
+
+from jmespath import exceptions
+from jmespath import parser
+from jmespath.functions import Functions, signature
+from jmespath.visitor import Options
+
+
+class DashboardFunctions(Functions):
+
+    @signature({'types': ['number']}, {'types': ['number']})
+    def _func_round_to(self, number, digits):
+        if digits != int(digits):
+            raise exceptions.JMESPathTypeError(
+                'round_to', digits, 'non-integer number', ['integer'])
+        return round(number, int(digits))
+
+    @signature({'types': ['number']}, {'types': ['number']},
+               {'types': ['number']})
+    def _func_clamp(self, value, lo, hi):
+        if lo > hi:
+            raise exceptions.JMESPathError(
+                'clamp: lo (%s) must not be greater than hi (%s)' % (lo, hi))
+        return max(lo, min(value, hi))
+
+    @signature({'types': ['number']}, {'types': ['number']},
+               {'types': ['number']})
+    def _func_percent(self, part, whole, digits):
+        if digits != int(digits):
+            raise exceptions.JMESPathTypeError(
+                'percent', digits, 'non-integer number', ['integer'])
+        if whole == 0:
+            raise exceptions.JMESPathError('percent: whole must not be zero')
+        # Excel-style ROUND: halves go away from zero. Work in Decimal built
+        # from the repr so 1.005 is treated as 1.005, as Excel does.
+        value = Decimal(repr(part)) / Decimal(repr(whole)) * 100
+        quantum = Decimal(1).scaleb(-int(digits))
+        return float(value.quantize(quantum, rounding=ROUND_HALF_UP))
+
+
+def search(expression, data):
+    """Evaluate a JMESPath expression with the dashboard functions."""
+    options = Options(custom_functions=DashboardFunctions())
+    return parser.Parser().parse(expression).search(data, options=options)
