diff --git a/test_schedule.py b/test_schedule.py
index f497826..6317d80 100644
--- a/test_schedule.py
+++ b/test_schedule.py
@@ -1569,6 +1569,78 @@ class SchedulerTests(TestCase):
         schedule.clear()
         assert len(schedule.jobs) == 0
 
+    def test_get_jobs_for(self):
+        def other():
+            pass
+
+        scheduler = schedule.Scheduler()
+        with mock_datetime(2010, 1, 6, 12, 15):
+            j1 = scheduler.every().second.do(make_mock_job(name="a"))
+            f = make_mock_job(name="f")
+            j2 = scheduler.every().minute.do(f, 1)
+            j3 = scheduler.every().hour.do(f, 2)
+            j4 = scheduler.every().day.do(other)
+            assert scheduler.get_jobs_for(f) == [j2, j3]
+            assert scheduler.get_jobs_for(other) == [j4]
+            assert j1 not in scheduler.get_jobs_for(f)
+            assert scheduler.get_jobs_for(lambda: None) == []
+            scheduler.cancel_job(j2)
+            assert scheduler.get_jobs_for(f) == [j3]
+
+    def test_pause_skips_tagged_jobs_in_run_pending(self):
+        scheduler = schedule.Scheduler()
+        tagged, other = make_mock_job("tagged"), make_mock_job("other")
+        with mock_datetime(2010, 1, 6, 12, 15):
+            scheduler.every().minute.do(tagged).tag("maint")
+            scheduler.every().minute.do(other).tag("keep")
+            scheduler.pause("maint")
+        with mock_datetime(2010, 1, 6, 12, 16):
+            scheduler.run_pending()
+        assert tagged.call_count == 0
+        assert other.call_count == 1
+
+    def test_resume_runs_jobs_again(self):
+        scheduler = schedule.Scheduler()
+        func = make_mock_job()
+        with mock_datetime(2010, 1, 6, 12, 15):
+            job = scheduler.every().minute.do(func).tag("maint")
+            scheduler.pause("maint")
+            assert job.paused
+        with mock_datetime(2010, 1, 6, 12, 16):
+            scheduler.run_pending()
+            assert func.call_count == 0
+            scheduler.resume("maint")
+            assert not job.paused
+            scheduler.run_pending()
+            assert func.call_count == 1
+
+    def test_pause_does_not_remove_jobs(self):
+        scheduler = schedule.Scheduler()
+        with mock_datetime(2010, 1, 6, 12, 15):
+            job = scheduler.every().minute.do(make_mock_job()).tag("maint")
+            scheduler.pause("maint")
+        assert scheduler.get_jobs("maint") == [job]
+
+    def test_pause_unknown_tag_is_noop(self):
+        scheduler = schedule.Scheduler()
+        with mock_datetime(2010, 1, 6, 12, 15):
+            job = scheduler.every().minute.do(make_mock_job()).tag("a")
+            scheduler.pause("missing")
+            scheduler.resume("missing")
+        assert not job.paused
+
+    def test_module_level_pause_resume(self):
+        func = make_mock_job()
+        with mock_datetime(2010, 1, 6, 12, 15):
+            every().minute.do(func).tag("maint")
+            schedule.pause("maint")
+        with mock_datetime(2010, 1, 6, 12, 16):
+            schedule.run_pending()
+            assert func.call_count == 0
+            schedule.resume("maint")
+            schedule.run_pending()
+            assert func.call_count == 1
+
