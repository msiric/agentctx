@@ -254,22 +254,39 @@ export function withLeadingSlash(input = ""): string {
 /**
  * Removes double slashes from the URL.
  *
+ * If second argument is `true`, the query string and fragment are left untouched.
+ *
  * @example
  *
  * ```js
  * cleanDoubleSlashes("//foo//bar//"); // "/foo/bar/"
  *
+ * cleanDoubleSlashes("/foo//bar?redirect=//baz", true); // "/foo/bar?redirect=//baz"
+ *
  * cleanDoubleSlashes("http://example.com/analyze//http://localhost:3000//");
  * // Returns "http://example.com/analyze/http://localhost:3000/"
  * ```
  *
  * @group utils
  */
-export function cleanDoubleSlashes(input = ""): string {
-  return input
-    .split("://")
-    .map((string_) => string_.replace(/\/{2,}/g, "/"))
-    .join("://");
+export function cleanDoubleSlashes(
+  input = "",
+  respectQueryAndFragment?: boolean,
+): string {
+  let rest = "";
+  if (respectQueryAndFragment) {
+    const index = input.search(/[?#]/);
+    if (index !== -1) {
+      rest = input.slice(index);
+      input = input.slice(0, index);
+    }
+  }
+  return (
+    input
+      .split("://")
+      .map((string_) => string_.replace(/\/{2,}/g, "/"))
+      .join("://") + rest
+  );
 }
 
