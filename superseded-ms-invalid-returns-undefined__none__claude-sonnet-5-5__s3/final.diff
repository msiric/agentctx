+/**
+ * Parse a compound duration such as `"1h 30m"`, `"1h, 30m"` or `"2 days 4 hours"` and
+ * return the total in milliseconds. Each piece is parsed with `parse`, so every
+ * piece must have a unit and use a unit supported by `parse`.
+ *
+ * @param str - A compound duration string
+ * @returns The total in milliseconds
+ * @throws TypeError if `str` is not a valid compound duration. Never returns
+ * `NaN`.
+ */
+export function parseCompound(str: string): number {
+  if (typeof str !== "string" || str.length === 0 || str.length > 200) {
+    throw new TypeError(
+      `Value provided to ms.parseCompound() must be a string with length between 1 and 200. value=${JSON.stringify(str)}`,
+    );
+  }
+  const trimmed = str.trim();
+  const invalid = () =>
+    new TypeError(
+      `Invalid compound duration provided to ms.parseCompound(). value=${JSON.stringify(str)}`,
+    );
+  if (!/^-?\d*\.?\d+ *[a-z]+(?:\s*,?\s*-?\d*\.?\d+ *[a-z]+)*$/i.test(trimmed)) {
+    throw invalid();
+  }
+  let total = 0;
+  for (const [piece] of trimmed.matchAll(/-?\d*\.?\d+ *[a-z]+/gi)) {
+    const n = parse(piece);
+    if (Number.isNaN(n)) {
+      throw invalid();
+    }
+    total += n;
+  }
+  return total;
+}
+
+/**
+ * Parse a timer-style clock string and return the total in milliseconds.
+ * `"m:ss"` (e.g. `"1:30"`) and `"h:mm:ss"` (e.g. `"01:02:03"`) are supported.
+ * Seconds may have a fractional part (e.g. `"1:30.5"`). Seconds, and minutes
+ * in the `h:mm:ss` form, must be below 60.
+ *
+ * @param str - A clock string
+ * @returns The total in milliseconds
+ * @throws TypeError if `str` is not a valid clock string. Never returns `NaN`.
+ */
+export function parseClock(str: string): number {
+  if (typeof str !== "string" || str.length === 0 || str.length > 100) {
+    throw new TypeError(
+      `Value provided to ms.parseClock() must be a string with length between 1 and 100. value=${JSON.stringify(str)}`,
+    );
+  }
+  const match =
+    /^(?:(?<h>\d+):(?<m3>\d{2})|(?<m2>\d+)):(?<s>\d{2}(?:\.\d+)?)$/.exec(
+      str.trim(),
+    );
+  const { h, m3, m2, s: secs } = match?.groups ?? {};
+  const minutes = Number(m3 ?? m2);
+  const seconds = Number(secs);
+  if (!match || seconds >= 60 || (h !== undefined && minutes >= 60)) {
+    throw new TypeError(
+      `Invalid clock duration provided to ms.parseClock(). value=${JSON.stringify(str)}`,
+    );
+  }
+  return (Number(h ?? 0) * 60 + minutes) * m + seconds * s;
+}
