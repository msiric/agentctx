new file mode 100644
index 0000000..93e5b93
--- /dev/null
+++ b/src/parse-clock.test.ts
@@ -0,0 +1,58 @@
+import { describe, expect, it } from "@jest/globals";
+import { parseClock } from "./index";
+
+describe("parseClock(string)", () => {
+  it("should parse m:ss", () => {
+    expect(parseClock("1:30")).toBe(90000);
+    expect(parseClock("0:05")).toBe(5000);
+    expect(parseClock("00:00")).toBe(0);
+  });
+
+  it("should allow more than 59 minutes in m:ss", () => {
+    expect(parseClock("90:00")).toBe(90 * 60000);
+  });
+
+  it("should parse h:mm:ss", () => {
+    expect(parseClock("01:02:03")).toBe(3600000 + 2 * 60000 + 3000);
+    expect(parseClock("1:00:00")).toBe(3600000);
+    expect(parseClock("100:00:00")).toBe(100 * 3600000);
+  });
+
+  it("should parse fractional seconds", () => {
+    expect(parseClock("1:30.5")).toBe(90500);
+    expect(parseClock("0:00:01.25")).toBe(1250);
+  });
+
+  it("should ignore surrounding whitespace", () => {
+    expect(parseClock(" 1:30 ")).toBe(90000);
+  });
+
+  it("should throw a TypeError including the input for invalid strings", () => {
+    for (const bad of [
+      "",
+      "   ",
+      "90",
+      "1:3",
+      "1:60",
+      "1:2:03",
+      "1:60:00",
+      "1:00:60",
+      "1:2:3:4",
+      ":30",
+      "1:",
+      "-1:30",
+      "a:bc",
+      "1h",
+      "1: 30",
+    ]) {
+      expect(() => parseClock(bad)).toThrow(TypeError);
+      expect(() => parseClock(bad)).toThrow(JSON.stringify(bad));
+    }
+  });
+
+  it("should throw a TypeError for non-strings and too-long strings", () => {
+    // @ts-expect-error testing runtime behavior
+    expect(() => parseClock(5)).toThrow(TypeError);
+    expect(() => parseClock("1".repeat(101))).toThrow(TypeError);
+  });
+});
diff --git a/src/parse-compound.test.ts b/src/parse-compound.test.ts
new file mode 100644
index 0000000..893b011
--- /dev/null
+++ b/src/parse-compound.test.ts
@@ -0,0 +1,59 @@
+import { describe, expect, it } from '@jest/globals';
+import { parse, parseCompound } from './index';
+
+describe('parseCompound(string)', () => {
+  it('should sum short units', () => {
+    expect(parseCompound('1h 30m')).toBe(5400000);
+  });
+
+  it('should sum long units with spaces', () => {
+    expect(parseCompound('2 days 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
+  });
+
+  it('should allow pieces without separators', () => {
+    expect(parseCompound('1h30m')).toBe(parse('1h') + parse('30m'));
+  });
+
+  it('should allow commas between parts', () => {
+    expect(parseCompound('1h, 30m')).toBe(5400000);
+    expect(parseCompound('1h,30m')).toBe(5400000);
+    expect(parseCompound('2 days , 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
+  });
+
+  it('should handle a single piece', () => {
+    expect(parseCompound('5s')).toBe(5000);
+  });
+
+  it('should handle decimals, negatives and mixed case', () => {
+    expect(parseCompound('1.5h 30M')).toBe(7200000);
+    expect(parseCompound('1h -30m')).toBe(1800000);
+  });
+
+  it('should ignore surrounding whitespace', () => {
+    expect(parseCompound('  1m 30s ')).toBe(90000);
+  });
+
+  it('should throw a TypeError including the input for invalid strings', () => {
+    for (const bad of [
+      '',
+      'abc',
+      '1h foo',
+      '1h 30',
+      '1h 30xyz',
+      '   ',
+      '1h,',
+      ',1h',
+      '1h,,30m',
+      '1h, 30',
+    ]) {
+      expect(() => parseCompound(bad)).toThrow(TypeError);
+      expect(() => parseCompound(bad)).toThrow(JSON.stringify(bad));
+    }
+  });
+
+  it('should throw a TypeError for non-strings and too-long strings', () => {
+    expect(() => parseCompound('1h '.repeat(100))).toThrow(TypeError);
+    // @ts-expect-error testing runtime behavior
+    expect(() => parseCompound(5)).toThrow(TypeError);
+  });
+});
