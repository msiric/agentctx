   const parsed = parseURL(input);
   return (parsed.pathname || "/") + parsed.search + parsed.hash;
 }
+
+/**
+ * Checks if two absolute URLs share the same origin (protocol + host + port).
+ *
+ * Default ports are normalized (`https://a.com` equals `https://a.com:443`),
+ * other ports are compared strictly. Relative, protocol-relative, invalid and
+ * opaque-origin (`data:`, `javascript:`, `mailto:`...) inputs are never same-origin.
+ *
+ * @example
+ * ```js
+ * isSameOrigin("https://example.com/a", "https://example.com:443/b"); // true
+ * isSameOrigin("https://example.com", "http://example.com"); // false
+ * ```
+ *
+ * @group utils
+ */
+export function isSameOrigin(a: string, b: string): boolean {
+  const originA = _getOrigin(a);
+  return !!originA && originA === _getOrigin(b);
+}
+
+function _getOrigin(input: string): string | undefined {
+  if (typeof input !== "string" || !input) {
+    return undefined;
+  }
+  try {
+    const { origin } = new URL(input);
+    return origin && origin !== "null" ? origin : undefined;
+  } catch {
+    return undefined;
+  }
+}
