diff --git a/test/same-origin.test.ts b/test/same-origin.test.ts
new file mode 100644
index 0000000..4149cfe
--- /dev/null
+++ b/test/same-origin.test.ts
@@ -0,0 +1,130 @@
+import { describe, expect, test } from "vitest";
+import { isSameOrigin } from "../src";
+
+// Origin = protocol + host + port, compared strictly: ports are NOT
+// normalized, so `https://x.com` and `https://x.com:443` differ.
+// Cases marked "PROPOSED" are open to discussion.
+
+describe("isSameOrigin", () => {
+  describe("same origin", () => {
+    const cases: [string, string][] = [
+      ["https://example.com", "https://example.com"],
+      // path, query and hash are ignored
+      ["https://example.com/a", "https://example.com/b"],
+      ["https://example.com/a?x=1", "https://example.com/b?y=2"],
+      ["https://example.com/#a", "https://example.com/#b"],
+      // trailing slash
+      ["https://example.com", "https://example.com/"],
+      // protocol and host are case-insensitive
+      ["HTTPS://EXAMPLE.COM", "https://example.com"],
+      ["https://Example.com/Path", "https://example.COM/path"],
+      // identical explicit ports (compared literally)
+      ["http://localhost:3000/a", "http://localhost:3000/b"],
+      ["https://example.com:443/a", "https://example.com:443/b"],
+      // PROPOSED: credentials are not part of the origin
+      ["https://user:pass@example.com", "https://example.com"],
+      ["https://a:b@example.com", "https://c:d@example.com"],
+      // IPv4 / IPv6
+      ["http://127.0.0.1:8080/a", "http://127.0.0.1:8080/b"],
+      ["http://[::1]:8080/a", "http://[::1]:8080/b"],
+    ];
+    for (const [a, b] of cases) {
+      test(`${a} === ${b}`, () => {
+        expect(isSameOrigin(a, b)).toBe(true);
+        // symmetric
+        expect(isSameOrigin(b, a)).toBe(true);
+      });
+    }
+  });
+
+  describe("different origin", () => {
+    const cases: [string, string][] = [
+      // protocol
+      ["http://example.com", "https://example.com"],
+      // host
+      ["https://example.com", "https://example.org"],
+      // subdomains are different origins
+      ["https://example.com", "https://www.example.com"],
+      ["https://a.example.com", "https://b.example.com"],
+      // port
+      ["http://localhost:3000", "http://localhost:4000"],
+      ["http://localhost:3000", "http://localhost"],
+      // strict ports: no default-port normalization, an explicit port
+      // never equals an omitted one, even if it is the protocol's default
+      ["https://example.com", "https://example.com:443"],
+      ["http://example.com", "http://example.com:80"],
+      ["https://example.com/a", "https://example.com:443/b"],
+      // default port of another protocol is not default here
+      ["http://example.com:443", "http://example.com"],
+      ["https://example.com:80", "https://example.com"],
+      // userinfo trick: host is what comes after the "@"
+      ["https://example.com@evil.com", "https://example.com"],
+      ["https://example.com", "https://example.com.evil.com"],
+      // IPv6 vs IPv4
+      ["http://[::1]", "http://127.0.0.1"],
+    ];
+    for (const [a, b] of cases) {
+      test(`${a} !== ${b}`, () => {
+        expect(isSameOrigin(a, b)).toBe(false);
+        expect(isSameOrigin(b, a)).toBe(false);
+      });
+    }
+  });
+
+  describe("relative and protocol-relative inputs", () => {
+    // PROPOSED: without a base there is no origin to compare,
+    // so anything lacking protocol + host is never "same origin".
+    test("relative paths are never same-origin", () => {
+      expect(isSameOrigin("/a", "/a")).toBe(false);
+      expect(isSameOrigin("a/b", "a/b")).toBe(false);
+      expect(isSameOrigin("/a", "https://example.com/a")).toBe(false);
+      expect(isSameOrigin("https://example.com/a", "/a")).toBe(false);
+    });
+
+    // PROPOSED: protocol-relative URLs have no protocol, so they are
+    // not comparable either (rather than guessing http/https).
+    test("protocol-relative URLs are never same-origin", () => {
+      expect(isSameOrigin("//example.com", "//example.com")).toBe(false);
+      expect(isSameOrigin("//example.com", "https://example.com")).toBe(false);
+    });
+  });
+
+  describe("empty / invalid inputs", () => {
+    test("empty strings", () => {
+      expect(isSameOrigin("", "")).toBe(false);
+      expect(isSameOrigin("", "https://example.com")).toBe(false);
+    });
+    test("undefined / null", () => {
+      expect(isSameOrigin(undefined as any, undefined as any)).toBe(false);
+      expect(isSameOrigin("https://example.com", undefined as any)).toBe(false);
+      expect(isSameOrigin(null as any, "https://example.com")).toBe(false);
+    });
+    test("does not throw on garbage", () => {
+      expect(isSameOrigin("http://", "http://")).toBe(false);
+      expect(isSameOrigin("::::", "::::")).toBe(false);
+    });
+  });
+
+  describe("opaque / non-hierarchical protocols", () => {
+    // PROPOSED: only URLs with a host can have a comparable origin.
+    // Mirrors browsers where these origins are opaque ("null").
+    test("data:, javascript:, mailto: are never same-origin", () => {
+      expect(isSameOrigin("data:text/plain,a", "data:text/plain,a")).toBe(
+        false,
+      );
+      expect(isSameOrigin("javascript:void(0)", "javascript:void(0)")).toBe(
+        false,
+      );
+      expect(isSameOrigin("mailto:a@b.c", "mailto:a@b.c")).toBe(false);
+    });
+  });
+
+  describe("unicode / punycode hosts", () => {
+    // PROPOSED: IDN hosts are compared in their normalized (punycode) form.
+    test("unicode host equals its punycode form", () => {
+      expect(isSameOrigin("https://münchen.de", "https://xn--mnchen-3ya.de")).toBe(
+        true,
+      );
+    });
+  });
+});
