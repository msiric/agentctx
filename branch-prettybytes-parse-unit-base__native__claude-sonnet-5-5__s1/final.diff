+
+/**
+Convert a byte string to a number of bytes: `'1.5 KiB'` → `1536`.
+
+Accepts a plain number (`'512'`), `B`, one of the binary units `KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`, `ZiB`, `YiB` (powers of 1024), or one of the SI units `kB`, `MB`, `GB`, `TB`, `PB`, `EB`, `ZB`, `YB` (powers of 1000). `KB` is accepted as an alias for `kB`. The number may be fractional and may have a leading `+` or `-`. The space before the unit is optional, and a non-breaking space is accepted too. Units are case-sensitive.
+
+The result is not rounded, so a fractional byte count can be returned (`'0.5 B'` → `0.5`).
+
+@param string - The string to parse.
+@throws A `TypeError` if the input is not a string, or a `SyntaxError` if it is malformed or uses an unsupported unit.
+
+@example
+```
+import {parseBytes} from 'pretty-bytes';
+
+parseBytes('512');
+//=> 512
+
+parseBytes('1.5 KiB');
+//=> 1536
+
+parseBytes('1.5 kB');
+//=> 1500
+```
+*/
+export function parseBytes(string: string): number;
diff --git a/index.js b/index.js
index c5f37ab..a2371ee 100644
--- a/index.js
+++ b/index.js
@@ -285,3 +285,31 @@ export default function prettyBytes(number, options) {
 	const result = prefix + numberString + separator + UNITS[exponent];
 	return result.padStart(options.fixedWidth ?? 0);
 }
+
+const BYTE_MULTIPLIERS = new Map([
+	...BIBYTE_UNITS.map((unit, index) => [unit, 1024 ** index]),
+	...BYTE_UNITS.map((unit, index) => [unit, 1000 ** index]),
+	['KB', 1000],
+]);
+
+const PARSE_PATTERN = /^([+-]?)(\d+(?:\.\d*)?|\.\d+)(?:[\u00A0\u202F ]?([A-Za-z]+))?$/;
+
+export function parseBytes(string) {
+	if (typeof string !== 'string') {
+		throw new TypeError(`Expected a string, got \`${typeof string}\``);
+	}
+
+	const match = PARSE_PATTERN.exec(string.trim());
+	if (!match) {
+		throw new SyntaxError(`Invalid byte string: \`${string}\``);
+	}
+
+	const [, sign, digits, unit = 'B'] = match;
+	const multiplier = BYTE_MULTIPLIERS.get(unit);
+	if (multiplier === undefined) {
+		throw new SyntaxError(`Unsupported unit \`${unit}\` in \`${string}\`, expected one of: ${[...BYTE_MULTIPLIERS.keys()].join(', ')}`);
+	}
+
+	const bytes = Number(digits) * multiplier;
+	return sign === '-' ? -bytes : bytes;
+}
