+    def test_get_jobs_for(self):
+        def foo(*args):
+            pass
+
+        def bar():
+            pass
+
+        class Obj:
+            def method(self):
+                pass
+
+        obj = Obj()
+        scheduler = schedule.Scheduler()
+        j1 = scheduler.every().second.do(foo)
+        j2 = scheduler.every().minute.do(foo, 1, 2)
+        j3 = scheduler.every().hour.do(bar)
+        j4 = scheduler.every().day.do(obj.method)
+
+        assert scheduler.get_jobs_for(foo) == [j1, j2]
+        assert scheduler.get_jobs_for(bar) == [j3]
+        assert scheduler.get_jobs_for(obj.method) == [j4]
+        assert scheduler.get_jobs_for(lambda: None) == []
+
+        scheduler.cancel_job(j1)
+        assert scheduler.get_jobs_for(foo) == [j2]
+        for job in scheduler.get_jobs_for(foo):
+            scheduler.cancel_job(job)
+        assert scheduler.get_jobs_for(foo) == []
+
+    def test_pause_and_resume_by_tag(self):
+        scheduler = schedule.Scheduler()
+        paused_fn = make_mock_job("paused")
+        other_fn = make_mock_job("other")
+        untagged_fn = make_mock_job("untagged")
+        j1 = scheduler.every().second.do(paused_fn).tag("maintenance")
+        j2 = scheduler.every().second.do(other_fn).tag("other")
+        j3 = scheduler.every().second.do(untagged_fn)
+
+        scheduler.pause("maintenance")
+        assert j1.paused
+        assert not j2.paused
+        assert not j3.paused
+
+        with mock_datetime(2100, 1, 1, 0, 0):
+            scheduler.run_pending()
+        assert paused_fn.call_count == 0
+        assert other_fn.call_count == 1
+        assert untagged_fn.call_count == 1
+        # Paused jobs stay scheduled
+        assert j1 in scheduler.get_jobs()
+
+        scheduler.resume("maintenance")
+        assert not j1.paused
+        with mock_datetime(2100, 1, 1, 0, 1):
+            scheduler.run_pending()
+        assert paused_fn.call_count == 1
+
