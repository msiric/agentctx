+    def test_run_pending_continues_after_error_and_reraises_first(self):
+        calls = []
+
+        def bad(n):
+            calls.append(n)
+            raise ValueError(n)
+
+        def good():
+            calls.append("good")
+
+        with mock_datetime(2010, 1, 6, 12, 15):
+            j1 = every().minute.do(bad, 1)
+            j2 = every().minute.do(good)
+            j3 = every().minute.do(bad, 3)
+            with mock_datetime(2010, 1, 6, 12, 17):
+                with self.assertRaises(ValueError) as cm:
+                    schedule.run_pending()
+                assert cm.exception.args == (1,)
+                assert sorted(map(str, calls)) == ["1", "3", "good"]
+                for j in (j1, j2, j3):
+                    assert j.next_run > datetime.datetime(2010, 1, 6, 12, 17)
