+/**
+ * Scale a non-negative decimal string by 10^places exactly (by moving the
+ * decimal point) and floor the result.
+ *
+ * @param {string} digits
+ * @param {number} places
+ * @param {boolean} negative
+ * @returns {number}
+ * @private
+ */
+
+function scaleDecimal(digits, places, negative) {
+  var parts = digits.split('.');
+  var frac = parts[1] || '';
+  var whole = parts[0] + (frac + new Array(places + 1).join('0')).slice(0, places);
+  var rest = frac.slice(places);
+  var result = Number(whole);
+
+  if (negative) {
+    result = -result;
+    if (/[1-9]/.test(rest)) {
+      result -= 1;
+    }
+  }
+
+  return result;
+}
diff --git a/test/byte-parse.js b/test/byte-parse.js
index cebfab2..1d01f73 100644
--- a/test/byte-parse.js
+++ b/test/byte-parse.js
@@ -108,4 +108,47 @@ describe('Test byte parse function', function(){
   it('Should allow whitespace', function(){
     assert.equal(bytes.parse('1 TB'), 1 * Math.pow(1024, 4));
   });
+
+  describe('with decimal option', function(){
+    var opts = {decimal: true};
+
+    it('Should use powers of 1000', function(){
+      assert.equal(bytes.parse('1kB', opts), 1000);
+      assert.equal(bytes.parse('1MB', opts), 1e6);
+      assert.equal(bytes.parse('1GB', opts), 1e9);
+      assert.equal(bytes.parse('1TB', opts), 1e12);
+      assert.equal(bytes.parse('1PB', opts), 1e15);
+      assert.equal(bytes.parse('1 kb', opts), 1000);
+    });
+
+    it('Should scale decimals exactly', function(){
+      assert.equal(bytes.parse('2.01 kB', opts), 2010);
+      assert.equal(bytes.parse('4.1 MB', opts), 4100000);
+      assert.equal(bytes.parse('1.5GB', opts), 1500000000);
+    });
+
+    it('Should drop partial bytes', function(){
+      assert.equal(bytes.parse('1.0009kB', opts), 1000);
+      assert.equal(bytes.parse('1.0000001MB', opts), 1000000);
+      assert.equal(bytes.parse('-1.0005kB', opts), -1001);
+      assert.equal(bytes.parse('-1.5kB', opts), -1500);
+    });
+
+    it('Should not change bytes or plain numbers', function(){
+      assert.equal(bytes.parse('1024', opts), 1024);
+      assert.equal(bytes.parse('1.1b', opts), 1);
+      assert.equal(bytes.parse(5, opts), 5);
+      assert.strictEqual(bytes.parse('foo', opts), null);
+    });
+
+    it('Should work through bytes()', function(){
+      assert.equal(bytes('2kB', opts), 2000);
+    });
+
+    it('Should default to binary units', function(){
+      assert.equal(bytes.parse('1kB'), 1024);
+      assert.equal(bytes.parse('1kB', {}), 1024);
+      assert.equal(bytes.parse('1kB', {decimal: false}), 1024);
+    });
+  });
 });
