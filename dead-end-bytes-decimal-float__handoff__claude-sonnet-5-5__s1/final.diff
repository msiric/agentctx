@@ -108,4 +108,50 @@ describe('Test byte parse function', function(){
   it('Should allow whitespace', function(){
     assert.equal(bytes.parse('1 TB'), 1 * Math.pow(1024, 4));
   });
+
+  describe('decimal option', function(){
+    var opts = {decimal: true};
+
+    it('Should use powers of 1000', function(){
+      assert.equal(bytes.parse('1kB', opts), 1000);
+      assert.equal(bytes.parse('1MB', opts), 1e6);
+      assert.equal(bytes.parse('1GB', opts), 1e9);
+      assert.equal(bytes.parse('1TB', opts), 1e12);
+      assert.equal(bytes.parse('1PB', opts), 1e15);
+      assert.equal(bytes.parse('1 kb', opts), 1000);
+    });
+
+    it('Should be exact for floats that multiply badly', function(){
+      assert.equal(bytes.parse('2.01 kB', opts), 2010);
+      assert.equal(bytes.parse('4.1 MB', opts), 4100000);
+      assert.equal(bytes.parse('8.2 GB', opts), 8200000000);
+      assert.equal(bytes.parse('16.9 TB', opts), 16900000000000);
+    });
+
+    it('Should drop partial bytes', function(){
+      assert.equal(bytes.parse('1.0009999kB', opts), 1000);
+      assert.equal(bytes.parse('1.5MB', opts), 1500000);
+    });
+
+    it('Should floor negative values', function(){
+      assert.equal(bytes.parse('-1.5kB', opts), -1500);
+      assert.equal(bytes.parse('-1.0001kB', opts), -1001);
+      assert.equal(bytes.parse('-0kB', opts), 0);
+    });
+
+    it('Should leave unitless strings and numbers unchanged', function(){
+      assert.equal(bytes.parse('1024', opts), 1024);
+      assert.equal(bytes.parse(1024, opts), 1024);
+      assert.strictEqual(bytes.parse('foo', opts), null);
+    });
+
+    it('Should be forwarded by bytes()', function(){
+      assert.equal(bytes('1kB', opts), 1000);
+    });
+
+    it('Should not change default behavior', function(){
+      assert.equal(bytes.parse('1kB'), 1024);
+      assert.equal(bytes.parse('1kB', {decimal: false}), 1024);
+    });
+  });
 });
