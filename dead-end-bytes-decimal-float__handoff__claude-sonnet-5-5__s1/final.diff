+
+/**
+ * Scale a decimal number string by 10^exponent and floor it, using string
+ * digit shifting so values like "2.01" stay exact (no float multiplication).
+ *
+ * @param {string} str
+ * @param {number} exponent
+ * @returns {number}
+ * @private
+ */
+
+function parseDecimal(str, exponent) {
+  var negative = str.charAt(0) === '-';
+  var parts = str.replace(/^[-+]/, '').split('.');
+  var frac = parts[1] || '';
+  var kept = frac.slice(0, exponent);
+  var dropped = frac.slice(exponent);
+  var result = Number(parts[0] + kept + new Array(exponent - kept.length + 1).join('0'));
+
+  if (negative) {
+    // Math.floor semantics: any discarded fraction rounds away from zero
+    return -result - (/[1-9]/.test(dropped) ? 1 : 0) || 0;
+  }
+
+  return result;
+}
