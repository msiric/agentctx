+def test_length():
+    assert Length(min=2, max=4).validate("ab") == "ab"
+    assert Length(min=2, max=4).validate("abcd") == "abcd"
+    assert Length().validate("anything") == "anything"
+    assert Length(min=3).validate("abcdef") == "abcdef"
+    assert Length(max=3).validate("") == ""
+    with SE:
+        Length(min=2).validate("a")
+    with SE:
+        Length(max=3).validate("abcd")
+
+    # Bounds count UTF-8 bytes, not characters
+    assert Length(max=2).validate("\u00e9") == "\u00e9"
+    with SE:
+        Length(max=3).validate("\u00e9\u00e9")
+    with SE:
+        Length(min=3).validate("\u00e9")
+    assert Length(max=3).validate("\u20ac") == "\u20ac"
+    with SE:
+        Length(max=2).validate("\u20ac")
+
+    # Non-strings are rejected
+    with SE:
+        Length(max=3).validate(1)
+    with SE:
+        Length(max=3).validate(None)
+
+    # The message reports the length, not the data
+    with raises(SchemaError) as exc:
+        Length(max=3).validate("secret-value")
+    assert "secret" not in str(exc.value)
+    assert "12" in str(exc.value)
+
+    # Custom error
+    with raises(SchemaError) as exc:
+        Schema(Length(max=1, error="too long: {}")).validate("ab")
+    assert "too long: ab" in exc.value.errors
+
+    # Inside a schema, key and value
+    assert Schema({"name": Length(max=5)}).validate({"name": "bob"}) == {"name": "bob"}
+    with SE:
+        Schema({"name": Length(max=5)}).validate({"name": "bobbybob"})
+
+    with raises(ValueError):
+        Length(min=5, max=2)
