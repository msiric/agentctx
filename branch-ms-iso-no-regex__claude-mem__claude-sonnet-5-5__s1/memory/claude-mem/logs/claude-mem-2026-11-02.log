    expect(parseCompound('  1H 30M  ')).toBe(5400000);
  });

  it('should support decimals and negatives', () => {
    expect(parseCompound('1.5h 30m')).toBe(7200000);
    expect(parseCompound('-1h 30m')).toBe(-1800000);
  });

  it('should distinguish m from ms', () => {
    expect(parseCompound('1m 500ms')).toBe(60500);
  });

  it('should return NaN for empty or non-string input', () => {
    expect(parseCompound('')).toBeNaN();
    expect(parseCompound('   ')).toBeNaN();
    // @ts-expect-error testing invalid input
    expect(parseCompound(undefined)).toBeNaN();
    // @ts-expect-error testing invalid input
    expect(parseCompound(5)).toBeNaN();
  });

  it('should return NaN for terms without a unit', () => {
    expect(parseCompound('1h 30')).toBeNaN();
    expect(parseCompound('100')).toBeNaN();
  });

  it('should return NaN for unknown units or garbage', () => {
    expect(parseCompound('1h 30x')).toBeNaN();
    expect(parseCompound('abc')).toBeNaN();
    expect(parseCompound('1h, 30m')).toBeNaN();
    expect(parseCompound('1h and 30m')).toBeNaN();
  });
});
EOF
