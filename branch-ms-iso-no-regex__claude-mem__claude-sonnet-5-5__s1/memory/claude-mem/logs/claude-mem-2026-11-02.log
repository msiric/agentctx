 * Parse a compound duration such as `"1h 30m"` or `"2 days 4 hours"` and
 * return the total in milliseconds. Every term must have a unit, and terms may
 * be separated by whitespace or nothing at all (`"1h30m"`).
 *
 * @param str - A compound duration string
 * @returns The total in milliseconds, or `NaN` if the string can't be parsed
 */
export function parseCompound(str: string): number {
  if (typeof str !== 'string') {
    return NaN;
  }
  const input = str.trim();
  if (input.length === 0) {
    return NaN;
  }
  const term = / *(-?\\d*\\.?\\d+) *([a-z]+) */iy;
  let total = 0;
  while (term.lastIndex < input.length) {
    const match = term.exec(input);
    if (!match) {
      return NaN;
    }
    total += parse(`${match[1]}${match[2]}`);
  }
  return total;
}

'''
