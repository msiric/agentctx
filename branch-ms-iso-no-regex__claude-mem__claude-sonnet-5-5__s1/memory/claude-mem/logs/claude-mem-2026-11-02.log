import { describe, expect, it } from '@jest/globals';
import { formatISO, parseISO } from './index';

describe('parseISO(string)', () => {
  it('should parse hours and minutes', () => {
    expect(parseISO('PT1H30M')).toBe(5400000);
  });

  it('should parse days, hours, minutes and seconds', () => {
    expect(parseISO('P1DT1H1M1S')).toBe(90061000);
  });

  it('should parse single components', () => {
    expect(parseISO('P3D')).toBe(3 * 86400000);
    expect(parseISO('PT1H')).toBe(3600000);
    expect(parseISO('PT1M')).toBe(60000);
    expect(parseISO('PT1S')).toBe(1000);
    expect(parseISO('P2W')).toBe(14 * 86400000);
  });

  it('should parse zero', () => {
    expect(parseISO('PT0S')).toBe(0);
    expect(parseISO('P0D')).toBe(0);
  });

  it('should parse fractional values', () => {
    expect(parseISO('PT0.5S')).toBe(500);
    expect(parseISO('PT0,5S')).toBe(500);
    expect(parseISO('PT0.001S')).toBe(1);
    expect(parseISO('PT1.5H')).toBe(5400000);
    expect(parseISO('PT1M0.02S')).toBe(60020);
  });

  it('should parse negative durations', () => {
    expect(parseISO('-PT1H30M')).toBe(-5400000);
    expect(parseISO('-PT0.5S')).toBe(-500);
  });

  it('should be case-insensitive', () => {
    expect(parseISO('pt1h30m')).toBe(5400000);
  });

  it('should return NaN for years and months', () => {
    expect(parseISO('P1Y')).toBeNaN();
    expect(parseISO('P1M')).toBeNaN();
    expect(parseISO('P1Y2M3DT4H')).toBeNaN();
  });

  it('should return NaN for malformed durations', () => {
    expect(parseISO('P')).toBeNaN();
    expect(parseISO('PT')).toBeNaN();
    expect(parseISO('P1DT')).toBeNaN();
    expect(parseISO('1H30M')).toBeNaN();
    expect(parseISO('PT1H30')).toBeNaN();
    expect(parseISO('PT30M1H')).toBeNaN();
    expect(parseISO('P1H')).toBeNaN();
    expect(parseISO('PT1D')).toBeNaN();
    expect(parseISO('PT-1H')).toBeNaN();
    expect(parseISO('PT1H extra')).toBeNaN();
    expect(parseISO('1h')).toBeNaN();
  });

  it('should throw for invalid input', () => {
    expect(() => parseISO('')).toThrow();
    expect(() => parseISO('P'.repeat(101))).toThrow();
    // @ts-expect-error testing invalid input
    expect(() => parseISO(5400000)).toThrow();
  });

  it('should round-trip with formatISO', () => {
    for (const v of [0, 1, 500, 1250, 60020, 5400000, 90061000, 400 * 86400000, -5400000, -500]) {
      expect(parseISO(formatISO(v))).toBe(v);
    }
  });
});
EOF
