/**
 * Format the given milliseconds as an ISO 8601 duration string.
 *
 * Days are the largest unit used, since months and years are ambiguous.
 * Sub-second values are expressed as fractional seconds, and negative values
 * are prefixed with `-`.
 *
 * @param ms - milliseconds
 * @returns The ISO 8601 duration, e.g. `PT1H30M` or `P1DT1H1M1S`
 * @throws Error if `ms` is not a finite number
 *
 * @example
 * formatISO(5400000); // "PT1H30M"
 * formatISO(90061000); // "P1DT1H1M1S"
 */
export function formatISO(ms: number): string {
  if (typeof ms !== 'number' || !Number.isFinite(ms)) {
    throw new Error('Value provided to ms.formatISO() must be of type number.');
  }

  let rest = Math.round(Math.abs(ms));
  if (rest === 0) {
    return 'PT0S';
  }

  const days = Math.floor(rest / d);
  rest -= days * d;
  const hours = Math.floor(rest / h);
  rest -= hours * h;
  const minutes = Math.floor(rest / m);
  rest -= minutes * m;
  const seconds = Math.floor(rest / s);
  const millis = rest - seconds * s;

  let secStr = '';
  if (millis > 0) {
    secStr = `${seconds}.${String(millis).padStart(3, '0').replace(/0+$/, '')}S`;
  } else if (seconds > 0) {
    secStr = `${seconds}S`;
  }

  const time =
    (hours ? `${hours}H` : '') + (minutes ? `${minutes}M` : '') + secStr;

  return `${ms < 0 ? '-' : ''}P${days ? `${days}D` : ''}${time ? `T${time}` : ''}`;
}
EOF
cat > src/format-iso.test.ts <<'EOF'
import { describe, expect, it } from '@jest/globals';
import { formatISO } from './index';

describe('formatISO(number)', () => {
  it('should format hours and minutes', () => {
    expect(formatISO(5400000)).toBe('PT1H30M');
  });

  it('should format days, hours, minutes and seconds', () => {
    expect(formatISO(90061000)).toBe('P1DT1H1M1S');
  });

  it('should omit the time designator when there is no time part', () => {
    expect(formatISO(86400000)).toBe('P1D');
    expect(formatISO(3 * 86400000)).toBe('P3D');
  });

  it('should omit zero components', () => {
    expect(formatISO(3600000)).toBe('PT1H');
    expect(formatISO(60000)).toBe('PT1M');
    expect(formatISO(1000)).toBe('PT1S');
    expect(formatISO(86400000 + 1000)).toBe('P1DT1S');
  });

  it('should use days as the largest unit', () => {
    expect(formatISO(400 * 86400000)).toBe('P400D');
  });

  it('should format zero', () => {
    expect(formatISO(0)).toBe('PT0S');
  });

  it('should format fractional seconds', () => {
    expect(formatISO(500)).toBe('PT0.5S');
    expect(formatISO(1)).toBe('PT0.001S');
    expect(formatISO(1250)).toBe('PT1.25S');
    expect(formatISO(60000 + 20)).toBe('PT1M0.02S');
  });

  it('should round to whole milliseconds', () => {
    expect(formatISO(0.4)).toBe('PT0S');
    expect(formatISO(1000.6)).toBe('PT1.001S');
  });

  it('should prefix negative values with a minus sign', () => {
    expect(formatISO(-5400000)).toBe('-PT1H30M');
    expect(formatISO(-500)).toBe('-PT0.5S');
  });

  it('should throw for non-finite or non-number values', () => {
    expect(() => formatISO(NaN)).toThrow();
    expect(() => formatISO(Infinity)).toThrow();
    // @ts-expect-error testing invalid input
    expect(() => formatISO('1h')).toThrow();
  });
});
EOF
