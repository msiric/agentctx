+
+/**
+ * Format the given milliseconds as an ISO 8601 duration string.
+ *
+ * Days are the largest unit used, since months and years are ambiguous.
+ * Sub-second values are expressed as fractional seconds, and negative values
+ * are prefixed with `-`.
+ *
+ * @param ms - milliseconds
+ * @returns The ISO 8601 duration, e.g. `PT1H30M` or `P1DT1H1M1S`
+ * @throws Error if `ms` is not a finite number
+ *
+ * @example
+ * formatISO(5400000); // "PT1H30M"
+ * formatISO(90061000); // "P1DT1H1M1S"
+ */
+export function formatISO(ms: number): string {
+  if (typeof ms !== 'number' || !Number.isFinite(ms)) {
+    throw new Error('Value provided to ms.formatISO() must be of type number.');
+  }
+
+  let rest = Math.round(Math.abs(ms));
+  if (rest === 0) {
+    return 'PT0S';
+  }
+
+  const days = Math.floor(rest / d);
+  rest -= days * d;
+  const hours = Math.floor(rest / h);
+  rest -= hours * h;
+  const minutes = Math.floor(rest / m);
+  rest -= minutes * m;
+  const seconds = Math.floor(rest / s);
+  const millis = rest - seconds * s;
+
+  let secStr = '';
+  if (millis > 0) {
+    secStr = `${seconds}.${String(millis).padStart(3, '0').replace(/0+$/, '')}S`;
+  } else if (seconds > 0) {
+    secStr = `${seconds}S`;
+  }
+
+  const time =
+    (hours ? `${hours}H` : '') + (minutes ? `${minutes}M` : '') + secStr;
+
+  return `${ms < 0 ? '-' : ''}P${days ? `${days}D` : ''}${time ? `T${time}` : ''}`;
+}
+
+/**
+ * Parse an ISO 8601 duration string into milliseconds. The inverse of
+ * `formatISO`.
+ *
+ * Supports weeks, days, hours, minutes and seconds, with an optional leading
+ * `-` and decimal fractions (`.` or `,`). Years and months are not supported
+ * since their length is ambiguous, and return `NaN`.
+ *
+ * @param str - ISO 8601 duration, e.g. `PT1H30M`
+ * @returns The duration in milliseconds, or `NaN` if the string is not a supported duration
+ * @throws Error if `str` is not a string with length between 1 and 99
+ *
+ * @example
+ * parseISO('PT1H30M'); // 5400000
+ * parseISO('P1DT1H1M1S'); // 90061000
+ */
+export function parseISO(str: string): number {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw new Error(
+      `Value provided to ms.parseISO() must be a string with length between 1 and 99. value=${JSON.stringify(str)}`,
+    );
+  }
+  const num = '(\\d+(?:[.,]\\d+)?)';
+  const match = new RegExp(
+    `^(-)?P(?:${num}W)?(?:${num}D)?(?:T(?:${num}H)?(?:${num}M)?(?:${num}S)?)?$`,
+    'i',
+  ).exec(str);
+
+  if (!match) {
+    return NaN;
+  }
+
+  const [, sign, weeks, days, hours, minutes, seconds] = match;
+  // At least one component is required, and `T` must be followed by one.
+  if ((!weeks && !days && !hours && !minutes && !seconds) || /t$/i.test(str)) {
+    return NaN;
+  }
+
+  const part = (v: string | undefined, unit: number) =>
+    v ? parseFloat(v.replace(',', '.')) * unit : 0;
+  const total = Math.round(
+    part(weeks, w) +
+      part(days, d) +
+      part(hours, h) +
+      part(minutes, m) +
+      part(seconds, s),
+  );
+  return sign ? -total : total;
+}
