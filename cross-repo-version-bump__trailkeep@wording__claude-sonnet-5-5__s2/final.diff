@@ -328,3 +328,14 @@ test('flag boolean with default string & alias', t => {
 	t.is(typeof baz.two, 'boolean');
 	t.end();
 });
+
+test('count', t => {
+	t.same(fn(['-vvv'], { count:'v' }), { v:3, _:[] }, 'short, grouped');
+	t.same(fn(['--verbose', '--verbose'], { count:['verbose'] }), { verbose:2, _:[] }, 'long, repeated');
+	t.same(fn(['-v', '-vv', '--verbose'], { count:'v', alias:{ v:'verbose' } }), { v:4, verbose:4, _:[] }, 'alias shares count');
+	t.same(fn(['-v', 'foo'], { count:'v' }), { v:1, _:['foo'] }, 'does not consume next arg');
+	t.same(fn(['-vx'], { count:'v' }), { v:1, x:true, _:[] }, 'mixed with other flags');
+	t.same(fn([], { count:'v' }), { _:[] }, 'absent stays unset');
+	t.same(fn([], { count:'v', default:{ v:0 } }), { v:0, _:[] }, 'default');
+	t.end();
+});
