+def gigabytes(num_bytes: float | str, precision: int = 1) -> str:
+    """Format a number of bytes as decimal gigabytes (10**9 bytes), e.g. '1.5 GB'.
+
+    The unit is always GB, however small or large the value. Rounding is half up
+    on the decimal repr of the value (as in `percent`), not half to even.
+
+    Examples:
+        ```pycon
+        >>> gigabytes(1500000000)
+        '1.5 GB'
+        >>> gigabytes(500000000)
+        '0.5 GB'
+        >>> gigabytes(1234567890, 2)
+        '1.23 GB'
+        >>> gigabytes(2500000000, 0)
+        '3 GB'
+
+        ```
+
+    Args:
+        num_bytes (int, float, str): Number of bytes.
+        precision (int): Number of digits after the decimal point.
+
+    Returns:
+        str: The size in gigabytes with a " GB" suffix.
+    """
+    import decimal
+
+    value = float(num_bytes)
+    precision = int(precision)
+    with decimal.localcontext() as ctx:
+        ctx.prec = 400 + max(precision, 0)
+        ctx.rounding = decimal.ROUND_HALF_UP
+        scaled = decimal.Decimal(repr(value)).scaleb(-9)
+        rounded = scaled.quantize(decimal.Decimal(1).scaleb(-precision))
+        return f"{rounded:f} GB"
