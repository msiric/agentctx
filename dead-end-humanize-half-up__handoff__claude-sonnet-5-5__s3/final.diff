+def percent(value: NumberOrString, precision: int = 1) -> str:
+    """Return a fraction formatted as a percentage.
+
+    Examples:
+        ```pycon
+        >>> percent(0.125)
+        '12.5%'
+        >>> percent(0.5)
+        '50.0%'
+        >>> percent(1)
+        '100.0%'
+        >>> percent(0.12345, 2)
+        '12.35%'
+        >>> percent(0.5, 0)
+        '50%'
+        >>> percent(0.0625)
+        '6.3%'
+        >>> percent(-0.25)
+        '-25.0%'
+        >>> percent("foo")
+        'foo'
+        >>> percent(None)
+        'None'
+
+        ```
+
+    Args:
+        value (int, float, str): Fraction to format, where 1 means 100%.
+        precision (int): Number of digits after the decimal point.
+
+    Returns:
+        str: The percentage with a trailing "%", rounded half up (as invoices
+            do) rather than half to even. Non-numeric input is returned
+            as a string, and NaN or infinity as "NaN", "+Inf" or "-Inf".
+    """
+    import decimal
+    import math
+
+    try:
+        value = float(value)
+        if not math.isfinite(value):
+            return _format_not_finite(value)
+    except (ValueError, TypeError):
+        return str(value)
+    precision = int(precision)
+    # Round half up on the decimal repr of the value, as invoices do. Binary
+    # float formatting rounds exact ties to even ('%.1f' % 6.25 == '6.2').
+    with decimal.localcontext() as ctx:
+        ctx.prec = 400 + max(precision, 0)
+        ctx.rounding = decimal.ROUND_HALF_UP
+        scaled = decimal.Decimal(repr(value)).scaleb(2)
+        rounded = scaled.quantize(decimal.Decimal(1).scaleb(-precision))
+        return f"{rounded:f}%"
