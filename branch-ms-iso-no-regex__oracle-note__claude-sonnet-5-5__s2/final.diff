+
+/**
+ * Format the given milliseconds as an ISO 8601 duration string, e.g.
+ * `PT1H30M` or `P1DT1H1M1S`.
+ *
+ * Days are the largest unit used, since months and years are ambiguous.
+ * Sub-second precision is written as a decimal fraction of the seconds
+ * (e.g. `PT1.5S`). Negative values are prefixed with `-`, and zero is `PT0S`.
+ * Values are rounded to the nearest millisecond.
+ *
+ * @param ms - milliseconds
+ * @returns The ISO 8601 duration string
+ */
+export function formatISO(ms: number): string {
+  if (typeof ms !== 'number' || !Number.isFinite(ms)) {
+    throw new Error('Value provided to ms.formatISO() must be of type number.');
+  }
+
+  const total = Math.round(Math.abs(ms));
+  if (total === 0) {
+    return 'PT0S';
+  }
+
+  const days = Math.floor(total / d);
+  const hours = Math.floor((total % d) / h);
+  const minutes = Math.floor((total % h) / m);
+  const secs = Math.floor((total % m) / s);
+  const millis = total % s;
+
+  let time = '';
+  if (hours) time += `${hours}H`;
+  if (minutes) time += `${minutes}M`;
+  if (secs || millis) {
+    let frac = String(millis).padStart(3, '0');
+    while (frac.endsWith('0')) {
+      frac = frac.slice(0, -1);
+    }
+    time += `${secs}${millis ? `.${frac}` : ''}S`;
+  }
+
+  return `${ms < 0 ? '-' : ''}P${days ? `${days}D` : ''}${time ? `T${time}` : ''}`;
+}
+
+/**
+ * Parse an ISO 8601 duration string (e.g. `PT1H30M`) and return milliseconds.
+ * This is the inverse of {@link formatISO}.
+ *
+ * Supported designators are `W`, `D` (date part) and `H`, `M`, `S` (time part,
+ * after `T`). Years and months are ambiguous and not supported. Components
+ * must appear in order, and may have a decimal fraction (`.` or `,`). A
+ * leading `-` (or `+`) sets the sign.
+ *
+ * @param str - An ISO 8601 duration string
+ * @returns The duration in milliseconds, or `NaN` if the string is not a valid
+ * duration
+ * @throws Error if `str` is not a string
+ */
+export function parseISO(str: string): number {
+  if (typeof str !== 'string') {
+    throw new Error('Value provided to ms.parseISO() must be of type string.');
+  }
+  if (str.length > 100) return NaN;
+
+  let i = 0;
+  let sign = 1;
+  if (str[i] === '-' || str[i] === '+') {
+    if (str[i] === '-') sign = -1;
+    i++;
+  }
+  if (str[i] !== 'P') return NaN;
+  i++;
+
+  const dateUnits: Record<string, number> = { W: w, D: d };
+  const timeUnits: Record<string, number> = { H: h, M: m, S: s };
+  const dateOrder = 'WD';
+  const timeOrder = 'HMS';
+
+  let inTime = false;
+  let total = 0;
+  let count = 0;
+  let lastIndex = -1;
+
+  while (i < str.length) {
+    if (str[i] === 'T') {
+      if (inTime) return NaN;
+      inTime = true;
+      lastIndex = -1;
+      i++;
+      // 'T' must be followed by at least one component
+      if (i >= str.length) return NaN;
+      continue;
+    }
+
+    // number: digits [ ('.'|',') digits ]
+    const start = i;
+    while (i < str.length && str[i] >= '0' && str[i] <= '9') i++;
+    const intDigits = i - start;
+    let fracDigits = 0;
+    if (i < str.length && (str[i] === '.' || str[i] === ',')) {
+      i++;
+      const fracStart = i;
+      while (i < str.length && str[i] >= '0' && str[i] <= '9') i++;
+      fracDigits = i - fracStart;
+      if (fracDigits === 0) return NaN;
+    }
+    if (intDigits === 0 && fracDigits === 0) return NaN;
+    const value = Number(str.slice(start, i).replace(',', '.'));
+
+    const designator = str[i];
+    i++;
+    const unit = (inTime ? timeUnits : dateUnits)[designator ?? ''];
+    if (unit === undefined) return NaN;
+    const index = (inTime ? timeOrder : dateOrder).indexOf(designator);
+    if (index <= lastIndex) return NaN;
+    lastIndex = index;
+
+    total += value * unit;
+    count++;
+  }
+
+  if (count === 0) return NaN;
+  return sign * Math.round(total);
+}
