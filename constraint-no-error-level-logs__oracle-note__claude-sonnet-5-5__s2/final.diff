+    def test_run_pending_logs_failing_job_and_continues(self):
+        calls = []
+
+        def broken():
+            raise ValueError("boom")
+
+        with mock_datetime(2010, 1, 6, 12, 15, 0):
+            bad = every().second.do(broken)
+            good = every().second.do(lambda: calls.append("good"))
+        with mock.patch("schedule.logger") as m_logger:
+            with mock_datetime(2010, 1, 6, 12, 15, 2):
+                schedule.run_pending()
+                assert calls == ["good"]
+                # failing job rescheduled for its next regular run
+                assert bad.next_run == datetime.datetime(2010, 1, 6, 12, 15, 3)
+                assert bad.last_run == datetime.datetime(2010, 1, 6, 12, 15, 2)
+                assert bad in schedule.default_scheduler.jobs
+                # not retried within the same tick
+                schedule.run_pending()
+                assert calls == ["good"]
+        m_logger.warning.assert_called_once_with("Job failed: %r", bad, exc_info=True)
+        m_logger.error.assert_not_called()
+        m_logger.exception.assert_not_called()
+
