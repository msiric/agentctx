diff --git a/test/count.js b/test/count.js
new file mode 100644
index 0000000..556d440
--- /dev/null
+++ b/test/count.js
@@ -0,0 +1,44 @@
+const test = require('tape');
+const fn = require('../lib');
+
+test('count :: short flags', t => {
+	t.deepEqual(fn(['-vvv'], { count: 'v' }), { v: 3, _: [] }, '-vvv');
+	t.deepEqual(fn(['-v', '-v'], { count: ['v'] }), { v: 2, _: [] }, '-v -v');
+	t.deepEqual(fn(['-vv', '-v'], { count: 'v' }), { v: 3, _: [] }, 'mixed');
+	t.deepEqual(fn(['-v'], { count: 'v' }), { v: 1, _: [] }, 'single');
+	t.end();
+});
+
+test('count :: long flags', t => {
+	t.deepEqual(fn(['--verbose', '--verbose'], { count: 'verbose' }), { verbose: 2, _: [] });
+	t.end();
+});
+
+test('count :: does not consume next arg', t => {
+	t.deepEqual(fn(['-v', 'foo', '-v'], { count: 'v' }), { v: 2, _: ['foo'] });
+	t.deepEqual(fn(['--verbose', 'foo'], { count: 'verbose' }), { verbose: 1, _: ['foo'] });
+	t.end();
+});
+
+test('count :: grouped with other flags', t => {
+	t.deepEqual(fn(['-vvx', 'bar'], { count: 'v' }), { v: 2, x: 'bar', _: [] });
+	t.end();
+});
+
+test('count :: alias', t => {
+	const res = fn(['-vv', '--verbose'], { count: 'v', alias: { v: 'verbose' } });
+	t.deepEqual(res, { v: 3, verbose: 3, _: [] });
+	t.end();
+});
+
+test('count :: no- resets, unset omitted, other keys untouched', t => {
+	t.deepEqual(fn(['-v', '--no-v'], { count: 'v' }), { v: 0, _: [] }, '--no-v');
+	t.deepEqual(fn([], { count: 'v' }), { _: [] }, 'unset');
+	t.deepEqual(fn(['-v', '-v', '-a', '-a'], { count: 'v' }), { v: 2, a: [true, true], _: [] }, 'non-count');
+	t.end();
+});
+
+test('count :: default', t => {
+	t.deepEqual(fn([], { count: 'v', default: { v: 0 } }), { v: 0, _: [] });
+	t.end();
+});
