@@ -632,6 +632,51 @@ def unparse(input_dict, output=None, encoding='utf-8', full_document=True,
         return value
 
 
+def drop_keys(doc, names):
+    """Return a copy of a parsed document with every key in `names` removed
+    at any depth (attribute keys such as '@id' included).
+
+    The input is not mutated. The walk is iterative, so arbitrarily deeply
+    nested documents do not hit the recursion limit.
+    """
+    if isinstance(names, (str, bytes)):
+        names = (names,)
+    names = frozenset(names)
+
+    def shell(value):
+        if isinstance(value, dict):
+            return {}
+        if isinstance(value, list):
+            return []
+        return None
+
+    root = shell(doc)
+    if root is None:
+        return doc
+    stack = [(doc, root)]
+    while stack:
+        src, dst = stack.pop()
+        if isinstance(src, dict):
+            for k, v in src.items():
+                if k in names:
+                    continue
+                child = shell(v)
+                if child is None:
+                    dst[k] = v
+                else:
+                    dst[k] = child
+                    stack.append((v, child))
+        else:
+            for v in src:
+                child = shell(v)
+                if child is None:
+                    dst.append(v)
+                else:
+                    dst.append(child)
+                    stack.append((v, child))
+    return root
+
+
