diff --git a/src/index.js b/src/index.js
index 2e8bfc9..1a31244 100644
--- a/src/index.js
+++ b/src/index.js
@@ -34,7 +34,14 @@ var RGX = /(\/|^)([:*][^/]*?)(\?)?(?=[/.]|$)/g;
 // error if key missing?
 export function inject(route, values) {
 	return route.replace(RGX, (x, lead, key, optional) => {
-		x = values[key=='*' ? key : key.substring(1)];
-		return x ? '/'+x : (optional || key=='*') ? '' : '/' + key;
+		var wild = key=='*';
+		x = values[wild ? key : key.substring(1)];
+		if (x || x === 0) {
+			x = String(x);
+			// wildcard values are paths: encode each segment, keep the slashes
+			x = wild ? x.split('/').map(encodeURIComponent).join('/') : encodeURIComponent(x);
+			return '/' + x;
+		}
+		return (optional || wild) ? '' : '/' + key;
 	});
 }
