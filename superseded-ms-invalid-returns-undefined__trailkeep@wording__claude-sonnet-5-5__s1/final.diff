+/**
+ * Parse a compound duration such as `"1h 30m"`, `"1h, 30m"` or `"2 days 4 hours"` and
+ * return the total in milliseconds. Each piece is parsed with `parse`, so it
+ * must include a unit and accepts the same units.
+ *
+ * @param str - A string of one or more `<number><unit>` pieces separated by
+ * whitespace and/or a comma
+ * @returns The total in milliseconds
+ * @throws TypeError if `str` is not a string with length between 1 and 99, or
+ * any part of it can't be parsed. Never returns `NaN`.
+ */
+export function parseCompound(str: string): number {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw new TypeError(
+      `Value provided to ms.parseCompound() must be a string with length between 1 and 99. value=${JSON.stringify(str)}`,
+    );
+  }
+  const invalid = () =>
+    new TypeError(
+      `Value provided to ms.parseCompound() is not a valid compound duration. value=${JSON.stringify(str)}`,
+    );
+  const piece = /(-?\d*\.?\d+ *[a-z]+)(?: *, *(?=\S)| +|$)/iy;
+  const trimmed = str.trim();
+  let total = 0;
+  let count = 0;
+  while (piece.lastIndex < trimmed.length) {
+    const match = piece.exec(trimmed);
+    if (!match) {
+      throw invalid();
+    }
+    const part = parse(match[1] as string);
+    if (Number.isNaN(part)) {
+      throw invalid();
+    }
+    total += part;
+    count++;
+  }
+  if (count === 0) {
+    throw invalid();
+  }
+  return total;
+}
+
+/**
+ * Parse a timer-style clock string and return milliseconds. `"m:ss"` (for
+ * example `"1:30"`) and `"h:mm:ss"` (for example `"01:02:03"`) are supported.
+ * Seconds, and minutes when hours are present, must be two digits and below 60.
+ *
+ * @param str - A clock string such as `"1:30"` or `"01:02:03"`
+ * @returns The value in milliseconds, or `undefined` if the input is not a
+ * valid clock string. Never throws and never returns `NaN`.
+ */
+export function parseClock(str: string): number | undefined {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    return undefined;
+  }
+  const match = /^(?:(\d+):(\d{2})|(\d+):(\d{2}):(\d{2}))$/.exec(str);
+  if (!match) {
+    return undefined;
+  }
+  const [hours, minutes, seconds] = match[1]
+    ? [0, Number(match[1]), Number(match[2])]
+    : [Number(match[3]), Number(match[4]), Number(match[5])];
+  if (seconds >= 60 || (match[3] !== undefined && minutes >= 60)) {
+    return undefined;
+  }
+  const total = hours * h + minutes * m + seconds * s;
+  return Number.isSafeInteger(total) ? total : undefined;
+}
