+import { describe, expect, it } from '@jest/globals';
+import { parseClock } from './index';
+
+describe('parseClock(string)', () => {
+  it('should parse m:ss', () => {
+    expect(parseClock('1:30')).toBe(90000);
+    expect(parseClock('0:05')).toBe(5000);
+    expect(parseClock('00:00')).toBe(0);
+    expect(parseClock('90:00')).toBe(5400000);
+  });
+
+  it('should parse h:mm:ss', () => {
+    expect(parseClock('01:02:03')).toBe(3723000);
+    expect(parseClock('1:00:00')).toBe(3600000);
+    expect(parseClock('100:59:59')).toBe(100 * 3600000 + 59 * 60000 + 59000);
+  });
+
+  it('should return undefined for out-of-range parts', () => {
+    expect(parseClock('1:60')).toBeUndefined();
+    expect(parseClock('1:60:00')).toBeUndefined();
+    expect(parseClock('1:00:60')).toBeUndefined();
+  });
+
+  it('should return undefined for malformed input', () => {
+    for (const input of [
+      '',
+      '90',
+      '1:5',
+      '1:2:3',
+      ':30',
+      '1:',
+      '1:30:',
+      '1:02:03:04',
+      '-1:30',
+      '1:30.5',
+      ' 1:30',
+      '1:30 ',
+      'a:bc',
+      '1h',
+    ]) {
+      expect(parseClock(input)).toBeUndefined();
+    }
+  });
+
+  it('should return undefined (not throw) for non-strings and long input', () => {
+    expect(parseClock(undefined as unknown as string)).toBeUndefined();
+    expect(parseClock(null as unknown as string)).toBeUndefined();
+    expect(parseClock(130 as unknown as string)).toBeUndefined();
+    expect(parseClock(`${'1'.repeat(100)}:30`)).toBeUndefined();
+    expect(parseClock(`${'9'.repeat(30)}:00`)).toBeUndefined();
+  });
+});
