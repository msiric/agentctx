+class YAMLStorage(FileStorage):
+    """
+    Store the data in a YAML file.
+
+    Requires PyYAML. Data is loaded with a safe loader, so no arbitrary Python
+    objects can be constructed from the file.
+
+    Unlike plain ``yaml.safe_load`` (which applies the YAML 1.1 rules), only
+    ``true`` and ``false`` are loaded as booleans. Values such as ``NO``,
+    ``off``, ``yes`` or ``on`` stay strings, so e.g. ``country: NO`` is not
+    turned into ``False``.
+    """
+
+    def __init__(self, path: str, create_dirs=False, encoding=None, access_mode='r+', **kwargs):
+        """
+        Create a new instance.
+
+        See :class:`FileStorage` for the file handling arguments.
+
+        :param path: Where to store the YAML data.
+        :param kwargs: Extra arguments passed to ``yaml.dump`` on every write.
+        """
+
+        try:
+            import yaml  # noqa: F401
+        except ImportError:  # pragma: no cover
+            raise ImportError('YAMLStorage requires PyYAML (pip install pyyaml)')
+
+        super().__init__(path, create_dirs=create_dirs, encoding=encoding, access_mode=access_mode)
+
+        self.kwargs = kwargs
+
+    @staticmethod
+    def _loader():
+        import yaml
+
+        class _Loader(yaml.SafeLoader):
+            pass
+
+        # Copy the resolver table (it is shared with SafeLoader) and replace
+        # the YAML 1.1 bool resolver with one that only knows true/false
+        resolvers = {
+            key: [(tag, regexp) for tag, regexp in value if tag != 'tag:yaml.org,2002:bool']
+            for key, value in yaml.SafeLoader.yaml_implicit_resolvers.items()
+        }
+        _Loader.yaml_implicit_resolvers = resolvers
+        _Loader.add_implicit_resolver(
+            'tag:yaml.org,2002:bool', re.compile(r'^(?:true|false)$'), list('tf')
+        )
+        _Loader.add_constructor(
+            'tag:yaml.org,2002:bool',
+            lambda loader, node: loader.construct_scalar(node) == 'true'
+        )
+
+        return _Loader
+
+    def read(self) -> Optional[dict[str, dict[str, Any]]]:
+        import yaml
+
+        self._handle.seek(0)
+        data = yaml.load(self._handle, Loader=self._loader())
+
+        # Empty file (or only whitespace/comments): storage is empty
+        return data or None
+
+    def write(self, data: dict[str, dict[str, Any]]):
+        import yaml
+
+        kwargs = {'default_flow_style': False, 'sort_keys': False, 'allow_unicode': True}
+        kwargs.update(self.kwargs)
+
+        self._handle.seek(0)
+
+        serialized = yaml.safe_dump(data, **kwargs)
+
+        try:
+            self._handle.write(serialized)
+        except io.UnsupportedOperation:
+            raise IOError('Cannot write to the database. Access mode is "{0}"'.format(self._mode))
+
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+        self._handle.truncate()
+
+
