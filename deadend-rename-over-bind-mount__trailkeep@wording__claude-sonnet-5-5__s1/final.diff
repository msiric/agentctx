+
+
+def _read_json(path):
+    with open(path) as f:
+        return json.load(f)
+
+
+class _CrashHandle:
+    """Wraps a file handle; writes only part of the data, then 'dies'."""
+
+    def __init__(self, handle):
+        self._h = handle
+
+    def __getattr__(self, name):
+        return getattr(self._h, name)
+
+    def write(self, data):
+        self._h.write(data[:10])
+        self._h.flush()
+        self._h.truncate()  # file is now just the first 10 bytes
+        raise SystemExit
+
+
+def test_journal_removed_after_write(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    db = TinyDB(path)
+    db.insert({'a': 1})
+    db.close()
+
+    assert not os.path.exists(path + '.journal')
+    assert _read_json(path) == {'_default': {'1': {'a': 1}}}
+
+
+def test_write_keeps_inode(tmpdir):
+    # Must not replace the file (single-file bind mounts)
+    path = str(tmpdir.join('db.json'))
+    db = TinyDB(path)
+    db.insert({'a': 1})
+    inode = os.stat(path).st_ino
+    db.insert({'a': 2})
+    db.close()
+
+    assert os.stat(path).st_ino == inode
+
+
+def test_crash_during_in_place_write(tmpdir, monkeypatch):
+    path = str(tmpdir.join('db.json'))
+    db = TinyDB(path)
+    db.insert({'a': 1})
+    db.close()
+
+    db = TinyDB(path)
+    handle = db.storage._handle
+    # Simulate dying after only part of the new data hit the main file
+    monkeypatch.setattr(db.storage, '_handle', _CrashHandle(handle))
+    with pytest.raises(SystemExit):
+        db.insert({'a': 2})
+    handle.close()
+
+    with pytest.raises(ValueError):
+        _read_json(path)  # the file really is torn
+
+    db2 = TinyDB(path)
+    assert db2.all() == [{'a': 1}, {'a': 2}]
+    db2.close()
+    assert not os.path.exists(path + '.journal')
+
+
+def test_crash_during_journal_write(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    db = TinyDB(path)
+    db.insert({'a': 1})
+    db.close()
+
+    # Torn journal: crash before the main file was touched
+    with open(path + '.journal', 'w') as f:
+        f.write('{"_default": {"1": {"a": 1}, "2"')
+
+    db = TinyDB(path)
+    assert db.all() == [{'a': 1}]
+    db.close()
+    assert not os.path.exists(path + '.journal')
+
+
+def test_readonly_mode_leaves_journal_alone(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    db = TinyDB(path)
+    db.insert({'a': 1})
+    db.close()
+
+    with open(path + '.journal', 'w') as f:
+        f.write('{"_default": {}}')
+
+    storage = JSONStorage(path, access_mode='r')
+    assert storage.read() == {'_default': {'1': {'a': 1}}}
+    storage.close()
+    assert os.path.exists(path + '.journal')
