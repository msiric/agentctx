@@ -76,9 +76,61 @@ class Storage(ABC):
         pass
 
 
+def _fsync_dir(path: str) -> None:
+    """Best-effort fsync of the directory containing ``path``."""
+    try:
+        fd = os.open(os.path.dirname(os.path.abspath(path)), os.O_RDONLY)
+    except OSError:
+        return
+    try:
+        os.fsync(fd)
+    except OSError:
+        pass
+    finally:
+        os.close(fd)
+
+
+def _recover(path: str, journal_path: str) -> None:
+    """
+    Finish or discard an interrupted write.
+
+    The journal holds the complete new state. If it parses as JSON it was
+    fully written, so the main file may be torn and the journal is replayed
+    into it (in place, the inode never changes). If it doesn't parse, the
+    crash happened while writing the journal and the main file is untouched.
+    """
+    if not os.path.exists(journal_path):
+        return
+
+    with open(journal_path, 'rb') as journal:
+        content = journal.read()
+
+    try:
+        json.loads(content)
+        complete = True
+    except ValueError:
+        complete = False
+
+    if complete:
+        with open(path, 'r+b') as target:
+            target.write(content)
+            target.truncate()
+            target.flush()
+            os.fsync(target.fileno())
+
+    os.remove(journal_path)
+    _fsync_dir(journal_path)
+
+
 class JSONStorage(Storage):
     """
     Store the data in a JSON file.
+
+    Writes are crash-safe without replacing the file (the inode is kept, so
+    single-file bind mounts work): the new state is first saved to a
+    ``<path>.journal`` file, then written in place, then the journal is
+    removed. On open, a leftover journal is replayed or discarded so the
+    database is always either the old or the new state.
     """
 
     def __init__(self, path: str, create_dirs=False, encoding=None, access_mode='r+', **kwargs):
