+def _json_key(key: Any) -> str:
+    """
+    Return the string a key is written as by :mod:`json`, so that keys of
+    mixed types (e.g. ``200`` and ``'other'``) can be ordered consistently.
+    """
+
+    if key is True:
+        return 'true'
+    if key is False:
+        return 'false'
+    if key is None:
+        return 'null'
+    if isinstance(key, float):
+        return json.dumps(key)
+    return str(key)
+
+
+def _sort_keys(obj: Any) -> Any:
+    """
+    Recursively rebuild all dicts in ``obj`` with their keys ordered by
+    their JSON string form. Unlike ``sort_keys=True`` this doesn't fail for
+    keys of mixed types.
+    """
+
+    if isinstance(obj, dict):
+        return {k: _sort_keys(obj[k]) for k in sorted(obj, key=_json_key)}
+    if isinstance(obj, (list, tuple)):
+        return [_sort_keys(v) for v in obj]
+    return obj
+
