     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def test_json_sorts_keys_by_default(tmpdir):
+    path = str(tmpdir.join('test.db'))
+    storage = JSONStorage(path)
+    storage.write({'t': {'b': 1, 'a': {'z': 1, 'y': 2}}})
+    storage.close()
+
+    with open(path) as f:
+        assert f.read() == '{"t": {"a": {"y": 2, "z": 1}, "b": 1}}'
+
+
+def test_json_sort_keys_disabled(tmpdir):
+    path = str(tmpdir.join('test.db'))
+    storage = JSONStorage(path, sort_keys=False)
+    storage.write({'t': {'b': 1, 'a': 2}})
+    storage.close()
+
+    with open(path) as f:
+        assert f.read() == '{"t": {"b": 1, "a": 2}}'
+
+
+def test_json_sort_keys_mixed_key_types(tmpdir):
+    path = str(tmpdir.join('test.db'))
+    storage = JSONStorage(path)
+    storage.write({'t': {'other': 3, 200: 1, 'a': [{'z': 1, 1: 2}]}})
+    storage.close()
+
+    with open(path) as f:
+        assert f.read() == (
+            '{"t": {"200": 1, "a": [{"1": 2, "z": 1}], "other": 3}}'
+        )
