 Parse the value as a boolean type instead of string type if it's a boolean.
 
+##### ignoreEmpty
+
+Type: `boolean`\
+Default: `false`
+
+Drop the parameters that have an empty value, like `foo=`. A key without `=`, like `foo`, is not empty and is kept as `null`.
+
+```js
+import queryString from 'query-string';
+
+queryString.parse('?q=&page=2', {ignoreEmpty: true});
+//=> {page: '2'}
+
+queryString.parse('?flag&q=', {ignoreEmpty: true});
+//=> {flag: null}
+```
+
+##### stripTracking
+
+Type: `boolean`\
+Default: `true`
+
+Drop the tracking parameters `utm_*`, `fbclid`, and `gclid`. The match is case-insensitive. Set it to `false` to keep them.
+
+```js
+import queryString from 'query-string';
+
+queryString.parse('?q=a&utm_source=x&fbclid=y&gclid=z');
+//=> {q: 'a'}
+
+queryString.parse('?q=a&utm_source=x', {stripTracking: false});
+//=> {q: 'a', utm_source: 'x'}
+```
+
 ##### types
 
 Type: `object`\
diff --git a/test/parse.js b/test/parse.js
index 00a1abf..9f8442e 100644
--- a/test/parse.js
+++ b/test/parse.js
@@ -1492,3 +1492,27 @@ test('rejects an invalid `arrayFormatSeparator`', () => {
 
 	assert.deepEqual(structuredClone(queryString.parse('foo=a·b', {arrayFormat: 'separator', arrayFormatSeparator: '·'})), {foo: ['a', 'b']});
 });
+
+test('`ignoreEmpty` drops parameters with an empty value', () => {
+	assert.deepEqual(structuredClone(queryString.parse('?q=&page=2', {ignoreEmpty: true})), {page: '2'});
+	assert.deepEqual(structuredClone(queryString.parse('?q=&page=2')), {page: '2', q: ''});
+	assert.deepEqual(structuredClone(queryString.parse('?flag&q=', {ignoreEmpty: true})), {flag: null});
+	assert.deepEqual(structuredClone(queryString.parse('?q=+&r=%20', {ignoreEmpty: true})), {q: ' ', r: ' '});
+	assert.deepEqual(structuredClone(queryString.parse('?a=1&a=&a=2', {ignoreEmpty: true})), {a: ['1', '2']});
+	assert.deepEqual(structuredClone(queryString.parse('?a[]=&b[]=1', {ignoreEmpty: true, arrayFormat: 'bracket'})), {b: ['1']});
+	assert.deepEqual(structuredClone(queryString.parse('?a=&b=1', {ignoreEmpty: true, arrayFormat: 'comma'})), {b: '1'});
+	assert.deepEqual(structuredClone(queryString.parse('?q=', {ignoreEmpty: true})), {});
+});
+
+/* eslint-disable camelcase -- tracking parameter names are snake_case */
+test('`stripTracking` drops `utm_*`, `fbclid`, and `gclid` by default', () => {
+	assert.deepEqual(structuredClone(queryString.parse('?q=a&utm_source=x&utm_medium=y&fbclid=1&gclid=2')), {q: 'a'});
+	assert.deepEqual(structuredClone(queryString.parse('?q=a&UTM_Source=x&utm_=1&utm_term')), {q: 'a'});
+	assert.deepEqual(structuredClone(queryString.parse('?q=a&utm%5Fsource=x')), {q: 'a'});
+	assert.deepEqual(structuredClone(queryString.parse('?q=a&utm_tag[]=1&utm_tag[]=2', {arrayFormat: 'bracket'})), {q: 'a'});
+	assert.deepEqual(structuredClone(queryString.parse('?utm=1&myutm_x=1&fbclid2=1')), {fbclid2: '1', myutm_x: '1', utm: '1'});
+	assert.deepEqual(structuredClone(queryString.parse('?q=a&utm_source=x&fbclid=y&gclid=z', {stripTracking: false})), {
+		fbclid: 'y', gclid: 'z', q: 'a', utm_source: 'x',
+	});
+});
+/* eslint-enable camelcase */
