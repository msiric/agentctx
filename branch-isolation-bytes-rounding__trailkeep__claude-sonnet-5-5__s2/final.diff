+/**
+ * Format a number with the given decimal places, truncating toward zero.
+ *
+ * Works on the exact decimal expansion string rather than multiplying by
+ * 10^n, which would introduce floating point error (1.15 -> 1.14).
+ *
+ * @param {number} val
+ * @param {number} decimalPlaces
+ * @private
+ */
+
+function truncate(val, decimalPlaces) {
+  var places = Math.max(0, Math.min(Math.floor(decimalPlaces) || 0, 20));
+  var mag = Math.abs(val);
+  // shortest round-trip representation (1.15 -> '1.15'); exponent forms fall back to the exact expansion
+  var text = String(mag);
+  var parts = (/e/.test(text) ? mag.toFixed(100) : text).split('.');
+  var frac = (parts[1] || '') + '00000000000000000000';
+  var str = places > 0 ? parts[0] + '.' + frac.slice(0, places) : parts[0];
+
+  return val < 0 && /[1-9]/.test(str) ? '-' + str : str;
+}
