diff --git a/test/byte-format.js b/test/byte-format.js
index 7e82cee..e68b3a7 100644
--- a/test/byte-format.js
+++ b/test/byte-format.js
@@ -116,4 +116,50 @@ describe('Test byte format function', function(){
     assert.equal(bytes.format(12 * mb, {unit: ''}).toLowerCase(), '12mb');
     assert.equal(bytes.format(12 * mb, {unit: 'bb'}).toLowerCase(), '12mb');
   })
+
+  describe('with rounding: "down"', function(){
+    var down = {rounding: 'down'};
+
+    it('Should never round up at unit boundaries', function(){
+      assert.equal(bytes.format(kb - 1, down), '1023B');
+      assert.equal(bytes.format(mb - 1, down), '1023.99KB');
+      assert.equal(bytes.format(gb - 1, down), '1023.99MB');
+      assert.equal(bytes.format(tb - 1, down), '1023.99GB');
+      assert.equal(bytes.format(pb - 1, down), '1023.99TB');
+      assert.equal(bytes.format(2047, down), '1.99KB');
+    });
+
+    it('Should keep exact values', function(){
+      assert.equal(bytes.format(kb, down), '1KB');
+      assert.equal(bytes.format(mb, down), '1MB');
+      assert.equal(bytes.format(1.5 * kb, down), '1.5KB');
+      assert.equal(bytes.format(0, down), '0B');
+    });
+
+    it('Should truncate with custom decimal places', function(){
+      assert.equal(bytes.format(1.5 * kb, {rounding: 'down', decimalPlaces: 0}), '1KB');
+      assert.equal(bytes.format(mb - 1, {rounding: 'down', decimalPlaces: 0}), '1023KB');
+      assert.equal(bytes.format(mb - 1, {rounding: 'down', decimalPlaces: 3}), '1023.999KB');
+      assert.equal(bytes.format(mb - 1, {rounding: 'down', decimalPlaces: 3, fixedDecimals: true}), '1023.999KB');
+      assert.equal(bytes.format(kb, {rounding: 'down', decimalPlaces: 3, fixedDecimals: true}), '1.000KB');
+    });
+
+    it('Should avoid floating point error', function(){
+      assert.equal(bytes.format(1.15, {rounding: 'down', unit: 'B', decimalPlaces: 2}), '1.15B');
+    });
+
+    it('Should truncate magnitude of negatives toward zero', function(){
+      assert.equal(bytes.format(-(mb - 1), down), '-1023.99KB');
+      assert.equal(bytes.format(-2047, down), '-1.99KB');
+      assert.equal(bytes.format(-0.001, {rounding: 'down', unit: 'B'}), '0B');
+    });
+
+    it('Should work with separators', function(){
+      assert.equal(bytes.format(mb * 2000 - 1, {rounding: 'down', unit: 'KB', thousandsSeparator: ','}), '2,047,999.99KB');
+    });
+  });
+
+  it('Should keep rounding by default', function(){
+    assert.equal(bytes.format(mb - 1), '1024KB');
+  });
