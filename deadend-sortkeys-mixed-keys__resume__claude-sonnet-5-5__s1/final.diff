+def _json_key(key: Any) -> Any:
+    # Mirror how ``json.dumps`` turns non-string keys into strings
+    if key is True:
+        return 'true'
+    if key is False:
+        return 'false'
+    if key is None:
+        return 'null'
+    return str(key) if isinstance(key, (int, float)) else key
+
+
+def _sort_keys(obj: Any) -> Any:
+    """
+    Recursively order dict keys by their JSON string form.
+
+    ``json.dumps(sort_keys=True)`` raises ``TypeError`` for dicts that mix key
+    types (e.g. ``{200: 1, "other": 2}``), so we sort ourselves.
+    """
+    if isinstance(obj, dict):
+        items = sorted(obj.items(), key=lambda kv: str(_json_key(kv[0])))
+        return {k: _sort_keys(v) for k, v in items}
+    if isinstance(obj, (list, tuple)):
+        return [_sort_keys(v) for v in obj]
+    return obj
+
+
