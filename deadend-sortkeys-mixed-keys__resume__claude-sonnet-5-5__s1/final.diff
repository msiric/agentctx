+def test_json_sort_keys_default_and_opt_out(tmpdir):
+    sorted_file = tmpdir.join('sorted.json')
+    with TinyDB(str(sorted_file)) as db:
+        db.insert({'b': 1, 'a': {'z': 1, 'y': 2}})
+    assert sorted_file.read() == \
+        '{"_default": {"1": {"a": {"y": 2, "z": 1}, "b": 1}}}'
+
+    unsorted_file = tmpdir.join('unsorted.json')
+    with TinyDB(str(unsorted_file), sort_keys=False) as db:
+        db.insert({'b': 1, 'a': 2})
+    assert unsorted_file.read() == '{"_default": {"1": {"b": 1, "a": 2}}}'
+
+
+def test_json_sort_keys_is_order_independent(tmpdir):
+    f1, f2 = tmpdir.join('1.json'), tmpdir.join('2.json')
+    with TinyDB(str(f1)) as db:
+        db.insert({'a': 1, 'b': 2})
+    with TinyDB(str(f2)) as db:
+        db.insert({'b': 2, 'a': 1})
+    assert f1.read() == f2.read()
+
+
+def test_json_sort_keys_mixed_key_types(tmpdir):
+    path = tmpdir.join('mixed.json')
+    doc = {'endpoint': '/api/orders', 'hits': {200: 1520, 404: 12, 'other': 3}}
+    with TinyDB(str(path)) as db:
+        db.insert(doc)
+        db.insert({'hits': [{'other': 1, 404: 2}]})
+    assert path.read() == (
+        '{"_default": {"1": {"endpoint": "/api/orders", '
+        '"hits": {"200": 1520, "404": 12, "other": 3}}, '
+        '"2": {"hits": [{"404": 2, "other": 1}]}}}'
+    )
+    with TinyDB(str(path)) as db:
+        assert db.get(doc_id=1)['hits'] == {'200': 1520, '404': 12, 'other': 3}
+
+
