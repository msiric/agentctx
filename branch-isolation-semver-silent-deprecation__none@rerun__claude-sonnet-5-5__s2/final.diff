+
+
+@pytest.mark.parametrize(
+    "cli,expected",
+    [
+        (["bump", "major", "v1.2.3"], "2.0.0"),
+        (["bump", "minor", "V1.2.3"], "1.3.0"),
+        (["bump", "patch", "v1.2.3"], "1.2.4"),
+        (["bump", "prerelease", "v1.2.3-rc.1"], "1.2.3-rc.2"),
+        (["bump", "build", "v1.2.3+build.1"], "1.2.3+build.2"),
+        (["compare", "v1.2.3", "V2.1.3"], "-1"),
+        (["compare", "v1.2.3", "1.2.3"], "0"),
+        (["nextver", "v1.4.2", "minor"], "1.5.0"),
+        (["check", "v1.4.2"], ""),
+    ],
+)
+def test_cli_accepts_leading_v(capsys, cli, expected):
+    from semver.cli import main
+    assert main(cli) == 0
+    assert capsys.readouterr().out.strip() == expected
+
+
+@pytest.mark.parametrize("version", ["vv1.2.3", "v", "x1.2.3"])
