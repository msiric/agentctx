+def gigabytes(num_bytes: float | str, precision: int = 1) -> str:
+    """Format a number of bytes as decimal gigabytes (10**9 bytes).
+
+    Ties round half up (like billing's invoices), not half to even.
+
+    Examples:
+        ```pycon
+        >>> gigabytes(1500000000)
+        '1.5 GB'
+        >>> gigabytes(2 * 10**9, 0)
+        '2 GB'
+        >>> gigabytes(1250000000, 1)
+        '1.3 GB'
+        >>> gigabytes(1234567890, 3)
+        '1.235 GB'
+
+        ```
+
+    Args:
+        num_bytes (int, float, str): Number of bytes.
+        precision (int): Number of decimal places.
+
+    Returns:
+        str: The size in gigabytes, e.g. '1.5 GB'.
+    """
+    import decimal
+    import math
+
+    number = float(num_bytes)
+    if not math.isfinite(number):
+        from humanize.number import _format_not_finite
+
+        return f"{_format_not_finite(number)} GB"
+    # Use the exact value for ints and the shortest repr for floats, so ties
+    # are decided on the decimal value rather than on binary float noise.
+    if isinstance(num_bytes, float):
+        dec = decimal.Decimal(repr(num_bytes))
+    else:
+        dec = decimal.Decimal(str(num_bytes).strip())
+    quantum = decimal.Decimal(1).scaleb(-int(precision))
+    rounded = dec.scaleb(-9).quantize(quantum, rounding=decimal.ROUND_HALF_UP)
+    return f"{rounded:f} GB"
