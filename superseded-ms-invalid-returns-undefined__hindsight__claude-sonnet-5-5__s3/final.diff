+/**
+ * Parse a compound duration such as `"1h 30m"`, `"1h, 30m"` or `"2 days 4 hours"` and
+ * return the total in milliseconds. Each piece is parsed with `parse`.
+ *
+ * Every piece must include a unit.
+ *
+ * @param str - A compound duration string
+ * @returns The total in milliseconds
+ * @throws TypeError if `str` is not a string of length 1 to 99 or any part of
+ * it can't be parsed
+ */
+export function parseCompound(str: string): number {
+  const invalid = () =>
+    new TypeError(
+      `Value provided to ms.parseCompound() must be a compound duration like "1h 30m". value=${JSON.stringify(str)}`,
+    );
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw invalid();
+  }
+  const piece = /(-?\d*\.?\d+) *([a-z]+)/iy;
+  let total = 0;
+  let pos = 0;
+  let count = 0;
+  while (pos < str.length) {
+    // skip whitespace between pieces
+    while (str[pos] === ' ') pos++;
+    if (pos >= str.length) break;
+    piece.lastIndex = pos;
+    const match = piece.exec(str);
+    if (!match) {
+      throw invalid();
+    }
+    const n = parse(match[0]);
+    if (Number.isNaN(n)) {
+      throw invalid();
+    }
+    total += n;
+    pos = piece.lastIndex;
+    count++;
+    // allow a single optional comma between pieces, which must be followed by another piece
+    while (str[pos] === ' ') pos++;
+    if (str[pos] === ',') {
+      pos++;
+      while (str[pos] === ' ') pos++;
+      if (pos >= str.length) throw invalid();
+    }
+  }
+  if (count === 0) {
+    throw invalid();
+  }
+  return total;
+}
+
+const CLOCK_REGEX = /^(-)?(?:(\d+):(\d{2})|(\d+)):(\d{2}(?:\.\d+)?)$/;
+
+/**
+ * Parse a timer-style string and return milliseconds. `"m:ss"` (e.g. `"1:30"`)
+ * and `"h:mm:ss"` (e.g. `"01:02:03"`) are supported. Seconds may have a
+ * fractional part (`"1:30.5"`), and the string may start with `-`.
+ *
+ * Seconds (and minutes, when hours are given) must be below 60.
+ *
+ * @param str - A clock string
+ * @returns The value in milliseconds
+ * @throws TypeError if `str` is not a string of length 1 to 99 or isn't a valid clock string
+ */
+export function parseClock(str: string): number {
+  const invalid = () =>
+    new TypeError(
+      `Value provided to ms.parseClock() must be a clock string like "1:30" or "01:02:03". value=${JSON.stringify(str)}`,
+    );
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw invalid();
+  }
+  const match = CLOCK_REGEX.exec(str);
+  if (!match) {
+    throw invalid();
+  }
+  const hasHours = match[2] !== undefined;
+  const hours = hasHours ? Number(match[2]) : 0;
+  const minutes = Number(hasHours ? match[3] : match[4]);
+  const seconds = Number(match[5]);
+  if (seconds >= 60 || (hasHours && minutes >= 60)) {
+    throw invalid();
+  }
+  const total = ((hours * 60 + minutes) * 60 + seconds) * 1000;
+  return match[1] ? -total : total;
+}
