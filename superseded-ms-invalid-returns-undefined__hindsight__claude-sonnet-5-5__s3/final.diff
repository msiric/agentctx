+import { describe, expect, it } from '@jest/globals';
+import { parseCompound } from './index';
+
+describe('parseCompound(string)', () => {
+  it('should parse short units', () => {
+    expect(parseCompound('1h 30m')).toBe(5400000);
+  });
+
+  it('should parse long units', () => {
+    expect(parseCompound('2 days 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
+  });
+
+  it('should parse pieces without spaces', () => {
+    expect(parseCompound('1h30m15s')).toBe(5415000);
+  });
+
+  it('should parse a single piece like parse', () => {
+    expect(parseCompound('2d')).toBe(172800000);
+  });
+
+  it('should support decimals and negatives', () => {
+    expect(parseCompound('1.5h 30m')).toBe(7200000);
+    expect(parseCompound('1h -30m')).toBe(1800000);
+  });
+
+  it('should accept commas between parts', () => {
+    expect(parseCompound('1h, 30m')).toBe(5400000);
+    expect(parseCompound('1h,30m')).toBe(5400000);
+    expect(parseCompound('2 days , 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
+  });
+
+  it('should be case insensitive', () => {
+    expect(parseCompound('1H 30M')).toBe(5400000);
+  });
+
+  it('should throw a TypeError including the input for invalid strings', () => {
+    for (const input of ['abc', '1h foo', '1h 30', '1h 30x', '   ', '', ',1h', '1h,', '1h,,30m', ',']) {
+      expect(() => parseCompound(input)).toThrow(TypeError);
+      expect(() => parseCompound(input)).toThrow(JSON.stringify(input));
+    }
+  });
+
+  it('should throw a TypeError for long or non-string values', () => {
+    expect(() => parseCompound('1h '.repeat(40))).toThrow(TypeError);
+    // @ts-expect-error testing runtime behavior
+    expect(() => parseCompound(5)).toThrow(TypeError);
+  });
+});
