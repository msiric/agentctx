+import { describe, expect, it } from '@jest/globals';
+import { parseClock } from './index';
+
+describe('parseClock(string)', () => {
+  it('should parse m:ss', () => {
+    expect(parseClock('1:30')).toBe(90000);
+    expect(parseClock('0:05')).toBe(5000);
+    expect(parseClock('00:00')).toBe(0);
+  });
+
+  it('should allow minutes of 60 or more in m:ss', () => {
+    expect(parseClock('90:00')).toBe(5400000);
+  });
+
+  it('should parse h:mm:ss', () => {
+    expect(parseClock('01:02:03')).toBe(3723000);
+    expect(parseClock('1:00:00')).toBe(3600000);
+    expect(parseClock('100:00:00')).toBe(360000000);
+  });
+
+  it('should support fractional seconds', () => {
+    expect(parseClock('1:30.5')).toBe(90500);
+    expect(parseClock('0:00.25')).toBe(250);
+    expect(parseClock('1:02:03.5')).toBe(3723500);
+  });
+
+  it('should support a leading minus', () => {
+    expect(parseClock('-1:30')).toBe(-90000);
+    expect(parseClock('-01:02:03')).toBe(-3723000);
+  });
+
+  it('should throw a TypeError including the input for invalid strings', () => {
+    for (const input of [
+      '',
+      ' ',
+      'abc',
+      '1',
+      '1:3',
+      '1:300',
+      '1:60',
+      '1:60:00',
+      '1:00:60',
+      '1:2:03',
+      '1:02:03:04',
+      ':30',
+      '1:',
+      '1::30',
+      ' 1:30',
+      '1:30 ',
+      '1:30s',
+      '+1:30',
+      '--1:30',
+      '1:-30',
+      '1.5:30',
+    ]) {
+      expect(() => parseClock(input)).toThrow(TypeError);
+      expect(() => parseClock(input)).toThrow(JSON.stringify(input));
+    }
+  });
+
+  it('should throw a TypeError for long or non-string values', () => {
+    expect(() => parseClock(`1:${'0'.repeat(100)}`)).toThrow(TypeError);
+    // @ts-expect-error testing runtime behavior
+    expect(() => parseClock(130)).toThrow(TypeError);
+    // @ts-expect-error testing runtime behavior
+    expect(() => parseClock(undefined)).toThrow(TypeError);
+  });
+});
