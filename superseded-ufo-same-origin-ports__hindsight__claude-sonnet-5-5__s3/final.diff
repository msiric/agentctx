diff --git a/test/same-origin.test.ts b/test/same-origin.test.ts
new file mode 100644
index 0000000..cccbaf0
--- /dev/null
+++ b/test/same-origin.test.ts
@@ -0,0 +1,142 @@
+import { describe, expect, test } from "vitest";
+import { isSameOrigin } from "../src";
+
+// Origin = protocol + hostname + port (path, query, hash and userinfo are ignored).
+// Ports are compared strictly as written: no default-port normalization.
+describe("isSameOrigin", () => {
+  describe("same origin", () => {
+    const same = [
+      // Identical
+      ["https://example.com", "https://example.com"],
+      // Path, query and hash do not matter
+      ["https://example.com", "https://example.com/"],
+      ["https://example.com/a", "https://example.com/b"],
+      ["https://example.com/?a=1", "https://example.com/?b=2"],
+      ["https://example.com/#a", "https://example.com/#b"],
+      // Protocol and host are case-insensitive
+      ["HTTPS://example.com", "https://example.com"],
+      ["https://EXAMPLE.com", "https://example.com"],
+      // Ports are compared as written: identical explicit ports match
+      ["http://localhost:3000/a", "http://localhost:3000/b"],
+      ["https://example.com:443", "https://example.com:443"],
+      // Userinfo is not part of the origin
+      ["https://user:pass@example.com", "https://example.com"],
+      ["https://a@example.com", "https://b@example.com"],
+      // Punycode / unicode hostnames are equivalent
+      ["https://xn--mnchen-3ya.de", "https://münchen.de"],
+      // IP hosts
+      ["http://127.0.0.1:8080/a", "http://127.0.0.1:8080/b"],
+      ["http://[::1]:8080/a", "http://[::1]:8080/b"],
+      // Protocol-relative URLs compare by host only
+      ["//example.com/a", "//example.com/b"],
+      ["//example.com:8080", "//example.com:8080"],
+    ];
+
+    for (const [a, b] of same) {
+      test(`${a} == ${b}`, () => {
+        expect(isSameOrigin(a, b)).toBe(true);
+        // Symmetric
+        expect(isSameOrigin(b, a)).toBe(true);
+      });
+    }
+  });
+
+  describe("different origin", () => {
+    const different = [
+      // Different protocol
+      ["http://example.com", "https://example.com"],
+      ["ws://example.com", "wss://example.com"],
+      // Different host
+      ["https://example.com", "https://example.org"],
+      // Subdomains are distinct origins
+      ["https://example.com", "https://www.example.com"],
+      ["https://a.example.com", "https://b.example.com"],
+      // Different port
+      ["http://localhost:3000", "http://localhost:4000"],
+      ["http://localhost:3000", "http://localhost"],
+      // Strict ports: no default-port normalization, an explicit port is
+      // never equal to an omitted one (even if it is the protocol default)
+      ["https://example.com", "https://example.com:443"],
+      ["http://example.com", "http://example.com:80"],
+      ["wss://example.com", "wss://example.com:443"],
+      ["ws://example.com", "ws://example.com:80"],
+      ["//example.com", "//example.com:443"],
+      ["https://example.com:80", "https://example.com"],
+      ["http://example.com:443", "http://example.com"],
+      // Lookalike hosts / userinfo tricks
+      ["https://example.com", "https://example.com.evil.com"],
+      ["https://example.com@evil.com", "https://example.com"],
+      ["https://example.com", "https://evil.com/https://example.com"],
+      // Protocol-relative vs. different host
+      ["//example.com", "//example.org"],
+    ];
+
+    for (const [a, b] of different) {
+      test(`${a} != ${b}`, () => {
+        expect(isSameOrigin(a, b)).toBe(false);
+        // Symmetric
+        expect(isSameOrigin(b, a)).toBe(false);
+      });
+    }
+  });
+
+  describe("relative and origin-less inputs", () => {
+    // Open question: a relative URL has no origin of its own, so we propose
+    // that it is never "same origin" with anything (including another
+    // relative URL), rather than guessing a base.
+    const noOrigin = [
+      ["/a", "/a"],
+      ["a/b", "a/b"],
+      ["", ""],
+      ["/a", "https://example.com/a"],
+      ["https://example.com/a", "/a"],
+      ["?a=1", "?a=1"],
+      ["#hash", "#hash"],
+    ];
+
+    for (const [a, b] of noOrigin) {
+      test(`${JSON.stringify(a)} vs ${JSON.stringify(b)} => false`, () => {
+        expect(isSameOrigin(a, b)).toBe(false);
+      });
+    }
+
+    // Open question: protocol-relative vs absolute. Proposed: false, since
+    // the protocol of the former is unknown.
+    test("protocol-relative vs absolute => false", () => {
+      expect(isSameOrigin("//example.com", "https://example.com")).toBe(false);
+    });
+  });
+
+  describe("opaque origins", () => {
+    // Per the URL spec these have an opaque origin ("null") which is never
+    // same-origin, not even with itself.
+    const opaque = [
+      ["data:text/plain,hello", "data:text/plain,hello"],
+      ["javascript:alert(1)", "javascript:alert(1)"],
+      ["mailto:a@example.com", "mailto:a@example.com"],
+      ["file:///a", "file:///a"],
+    ];
+
+    for (const [a, b] of opaque) {
+      test(`${a} vs ${b} => false`, () => {
+        expect(isSameOrigin(a, b)).toBe(false);
+      });
+    }
+  });
+
+  describe("invalid / empty input", () => {
+    test("undefined and empty inputs are not same origin", () => {
+      expect(isSameOrigin(undefined as any, undefined as any)).toBe(false);
+      expect(isSameOrigin("", "https://example.com")).toBe(false);
+      expect(isSameOrigin("https://example.com", undefined as any)).toBe(false);
+    });
+
+    test("does not throw on malformed URLs", () => {
+      expect(() => isSameOrigin("http://", "http://")).not.toThrow();
+      expect(isSameOrigin("http://", "http://")).toBe(false);
+      expect(isSameOrigin("https://exa mple.com", "https://exa mple.com")).toBe(
+        false,
+      );
+    });
+  });
+});
