@@ -773,3 +777,60 @@ export function withoutHost(input: string) {
   const parsed = parseURL(input);
   return (parsed.pathname || "/") + parsed.search + parsed.hash;
 }
+
+const ORIGIN_RE = /^([a-z][\d+.a-z-]*:)?\/\/([^#/?\\]*)/i;
+
+function _parseOrigin(input: string) {
+  if (typeof input !== "string") {
+    return;
+  }
+  const match = input.trim().match(ORIGIN_RE);
+  if (!match) {
+    return;
+  }
+  const protocol = (match[1] || "").toLowerCase();
+  // Opaque origins are never same-origin
+  if (protocol === "file:") {
+    return;
+  }
+  // Strip userinfo
+  const authority = match[2]!.slice(match[2]!.lastIndexOf("@") + 1);
+  // Port is kept as written (no default-port normalization)
+  const portMatch = authority.match(/:(\d*)$/);
+  const port = portMatch ? portMatch[1]! : "";
+  const rawHost = portMatch ? authority.slice(0, portMatch.index) : authority;
+  if (!rawHost) {
+    return;
+  }
+  let hostname: string;
+  try {
+    hostname = new URL("http://" + rawHost).hostname;
+  } catch {
+    return;
+  }
+  if (!hostname) {
+    return;
+  }
+  return { protocol, hostname, port, hasPort: !!portMatch };
+}
+
+/**
+ * Checks if two URLs have the same origin (protocol, hostname and port).
+ *
+ * - Ports are compared as written (an explicit default port is not equal to an omitted one).
+ * - Relative URLs, opaque origins (`data:`, `file:`, ...) and invalid input are never same-origin.
+ * - Protocol-relative URLs only match other protocol-relative URLs.
+ */
+export function isSameOrigin(a: string, b: string): boolean {
+  const oa = _parseOrigin(a);
+  const ob = _parseOrigin(b);
+  if (!oa || !ob) {
+    return false;
+  }
+  return (
+    oa.protocol === ob.protocol &&
+    oa.hostname === ob.hostname &&
+    oa.hasPort === ob.hasPort &&
+    oa.port === ob.port
+  );
+}
