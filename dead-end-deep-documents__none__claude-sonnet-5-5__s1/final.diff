@@ -558,6 +558,31 @@ def _emit(key, value, content_handler,
             content_handler.ignorableWhitespace(newl)
 
 
+def drop_keys(doc, names):
+    """Return a copy of a parsed document with every key in `names` removed
+    at any depth (attribute keys such as '@id' included).
+
+    `names` is an iterable of keys; a single string is treated as one key.
+    The input is never mutated; non-container values are shared, not copied.
+    """
+    if isinstance(names, str):
+        names = (names,)
+    names = frozenset(names)
+
+    def walk(node):
+        if isinstance(node, dict):
+            new = node.__class__() if type(node) is not dict else {}
+            for k, v in node.items():
+                if k not in names:
+                    new[k] = walk(v)
+            return new
+        if isinstance(node, list):
+            return [walk(v) for v in node]
+        return node
+
+    return walk(doc)
+
+
 class _XMLGenerator(XMLGenerator):
     def comment(self, text):
         text = _validate_comment(text)
