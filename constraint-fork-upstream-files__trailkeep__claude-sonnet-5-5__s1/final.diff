diff --git a/test/dashdash.js b/test/dashdash.js
new file mode 100644
index 0000000..3754a66
--- /dev/null
+++ b/test/dashdash.js
@@ -0,0 +1,35 @@
+const test = require('tape');
+const fn = require('../lib');
+
+test('-- option: collects args after bare --', t => {
+	t.deepEqual(
+		fn(['a', '--foo', 'x', '--', 'b', '--bar', '-c'], { '--': true }),
+		{ _: ['a'], foo: 'x', '--': ['b', '--bar', '-c'] }
+	);
+	t.end();
+});
+
+test('-- option: empty array when no bare --', t => {
+	t.deepEqual(fn(['a', '-x'], { '--': true }), { _: ['a'], x: true, '--': [] });
+	t.deepEqual(fn(['a', '--'], { '--': true }), { _: ['a'], '--': [] });
+	t.end();
+});
+
+test('-- option: unset keeps default behavior', t => {
+	t.deepEqual(fn(['a', '--', 'b']), { _: ['a', 'b'] });
+	t.deepEqual(fn(['a', '--', 'b'], { '--': false }), { _: ['a', 'b'] });
+	t.end();
+});
+
+test('-- option: values after -- are not parsed or coerced', t => {
+	t.deepEqual(fn(['--', '1', '--no-x'], { '--': true }), { _: [], '--': ['1', '--no-x'] });
+	t.end();
+});
+
+test('-- option: works with alias, default and unknown', t => {
+	t.deepEqual(
+		fn(['-f', '1', '--', 'z'], { '--': true, alias: { f: 'foo' }, default: { d: 2 } }),
+		{ _: [], f: 1, foo: 1, d: 2, '--': ['z'] }
+	);
+	t.end();
+});
