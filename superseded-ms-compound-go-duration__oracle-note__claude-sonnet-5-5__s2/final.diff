+/**
+ * Compound short format for `ms`, e.g. `1h30m`. Hours are the largest unit and there are no
+ * separators, so the output is compatible with Go's `time.ParseDuration`.
+ */
+function fmtCompound(ms: number): string {
+  let rest = Math.floor(Math.abs(ms) / s) * s;
+  const parts: string[] = [];
+  for (const [size, name] of [
+    [h, 'h'],
+    [m, 'm'],
+    [s, 's'],
+  ] as const) {
+    const count = Math.floor(rest / size);
+    rest -= count * size;
+    if (count > 0) {
+      parts.push(`${count}${name}`);
+    }
+  }
+  if (parts.length === 0) {
+    return '0s';
+  }
+  return `${ms < 0 ? '-' : ''}${parts.join('')}`;
+}
