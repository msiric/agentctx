+def test_get_default_used_for_missing_key(cli, dotenv_path):
+    dotenv_path.write_text("a=b")
+
+    result = cli.invoke(dotenv_cli, ["--file", dotenv_path, "get", "x", "--default", "d"])
+
+    assert (result.exit_code, result.output) == (0, "d\n")
+
+
+def test_get_default_used_for_key_without_value(cli, dotenv_path):
+    dotenv_path.write_text("a")
+
+    result = cli.invoke(dotenv_cli, ["--file", dotenv_path, "get", "a", "--default", "d"])
+
+    assert (result.exit_code, result.output) == (0, "d\n")
+
+
+def test_get_default_ignored_for_empty_string_value(cli, dotenv_path):
+    dotenv_path.write_text("a=\n")
+
+    result = cli.invoke(dotenv_cli, ["--file", dotenv_path, "get", "a", "--default", "d"])
+
+    assert (result.exit_code, result.output) == (0, "\n")
+
+
+def test_get_default_ignored_for_existing_value(cli, dotenv_path):
+    dotenv_path.write_text("a=b")
+
+    result = cli.invoke(dotenv_cli, ["--file", dotenv_path, "get", "a", "--default", "d"])
+
+    assert (result.exit_code, result.output) == (0, "b\n")
+
+
+def test_get_empty_default_for_missing_key(cli, dotenv_path):
+    dotenv_path.write_text("a=b")
+
+    result = cli.invoke(dotenv_cli, ["--file", dotenv_path, "get", "x", "--default", ""])
+
+    assert (result.exit_code, result.output) == (0, "\n")
+
+
+def test_get_default_does_not_mask_missing_file(cli):
+    result = cli.invoke(dotenv_cli, ["--file", "nx_file", "get", "a", "--default", "d"])
+
+    assert result.exit_code == 2
+
+
