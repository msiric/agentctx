+def test_statement_types():
+    assert sqlparse.statement_types('select 1; insert into t values (1)') \
+        == ['SELECT', 'INSERT']
+    assert sqlparse.statement_types('') == []
+    assert sqlparse.statement_types(
+        'with x as (select 1) delete from t') == ['DELETE']
