@@ -1,3 +1,5 @@
+import warnings
+
 import pytest
 
 import semver
@@ -407,3 +409,22 @@ def test_direct_compare_with_collections():
 def test_direct_compare_with_invalid_type(other):
     with pytest.raises(TypeError):
         Version(1, 0, 0).compare(other)
+
+
+def test_compare_with_dict_is_deprecated():
+    with pytest.warns(DeprecationWarning, match="dict") as record:
+        assert Version(1, 2, 3).compare({"major": 1, "minor": 2, "patch": 3}) == 0
+    assert record[0].filename == __file__
+
+
+@pytest.mark.parametrize("other", ["1.2.3", (1, 2, 3), [1, 2, 3], Version(1, 2, 3)])
+def test_compare_without_dict_does_not_warn(other):
+    with warnings.catch_warnings():
+        warnings.simplefilter("error")
+        assert Version(1, 2, 3).compare(other) == 0
+
+
+def test_comparison_operators_with_dict_do_not_warn():
+    with warnings.catch_warnings():
+        warnings.simplefilter("error")
+        assert Version(1, 2, 3) == {"major": 1, "minor": 2, "patch": 3}
diff --git a/tests/test_pysemver-cli.py b/tests/test_pysemver-cli.py
index 9933b0d..4ee20ef 100644
--- a/tests/test_pysemver-cli.py
+++ b/tests/test_pysemver-cli.py
@@ -4,6 +4,7 @@ from unittest.mock import patch
 
 import pytest
 
+from semver.cli import main as cli_main
 from semver import (
     cmd_bump,
     cmd_check,
@@ -155,3 +156,32 @@ def test_should_return_documented_error_code_for_invalid_version(cliargs, capsys
     # docs/pysemver.rst shows ``echo $?`` printing 2 for both commands
     assert main(cliargs) == 2
     assert capsys.readouterr().err.startswith("ERROR")
+
+
+@pytest.mark.parametrize("prefix", ["v", "V"])
+@pytest.mark.parametrize(
+    "cliargs,expected",
+    [
+        (["bump", "major", "{}1.2.3"], "2.0.0"),
+        (["bump", "minor", "{}1.2.3"], "1.3.0"),
+        (["bump", "patch", "{}1.2.3"], "1.2.4"),
+        (["bump", "prerelease", "{}1.2.3-rc.1"], "1.2.3-rc.2"),
+        (["bump", "build", "{}1.2.3+build.1"], "1.2.3+build.2"),
+        (["nextver", "{}1.4.2", "minor"], "1.5.0"),
+        (["check", "{}1.4.2"], ""),
+        (["compare", "{}1.2.3", "{}2.0.0"], "-1"),
+        (["compare", "{}2.0.0", "1.2.3"], "1"),
+        (["compare", "1.2.3", "{}1.2.3"], "0"),
+    ],
+)
+def test_cli_accepts_leading_v(prefix, cliargs, expected, capsys):
+    cliargs = [a.format(prefix) if "{}" in a else a for a in cliargs]
+    assert cli_main(cliargs) == 0
+    assert capsys.readouterr().out.strip() == expected
+
+
+@pytest.mark.parametrize(
+    "cliargs", [["check", "vv1.2.3"], ["check", "v"], ["compare", "1.2.3", "vv1.2.3"]]
+)
+def test_cli_rejects_other_prefixes(cliargs, capsys):
+    assert cli_main(cliargs) == 2
