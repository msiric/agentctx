@@ -0,0 +1,67 @@
+import copy
+
+from xmltodict import drop_keys, parse
+
+
+def test_removes_keys_and_attributes_at_any_depth():
+    doc = parse('<a id="1"><b id="2" k="v"><c>x</c></b><b id="3"/></a>')
+    assert drop_keys(doc, ['@id']) == {
+        'a': {'b': [{'@k': 'v', 'c': 'x'}, {}]}}
+
+
+def test_removes_element_keys_inside_lists():
+    doc = {'a': [{'x': 1, 'y': 2}, {'x': 3}]}
+    assert drop_keys(doc, {'x'}) == {'a': [{'y': 2}, {}]}
+
+
+def test_does_not_mutate_input():
+    doc = parse('<a id="1"><b id="2">t</b><b id="3">u</b></a>')
+    before = copy.deepcopy(doc)
+    result = drop_keys(doc, ['@id', 'b'])
+    assert doc == before
+    assert result == {'a': {}}
+    assert result['a'] is not doc['a']
+
+
+def test_copy_is_independent_of_input():
+    doc = {'a': {'b': [1, {'c': 2}]}}
+    result = drop_keys(doc, ['zzz'])
+    assert result == doc
+    result['a']['b'][1]['c'] = 99
+    assert doc['a']['b'][1]['c'] == 2
+
+
+def test_prefix_must_match_exactly():
+    doc = {'a': {'@id': '1', 'id': 'e'}}
+    assert drop_keys(doc, ['id']) == {'a': {'@id': '1'}}
+
+
+def test_empty_names_and_non_container_input():
+    doc = {'a': [1, 2]}
+    assert drop_keys(doc, []) == doc
+    assert drop_keys(doc, []) is not doc
+    assert drop_keys('text', ['a']) == 'text'
+    assert drop_keys(None, ['a']) is None
+
+
+def test_preserves_dict_subclass_and_key_order():
+    from collections import OrderedDict
+    doc = OrderedDict([('b', 1), ('a', 2), ('c', 3)])
+    result = drop_keys(doc, ['a'])
+    assert isinstance(result, OrderedDict)
+    assert list(result) == ['b', 'c']
+
+
+def test_very_deep_nesting_does_not_recurse():
+    doc = leaf = {}
+    for _ in range(5000):
+        leaf['@id'] = 'x'
+        leaf['part'] = {}
+        leaf = leaf['part']
+    result = drop_keys(doc, ['@id'])
+    depth = 0
+    while result:
+        assert '@id' not in result
+        result = result['part']
+        depth += 1
+    assert depth == 5000
