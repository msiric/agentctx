@@ -632,6 +632,47 @@ def unparse(input_dict, output=None, encoding='utf-8', full_document=True,
         return value
 
 
+def drop_keys(doc, names):
+    """Return a copy of `doc` with every dict key in `names` removed at any depth.
+
+    Keys are matched exactly, so attribute keys need their prefix (e.g.
+    `'@id'`). Dicts and lists are copied; other values are shared. The input
+    is never mutated. Implemented iteratively so very deeply nested documents
+    do not hit the recursion limit.
+    """
+    names = frozenset(names)
+
+    def shell(value):
+        if isinstance(value, dict):
+            return type(value)() if type(value) is not dict else {}
+        if isinstance(value, list):
+            return []
+        return None
+
+    root = shell(doc)
+    if root is None:
+        return doc
+    stack = [(doc, root)]
+    while stack:
+        src, dst = stack.pop()
+        items = src.items() if isinstance(src, dict) else enumerate(src)
+        for key, value in items:
+            if isinstance(src, dict):
+                if key in names:
+                    continue
+            child = shell(value)
+            if child is None:
+                out = value
+            else:
+                out = child
+                stack.append((value, child))
+            if isinstance(src, dict):
+                dst[key] = out
+            else:
+                dst.append(out)
+    return root
+
+
