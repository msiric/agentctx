@@ -216,3 +216,18 @@ export default function prettyBytes(
 	number: number | bigint,
 	options?: Options
 ): string;
+
+/**
+The reverse of `prettyBytes`: convert a string like `'1.5 KiB'` to a number of bytes (`1536`).
+
+Accepts a plain number (`'512'`), or a number followed by `B` or a unit from `KiB` to `YiB` or `kB`/`KB` to `YB`, with optional whitespace in between. Fractional values and a leading `+` or `-` are allowed. Units are case-sensitive.
+
+All units are powers of 1024, including those without the `i`: `'1 kB'`, `'1 KB'` and `'1 KiB'` are all `1024`, and `'1 MB'` is `1048576`. This matches sizes shown by Windows Explorer, but differs from `prettyBytes`, which uses powers of 1000 for `kB`, `MB`, etc. unless `{binary: true}` is set.
+
+The result is not rounded, so `'0.3 KiB'` is `307.2`.
+
+@param string - The string to parse.
+@returns The number of bytes.
+@throws A `TypeError` if the input is not a string, or a `SyntaxError` if it cannot be parsed or has an unsupported unit.
+*/
+export function parseBytes(string: string): number;
diff --git a/index.js b/index.js
index c5f37ab..6653aff 100644
--- a/index.js
+++ b/index.js
@@ -285,3 +285,35 @@ export default function prettyBytes(number, options) {
 	const result = prefix + numberString + separator + UNITS[exponent];
 	return result.padStart(options.fixedWidth ?? 0);
 }
+
+// Units without the `i` (`kB`, `MB`, ...) are also powers of 1024, matching what Windows Explorer shows.
+const BINARY_MULTIPLIERS = new Map([
+	...BIBYTE_UNITS.map((unit, exponent) => [unit, 1024 ** exponent]),
+	...BYTE_UNITS.slice(1).map((unit, index) => [unit, 1024 ** (index + 1)]),
+	['KB', 1024],
+]);
+
+const PARSE_PATTERN = /^([+-]?)(\d+(?:\.\d+)?|\.\d+)\s*([A-Za-z]*)$/;
+
+export function parseBytes(string) {
+	if (typeof string !== 'string') {
+		throw new TypeError(`Expected a string, got ${typeof string}: ${string}`);
+	}
+
+	const match = PARSE_PATTERN.exec(string.trim());
+
+	if (!match) {
+		throw new SyntaxError(`Unable to parse bytes from ${JSON.stringify(string)}`);
+	}
+
+	const [, sign, digits, unit] = match;
+	// No unit means bytes.
+	const multiplier = unit === '' ? 1 : BINARY_MULTIPLIERS.get(unit);
+
+	if (multiplier === undefined) {
+		throw new SyntaxError(`Unsupported unit ${JSON.stringify(unit)} in ${JSON.stringify(string)}, expected one of: ${[...BINARY_MULTIPLIERS.keys()].join(', ')}`);
+	}
+
+	const result = Number(digits) * multiplier;
+	return sign === '-' && result !== 0 ? -result : result;
+}
