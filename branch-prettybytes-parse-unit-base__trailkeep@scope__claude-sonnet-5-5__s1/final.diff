+
+test('parseBytes: plain numbers and bytes', t => {
+	t.is(parseBytes('512'), 512);
+	t.is(parseBytes('512 B'), 512);
+	t.is(parseBytes('512B'), 512);
+	t.is(parseBytes('  512   B  '), 512);
+	t.is(parseBytes('0'), 0);
+	t.is(parseBytes('1.5'), 1.5);
+	t.is(parseBytes('.5 KiB'), 512);
+	t.is(parseBytes('+10 B'), 10);
+	t.is(parseBytes('-10 B'), -10);
+	t.is(parseBytes('-0'), 0);
+});
+
+test('parseBytes: binary units', t => {
+	for (const [exponent, unit] of BINARY_UNITS.entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1024 ** exponent);
+		t.is(parseBytes(`2${unit}`), 2 * (1024 ** exponent));
+	}
+
+	t.is(parseBytes('1.5 KiB'), 1536);
+	t.is(parseBytes('0.25 MiB'), 262_144);
+	t.is(parseBytes('1 YiB'), 2 ** 80);
+});
+
+test('parseBytes: round-trips prettyBytes binary output', t => {
+	for (const value of [0, 1, 512, 1024, 1536, 10_240, 1024 ** 3, 1.5 * (1024 ** 4)]) {
+		t.is(parseBytes(prettyBytes(value, {binary: true})), value);
+		t.is(parseBytes(prettyBytes(value, {binary: true, space: false})), value);
+		t.is(parseBytes(prettyBytes(value, {binary: true, nonBreakingSpace: true})), value);
+	}
+});
+
+test('parseBytes: units are case-sensitive', t => {
+	for (const input of ['1 kib', '1 KIB', '1 kiB', '1 mib', '1 b', '1 Kib']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError}, `${input}`);
+	}
+});
+
+test('parseBytes: units without the i are powers of 1024', t => {
+	t.is(parseBytes('1 kB'), 1024);
+	t.is(parseBytes('1 KB'), 1024);
+	t.is(parseBytes('1 MB'), 1_048_576);
+	t.is(parseBytes('1.5 GB'), 1.5 * (1024 ** 3));
+	t.is(parseBytes('2TB'), 2 * (1024 ** 4));
+	t.is(parseBytes('1 PB'), 1024 ** 5);
+	t.is(parseBytes('1 EB'), 1024 ** 6);
+	t.is(parseBytes('1 ZB'), 1024 ** 7);
+	t.is(parseBytes('1 YB'), 1024 ** 8);
+});
+
+test('parseBytes: invalid non-i units', t => {
+	for (const input of ['1 K', '1 Ki', '1 kb', '1 mb', '1 Mb', '1 gB', '1 KIB']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError}, `${input}`);
+	}
+});
+
+test('parseBytes: throws on invalid input', t => {
+	for (const input of ['', ' ', 'KiB', 'abc', '1..5', '1.', '1,5 KiB', '1e3', '0x10', '1 2 KiB', '1 KiB B', '--1', 'Infinity', 'NaN']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError}, `${input}`);
+	}
+
+	for (const input of [1, undefined, null, {}, 1n]) {
+		t.throws(() => parseBytes(input), {instanceOf: TypeError});
+	}
+});
