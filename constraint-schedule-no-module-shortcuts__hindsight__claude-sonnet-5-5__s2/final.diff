+    def pause(self, tag: Hashable) -> None:
+        """
+        Pause all jobs marked with the given tag. Paused jobs are skipped
+        by :meth:`run_pending` until :meth:`resume` is called. Jobs stay
+        scheduled, so nothing needs to be re-added afterwards.
+
+        Note that :meth:`run_all` ignores the paused state.
+
+        :param tag: An identifier used to identify a subset of
+                    jobs to pause
+        """
+        logger.debug('Pausing all jobs tagged "%s"', tag)
+        for job in self.get_jobs(tag):
+            job.paused = True
+
+    def resume(self, tag: Hashable) -> None:
+        """
+        Resume all paused jobs marked with the given tag. A job whose
+        scheduled time passed while it was paused runs once on the next
+        :meth:`run_pending`; missed runs are not repeated.
+
+        :param tag: An identifier used to identify a subset of
+                    jobs to resume
+        """
+        logger.debug('Resuming all jobs tagged "%s"', tag)
+        for job in self.get_jobs(tag):
+            job.paused = False
+
