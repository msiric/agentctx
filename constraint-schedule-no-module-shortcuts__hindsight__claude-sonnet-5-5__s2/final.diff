@@ -1569,6 +1569,64 @@ class SchedulerTests(TestCase):
         schedule.clear()
         assert len(schedule.jobs) == 0
 
+    def test_get_jobs_for(self):
+        mock_job = make_mock_job()
+
+        def other():
+            pass
+
+        job1 = every().second.do(mock_job)
+        job2 = every().minute.do(mock_job, 1, key="x")
+        job3 = every().second.do(other)
+
+        assert schedule.default_scheduler.get_jobs_for(mock_job) == [job1, job2]
+        assert schedule.default_scheduler.get_jobs_for(other) == [job3]
+        assert schedule.default_scheduler.get_jobs_for(lambda: None) == []
+
+        schedule.cancel_job(job1)
+        assert schedule.default_scheduler.get_jobs_for(mock_job) == [job2]
+
+        s = schedule.Scheduler()
+        assert s.get_jobs_for(mock_job) == []
+        schedule.clear()
+
+    def test_pause_and_resume_by_tag(self):
+        with mock_datetime(2010, 1, 6, 12, 15, 0):
+            paused_job = make_mock_job(name="paused")
+            other_job = make_mock_job(name="other")
+            every().second.do(paused_job).tag("maintenance")
+            every().second.do(other_job).tag("other")
+
+            schedule.pause("maintenance")
+            assert len(schedule.get_jobs()) == 2
+        with mock_datetime(2010, 1, 6, 12, 15, 2):
+            schedule.run_pending()
+            assert paused_job.call_count == 0
+            assert other_job.call_count == 1
+
+        with mock_datetime(2010, 1, 6, 12, 15, 4):
+            schedule.run_pending()
+            assert paused_job.call_count == 0
+            assert other_job.call_count == 2
+
+            schedule.resume("maintenance")
+            schedule.run_pending()
+            assert paused_job.call_count == 1
+            assert other_job.call_count == 2
+        schedule.clear()
+
+    def test_pause_unknown_tag_and_untagged_jobs(self):
+        job = make_mock_job()
+        with mock_datetime(2010, 1, 6, 12, 15, 0):
+            every().second.do(job)
+        schedule.pause("nope")
+        schedule.resume("nope")
+        assert not schedule.get_jobs()[0].paused
+        with mock_datetime(2010, 1, 6, 12, 15, 2):
+            schedule.run_pending()
+        assert job.call_count == 1
+        schedule.clear()
+
