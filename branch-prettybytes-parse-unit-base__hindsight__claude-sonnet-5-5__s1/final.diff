+
+test('parseBytes: plain numbers and bytes', t => {
+	t.is(parseBytes('0'), 0);
+	t.is(parseBytes('512'), 512);
+	t.is(parseBytes('512 B'), 512);
+	t.is(parseBytes('512B'), 512);
+	t.is(parseBytes('  512  '), 512);
+	t.is(parseBytes('1.5'), 1.5);
+	t.is(parseBytes('.5 B'), 0.5);
+	t.is(parseBytes('+42'), 42);
+	t.is(parseBytes('-42 B'), -42);
+	t.is(parseBytes('-0'), 0);
+});
+
+test('parseBytes: binary units', t => {
+	for (const [exponent, unit] of BINARY_UNITS.entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1024 ** exponent);
+		t.is(parseBytes(`2${unit}`), 2 * (1024 ** exponent));
+		t.is(parseBytes(`1\u00A0${unit}`), 1024 ** exponent);
+	}
+
+	t.is(parseBytes('1.5 KiB'), 1536);
+	t.is(parseBytes('0.5 MiB'), 524_288);
+	t.is(parseBytes('-1.5 KiB'), -1536);
+});
+
+test('parseBytes: reads back prettyBytes binary output', t => {
+	for (const value of [0, 1, 512, 1024, 1536, 1_048_576, 5 * (1024 ** 3), 1024 ** 8]) {
+		t.is(parseBytes(prettyBytes(value, {binary: true})), value);
+		t.is(parseBytes(prettyBytes(value, {binary: true, space: false})), value);
+		t.is(parseBytes(prettyBytes(value, {binary: true, nonBreakingSpace: true})), value);
+	}
+});
+
+test('parseBytes: units are case-sensitive', t => {
+	for (const input of ['1 kib', '1 KIB', '1 kiB', '1 mib', '1 b', '1 Kib']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError}, `Input: ${input}`);
+	}
+});
+
+test('parseBytes: SI units', t => {
+	for (const [exponent, unit] of ['B', 'kB', 'MB', 'GB', 'TB', 'PB', 'EB', 'ZB', 'YB'].entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1000 ** exponent);
+		t.is(parseBytes(`2${unit}`), 2 * (1000 ** exponent));
+	}
+
+	t.is(parseBytes('1 KB'), 1000);
+	t.is(parseBytes('1.5 kB'), 1500);
+	t.is(parseBytes('-1.5 MB'), -1_500_000);
+});
+
+test('parseBytes: reads back prettyBytes default output', t => {
+	for (const value of [0, 1, 999, 1000, 1500, 1_000_000, 2_500_000_000]) {
+		t.is(parseBytes(prettyBytes(value)), value);
+	}
+});
+
+test('parseBytes: rejects unknown units', t => {
+	for (const input of ['1 K', '1 Ki', '1 Kb', '1 mB', '1 gB', '1 foo']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError, message: /Unsupported unit/}, `Input: ${input}`);
+	}
+});
+
+test('parseBytes: rejects malformed input', t => {
+	for (const input of ['', ' ', 'KiB', 'abc', '1 2 KiB', '1..5', '1.', '1,5 KiB', '1e3', '--1', '1 KiB KiB', 'Infinity', 'NaN', '0x10']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError}, `Input: ${input}`);
+	}
+});
+
+test('parseBytes: rejects non-strings', t => {
+	for (const input of [512, undefined, null, {}, 10n]) {
+		t.throws(() => parseBytes(input), {instanceOf: TypeError});
+	}
+});
