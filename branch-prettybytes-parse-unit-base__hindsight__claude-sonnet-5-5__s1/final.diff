+
+/**
+Convert a human readable size string to a number of bytes, the reverse of `prettyBytes`.
+
+Supports plain numbers (`'512'`), `B`, the binary units `KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`, `ZiB`, and `YiB` (base 1024), and the SI units `kB`, `MB`, `GB`, `TB`, `PB`, `EB`, `ZB`, and `YB` (base 1000). `KB` is accepted as an alias for `kB`. Fractional values are allowed. Units are case-sensitive. A space between the number and the unit is optional, and a leading `+` or `-` is accepted.
+
+@param string - The string to parse.
+@returns The number of bytes. Fractional results are not rounded.
+@throws {TypeError} If the input is not a string.
+@throws {SyntaxError} If the string is malformed or uses an unsupported unit.
+
+@example
+```
+import {parseBytes} from 'pretty-bytes';
+
+parseBytes('512');
+//=> 512
+
+parseBytes('1.5 KiB');
+//=> 1536
+
+parseBytes('1.5 kB');
+//=> 1500
+```
+*/
+export function parseBytes(string: string): number;
diff --git a/index.js b/index.js
index c5f37ab..0de3c02 100644
--- a/index.js
+++ b/index.js
@@ -285,3 +285,35 @@ export default function prettyBytes(number, options) {
 	const result = prefix + numberString + separator + UNITS[exponent];
 	return result.padStart(options.fixedWidth ?? 0);
 }
+
+// Reads back the units `prettyBytes` writes: binary (`KiB`) is base 1024, SI (`kB`) is base 1000. `KB` is also accepted as an alias for `kB`. Matching is case-sensitive, like the output.
+const PARSE_UNITS = new Map([
+	...BIBYTE_UNITS.map((unit, exponent) => [unit, 1024 ** exponent]),
+	...BYTE_UNITS.map((unit, exponent) => [unit, 1000 ** exponent]),
+	['KB', 1000],
+]);
+
+const BYTES_PATTERN = /^(?<sign>[+-])?(?<number>\d+(?:\.\d+)?|\.\d+)[\s\u00A0]*(?<unit>[A-Za-z]+)?$/;
+
+export function parseBytes(string) {
+	if (typeof string !== 'string') {
+		throw new TypeError(`Expected a string, got ${typeof string}: ${string}`);
+	}
+
+	const match = BYTES_PATTERN.exec(string.trim());
+
+	if (!match) {
+		throw new SyntaxError(`Cannot parse bytes from ${JSON.stringify(string)}`);
+	}
+
+	const {sign, number, unit = 'B'} = match.groups;
+	const multiplier = PARSE_UNITS.get(unit);
+
+	if (multiplier === undefined) {
+		throw new SyntaxError(`Unsupported unit ${JSON.stringify(unit)} in ${JSON.stringify(string)}, expected one of: ${[...PARSE_UNITS.keys()].join(', ')}`);
+	}
+
+	const result = Number(number) * multiplier;
+
+	return sign === '-' && result !== 0 ? -result : result;
+}
