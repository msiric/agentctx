diff --git a/index.d.ts b/index.d.ts
index 4fac6e9..9e7276e 100644
--- a/index.d.ts
+++ b/index.d.ts
@@ -216,3 +216,28 @@ export default function prettyBytes(
 	number: number | bigint,
 	options?: Options
 ): string;
+
+/**
+Convert a human readable byte string to a number of bytes: `1.5 KiB` → `1536`. The reverse of `prettyBytes`.
+
+Supports plain numbers, the binary units `B`, `KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`, `ZiB`, and `YiB`, and the units without the `i`: `kB` (or `KB`), `MB`, `GB`, `TB`, `PB`, `EB`, `ZB`, and `YB`. Units are case-sensitive, a fraction is allowed, and the space before the unit is optional. A number without a unit is read as bytes.
+
+Units without the `i` are read as powers of 1024, not 1000, because that is how sizes in tools like Windows Explorer are written: `'1 KB'` is `1024` and `'1 MB'` is `1048576`. This differs from `prettyBytes`, which uses powers of 1000 for these units unless `binary` is set.
+
+The result is not rounded, so `'1.5 B'` is `1.5`. Above `Number.MAX_SAFE_INTEGER` bytes the result may not be exact.
+
+@param string - The string to parse.
+@throws A `TypeError` if the input is not a string, and a `SyntaxError` if it is not a valid byte string or uses an unsupported unit.
+
+@example
+```
+import {parseBytes} from 'pretty-bytes';
+
+parseBytes('512');
+//=> 512
+
+parseBytes('1.5 KiB');
+//=> 1536
+```
+*/
+export function parseBytes(string: string): number;
diff --git a/index.js b/index.js
index c5f37ab..f395748 100644
--- a/index.js
+++ b/index.js
@@ -285,3 +285,39 @@ export default function prettyBytes(number, options) {
 	const result = prefix + numberString + separator + UNITS[exponent];
 	return result.padStart(options.fixedWidth ?? 0);
 }
+
+// Units without the `i` (`kB`, `KB`, `MB` …) are read as powers of 1024, not 1000, because that is what Windows Explorer and similar tools show and what users paste in.
+const PARSE_UNITS = new Map([
+	...BIBYTE_UNITS.map((unit, index) => [unit, 1024 ** index]),
+	...BYTE_UNITS.map((unit, index) => [unit, 1024 ** index]),
+	['KB', 1024],
+]);
+
+// Optional sign, a decimal number with an optional fraction, then an optional unit separated by optional (non-breaking) whitespace.
+const PARSE_PATTERN = /^(?<sign>[+-]?)(?<number>(?:\d+(?:\.\d*)?|\.\d+))(?:\s*(?<unit>[A-Za-z]+))?$/;
+
+/*
+The reverse of `prettyBytes` for plain numbers, the binary units (`B`, `KiB` … `YiB`), and the units without the `i` (`kB`/`KB`, `MB` … `YB`), which are read as powers of 1024. Units are case-sensitive.
+*/
+export function parseBytes(string) {
+	if (typeof string !== 'string') {
+		throw new TypeError(`Expected a string, got ${typeof string}: ${string}`);
+	}
+
+	const match = PARSE_PATTERN.exec(string.trim());
+
+	if (!match) {
+		throw new SyntaxError(`Invalid byte string: ${JSON.stringify(string)}`);
+	}
+
+	const {sign, number, unit = 'B'} = match.groups;
+	const multiplier = PARSE_UNITS.get(unit);
+
+	if (multiplier === undefined) {
+		throw new SyntaxError(`Unsupported unit ${JSON.stringify(unit)} in ${JSON.stringify(string)}, expected one of: ${[...PARSE_UNITS.keys()].join(', ')}`);
+	}
+
+	const result = Number(number) * multiplier;
+
+	return sign === '-' && result !== 0 ? -result : result;
+}
