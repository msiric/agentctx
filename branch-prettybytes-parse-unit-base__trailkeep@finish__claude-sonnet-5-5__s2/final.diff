+
+test('parseBytes() - plain numbers', t => {
+	t.is(parseBytes('512'), 512);
+	t.is(parseBytes('512 B'), 512);
+	t.is(parseBytes('512B'), 512);
+	t.is(parseBytes('0'), 0);
+	t.is(parseBytes('1.5'), 1.5);
+	t.is(parseBytes('.5 B'), 0.5);
+	t.is(parseBytes('  512 B  '), 512);
+	t.is(parseBytes('512\u00A0B'), 512);
+	t.is(parseBytes('512 B'), 512);
+});
+
+test('parseBytes() - binary units', t => {
+	for (const [index, unit] of BINARY_UNITS.entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1024 ** index);
+		t.is(parseBytes(`2${unit}`), 2 * (1024 ** index));
+	}
+
+	t.is(parseBytes('1.5 KiB'), 1536);
+	t.is(parseBytes('0.5 MiB'), 524_288);
+});
+
+test('parseBytes() - signs', t => {
+	t.is(parseBytes('+1 KiB'), 1024);
+	t.is(parseBytes('-1 KiB'), -1024);
+	t.is(parseBytes('-0'), 0);
+	t.true(Object.is(parseBytes('-0 B'), 0));
+});
+
+test('parseBytes() - round trips prettyBytes in binary mode', t => {
+	for (const bytes of [0, 1, 512, 1024, 1536, 1024 ** 3, 5 * (1024 ** 4)]) {
+		t.is(parseBytes(prettyBytes(bytes, {binary: true})), bytes);
+	}
+});
+
+test('parseBytes() - units are case-sensitive', t => {
+	for (const unit of ['kib', 'KIB', 'kiB', 'b', 'mib', 'Mb', 'mB']) {
+		t.throws(() => parseBytes(`1 ${unit}`), {instanceOf: SyntaxError});
+	}
+});
+
+test('parseBytes() - units without the i are powers of 1024', t => {
+	for (const [index, unit] of DECIMAL_UNITS.entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1024 ** index);
+		t.is(parseBytes(`2${unit}`), 2 * (1024 ** index));
+	}
+
+	t.is(parseBytes('1 KB'), 1024);
+	t.is(parseBytes('1.5 MB'), 1_572_864);
+});
+
+test('parseBytes() - bit and unknown units are not supported', t => {
+	for (const unit of [...BIT_UNITS, 'K', 'Ki', 'kb', 'mb', 'Kb', 'gB']) {
+		t.throws(() => parseBytes(`1 ${unit}`), {instanceOf: SyntaxError, message: /Unsupported unit/});
+	}
+});
+
+test('parseBytes() - invalid input', t => {
+	for (const string of ['', ' ', 'KiB', 'abc', '1..5 B', '1.5.2 B', '1 2 KiB', '1e3', '--1', '1 KiB B', 'Infinity', 'NaN', '0x10']) {
+		t.throws(() => parseBytes(string), {instanceOf: SyntaxError});
+	}
+
+	for (const value of [1, undefined, null, {}, 10n]) {
