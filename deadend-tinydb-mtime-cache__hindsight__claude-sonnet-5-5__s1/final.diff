--- a/tests/test_storages.py
+++ b/tests/test_storages.py
@@ -285,3 +285,28 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def test_json_read_cache_sees_external_changes(tmpdir):
+    import json as _json
+    path = str(tmpdir.join('db.json'))
+    storage = JSONStorage(path)
+    storage.write({'_default': {'1': {'a': 1}}})
+
+    calls = []
+    real_load = _json.load
+    _json.load = lambda *a, **k: (calls.append(1), real_load(*a, **k))[1]
+    try:
+        assert storage.read() == {'_default': {'1': {'a': 1}}}
+        assert storage.read() == {'_default': {'1': {'a': 1}}}
+        assert not calls  # served from cache, no re-parse
+
+        # Another process rewrites the file (different size)
+        with open(path, 'w') as f:
+            _json.dump({'_default': {'1': {'a': 1}, '2': {'a': 22}}}, f)
+
+        assert '2' in storage.read()['_default']
+        assert len(calls) == 1
+    finally:
+        _json.load = real_load
+        storage.close()
