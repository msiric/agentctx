+"""
+Benchmark TinyDB read performance on a large JSON database.
+
+Usage: python scripts/bench_read.py [target_mb] [repeats]
+
+Generates a db of roughly ``target_mb`` MB in a temp dir, then times:
+  * raw json.load of the file (the floor for any JSONStorage read)
+  * JSONStorage.read()
+  * db.all()
+  * db.search() with a fresh query each time (bypasses the query cache)
+  * db.search() with the same query repeated (served from the query cache)
+and a cProfile breakdown of one uncached search.
+"""
+
+import cProfile
+import json
+import os
+import pstats
+import random
+import sys
+import tempfile
+import time
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))
+
+from tinydb import TinyDB, where  # noqa: E402
+
+
+def make_db(path, target_mb):
+    rng = random.Random(0)
+    db = TinyDB(path)
+    batch, n = [], 0
+    while os.path.getsize(path) < target_mb * 1024 * 1024:
+        # Build a batch in memory and insert once: insert_multiple does a
+        # single read+write, so generation stays fast.
+        batch = [{
+            'id': n + i,
+            'name': 'user%d' % rng.randrange(10**6),
+            'age': rng.randrange(100),
+            'tags': [rng.choice('abcdefgh') for _ in range(5)],
+            'bio': ''.join(rng.choice('abcdefghij ') for _ in range(100)),
+        } for i in range(20000)]
+        db.insert_multiple(batch)
+        n += len(batch)
+    db.close()
+    return n
+
+
+def timeit(fn, repeats):
+    times = []
+    for _ in range(repeats):
+        t = time.perf_counter()
+        fn()
+        times.append(time.perf_counter() - t)
+    return min(times), sum(times) / len(times)
+
+
+def report(label, fn, repeats):
+    best, avg = timeit(fn, repeats)
+    print('%-34s best %8.1f ms   avg %8.1f ms' % (label, best * 1e3, avg * 1e3))
+
+
+def main():
+    target_mb = float(sys.argv[1]) if len(sys.argv) > 1 else 40
+    repeats = int(sys.argv[2]) if len(sys.argv) > 2 else 5
+
+    with tempfile.TemporaryDirectory() as tmp:
+        path = os.path.join(tmp, 'big.json')
+        print('Generating ~%g MB db...' % target_mb)
+        t = time.perf_counter()
+        n = make_db(path, target_mb)
+        print('  %d docs, %.1f MB, %.1fs\n' % (
+            n, os.path.getsize(path) / 1e6, time.perf_counter() - t))
+
+        db = TinyDB(path)
+        storage = db.storage
+
+        def raw_json_load():
+            with open(path) as f:
+                json.load(f)
+
+        report('raw json.load(file)', raw_json_load, repeats)
+        report('JSONStorage.read()', storage.read, repeats)
+        report('db.all()', db.all, repeats)
+
+        counter = iter(range(10**9))
+        report('db.search() uncached (new query)',
+               lambda: db.search(where('age') == next(counter) + 1000),
+               repeats)
+
+        q = where('age') == 42
+        db.search(q)  # prime the cache
+        report('db.search() cached (same query)', lambda: db.search(q), repeats)
+
+        print('\ncProfile of one uncached search (top 8 by cumulative time):')
+        prof = cProfile.Profile()
+        prof.enable()
+        db.search(where('name') == 'nobody')
+        prof.disable()
+        pstats.Stats(prof).sort_stats('cumulative').print_stats(8)
+        db.close()
+
+
+if __name__ == '__main__':
+    main()
