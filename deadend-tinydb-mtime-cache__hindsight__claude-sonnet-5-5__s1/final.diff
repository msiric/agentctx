new file mode 100644
index 0000000..30a91da
--- /dev/null
+++ b/scripts/bench_read.py
@@ -0,0 +1,83 @@
+"""Benchmark TinyDB read paths on a large JSON db.
+
+Usage: python scripts/bench_read.py [--mb 40] [--repeat 5] [--keep]
+"""
+import argparse
+import cProfile
+import json
+import os
+import pstats
+import random
+import sys
+import tempfile
+import time
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))
+
+from tinydb import TinyDB, where  # noqa: E402
+from tinydb.storages import JSONStorage  # noqa: E402
+
+
+def generate(path, target_mb):
+    rnd = random.Random(0)
+    docs, size, i = {}, 0, 0
+    while size < target_mb * 1024 * 1024:
+        i += 1
+        doc = {'id': i, 'name': 'user%d' % i, 'age': rnd.randint(18, 90),
+               'tags': [rnd.choice('abcdefgh') * 5 for _ in range(5)],
+               'bio': ''.join(rnd.choices('abcdefghij ', k=200))}
+        docs[str(i)] = doc
+        size += 330
+    with open(path, 'w') as f:
+        json.dump({'_default': docs}, f)
+    return len(docs)
+
+
+def timeit(label, fn, repeat):
+    times = []
+    for _ in range(repeat):
+        t = time.perf_counter()
+        fn()
+        times.append(time.perf_counter() - t)
+    print('%-34s min %7.1f ms  median %7.1f ms' % (
+        label, min(times) * 1e3, sorted(times)[len(times) // 2] * 1e3))
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--mb', type=float, default=40)
+    ap.add_argument('--repeat', type=int, default=5)
+    ap.add_argument('--keep', action='store_true')
+    a = ap.parse_args()
+
+    path = os.path.join(tempfile.mkdtemp(), 'big.json')
+    n = generate(path, a.mb)
+    print('db: %d docs, %.1f MB' % (n, os.path.getsize(path) / 2**20))
+
+    db = TinyDB(path)
+    st = db.storage
+    counter = iter(range(10**9))
+
+    timeit('raw json.load of file', lambda: json.load(open(path)), a.repeat)
+    timeit('storage.read()', st.read, a.repeat)
+    timeit('db.all()', db.all, a.repeat)
+    timeit('db.search (uncached, new query)',
+           lambda: db.search(where('age') > 18 + next(counter) % 70), a.repeat)
+    same = where('age') > 50
+    db.search(same)
+    timeit('db.search (cache hit)', lambda: db.search(same), a.repeat)
+
+    print('\nprofile of one uncached search:')
+    pr = cProfile.Profile()
+    pr.enable()
+    db.search(where('name') == 'user%d' % (next(counter) + 1))
+    pr.disable()
+    pstats.Stats(pr).sort_stats('cumulative').print_stats(8)
+
+    db.close()
+    if not a.keep:
+        os.remove(path)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tests/test_storages.py b/tests/test_storages.py
index 6e433a1..7ecd85e 100644
--- a/tests/test_storages.py
+++ b/tests/test_storages.py
@@ -285,3 +285,44 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def test_json_read_cache_sees_external_writes(tmpdir):
+    import json as _json
+    import os as _os
+    path = str(tmpdir.join('db.json'))
+    storage = JSONStorage(path)
+    storage._CACHE_MIN_AGE_NS = 0  # trust the cache immediately
+
+    storage.write({'_default': {'1': {'a': 1}}})
+    first = storage.read()
+    assert storage.read() is first  # unchanged file: no re-parse
+    version = storage.version
+
+    # An external process rewrites the file (same size, so only the
+    # timestamps differ)
+    with open(path, 'w') as f:
+        _json.dump({'_default': {'1': {'a': 2}}}, f)
+    _os.utime(path, ns=(1, 1))
+
+    assert storage.read() == {'_default': {'1': {'a': 2}}}
+    assert storage.version == version + 1
+    storage.close()
+
+
+def test_tinydb_search_sees_external_writes(tmpdir):
+    import json as _json
+    import os as _os
+    from tinydb import where
+    path = str(tmpdir.join('db.json'))
+    db = TinyDB(path)
+    db.storage._CACHE_MIN_AGE_NS = 0
+    db.insert({'a': 1})
+    assert len(db.search(where('a') == 1)) == 1
+    assert len(db.search(where('a') == 1)) == 1  # cached
+
+    with open(path, 'w') as f:
+        _json.dump({'_default': {'1': {'a': 1}, '2': {'a': 1}}}, f)
+    _os.utime(path, ns=(1, 1))
+    assert len(db.search(where('a') == 1)) == 2
+    db.close()
