diff --git a/tests/test_pysemver-cli.py b/tests/test_pysemver-cli.py
index 9933b0d..57dd450 100644
--- a/tests/test_pysemver-cli.py
+++ b/tests/test_pysemver-cli.py
@@ -4,6 +4,7 @@ from unittest.mock import patch
 
 import pytest
 
+from semver.cli import main as cli_main
 from semver import (
     cmd_bump,
     cmd_check,
@@ -155,3 +156,38 @@ def test_should_return_documented_error_code_for_invalid_version(cliargs, capsys
     # docs/pysemver.rst shows ``echo $?`` printing 2 for both commands
     assert main(cliargs) == 2
     assert capsys.readouterr().err.startswith("ERROR")
+
+
+@pytest.mark.parametrize(
+    "cli,expected",
+    [
+        (["bump", "major", "v1.2.3"], "2.0.0"),
+        (["bump", "minor", "V1.2.3"], "1.3.0"),
+        (["bump", "patch", "v1.2.3"], "1.2.4"),
+        (["bump", "prerelease", "v1.2.3-rc1"], "1.2.3-rc1.0"),
+        (["bump", "build", "V1.2.3+build.1"], "1.2.3+build.2"),
+        (["compare", "v1.2.3", "V2.1.3"], "-1"),
+        (["compare", "v1.2.3", "1.2.3"], "0"),
+        (["compare", "2.0.0", "v1.2.3"], "1"),
+        (["nextver", "v1.2.3", "minor"], "1.3.0"),
+        (["check", "v1.2.3"], ""),
+    ],
+)
+def test_should_accept_leading_v(cli, expected, capsys):
+    assert cli_main(cli) == 0
+    assert capsys.readouterr().out.strip() == expected
+
+
+@pytest.mark.parametrize(
+    "cli",
+    [
+        ["check", "vv1.2.3"],
+        ["check", "v"],
+        ["bump", "major", "vv1.2.3"],
+        ["compare", "1.2.3", "vv1.2.3"],
+        ["nextver", "vv1.2.3", "major"],
+    ],
+)
+def test_should_reject_invalid_leading_v(cli, capsys):
+    assert cli_main(cli) == 2
+    assert "ERROR" in capsys.readouterr().err
