 import datetime
 import functools
+import logging
 from unittest import mock, TestCase
 import os
 import time
@@ -94,6 +95,41 @@ class mock_datetime:
 
 
 class SchedulerTests(TestCase):
+    def test_failing_job_is_logged_and_rescheduled(self):
+        def failing():
+            raise ValueError("boom")
+
+        with mock_datetime(2024, 1, 1, 12, 0, 0):
+            job = every().second.do(failing)
+            job_repr = repr(job)
+            with mock_datetime(2024, 1, 1, 12, 0, 5):
+                with self.assertLogs("schedule", level="WARNING") as cm:
+                    schedule.run_pending()
+                assert job.next_run == datetime.datetime(2024, 1, 1, 12, 0, 6)
+                assert job in schedule.jobs
+        output = "\n".join(cm.output)
+        self.assertIn(job_repr, output)
+        self.assertIn("Traceback", output)
+        self.assertIn("boom", output)
+        assert all(r.levelno <= logging.WARNING for r in cm.records)
+        schedule.clear()
+
+    def test_failing_job_does_not_stop_other_jobs(self):
+        calls = []
+
+        def failing():
+            raise ValueError("boom")
+
+        with mock_datetime(2024, 1, 1, 12, 0, 0):
+            every().second.do(failing)
+            every().second.do(lambda: calls.append("a"))
+            every().second.do(lambda: calls.append("b"))
+            with mock_datetime(2024, 1, 1, 12, 0, 5):
+                with self.assertLogs("schedule", level="WARNING"):
+                    schedule.run_pending()
+        assert sorted(calls) == ["a", "b"]
+        schedule.clear()
+
     def setUp(self):
         schedule.clear()
 
