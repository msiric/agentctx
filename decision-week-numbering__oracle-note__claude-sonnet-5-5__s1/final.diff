diff --git a/test/index.js b/test/index.js
index 7ac0525..4c72980 100644
--- a/test/index.js
+++ b/test/index.js
@@ -28,6 +28,29 @@ test('rendering', t => {
 	t.is(render('{fff}'), '000', 'returns milliseconds (default 000)');
 	t.is(render('{fff}', new Date(1559607289771)), '771', 'returns milliseconds');
 
+	// day of year
+	t.is(render('{DDD}', new Date(2017, 0, 1)), '001', 'returns day of year (first day, padded)');
+	t.is(render('{DDD}'), '121', 'returns day of year');
+	t.is(render('{DDD}', new Date(2017, 11, 31)), '365', 'returns day of year (last day, non-leap)');
+	t.is(render('{DDD}', new Date(2016, 11, 31)), '366', 'returns day of year (last day, leap)');
+	t.is(render('{DDD}', new Date(2016, 1, 29)), '060', 'returns day of year (leap day)');
+	t.is(render('{DDD}', new Date(2017, 2, 1)), '060', 'returns day of year (Mar 1, non-leap)');
+	t.is(render('{DDD}', new Date(2017, 2, 12, 12)), '071', 'returns day of year (across US DST start)');
+	t.is(render('{DDD}', new Date(2017, 10, 6, 0, 30)), '310', 'returns day of year (across US DST end)');
+	t.is(render('{DDD}', new Date(2017, 11, 31, 23, 59, 59, 999)), '365', 'ignores time of day');
+
+	// week of year (Excel WEEKNUM(date, 2))
+	t.is(render('{WW}'), '19', 'returns week of year');
+	t.is(render('{WW}', new Date(2023, 0, 1)), '01', 'Sunday Jan 1 is week 01');
+	t.is(render('{WW}', new Date(2023, 0, 2)), '02', 'first Monday after Sunday Jan 1 starts week 02');
+	t.is(render('{WW}', new Date(2021, 0, 3)), '01', 'Sunday ends week 01 (Jan 1 is Friday)');
+	t.is(render('{WW}', new Date(2021, 0, 4)), '02', 'Monday starts new week');
+	t.is(render('{WW}', new Date(2018, 0, 1)), '01', 'Jan 1 on Monday is week 01');
+	t.is(render('{WW}', new Date(2018, 0, 7)), '01', 'Sunday after Monday Jan 1 is week 01');
+	t.is(render('{WW}', new Date(2018, 0, 8)), '02', 'second Monday is week 02');
+	t.is(render('{WW}', new Date(2012, 11, 31)), '54', 'returns week 54 (leap year starting Sunday)');
+	t.is(render('{WW}', new Date(2017, 11, 31)), '53', 'returns week 53');
+
 	// formats
 	t.is(render('[{HH}:{mm}:{ss}]'), '[16:30:09]', 'returns formatted time string');
 	t.is(render('The date is {MM}/{DD}/{YYYY}!'), 'The date is 05/01/2017!', 'returns formatted date string');
