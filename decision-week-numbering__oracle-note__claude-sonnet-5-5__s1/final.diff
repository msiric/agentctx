 var RGX = /([^{]*?)\w(?=\})/g;
 
+function doy(d) {
+	// day of year (1-366); diff in UTC so DST shifts can't skew the count
+	var y = d.getFullYear();
+	return (Date.UTC(y, d.getMonth(), d.getDate()) - Date.UTC(y, 0, 0)) / 864e5;
+}
+
 var MAP = {
