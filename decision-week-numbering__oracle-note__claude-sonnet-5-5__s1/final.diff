 	},
 	DD: 'getDate',
+	DDD: doy,
+	WW: function (d) {
+		// Excel WEEKNUM(date, 2): weeks start Monday, week 1 contains Jan 1
+		var jan1 = (new Date(d.getFullYear(), 0, 1).getDay() + 6) % 7; // Mon=0
+		return Math.floor((doy(d) - 1 + jan1) / 7) + 1;
