diff --git a/test/byte-parse.js b/test/byte-parse.js
index cebfab2..392e8bd 100644
--- a/test/byte-parse.js
+++ b/test/byte-parse.js
@@ -108,4 +108,63 @@ describe('Test byte parse function', function(){
   it('Should allow whitespace', function(){
     assert.equal(bytes.parse('1 TB'), 1 * Math.pow(1024, 4));
   });
+
+  it('Should parse IEC units case-insensitively', function(){
+    ['KiB', 'MiB', 'GiB', 'TiB', 'PiB'].forEach(function(unit, i){
+      var mult = Math.pow(1024, i + 1);
+      [unit, unit.toLowerCase(), unit.toUpperCase(), unit.replace('i', 'I')].forEach(function(u){
+        assert.strictEqual(bytes.parse('1' + u), mult);
+        assert.strictEqual(bytes.parse('1.5' + u), Math.floor(1.5 * mult));
+        assert.strictEqual(bytes.parse('0.5' + u), Math.floor(0.5 * mult));
+        assert.strictEqual(bytes.parse('1 ' + u), mult);
+        assert.strictEqual(bytes.parse('-1' + u), -mult);
+      });
+      assert.strictEqual(bytes.parse('1' + unit), bytes.parse('1' + unit.replace('i', '')));
+    });
+  });
+
+  it('Should reject IEC units without a number', function(){
+    assert.strictEqual(bytes.parse('KiB'), null);
+    assert.strictEqual(bytes.parse('xKiB'), null);
+  });
+
+  describe('with long junk input', function(){
+    var LENGTH = 100000;
+    var LIMIT_MS = 100;
+
+    function timeParse(input) {
+      var start = process.hrtime();
+      var result = bytes.parse(input);
+      var diff = process.hrtime(start);
+      var elapsed = diff[0] * 1e3 + diff[1] / 1e6;
+
+      assert.ok(elapsed < LIMIT_MS, 'took ' + elapsed.toFixed(1) + 'ms');
+      return result;
+    }
+
+    function assertRejectedQuickly(input) {
+      assert.strictEqual(timeParse(input), null);
+    }
+
+    it('Should reject a long non-numeric string quickly', function(){
+      assertRejectedQuickly('x'.repeat(LENGTH));
+    });
+
+    // Strings with a leading number but an invalid unit fall back to
+    // parseInt, so they are not rejected; only timing is asserted here.
+    it('Should handle long digits with a bad unit quickly', function(){
+      timeParse('1'.repeat(LENGTH) + 'x');
+      timeParse('1.' + '1'.repeat(LENGTH) + 'x');
+    });
+
+    it('Should reject long whitespace runs quickly', function(){
+      assertRejectedQuickly(' '.repeat(LENGTH) + 'x');
+      assertRejectedQuickly('x' + ' '.repeat(LENGTH) + 'kb');
+    });
+
+    it('Should reject repeated decimal points quickly', function(){
+      assertRejectedQuickly('.'.repeat(LENGTH));
+      timeParse('1' + '.1'.repeat(LENGTH / 2) + 'x');
+    });
+  });
 });
