+def percent(value: NumberOrString, precision: int = 1) -> str:
+    """Format a fraction as a percentage.
+
+    Examples:
+        ```pycon
+        >>> percent(0.125)
+        '12.5%'
+        >>> percent(0.5)
+        '50.0%'
+        >>> percent(0.5, 0)
+        '50%'
+        >>> percent(1.5, 2)
+        '150.00%'
+        >>> percent("0.25")
+        '25.0%'
+        >>> percent("foo")
+        'foo'
+        >>> percent(None)
+        'None'
+
+        ```
+
+    Args:
+        value (int, float, str): Fraction to format, where 1 is 100%.
+        precision (int): Number of digits after the decimal point.
+
+    Returns:
+        str: The percentage, or the input as a string if it is not a number.
+    """
+    import decimal
+    import math
+
+    try:
+        value = float(value)
+        if not math.isfinite(value):
+            return _format_not_finite(value)
+    except (ValueError, TypeError):
+        return str(value)
+    # Round half up on the decimal repr of the value, as billing does.
+    # Float formatting would give '6.2%' for 0.0625 (exact tie, half-even)
+    # and '1.2%' for 0.0125 (binary representation just below the tie).
+    context = decimal.Context(prec=60, rounding=decimal.ROUND_HALF_UP)
+    with decimal.localcontext(context):
+        scaled = decimal.Decimal(repr(value)).scaleb(2)
+        return format(scaled, f".{int(precision)}f") + "%"
+
