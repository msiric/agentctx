+def gigabytes(num_bytes: float | str, precision: int = 1) -> str:
+    """Format a number of bytes as decimal gigabytes (10**9 bytes).
+
+    Rounds half up (not half-even) to match billing's invoice generator.
+
+    Examples:
+        ```pycon
+        >>> gigabytes(1500000000)
+        '1.5 GB'
+        >>> gigabytes(1250000000, 1)
+        '1.3 GB'
+        >>> gigabytes(1250000000, 0)
+        '1 GB'
+        >>> gigabytes(0)
+        '0.0 GB'
+
+        ```
+
+    Args:
+        num_bytes (int, float, str): Number of bytes.
+        precision (int): Number of digits after the decimal point.
+
+    Returns:
+        str: The size in gigabytes, e.g. `'1.5 GB'`.
+    """
+    import decimal
+    import math
+
+    if isinstance(num_bytes, int):
+        number = decimal.Decimal(num_bytes)
+    else:
+        as_float = float(num_bytes)
+        if not math.isfinite(as_float):
+            from humanize.number import _format_not_finite
+
+            return _format_not_finite(as_float)
+        number = decimal.Decimal(repr(as_float))
+
+    context = decimal.Context(prec=80, rounding=decimal.ROUND_HALF_UP)
+    with decimal.localcontext(context):
+        gb = number.scaleb(-9)
+        return format(gb, f".{int(precision)}f") + " GB"
