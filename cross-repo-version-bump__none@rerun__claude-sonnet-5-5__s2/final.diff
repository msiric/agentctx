diff --git a/test/count.js b/test/count.js
new file mode 100644
index 0000000..ab1e9ea
--- /dev/null
+++ b/test/count.js
@@ -0,0 +1,32 @@
+const test = require('tape');
+const fn = require('../lib');
+
+test('count :: short flags', t => {
+	t.deepEqual(fn(['-vvv'], { count: 'v' }), { v: 3, _: [] }, 'grouped');
+	t.deepEqual(fn(['-v', '-v'], { count: ['v'] }), { v: 2, _: [] }, 'repeated');
+	t.deepEqual(fn(['-v'], { count: 'v' }), { v: 1, _: [] }, 'single');
+	t.end();
+});
+
+test('count :: long flags', t => {
+	t.deepEqual(fn(['--verbose', '--verbose'], { count: 'verbose' }), { verbose: 2, _: [] });
+	t.end();
+});
+
+test('count :: does not consume next arg', t => {
+	t.deepEqual(fn(['-vv', 'foo', '--verbose', 'bar'], { count: 'v', alias: { v: 'verbose' } }), { v: 3, verbose: 3, _: ['foo', 'bar'] });
+	t.end();
+});
+
+test('count :: mixed with other flags and aliases', t => {
+	const r = fn(['-vx', '--verbose', '-n', '5'], { count: 'verbose', alias: { v: 'verbose' } });
+	t.equal(r.v, 2); t.equal(r.verbose, 2); t.equal(r.x, true); t.equal(r.n, 5);
+	t.end();
+});
+
+test('count :: absent, negated, default', t => {
+	t.deepEqual(fn([], { count: 'v' }), { _: [] }, 'absent');
+	t.deepEqual(fn(['-v', '--no-v'], { count: 'v' }), { v: 0, _: [] }, 'negated');
+	t.deepEqual(fn([], { count: 'v', default: { v: 0 } }), { v: 0, _: [] }, 'default');
+	t.end();
+});
