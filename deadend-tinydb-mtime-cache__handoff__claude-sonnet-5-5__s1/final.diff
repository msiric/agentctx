@@ -0,0 +1,70 @@
+"""Benchmark read performance of TinyDB's JSONStorage on a large db file.
+
+Usage: python scripts/bench_read.py [target_mb=40] [repeat=3]
+"""
+import cProfile
+import json
+import os
+import pstats
+import sys
+import tempfile
+import time
+
+from tinydb import TinyDB, where
+from tinydb.storages import JSONStorage
+
+
+def generate(path, target_mb):
+    docs, size, i = {}, 0, 0
+    while size < target_mb * 1024 * 1024:
+        doc = {'name': f'user{i}', 'age': i % 90, 'email': f'user{i}@example.com',
+               'tags': ['a', 'b', 'c'], 'addr': {'city': f'city{i % 500}', 'zip': i}}
+        docs[str(i + 1)] = doc
+        size += len(json.dumps(doc)) + 10
+        i += 1
+    with open(path, 'w') as f:
+        json.dump({'_default': docs}, f)
+    return i
+
+
+def timed(label, fn, repeat):
+    ts = []
+    for _ in range(repeat):
+        t = time.perf_counter()
+        fn()
+        ts.append(time.perf_counter() - t)
+    print(f'{label:<34} best {min(ts)*1000:8.1f} ms  (n={repeat})')
+
+
+def main():
+    mb = float(sys.argv[1]) if len(sys.argv) > 1 else 40
+    repeat = int(sys.argv[2]) if len(sys.argv) > 2 else 3
+    with tempfile.TemporaryDirectory() as d:
+        path = os.path.join(d, 'db.json')
+        n = generate(path, mb)
+        print(f'{n} docs, {os.path.getsize(path)/1e6:.1f} MB')
+        db = TinyDB(path)
+        storage = db._storage
+
+        timed('raw json.load (storage.read)', storage.read, repeat)
+        timed('db.all()', db.all, repeat)
+        # a fresh condition each time defeats the query cache
+        counter = iter(range(10**6))
+        timed('db.search (uncached, new query)',
+              lambda: db.search(where('age') == next(counter) % 90), repeat)
+        q = where('age') == 42
+        db.search(q)
+        timed('db.search (cached, same query)', lambda: db.search(q), repeat)
+        timed('db.get(doc_id=1)', lambda: db.get(doc_id=1), repeat)
+
+        print('\nprofile of one uncached search:')
+        pr = cProfile.Profile()
+        pr.enable()
+        db.search(where('age') == 7)
+        pr.disable()
+        pstats.Stats(pr).sort_stats('cumulative').print_stats(8)
+        db.close()
+
+
+if __name__ == '__main__':
+    main()
