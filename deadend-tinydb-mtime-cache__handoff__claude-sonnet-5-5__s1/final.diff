@@ -285,3 +285,36 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def test_json_read_cache_sees_external_writes_and_skips_parse(tmpdir, monkeypatch):
+    path = str(tmpdir.join('db.json'))
+    with open(path, 'w') as f:
+        f.write('{"_default": {"1": {"a": 1}}}')
+
+    s = JSONStorage(path, cache_reads=True)
+    first = s.read()
+    assert s.read() is first  # unchanged content -> no re-parse
+
+    # External write with identical size and restored mtime (NFS-like)
+    st = os.stat(path)
+    with open(path, 'w') as f:
+        f.write('{"_default": {"1": {"a": 2}}}')
+    os.utime(path, ns=(st.st_atime_ns, st.st_mtime_ns))
+    assert s.read()['_default']['1']['a'] == 2
+    s.close()
+
+
+def test_json_read_cache_failed_update_not_served(tmpdir):
+    from tinydb import TinyDB
+    db = TinyDB(str(tmpdir.join('db.json')), cache_reads=True)
+    db.insert({'a': 1})
+
+    def boom(doc):
+        doc['a'] = 99
+        raise RuntimeError
+
+    with pytest.raises(RuntimeError):
+        db.update(boom)
+    assert db.get(doc_id=1)['a'] == 1
+    db.close()
