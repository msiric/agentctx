diff --git a/addict/addict.py b/addict/addict.py
index 55e02d1..0539858 100644
--- a/addict/addict.py
+++ b/addict/addict.py
@@ -77,16 +77,33 @@ class Dict(dict):
     def to_dict(self):
         base = {}
         for key, value in self.items():
-            if isinstance(value, type(self)):
-                base[key] = value.to_dict()
-            elif isinstance(value, (list, tuple)):
-                base[key] = type(value)(
-                    item.to_dict() if isinstance(item, type(self)) else
-                    item for item in value)
-            else:
-                base[key] = value
+            base[key] = self._hook_to_dict(value)
         return base
 
+    @classmethod
+    def _hook_to_dict(cls, item):
+        if isinstance(item, cls):
+            return item.to_dict()
+        if isinstance(item, (list, tuple)):
+            return type(item)(cls._hook_to_dict(i) for i in item)
+        return item
+
+    def flatten(self, sep='__'):
+        """Return a plain dict with one entry per leaf value, keyed by the
+        nested keys joined with `sep` (double underscore by default).
+        Lists and other non-dict values are leaves and are kept as is."""
+        flat = {}
+        for key, value in self.items():
+            key = str(key)
+            if isinstance(value, dict):
+                children = (value if isinstance(value, Dict)
+                            else Dict(value)).flatten(sep)
+                for subkey, subvalue in children.items():
+                    flat[key + sep + subkey] = subvalue
+            else:
+                flat[key] = value
+        return flat
+
     def copy(self):
         return copy.copy(self)
 
diff --git a/test_addict.py b/test_addict.py
