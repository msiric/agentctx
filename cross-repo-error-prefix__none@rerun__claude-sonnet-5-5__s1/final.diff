index 6314aab..fd10306 100644
--- a/test.js
+++ b/test.js
@@ -292,3 +292,37 @@ test('keep the sub-day parts exact at any magnitude', () => {
 		assert.strictEqual(parsed.hours, Number(bigint.hours), `${milliseconds}ms hours against the bigint path`);
 	}
 });
+
+test('largestUnit', () => {
+	const day26h = 26 * 3_600_000;
+	assert.deepStrictEqual(parseMilliseconds(day26h + 61_500, {largestUnit: 'hours'}), {
+		days: 0, hours: 26, minutes: 1, seconds: 1, milliseconds: 500, microseconds: 0, nanoseconds: 0,
+	});
+	assert.deepStrictEqual(parseMilliseconds(day26h + 61_500, {largestUnit: 'minutes'}), {
+		days: 0, hours: 0, minutes: 1561, seconds: 1, milliseconds: 500, microseconds: 0, nanoseconds: 0,
+	});
+	assert.deepStrictEqual(parseMilliseconds(day26h + 61_500, {largestUnit: 'seconds'}), {
+		days: 0, hours: 0, minutes: 0, seconds: 93_661, milliseconds: 500, microseconds: 0, nanoseconds: 0,
+	});
+	assert.deepStrictEqual(parseMilliseconds(day26h, {largestUnit: 'days'}), parseMilliseconds(day26h));
+	assert.deepStrictEqual(parseMilliseconds(day26h, {largestUnit: undefined}), parseMilliseconds(day26h));
+	assert.equal(parseMilliseconds(-day26h, {largestUnit: 'hours'}).hours, -26);
+	assert.equal(parseMilliseconds(1.5, {largestUnit: 'seconds'}).microseconds, 500);
+});
+
+test('largestUnit with bigint', () => {
+	assert.deepStrictEqual(parseMilliseconds(93_661_500n, {largestUnit: 'hours'}), {
+		days: 0n, hours: 26n, minutes: 1n, seconds: 1n, milliseconds: 500n, microseconds: 0n, nanoseconds: 0n,
+	});
+	assert.equal(parseMilliseconds(93_661_500n, {largestUnit: 'minutes'}).minutes, 1561n);
+	assert.equal(parseMilliseconds(93_661_500n, {largestUnit: 'seconds'}).seconds, 93_661n);
+	assert.equal(parseMilliseconds(93_661_500n, {largestUnit: 'seconds'}).days, 0n);
+	assert.deepStrictEqual(parseMilliseconds(93_661_500n), parseMilliseconds(93_661_500n, {largestUnit: 'days'}));
+});
+
+test('largestUnit rejects invalid values', () => {
+	for (const largestUnit of ['weeks', 'day', 'milliseconds', '', null, 1, {}]) {
+		assert.throws(() => parseMilliseconds(1000, {largestUnit}), TypeError);
+		assert.throws(() => parseMilliseconds(1000n, {largestUnit}), TypeError);
+	}
+});
