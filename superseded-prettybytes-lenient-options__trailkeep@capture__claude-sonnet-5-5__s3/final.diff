 ```
 
+##### significantDigits
+
+Type: `number`\
+Default: `3`
+
+The number of significant digits to round to. Only applies when neither [`minimumFractionDigits`](#minimumfractiondigits) nor [`maximumFractionDigits`](#maximumfractiondigits) is set.
+
+Must be an integer between 1 and 100. Any other value is ignored and the default is used. The integer part of the number is never cut short.
+
+```js
+import prettyBytes from 'pretty-bytes';
+
+prettyBytes(1337, {significantDigits: 2});
+//=> '1.3 kB'
+
+prettyBytes(1337, {significantDigits: 4});
+//=> '1.337 kB'
+```
+
 ##### minimumFractionDigits
 
 Type: `number`\
diff --git a/test.js b/test.js
index e7286c0..08ac217 100644
--- a/test.js
+++ b/test.js
@@ -1181,3 +1181,20 @@ test('unit option rejects units outside the active system', t => {
 	t.throws(() => prettyBytes(1, {unit: null}), {instanceOf: TypeError});
 	t.notThrows(() => prettyBytes(1, {unit: undefined}));
 });
+
+test('significantDigits option', t => {
+	t.is(prettyBytes(1337, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 1}), '1 kB');
+	t.is(prettyBytes(999_999, {significantDigits: 1}), '1 MB');
+	t.is(prettyBytes(123_456, {significantDigits: 1}), '123 kB');
+	t.is(prettyBytes(1337n, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 2, locale: 'de'}), '1,3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 2, maximumFractionDigits: 3}), '1.337 kB');
+});
+
+test('significantDigits ignores invalid values', t => {
+	for (const value of [0, -1, 1.5, 101, Number.NaN, '2', null, undefined, {}]) {
+		t.is(prettyBytes(1337, {significantDigits: value}), '1.34 kB');
+	}
+});
