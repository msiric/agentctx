+/**
+ * Parse a compound duration such as `"1h 30m"`, `"1h, 30m"` or `"2 days 4 hours"` and
+ * return the total in milliseconds. Each piece is parsed with `parse`.
+ *
+ * @param str - A string of one or more whitespace- or comma-separated
+ * `<number><unit>` pieces
+ * @returns The summed value in milliseconds
+ * @throws TypeError if `str` is not a valid compound duration (this function
+ * never returns `NaN`)
+ */
+export function parseCompound(str: string): number {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw new TypeError(
+      `Value provided to ms.parseCompound() must be a string with length between 1 and 99. value=${JSON.stringify(str)}`,
+    );
+  }
+  const pieces = str.trim().split(/(?<=[a-z])(?:\s*,\s*|\s+)(?=-?\d|\.\d)/i);
+  let total = 0;
+  for (const piece of pieces) {
+    // A piece without a unit would be ambiguous in a compound ("1 2").
+    const n = /[a-z]$/i.test(piece) ? parse(piece) : NaN;
+    if (Number.isNaN(n)) {
+      throw new TypeError(
+        `Invalid compound duration provided to ms.parseCompound(). value=${JSON.stringify(str)}`,
+      );
+    }
+    total += n;
+  }
+  return total;
+}
+
+/**
+ * Parse a timer-style string, `"m:ss"` (e.g. `"1:30"`) or `"h:mm:ss"`
+ * (e.g. `"01:02:03"`), and return the total in milliseconds.
+ *
+ * Seconds (and minutes when hours are present) must be two digits, 00-59.
+ * The leading field may be any number of digits.
+ *
+ * @param str - A timer-style string
+ * @returns The value in milliseconds, or `undefined` if `str` is not valid
+ */
+export function parseClock(str: string): number | undefined {
+  if (typeof str !== 'string' || str.length > 99) return undefined;
+  const match = /^(?:(\d+):([0-5]\d)|(\d+):([0-5]\d):([0-5]\d))$/.exec(str);
+  if (!match) return undefined;
+  const [h, m, s] =
+    match[3] !== undefined
+      ? [match[3], match[4], match[5]]
+      : ['0', match[1], match[2]];
+  return (Number(h) * 3600 + Number(m) * 60 + Number(s)) * 1000;
+}
