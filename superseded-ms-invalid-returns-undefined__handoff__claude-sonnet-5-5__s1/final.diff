+import { describe, expect, it } from '@jest/globals';
+import { parseCompound } from './index';
+
+describe('parseCompound(string)', () => {
+  it('should parse a single piece like parse', () => {
+    expect(parseCompound('1h')).toBe(3600000);
+  });
+
+  it('should sum short units', () => {
+    expect(parseCompound('1h 30m')).toBe(5400000);
+  });
+
+  it('should sum long units with spaces', () => {
+    expect(parseCompound('2 days 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
+  });
+
+  it('should handle three or more pieces', () => {
+    expect(parseCompound('1d 2h 3m 4s 5ms')).toBe(
+      86400000 + 7200000 + 180000 + 4000 + 5,
+    );
+  });
+
+  it('should accept commas between pieces', () => {
+    expect(parseCompound('1h, 30m')).toBe(5400000);
+    expect(parseCompound('1h,30m')).toBe(5400000);
+    expect(parseCompound('2 days , 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
+  });
+
+  it('should handle decimals, casing and surrounding whitespace', () => {
+    expect(parseCompound('  1.5H 30M ')).toBe(7200000);
+  });
+
+  it('should handle negative pieces', () => {
+    expect(parseCompound('1h -30m')).toBe(1800000);
+  });
+
+  it('should throw a TypeError including the input for invalid input', () => {
+    for (const bad of [
+      '1h foo',
+      '1h 30',
+      '1 2',
+      '1h,',
+      ',1h',
+      '1h,,30m',
+      '1h30m',
+      'abc',
+      '   ',
+    ]) {
+      expect(() => parseCompound(bad)).toThrow(TypeError);
+      expect(() => parseCompound(bad)).toThrow(JSON.stringify(bad));
+    }
+  });
+
+  it('should throw a TypeError for empty, too long or non-string values', () => {
+    expect(() => parseCompound('')).toThrow(TypeError);
+    expect(() => parseCompound('')).toThrow('""');
+    expect(() => parseCompound('1h '.repeat(40))).toThrow(TypeError);
+    // @ts-expect-error testing runtime behavior
+    expect(() => parseCompound(5)).toThrow(TypeError);
+  });
+});
