--- a/tests/test_storages.py
+++ b/tests/test_storages.py
@@ -285,3 +285,84 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def test_json_write_is_atomic_on_crash(tmpdir, monkeypatch):
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+
+    # Simulate the process dying mid-write: the temp file gets partially
+    # written, then the "crash" happens before the file is replaced.
+    def crash(*args, **kwargs):
+        raise KeyboardInterrupt('simulated kill')
+
+    monkeypatch.setattr(os, 'replace', crash)
+
+    db = TinyDB(path)
+    with pytest.raises(KeyboardInterrupt):
+        db.insert({'b': 2})
+    monkeypatch.undo()
+
+    # Database is still readable and has the old state; no temp files left
+    with TinyDB(path) as db2:
+        assert db2.all() == [{'a': 1}]
+    assert os.listdir(str(tmpdir)) == ['db.json']
+
+
+def test_json_write_failure_in_fsync_keeps_old_state(tmpdir, monkeypatch):
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+
+    def boom(fd):
+        raise OSError('disk gone')
+
+    monkeypatch.setattr(os, 'fsync', boom)
+    db = TinyDB(path)
+    with pytest.raises(OSError):
+        db.insert({'b': 2})
+    monkeypatch.undo()
+
+    with TinyDB(path) as db2:
+        assert db2.all() == [{'a': 1}]
+
+
+def test_json_serialization_error_keeps_old_state(tmpdir):
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+        with pytest.raises(TypeError):
+            db.insert({'b': object()})
+
+    with TinyDB(path) as db2:
+        assert db2.all() == [{'a': 1}]
+
+
+def test_json_multiple_writes_and_shrinking(tmpdir):
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path) as db:
+        db.insert({'x': 'y' * 1000})
+        db.truncate()
+        db.insert({'a': 1})
+
+    with TinyDB(path) as db2:
+        assert db2.all() == [{'a': 1}]
+    assert os.listdir(str(tmpdir)) == ['db.json']
+
+
+def test_json_write_preserves_permissions(tmpdir):
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+    os.chmod(path, 0o640)
+
+    with TinyDB(path) as db:
+        db.insert({'b': 2})
+
+    assert os.stat(path).st_mode & 0o777 == 0o640
