     check_process(result, exit_code=0)
     assert result.stdout.strip().startswith("dotenv, version")
+
+
+def test_check_all_present(cli, dotenv_path):
+    dotenv_path.write_text("A=1\nB=2\nC=3\n")
+    (dotenv_path.parent / ".env.example").write_text("A=\nB=\n")
+
+    result = cli.invoke(dotenv_cli, ["--file", dotenv_path, "check"])
+
+    assert (result.exit_code, result.output) == (0, "")
+
+
+def test_check_lists_missing_keys(cli, dotenv_path):
+    dotenv_path.write_text("A=1\n")
+    (dotenv_path.parent / ".env.example").write_text("A=\nB=x\n# C=1\nD\n")
+
+    result = cli.invoke(dotenv_cli, ["--file", dotenv_path, "check"])
+
+    assert (result.exit_code, result.output) == (1, "B\nD\n")
+
+
+def test_check_empty_and_bare_keys_count_as_present(cli, dotenv_path):
+    dotenv_path.write_text("A=\nB\n")
+    (dotenv_path.parent / ".env.example").write_text("A=1\nB=2\n")
+
+    result = cli.invoke(dotenv_cli, ["--file", dotenv_path, "check"])
+
+    assert (result.exit_code, result.output) == (0, "")
+
+
+def test_check_custom_example(cli, dotenv_path, tmp_path):
+    dotenv_path.write_text("A=1\n")
+    (dotenv_path.parent / ".env.example").write_text("IGNORED=1\n")
+    other = tmp_path / "other.example"
+    other.write_text("A=\nZ=\n")
+
+    result = cli.invoke(
+        dotenv_cli, ["--file", dotenv_path, "check", "--example", str(other)]
+    )
+
+    assert (result.exit_code, result.output) == (1, "Z\n")
+
+
+def test_check_missing_example_file(cli, dotenv_path):
+    dotenv_path.write_text("A=1\n")
+
+    result = cli.invoke(dotenv_cli, ["--file", dotenv_path, "check"])
+
+    assert result.exit_code == 2
+
+
+def test_check_missing_env_file(cli, tmp_path):
+    (tmp_path / ".env.example").write_text("A=\n")
+
+    result = cli.invoke(dotenv_cli, ["--file", tmp_path / ".env", "check"])
+
+    assert result.exit_code == 2
+
+
+def test_diff_same(cli, tmp_path):
+    a, b = tmp_path / "a.env", tmp_path / "b.env"
+    a.write_text("A=1\nB=2\n")
+    b.write_text("B=2\nA=1\n")
+
+    result = cli.invoke(dotenv_cli, ["diff", str(a), str(b)])
+
+    assert (result.exit_code, result.output) == (0, "")
+
+
+def test_diff_reports_differences_without_values(cli, tmp_path):
+    a, b = tmp_path / "a.env", tmp_path / "b.env"
+    a.write_text("ONLY_A=secret1\nSAME=1\nDIFF=secret2\n")
+    b.write_text("ONLY_B=secret3\nSAME=1\nDIFF=secret4\n")
+
+    result = cli.invoke(dotenv_cli, ["diff", str(a), str(b)])
+
+    assert (result.exit_code, result.output) == (1, "< ONLY_A\n> ONLY_B\n~ DIFF\n")
+
+
+def test_diff_empty_vs_bare_key_differ(cli, tmp_path):
+    a, b = tmp_path / "a.env", tmp_path / "b.env"
+    a.write_text("A=\n")
+    b.write_text("A\n")
+
+    result = cli.invoke(dotenv_cli, ["diff", str(a), str(b)])
+
+    assert (result.exit_code, result.output) == (1, "~ A\n")
+
+
+def test_diff_missing_file(cli, tmp_path):
+    a = tmp_path / "a.env"
+    a.write_text("A=1\n")
+
+    result = cli.invoke(dotenv_cli, ["diff", str(a), str(tmp_path / "nope")])
+
+    assert result.exit_code == 2
