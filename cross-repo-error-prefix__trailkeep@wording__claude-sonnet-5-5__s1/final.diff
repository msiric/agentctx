+// {days: 0, hours: 26, minutes: 0, …}
 ```
 
+## API
+
+### parseMilliseconds(milliseconds, options?)
+
+`milliseconds` can be a finite `number` or a `bigint`.
+
+#### options
+
+Type: `object`
+
+##### largestUnit
+
+Type: `'days' | 'hours' | 'minutes' | 'seconds'`\
+Default: `'days'`
+
+The largest unit to include. Larger units roll into it, and the units above it are `0`. Any other value throws a `TypeError`.
+
 ## Related
 
 - [to-milliseconds](https://github.com/sindresorhus/to-milliseconds) - The inverse of this module
diff --git a/test.js b/test.js
index 6314aab..70b91ff 100644
--- a/test.js
+++ b/test.js
@@ -229,6 +229,54 @@ test('errors', () => {
 	assert.throws(() => {
 		parseMilliseconds(Infinity);
 	}, TypeError);
+
+	assert.throws(() => {
+		parseMilliseconds('string');
+	}, {message: /^parse-ms: /v});
+});
+
+test('largestUnit', () => {
+	const milliseconds = 93_784_005; // 1d 2h 3m 4s 5ms
+
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit: 'days'}), parseMilliseconds(milliseconds));
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit: 'hours'}), {
+		days: 0, hours: 26, minutes: 3, seconds: 4, milliseconds: 5, microseconds: 0, nanoseconds: 0,
+	});
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit: 'minutes'}), {
+		days: 0, hours: 0, minutes: 1563, seconds: 4, milliseconds: 5, microseconds: 0, nanoseconds: 0,
+	});
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit: 'seconds'}), {
+		days: 0, hours: 0, minutes: 0, seconds: 93_784, milliseconds: 5, microseconds: 0, nanoseconds: 0,
+	});
+	assert.strictEqual(parseMilliseconds(-milliseconds, {largestUnit: 'hours'}).hours, -26);
+});
+
+test('largestUnit with bigint', () => {
+	const milliseconds = 93_784_005n;
+
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit: 'hours'}), {
+		days: 0n, hours: 26n, minutes: 3n, seconds: 4n, milliseconds: 5n, microseconds: 0n, nanoseconds: 0n,
+	});
+	assert.strictEqual(parseMilliseconds(milliseconds, {largestUnit: 'minutes'}).minutes, 1563n);
+	assert.strictEqual(parseMilliseconds(milliseconds, {largestUnit: 'seconds'}).seconds, 93_784n);
+	assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit: 'days'}), parseMilliseconds(milliseconds));
+});
+
+test('largestUnit keeps the parts exact at large magnitudes', () => {
+	assert.strictEqual(parseMilliseconds(Number.MAX_SAFE_INTEGER, {largestUnit: 'seconds'}).seconds, Math.trunc(Number.MAX_SAFE_INTEGER / 1000));
+	assert.strictEqual(parseMilliseconds(Number.MAX_SAFE_INTEGER, {largestUnit: 'seconds'}).milliseconds, 991);
+});
+
+test('invalid largestUnit', () => {
+	for (const largestUnit of ['weeks', 'milliseconds', 'Hours', '', 5, null, {}]) {
+		assert.throws(() => {
+			parseMilliseconds(1000, {largestUnit});
+		}, {name: 'TypeError', message: /^parse-ms: /v});
+
+		assert.throws(() => {
+			parseMilliseconds(1000n, {largestUnit});
+		}, TypeError);
+	}
 });
 
