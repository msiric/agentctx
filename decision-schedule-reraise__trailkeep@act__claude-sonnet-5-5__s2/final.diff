+    def test_run_pending_runs_all_then_raises_first_exception(self):
+        calls = []
+
+        def bad(name):
+            calls.append(name)
+            raise ValueError(name)
+
+        def good():
+            calls.append("good")
+
+        with mock_datetime(2024, 1, 1, 10, 0):
+            j1 = every().minute.do(bad, "a")
+            j2 = every().minute.do(good)
+            j3 = every().minute.do(bad, "b")
+        with mock_datetime(2024, 1, 1, 10, 5):
+            with self.assertRaises(ValueError) as cm:
+                schedule.run_pending()
+            assert str(cm.exception) == "a"
+            assert sorted(calls) == ["a", "b", "good"]
+            # failing jobs were rescheduled
+            assert j1.last_run is not None and j3.last_run is not None
+            assert not j1.should_run
