@@ -1569,6 +1569,81 @@ class SchedulerTests(TestCase):
         schedule.clear()
         assert len(schedule.jobs) == 0
 
+    def test_get_jobs_for(self):
+        def foo():
+            pass
+
+        def bar():
+            pass
+
+        scheduler = schedule.Scheduler()
+        j1 = scheduler.every().second.do(foo)
+        j2 = scheduler.every().minute.do(foo, 1, x=2)
+        j3 = scheduler.every().hour.do(bar)
+        assert scheduler.get_jobs_for(foo) == [j1, j2]
+        assert scheduler.get_jobs_for(bar) == [j3]
+        assert scheduler.get_jobs_for(lambda: None) == []
+        scheduler.cancel_job(j1)
+        assert scheduler.get_jobs_for(foo) == [j2]
+
+    def test_get_jobs_for_unfinished_job(self):
+        scheduler = schedule.Scheduler()
+        scheduler.every().second  # never calls do()
+        assert scheduler.get_jobs_for(len) == []
+
+    def test_pause_and_resume(self):
+        scheduler = schedule.Scheduler()
+        paused_func = make_mock_job(name="paused")
+        other_func = make_mock_job(name="other")
+        scheduler.every().second.do(paused_func).tag("maint")
+        scheduler.every().second.do(other_func).tag("other")
+        scheduler.every().second.do(make_mock_job(name="untagged"))
+
+        with mock_datetime(2024, 1, 1, 12, 0, 0):
+            for job in scheduler.jobs:
+                job._schedule_next_run()
+        with mock_datetime(2024, 1, 1, 12, 0, 5):
+            scheduler.pause("maint")
+            scheduler.run_pending()
+            assert paused_func.call_count == 0
+            assert other_func.call_count == 1
+            assert len(scheduler.jobs) == 3  # still registered
+
+        # Paused jobs are not made up on resume, only rescheduled.
+        with mock_datetime(2024, 1, 1, 12, 10, 0):
+            scheduler.resume("maint")
+            scheduler.run_pending()
+            assert paused_func.call_count == 0
+        with mock_datetime(2024, 1, 1, 12, 10, 1):
+            scheduler.run_pending()
+            assert paused_func.call_count == 1
+
+    def test_pause_unknown_tag_is_noop(self):
+        scheduler = schedule.Scheduler()
+        job = scheduler.every().second.do(make_mock_job())
+        scheduler.pause("nope")
+        scheduler.resume("nope")
+        assert not job.paused
+
+    def test_paused_jobs_ignored_by_next_run(self):
+        scheduler = schedule.Scheduler()
+        scheduler.every().hour.do(make_mock_job()).tag("maint")
+        scheduler.every().day.do(make_mock_job()).tag("other")
+        other = scheduler.get_jobs("other")[0]
+        scheduler.pause("maint")
+        assert scheduler.get_next_run() == other.next_run
+        assert scheduler.get_next_run("maint") is None
+        scheduler.resume("maint")
+        assert scheduler.get_next_run() == scheduler.get_jobs("maint")[0].next_run
+
+    def test_run_all_still_runs_paused_jobs(self):
+        scheduler = schedule.Scheduler()
+        func = make_mock_job()
+        scheduler.every().hour.do(func).tag("maint")
+        scheduler.pause("maint")
+        scheduler.run_all()
+        assert func.call_count == 1
+
