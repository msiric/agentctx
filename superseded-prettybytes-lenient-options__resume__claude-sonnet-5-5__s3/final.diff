+test('significantDigits', t => {
+	t.is(prettyBytes(1337, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 3}), '1.34 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4}), '1.337 kB');
+	t.is(prettyBytes(1337n, {significantDigits: 4}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 1}), '1 kB');
+	t.is(prettyBytes(1996, {significantDigits: 2}), '2 kB');
+	t.is(prettyBytes(999_999, {significantDigits: 2}), '1 MB');
+	t.is(prettyBytes(1337, {significantDigits: 4, binary: true}), '1.306 KiB');
+	t.is(prettyBytes(1337, {significantDigits: 2, locale: 'de'}), '1,3 kB');
+
+	// The integer part is never rounded away.
+	t.is(prettyBytes(123_456, {significantDigits: 2}), '123 kB');
+
+	// The fraction digit options take over.
+	t.is(prettyBytes(1337, {significantDigits: 2, maximumFractionDigits: 2}), '1.33 kB');
+	t.is(prettyBytes(1337, {significantDigits: 2, minimumFractionDigits: 3}), '1.337 kB');
+
+	// A bad value is ignored instead of throwing, so the default of 3 applies.
+	for (const significantDigits of [0, -1, 101, 1.5, Number.NaN, Number.POSITIVE_INFINITY, '2', null, true, {}, 2n]) {
+		t.is(prettyBytes(1337, {significantDigits}), '1.34 kB', `${typeof significantDigits} ${String(significantDigits)}`);
+	}
+
+	t.is(prettyBytes(1337, {significantDigits: undefined}), '1.34 kB');
+});
+
