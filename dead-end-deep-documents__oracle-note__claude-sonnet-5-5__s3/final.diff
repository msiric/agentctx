--- a/xmltodict.py
+++ b/xmltodict.py
@@ -655,3 +655,44 @@ if __name__ == '__main__':  # pragma: no cover
             handle_item([], root)
     except KeyboardInterrupt:
         pass
+
+
+def drop_keys(doc, names):
+    """Return a copy of a parsed document with every key in ``names``
+    removed at any depth (attribute keys such as ``'@id'`` included).
+
+    The input is never mutated. Only dicts and lists are copied; other
+    values are shared. The walk is iterative, so arbitrarily deeply
+    nested documents do not hit the recursion limit.
+    """
+    if isinstance(names, (str, bytes)):
+        names = (names,)
+    names = frozenset(names)
+
+    def shell(value):
+        if isinstance(value, dict):
+            return {}
+        if isinstance(value, list):
+            return []
+        return None
+
+    root = shell(doc)
+    if root is None:
+        return doc
+    stack = [(doc, root)]
+    while stack:
+        src, dst = stack.pop()
+        if isinstance(src, dict):
+            items = [(k, v) for k, v in src.items() if k not in names]
+            for k, v in items:
+                child = shell(v)
+                dst[k] = v if child is None else child
+                if child is not None:
+                    stack.append((v, child))
+        else:
+            for v in src:
+                child = shell(v)
+                dst.append(v if child is None else child)
+                if child is not None:
+                    stack.append((v, child))
+    return root
