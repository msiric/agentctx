+
+
+def test_inprocess_wrap_option():
+    """In-process: --wrap WIDTH wraps long cell text at whitespace"""
+    out = run_main_in_process(
+        ["-s", ",", "-1", "--wrap", "10"], input_text="id,notes\n1,aaa bbb ccc ddd\n"
+    )
+    assert_equal(
+        ["  id  notes", "----  -------", "   1  aaa bbb", "      ccc ddd"],
+        out.splitlines(),
+    )
+
+
+def test_inprocess_wrap_option_keeps_ids_and_urls_intact():
+    """In-process: --wrap never splits ticket IDs or URLs, even if wider than WIDTH"""
+    ticket = "SUPPORT-2024-118233"
+    url = "https://wiki.example.com/ops/db-failover-runbook"
+    out = run_main_in_process(
+        ["-s", "\\t", "-1", "--wrap", "14"],
+        input_text=f"id\tnote\n1\tescalated as {ticket} to the vendor\n2\trunbook {url}\n",
+    )
+    lines = [line.strip() for line in out.splitlines()]
+    assert ticket in lines or any(line.endswith(ticket) for line in lines)
+    assert any(line.endswith(url) for line in lines)
+
+
+def test_inprocess_wrap_option_invalid():
+    """In-process: --wrap rejects non-positive / non-integer values"""
+    for bad in ["0", "abc"]:
+        try:
+            run_main_in_process(["--wrap", bad], input_text="a b\n")
+        except SystemExit as e:
+            assert_equal(e.code, 2)
+        else:
+            raise AssertionError("expected SystemExit")
