+/**
+ * Parse a compound duration such as `"1h 30m"`, `"1h, 30m"` or `"2 days 4 hours"` and
+ * return the total in milliseconds. Each piece must include a unit and is
+ * parsed with `parse`.
+ *
+ * @param str - A string of one or more duration pieces separated by whitespace and/or a single comma
+ * @returns The total in milliseconds
+ * @throws TypeError if `str` is not a valid compound duration
+ */
+export function parseCompound(str: string): number {
+  const invalid = () =>
+    new TypeError(
+      `Value provided to ms.parseCompound() must be a valid compound duration string of length 1 to 99, such as "1h 30m". value=${JSON.stringify(str)}`,
+    );
+  if (typeof str !== "string" || str.length === 0 || str.length > 100) {
+    throw invalid();
+  }
+  const piece = "-?\\d*\\.?\\d+ *[a-z]+";
+  if (
+    !new RegExp(`^ *${piece}(?:(?:\\s*,\\s*|\\s+)${piece})* *$`, "i").test(str)
+  ) {
+    throw invalid();
+  }
+  let total = 0;
+  for (const [part] of str.matchAll(new RegExp(piece, "gi"))) {
+    total += parse(part);
+  }
+  if (Number.isNaN(total)) {
+    throw invalid();
+  }
+  return total;
+}
+
+/**
+ * Parse a timer-style clock string and return the total in milliseconds.
+ * `"m:ss"` (e.g. `"1:30"`) and `"h:mm:ss"` (e.g. `"01:02:03"`) are supported.
+ * Seconds (and minutes, when hours are present) must be two digits, 00-59.
+ *
+ * @param str - A clock string
+ * @returns The total in milliseconds, or `undefined` if `str` is not a valid clock string
+ */
+export function parseClock(str: string): number | undefined {
+  if (typeof str !== "string" || str.length === 0 || str.length > 100) {
+    return undefined;
+  }
+  const match = /^(?:(\d+):([0-5]\d)|(\d+)):([0-5]\d)$/.exec(str);
+  if (!match) {
+    return undefined;
+  }
+  const [, h, hm, m, s] = match;
+  const hours = h === undefined ? 0 : Number(h);
+  const minutes = Number(h === undefined ? m : hm);
+  return ((hours * 60 + minutes) * 60 + Number(s)) * 1000;
 }
