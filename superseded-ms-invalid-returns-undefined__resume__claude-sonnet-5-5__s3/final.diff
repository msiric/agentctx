@@ -0,0 +1,68 @@
+import { describe, expect, it } from "@jest/globals";
+import { parseCompound } from "./index";
+
+describe("parseCompound(string)", () => {
+  it("should parse short compound durations", () => {
+    expect(parseCompound("1h 30m")).toBe(5400000);
+  });
+
+  it("should parse long compound durations with spaces", () => {
+    expect(parseCompound("2 days 4 hours")).toBe(2 * 86400000 + 4 * 3600000);
+  });
+
+  it("should parse a single piece", () => {
+    expect(parseCompound("90s")).toBe(90000);
+  });
+
+  it("should parse three or more pieces and mixed styles", () => {
+    expect(parseCompound("1d 2h 3m 4s 5ms")).toBe(
+      86400000 + 7200000 + 180000 + 4000 + 5,
+    );
+    expect(parseCompound("1w 1 day")).toBe(8 * 86400000);
+  });
+
+  it("should accept commas between parts", () => {
+    expect(parseCompound("1h, 30m")).toBe(5400000);
+    expect(parseCompound("1h,30m")).toBe(5400000);
+    expect(parseCompound("2 days , 4 hours, 5m")).toBe(
+      2 * 86400000 + 4 * 3600000 + 300000,
+    );
+  });
+
+  it("should support decimals and negative pieces", () => {
+    expect(parseCompound("1.5h 30m")).toBe(7200000);
+    expect(parseCompound("1h -30m")).toBe(1800000);
+  });
+
+  it("should be case insensitive and tolerate surrounding spaces", () => {
+    expect(parseCompound(" 1H 30M ")).toBe(5400000);
+  });
+
+  it("should throw a TypeError including the input for bad strings", () => {
+    for (const bad of [
+      "",
+      "abc",
+      "foo",
+      "1h foo",
+      "1h30m",
+      "1h,",
+      ",1h",
+      "1h,,30m",
+      "1h 30",
+    ]) {
+      expect(() => parseCompound(bad)).toThrow(TypeError);
+      expect(() => parseCompound(bad)).toThrow(JSON.stringify(bad));
+    }
+  });
+
+  it("should throw a TypeError for an unknown unit", () => {
+    expect(() => parseCompound("1h 30x")).toThrow(TypeError);
+    expect(() => parseCompound("1h 30x")).toThrow('"1h 30x"');
+  });
+
+  it("should throw a TypeError for too long or non-string values", () => {
+    expect(() => parseCompound("1h ".repeat(40))).toThrow(TypeError);
+    // @ts-expect-error testing runtime behavior
+    expect(() => parseCompound(5)).toThrow(TypeError);
+  });
+});
