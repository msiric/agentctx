+    def test_pause_resume_by_tag(self):
+        paused_mock = make_mock_job("paused")
+        other_mock = make_mock_job("other")
+        with mock_datetime(2014, 6, 28, 12, 0):
+            every().minute.do(paused_mock).tag("maint")
+            every().minute.do(other_mock).tag("other")
+            schedule.pause("maint")
+
+        with mock_datetime(2014, 6, 28, 12, 1):
+            schedule.run_pending()
+            assert paused_mock.call_count == 0
+            assert other_mock.call_count == 1
+
+            # Still scheduled, just paused
+            assert len(schedule.get_jobs("maint")) == 1
+            schedule.resume("maint")
+            schedule.run_pending()
+            assert paused_mock.call_count == 1
+            assert other_mock.call_count == 1
+
+    def test_pause_unknown_tag_is_noop(self):
+        mock_job = make_mock_job()
+        with mock_datetime(2014, 6, 28, 12, 0):
+            every().minute.do(mock_job).tag("a")
+            schedule.pause("nope")
+            schedule.resume("nope")
+        with mock_datetime(2014, 6, 28, 12, 1):
+            schedule.run_pending()
+        assert mock_job.call_count == 1
+
+    def test_pause_multiple_tags_and_scheduler_instance(self):
+        s = schedule.Scheduler()
+        m = make_mock_job()
+        with mock_datetime(2014, 6, 28, 12, 0):
+            job = s.every().minute.do(m).tag("a", "b")
+            s.pause("b")
+            assert job.paused
+            s.resume("b")
+            assert not job.paused
+
+    def test_get_jobs_for(self):
+        def foo(*args):
+            pass
+
+        def bar():
+            pass
+
+        j1 = every().second.do(foo)
+        j2 = every().minute.do(foo, 1, 2)
+        j3 = every().hour.do(bar)
+
+        assert schedule.default_scheduler.get_jobs_for(foo) == [j1, j2]
+        assert schedule.default_scheduler.get_jobs_for(bar) == [j3]
+        assert schedule.default_scheduler.get_jobs_for(lambda: None) == []
+
+        schedule.cancel_job(j1)
+        assert schedule.default_scheduler.get_jobs_for(foo) == [j2]
+
+    def test_get_jobs_for_bound_method(self):
+        class Worker:
+            def work(self):
+                pass
+
+        w = Worker()
+        job = every().second.do(w.work)
+        assert schedule.default_scheduler.get_jobs_for(w.work) == [job]
+        assert schedule.default_scheduler.get_jobs_for(Worker().work) == []
+
