diff --git a/test_schedule.py b/test_schedule.py
index f497826..4ee9eb5 100644
--- a/test_schedule.py
+++ b/test_schedule.py
@@ -1569,6 +1569,66 @@ class SchedulerTests(TestCase):
         schedule.clear()
         assert len(schedule.jobs) == 0
 
+    def test_get_jobs_for(self):
+        def foo(*args):
+            pass
+
+        def bar():
+            pass
+
+        scheduler = schedule.Scheduler()
+        job1 = scheduler.every().second.do(foo)
+        job2 = scheduler.every().minute.do(foo, 1, 2)
+        job3 = scheduler.every().hour.do(bar)
+
+        assert scheduler.get_jobs_for(foo) == [job1, job2]
+        assert scheduler.get_jobs_for(bar) == [job3]
+        assert scheduler.get_jobs_for(lambda: None) == []
+
+        # Found jobs can be cancelled without holding on to them.
+        for job in scheduler.get_jobs_for(foo):
+            scheduler.cancel_job(job)
+        assert scheduler.jobs == [job3]
+
+    def test_pause_and_resume_by_tag(self):
+        mock_job = make_mock_job()
+        other_job = make_mock_job(name="other")
+        with mock_datetime(2024, 1, 1, 12, 0, 0):
+            scheduler = schedule.Scheduler()
+            job = scheduler.every().minute.do(mock_job).tag("maint")
+            other = scheduler.every().minute.do(other_job).tag("other")
+            scheduler.pause("maint")
+            assert job.paused and not other.paused
+
+        with mock_datetime(2024, 1, 1, 12, 5, 0):
+            scheduler.run_pending()
+            assert mock_job.call_count == 0
+            assert other_job.call_count == 1
+            assert job in scheduler.jobs  # still scheduled
+
+            scheduler.resume("maint")
+            assert not job.paused
+            scheduler.run_pending()
+            assert mock_job.call_count == 1
+
+    def test_pause_unknown_tag_is_noop(self):
+        scheduler = schedule.Scheduler()
+        job = scheduler.every().minute.do(make_mock_job())
+        scheduler.pause("nope")
+        scheduler.resume("nope")
+        assert not job.paused
+
+    def test_pause_resume_default_scheduler(self):
+        mock_job = make_mock_job()
+        every().second.do(mock_job).tag("t")
+        schedule.pause("t")
+        with mock_datetime(2100, 1, 1, 0, 0, 0):
+            schedule.run_pending()
+            assert mock_job.call_count == 0
+            schedule.resume("t")
+            schedule.run_pending()
+            assert mock_job.call_count == 1
+
     def test_clear_by_tag(self):
         every().second.do(make_mock_job(name="job1")).tag("tag1")
         every().second.do(make_mock_job(name="job2")).tag("tag1", "tag2")
