+    def get_jobs_for(self, func: Callable) -> List["Job"]:
+        """
+        Gets scheduled jobs that run the given function, regardless of
+        the arguments they were scheduled with.
+
+        :param func: The function that was passed to :meth:`Job.do`
+        """
+        return [
+            job
+            for job in self.jobs
+            if job.job_func is not None and job.job_func.func == func
+        ]
+
+    def pause(self, tag: Hashable) -> None:
+        """
+        Pause all jobs marked with the given tag. Paused jobs stay
+        scheduled but are skipped by :meth:`run_pending` until resumed.
+        :meth:`run_all` still runs them.
+
+        :param tag: An identifier used to identify a subset of
+                    jobs to pause
+        """
+        logger.debug('Pausing all jobs tagged "%s"', tag)
+        for job in self.get_jobs(tag):
+            job.paused = True
+
+    def resume(self, tag: Hashable) -> None:
+        """
+        Resume all paused jobs marked with the given tag. A job whose
+        scheduled time passed while paused runs on the next
+        :meth:`run_pending`, once (missed runs are not repeated).
+
+        :param tag: An identifier used to identify a subset of
+                    jobs to resume
+        """
+        logger.debug('Resuming all jobs tagged "%s"', tag)
+        for job in self.get_jobs(tag):
+            job.paused = False
+
