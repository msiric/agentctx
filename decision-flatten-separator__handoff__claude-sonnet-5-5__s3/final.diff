+    def test_flatten(self):
+        d = self.dict_class({'db': {'host': 'x', 'port': 1}, 'name': 'svc'})
+        flat = d.flatten()
+        self.assertEqual(flat, {'db__host': 'x', 'db__port': 1,
+                                'name': 'svc'})
+        self.assertIs(type(flat), dict)
+
+    def test_flatten_deep_and_lists(self):
+        d = self.dict_class()
+        d.a.b.c = 1
+        d.a.seq = [1, {'k': 2}]
+        d.a.pair = (self.dict_class({'z': 1}),)
+        flat = d.flatten()
+        self.assertEqual(flat['a__b__c'], 1)
+        self.assertEqual(flat['a__seq'], [1, {'k': 2}])
+        self.assertEqual(flat['a__pair'], ({'z': 1},))
+        self.assertIs(type(flat['a__pair'][0]), dict)
+        self.assertEqual(len(flat), 3)
+
+    def test_flatten_custom_separator_and_empty(self):
+        d = self.dict_class({'a': {'b': 1}, 'e': {}, 5: {'x': 2}})
+        self.assertEqual(d.flatten('.'), {'a.b': 1, 'e': {}, '5.x': 2})
+        self.assertEqual(self.dict_class().flatten(), {})
+
+    def test_flatten_does_not_mutate(self):
+        d = self.dict_class({'a': {'b': 1}})
+        d.flatten()
