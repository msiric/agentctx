@@ -218,6 +218,30 @@ class AbstractTestsClass(object):
         self.assertIsInstance(regular['a'], tuple)
         self.assertNotIsInstance(regular['a'][0], self.dict_class)
 
+    def test_to_dict_with_nested_lists(self):
+        nested = {'a': [[{'b': 1}], ({'c': [{'d': 2}]},)]}
+        prop = self.dict_class(nested)
+        regular = prop.to_dict()
+        self.assertEqual(regular, nested)
+        self.assertNotIsInstance(regular['a'][0][0], self.dict_class)
+        self.assertIsInstance(regular['a'][1], tuple)
+        self.assertNotIsInstance(regular['a'][1][0], self.dict_class)
+        self.assertNotIsInstance(regular['a'][1][0]['c'][0], self.dict_class)
+
+    def test_flatten(self):
+        d = self.dict_class({'db': {'host': 'x', 'port': 1}, 'debug': True})
+        flat = d.flatten()
+        self.assertEqual(flat, {'db__host': 'x', 'db__port': 1,
+                                'debug': True})
+        self.assertIs(type(flat), dict)
+
+    def test_flatten_deep_and_lists(self):
+        d = self.dict_class({'a': {'b': {'c': [{'d': 1}, 2]}}, 'e': ()})
+        self.assertEqual(d.flatten(), {'a__b__c': [{'d': 1}, 2], 'e': ()})
+
+    def test_flatten_empty(self):
+        self.assertEqual(self.dict_class().flatten(), {})
+
     def test_update(self):
         old = self.dict_class()
         old.child.a = 'a'
