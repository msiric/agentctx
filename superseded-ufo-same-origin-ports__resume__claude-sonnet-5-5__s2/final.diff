+
+/**
+ * Checks if two URLs have the same origin (protocol, hostname and port).
+ *
+ * Path, query, hash and credentials are ignored. Default ports are normalized
+ * (`https://a.com:443` equals `https://a.com`). Relative URLs have no origin
+ * of their own: two relative URLs are considered the same, but a relative URL
+ * never matches an absolute (or protocol-relative) one. Opaque origins
+ * (`data:`, `javascript:`, `mailto:`...) never match.
+ *
+ * @example
+ *
+ * ```js
+ * isSameOrigin("https://a.com/x", "https://a.com:443/y"); // true
+ * isSameOrigin("https://a.com", "http://a.com"); // false
+ * ```
+ *
+ * @group utils
+ */
+export function isSameOrigin(a: string, b: string): boolean {
+  const oa = _originOf(a);
+  const ob = _originOf(b);
+  if (oa === undefined || ob === undefined) {
+    return false;
+  }
+  return oa === ob;
+}
+
+// Returns "" for relative, a string origin, or undefined for opaque/invalid.
+function _originOf(input = ""): string | undefined {
+  const str = String(input).trim();
+  const isProtocolRelative = /^[/\\]{2}/.test(str);
+  if (!isProtocolRelative && !hasProtocol(str)) {
+    return "";
+  }
+  try {
+    const url = new URL(isProtocolRelative ? "http:" + str : str);
+    if (url.origin === "null") {
+      return undefined;
+    }
+    // Protocol-relative: protocol is unknown, so compare host and port only
+    return isProtocolRelative ? "//" + url.host : url.origin;
+  } catch {
+    return undefined;
+  }
+}
