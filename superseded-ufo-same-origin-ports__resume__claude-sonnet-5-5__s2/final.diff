diff --git a/test/same-origin.test.ts b/test/same-origin.test.ts
new file mode 100644
index 0000000..e22e69d
--- /dev/null
+++ b/test/same-origin.test.ts
@@ -0,0 +1,114 @@
+import { describe, expect, test } from "vitest";
+import { isSameOrigin } from "../src";
+
+// Origin = protocol + hostname + port (path, query, hash, credentials ignored).
+// Default ports (:443 for https, :80 for http) are equivalent to no port.
+describe("isSameOrigin", () => {
+  const sameOrigin = [
+    // Identical
+    ["https://example.com", "https://example.com"],
+    // Path, query, hash are ignored
+    ["https://example.com", "https://example.com/"],
+    ["https://example.com/foo", "https://example.com/bar"],
+    ["https://example.com/?a=1", "https://example.com/?b=2"],
+    ["https://example.com/#a", "https://example.com/#b"],
+    // Credentials are not part of the origin
+    ["https://user:pass@example.com/", "https://example.com/"],
+    // Protocol and host are case-insensitive
+    ["HTTPS://EXAMPLE.COM/", "https://example.com/"],
+    // Default ports are normalized (CDN rewrites links with explicit ports)
+    ["https://example.com:443/", "https://example.com/"],
+    ["http://example.com:80/", "http://example.com/"],
+    // Explicit non-default ports match each other
+    ["http://localhost:3000/a", "http://localhost:3000/b"],
+    // IDN / punycode hosts are equivalent
+    ["https://тест.com/", "https://xn--e1aybc.com/"],
+  ];
+
+  const differentOrigin = [
+    // Protocol
+    ["http://example.com", "https://example.com"],
+    // Host
+    ["https://example.com", "https://example.org"],
+    // Subdomains are different origins
+    ["https://example.com", "https://www.example.com"],
+    ["https://a.example.com", "https://b.example.com"],
+    // Port
+    ["https://example.com:8080/", "https://example.com/"],
+    ["http://localhost:3000/", "http://localhost:4000/"],
+    // A default port of another protocol is not a default here
+    ["http://example.com:443/", "http://example.com/"],
+    ["https://example.com:80/", "https://example.com/"],
+    // Lookalike hosts (userinfo trick)
+    ["https://example.com@evil.com/", "https://example.com/"],
+    ["https://example.com.evil.com/", "https://example.com/"],
+  ];
+
+  for (const [a, b] of sameOrigin) {
+    test(`${a} == ${b}`, () => {
+      expect(isSameOrigin(a, b)).toBe(true);
+      expect(isSameOrigin(b, a)).toBe(true);
+    });
+  }
+
+  for (const [a, b] of differentOrigin) {
+    test(`${a} != ${b}`, () => {
+      expect(isSameOrigin(a, b)).toBe(false);
+      expect(isSameOrigin(b, a)).toBe(false);
+    });
+  }
+
+  // --- Relative / protocol-relative inputs (OPEN QUESTIONS, proposed answers) ---
+
+  describe("relative inputs", () => {
+    // A relative URL has no origin of its own, so it is never "same" as an
+    // absolute one; two relative URLs share the (unknown) base origin.
+    test("relative vs absolute is false", () => {
+      expect(isSameOrigin("/foo", "https://example.com/foo")).toBe(false);
+      expect(isSameOrigin("https://example.com/foo", "/foo")).toBe(false);
+    });
+
+    test("relative vs relative is true", () => {
+      expect(isSameOrigin("/foo", "/bar")).toBe(true);
+      expect(isSameOrigin("foo", "./bar?x=1")).toBe(true);
+    });
+
+    test("protocol-relative compares host and port only", () => {
+      expect(isSameOrigin("//example.com/a", "//example.com/b")).toBe(true);
+      expect(isSameOrigin("//example.com/a", "//example.org/a")).toBe(false);
+    });
+
+    test("protocol-relative vs absolute is false (protocol unknown)", () => {
+      expect(isSameOrigin("//example.com/", "https://example.com/")).toBe(
+        false,
+      );
+    });
+  });
+
+  // --- Opaque / non-hierarchical origins ---
+
+  describe("opaque origins", () => {
+    test("never same origin, even with themselves", () => {
+      expect(isSameOrigin("data:text/plain,hi", "data:text/plain,hi")).toBe(
+        false,
+      );
+      expect(isSameOrigin("javascript:alert(1)", "javascript:alert(1)")).toBe(
+        false,
+      );
+      expect(isSameOrigin("mailto:a@b.com", "mailto:a@b.com")).toBe(false);
+    });
+  });
+
+  // --- Empty / invalid inputs ---
+
+  describe("empty and invalid inputs", () => {
+    test("empty strings are both relative, so same", () => {
+      expect(isSameOrigin("", "")).toBe(true);
+    });
+
+    test("undefined/empty vs absolute is false", () => {
+      expect(isSameOrigin("", "https://example.com")).toBe(false);
+      expect(isSameOrigin(undefined as any, "https://example.com")).toBe(false);
+    });
+  });
+});
