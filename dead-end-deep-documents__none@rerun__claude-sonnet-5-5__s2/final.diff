@@ -632,6 +632,31 @@ def unparse(input_dict, output=None, encoding='utf-8', full_document=True,
         return value
 
 
+def drop_keys(doc, names):
+    """Return a copy of ``doc`` with every key in ``names`` removed at any depth.
+
+    Works on parsed documents (nested dicts and lists), including attribute
+    keys such as ``'@id'``. Keys are matched exactly, so include the
+    ``attr_prefix`` for attributes. ``names`` may be a single string or an
+    iterable of strings. The input is never mutated; dicts and lists are
+    rebuilt (dict subclasses such as ``OrderedDict`` are preserved), while
+    leaf values are shared.
+    """
+    if isinstance(names, (str, bytes)):
+        names = (names,)
+    names = frozenset(names)
+
+    def walk(node):
+        if isinstance(node, dict):
+            return type(node)((k, walk(v)) for k, v in node.items()
+                              if k not in names)
+        if isinstance(node, (list, tuple)):
+            return type(node)(walk(v) for v in node)
+        return node
+
+    return walk(doc)
+
+
