+/**
+ * Format a number with a fixed count of decimals, cutting off extra digits
+ * instead of rounding. Uses the exact decimal expansion of the double.
+ *
+ * @param {number} val
+ * @param {number} places
+ * @returns {string}
+ * @private
+ */
+
+function truncate(val, places) {
+  var full = Math.abs(val) < 1e21 && places < 100 ? val.toFixed(100) : null;
+
+  if (full === null) {
+    return val.toFixed(places);
+  }
+
+  var dot = full.indexOf('.');
+  var out = full.slice(0, places > 0 ? dot + 1 + places : dot);
+
+  // avoid "-0" when everything cut off was non-zero
+  if (out.charAt(0) === '-' && !/[1-9]/.test(out)) {
+    out = out.slice(1);
+  }
+
+  return out;
+}
