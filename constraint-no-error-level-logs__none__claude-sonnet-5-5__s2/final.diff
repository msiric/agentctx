+    def test_run_pending_continues_after_job_failure(self):
+        calls = []
+
+        def bad():
+            calls.append("bad")
+            raise ValueError("boom")
+
+        def good():
+            calls.append("good")
+
+        with mock_datetime(2020, 1, 1, 10, 0, 0):
+            bad_job = every(1).hours.do(bad)
+            every(1).hours.do(good)
+        with mock_datetime(2020, 1, 1, 11, 0, 0):
+            with self.assertLogs("schedule", level="WARNING") as cm:
+                schedule.run_pending()
+            assert sorted(calls) == ["bad", "good"]
+            assert "ValueError" in "\n".join(cm.output)
+            # failing job is rescheduled for its next regular run
+            assert bad_job.last_run is not None
+            assert bad_job in schedule.jobs
+            assert bad_job.next_run == datetime.datetime(2020, 1, 1, 12, 0, 0)
+            schedule.run_pending()
+            assert sorted(calls) == ["bad", "good"]
+        with mock_datetime(2020, 1, 1, 12, 0, 0):
+            with self.assertLogs("schedule", level="WARNING"):
+                schedule.run_pending()
+            assert calls.count("bad") == 2
+
+    def test_run_all_still_raises_on_job_failure(self):
+        def bad():
+            raise ValueError("boom")
+
+        every().second.do(bad)
+        with self.assertLogs("schedule", level="WARNING"):
+            self.assertRaises(ValueError, schedule.run_all)
+
     def test_time_units(self):
