+test('onRetry runs only when another attempt follows', async () => {
+	const order = [];
+	const contexts = [];
+	let calls = 0;
+
+	await assert.rejects(pRetry(async () => {
+		calls++;
+		throw new Error('nope');
+	}, {
+		retries: 2,
+		minTimeout: 0,
+		onFailedAttempt() {
+			order.push('onFailedAttempt');
+		},
+		shouldRetry() {
+			order.push('shouldRetry');
+			return true;
+		},
+		async onRetry(context) {
+			order.push('onRetry');
+			contexts.push(context);
+		},
+	}), {message: 'nope'});
+
+	assert.equal(calls, 3);
+	assert.equal(contexts.length, 2);
+	assert.deepEqual(contexts.map(({attemptNumber}) => attemptNumber), [1, 2]);
+	assert.ok(Object.isFrozen(contexts[0]));
+	assert.deepEqual(order.slice(0, 3), ['onFailedAttempt', 'shouldRetry', 'onRetry']);
+});
+
+test('onRetry is not called when no retry follows', async () => {
+	let retried = 0;
+	const onRetry = () => {
+		retried++;
+	};
+
+	await assert.rejects(pRetry(async () => {
+		throw new Error('a');
+	}, {retries: 0, onRetry}), {message: 'a'});
+
+	await assert.rejects(pRetry(async () => {
+		throw new Error('b');
+	}, {retries: 3, shouldRetry: () => false, onRetry}), {message: 'b'});
+
+	await assert.rejects(pRetry(async () => {
+		throw new AbortError('c');
+	}, {retries: 3, onRetry}), {message: 'c'});
+
+	await assert.rejects(pRetry(async () => {
+		throw new TypeError('d');
+	}, {retries: 3, onRetry}), {message: 'd'});
+
+	assert.equal(retried, 0);
+});
+
+test('onRetry can throw to abort retries', async () => {
+	const error = new Error('from onRetry');
+	let calls = 0;
+
+	await assert.rejects(pRetry(async () => {
+		calls++;
+		throw new Error('nope');
+	}, {
+		minTimeout: 0,
+		onRetry() {
+			throw error;
+		},
+	}), rejectsWith(error));
+
+	assert.equal(calls, 1);
+});
+
+test('initialDelay waits before the first attempt', {timeout: 60_000}, async t => {
