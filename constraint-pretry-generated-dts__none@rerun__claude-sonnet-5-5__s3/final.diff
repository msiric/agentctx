+	await pRetry(async () => {
+		firstAttemptAt = performance.now() - start;
+	}, {initialDelay: 500});
+
+	assert.ok(firstAttemptAt >= 500);
+});
+
+test('initialDelay defaults to no wait and null uses the default', async () => {
+	let calls = 0;
+	await pRetry(async () => {
