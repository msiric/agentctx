+    def test_flatten(self):
+        d = self.dict_class({'a': 1, 'b': {'c': 2, 'd': {'e': 3}}})
+        flat = d.flatten()
+        self.assertIs(type(flat), dict)
+        self.assertEqual(flat, {'a': 1, 'b.c': 2, 'b.d.e': 3})
+
+    def test_flatten_keeps_lists_as_leaves(self):
+        d = self.dict_class({'a': [{'b': 1}, 2], 'c': ({'d': 1},)})
+        self.assertEqual(d.flatten(), {'a': [{'b': 1}, 2], 'c': ({'d': 1},)})
