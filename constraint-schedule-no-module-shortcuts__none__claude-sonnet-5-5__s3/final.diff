+    def pause(self, tag: Hashable) -> None:
+        """
+        Pauses all jobs marked with the given tag. Paused jobs stay
+        scheduled but are skipped by :meth:`run_pending` until they are
+        resumed with :meth:`resume`. Pausing an already paused job has
+        no effect.
+
+        Note that :meth:`run_all` still runs paused jobs, since it runs
+        jobs regardless of their schedule.
+
+        :param tag: An identifier used to identify a subset of
+                    jobs to pause
+        """
+        logger.debug('Pausing all jobs tagged "%s"', tag)
+        for job in self.get_jobs(tag):
+            job.paused = True
+
+    def resume(self, tag: Hashable) -> None:
+        """
+        Resumes all paused jobs marked with the given tag. Runs that
+        came due while a job was paused are not replayed: a resumed job
+        whose ``next_run`` has passed runs once on the next
+        :meth:`run_pending` call and is then rescheduled as usual.
+
+        :param tag: An identifier used to identify a subset of
+                    jobs to resume
+        """
+        logger.debug('Resuming all jobs tagged "%s"', tag)
+        for job in self.get_jobs(tag):
+            job.paused = False
+
