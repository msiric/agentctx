+        def foo():
+            pass
+
+        def bar():
+            pass
+
+        class Greeter:
+            def hi(self):
+                pass
+
+        g = Greeter()
+        s = schedule.Scheduler()
+        j1 = s.every().second.do(foo)
+        j2 = s.every().minute.do(foo, 1, x=2)
+        j3 = s.every().second.do(bar)
+        j4 = s.every().second.do(g.hi)
+
+        assert s.get_jobs_for(foo) == [j1, j2]
