index f497826..aa5d9e4 100644
--- a/test_schedule.py
+++ b/test_schedule.py
@@ -1569,6 +1569,80 @@ class SchedulerTests(TestCase):
         schedule.clear()
         assert len(schedule.jobs) == 0
 
+    def test_get_jobs_for(self):
+        sched = schedule.Scheduler()
+
+        def a():
+            pass
+
+        def b():
+            pass
+
+        job1 = sched.every().second.do(a)
+        job2 = sched.every().minute.do(a, 1, x=2)
+        job3 = sched.every().second.do(b)
+        sched.every().second  # unfinished job without a function
+
+        assert sched.get_jobs_for(a) == [job1, job2]
+        assert sched.get_jobs_for(b) == [job3]
+        assert sched.get_jobs_for(lambda: None) == []
+
+        sched.cancel_job(job2)
+        assert sched.get_jobs_for(a) == [job1]
+
+    def test_get_jobs_for_bound_method(self):
+        class C:
+            def m(self):
+                pass
+
+        sched = schedule.Scheduler()
+        c = C()
+        job = sched.every().second.do(c.m)
+        assert sched.get_jobs_for(c.m) == [job]
+        assert sched.get_jobs_for(C().m) == []
+
+    def test_pause_and_resume_by_tag(self):
+        mock_job = make_mock_job()
+        paused = every().second.do(mock_job).tag("maintenance")
+        other = every().second.do(mock_job).tag("other")
+        with mock_datetime(2024, 1, 1, 0, 0, 0):
+            paused._schedule_next_run()
+            other._schedule_next_run()
+        with mock_datetime(2024, 1, 1, 0, 0, 5):
+            schedule.pause("maintenance")
+            assert paused.paused and not other.paused
+            schedule.run_pending()
+            assert mock_job.call_count == 1
+            assert paused.last_run is None
+            assert other.last_run is not None
+            assert len(schedule.jobs) == 2
+
+            schedule.resume("maintenance")
+            assert not paused.paused
+            schedule.run_pending()
+            assert paused.last_run is not None
+            assert mock_job.call_count == 2
+
+    def test_pause_unknown_tag_is_noop(self):
+        every().second.do(make_mock_job())
+        schedule.pause("nope")
+        schedule.resume("nope")
+        assert not schedule.jobs[0].paused
+
+    def test_pause_does_not_replay_missed_runs(self):
+        mock_job = make_mock_job()
+        job = every().second.do(mock_job).tag("t")
+        with mock_datetime(2024, 1, 1, 0, 0, 0):
+            job._schedule_next_run()
+            schedule.pause("t")
+        with mock_datetime(2024, 1, 1, 0, 10, 0):
+            schedule.run_pending()
+            assert mock_job.call_count == 0
+            schedule.resume("t")
+            schedule.run_pending()
+            schedule.run_pending()
+            assert mock_job.call_count == 1
+
