+    def pause(self, tag: Hashable) -> None:
+        """
+        Pause all jobs marked with the given tag. Paused jobs stay
+        scheduled but are skipped by :meth:`run_pending` until resumed.
+
+        Note that :meth:`run_all` still runs paused jobs.
+
+        :param tag: An identifier used to identify a subset of jobs to pause
+        """
+        logger.debug('Pausing all jobs tagged "%s"', tag)
+        for job in self.get_jobs(tag):
+            job.paused = True
+
+    def resume(self, tag: Hashable) -> None:
+        """
+        Resume all paused jobs marked with the given tag. A resumed job whose
+        scheduled time passed while it was paused runs on the next
+        :meth:`run_pending` call (once, missed runs are not replayed).
+
+        :param tag: An identifier used to identify a subset of jobs to resume
+        """
+        logger.debug('Resuming all jobs tagged "%s"', tag)
+        for job in self.get_jobs(tag):
+            job.paused = False
+
