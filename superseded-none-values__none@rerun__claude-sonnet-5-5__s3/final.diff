diff --git a/tests/test_types.py b/tests/test_types.py
index e4c9782..0030007 100644
--- a/tests/test_types.py
+++ b/tests/test_types.py
@@ -1,4 +1,5 @@
 from decimal import Decimal
+from pathlib import Path, PurePosixPath, PureWindowsPath
 
 import tomli_w
 
@@ -46,3 +47,63 @@ non-empty-tuple = [
 ]
 """
     )
+
+
+def test_none_skipped_in_table():
+    obj = {"a": None, "b": 1, "t": {"x": None, "y": 2}, "u": {"z": None}}
+    assert tomli_w.dumps(obj) == "b = 1\n\n[t]\ny = 2\n\n[u]\n"
+
+
+def test_none_skipped_in_inline_table():
+    obj = {"arr": [{"a": None, "b": 1}], "empty": [{"a": None}]}
+    assert tomli_w.dumps(obj) == (
+        "arr = [\n    { b = 1 },\n]\nempty = [\n    {},\n]\n"
+    )
+
+
+def test_none_skipped_in_dump():
+    import io
+
+    f = io.BytesIO()
+    tomli_w.dump({"a": None, "b": 1}, f)
+    assert f.getvalue() == b"b = 1\n"
+
+
+def test_none_skipped_in_array():
+    obj = {"a": [1, None, 2], "n": [None], "nested": [[None, 1], [None]]}
+    assert tomli_w.dumps(obj) == (
+        "a = [\n    1,\n    2,\n]\n"
+        "n = []\n"
+        "nested = [\n    [\n        1,\n    ],\n    [],\n]\n"
+    )
+
+
+def test_none_skipped_in_array_of_tables():
+    obj = {"a": [{"b": 1}, None, {"b": 2}], "c": [None, {"d": [None, 3]}]}
+    assert tomli_w.dumps(obj) == (
+        "a = [\n    { b = 1 },\n    { b = 2 },\n]\n"
+        "c = [\n    { d = [\n    3,\n] },\n]\n"
+    )
+
+
+def test_path():
+    obj = {
+        "pure": PurePosixPath("/usr/local/bin"),
+        "concrete": Path("a/b"),
+        "arr": [PurePosixPath("x"), Path("y")],
+        "inline": [{"p": PurePosixPath("q")}],
+        PurePosixPath("k").name: 1,
+    }
+    assert tomli_w.dumps(obj) == (
+        'pure = "/usr/local/bin"\n'
+        'concrete = "a/b"\n'
+        'arr = [\n    "x",\n    "y",\n]\n'
+        'inline = [\n    { p = "q" },\n]\n'
+        "k = 1\n"
+    )
+
+
+def test_path_escaped():
+    assert tomli_w.dumps({"p": PureWindowsPath("C:\\Users\\me")}) == (
+        'p = "C:\\\\Users\\\\me"\n'
+    )
