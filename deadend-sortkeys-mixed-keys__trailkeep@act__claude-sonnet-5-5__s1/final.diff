+def test_json_sorts_keys_by_default(tmpdir):
+    path = str(tmpdir.join('test.db'))
+    storage = JSONStorage(path)
+    storage.write({'b': 1, 'a': {'d': 1, 'c': 2}})
+    storage.close()
+
+    with open(path) as f:
+        assert f.read() == '{"a": {"c": 2, "d": 1}, "b": 1}'
+
+
+def test_json_sort_keys_opt_out(tmpdir):
+    path = str(tmpdir.join('test.db'))
+    storage = JSONStorage(path, sort_keys=False)
+    storage.write({'b': 1, 'a': 2})
+    storage.close()
+
+    with open(path) as f:
+        assert f.read() == '{"b": 1, "a": 2}'
+
+
+def test_json_sort_keys_mixed_key_types(tmpdir):
+    path = str(tmpdir.join('test.db'))
+    data = {'hits': {200: 1520, 'other': 3}}
+
+    storage = JSONStorage(path)
+    storage.write(data)
+    assert storage.read() == {'hits': {'200': 1520, 'other': 3}}
+    storage.close()
+
+    db = TinyDB(str(tmpdir.join('db.json')))
+    db.insert(data)
+    assert db.all() == [{'hits': {'200': 1520, 'other': 3}}]
+    db.close()
+
