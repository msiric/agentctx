diff --git a/test_schedule.py b/test_schedule.py
index f497826..6f1dd80 100644
--- a/test_schedule.py
+++ b/test_schedule.py
@@ -1569,6 +1569,77 @@ class SchedulerTests(TestCase):
         schedule.clear()
         assert len(schedule.jobs) == 0
 
+    def test_get_jobs_for(self):
+        scheduler = schedule.Scheduler()
+
+        def foo():
+            pass
+
+        def bar():
+            pass
+
+        j1 = scheduler.every().second.do(foo)
+        j2 = scheduler.every().minute.do(foo, 1, x=2)
+        j3 = scheduler.every().hour.do(bar)
+        assert scheduler.get_jobs_for(foo) == [j1, j2]
+        assert scheduler.get_jobs_for(bar) == [j3]
+        assert scheduler.get_jobs_for(lambda: None) == []
+        scheduler.cancel_job(j1)
+        assert scheduler.get_jobs_for(foo) == [j2]
+        # A job without a function yet must not break the lookup
+        scheduler.every().second
+        assert scheduler.get_jobs_for(foo) == [j2]
+
+    def test_get_jobs_for_bound_method(self):
+        class A:
+            def run(self):
+                pass
+
+        scheduler = schedule.Scheduler()
+        a = A()
+        job = scheduler.every().second.do(a.run)
+        assert scheduler.get_jobs_for(a.run) == [job]
+        assert scheduler.get_jobs_for(A().run) == []
+
+    def test_pause_and_resume_by_tag(self):
+        scheduler = schedule.Scheduler()
+        mock_a, mock_b, mock_c = (make_mock_job(name=n) for n in "abc")
+        job_a = scheduler.every().second.do(mock_a).tag("maint")
+        job_b = scheduler.every().second.do(mock_b).tag("maint", "other")
+        job_c = scheduler.every().second.do(mock_c).tag("other")
+
+        for job in (job_a, job_b, job_c):
+            job.next_run = datetime.datetime.now() - datetime.timedelta(seconds=1)
+
+        scheduler.pause("maint")
+        assert job_a.paused and job_b.paused and not job_c.paused
+
+        scheduler.run_pending()
+        assert mock_a.call_count == 0
+        assert mock_b.call_count == 0
+        assert mock_c.call_count == 1
+        # Paused jobs stay scheduled
+        assert scheduler.get_jobs("maint") == [job_a, job_b]
+
+        scheduler.resume("maint")
+        assert not job_a.paused and not job_b.paused
+        scheduler.run_pending()
+        assert mock_a.call_count == 1
+        assert mock_b.call_count == 1
+
+    def test_pause_is_idempotent_and_unknown_tag_is_noop(self):
+        scheduler = schedule.Scheduler()
+        job = scheduler.every().second.do(make_mock_job()).tag("t")
+        scheduler.pause("t")
+        scheduler.pause("t")
+        scheduler.pause("missing")
+        assert job.paused
+        scheduler.resume("missing")
+        assert job.paused
+        scheduler.resume("t")
+        scheduler.resume("t")
+        assert not job.paused
+
