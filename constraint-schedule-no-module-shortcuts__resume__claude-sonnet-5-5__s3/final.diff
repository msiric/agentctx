+    def get_jobs_for(self, func: Callable) -> List["Job"]:
+        """
+        Gets all scheduled jobs that run the given function.
+
+        Jobs are matched on the function passed to :meth:`Job.do`,
+        regardless of the arguments it was scheduled with.
+
+        :param func: The function that was passed to ``do()``
+        """
+        return [
+            job
+            for job in self.jobs
+            if job.job_func is not None and job.job_func.func == func
+        ]
+
+    def pause(self, tag: Hashable) -> None:
+        """
+        Pauses all jobs marked with the given tag.
+
+        Paused jobs stay scheduled but are skipped by
+        :meth:`run_pending`. Pausing an already paused job is a no-op.
+
+        :param tag: An identifier used to identify a subset of jobs
+        """
+        for job in self.get_jobs(tag):
+            job.paused = True
+
+    def resume(self, tag: Hashable) -> None:
+        """
+        Resumes all paused jobs marked with the given tag.
+
+        Runs missed while paused are not made up: a job whose
+        ``next_run`` passed during the pause runs once on the next
+        :meth:`run_pending` and is then rescheduled as usual.
+
+        :param tag: An identifier used to identify a subset of jobs
+        """
+        for job in self.get_jobs(tag):
+            job.paused = False
+
