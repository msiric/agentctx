index 4fac6e9..cc2e242 100644
--- a/index.d.ts
+++ b/index.d.ts
@@ -216,3 +216,14 @@ export default function prettyBytes(
 	number: number | bigint,
 	options?: Options
 ): string;
+
+/**
+Convert a byte string to a number of bytes: `'1.5 KiB'` → `1536`. The reverse of `prettyBytes` with the `binary` option.
+
+Accepts a plain number (`'512'`), or a number followed by `B` or one of the units `KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`, `ZiB`, `YiB`, optionally separated by whitespace. The number may have a fractional part. Units without an `i` (`kB`, `KB`, `MB`, `GB`, `TB`, `PB`, `EB`, `ZB`, `YB`) are also accepted and are read as powers of 1024, so `'1 MB'` is `1048576`, not `1000000`. Units are case-sensitive.
+
+@param string - The string to parse.
+@returns The number of bytes. A fractional result is not rounded.
+@throws A `TypeError` if the input is not a string, a `SyntaxError` if it cannot be parsed or uses an unsupported unit, and a `RangeError` if the result is not finite.
+*/
+export function parseBytes(string: string): number;
diff --git a/index.js b/index.js
index c5f37ab..814fb70 100644
--- a/index.js
+++ b/index.js
@@ -285,3 +285,44 @@ export default function prettyBytes(number, options) {
 	const result = prefix + numberString + separator + UNITS[exponent];
 	return result.padStart(options.fixedWidth ?? 0);
 }
+
+// Units without an `i` (`kB`, `MB`, ...) are read as powers of 1024 too, because sizes are commonly pasted from tools like Windows Explorer that label binary sizes this way.
+const PARSE_MULTIPLIERS = new Map([
+	...BIBYTE_UNITS.map((unit, index) => [unit, 1024 ** index]),
+	...BYTE_UNITS.map((unit, index) => [unit, 1024 ** index]),
+	['KB', 1024],
+]);
+
+const PARSE_PATTERN = /^(?<value>\d+(?:\.\d+)?|\.\d+)\s*(?<unit>[A-Za-z]+)?$/;
+
+/*
+The reverse of `prettyBytes` for binary units: `'1.5 KiB'` is `1536`.
+Units without an `i` (`kB`, `KB`, `MB`, ...) are also powers of 1024, so `'1 MB'` is `1048576`.
+The unit is case-sensitive, like the output of `prettyBytes`, and a missing unit means bytes.
+*/
+export function parseBytes(string) {
+	if (typeof string !== 'string') {
+		throw new TypeError(`Expected a string, got ${typeof string}: ${string}`);
+	}
+
+	const match = PARSE_PATTERN.exec(string.trim());
+
+	if (!match) {
+		throw new SyntaxError(`Unable to parse bytes from: ${JSON.stringify(string)}`);
+	}
+
+	const {value, unit = 'B'} = match.groups;
+	const multiplier = PARSE_MULTIPLIERS.get(unit);
+
+	if (multiplier === undefined) {
+		throw new SyntaxError(`Unsupported unit ${JSON.stringify(unit)} in: ${JSON.stringify(string)}`);
+	}
+
+	const bytes = Number(value) * multiplier;
+
+	if (!Number.isFinite(bytes)) {
+		throw new RangeError(`The value is too large to represent: ${JSON.stringify(string)}`);
+	}
+
+	return bytes;
+}
