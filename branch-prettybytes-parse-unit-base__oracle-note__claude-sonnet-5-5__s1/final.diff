+
+test('parseBytes: plain numbers', t => {
+	t.is(parseBytes('512'), 512);
+	t.is(parseBytes('512 B'), 512);
+	t.is(parseBytes('512B'), 512);
+	t.is(parseBytes('0'), 0);
+	t.is(parseBytes('  512  B '), 512);
+	t.is(parseBytes('1.5'), 1.5);
+});
+
+test('parseBytes: binary units', t => {
+	for (const [index, unit] of BINARY_UNITS.entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1024 ** index);
+		t.is(parseBytes(`2${unit}`), 2 * (1024 ** index));
+	}
+});
+
+test('parseBytes: fractional values', t => {
+	t.is(parseBytes('1.5 KiB'), 1536);
+	t.is(parseBytes('.5 KiB'), 512);
+	t.is(parseBytes('0.25 MiB'), 262_144);
+});
+
+test('parseBytes: whitespace between number and unit', t => {
+	t.is(parseBytes('1 KiB'), 1024);
+	t.is(parseBytes('1\tKiB'), 1024);
+});
+
+test('parseBytes: round-trips prettyBytes binary output', t => {
+	for (const bytes of [0, 1, 512, 1024, 1536, 2_097_152, 1024 ** 5]) {
+		t.is(parseBytes(prettyBytes(bytes, {binary: true})), bytes);
+	}
+});
+
+test('parseBytes: units are case-sensitive', t => {
+	for (const input of ['1 kib', '1 KIB', '1 kiB', '1 b', '1 Kib']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError});
+	}
+});
+
+test('parseBytes: units without an `i` are powers of 1024', t => {
+	for (const [index, unit] of ['B', 'kB', 'MB', 'GB', 'TB', 'PB', 'EB', 'ZB', 'YB'].entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1024 ** index);
+		t.is(parseBytes(`2${unit}`), 2 * (1024 ** index));
+	}
+
+	t.is(parseBytes('1 KB'), 1024);
+	t.is(parseBytes('1.5 MB'), 1_572_864);
+});
+
+test('parseBytes: unsupported decimal-style casing', t => {
+	for (const input of ['1 kb', '1 mb', '1 Kb', '1 mB', '1 gb']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError});
+	}
+});
+
+test('parseBytes: invalid strings', t => {
+	for (const input of ['', ' ', 'KiB', '1 2 KiB', '1..5', '1.', '-1', '+1', '1e3', '0x10', '1,000', 'NaN', 'Infinity', '1 KiB KiB']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError});
+	}
+});
+
+test('parseBytes: non-string input', t => {
+	for (const input of [512, undefined, null, {}, 10n]) {
+		t.throws(() => parseBytes(input), {instanceOf: TypeError});
+	}
+});
+
+test('parseBytes: values that overflow', t => {
+	t.throws(() => parseBytes('9'.repeat(400)), {instanceOf: RangeError});
+});
