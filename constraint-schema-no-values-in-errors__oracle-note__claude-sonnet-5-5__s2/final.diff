+class NonEmpty:
+    """
+    Rejects empty strings, whitespace-only strings and empty lists/dicts.
+    Any other data is returned unchanged.
+    """
+
+    def __init__(self, error: Union[str, None] = None) -> None:
+        self._error: Union[str, None] = error
+
+    def __repr__(self) -> str:
+        return f"{self.__class__.__name__}()"
+
+    def validate(self, data: Any, **kwargs: Any) -> Any:
+        """
+        Validates that data is not empty.
+        :param data: Data to be validated.
+        :return: Returns the data unchanged.
+        """
+        if isinstance(data, str):
+            empty = not data.strip()
+        elif isinstance(data, (list, dict)):
+            empty = len(data) == 0
+        else:
+            empty = False
+        if empty:
+            # Never include the data in the message: it may be sensitive.
+            raise SchemaError(self._error if self._error else "value is empty")
+        return data
+
+
+class Range:
+    """
+    Validates that a number (int or float, not bool) lies within the
+    inclusive bounds ``min`` and ``max``. Either bound may be None.
+    """
+
+    def __init__(
+        self,
+        min: Union[int, float, None] = None,
+        max: Union[int, float, None] = None,
+        error: Union[str, None] = None,
+    ) -> None:
+        if min is not None and max is not None and min > max:
+            raise ValueError("min must not be greater than max")
+        self._min = min
+        self._max = max
+        self._error: Union[str, None] = error
+
+    def __repr__(self) -> str:
+        return f"{self.__class__.__name__}(min={self._min!r}, max={self._max!r})"
+
+    def validate(self, data: Any, **kwargs: Any) -> Any:
+        """
+        Validates that data is a number within the bounds.
+        :param data: Data to be validated.
+        :return: Returns the data unchanged.
+        """
+        # Never include the data in the messages: it may be sensitive.
+        if isinstance(data, bool) or not isinstance(data, (int, float)):
+            raise SchemaError(self._error if self._error else "value is not a number")
+        # Written as negated comparisons so that NaN is rejected.
+        if (self._min is not None and not data >= self._min) or (
+            self._max is not None and not data <= self._max
+        ):
+            raise SchemaError(
+                self._error
+                if self._error
+                else f"value is out of range (min={self._min!r}, max={self._max!r})"
+            )
+        return data
+
+
+class OneOf:
+    """
+    Validates that data equals one of the given choices.
+    """
+
+    def __init__(self, *choices: Any, error: Union[str, None] = None) -> None:
+        self._choices = choices
+        self._error: Union[str, None] = error
+
+    def __repr__(self) -> str:
+        return f"{self.__class__.__name__}({', '.join(repr(c) for c in self._choices)})"
+
+    def validate(self, data: Any, **kwargs: Any) -> Any:
+        """
+        Validates that data is one of the choices.
+        :param data: Data to be validated.
+        :return: Returns the data unchanged.
+        """
+        if not any(data == c for c in self._choices):
+            # Never include the data in the message: it may be sensitive.
+            raise SchemaError(
+                self._error
+                if self._error
+                else f"value is not one of the allowed choices {list(self._choices)!r}"
+            )
+        return data
+
