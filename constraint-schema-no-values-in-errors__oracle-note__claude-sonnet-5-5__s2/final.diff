+def test_oneof():
+    v = OneOf("red", "green", 3, None)
+    for ok in ("red", "green", 3, None):
+        assert v.validate(ok) == ok
+    for bad in ("blue", "RED", 4, [], {}):
+        with raises(SchemaError):
+            v.validate(bad)
+    assert Schema({"color": OneOf("red", "green")}).is_valid({"color": "red"})
+    assert not Schema({"color": OneOf("red", "green")}).is_valid({"color": "x"})
+    with raises(SchemaError) as exc_info:
+        OneOf("a", error="pick a").validate("b")
+    assert exc_info.value.code == "pick a"
+    with raises(SchemaError):
+        OneOf().validate("anything")
