+@mark.parametrize("data", ["a", " a ", "0", [0], [""], {"a": 1}, {"": None}, 0, None])
+def test_nonempty_valid(data):
+    assert NonEmpty().validate(data) is data
+    assert Schema(NonEmpty()).validate(data) is data
+
+
+@mark.parametrize("data", ["", " ", "  \t\n", [], {}])
+def test_nonempty_invalid(data):
+    with raises(SchemaError) as exc_info:
+        NonEmpty().validate(data)
+    assert exc_info.value.args[0] == "value is empty"
+    assert Schema(NonEmpty()).is_valid(data) is False
+
+
+def test_nonempty_custom_error():
+    with raises(SchemaError) as exc_info:
+        Schema(NonEmpty(error="must not be empty")).validate("  ")
+    assert exc_info.value.code == "must not be empty"
+
+
+def test_nonempty_error_never_contains_value():
+    secret = "  "
+    # the value must not leak even if the custom error has format placeholders
+    for err in (None, "bad {!r} {}"):
+        with raises(SchemaError) as exc_info:
+            Schema({"email": NonEmpty(error=err)}).validate({"email": secret})
+        assert "'  '" not in exc_info.value.code
+        assert "'  '" not in str(exc_info.value)
+
+
+def test_nonempty_in_dict_and_and():
+    s = Schema({"name": NonEmpty(), "tags": And([str], NonEmpty())})
+    data = {"name": "x", "tags": ["a"]}
+    assert s.validate(data) == data
+    assert not s.is_valid({"name": " ", "tags": ["a"]})
+    assert not s.is_valid({"name": "x", "tags": []})
+
