+def test_range_and_oneof_errors_never_contain_value():
+    for validator, bad in ((Range(1, 5), 987654), (Range(1, 5), "secret-x"), (OneOf("a", "b"), "secret-x")):
+        with raises(SchemaError) as exc_info:
+            Schema({"k": validator}).validate({"k": bad})
+        assert str(bad) not in exc_info.value.code
+        assert str(bad) not in str(exc_info.value)
+
