@@ -49,6 +49,44 @@ def test_json_kwargs(tmpdir):
     db.close()
 
 
+def test_json_sorts_keys_by_default(tmpdir):
+    path = str(tmpdir.join('test.db'))
+    storage = JSONStorage(path)
+    storage.write({'b': 1, 'a': {'z': 1, 'y': 2}})
+    storage.close()
+
+    with open(path) as f:
+        assert f.read() == '{"a": {"y": 2, "z": 1}, "b": 1}'
+
+
+def test_json_sort_keys_disabled(tmpdir):
+    path = str(tmpdir.join('test.db'))
+    storage = JSONStorage(path, sort_keys=False)
+    storage.write({'b': 1, 'a': 2})
+    storage.close()
+
+    with open(path) as f:
+        assert f.read() == '{"b": 1, "a": 2}'
+
+
+def test_json_mixed_key_types_fall_back_to_unsorted(tmpdir):
+    path = str(tmpdir.join('test.db'))
+    storage = JSONStorage(path)
+    storage.write({'hits': {200: 1520, 'other': 3}})
+    storage.close()
+
+    with open(path) as f:
+        assert json.load(f) == {'hits': {'200': 1520, 'other': 3}}
+
+
+def test_json_mixed_key_types_explicit_sort_keys_raises(tmpdir):
+    path = str(tmpdir.join('test.db'))
+    storage = JSONStorage(path, sort_keys=True)
+    with pytest.raises(TypeError):
+        storage.write({'hits': {200: 1520, 'other': 3}})
+    storage.close()
+
+
