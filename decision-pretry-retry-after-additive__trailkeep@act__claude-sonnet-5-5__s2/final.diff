@@ -132,6 +133,23 @@ const result = await pRetry(run, {
 
 In the example above, the operation will be retried unless the error is an instance of `CustomError`.
 
+##### Retry-After
+
+If the error an attempt throws has a numeric `retryAfter` property in seconds, `pRetry` waits that long _in addition to_ the normal backoff delay before the next attempt. The backoff is kept on top so that many callers released at the same moment do not all retry together.
+
+- `maxTimeout` caps the backoff only, not the `retryAfter`. The wait is still cut short by `maxRetryTime`.
+- A failure that `shouldConsumeRetry` declines to count has no backoff, but still waits out the `retryAfter`.
+- A `retryAfter` that is not a positive finite number (`NaN`, negative, `Infinity`, a string) is ignored.
+
+```js
+class RateLimitError extends Error {
+	constructor(retryAfter) {
+		super('Too many requests');
+		this.retryAfter = retryAfter; // Seconds
+	}
+}
+```
+
 ##### shouldConsumeRetry(context)
 
 Type: `Function`
diff --git a/test-timing.js b/test-timing.js
index 2361505..91edffd 100644
--- a/test-timing.js
+++ b/test-timing.js
@@ -906,3 +906,156 @@ test('unref is not applied unless the option is set', {timeout: 30_000}, async t
 
 	assert.ok(!isUnrefCalled);
 });
+
+test('context has elapsedTime since pRetry was called, for every callback', async t => {
+	const originalPerformanceNow = performance.now;
+	let now = 5000; // Not 0, so a clock that is not relative to the call is caught.
+	performance.now = () => now;
+
+	t.after(() => {
+		performance.now = originalPerformanceNow;
+	});
+
+	const seen = {shouldConsumeRetry: [], onFailedAttempt: [], shouldRetry: []};
+	let attempts = 0;
+
+	await assert.rejects(pRetry(
+		async () => {
+			attempts++;
+			now += 10; // The operation takes 10ms.
+			throw new Error('test');
+		},
+		{
+			retries: 2,
+			minTimeout: 0,
+			shouldConsumeRetry({elapsedTime}) {
+				seen.shouldConsumeRetry.push(elapsedTime);
+				now += 1;
+			},
+			onFailedAttempt({elapsedTime}) {
+				seen.onFailedAttempt.push(elapsedTime);
+				now += 2;
+			},
+			shouldRetry({elapsedTime}) {
+				seen.shouldRetry.push(elapsedTime);
+				now += 3;
+				return true;
+			},
+		},
+	), {message: 'test'});
+
+	assert.equal(attempts, 3);
+	// Each attempt costs 10 + 1 + 2 + 3 = 16ms in total. `onFailedAttempt` and `shouldRetry` share one context, so they see the same value. The last attempt has no `shouldRetry`.
+	assert.deepEqual(seen.shouldConsumeRetry, [10, 26, 42]);
+	assert.deepEqual(seen.onFailedAttempt, [11, 27, 43]);
+	assert.deepEqual(seen.shouldRetry, [11, 27]);
+});
+
+const failWith = (retryAfter, times = 1) => {
+	let calls = 0;
+	return async () => {
+		if (calls++ < times) {
+			throw Object.assign(new Error('limited'), {retryAfter});
+		}
+
+		return fixture;
+	};
+};
+
+test('retryAfter is added to the backoff delay', async t => {
+	const delays = collapseDelays(t);
+
+	assert.equal(await pRetry(failWith(2), {minTimeout: 100}), fixture);
+	assert.deepEqual(delays, [2100]);
+});
+
+test('retryAfter is added again on every attempt that carries it', async t => {
+	const delays = collapseDelays(t);
+
+	await pRetry(failWith(1, 3), {minTimeout: 100, factor: 2});
+	assert.deepEqual(delays, [1100, 1200, 1400]);
+});
+
+test('retryAfter applies with minTimeout 0', async t => {
+	const delays = collapseDelays(t);
+
+	await pRetry(failWith(1.5), {minTimeout: 0});
+	assert.deepEqual(delays, [1500]);
+});
+
+test('maxTimeout caps the backoff but not retryAfter', async t => {
+	const delays = collapseDelays(t);
+
+	await pRetry(failWith(5), {minTimeout: 1000, maxTimeout: 200});
+	assert.deepEqual(delays, [5200]);
+});
+
+test('retryAfter is cut short by maxRetryTime', async t => {
+	const delays = collapseDelays(t);
+	const originalPerformanceNow = performance.now;
+	performance.now = () => 0;
+	t.after(() => {
+		performance.now = originalPerformanceNow;
+	});
+
+	await pRetry(failWith(60), {minTimeout: 100, maxRetryTime: 3000});
+	assert.deepEqual(delays, [3000]);
+});
+
+test('retryAfter is capped at what setTimeout can hold', async t => {
+	const delays = collapseDelays(t);
+
+	await pRetry(failWith(1e9), {minTimeout: 100});
+	assert.deepEqual(delays, [(2 ** 31) - 1]);
+});
+
+test('invalid retryAfter values are ignored', async t => {
+	const delays = collapseDelays(t);
+
+	for (const value of [NaN, -5, 0, Infinity, '5', null, undefined]) {
+		await pRetry(failWith(value), {minTimeout: 100});
+	}
+
+	assert.deepEqual(delays, Array.from({length: 7}, () => 100));
+});
+
+test('retryAfter is shown in retryDelay to every callback', async t => {
+	collapseDelays(t);
+	const seen = [];
+
+	await pRetry(failWith(2), {
+		minTimeout: 100,
+		shouldConsumeRetry({retryDelay}) {
+			seen.push(retryDelay);
+		},
+		onFailedAttempt({retryDelay}) {
+			seen.push(retryDelay);
+		},
+		shouldRetry({retryDelay}) {
+			seen.push(retryDelay);
+			return true;
+		},
+	});
+
+	assert.deepEqual(seen, [2100, 2100, 2100]);
+});
+
+test('a retry that is not consumed still waits out retryAfter, without backoff', async t => {
+	const delays = collapseDelays(t);
+	let consumed = 0;
+
+	await pRetry(failWith(2, 2), {
+		retries: 1,
+		minTimeout: 100,
+		shouldConsumeRetry: () => consumed++ > 0,
+	});
+
+	assert.deepEqual(delays, [2000, 2100]);
+});
+
+test('retryAfter is not waited when no retry follows', async t => {
+	const delays = collapseDelays(t);
+
+	await assert.rejects(pRetry(failWith(5, 10), {retries: 0, minTimeout: 100}), {message: 'limited'});
+	assert.deepEqual(delays, []);
+});
