diff --git a/test/dashdash.js b/test/dashdash.js
new file mode 100644
index 0000000..81e24d6
--- /dev/null
+++ b/test/dashdash.js
@@ -0,0 +1,46 @@
+const test = require('tape');
+const fn = require('../lib');
+
+test('opts["--"]: collects args after bare --', t => {
+	const argv = fn(['a', '-x', '1', '--', 'b', '--c', '-d'], { '--': true });
+	t.same(argv._, ['a']);
+	t.is(argv.x, 1);
+	t.same(argv['--'], ['b', '--c', '-d']);
+	t.false('c' in argv);
+	t.end();
+});
+
+test('opts["--"]: empty array when no -- present', t => {
+	const argv = fn(['a', '-x'], { '--': true });
+	t.same(argv._, ['a']);
+	t.same(argv['--'], []);
+	t.end();
+});
+
+test('opts["--"]: trailing -- yields empty array', t => {
+	const argv = fn(['a', '--'], { '--': true });
+	t.same(argv._, ['a']);
+	t.same(argv['--'], []);
+	t.end();
+});
+
+test('opts["--"]: only first -- is consumed', t => {
+	const argv = fn(['--', 'a', '--', 'b'], { '--': true });
+	t.same(argv._, []);
+	t.same(argv['--'], ['a', '--', 'b']);
+	t.end();
+});
+
+test('opts["--"]: unset keeps default behavior', t => {
+	const argv = fn(['a', '--', 'b', '-c']);
+	t.same(argv._, ['a', 'b', '-c']);
+	t.false('--' in argv);
+	t.end();
+});
+
+test('opts["--"]: works with alias/boolean', t => {
+	const argv = fn(['-v', '--', 'x'], { '--': true, boolean: 'v', alias: { v: 'verbose' } });
+	t.is(argv.verbose, true);
+	t.same(argv['--'], ['x']);
+	t.end();
+});
