index ad2b6cc..1128826 100644
--- a/index.js
+++ b/index.js
@@ -25,6 +25,12 @@ module.exports = rangeParser
  */
 
 function rangeParser (size, str, options) {
+  // an invalid size (non-number, NaN, Infinity, negative or fractional)
+  // must not throw; ignore the header like any other unusable range
+  if (typeof size !== 'number' || !isFinite(size) || size < 0 || Math.floor(size) !== size) {
+    return -2
+  }
+
   if (typeof str !== 'string') {
     throw new TypeError('argument str must be a string')
   }
