--- a/tests/test_tables.py
+++ b/tests/test_tables.py
@@ -197,3 +197,50 @@ def test_persist_empty_does_not_wipe_existing_data(tmpdir):
     assert len(table) == 1
     assert table.all() == [{'a': 1}]
     db.close()
+
+
+def test_to_csv_default_fields(db, tmpdir):
+    import csv
+
+    table = db.table('csv')
+    table.insert({'a': 1, 'b': 'x'})
+    table.insert({'b': 'y', 'c': 3})
+    path = str(tmpdir.join('out.csv'))
+
+    table.to_csv(path)
+
+    with open(path, newline='', encoding='utf-8') as f:
+        rows = list(csv.reader(f))
+    assert rows == [['a', 'b', 'c'], ['1', 'x', ''], ['', 'y', '3']]
+
+
+def test_to_csv_fields_select_and_order(db, tmpdir):
+    import csv
+
+    table = db.table('csv')
+    table.insert({'a': 1, 'b': 'x', 'c': 3})
+    table.insert({'a': 2})
+    path = str(tmpdir.join('out.csv'))
+
+    table.to_csv(path, fields=['c', 'a', 'missing'])
+
+    with open(path, newline='', encoding='utf-8') as f:
+        rows = list(csv.reader(f))
+    assert rows == [['c', 'a', 'missing'], ['3', '1', ''], ['', '2', '']]
+
+
+def test_to_csv_empty_table_and_quoting(db, tmpdir):
+    import csv
+
+    path = str(tmpdir.join('out.csv'))
+    db.table('empty').to_csv(path, fields=['a'])
+    with open(path, newline='', encoding='utf-8') as f:
+        assert list(csv.reader(f)) == [['a']]
+
+    table = db.table('q')
+    table.insert({'a': 'x,y', 'b': 'line1\nline2', 'c': 'ü'})
+    table.to_csv(path)
+    with open(path, newline='', encoding='utf-8') as f:
+        assert list(csv.reader(f)) == [
+            ['a', 'b', 'c'], ['x,y', 'line1\nline2', 'ü']
+        ]
