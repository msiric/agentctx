+
+/**
+ * Multiply a decimal string by 1000^exp exactly (by moving the decimal
+ * point) and floor the result.
+ *
+ * @param {string} str
+ * @param {number} exp
+ * @returns {number}
+ * @private
+ */
+
+function scaleDecimal(str, exp) {
+  var negative = str.charAt(0) === '-';
+  var unsigned = str.replace(/^[-+]/, '');
+  var parts = unsigned.split('.');
+  var frac = parts[1] || '';
+  var shift = exp * 3;
+  var kept = (frac + new Array(shift + 1).join('0')).slice(0, shift);
+  var dropped = frac.slice(shift);
+  var magnitude = Number(parts[0] + kept);
+
+  if (negative) {
+    // floor rounds toward negative infinity
+    return /[1-9]/.test(dropped) ? -(magnitude + 1) : -magnitude;
+  }
+
+  return magnitude;
+}
diff --git a/test/byte-parse.js b/test/byte-parse.js
index cebfab2..c11d1ef 100644
--- a/test/byte-parse.js
+++ b/test/byte-parse.js
@@ -108,4 +108,46 @@ describe('Test byte parse function', function(){
   it('Should allow whitespace', function(){
     assert.equal(bytes.parse('1 TB'), 1 * Math.pow(1024, 4));
   });
+
+  describe('with decimal option', function(){
+    var opts = {decimal: true};
+
+    it('Should use powers of 1000', function(){
+      assert.equal(bytes.parse('1kB', opts), 1000);
+      assert.equal(bytes.parse('1MB', opts), 1000000);
+      assert.equal(bytes.parse('1GB', opts), 1e9);
+      assert.equal(bytes.parse('1TB', opts), 1e12);
+      assert.equal(bytes.parse('1PB', opts), 1e15);
+      assert.equal(bytes.parse('1 kb', opts), 1000);
+    });
+
+    it('Should scale fractions exactly', function(){
+      assert.equal(bytes.parse('2.01 kB', opts), 2010);
+      assert.equal(bytes.parse('4.1 MB', opts), 4100000);
+      assert.equal(bytes.parse('1.5GB', opts), 1500000000);
+      assert.equal(bytes.parse('0.001kB', opts), 1);
+    });
+
+    it('Should floor partial bytes', function(){
+      assert.equal(bytes.parse('1.0009kB', opts), 1000);
+      assert.equal(bytes.parse('1.1b', opts), 1);
+      assert.equal(bytes.parse('-1.0009kB', opts), -1001);
+      assert.equal(bytes.parse('-1.5kB', opts), -1500);
+    });
+
+    it('Should keep other inputs unchanged', function(){
+      assert.equal(bytes.parse('1024', opts), 1024);
+      assert.equal(bytes.parse(1024, opts), 1024);
+      assert.strictEqual(bytes.parse('foo', opts), null);
+    });
+
+    it('Should not change default behaviour', function(){
+      assert.equal(bytes.parse('1kB'), 1024);
+      assert.equal(bytes.parse('1kB', {decimal: false}), 1024);
+    });
+
+    it('Should work via the default export', function(){
+      assert.equal(bytes('2kB', opts), 2000);
+    });
+  });
 });
