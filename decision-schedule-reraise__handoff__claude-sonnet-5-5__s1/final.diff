+class JobErrorTests(TestCase):
+    def setUp(self):
+        schedule.clear()
+
+    def tearDown(self):
+        schedule.clear()
+
+    def test_failing_job_does_not_starve_others(self):
+        calls = []
+
+        def bad():
+            calls.append("bad")
+            raise ValueError("boom")
+
+        def good():
+            calls.append("good")
+
+        every().second.do(bad)
+        every().second.do(good)
+        time.sleep(1.1)
+        with self.assertRaises(ValueError):
+            schedule.run_pending()
+        assert calls == ["bad", "good"]
+
+    def test_failing_job_is_rescheduled(self):
+        def bad():
+            raise ValueError("boom")
+
+        job = every().hour.do(bad)
+        job.next_run = datetime.datetime.now() - datetime.timedelta(seconds=1)
+        with self.assertRaises(ValueError):
+            schedule.run_pending()
+        assert job.last_run is not None
+        assert not job.should_run
