+"""
+Benchmark TinyDB read performance on a large JSON db file.
+
+Usage: python scripts/bench_reads.py [--size-mb 40] [--repeat 5] [--keep PATH]
+"""
+import argparse
+import json
+import os
+import random
+import statistics
+import tempfile
+import time
+
+from tinydb import TinyDB, where
+from tinydb.storages import JSONStorage
+
+
+def generate(path, size_mb):
+    rnd = random.Random(0)
+    table, i = {}, 0
+    # ~200 bytes per doc; write JSON directly (fast) and stop at target size
+    target = size_mb * 1024 * 1024
+    approx = 0
+    while approx < target:
+        i += 1
+        doc = {'name': f'user{i}', 'age': rnd.randint(0, 99),
+               'email': f'user{i}@example.com',
+               'tags': [rnd.choice('abcdefgh') for _ in range(5)],
+               'address': {'city': f'city{rnd.randint(0, 999)}', 'zip': rnd.randint(10000, 99999)}}
+        table[str(i)] = doc
+        approx += 200
+    with open(path, 'w') as f:
+        json.dump({'_default': table}, f)
+    return i
+
+
+def timeit(fn, repeat):
+    ts = []
+    for _ in range(repeat):
+        t = time.perf_counter()
+        fn()
+        ts.append(time.perf_counter() - t)
+    return statistics.median(ts)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--size-mb', type=int, default=40)
+    ap.add_argument('--repeat', type=int, default=5)
+    ap.add_argument('--keep')
+    a = ap.parse_args()
+
+    path = a.keep or os.path.join(tempfile.mkdtemp(), 'bench.json')
+    n = generate(path, a.size_mb)
+    print(f'{path}: {os.path.getsize(path)/1e6:.1f} MB, {n} docs')
+
+    db = TinyDB(path)
+    storage = db.storage
+    q = where('age') == 42
+    r = a.repeat
+
+    def row(label, t):
+        print(f'{label:<48}{t*1000:9.1f} ms')
+
+    raw = timeit(lambda: json.load(open(path)), r)
+    row('json.load (floor for any full read)', raw)
+    row('storage.read()', timeit(storage.read, r))
+    row('db.all()', timeit(db.all, r))
+    row('db.search (cold, cache cleared each run)',
+        timeit(lambda: (db.clear_cache(), db.search(q)), r))
+    db.search(q)
+    row('db.search (cached, identical query)', timeit(lambda: db.search(q), r))
+    row('db.get(doc_id=1)', timeit(lambda: db.get(doc_id=1), r))
+    row('db.insert({...}) (read + full rewrite)', timeit(lambda: db.insert({'x': 1}), 2))
+
+    # Split search into parse vs. filter+wrap
+    data = storage.read()['_default']
+    row('  filter only on parsed data (no I/O)',
+        timeit(lambda: [d for d in data.values() if q(d)], r))
+    db.close()
+
+
+if __name__ == '__main__':
+    main()
