diff --git a/test/byte-parse.js b/test/byte-parse.js
index cebfab2..583bfcf 100644
--- a/test/byte-parse.js
+++ b/test/byte-parse.js
@@ -108,4 +108,53 @@ describe('Test byte parse function', function(){
   it('Should allow whitespace', function(){
     assert.equal(bytes.parse('1 TB'), 1 * Math.pow(1024, 4));
   });
+
+  describe('IEC units', function(){
+    ['kib', 'mib', 'gib', 'tib', 'pib'].forEach(function(unit, i){
+      var expected = Math.pow(1024, i + 1);
+      it('Should parse ' + unit + ' like ' + unit.replace('i', ''), function(){
+        assert.strictEqual(bytes.parse('1' + unit), expected);
+        assert.strictEqual(bytes.parse('1' + unit.toUpperCase()), expected);
+        assert.strictEqual(bytes.parse('1 ' + unit[0].toUpperCase() + 'iB'), expected);
+        assert.strictEqual(bytes.parse('1' + unit), bytes.parse('1' + unit.replace('i', '')));
+      });
+    });
+
+    it('Should handle decimals and signs', function(){
+      assert.strictEqual(bytes.parse('1.5KiB'), 1536);
+      assert.strictEqual(bytes.parse('-1KiB'), -1024);
+      assert.strictEqual(bytes.parse('+2 MiB'), 2 * Math.pow(1024, 2));
+    });
+
+    it('Should not accept invalid IEC units', function(){
+      assert.strictEqual(bytes.parse('KiB'), null);
+      assert.strictEqual(bytes.parse('1 BiB'), 1);
+      assert.strictEqual(bytes.parse('1 xKiB'), 1);
+    });
+  });
+
+  describe('with long hostile input', function(){
+    var LENGTH = 100000;
+    var LIMIT_MS = 250; // generous; linear parsing takes ~1ms
+
+    function timed(input) {
+      var start = process.hrtime.bigint();
+      var result = bytes.parse(input);
+      var elapsed = Number(process.hrtime.bigint() - start) / 1e6;
+      assert.ok(elapsed < LIMIT_MS, 'parse took ' + elapsed.toFixed(1) + 'ms');
+      return result;
+    }
+
+    it('Should reject a junk string quickly', function(){
+      assert.strictEqual(timed('x'.repeat(LENGTH)), null);
+      assert.strictEqual(timed('-'.repeat(LENGTH) + '1kb'), null);
+      assert.strictEqual(timed(' '.repeat(LENGTH) + 'kb'), null);
+    });
+
+    it('Should handle near-miss strings quickly', function(){
+      timed('1'.repeat(LENGTH) + '!');
+      timed('1' + ' '.repeat(LENGTH) + '!');
+      timed('1' + '.1'.repeat(LENGTH / 2) + '!');
+    });
+  });
 });
