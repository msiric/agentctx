	t.throws(() => prettyBytes(1, {binary: true, maxUnit: 'GB'}), {instanceOf: TypeError});
	t.throws(() => prettyBytes(1, {bits: true, maxUnit: 'GB'}), {instanceOf: TypeError});
	t.throws(() => prettyBytes(1, {maxUnit: 'gb'}), {instanceOf: TypeError});
	t.throws(() => prettyBytes(1, {maxUnit: 5}), {instanceOf: TypeError});
	t.throws(() => prettyBytes(1, {maxUnit: null}), {instanceOf: TypeError});
});
""")
EOF
cat package.json | grep -A4 '"scripts"'; npm test 2>&1 | tail -25) | depth=3
