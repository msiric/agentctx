diff --git a/test/dashdash.js b/test/dashdash.js
new file mode 100644
index 0000000..fa8a3b5
--- /dev/null
+++ b/test/dashdash.js
@@ -0,0 +1,37 @@
+const test = require('tape');
+const fn = require('../lib');
+
+test('-- : default behavior', t => {
+	t.deepEqual(fn(['a', '--', 'b', '-c']), { _: ['a', 'b', '-c'] });
+	t.end();
+});
+
+test('-- : opts["--"]', t => {
+	t.deepEqual(
+		fn(['a', '-x', '1', '--', 'b', '--foo', '-c'], { '--': true }),
+		{ _: ['a'], x: 1, '--': ['b', '--foo', '-c'] }
+	);
+	t.end();
+});
+
+test('-- : empty array when absent', t => {
+	t.deepEqual(fn(['a', '--foo'], { '--': true }), { _: ['a'], foo: true, '--': [] });
+	t.deepEqual(fn([], { '--': true }), { _: [], '--': [] });
+	t.end();
+});
+
+test('-- : trailing bare --', t => {
+	t.deepEqual(fn(['a', '--'], { '--': true }), { _: ['a'], '--': [] });
+	t.end();
+});
+
+test('-- : only first -- is a separator', t => {
+	t.deepEqual(fn(['a', '--', 'b', '--', 'c'], { '--': true }), { _: ['a'], '--': ['b', '--', 'c'] });
+	t.end();
+});
+
+test('-- : works with alias/default/boolean', t => {
+	const r = fn(['-v', '--', 'x'], { '--': true, alias: { v: 'verbose' }, boolean: 'v', default: { n: 2 } });
+	t.deepEqual(r, { _: [], v: true, verbose: true, n: 2, '--': ['x'] });
+	t.end();
+});
