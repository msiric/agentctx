+    def test_ttl_setter(self):
+        cache = TTLCache[int, int, int](maxsize=3, ttl=2, timer=Timer())
+        cache[1] = 1  # expires at 2
+        cache.ttl = 5
+        self.assertEqual(5, cache.ttl)
+        cache[2] = 2  # expires at 5
+
+        cache.timer.tick()
+        cache.timer.tick()
+        self.assertNotIn(1, cache)  # existing item keeps old expiration
+        self.assertIn(2, cache)
+
+        cache.timer.tick()
+        cache.timer.tick()
+        cache.timer.tick()
+        self.assertNotIn(2, cache)
+
