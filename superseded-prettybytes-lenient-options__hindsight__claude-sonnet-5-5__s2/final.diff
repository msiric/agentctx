+##### significantDigits
+
+Type: `number`\
+Default: `3`
+
+The number of significant digits to round to.
+
+Only applies when neither `minimumFractionDigits` nor `maximumFractionDigits` is set, and is ignored otherwise. The integer part is never rounded away, so a value like `1337` bytes in `B` keeps all four digits.
+
+Must be an integer between 1 and 100. Throws a `TypeError` for invalid values.
+
+```js
+import prettyBytes from 'pretty-bytes';
+
+prettyBytes(1337, {significantDigits: 2});
+//=> '1.3 kB'
+
+prettyBytes(1337, {significantDigits: 4});
+//=> '1.337 kB'
+```
+
 ##### space
 
 Type: `boolean`\
diff --git a/test.js b/test.js
index 05f9398..fca8d5f 100644
--- a/test.js
+++ b/test.js
@@ -1188,3 +1188,33 @@ test('unit must belong to the active unit system', t => {
 		prettyBytes(10n ** 400n, {unit: 'KiB'});
 	}, {instanceOf: TypeError});
 });
+
+test('significantDigits changes the default rounding', t => {
+	t.is(prettyBytes(1337, {significantDigits: 1}), '1 kB');
+	t.is(prettyBytes(1337, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 3}), prettyBytes(1337));
+	t.is(prettyBytes(1337, {significantDigits: 4}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4, binary: true}), '1.306 KiB');
+	t.is(prettyBytes(1337n, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4, locale: 'de'}), '1,337 kB');
+});
+
+test('significantDigits never rounds away the integer part', t => {
+	t.is(prettyBytes(999, {significantDigits: 1}), '999 B');
+	t.is(prettyBytes(1337, {significantDigits: 2, unit: 'B'}), '1337 B');
+});
+
+test('significantDigits carries across unit boundaries', t => {
+	t.is(prettyBytes(999_999, {significantDigits: 2}), '1 MB');
+});
+
+test('significantDigits is ignored when fraction digit options are set', t => {
+	t.is(prettyBytes(1337, {significantDigits: 1, maximumFractionDigits: 3}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 1, minimumFractionDigits: 1}), '1.337 kB');
+});
+
+test('significantDigits is validated', t => {
+	for (const significantDigits of [0, 101, 1.5, -1, '3', Number.NaN, null]) {
+		t.throws(() => prettyBytes(1337, {significantDigits}), {instanceOf: TypeError});
+	}
+});
