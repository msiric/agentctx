diff --git a/test/dash.js b/test/dash.js
new file mode 100644
index 0000000..0094c15
--- /dev/null
+++ b/test/dash.js
@@ -0,0 +1,40 @@
+const test = require('tape');
+const fn = require('../lib');
+
+test('-- (default): rest goes to _', t => {
+	t.same(fn(['a', '--', '-b', 'c']), { _: ['a', '-b', 'c'] });
+	t.end();
+});
+
+test('-- (opts["--"]): rest goes to argv["--"]', t => {
+	const argv = fn(['a', '-x', '1', '--', '-b', '--c=2', 'd'], { '--': true });
+	t.same(argv, { _: ['a'], x: 1, '--': ['-b', '--c=2', 'd'] });
+	t.end();
+});
+
+test('-- (opts["--"]): empty array when no bare --', t => {
+	t.same(fn(['a', '--foo'], { '--': true }), { _: ['a'], foo: true, '--': [] });
+	t.same(fn([], { '--': true }), { _: [], '--': [] });
+	t.end();
+});
+
+test('-- (opts["--"]): trailing -- yields empty array', t => {
+	t.same(fn(['a', '--'], { '--': true }), { _: ['a'], '--': [] });
+	t.end();
+});
+
+test('-- (opts["--"]): only first bare -- is consumed', t => {
+	t.same(fn(['--', 'a', '--', 'b'], { '--': true }), { _: [], '--': ['a', '--', 'b'] });
+	t.end();
+});
+
+test('-- (opts["--"]): works with alias/boolean/default', t => {
+	const argv = fn(['-v', 'x', '--', '-v', 'y'], {
+		'--': true,
+		alias: { v: 'verbose' },
+		boolean: 'v',
+		default: { n: 5 }
+	});
+	t.same(argv, { _: ['x'], v: true, verbose: true, n: 5, '--': ['-v', 'y'] });
+	t.end();
+});
