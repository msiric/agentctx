+
+
+def test_gzip_json(tmpdir):
+    import gzip
+    from tinydb.storages import GzipJSONStorage
+
+    path = str(tmpdir.join('test.db.gz'))
+
+    with TinyDB(path, storage=GzipJSONStorage) as db:
+        db.insert_multiple({'int': 1, 'text': 'x' * 50} for _ in range(20))
+
+    with open(path, 'rb') as f:
+        assert json.loads(gzip.decompress(f.read()))['_default']
+
+    with TinyDB(path, storage=GzipJSONStorage) as db:
+        assert len(db) == 20
+        db.truncate()
+        db.insert({'a': 1})
+
+    with TinyDB(path, storage=GzipJSONStorage) as db:
+        assert db.all() == [{'a': 1}]
+
+
+def test_gzip_json_read_only_empty(tmpdir):
+    from tinydb.storages import GzipJSONStorage
+
+    path = str(tmpdir.join('empty.gz'))
+    open(path, 'wb').close()
+    storage = GzipJSONStorage(path, access_mode='rb')
+    assert storage.read() is None
+    with pytest.raises(IOError):
+        storage.write({})
+    storage.close()
