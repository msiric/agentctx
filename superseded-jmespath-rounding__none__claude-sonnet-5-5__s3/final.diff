+import unittest
+
+from jmespath import exceptions
+from jmespath.dashboard import search
+
+
+class TestRoundTo(unittest.TestCase):
+    def test_rounds_half_to_even(self):
+        # Matches Python's round() and pandas, not round-half-up.
+        cases = [
+            (0.5, 0, 0), (1.5, 0, 2), (2.5, 0, 2), (3.5, 0, 4),
+            (-0.5, 0, 0), (-1.5, 0, -2), (-2.5, 0, -2),
+            (0.125, 2, 0.12), (0.375, 2, 0.38),
+        ]
+        for number, digits, expected in cases:
+            result = search('round_to(@, `%s`)' % digits, number)
+            self.assertEqual(result, expected, (number, digits))
+
+    def test_literal_arguments(self):
+        self.assertEqual(search('round_to(`2.5`, `0`)', None), 2)
+        self.assertEqual(search('round_to(`3.5`, `0`)', None), 4)
+
+    def test_digits(self):
+        self.assertEqual(search('round_to(a, `1`)', {'a': 3.14159}), 3.1)
+        self.assertEqual(search('round_to(a, `1.0`)', {'a': 3.14159}), 3.1)
+        self.assertEqual(search('round_to(a, `-1`)', {'a': 15}), 20)
+
+    def test_fractional_digits_rejected(self):
+        with self.assertRaises(exceptions.JMESPathTypeError):
+            search('round_to(`1`, `1.5`)', None)
+
+    def test_builtins_still_available(self):
+        self.assertEqual(search('abs(@)', -1), 1)
+
+
+class TestClamp(unittest.TestCase):
+    def test_within_range(self):
+        self.assertEqual(search('clamp(@, `0`, `10`)', 5), 5)
+
+    def test_below_and_above(self):
+        self.assertEqual(search('clamp(@, `0`, `10`)', -3), 0)
+        self.assertEqual(search('clamp(@, `0`, `10`)', 42), 10)
+
+    def test_bounds_inclusive(self):
+        self.assertEqual(search('clamp(@, `0`, `10`)', 0), 0)
+        self.assertEqual(search('clamp(@, `0`, `10`)', 10), 10)
+
+    def test_floats_and_negatives(self):
+        self.assertEqual(search('clamp(@, `-1.5`, `1.5`)', -2.5), -1.5)
+        self.assertEqual(search('clamp(@, `-1.5`, `1.5`)', 0.25), 0.25)
+
+    def test_lo_greater_than_hi_rejected(self):
+        with self.assertRaises(ValueError):
+            search('clamp(`1`, `10`, `0`)', None)
+
+    def test_non_number_rejected(self):
+        with self.assertRaises(exceptions.JMESPathTypeError):
+            search('clamp(`"a"`, `0`, `1`)', None)
+
+
+class TestPercent(unittest.TestCase):
+    def test_basic(self):
+        self.assertEqual(search('percent(`1`, `4`, `0`)', None), 25)
+        self.assertEqual(search('percent(`1`, `3`, `2`)', None), 33.33)
+        self.assertEqual(search('percent(a, b, `1`)', {'a': 2, 'b': 3}), 66.7)
+
+    def test_over_100_and_negative(self):
+        self.assertEqual(search('percent(`3`, `2`, `0`)', None), 150)
+        self.assertEqual(search('percent(`-1`, `4`, `0`)', None), -25)
+
+    def test_float_digits(self):
+        self.assertEqual(search('percent(`1`, `3`, `2.0`)', None), 33.33)
+
+    def test_fractional_digits_rejected(self):
+        with self.assertRaises(exceptions.JMESPathTypeError):
+            search('percent(`1`, `3`, `1.5`)', None)
+
+    def test_zero_whole_rejected(self):
+        with self.assertRaises(ValueError):
+            search('percent(`1`, `0`, `0`)', None)
+
+    def test_non_number_rejected(self):
+        with self.assertRaises(exceptions.JMESPathTypeError):
+            search('percent(`"a"`, `1`, `0`)', None)
+
+
+if __name__ == '__main__':
+    unittest.main()
