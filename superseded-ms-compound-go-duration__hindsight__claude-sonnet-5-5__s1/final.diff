 ms(ms('10 hours'), { long: true })    // "10 hours"
 ```
 
+### Compound Format
+
+```ts
+ms(5400000, { compound: true })       // "1h 30m"
+ms(90061000, { compound: true })      // "1d 1h 1m 1s"
+ms(-5400000, { compound: true })      // "-1h 30m"
+```
+
+Largest unit first, zero parts are skipped, units go from days down to seconds (leftover milliseconds are dropped), and `long` takes precedence if both are set.
+
 ### Input Formats (Units)
 
 ```ts
@@ -156,6 +166,8 @@ import { parse, format } from 'ms';
 parse('1h'); // 3600000
 
 format(2000); // "2s"
+
+format(5400000, { compound: true }); // "1h 30m"
 ```
 
 ### Enhanced Type Safety
diff --git a/src/format.test.ts b/src/format.test.ts
index cdabb0f..70034de 100644
--- a/src/format.test.ts
+++ b/src/format.test.ts
@@ -259,3 +259,48 @@ describe('format(invalid inputs)', () => {
     }).toThrow();
   });
 });
+
+describe('format(number, { compound: true })', () => {
+  it('should combine units, largest first', () => {
+    expect(format(5400000, { compound: true })).toBe('1h 30m');
+    expect(format(90061000, { compound: true })).toBe('1d 1h 1m 1s');
+  });
+
+  it('should skip zero parts', () => {
+    expect(format(86400000 + 5000, { compound: true })).toBe('1d 5s');
+    expect(format(7200000, { compound: true })).toBe('2h');
+  });
+
+  it('should not use weeks, months or years', () => {
+    expect(format(400 * 86400000, { compound: true })).toBe('400d');
+  });
+
+  it('should drop leftover milliseconds', () => {
+    expect(format(1999, { compound: true })).toBe('1s');
+    expect(format(500, { compound: true })).toBe('0s');
+    expect(format(-500, { compound: true })).toBe('0s');
+    expect(format(0, { compound: true })).toBe('0s');
+  });
+
+  it('should support negative values', () => {
+    expect(format(-5400000, { compound: true })).toBe('-1h 30m');
+  });
+
+  it('should roll over at unit boundaries', () => {
+    expect(format(59999, { compound: true })).toBe('59s');
+    expect(format(60000, { compound: true })).toBe('1m');
+    expect(format(3599000, { compound: true })).toBe('59m 59s');
+    expect(format(86399000, { compound: true })).toBe('23h 59m 59s');
+  });
+
+  it('should behave like the short format when compound is false', () => {
+    expect(format(5400000, { compound: false })).toBe('2h');
+  });
+
+  it('should throw on non-finite or non-number values', () => {
+    expect(() => format(NaN, { compound: true })).toThrow();
+    expect(() => format(Infinity, { compound: true })).toThrow();
+    // @ts-expect-error testing invalid input
+    expect(() => format('1h', { compound: true })).toThrow();
+  });
+});
