+
+test('elapsedTime is passed to all callbacks and grows across attempts', async () => {
+	const seen = {shouldConsumeRetry: [], onFailedAttempt: [], shouldRetry: []};
+	const record = name => ({elapsedTime}) => {
+		seen[name].push(elapsedTime);
+		return true;
+	};
+
+	await assert.rejects(pRetry(async () => {
+		await delay(20);
+		throw new Error('fail');
+	}, {
+		retries: 2,
+		minTimeout: 20,
+		factor: 1,
+		shouldConsumeRetry: record('shouldConsumeRetry'),
+		onFailedAttempt: record('onFailedAttempt'),
+		shouldRetry: record('shouldRetry'),
+	}), {message: 'fail'});
+
+	for (const times of Object.values(seen)) {
+		assert.equal(times.length >= 2, true);
+		assert.equal(times.every(time => typeof time === 'number' && time >= 15), true);
+		assert.deepEqual(times, times.toSorted((a, b) => a - b));
+		// Each attempt takes at least the operation's 20ms plus the 20ms wait before it.
+		assert.equal(times.at(-1) - times[0] >= 35, true);
+	}
+});
+
+test('retryAfter (seconds) is added to the computed backoff', async () => {
+	const delays = [];
+	const started = performance.now();
+	let attempts = 0;
+
+	await pRetry(async () => {
+		attempts++;
+		if (attempts === 1) {
+			throw Object.assign(new Error('rate limited'), {retryAfter: 0.05});
+		}
+	}, {
+		minTimeout: 30,
+		factor: 1,
+		onFailedAttempt({retryDelay}) {
+			delays.push(retryDelay);
+		},
+	});
+
+	assert.deepEqual(delays, [80]);
+	assert.equal(performance.now() - started >= 75, true);
+});
+
+test('retryAfter is ignored unless it is a positive finite number', async () => {
+	for (const retryAfter of ['5', NaN, Infinity, -1, 0, undefined, null]) {
+		const delays = [];
+		let attempts = 0;
+
+		await pRetry(async () => {
+			attempts++;
+			if (attempts === 1) {
+				throw Object.assign(new Error('fail'), {retryAfter});
+			}
+		}, {
+			minTimeout: 1,
+			onFailedAttempt({retryDelay}) {
+				delays.push(retryDelay);
+			},
+		});
+
+		assert.deepEqual(delays, [1], String(retryAfter));
+	}
+});
+
+test('retryAfter is still bounded by maxRetryTime', async () => {
+	const started = performance.now();
+
+	await assert.rejects(pRetry(async () => {
+		throw Object.assign(new Error('rate limited'), {retryAfter: 60});
+	}, {minTimeout: 1, maxRetryTime: 100}), {message: 'rate limited'});
+
+	assert.equal(performance.now() - started < 1000, true);
+});
+
+test('retryAfter adds to the backoff after maxTimeout is applied', async () => {
+	const delays = [];
+	let attempts = 0;
+
+	await pRetry(async () => {
+		attempts++;
+		if (attempts === 1) {
+			throw Object.assign(new Error('fail'), {retryAfter: 0.01});
+		}
+	}, {
+		minTimeout: 50,
+		maxTimeout: 5,
+		onFailedAttempt({retryDelay}) {
+			delays.push(retryDelay);
+		},
+	});
+
+	assert.deepEqual(delays, [15]);
+});
