@@ -242,3 +242,84 @@ function plural(
   const isPlural = msAbs >= n * 1.5;
   return `${Math.round(ms / n)} ${name}${isPlural ? 's' : ''}` as StringValue;
 }
+
+/**
+ * Format the given milliseconds as an ISO 8601 duration string.
+ *
+ * Days are the largest unit used, since months and years are ambiguous.
+ * Negative values are prefixed with `-`, and sub-second precision is emitted
+ * as a decimal fraction of seconds.
+ *
+ * @param ms - milliseconds
+ * @returns The ISO 8601 duration, e.g. `PT1H30M` or `P1DT1H1M1S`
+ * @throws Error if `ms` is not a finite number
+ */
+export function formatISO(ms: number): string {
+  if (typeof ms !== 'number' || !Number.isFinite(ms)) {
+    throw new Error('Value provided to ms.formatISO() must be of type number.');
+  }
+
+  let rest = Math.round(Math.abs(ms));
+  const sign = ms < 0 && rest > 0 ? '-' : '';
+
+  const days = Math.floor(rest / d);
+  rest -= days * d;
+  const hours = Math.floor(rest / h);
+  rest -= hours * h;
+  const minutes = Math.floor(rest / m);
+  rest -= minutes * m;
+  const seconds = Math.floor(rest / s);
+  const millis = rest - seconds * s;
+
+  const secStr = millis
+    ? `${seconds}.${String(millis).padStart(3, '0').replace(/0+$/, '')}`
+    : `${seconds}`;
+
+  const date = days ? `${days}D` : '';
+  const time =
+    (hours ? `${hours}H` : '') +
+    (minutes ? `${minutes}M` : '') +
+    (seconds || millis ? `${secStr}S` : '');
+
+  if (!date && !time) {
+    return 'PT0S';
+  }
+  return `${sign}P${date}${time ? `T${time}` : ''}`;
+}
+
+const ISO_NUM = '(\\d+(?:[.,]\\d+)?)';
+const ISO_DURATION = new RegExp(
+  `^(?<sign>[-+])?P(?:${ISO_NUM}W)?(?:${ISO_NUM}D)?(?:T(?:${ISO_NUM}H)?(?:${ISO_NUM}M)?(?:${ISO_NUM}S)?)?$`,
+);
+
+/**
+ * Parse an ISO 8601 duration string and return milliseconds. This is the
+ * inverse of `formatISO`.
+ *
+ * Supports weeks, days, hours, minutes and seconds (with decimal fractions).
+ * Years and months are not supported since their length is ambiguous.
+ *
+ * @param str - An ISO 8601 duration, e.g. `PT1H30M` or `P1DT1H1M1S`
+ * @returns The duration in milliseconds, or `NaN` if the string is not a
+ * supported ISO 8601 duration
+ * @throws Error if `str` is not a string with length between 1 and 100
+ */
+export function parseISO(str: string): number {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw new Error(
+      `Value provided to ms.parseISO() must be a string with length between 1 and 100. value=${JSON.stringify(str)}`,
+    );
+  }
+  const match = ISO_DURATION.exec(str);
+  // Must contain at least one component, and "T" must be followed by one.
+  if (!match || str.endsWith('T') || str === 'P' || /^[-+]?P$/.test(str)) {
+    return NaN;
+  }
+  const [, w$, d$, h$, m$, s$] = match.slice(1);
+  const num = (v: string | undefined, unit: number) =>
+    v === undefined ? 0 : parseFloat(v.replace(',', '.')) * unit;
+  const total = Math.round(
+    num(w$, w) + num(d$, d) + num(h$, h) + num(m$, m) + num(s$, s),
+  );
+  return (match.groups?.sign === '-' ? -total : total) + 0;
+}
