+    def pause(self, tag: Hashable) -> None:
+        """
+        Pause all jobs marked with the given tag. Paused jobs stay
+        scheduled but are skipped by :meth:`run_pending` until they are
+        resumed with :meth:`resume`. :meth:`run_all` still runs them.
+
+        :param tag: An identifier used to identify a subset of
+                    jobs to pause
+        """
+        logger.debug('Pausing all jobs tagged "%s"', tag)
+        for job in self.get_jobs(tag):
+            job.paused = True
+
+    def resume(self, tag: Hashable) -> None:
+        """
+        Resume all paused jobs marked with the given tag.
+
+        Runs missed while paused are not made up: a resumed job whose
+        ``next_run`` has passed runs once on the next :meth:`run_pending`
+        and is then rescheduled as usual.
+
+        :param tag: An identifier used to identify a subset of
+                    jobs to resume
+        """
+        logger.debug('Resuming all jobs tagged "%s"', tag)
+        for job in self.get_jobs(tag):
+            job.paused = False
