+    def test_get_jobs_for(self):
+        def foo():
+            pass
+
+        def bar():
+            pass
+
+        def never_scheduled():
+            pass
+
+        j1 = every().second.do(foo)
+        j2 = every().minute.do(foo, 1, x=2)
+        j3 = every().hour.do(bar)
+        unfinished = every().day  # no job_func yet
+
+        assert schedule.default_scheduler.get_jobs_for(foo) == [j1, j2]
+        assert schedule.default_scheduler.get_jobs_for(bar) == [j3]
+        assert schedule.default_scheduler.get_jobs_for(never_scheduled) == []
+        assert unfinished not in schedule.default_scheduler.get_jobs_for(foo)
+
+        for job in schedule.default_scheduler.get_jobs_for(foo):
+            schedule.cancel_job(job)
+        assert schedule.jobs == [j3]
+
+    def test_get_jobs_for_bound_method(self):
+        class Worker:
+            def run(self):
+                pass
+
+        w1, w2 = Worker(), Worker()
+        j1 = every().second.do(w1.run)
+        j2 = every().second.do(w2.run)
+
+        assert schedule.default_scheduler.get_jobs_for(w1.run) == [j1]
+        assert schedule.default_scheduler.get_jobs_for(w2.run) == [j2]
+
+    def test_pause_and_resume(self):
+        mock_job = make_mock_job()
+        other_job = make_mock_job()
+        every().second.do(mock_job).tag("maint")
+        every().second.do(other_job)
+
+        with mock_datetime(2010, 1, 6, 12, 15, 0):
+            schedule.run_pending()
+        schedule.pause("maint")
+        with mock_datetime(2100, 1, 1, 0, 0, 0):
+            schedule.run_pending()
+        assert mock_job.call_count == 0
+        assert other_job.call_count == 1
+        assert len(schedule.jobs) == 2
+
+        schedule.resume("maint")
+        with mock_datetime(2100, 1, 1, 0, 0, 1):
+            schedule.run_pending()
+        assert mock_job.call_count == 1
+        assert other_job.call_count == 2
+
+    def test_pause_unknown_tag_is_noop(self):
+        mock_job = make_mock_job()
+        every().second.do(mock_job).tag("a")
+        schedule.pause("nope")
+        schedule.resume("nope")
+        with mock_datetime(2100, 1, 1, 0, 0, 0):
+            schedule.run_pending()
+        assert mock_job.call_count == 1
+
+    def test_paused_jobs_ignored_by_next_run(self):
+        every().hour.do(make_mock_job()).tag("a")
+        every().day.do(make_mock_job()).tag("b")
+        schedule.pause("a")
+        assert schedule.next_run() == schedule.get_jobs("b")[0].next_run
+        schedule.pause("b")
+        assert schedule.next_run() is None
+        assert schedule.idle_seconds() is None
+        schedule.resume("a")
+        assert schedule.next_run() == schedule.get_jobs("a")[0].next_run
+
