+##### significantDigits
+
+Type: `number`\
+Default: `3`
+
+The number of significant digits to round to, instead of the default of 3.
+
+Only applies when neither `minimumFractionDigits` nor `maximumFractionDigits` is set. The integer part of the number is never cut short, so `prettyBytes(123_456, {significantDigits: 2})` is still `123 kB`.
+
+Must be an integer between 1 and 100. Any other value is ignored and the default of 3 is used.
+
+```js
+import prettyBytes from 'pretty-bytes';
+
+prettyBytes(1337, {significantDigits: 2});
+//=> '1.3 kB'
+
+prettyBytes(1337, {significantDigits: 4});
+//=> '1.337 kB'
+```
+
 ##### space
 
 Type: `boolean`\
diff --git a/test.js b/test.js
index 38d53bd..076ed5a 100644
--- a/test.js
+++ b/test.js
@@ -1177,3 +1177,26 @@ test('unit must be in the active unit system', t => {
 	t.throws(() => prettyBytes(1, {unit: 5}), {instanceOf: TypeError});
 	t.throws(() => prettyBytes(1, {unit: null}), {instanceOf: TypeError});
 });
+
+test('significantDigits', t => {
+	t.is(prettyBytes(1337, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 3}), '1.34 kB');
+	t.is(prettyBytes(1337, {significantDigits: 1}), '1 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4, locale: 'de'}), '1,337 kB');
+	t.is(prettyBytes(999_999, {significantDigits: 1}), '1 MB');
+	t.is(prettyBytes(123_456, {significantDigits: 2}), '123 kB');
+
+	// Ignored when a fraction digit option is set
+	t.is(prettyBytes(1337, {significantDigits: 4, maximumFractionDigits: 1}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4, minimumFractionDigits: 0}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 1, minimumFractionDigits: 1}), '1.337 kB');
+});
+
+test('significantDigits ignores invalid values', t => {
+	for (const value of [0, -1, 1.5, 101, Number.NaN, Number.POSITIVE_INFINITY, '2', null, {}, true]) {
+		t.is(prettyBytes(1337, {significantDigits: value}), '1.34 kB');
+	}
+
+	t.is(prettyBytes(1337, {significantDigits: undefined}), '1.34 kB');
+});
