+class YAMLStorage(FileStorage):
+    """
+    Store the data in a YAML file that is pleasant to edit by hand.
+
+    Requires `PyYAML <https://pyyaml.org/>`_, which is not a dependency of
+    TinyDB and has to be installed separately.
+
+    Only plain YAML data is read and written (``yaml.SafeLoader`` semantics),
+    so no arbitrary Python objects can be constructed from the file. Unlike
+    stock PyYAML (YAML 1.1), only ``true`` and ``false`` (in any of the usual
+    casings) are read as booleans: ``yes``, ``no``, ``on`` and ``off`` are
+    strings. Strings that *would* be ambiguous are quoted when writing, so
+    the files stay readable by other YAML parsers.
+
+    **Note:** Comments and formatting in the file are not preserved when the
+    database is written.
+    """
+
+    def __init__(self, path: str, create_dirs=False, encoding=None, access_mode='r+', **kwargs):
+        """
+        Create a new instance.
+
+        See :class:`FileStorage` for the file handling arguments.
+
+        :param path: Where to store the YAML data.
+        :param kwargs: Passed to :func:`yaml.dump` on every write.
+        :raises ImportError: If PyYAML is not installed.
+        """
+
+        # Fail before touching the file system if PyYAML is missing
+        self._loader, self._dumper = _yaml_classes()
+
+        super().__init__(path, create_dirs=create_dirs, encoding=encoding, access_mode=access_mode)
+
+        self.kwargs = kwargs
+
+    def read(self) -> Optional[dict[str, dict[str, Any]]]:
+        import yaml
+
+        self._handle.seek(0)
+        text = self._handle.read()
+
+        if not text.strip():
+            # Empty file: let TinyDB initialize the database
+            return None
+
+        # Malformed YAML raises ``yaml.YAMLError`` instead of being treated as
+        # empty, so a broken hand-edit can't be silently overwritten
+        data = yaml.load(text, Loader=self._loader)
+
+        if data is None:
+            # E.g. a file that only contains comments
+            return None
+
+        if not isinstance(data, dict):
+            raise ValueError(
+                'Invalid database file: expected a mapping at the top level, '
+                'got {0}'.format(type(data).__name__)
+            )
+
+        return data
+
+    def write(self, data: dict[str, dict[str, Any]]):
+        import yaml
+
+        options: dict[str, Any] = {'default_flow_style': False, 'allow_unicode': True, 'sort_keys': False}
+        options.update(self.kwargs)
+        serialized = yaml.dump(data, Dumper=self._dumper, **options)
+
+        self._handle.seek(0)
+
+        try:
+            self._handle.write(serialized)
+        except io.UnsupportedOperation:
+            raise IOError('Cannot write to the database. Access mode is "{0}"'.format(self._mode))
+
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+        self._handle.truncate()
+
+
+_yaml_cache = None
+
+
+def _yaml_classes():
+    """
+    Build (once) the PyYAML loader and dumper used by :class:`YAMLStorage`.
+
+    Subclasses are used so PyYAML's global state is never modified.
+    """
+
+    global _yaml_cache
+
+    if _yaml_cache is not None:
+        return _yaml_cache
+
+    try:
+        import yaml
+    except ImportError as e:
+        raise ImportError('YAMLStorage requires PyYAML: pip install pyyaml') from e
+
+    from .table import Document
+
+    class _Loader(yaml.SafeLoader):
+        pass
+
+    class _Dumper(yaml.SafeDumper):
+        pass
+
+    # Copy the resolver table (it is shared with SafeLoader otherwise) and
+    # restrict booleans to true/false
+    bool_re = re.compile(r'^(?:true|True|TRUE|false|False|FALSE)$')
+    resolvers = {}
+    for first_char, entries in yaml.SafeLoader.yaml_implicit_resolvers.items():
+        resolvers[first_char] = [
+            (tag, bool_re if tag == 'tag:yaml.org,2002:bool' else regexp)
+            for tag, regexp in entries
+        ]
+    _Loader.yaml_implicit_resolvers = resolvers
+
+    # Documents are dicts; write them as plain mappings without tags
+    _Dumper.add_representer(Document, lambda dumper, doc: dumper.represent_dict(dict(doc)))
+
+    _yaml_cache = (_Loader, _Dumper)
+    return _yaml_cache
+
+
