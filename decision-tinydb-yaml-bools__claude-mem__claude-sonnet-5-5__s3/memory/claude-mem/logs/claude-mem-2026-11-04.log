tests='''yaml = pytest.importorskip('yaml')


def test_yaml(tmpdir):
    path = str(tmpdir.join('test.yaml'))
    db = TinyDB(path, storage=YAMLStorage)
    db.insert(doc)
    assert db.all() == [doc]

    db.update({'name': 'foo'})

    assert '!' not in tmpdir.join('test.yaml').read()
    assert db.contains(where('name') == 'foo')
    assert len(db) == 1
    db.close()

    # Survives a reopen
    with TinyDB(path, storage=YAMLStorage) as db:
        assert len(db) == 1
        assert db.get(where('name') == 'foo')['int'] == 42


def test_yaml_empty_and_comment_only(tmpdir):
    path = tmpdir.join('test.yaml')
    storage = YAMLStorage(str(path))
    assert storage.read() is None

    path.write('# nothing here yet\\n')
    assert storage.read() is None
    storage.close()


def test_yaml_roundtrip_shrinks_file(tmpdir):
    path = str(tmpdir.join('test.yaml'))
    storage = YAMLStorage(path)
    storage.write({'_default': {'1': {'text': 'x' * 500}}})
    storage.write({'_default': {}})
    assert storage.read() == {'_default': {}}
    storage.close()
    assert 'x' not in open(path).read()


def test_yaml_hand_edit_booleans(tmpdir):
    path = tmpdir.join('test.yaml')
    path.write('_default:\\n  "1":\\n    a: true\\n    b: False\\n    c: yes\\n    d: off\\n')
    storage = YAMLStorage(str(path))
    assert storage.read() == {'_default': {'1': {'a': True, 'b': False, 'c': 'yes', 'd': 'off'}}}
    storage.close()


def test_yaml_ambiguous_strings_are_quoted(tmpdir):
    path = str(tmpdir.join('test.yaml'))
    data = {'_default': {'1': {'a': 'yes', 'b': 'no', 'c': '123', 'd': 'null'}}}
    storage = YAMLStorage(path)
    storage.write(data)
    assert storage.read() == data
    storage.close()

    # A stock YAML 1.1 parser must agree
    with open(path) as f:
        assert yaml.safe_load(f) == data


def test_yaml_does_not_touch_global_pyyaml(tmpdir):
    storage = YAMLStorage(str(tmpdir.join('test.yaml')))
    storage.close()
    assert yaml.safe_load('a: yes') == {'a': True}
    assert Document not in yaml.SafeDumper.yaml_representers


