new='''class FileStorage(Storage):
    """
    Base class for storages that keep their data in a single file.

    Takes care of creating the file (and optionally its parent directories),
    validating the access mode and holding the open file handle. Subclasses
    implement :meth:`read` and :meth:`write` on top of ``self._handle``.
    """

    def __init__(self, path: str, create_dirs=False, encoding=None, access_mode='r+'):
        """
        Create a new instance.

        Also creates the storage file, if it doesn't exist and the access mode
        is appropriate for writing.

        **Note:** Using an access mode other than `r` or `r+` will probably
        lead to data loss or data corruption!

        :param path: Where to store the data.
        :param create_dirs: Whether to create missing parent directories.
        :param encoding: The encoding used to open the file.
        :param access_mode: mode in which the file is opened (r, r+)
        :type access_mode: str
        """

        super().__init__()

        self._mode = access_mode

        if access_mode not in ('r', 'rb', 'r+', 'rb+'):
            warnings.warn(
                'Using an `access_mode` other than \\'r\\', \\'rb\\', \\'r+\\' '
                'or \\'rb+\\' can cause data loss or corruption'
            )

        # Create the file if it doesn't exist and creating is allowed by the
        # access mode
        if any([character in self._mode for character in ('+', 'w', 'a')]):  # any of the writing modes
            touch(path, create_dirs=create_dirs)

        # Open the file for reading/writing
        self._handle = open(path, mode=self._mode, encoding=encoding)

    def close(self) -> None:
        self._handle.close()


class JSONStorage(FileStorage):
    """
    Store the data in a JSON file.
    """

    def __init__(self, path: str, create_dirs=False, encoding=None, access_mode='r+', **kwargs):
        """
        Create a new instance.

        See :class:`FileStorage` for the file handling arguments.

        **Note:** **Never** pass untrusted or user-controlled code as ``kwargs``
        members like ``cls`` or ``default`` will be called on every write
        operation.

        :param path: Where to store the JSON data.
        :param kwargs: Passed to :func:`json.dumps` on every write.
        """

        super().__init__(path, create_dirs=create_dirs, encoding=encoding, access_mode=access_mode)

        self.kwargs = kwargs

'''
s=s[:start]+new+s[end:]
s=s.replace("__all__ = ('Storage', 'JSONStorage', 'MemoryStorage')","__all__ = ('Storage', 'FileStorage', 'JSONStorage', 'MemoryStorage')")
open(p,'w').write(s)
EOF
