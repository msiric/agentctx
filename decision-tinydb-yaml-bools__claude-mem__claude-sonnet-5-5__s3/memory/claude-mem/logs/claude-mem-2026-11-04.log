    storage.close()


def test_yaml_kwargs_and_unicode(tmpdir):
    path = tmpdir.join('test.yaml')
    storage = YAMLStorage(str(path), encoding='utf-8', sort_keys=True)
    storage.write({'b': {}, 'a': {'t': u'こんにちは'}})
    storage.close()
    text = path.read_text('utf-8')
    assert text.index('a:') < text.index('b:')
    assert u'こんにちは' in text


