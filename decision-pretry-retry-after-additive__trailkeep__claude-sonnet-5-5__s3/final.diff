diff --git a/test.js b/test.js
index 20c9a47..edf3328 100644
--- a/test.js
+++ b/test.js
@@ -1284,3 +1284,127 @@ try {
 		await removeTemporaryScript(temporaryFile);
 	}
 });
+
+test('context carries elapsedTime since pRetry was called', async () => {
+	const seen = {shouldConsumeRetry: [], onFailedAttempt: [], shouldRetry: []};
+	const record = name => ({elapsedTime}) => {
+		seen[name].push(elapsedTime);
+	};
+
+	await assert.rejects(pRetry(async () => {
+		await delay(30);
+		throw new Error('fail');
+	}, {
+		retries: 1,
+		minTimeout: 20,
+		shouldConsumeRetry: record('shouldConsumeRetry'),
+		onFailedAttempt: record('onFailedAttempt'),
+		shouldRetry(context) {
+			record('shouldRetry')(context);
+			return true;
+		},
+	}), {message: 'fail'});
+
+	for (const [name, values] of Object.entries(seen)) {
+		assert.equal(values.length, name === 'shouldRetry' ? 1 : 2, name);
+		assert.ok(values.every(value => typeof value === 'number'), name);
+		assert.ok(values[0] >= 28, `${name}: ${values[0]}`);
+		// Each attempt takes at least 30ms, the retry waits at least 20ms (timers can fire ~1ms early).
+
+		if (values.length === 1) {
+			continue;
+		}
+
+		assert.ok(values[1] >= 78, `${name}: ${values[1]}`);
+		assert.ok(values[1] > values[0], name);
+	}
+});
+
+test('retryAfter on the error is added to the backoff delay', async () => {
+	const delays = [];
+	let calls = 0;
+	const start = performance.now();
+
+	await pRetry(async () => {
+		calls++;
+
+		if (calls === 1) {
+			throw Object.assign(new Error('rate limited'), {retryAfter: 0.1});
+		}
+	}, {
+		minTimeout: 50,
+		onFailedAttempt({retryDelay}) {
+			delays.push(retryDelay);
+		},
+	});
+
+	assert.deepEqual(delays, [150]);
+	assert.ok(performance.now() - start >= 148);
+});
+
+test('retryAfter is not capped by maxTimeout or randomized', async () => {
+	const delays = [];
+
+	await assert.rejects(pRetry(async () => {
+		throw Object.assign(new Error('rate limited'), {retryAfter: 0.01});
+	}, {
+		retries: 1,
+		minTimeout: 5,
+		maxTimeout: 5,
+		randomize: true,
+		onFailedAttempt({retryDelay}) {
+			delays.push(retryDelay);
+		},
+	}), {message: 'rate limited'});
+
+	// Backoff is 5-10ms capped at 5, plus exactly 10ms.
+	assert.equal(delays[0], 15);
+	assert.equal(delays[1], 0);
+});
+
+test('retryAfter is still bounded by maxRetryTime', async () => {
+	const start = performance.now();
+
+	await assert.rejects(pRetry(async () => {
+		throw Object.assign(new Error('rate limited'), {retryAfter: 60});
+	}, {
+		minTimeout: 10,
+		maxRetryTime: 100,
+	}), {message: 'rate limited'});
+
+	assert.ok(performance.now() - start < 1000);
+});
+
+test('invalid retryAfter values are ignored', async () => {
+	for (const retryAfter of ['5', -1, NaN, Infinity, null, undefined]) {
+		const delays = [];
+
+		await assert.rejects(pRetry(async () => {
+			throw Object.assign(new Error('fail'), {retryAfter});
+		}, {
+			retries: 1,
+			minTimeout: 1,
+			onFailedAttempt({retryDelay}) {
+				delays.push(retryDelay);
+			},
+		}), {message: 'fail'});
+
+		assert.deepEqual(delays, [1, 0], String(retryAfter));
+	}
+});
+
+test('retryAfter is honoured with minTimeout 0', async () => {
+	const delays = [];
+
+	await assert.rejects(pRetry(async () => {
+		throw Object.assign(new Error('fail'), {retryAfter: 0.02});
+	}, {
+		retries: 1,
+		minTimeout: 0,
+		onFailedAttempt({retryDelay}) {
+			delays.push(retryDelay);
+		},
+	}), {message: 'fail'});
+
+	assert.deepEqual(delays, [20, 0]);
+});
