+def test_inprocess_wrap_option():
+    """In-process: --wrap keeps IDs and URLs intact in wrapped cells"""
+    ticket = "SUPPORT-2024-118233"
+    url = "https://example.com/very/long/path"
+    text = f"id\tnote\n1\tescalated as {ticket} to the vendor\n2\tsee {url} now\n"
+    out = run_main_in_process(["-s", r"\t", "-1", "--wrap", "14"], input_text=text)
+    assert ticket in out
+    assert url in out
+    assert max(len(line) for line in out.splitlines()) > 14  # overflow, not split
+
+
+def test_inprocess_wrap_invalid_width():
+    """In-process: --wrap needs an integer >= 1"""
+    import pytest
+
+    for bad in ["0", "-3", "abc"]:
+        with pytest.raises(SystemExit) as exc_info:
+            run_main_in_process(["--wrap", bad], input_text="a b\n1 2\n")
+        assert exc_info.value.code == 2
