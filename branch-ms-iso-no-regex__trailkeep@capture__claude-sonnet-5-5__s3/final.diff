+
+/**
+ * Format the given milliseconds as an ISO 8601 duration string.
+ *
+ * Days are the largest unit used, since months and years are ambiguous.
+ * Sub-second precision is emitted as a decimal fraction of the seconds
+ * component. Negative values are prefixed with `-`, and zero is `PT0S`.
+ *
+ * @param ms - milliseconds
+ * @returns The ISO 8601 duration, e.g. `P1DT1H1M1S`
+ * @throws Error if `ms` is not a finite number
+ */
+export function formatISO(ms: number): string {
+  if (typeof ms !== 'number' || !Number.isFinite(ms)) {
+    throw new Error('Value provided to ms.formatISO() must be of type number.');
+  }
+
+  let rest = Math.round(Math.abs(ms));
+  const days = Math.floor(rest / d);
+  rest -= days * d;
+  const hours = Math.floor(rest / h);
+  rest -= hours * h;
+  const minutes = Math.floor(rest / m);
+  rest -= minutes * m;
+  const seconds = Math.floor(rest / s);
+  const millis = rest - seconds * s;
+
+  let secondsStr = '';
+  if (millis > 0) {
+    secondsStr = `${seconds}.${String(millis).padStart(3, '0').replace(/0+$/, '')}S`;
+  } else if (seconds > 0) {
+    secondsStr = `${seconds}S`;
+  }
+
+  const time =
+    (hours > 0 ? `${hours}H` : '') +
+    (minutes > 0 ? `${minutes}M` : '') +
+    secondsStr;
+
+  if (days === 0 && time === '') {
+    return 'PT0S';
+  }
+
+  return `${ms < 0 ? '-' : ''}P${days > 0 ? `${days}D` : ''}${time ? `T${time}` : ''}`;
+}
+
+function isDigit(c: string | undefined): boolean {
+  return c !== undefined && c >= '0' && c <= '9';
+}
+
+/**
+ * Parse an ISO 8601 duration string and return milliseconds. The inverse of
+ * `formatISO`.
+ *
+ * Supports weeks, days, hours, minutes and seconds (`PnWnDTnHnMnS`), an
+ * optional leading `-`, and a decimal fraction (`.` or `,`) on any component.
+ * Years and months are ambiguous and are not supported. Components must appear
+ * in order. Implemented by hand, without regular expressions.
+ *
+ * @param str - An ISO 8601 duration, e.g. `PT1H30M`
+ * @returns The duration in milliseconds, or `NaN` if the string is not a
+ * supported ISO 8601 duration
+ * @throws Error if `str` is not a string with length between 1 and 99
+ */
+export function parseISO(str: string): number {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw new Error(
+      `Value provided to ms.parseISO() must be a string with length between 1 and 99. value=${JSON.stringify(str)}`,
+    );
+  }
+
+  let i = 0;
+  let sign = 1;
+  if (str[i] === '-') {
+    sign = -1;
+    i++;
+  }
+  if (str[i] !== 'P') {
+    return NaN;
+  }
+  i++;
+
+  // Units in the order they must appear; the time designator sits before 'H'.
+  const order = ['W', 'D', 'H', 'M', 'S'];
+  const sizes = [w, d, h, m, s];
+  let lastRank = -1;
+  let inTime = false;
+  let components = 0;
+  let timeComponents = 0;
+  let total = 0;
+
+  while (i < str.length) {
+    if (str[i] === 'T') {
+      if (inTime) {
+        return NaN;
+      }
+      inTime = true;
+      i++;
+      continue;
+    }
+
+    const start = i;
+    while (isDigit(str[i])) {
+      i++;
+    }
+    if (i === start) {
+      return NaN;
+    }
+    if (str[i] === '.' || str[i] === ',') {
+      i++;
+      const fracStart = i;
+      while (isDigit(str[i])) {
+        i++;
+      }
+      if (i === fracStart) {
+        return NaN;
+      }
+    }
+    const num = parseFloat(str.slice(start, i).replace(',', '.'));
+
+    const rank = order.indexOf(str[i] ?? '');
+    i++;
+    // Weeks and days are date units; hours, minutes and seconds are time units.
+    if (rank === -1 || rank <= lastRank || rank >= 2 !== inTime) {
+      return NaN;
+    }
+    lastRank = rank;
+    components++;
+    if (inTime) {
+      timeComponents++;
+    }
+    total += num * (sizes[rank] as number);
+  }
+
+  if (components === 0 || (inTime && timeComponents === 0)) {
+    return NaN;
+  }
+
+  return sign * Math.round(total) || 0;
+}
