--- a/index.js
+++ b/index.js
@@ -127,6 +127,30 @@ function format(value, options) {
   return str + unitSeparator + unit;
 }
 
+/**
+ * Rewrite a trailing IEC unit (KiB, MiB, GiB, TiB, PiB; any case) to its
+ * JEDEC equivalent (KB, ...), which has the same value here. Uses plain
+ * string handling on purpose (no regex; see repo notes on ReDoS audit).
+ *
+ * @param {string} str
+ * @returns {string}
+ * @private
+ */
+
+function normalizeIecUnit(str) {
+  var len = str.length;
+
+  if (len < 3 || str.charAt(len - 1).toLowerCase() !== 'b' || str.charAt(len - 2).toLowerCase() !== 'i') {
+    return str;
+  }
+
+  if ('kmgtp'.indexOf(str.charAt(len - 3).toLowerCase()) === -1) {
+    return str;
+  }
+
+  return str.slice(0, len - 2) + str.charAt(len - 1);
+}
+
 /**
  * Parse the string value into an integer in bytes.
  *
@@ -148,7 +172,7 @@ function parse(val) {
   }
 
   // Test if the string passed is valid
-  var results = parseRegExp.exec(val);
+  var results = parseRegExp.exec(normalizeIecUnit(val));
   var floatValue;
   var unit = 'b';
 
diff --git a/test/byte-parse.js b/test/byte-parse.js
index cebfab2..a6325a8 100644
--- a/test/byte-parse.js
+++ b/test/byte-parse.js
@@ -108,4 +108,68 @@ describe('Test byte parse function', function(){
   it('Should allow whitespace', function(){
     assert.equal(bytes.parse('1 TB'), 1 * Math.pow(1024, 4));
   });
+
+  describe('IEC units', function(){
+    ['K', 'M', 'G', 'T', 'P'].forEach(function (letter, i) {
+      var power = i + 1;
+      var name = letter + 'iB';
+
+      it('Should parse ' + name + ' case-insensitively', function(){
+        var expected = Math.pow(1024, power);
+        [name, name.toLowerCase(), name.toUpperCase(), letter.toLowerCase() + 'IB', letter + 'Ib'].forEach(function (unit) {
+          assert.strictEqual(bytes.parse('1' + unit), expected);
+          assert.strictEqual(bytes.parse('1 ' + unit), expected);
+        });
+        assert.strictEqual(bytes.parse('1' + name), bytes.parse('1' + letter + 'B'));
+      });
+
+      it('Should parse fractional and signed ' + name, function(){
+        assert.strictEqual(bytes.parse('1.5' + name), Math.floor(1.5 * Math.pow(1024, power)));
+        assert.strictEqual(bytes.parse('-1.5' + name), Math.floor(-1.5 * Math.pow(1024, power)));
+        assert.strictEqual(bytes.parse('+2' + name), 2 * Math.pow(1024, power));
+      });
+    });
+
+    it('Should not accept malformed IEC units', function(){
+      assert.strictEqual(bytes.parse('KiB'), null);
+      assert.strictEqual(bytes.parse('1iB'), 1);
+      assert.strictEqual(bytes.parse('1BiB'), 1);
+      assert.strictEqual(bytes.parse('1 xiB'), 1);
+      assert.strictEqual(bytes.parse('1KiiB'), 1);
+    });
+  });
+
+  describe('with long junk input', function(){
+    var LENGTH = 100000;
+    var LIMIT_MS = 250; // measured at a few ms; generous to avoid CI flakiness
+
+    function timed(input) {
+      var start = process.hrtime();
+      var result = bytes.parse(input);
+      var diff = process.hrtime(start);
+      return { result: result, ms: diff[0] * 1e3 + diff[1] / 1e6 };
+    }
+
+    it('Should reject a long non-numeric string quickly', function(){
+      var out = timed('x'.repeat(LENGTH));
+      assert.strictEqual(out.result, null);
+      assert.ok(out.ms < LIMIT_MS, 'took ' + out.ms + 'ms');
+    });
+
+    it('Should reject long hostile strings quickly', function(){
+      var inputs = [
+        '!' + '1'.repeat(LENGTH),
+        '1' + ' '.repeat(LENGTH) + '!',
+        '1.' + '1'.repeat(LENGTH) + '!',
+        '1' + '.1'.repeat(LENGTH / 2) + '!',
+        '-'.repeat(LENGTH) + 'kb'
+      ];
+
+      inputs.forEach(function (input) {
+        var out = timed(input);
+        assert.ok(out.result === null || typeof out.result === 'number');
+        assert.ok(out.ms < LIMIT_MS, 'took ' + out.ms + 'ms');
+      });
+    });
+  });
 });
