diff --git a/test/count.js b/test/count.js
new file mode 100644
index 0000000..45ab872
--- /dev/null
+++ b/test/count.js
@@ -0,0 +1,40 @@
+const test = require('tape');
+const fn = require('../lib');
+
+test('count :: short group', t => {
+	t.deepEqual(fn(['-vvv'], { count: 'v' }), { _: [], v: 3 });
+	t.end();
+});
+
+test('count :: long repeated', t => {
+	t.deepEqual(fn(['--verbose', '--verbose'], { count: ['verbose'] }), { _: [], verbose: 2 });
+	t.end();
+});
+
+test('count :: single & absent', t => {
+	t.deepEqual(fn(['-v'], { count: 'v' }), { _: [], v: 1 });
+	t.deepEqual(fn(['-x'], { count: 'v' }), { _: [], x: true });
+	t.end();
+});
+
+test('count :: does not consume next arg', t => {
+	t.deepEqual(fn(['-v', 'foo', '-v'], { count: 'v' }), { _: ['foo'], v: 2 });
+	t.end();
+});
+
+test('count :: aliases share count', t => {
+	const opts = { count: 'v', alias: { v: 'verbose' } };
+	t.deepEqual(fn(['-vv', '--verbose'], opts), { _: [], v: 3, verbose: 3 });
+	t.deepEqual(fn(['--verbose', '-v'], { count: 'verbose', alias: { v: 'verbose' } }), { _: [], v: 2, verbose: 2 });
+	t.end();
+});
+
+test('count :: mixed with other flags', t => {
+	t.deepEqual(fn(['-vvq', '--name', 'x'], { count: ['v'] }), { _: [], v: 2, q: true, name: 'x' });
+	t.end();
+});
+
+test('count :: --v=false is not counted', t => {
+	t.deepEqual(fn(['--v=false', '-v'], { count: 'v' }), { _: [], v: 1 });
+	t.end();
+});
