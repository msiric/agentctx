+
+	await assert.rejects(pRetry(async () => {
+		throw new Error('a');
+	}, {shouldRetry: () => false, onRetry}), {message: 'a'});
+
+	await assert.rejects(pRetry(async () => {
+		throw new AbortError('b');
+	}, {onRetry}), {message: 'b'});
+
+	await assert.rejects(pRetry(async () => {
+		throw new Error('c');
+	}, {retries: 0, onRetry}), {message: 'c'});
+
+	await assert.rejects(pRetry(async () => {
+		throw new TypeError('d');
+	}, {onRetry}), {message: 'd'});
+
+	assert.equal(calls, 0);
+});
+
+test('onRetry is called when shouldConsumeRetry returns false', async () => {
+	let calls = 0;
+	let attempts = 0;
+
+	await pRetry(async () => {
+		if (++attempts < 3) {
+			throw new Error('fail');
+		}
