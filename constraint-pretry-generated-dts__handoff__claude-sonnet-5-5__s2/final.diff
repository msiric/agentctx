+test('onRetry runs only when another attempt follows', async () => {
+	const order = [];
+	const contexts = [];
+
+	await assert.rejects(pRetry(async () => {
+		throw new Error('fail');
+	}, {
+		retries: 2,
+		minTimeout: 0,
+		onFailedAttempt({attemptNumber}) {
+			order.push(`failed${attemptNumber}`);
+		},
+		shouldRetry() {
+			order.push('shouldRetry');
+			return true;
+		},
+		async onRetry(context) {
+			await delay(1);
+			order.push(`retry${context.attemptNumber}`);
+			contexts.push(context);
+		},
+	}), {message: 'fail'});
+
+	// The final failure (attempt 3) has no `onRetry`.
+	assert.deepEqual(order, ['failed1', 'shouldRetry', 'retry1', 'failed2', 'shouldRetry', 'retry2', 'failed3']);
+	assert.deepEqual(contexts.map(({attemptNumber, retriesLeft, retriesConsumed}) => ({attemptNumber, retriesLeft, retriesConsumed})), [
+		{attemptNumber: 1, retriesLeft: 2, retriesConsumed: 0},
+		{attemptNumber: 2, retriesLeft: 1, retriesConsumed: 1},
+	]);
+	assert.ok(Object.isFrozen(contexts[0]));
+});
+
+test('onRetry receives the retry delay and runs before the wait', async t => {
+	await withFakeTime(t);
+	const delays = [];
+	let attempts = 0;
+
+	await pRetry(async () => {
+		if (++attempts < 3) {
+			throw new Error('fail');
+		}
+	}, {
+		minTimeout: 100,
+		onRetry({retryDelay}) {
+			delays.push(retryDelay);
+		},
+	});
+
+	assert.deepEqual(delays, [100, 200]);
+});
+
+test('onRetry is not called when shouldRetry declines, for AbortError, or when retries is 0', async () => {
+	let calls = 0;
+	const onRetry = () => {
+		calls++;
