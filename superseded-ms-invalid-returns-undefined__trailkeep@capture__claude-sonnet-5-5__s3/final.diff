+/**
+ * Parse a compound duration such as `"1h 30m"` or `"2 days 4 hours"` and return
+ * the total in milliseconds. Each piece is parsed with `parse`.
+ *
+ * Every piece must have a unit. Pieces are separated by whitespace and/or a
+ * comma, e.g. `"1h, 30m"`.
+ *
+ * @param str - A compound duration string
+ * @returns The total in milliseconds
+ * @throws TypeError if `str` is not a valid compound duration
+ */
+export function parseCompound(str: string): number {
+  const invalid = () =>
+    new TypeError(
+      `Value provided to ms.parseCompound() must be a compound duration like "1h 30m". value=${JSON.stringify(str)}`,
+    );
+  if (
+    typeof str !== 'string' ||
+    str.length === 0 ||
+    str.length > 100 ||
+    !/^\s*(?:-?\d*\.?\d+ *[a-z]+(?:\s*,\s*(?=-?\.?\d)|\s*))+$/i.test(str)
+  ) {
+    throw invalid();
+  }
+  let total = 0;
+  for (const [piece] of str.matchAll(/-?\d*\.?\d+ *[a-z]+/gi)) {
+    total += parse(piece);
+  }
+  if (Number.isNaN(total)) {
+    throw invalid();
+  }
+  return total;
+}
+
+/**
+ * Parse a timer-style clock string and return the total in milliseconds.
+ * `"m:ss"` (e.g. `"1:30"`) and `"h:mm:ss"` (e.g. `"01:02:03"`) are supported.
+ * Seconds must be two digits and below 60; in `h:mm:ss` minutes must be two
+ * digits and below 60.
+ *
+ * @param str - A clock string
+ * @returns The total in milliseconds, or `undefined` if `str` is not valid
+ */
+export function parseClock(str: string): number | undefined {
+  if (typeof str !== 'string' || str.length > 100) {
+    return undefined;
+  }
+  const match = /^(?:(\d+):([0-5]\d)|(\d+):([0-5]\d):([0-5]\d))$/.exec(str);
+  if (!match) {
+    return undefined;
+  }
+  if (match[1] !== undefined) {
+    return (Number(match[1]) * 60 + Number(match[2])) * 1000;
+  }
+  return (
+    (Number(match[3]) * 3600 + Number(match[4]) * 60 + Number(match[5])) * 1000
+  );
+}
