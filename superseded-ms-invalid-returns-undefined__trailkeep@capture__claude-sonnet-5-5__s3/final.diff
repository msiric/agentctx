+import { describe, expect, it } from '@jest/globals';
+import { parseCompound } from './index';
+
+describe('parseCompound(string)', () => {
+  it('should parse short compound durations', () => {
+    expect(parseCompound('1h 30m')).toBe(5400000);
+  });
+
+  it('should parse long compound durations with spaces', () => {
+    expect(parseCompound('2 days 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
+  });
+
+  it('should parse a single piece', () => {
+    expect(parseCompound('1m')).toBe(60000);
+  });
+
+  it('should handle three pieces, decimals and mixed case', () => {
+    expect(parseCompound('1H 1.5m 500MS')).toBe(3600000 + 90000 + 500);
+  });
+
+  it('should handle negative pieces', () => {
+    expect(parseCompound('1h -30m')).toBe(1800000);
+  });
+
+  it('should ignore surrounding whitespace', () => {
+    expect(parseCompound(' 1h  30m ')).toBe(5400000);
+  });
+
+  it('should throw a TypeError for a piece without a unit', () => {
+    expect(() => parseCompound('1h 30')).toThrow(TypeError);
+  });
+
+  it('should throw a TypeError for an unknown unit', () => {
+    expect(() => parseCompound('1h 30x')).toThrow(TypeError);
+  });
+
+  it('should accept commas between pieces', () => {
+    expect(parseCompound('1h, 30m')).toBe(5400000);
+    expect(parseCompound('1h,30m')).toBe(5400000);
+    expect(parseCompound('2 days , 4 hours, 1m')).toBe(
+      2 * 86400000 + 4 * 3600000 + 60000,
+    );
+  });
+
+  it('should throw a TypeError for stray commas', () => {
+    expect(() => parseCompound('1h,')).toThrow(TypeError);
+    expect(() => parseCompound(',1h')).toThrow(TypeError);
+    expect(() => parseCompound('1h,,30m')).toThrow(TypeError);
+  });
+
+  it('should throw a TypeError for garbage', () => {
+    expect(() => parseCompound('foo')).toThrow(TypeError);
+    expect(() => parseCompound('abc')).toThrow(TypeError);
+  });
+
+  it('should include the input in the error message', () => {
+    expect(() => parseCompound('1h foo')).toThrow(/"1h foo"/);
+  });
+
+  it('should throw a TypeError for an empty string', () => {
+    expect(() => parseCompound('')).toThrow(TypeError);
+  });
+
+  it('should throw a TypeError for a string over 99 characters', () => {
+    expect(() => parseCompound('1h '.repeat(40))).toThrow(TypeError);
+  });
+
+  it('should throw a TypeError for non-strings', () => {
+    expect(() => parseCompound(1 as unknown as string)).toThrow(TypeError);
+  });
+});
