+  describe('truncation (never round up)', function () {
+    var mb = Math.pow(1024, 2);
+    var gb = Math.pow(1024, 3);
+    var tb = Math.pow(1024, 4);
+
+    it('should not round up to 1024 of the lower unit', function () {
+      assert.equal(bytes.format(mb - 1), '1023.99KB');
+      assert.equal(bytes.format(mb - 5), '1023.99KB');
+      assert.equal(bytes.format(gb - 1), '1023.99MB');
+      assert.equal(bytes.format(tb - 1), '1023.99GB');
+      assert.equal(bytes.format(mb), '1MB');
+    });
+
+    it('should truncate extra decimals', function () {
+      assert.equal(bytes.format(2047), '1.99KB');
+      assert.equal(bytes.format(1023.999), '1023.99B');
+      assert.equal(bytes.format(1.5 * kb, {decimalPlaces: 0}), '1KB');
+      assert.equal(bytes.format(mb - 1, {decimalPlaces: 0}), '1023KB');
+      assert.equal(bytes.format(mb - 1, {decimalPlaces: 1}), '1023.9KB');
+    });
+
+    it('should truncate toward zero for negatives', function () {
+      assert.equal(bytes.format(-(mb - 1)), '-1023.99KB');
+      assert.equal(bytes.format(-2047), '-1.99KB');
+      assert.equal(bytes.format(-0.001), '0B');
+    });
+
+    it('should honor fixedDecimals and thousandsSeparator', function () {
+      assert.equal(bytes.format(mb - 1, {fixedDecimals: true}), '1023.99KB');
