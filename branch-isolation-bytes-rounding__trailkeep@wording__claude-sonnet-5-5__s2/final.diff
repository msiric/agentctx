+/**
+ * Format a number with `places` decimals, truncating toward zero.
+ *
+ * Works on the exact decimal expansion of the double to avoid
+ * floating point error from multiply/floor/divide.
+ *
+ * @param {number} val
+ * @param {number} places
+ * @returns {string}
+ * @private
+ */
+
+function truncate(val, places) {
+  var abs = Math.abs(val);
+  var full;
+  if (abs >= 1e21) {
+    // toFixed switches to exponent notation at 1e21; such values are integers
+    /* global BigInt */
+    full = BigInt(abs).toString() + '.' + new Array(101).join('0');
+  } else {
+    // Drop binary float noise (e.g. 1.2 stored as 1.19999999999999995) so
+    // that it is not truncated to 1.19; byte counts are far coarser than
+    // 15 significant digits so real values are unaffected.
+    full = abs < 1e15 ? abs.toPrecision(15) : '';
+    if (!full || full.indexOf('e') !== -1) {
+      full = abs.toFixed(100);
+    } else if (full.indexOf('.') === -1) {
+      full += '.';
+    }
+  }
+  var dot = full.indexOf('.');
+  var frac = full.slice(dot + 1);
+  while (frac.length < places) {
+    frac += '0';
+  }
+  var str = full.slice(0, dot) + (places > 0 ? '.' + frac.slice(0, places) : '');
+  return (val < 0 && /[1-9]/.test(str) ? '-' : '') + str;
+}
