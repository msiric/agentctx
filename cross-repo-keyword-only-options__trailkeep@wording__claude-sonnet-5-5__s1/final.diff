+    def test_to_dict_skip_none(self):
+        prop = self.dict_class(
+            {'a': None, 'b': 1, 'c': {'d': None, 'e': 2},
+             'f': [{'g': None, 'h': 3}, None], 'i': ({'j': None},)})
+        self.assertEqual(
+            prop.to_dict(skip_none=True),
+            {'b': 1, 'c': {'e': 2}, 'f': [{'h': 3}, None], 'i': ({},)})
+        self.assertIsInstance(prop.to_dict(skip_none=True)['i'], tuple)
+
+    def test_to_dict_skip_none_default_off(self):
+        prop = self.dict_class({'a': None, 'b': {'c': None}})
+        self.assertEqual(prop.to_dict(), {'a': None, 'b': {'c': None}})
+        self.assertRaises(TypeError, prop.to_dict, True)
+
     def test_update(self):
