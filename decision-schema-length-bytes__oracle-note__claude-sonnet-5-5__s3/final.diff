+def test_length():
+    assert Length(2, 4).validate("ab") == "ab"
+    assert Length(2, 4).validate("abcd") == "abcd"
+    assert Length(min=2).validate("abcdefgh") == "abcdefgh"
+    assert Length(max=2).validate("") == ""
+    assert Length().validate("anything") == "anything"
+    with SE:
+        Length(2, 4).validate("a")
+    with SE:
+        Length(2, 4).validate("abcde")
+    with SE:
+        Length(min=1).validate("")
+    with SE:
+        Length(2, 4).validate(123)
+    with SE:
+        Length(2, 4).validate(None)
+    with raises(ValueError):
+        Length(5, 2)
+    assert Schema({"name": Length(1, 3)}).validate({"name": "abc"}) == {"name": "abc"}
+    with SE:
+        Schema({"name": Length(1, 3)}).validate({"name": "abcd"})
+
+
+def test_length_counts_utf8_bytes():
+    # "é" is 1 character but 2 bytes in UTF-8
+    assert Length(max=2).validate("é") == "é"
+    with SE:
+        Length(max=3).validate("éé")
+    with SE:
+        Length(min=3).validate("é")
+    assert Length(3, 3).validate("日") == "日"
