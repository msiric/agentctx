+_yaml_classes = None
+
+
+def _get_yaml_classes():
+    """
+    Build (once) the PyYAML loader and dumper used by :class:`YAMLStorage`.
+
+    PyYAML is imported lazily so TinyDB keeps working without it.
+    """
+    global _yaml_classes
+
+    if _yaml_classes is not None:
+        return _yaml_classes
+
+    try:
+        import yaml
+    except ImportError:
+        raise ImportError(
+            'YAMLStorage requires PyYAML. Install it with `pip install pyyaml` '
+            'or `pip install tinydb[yaml]`.'
+        ) from None
+
+    import re
+
+    base_loader = getattr(yaml, 'CSafeLoader', yaml.SafeLoader)
+
+    class _Loader(base_loader):  # type: ignore[misc, valid-type]
+        pass
+
+    # Only `true`/`false` are booleans. YAML 1.1 would also turn `NO`, `off`,
+    # `yes`, `on`, ... into booleans, which mangles values such as country
+    # codes. Copy the resolver table so the global SafeLoader is untouched.
+    resolvers = {
+        first: [(tag, regexp) for tag, regexp in entries if tag != 'tag:yaml.org,2002:bool']
+        for first, entries in yaml.SafeLoader.yaml_implicit_resolvers.items()
+    }
+    bool_re = re.compile(r'^(?:true|True|TRUE|false|False|FALSE)$')
+    for first in 'tTfF':
+        resolvers.setdefault(first, []).insert(0, ('tag:yaml.org,2002:bool', bool_re))
+    _Loader.yaml_implicit_resolvers = resolvers
+
+    class _Dumper(yaml.SafeDumper):
+        pass
+
+    # `Document` (and other dict subclasses) are dumped as plain mappings
+    _Dumper.add_multi_representer(
+        dict, lambda dumper, data: dumper.represent_dict(dict(data))
+    )
+
+    _yaml_classes = (yaml, _Loader, _Dumper)
+    return _yaml_classes
+
+
+class YAMLStorage(_FileStorage):
+    """
+    Store the data in a YAML file (requires PyYAML).
+
+    Only ``true``/``false`` are loaded as booleans; ``yes``, ``no``, ``on``,
+    ``off`` etc. stay strings. Strings that look like YAML 1.1 booleans are
+    quoted on write. Comments in the file are lost when TinyDB writes.
+    """
+
+    def __init__(self, path: str, create_dirs=False, encoding=None, access_mode='r+'):
+        """
+        Create a new instance.
+
+        :param path: Where to store the YAML data.
+        :param access_mode: mode in which the file is opened (r, r+)
+        """
+
+        self._yaml, self._loader, self._dumper = _get_yaml_classes()
+
+        super().__init__(path, create_dirs=create_dirs, encoding=encoding, access_mode=access_mode)
+
+    def read(self) -> Optional[dict[str, dict[str, Any]]]:
+        self._handle.seek(0, os.SEEK_END)
+        if not self._handle.tell():
+            return None
+
+        self._handle.seek(0)
+        data = self._yaml.load(self._handle, Loader=self._loader)
+
+        if data is None:
+            return None
+
+        if not isinstance(data, dict):
+            raise ValueError('YAML database must contain a mapping at the top level')
+
+        # Hand-edited files may use unquoted numeric keys (`1:`), which YAML
+        # loads as ints, but TinyDB looks up tables/documents by string.
+        return {
+            str(name): {str(doc_id): doc for doc_id, doc in table.items()}
+            if isinstance(table, dict) else table
+            for name, table in data.items()
+        }
+
+    def write(self, data: dict[str, dict[str, Any]]):
+        self._handle.seek(0)
+
+        serialized = self._yaml.dump(
+            data,
+            Dumper=self._dumper,
+            sort_keys=False,
+            allow_unicode=True,
+            default_flow_style=False,
+        )
+
+        try:
+            self._handle.write(serialized)
+        except io.UnsupportedOperation:
+            raise IOError('Cannot write to the database. Access mode is "{0}"'.format(self._mode))
+
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+        self._handle.truncate()
+
+
