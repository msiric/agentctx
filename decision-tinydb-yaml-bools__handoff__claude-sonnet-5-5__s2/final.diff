+def test_yaml_storage_roundtrip(tmpdir):
+    pytest.importorskip('yaml')
+    from tinydb.storages import YAMLStorage
+
+    path = str(tmpdir.join('db.yaml'))
+    with TinyDB(path, storage=YAMLStorage) as db:
+        db.insert({'country': 'NO', 'maintenance': 'off', 'on': True, 'n': 1})
+        db.table('t').insert({'x': 'yes'})
+
+    with TinyDB(path, storage=YAMLStorage) as db:
+        assert db.all() == [{'country': 'NO', 'maintenance': 'off', 'on': True, 'n': 1}]
+        assert db.table('t').all() == [{'x': 'yes'}]
+
+
+def test_yaml_storage_hand_edited(tmpdir):
+    pytest.importorskip('yaml')
+    from tinydb.storages import YAMLStorage
+    import yaml
+
+    path = tmpdir.join('db.yaml')
+    path.write(
+        '# ops comment\n_default:\n  1:\n    country: NO\n    maintenance: off\n'
+        '    yes: y\n    live: true\n    dead: False\n'
+    )
+
+    with TinyDB(str(path), storage=YAMLStorage) as db:
+        assert db.get(doc_id=1) == {
+            'country': 'NO', 'maintenance': 'off', 'yes': 'y', 'live': True, 'dead': False
+        }
+        db.update({'k': 2}, doc_ids=[1])
+
+    # The global SafeLoader must be unaffected, and no python tags are written
+    assert yaml.safe_load('a: NO')['a'] is False
+    assert '!!python' not in path.read()
+
+
+def test_yaml_storage_empty_and_rejects_python_tags(tmpdir):
+    pytest.importorskip('yaml')
+    import yaml
+    from tinydb.storages import YAMLStorage
+
+    path = tmpdir.join('db.yaml')
+    s = YAMLStorage(str(path))
+    assert s.read() is None
+    s.close()
+
+    path.write('_default:\n  1: !!python/object/apply:os.getcwd []\n')
+    s = YAMLStorage(str(path))
+    with pytest.raises(yaml.YAMLError):
+        s.read()
+    s.close()
