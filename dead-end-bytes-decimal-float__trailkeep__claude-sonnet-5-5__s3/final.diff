+function parseDecimal(num, exp, negative) {
+  var parts = num.split('.');
+  var frac = parts[1] || '';
+  var digits = parts[0] + frac.slice(0, exp);
+
+  while (frac.length < exp) {
+    digits += '0';
+    frac += '0';
+  }
+
+  var whole = Number(digits);
+  var hasRemainder = /[1-9]/.test(frac.slice(exp));
+
