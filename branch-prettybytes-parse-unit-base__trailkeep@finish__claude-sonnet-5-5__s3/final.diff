@@ -216,3 +216,28 @@ export default function prettyBytes(
 	number: number | bigint,
 	options?: Options
 ): string;
+
+/**
+The reverse of `prettyBytes`: convert a string like `1.5 KiB` to a number of bytes.
+
+Supports plain numbers (`'512'`, `'512 B'`), the binary units `KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`, `ZiB`, and `YiB`, and the units without the `i` (`kB` or `KB`, `MB`, `GB`, `TB`, `PB`, `EB`, `ZB`, and `YB`). All of them are powers of 1024, so `1 KB` and `1 kB` are `1024` bytes and `1 MB` is `1048576`, which is what Windows Explorer shows. This differs from `prettyBytes`, where `1 kB` is `1000` bytes. Fractional values are allowed, and a result that is not a whole number of bytes is truncated. Units are case-sensitive, and the space before the unit is optional.
+
+@param string - The string to parse.
+@returns The number of bytes.
+@throws A `TypeError` if the input is not a string, and a `SyntaxError` if it cannot be parsed or has an unsupported unit.
+
+@example
+```
+import {parseBytes} from 'pretty-bytes';
+
+parseBytes('1.5 KiB');
+//=> 1536
+
+parseBytes('1 MB');
+//=> 1048576
+
+parseBytes('512');
+//=> 512
+```
+*/
+export function parseBytes(string: string): number;
diff --git a/index.js b/index.js
index c5f37ab..c848a52 100644
--- a/index.js
+++ b/index.js
@@ -285,3 +285,41 @@ export default function prettyBytes(number, options) {
 	const result = prefix + numberString + separator + UNITS[exponent];
 	return result.padStart(options.fixedWidth ?? 0);
 }
+
+const BINARY_EXPONENTS = new Map(BIBYTE_UNITS.map((unit, exponent) => [unit, exponent]));
+
+// The units without the `i` are powers of 1024 here, as in Windows Explorer, unlike the SI output of `prettyBytes` where `1 kB` is 1000 bytes.
+const JEDEC_UNITS = ['B', 'KB', 'MB', 'GB', 'TB', 'PB', 'EB', 'ZB', 'YB'];
+const UNIT_EXPONENTS = new Map([
+	...JEDEC_UNITS.map((unit, exponent) => [unit, exponent]),
+	['kB', 1],
+	...BINARY_EXPONENTS,
+]);
+
+// Only plain decimal numbers are accepted: no sign, no exponent, no digit separators.
+const BYTES_PATTERN = /^(?<number>\d+(?:\.\d+)?|\.\d+)(?:\s*(?<unit>[A-Za-z]+))?$/;
+
+/*
+The reverse of `prettyBytes`, for plain numbers and the binary (`KiB` … `YiB`) and `kB`/`KB` … `YB` units, which are all powers of 1024. Units are case-sensitive, the same as the output.
+*/
+export function parseBytes(string) {
+	if (typeof string !== 'string') {
+		throw new TypeError(`Expected a string, got ${typeof string}: ${string}`);
+	}
+
+	const match = BYTES_PATTERN.exec(string.trim());
+
+	if (!match) {
+		throw new SyntaxError(`Unable to parse bytes from: ${JSON.stringify(string)}`);
+	}
+
+	const {number, unit = 'B'} = match.groups;
+	const exponent = UNIT_EXPONENTS.get(unit);
+
+	if (exponent === undefined) {
+		throw new SyntaxError(`Unsupported unit ${JSON.stringify(unit)}, expected one of: ${[...UNIT_EXPONENTS.keys()].join(', ')}`);
+	}
+
+	// A byte count is whole, so a fraction that does not land on a byte is truncated, the same as `prettyBytes` does with the fraction digit options.
+	return Math.floor(Number(number) * (1024 ** exponent));
+}
