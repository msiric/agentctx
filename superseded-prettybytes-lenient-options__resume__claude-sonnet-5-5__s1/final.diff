+##### significantDigits
+
+Type: `number`\
+Default: `3`
+
+The number of significant digits to round to.
+
+Only applies when neither `minimumFractionDigits` nor `maximumFractionDigits` is set. The integer part of the number is never rounded away, so `prettyBytes(123_456, {significantDigits: 1})` is still `123 kB`.
+
+Must be an integer between 1 and 100. Any other value is ignored and the default is used.
+
+```js
+import prettyBytes from 'pretty-bytes';
+
+prettyBytes(1337, {significantDigits: 2});
+//=> '1.3 kB'
+
+prettyBytes(1337, {significantDigits: 4});
+//=> '1.337 kB'
+
+prettyBytes(1337);
+//=> '1.34 kB'
+```
+
 ##### space
 
 Type: `boolean`\
diff --git a/test.js b/test.js
index af32138..ce1a876 100644
--- a/test.js
+++ b/test.js
@@ -1190,3 +1190,30 @@ test('unit must belong to the active unit system', t => {
 		prettyBytes(10n ** 400n, {unit: 'nope'});
 	}, {instanceOf: TypeError});
 });
+
+test('significantDigits changes the default rounding', t => {
+	t.is(prettyBytes(1337, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 3}), '1.34 kB');
+	t.is(prettyBytes(1337n, {significantDigits: 4}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4, locale: 'de'}), '1,337 kB');
+	t.is(prettyBytes(1024, {significantDigits: 2, binary: true}), '1 KiB');
+
+	// The integer part is never rounded away.
+	t.is(prettyBytes(123_456, {significantDigits: 1}), '123 kB');
+
+	// A carry across a unit boundary still happens.
+	t.is(prettyBytes(999_500, {significantDigits: 1}), '1 MB');
+});
+
+test('significantDigits is ignored when a fraction digit option is set', t => {
+	t.is(prettyBytes(1337, {significantDigits: 2, maximumFractionDigits: 3}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4, minimumFractionDigits: 1}), '1.337 kB');
+});
+
+test('an invalid significantDigits is ignored and never throws', t => {
+	for (const significantDigits of [0, -1, 101, 1.5, Number.NaN, Infinity, '2', null, undefined, {}, [], true, 2n]) {
+		t.is(prettyBytes(1337, {significantDigits}), '1.34 kB', `${String(significantDigits)}`);
+		t.is(prettyBytes(1337n, {significantDigits}), '1.34 kB', `${String(significantDigits)}`);
+	}
+});
