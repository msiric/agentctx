+
+describe('format(number, { compound: true })', () => {
+  it('should combine units, largest first', () => {
+    expect(format(5400000, { compound: true })).toBe('1h 30m');
+    expect(format(90061000, { compound: true })).toBe('1d 1h 1m 1s');
+    expect(format(8 * 86400000, { compound: true })).toBe('8d');
+  });
+
+  it('should skip zero parts and drop milliseconds', () => {
+    expect(format(3600000 + 5000, { compound: true })).toBe('1h 5s');
+    expect(format(1999, { compound: true })).toBe('1s');
+    expect(format(500, { compound: true })).toBe('0s');
+  });
+
+  it('should handle negatives', () => {
+    expect(format(-5400000, { compound: true })).toBe('-1h 30m');
+    expect(format(-500, { compound: true })).toBe('0s');
+  });
+});
+
+describe('compound option edge cases', () => {
+  it('should be ignored when long is true', () => {
+    expect(format(5400000, { long: true, compound: true })).toBe('2 hours');
+  });
+
+  it('should not change output when false', () => {
+    expect(format(5400000, { compound: false })).toBe('2h');
+  });
+
+  it('should roll over exact boundaries', () => {
+    expect(format(60000, { compound: true })).toBe('1m');
+    expect(format(86400000, { compound: true })).toBe('1d');
+    expect(format(0, { compound: true })).toBe('0s');
+  });
+
+  it('should work through ms()', () => {
+    expect(ms(5400000, { compound: true })).toBe('1h 30m');
+  });
+});
+
+describe('compound option additional cases', () => {
+  it('should throw on non-finite values', () => {
+    expect(() => format(NaN, { compound: true })).toThrow();
+    expect(() => format(Infinity, { compound: true })).toThrow();
+  });
+
+  it('should handle fractional milliseconds', () => {
+    expect(format(1500.9, { compound: true })).toBe('1s');
+    expect(format(59999.9, { compound: true })).toBe('59s');
+  });
+
+  it('should not roll days into larger units', () => {
+    expect(format(400 * 86400000 + 3600000, { compound: true })).toBe(
+      '400d 1h',
+    );
+  });
+
+  it('should round-trip through parse for whole seconds', () => {
+    const value = 90061000;
+    const text = format(value, { compound: true });
+    const total = text
+      .split(' ')
+      .reduce((sum, part) => sum + (ms(part as never) as number), 0);
+    expect(total).toBe(value);
+  });
+});
