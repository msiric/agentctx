diff --git a/addict/addict.py b/addict/addict.py
index 55e02d1..3eb6113 100644
--- a/addict/addict.py
+++ b/addict/addict.py
@@ -74,15 +74,18 @@ class Dict(dict):
     def __delattr__(self, name):
         del self[name]
 
-    def to_dict(self):
+    def to_dict(self, *, skip_none=False):
         base = {}
         for key, value in self.items():
+            if skip_none and value is None:
+                continue
             if isinstance(value, type(self)):
-                base[key] = value.to_dict()
+                base[key] = value.to_dict(skip_none=skip_none)
             elif isinstance(value, (list, tuple)):
                 base[key] = type(value)(
-                    item.to_dict() if isinstance(item, type(self)) else
-                    item for item in value)
+                    item.to_dict(skip_none=skip_none)
+                    if isinstance(item, type(self)) else item
+                    for item in value)
             else:
                 base[key] = value
         return base
diff --git a/test_addict.py b/test_addict.py
index b4af646..b02b8cd 100644
--- a/test_addict.py
+++ b/test_addict.py
@@ -218,6 +218,28 @@ class AbstractTestsClass(object):
         self.assertIsInstance(regular['a'], tuple)
         self.assertNotIsInstance(regular['a'][0], self.dict_class)
 
+    def test_to_dict_skip_none(self):
+        nested = {'a': None, 'b': 1,
+                  'c': {'d': None, 'e': 2, 'f': {'g': None}},
+                  'h': [{'i': None, 'j': 3}, None, 4],
+                  'k': ({'l': None},)}
+        prop = self.dict_class(nested)
+        regular = prop.to_dict(skip_none=True)
+        self.assertEqual(regular, {
+            'b': 1,
+            'c': {'e': 2, 'f': {}},
+            'h': [{'j': 3}, None, 4],
+            'k': ({},)})
+        self.assertNotIsInstance(regular['c'], self.dict_class)
+        self.assertNotIsInstance(regular['h'][0], self.dict_class)
+
+    def test_to_dict_keeps_none_by_default(self):
+        prop = self.dict_class({'a': None, 'b': {'c': None}})
+        self.assertEqual(prop.to_dict(), {'a': None, 'b': {'c': None}})
+
+    def test_to_dict_skip_none_keyword_only(self):
+        self.assertRaises(TypeError, self.dict_class().to_dict, True)
+
     def test_update(self):
         old = self.dict_class()
         old.child.a = 'a'
