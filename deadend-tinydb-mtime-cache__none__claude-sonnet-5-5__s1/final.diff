+"""
+Benchmark read performance of JSONStorage on a large database.
+
+Usage: python scripts/bench_read.py [target_mb] [repeats]
+
+Generates a ~target_mb JSON db in a temp dir, then times:
+  * raw json.load of the file (the lower bound for any read)
+  * db.all()
+  * db.search() (query cache cleared each run so it measures a real search)
+  * the same two calls through CachingMiddleware, for comparison
+"""
+import json
+import os
+import random
+import statistics
+import sys
+import tempfile
+import time
+
+from tinydb import TinyDB, where
+from tinydb.middlewares import CachingMiddleware
+from tinydb.storages import JSONStorage
+
+
+def generate(path, target_mb):
+    rnd = random.Random(0)
+    docs = {}
+    size = 0
+    i = 1
+    while size < target_mb * 1024 * 1024:
+        doc = {
+            'name': 'user%d' % i,
+            'age': rnd.randint(18, 90),
+            'email': 'user%d@example.com' % i,
+            'tags': [rnd.choice('abcdefgh') for _ in range(5)],
+            'address': {'city': rnd.choice(['Berlin', 'Paris', 'Rome']), 'zip': rnd.randint(10000, 99999)},
+        }
+        docs[str(i)] = doc
+        size += len(json.dumps(doc)) + 8
+        i += 1
+    with open(path, 'w') as f:
+        json.dump({'_default': docs}, f)
+    return len(docs)
+
+
+def timeit(fn, repeats):
+    times = []
+    for _ in range(repeats):
+        t = time.perf_counter()
+        fn()
+        times.append(time.perf_counter() - t)
+    return statistics.median(times)
+
+
+def main():
+    target_mb = float(sys.argv[1]) if len(sys.argv) > 1 else 40
+    repeats = int(sys.argv[2]) if len(sys.argv) > 2 else 5
+
+    with tempfile.TemporaryDirectory() as d:
+        path = os.path.join(d, 'db.json')
+        n = generate(path, target_mb)
+        print('db: %d docs, %.1f MB, median of %d runs' % (n, os.path.getsize(path) / 1e6, repeats))
+
+        def raw_load():
+            with open(path) as f:
+                json.load(f)
+
+        def read_only():
+            with open(path) as f:
+                f.read()
+
+        results = [('file read (no parse)', timeit(read_only, repeats)),
+                   ('json.load (lower bound)', timeit(raw_load, repeats))]
+
+        db = TinyDB(path)
+        table = db.table('_default')
+
+        def search():
+            table.clear_cache()
+            table.search(where('age') > 80)
+
+        results += [('JSONStorage db.all()', timeit(db.all, repeats)),
+                    ('JSONStorage search', timeit(search, repeats)),
+                    ('JSONStorage get(doc_id)', timeit(lambda: table.get(doc_id=n // 2), repeats))]
+        db.close()
+
+        db = TinyDB(path, storage=CachingMiddleware(JSONStorage))
+        table = db.table('_default')
+        db.all()  # warm
+
+        def search_c():
+            table.clear_cache()
+            table.search(where('age') > 80)
+
+        results += [('Caching db.all()', timeit(db.all, repeats)),
+                    ('Caching search', timeit(search_c, repeats))]
+        db.close()
+
+        for name, t in results:
+            print('%-28s %8.1f ms' % (name, t * 1000))
+
+
+if __name__ == '__main__':
+    main()
