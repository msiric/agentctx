+
+test('parseBytes: plain numbers and bytes', t => {
+	t.is(parseBytes('512'), 512);
+	t.is(parseBytes('512 B'), 512);
+	t.is(parseBytes('512B'), 512);
+	t.is(parseBytes('0'), 0);
+	t.is(parseBytes('  42 B  '), 42);
+	t.is(parseBytes('.5'), 0.5);
+	t.is(parseBytes('-1 KiB'), -1024);
+});
+
+test('parseBytes: binary units', t => {
+	for (const [index, unit] of BINARY_UNITS.entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1024 ** index);
+		t.is(parseBytes(`2${unit}`), 2 * (1024 ** index));
+	}
+
+	t.is(parseBytes('1 YiB'), 2 ** 80);
+});
+
+test('parseBytes: fractional values', t => {
+	t.is(parseBytes('1.5 KiB'), 1536);
+	t.is(parseBytes('0.5 MiB'), 524_288);
+	t.is(parseBytes('1. KiB'), 1024);
+});
+
+test('parseBytes: round-trips prettyBytes output', t => {
+	t.is(parseBytes(prettyBytes(1536, {binary: true})), 1536);
+	t.is(parseBytes(prettyBytes(5 * (1024 ** 3), {binary: true})), 5 * (1024 ** 3));
+});
+
+test('parseBytes: units are case-sensitive', t => {
+	for (const input of ['1 kib', '1 KIB', '1 kiB', '1 mib', '1 b', '1 Kib']) {
+		t.throws(() => parseBytes(input), {instanceOf: TypeError}, `${input}`);
+	}
+});
+
+test('parseBytes: decimal units', t => {
+	for (const [index, unit] of DECIMAL_UNITS.entries()) {
+		t.is(parseBytes(`1 ${unit}`), Number(`1e${3 * index}`));
+		t.is(parseBytes(`2${unit}`), Number(`2e${3 * index}`));
+	}
+
+	t.is(parseBytes('1 KB'), 1000);
+	t.is(parseBytes('1.5 kB'), 1500);
+	t.is(parseBytes('1.5 KB'), 1500);
+	t.is(parseBytes('-2 MB'), -2_000_000);
+	t.is(parseBytes('1 YB'), 1e24);
+});
+
+test('parseBytes: round-trips decimal prettyBytes output', t => {
+	t.is(parseBytes(prettyBytes(1500)), 1500);
+	t.is(parseBytes(prettyBytes(5e9)), 5e9);
+});
+
+test('parseBytes: unsupported or wrongly cased decimal units', t => {
+	for (const input of ['1 kb', '1 Kb', '1 mB', '1 Mb', '1 gb', '1 kbit', '1 Mbit', '1 kiB']) {
+		t.throws(() => parseBytes(input), {instanceOf: TypeError}, `${input}`);
+	}
+});
+
+test('parseBytes: invalid input', t => {
+	for (const input of ['', ' ', 'KiB', 'abc', '1 2 KiB', '1,5 KiB', '1e3', '1 KiB B', '0x10', 'NaN', 'Infinity', '1.2.3 KiB']) {
+		t.throws(() => parseBytes(input), {instanceOf: TypeError}, `${input}`);
+	}
+
+	for (const input of [1, undefined, null, {}, 10n]) {
+		t.throws(() => parseBytes(input), {instanceOf: TypeError});
+	}
+
+	t.throws(() => parseBytes(`1${'0'.repeat(400)}`), {instanceOf: RangeError});
+});
