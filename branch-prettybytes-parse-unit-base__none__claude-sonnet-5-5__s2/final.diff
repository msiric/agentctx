--- a/index.d.ts
+++ b/index.d.ts
@@ -216,3 +216,15 @@ export default function prettyBytes(
 	number: number | bigint,
 	options?: Options
 ): string;
+
+/**
+Parse a human readable size string into a number of bytes, the reverse of `prettyBytes`.
+
+Accepts a plain number (`'512'`), or a number followed by an optional space and one of the units `B`, the decimal units `kB` (or `KB`), `MB`, `GB`, `TB`, `PB`, `EB`, `ZB`, `YB` (powers of 1000), or the binary units `KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`, `ZiB`, `YiB` (powers of 1024). Fractional values are allowed, so `'1.5 kB'` is `1500` and `'1.5 KiB'` is `1536`. Units are case-sensitive. Bit units are not supported.
+
+@param string - The size to parse.
+@returns The number of bytes. Fractional results are not rounded.
+@throws {TypeError} If the input is not a string or is not a valid size.
+@throws {RangeError} If the result is not a finite number.
+*/
+export function parseBytes(string: string): number;
diff --git a/index.js b/index.js
index c5f37ab..3ca4554 100644
--- a/index.js
+++ b/index.js
@@ -285,3 +285,31 @@ export default function prettyBytes(number, options) {
 	const result = prefix + numberString + separator + UNITS[exponent];
 	return result.padStart(options.fixedWidth ?? 0);
 }
+
+// Unit names are case-sensitive, like the output of `prettyBytes`. `KB` is accepted as an alias of `kB`.
+const PARSE_PATTERN = /^([+-]?(?:\d+(?:\.\d*)?|\.\d+))(?:\s*(B|[kK]B|[MGTPEZY]B|[KMGTPEZY]iB))?$/;
+
+export function parseBytes(string) {
+	if (typeof string !== 'string') {
+		throw new TypeError(`Expected a string, got \`${typeof string}\``);
+	}
+
+	const match = PARSE_PATTERN.exec(string.trim());
+
+	if (!match) {
+		throw new TypeError(`Cannot parse \`${string}\` as a number of bytes`);
+	}
+
+	const [, numberString, unit = 'B'] = match;
+	const binaryIndex = BIBYTE_UNITS.indexOf(unit);
+	const result = binaryIndex === -1
+		// Scaled through the exponent so `1000 ** 8` style inexact powers are never involved.
+		? Number(`${numberString}e${3 * BYTE_UNITS.indexOf(unit === 'KB' ? 'kB' : unit)}`)
+		: Number(numberString) * (1024 ** binaryIndex);
+
+	if (!Number.isFinite(result)) {
+		throw new RangeError(`\`${string}\` is too large to represent`);
+	}
+
+	return result;
+}
