+
+def test_local_snowflake_keywords():
+    sql_ = ('select * exclude (a) from t asof join u '
+            'match_condition (t.x >= u.x)')
+    assert sqlparse.format(sql_, keyword_case='upper') == (
+        'SELECT * EXCLUDE (a) FROM t ASOF JOIN u '
+        'MATCH_CONDITION (t.x >= u.x)')
+    assert sqlparse.format(
+        'select * from t match_recognize (partition by a)',
+        keyword_case='upper',
+    ) == 'SELECT * FROM t MATCH_RECOGNIZE (PARTITION BY a)'
