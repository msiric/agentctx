diff --git a/sqlparse/extra_keywords.py b/sqlparse/extra_keywords.py
new file mode 100644
index 0000000..13e180b
--- /dev/null
+++ b/sqlparse/extra_keywords.py
@@ -0,0 +1,29 @@
+"""Local keyword additions, kept out of ``keywords.py``.
+
+``keywords.py`` must stay identical to upstream so merges stay clean.
+Keywords we need beyond upstream are registered on the default lexer here.
+"""
+
+from sqlparse import tokens
+from sqlparse.lexer import Lexer
+
+KEYWORDS_LOCAL = {
+    'ASOF': tokens.Keyword,
+    'EXCLUDE': tokens.Keyword,
+    'MATCH_CONDITION': tokens.Keyword,
+    'MATCH_RECOGNIZE': tokens.Keyword,
+}
+
+
+_orig_default_initialization = Lexer.default_initialization
+
+
+def _default_initialization(self):
+    # Keep our keywords when the lexer is reset to its defaults.
+    _orig_default_initialization(self)
+    self.add_keywords(KEYWORDS_LOCAL)
+
+
+def register():
+    Lexer.default_initialization = _default_initialization
+    Lexer.get_default_instance().default_initialization()
diff --git a/tests/test_cli.py b/tests/test_cli.py
index f33b534..6d1ecee 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -235,3 +235,29 @@ def test_cli_outfile_keeps_file_on_format_error(tmpdir, capsys):
     assert out_file.read() == "select 1"
     _, err = capsys.readouterr()
     assert err.startswith("[ERROR] Failed to format")
+
+
+def test_check_reports_changed_files_without_writing(tmpdir, capsys):
+    changed = tmpdir.join('changed.sql')
+    changed.write('select a from b')
+    clean = tmpdir.join('clean.sql')
+    clean.write('SELECT a')
+    rc = sqlparse.cli.main(['--check', '-k', 'upper',
+                            str(changed), str(clean)])
+    assert rc == 1
+    assert capsys.readouterr().out == f'{changed}\n'
+    assert changed.read() == 'select a from b'
+
+
+def test_check_clean_exits_zero(tmpdir, capsys):
+    clean = tmpdir.join('clean.sql')
+    clean.write('SELECT a')
+    assert sqlparse.cli.main(['--check', '-k', 'upper', str(clean)]) == 0
+    assert capsys.readouterr().out == ''
+
+
+def test_check_incompatible_with_inplace(tmpdir, capsys):
+    f = tmpdir.join('f.sql')
+    f.write('select 1')
+    assert sqlparse.cli.main(['--check', '--in-place', str(f)]) == 1
+    assert f.read() == 'select 1'
