+from tests import unittest
+
+from jmespath import dashboard
+
+
+class TestRoundTo(unittest.TestCase):
+
+    def test_basic_rounding(self):
+        self.assertEqual(dashboard.search('round_to(`3.14159`, `2`)', {}), 3.14)
+
+    def test_rounds_half_to_even(self):
+        # Must match Python's round() and pandas: ties go to the even
+        # neighbor, not away from zero.
+        cases = [
+            ('2.5', '0', 2), ('3.5', '0', 4), ('0.5', '0', 0),
+            ('1.5', '0', 2), ('-0.5', '0', 0), ('-1.5', '0', -2),
+            ('-2.5', '0', -2),
+            # Exactly representable ties at a nonzero digit count.
+            ('0.125', '2', 0.12), ('0.375', '2', 0.38),
+        ]
+        for number, digits, expected in cases:
+            expr = 'round_to(`%s`, `%s`)' % (number, digits)
+            self.assertEqual(dashboard.search(expr, {}), expected, expr)
+
+    def test_negative_digits(self):
+        self.assertEqual(dashboard.search('round_to(`1250`, `-2`)', {}), 1200)
+
+    def test_fractional_digits_rejected(self):
+        from jmespath.exceptions import JMESPathError
+        with self.assertRaises(JMESPathError):
+            dashboard.search('round_to(`1.5`, `0.5`)', {})
+
+    def test_builtins_still_available(self):
+        self.assertEqual(dashboard.search('abs(`-1`)', {}), 1)
+
+
+class TestClamp(unittest.TestCase):
+
+    def test_clamp(self):
+        cases = [
+            ('5', '0', '10', 5), ('-5', '0', '10', 0),
+            ('15', '0', '10', 10), ('0', '0', '10', 0),
+            ('10', '0', '10', 10), ('1.5', '1', '2', 1.5),
+            ('-3', '-2', '-1', -2),
+        ]
+        for value, lo, hi, expected in cases:
+            expr = 'clamp(`%s`, `%s`, `%s`)' % (value, lo, hi)
+            self.assertEqual(dashboard.search(expr, {}), expected, expr)
+
+    def test_lo_greater_than_hi_rejected(self):
+        from jmespath.exceptions import JMESPathError
+        with self.assertRaises(JMESPathError):
+            dashboard.search('clamp(`1`, `10`, `0`)', {})
+
+    def test_non_number_rejected(self):
+        from jmespath.exceptions import JMESPathError
+        with self.assertRaises(JMESPathError):
+            dashboard.search('clamp(`"a"`, `0`, `1`)', {})
+
+
+class TestPercent(unittest.TestCase):
+
+    def test_percent(self):
+        cases = [
+            ('1', '3', '2', 33.33), ('1', '4', '0', 25), ('1', '2', '1', 50.0),
+            ('0', '5', '2', 0), ('3', '2', '0', 150), ('-1', '4', '0', -25),
+            ('1', '8', '1', 12.5),
+        ]
+        for part, whole, digits, expected in cases:
+            expr = 'percent(`%s`, `%s`, `%s`)' % (part, whole, digits)
+            self.assertEqual(dashboard.search(expr, {}), expected, expr)
+
+    def test_zero_whole_rejected(self):
+        from jmespath.exceptions import JMESPathError
+        with self.assertRaises(JMESPathError):
+            dashboard.search('percent(`1`, `0`, `2`)', {})
+
+    def test_fractional_digits_rejected(self):
+        from jmespath.exceptions import JMESPathError
+        with self.assertRaises(JMESPathError):
+            dashboard.search('percent(`1`, `2`, `0.5`)', {})
+
