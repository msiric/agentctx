+def test_gzip_json_storage(tmpdir):
+    path = str(tmpdir.join('test.json.gz'))
+
+    with TinyDB(path, storage=GzipJSONStorage) as db:
+        for i in range(100):
+            db.insert({'int': i, 'text': 'hello' * 20})
+
+    with open(path, 'rb') as f:
+        assert f.read(2) == b'\x1f\x8b'  # gzip magic number
+
+    with TinyDB(path, storage=GzipJSONStorage) as db:
+        assert len(db) == 100
+        db.remove(where('int') >= 5)
+
+    with TinyDB(path, storage=GzipJSONStorage) as db:
+        assert len(db) == 5
+
+
+def test_gzip_json_storage_invalid_mode(tmpdir):
+    with pytest.raises(ValueError):
+        GzipJSONStorage(str(tmpdir.join('x.gz')), access_mode='w')
