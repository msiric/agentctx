+class NonEmpty:
+    """
+    Validates that data is not empty: rejects empty or whitespace-only
+    strings and empty lists, tuples, sets and dicts. Valid data is
+    returned unchanged. Any other type is rejected.
+    """
+
+    def __init__(self, error: Union[str, None] = None) -> None:
+        self._error: Union[str, None] = error
+
+    def __repr__(self) -> str:
+        return f"{self.__class__.__name__}()"
+
+    def validate(self, data: Any, **kwargs: Any) -> Any:
+        """
+        Validates that data is non-empty.
+        :param data: Data to be validated.
+        :return: Returns validated data, unchanged.
+        """
+        e = self._error
+
+        if isinstance(data, (str, bytes)):
+            if data.strip():
+                return data
+            reason = "is empty or whitespace-only"
+        elif isinstance(data, (list, tuple, set, frozenset, dict)):
+            if data:
+                return data
+            reason = "is empty"
+        else:
+            reason = f"of type {type(data).__name__} is not a string, list, tuple, set or dict"
+        # Never include the validated value: these errors may be reported to
+        # external services. The custom error is therefore used verbatim
+        # (not .format(data)-ed).
+        raise SchemaError(e if e else f"value {reason}")
+
+
+class Range:
+    """
+    Validates that data is an int or float within inclusive bounds.
+    Either bound may be None (unbounded). bool and NaN are rejected.
+    """
+
+    def __init__(
+        self,
+        min: Union[int, float, None] = None,
+        max: Union[int, float, None] = None,
+        error: Union[str, None] = None,
+    ) -> None:
+        if min is not None and max is not None and min > max:
+            raise ValueError("Range min must not be greater than max")
+        self._min = min
+        self._max = max
+        self._error: Union[str, None] = error
+
+    def __repr__(self) -> str:
+        return f"{self.__class__.__name__}(min={self._min!r}, max={self._max!r})"
+
+    def validate(self, data: Any, **kwargs: Any) -> Any:
+        """
+        Validates that data is a number within [min, max].
+        :param data: Data to be validated.
+        :return: Returns validated data, unchanged.
+        """
+        if isinstance(data, bool) or not isinstance(data, (int, float)):
+            reason = f"of type {type(data).__name__} is not an int or float"
+        elif data != data:
+            reason = "is not a number (NaN)"
+        elif self._min is not None and data < self._min:
+            reason = f"is less than the minimum {self._min!r}"
+        elif self._max is not None and data > self._max:
+            reason = f"is greater than the maximum {self._max!r}"
+        else:
+            return data
+        # Never include the validated value (see NonEmpty).
+        raise SchemaError(self._error if self._error else f"value {reason}")
+
+
+class OneOf:
+    """
+    Validates that data is equal to one of the given choices.
+    Valid data is returned unchanged.
+    """
+
+    def __init__(self, *choices: Any, error: Union[str, None] = None) -> None:
+        if not choices:
+            raise ValueError("OneOf requires at least one choice")
+        self._choices = choices
+        self._error: Union[str, None] = error
+
+    def __repr__(self) -> str:
+        return f"{self.__class__.__name__}({', '.join(map(repr, self._choices))})"
+
+    def validate(self, data: Any, **kwargs: Any) -> Any:
+        """
+        Validates that data is one of the choices.
+        :param data: Data to be validated.
+        :return: Returns validated data, unchanged.
+        """
+        for choice in self._choices:
+            if type(data) is type(choice) and data == choice:
+                return data
+        # Never include the validated value (see NonEmpty). The allowed
+        # choices are schema-defined, so listing them is safe.
+        raise SchemaError(
+            self._error
+            if self._error
+            else f"value is not one of {list(self._choices)!r}"
+        )
+
+
