@@ -2100,3 +2103,92 @@ def test_tuple_key_error_message_does_not_crash():
     with raises(SchemaError) as exc_info:
         Schema({("a", "b"): int}).validate({("a", "b"): "not-an-int"})
     assert "Key '('a', 'b')' error:" in exc_info.value.code
+
+
+def test_nonempty():
+    assert NonEmpty().validate("a") == "a"
+    assert NonEmpty().validate("  a ") == "  a "  # returned unchanged
+    assert NonEmpty().validate([0]) == [0]
+    assert NonEmpty().validate({"k": None}) == {"k": None}
+    for bad in ["", "   ", "\t\n", b"", b"  ", [], (), set(), {}, None, 0, 1]:
+        with raises(SchemaError):
+            NonEmpty().validate(bad)
+    # Usable inside a Schema
+    assert Schema({"name": NonEmpty()}).validate({"name": "x"}) == {"name": "x"}
+    with raises(SchemaError):
+        Schema({"name": NonEmpty()}).validate({"name": " "})
+    assert Schema(And(str, NonEmpty())).validate("ok") == "ok"
+
+
+def test_nonempty_error_message():
+    with raises(SchemaError) as e:
+        NonEmpty().validate("  ")
+    assert "empty or whitespace-only" in e.value.code
+    with raises(SchemaError) as e:
+        Schema({"name": NonEmpty(error="name required")}).validate({"name": ""})
+    assert "name required" in e.value.code
+
+
+def test_nonempty_error_never_contains_value():
+    secrets = [5551234567, "   ", b"  ", 1.5]
+    for secret in secrets:
+        for validator in (NonEmpty(), NonEmpty(error="bad {!r} {}")):
+            with raises(SchemaError) as e:
+                Schema({"phone": validator}).validate({"phone": secret})
+            text = str(e.value) + " ".join(str(x) for x in e.value.autos + e.value.errors if x)
+            assert str(secret).strip() == "" or str(secret) not in text
+            assert repr(secret) not in text.replace("{!r}", "")
+
+
+def test_range():
+    r = Range(min=1, max=5)
+    for ok in [1, 5, 3, 1.0, 5.0, 2.5]:
+        assert r.validate(ok) == ok
+    for bad in [0, 6, 0.99, 5.01, "3", None, [3], True, False, float("nan")]:
+        with raises(SchemaError):
+            r.validate(bad)
+    assert Range(min=0).validate(10**9) == 10**9
+    assert Range(max=0).validate(-10**9) == -10**9
+    assert Range().validate(7) == 7
+    with raises(SchemaError):
+        Range().validate("7")
+    with raises(ValueError):
+        Range(min=5, max=1)
+    assert Schema({"age": Range(0, 150)}).validate({"age": 30}) == {"age": 30}
+    with raises(SchemaError):
+        Schema({"age": Range(0, 150)}).validate({"age": 200})
+    assert Schema(And(int, Range(max=3))).validate(3) == 3
+
+
+def test_range_error_never_contains_value():
+    with raises(SchemaError) as e:
+        Range(max=5).validate(987654321)
+    assert "987654321" not in e.value.code
+    assert "maximum 5" in e.value.code
+    with raises(SchemaError) as e:
+        Range(min=1, error="out of range").validate(0)
+    assert e.value.code == "out of range"
+
+
+def test_oneof():
+    o = OneOf("a", "b", 3)
+    for ok in ["a", "b", 3]:
+        assert o.validate(ok) == ok
+    for bad in ["c", "A", None, 4, ["a"], {"a": 1}, 3.0, True]:
+        with raises(SchemaError):
+            o.validate(bad)
+    with raises(ValueError):
+        OneOf()
+    assert Schema({"s": OneOf("on", "off")}).validate({"s": "on"}) == {"s": "on"}
+    with raises(SchemaError):
+        Schema({"s": OneOf("on", "off")}).validate({"s": "maybe"})
+
+
+def test_oneof_error_never_contains_value():
+    with raises(SchemaError) as e:
+        OneOf("a", "b").validate("secret-token")
+    assert "secret-token" not in e.value.code
+    assert "'a'" in e.value.code
+    with raises(SchemaError) as e:
+        OneOf("a", error="bad choice").validate("x")
+    assert e.value.code == "bad choice"
