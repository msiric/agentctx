@@ -0,0 +1,90 @@
+import { describe, expect, test } from "vitest";
+import { isSameOrigin } from "../src";
+
+describe("isSameOrigin", () => {
+  const sameOrigin = [
+    // Identical
+    ["https://example.com", "https://example.com"],
+    // Path, query and fragment are ignored
+    ["https://example.com/foo", "https://example.com/bar"],
+    ["https://example.com/foo?a=1#x", "https://example.com/bar?b=2#y"],
+    ["https://example.com", "https://example.com/"],
+    // Credentials are not part of the origin
+    ["https://user:pass@example.com", "https://example.com"],
+    // Protocol and host are case-insensitive
+    ["HTTPS://EXAMPLE.COM", "https://example.com"],
+    // Identical explicit ports match each other
+    ["https://example.com:443/a", "https://example.com:443/b"],
+    ["http://localhost:3000/a", "http://localhost:3000/b"],
+    // Default ports are normalized
+    ["https://example.com", "https://example.com:443"],
+    ["http://example.com", "http://example.com:80"],
+    ["wss://example.com", "wss://example.com:443"],
+    ["ws://example.com", "ws://example.com:80"],
+    // Unicode host equals its punycode form
+    ["https://münchen.de", "https://xn--mnchen-3ya.de"],
+    // IPv6
+    ["http://[::1]:8080/a", "http://[::1]:8080/b"],
+    // Both relative (no origin to differ on)
+    ["/foo", "/bar"],
+    ["foo", "/bar"],
+    ["", "/"],
+    // Relative vs absolute is NOT same-origin; see notSameOrigin
+  ];
+
+  const notSameOrigin = [
+    // Different protocol
+    ["http://example.com", "https://example.com"],
+    ["ws://example.com", "wss://example.com"],
+    // Different host
+    ["https://example.com", "https://example.org"],
+    // Subdomains are different origins
+    ["https://example.com", "https://www.example.com"],
+    ["https://a.example.com", "https://b.example.com"],
+    // Different port
+    ["https://example.com:8443", "https://example.com"],
+    ["http://localhost:3000", "http://localhost:4000"],
+    // Non-default explicit port must match exactly
+    ["http://example.com:443", "http://example.com"],
+    // Credentials in host position can't be spoofed
+    ["https://example.com@evil.com", "https://example.com"],
+    // Relative vs absolute
+    ["/foo", "https://example.com/foo"],
+    ["https://example.com/foo", "/foo"],
+    // Protocol-relative has no protocol, so it can't be matched to absolute
+    ["//example.com/foo", "https://example.com/foo"],
+  ];
+
+  for (const [a, b] of sameOrigin) {
+    test(`"${a}" == "${b}"`, () => {
+      expect(isSameOrigin(a, b)).toBe(true);
+      // Symmetric
+      expect(isSameOrigin(b, a)).toBe(true);
+    });
+  }
+
+  for (const [a, b] of notSameOrigin) {
+    test(`"${a}" != "${b}"`, () => {
+      expect(isSameOrigin(a, b)).toBe(false);
+      // Symmetric
+      expect(isSameOrigin(b, a)).toBe(false);
+    });
+  }
+
+  test("opaque origins are never same-origin", () => {
+    expect(isSameOrigin("data:text/plain,hi", "data:text/plain,hi")).toBe(
+      false,
+    );
+    expect(isSameOrigin("javascript:alert(1)", "javascript:alert(1)")).toBe(
+      false,
+    );
+    expect(isSameOrigin("mailto:a@example.com", "mailto:a@example.com")).toBe(
+      false,
+    );
+  });
+
+  test("does not throw on malformed input", () => {
+    expect(isSameOrigin("http://", "http://")).toBe(false);
+    expect(isSameOrigin("", "")).toBe(true);
+  });
+});
