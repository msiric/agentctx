 }
+
+/**
+ * Checks if two URLs have the same origin (protocol, host and port).
+ *
+ * - Path, query, hash and credentials are ignored.
+ * - Default ports are normalized (`https://a.com` equals `https://a.com:443`).
+ * - Two relative URLs are same-origin; relative vs absolute is not.
+ * - Protocol-relative (`//host`) URLs only match other protocol-relative URLs.
+ * - Opaque origins (`data:`, `mailto:`, ...) and invalid URLs never match.
+ */
+export function isSameOrigin(a: string, b: string): boolean {
+  const originA = _originKey(a);
+  const originB = _originKey(b);
+  return originA !== undefined && originA === originB;
+}
+
+function _originKey(input: string): string | undefined {
+  try {
+    const origin = new URL(input).origin;
+    return origin === "null" ? undefined : "abs:" + origin;
+  } catch {
+    // Not an absolute URL
+  }
+  if (/^[a-z][\d+.a-z-]*:/i.test(input)) {
+    // Has a scheme but failed to parse
+    return undefined;
+  }
+  if (/^[/\\]{2}/.test(input)) {
+    try {
+      return "rel:" + new URL("http:" + input).host;
+    } catch {
+      return undefined;
+    }
+  }
+  return "relative";
+}
