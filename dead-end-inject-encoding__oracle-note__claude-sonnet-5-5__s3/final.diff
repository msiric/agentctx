diff --git a/src/index.js b/src/index.js
index 2e8bfc9..572aaa5 100644
--- a/src/index.js
+++ b/src/index.js
@@ -31,10 +31,19 @@ export function parse(input, loose) {
 
 var RGX = /(\/|^)([:*][^/]*?)(\?)?(?=[/.]|$)/g;
 
+// RFC 3986: encodeURIComponent leaves ! ' ( ) * unescaped
+function enc(str) {
+	return encodeURIComponent(str).replace(/[!'()*]/g, c => '%' + c.charCodeAt(0).toString(16).toUpperCase());
+}
+
 // error if key missing?
 export function inject(route, values) {
 	return route.replace(RGX, (x, lead, key, optional) => {
 		x = values[key=='*' ? key : key.substring(1)];
-		return x ? '/'+x : (optional || key=='*') ? '' : '/' + key;
+		if (x || x === 0) {
+			x = ''+x;
+			return '/' + (key=='*' ? x.split('/').map(enc).join('/') : enc(x));
+		}
+		return (optional || key=='*') ? '' : '/' + key;
 	});
 }
