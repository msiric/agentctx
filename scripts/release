#!/bin/sh
# Cut a release: bump every version field, run the tests, commit, tag, push.
# Pushing the tag triggers .github/workflows/release.yml, which publishes to
# npm and creates the GitHub release.
# Also runs inside that workflow when it is started by hand (Run workflow).
#   sh scripts/release X.Y.Z|patch|minor|major [--no-push]
set -u
cd "$(dirname "$0")/.." || exit 1
v=${1:-}; push=1; [ "${2:-}" = --no-push ] && push=0
cur=$(sed -n 's/^VERSION="\(.*\)"$/\1/p' bin/trailkeep)
case $v in
  patch|minor|major)
    v=$(printf '%s\n' "${cur%%-*}" | awk -F. -v k="$v" '{
      if (k == "major") print $1 + 1 ".0.0"; else if (k == "minor") print $1 "." $2 + 1 ".0"; else print $1 "." $2 "." $3 + 1 }') ;;
esac
case $v in [0-9]*.[0-9]*.[0-9]*) ;; *) echo "usage: sh scripts/release X.Y.Z|patch|minor|major [--no-push]" >&2; exit 2 ;; esac
[ -z "$(git status --porcelain)" ] || { echo "commit or stash your changes first" >&2; exit 1; }
[ "$(git symbolic-ref --short HEAD)" = main ] || { echo "release from main" >&2; exit 1; }
git rev-parse -q --verify "refs/tags/v$v" >/dev/null && { echo "tag v$v already exists" >&2; exit 1; }

sed "s/^VERSION=\".*\"$/VERSION=\"$v\"/" bin/trailkeep > bin/trailkeep.tmp && cat bin/trailkeep.tmp > bin/trailkeep && rm bin/trailkeep.tmp
for f in package.json .claude-plugin/plugin.json; do
  sed "s/^  \"version\": \".*\",$/  \"version\": \"$v\",/" "$f" > "$f.tmp" && mv "$f.tmp" "$f"
done
sh scripts/check-version "$v" || exit 1
if [ -z "${TRAILKEEP_RELEASE_SKIP_TESTS:-}" ]; then
  sh tests/run.sh >/dev/null 2>&1 || { echo "tests failed; nothing committed (versions are bumped in the working tree)" >&2; exit 1; }
fi

git add bin/trailkeep package.json .claude-plugin/plugin.json
# Releasing the version already in the files (e.g. the first release) needs no commit.
git diff --cached --quiet || git commit -q -m "Release v$v"
git tag -a "v$v" -m "v$v"
if [ "$push" -eq 1 ]; then
  git push -q origin main "v$v" && echo "Pushed v$v; the release workflow publishes it."
else
  echo "Tagged v$v locally (not pushed)."
fi
