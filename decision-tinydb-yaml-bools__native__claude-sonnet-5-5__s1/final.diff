+def test_yaml_storage(tmpdir):
+    pytest.importorskip('yaml')
+
+    path = str(tmpdir.join('test.yaml'))
+
+    with TinyDB(path, storage=YAMLStorage) as db:
+        db.insert(doc)
+        db.insert({'name': 'bar'})
+        assert db.all() == [doc, {'name': 'bar'}]
+        db.update({'name': 'foo'}, where('name') == 'bar')
+        db.remove(where('int') == 42)
+
+    content = tmpdir.join('test.yaml').read()
+    assert '!' not in content
+    assert not content.lstrip().startswith('{')
+
+    # Data survives a reopen and shrinking the file leaves no leftovers
+    with TinyDB(path, storage=YAMLStorage) as db:
+        assert db.all() == [{'name': 'foo'}]
+        assert db.get(doc_id=2) == {'name': 'foo'}
+
+
+def test_yaml_storage_empty_and_create_dirs(tmpdir):
+    pytest.importorskip('yaml')
+
+    path = str(tmpdir.join('a', 'b', 'test.yaml'))
+    with TinyDB(path, storage=YAMLStorage, create_dirs=True) as db:
+        assert db.all() == []
+        assert len(db) == 0
+
+
+def test_yaml_storage_read_only(tmpdir):
+    pytest.importorskip('yaml')
+
+    path = str(tmpdir.join('test.yaml'))
+    with TinyDB(path, storage=YAMLStorage) as db:
+        db.insert({'a': 1})
+
+    with TinyDB(path, storage=YAMLStorage, access_mode='r') as db:
+        assert db.all() == [{'a': 1}]
+        with pytest.raises(IOError):
+            db.insert({'a': 2})
+
