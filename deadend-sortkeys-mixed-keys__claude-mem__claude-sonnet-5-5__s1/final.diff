--- a/tests/test_storages.py
+++ b/tests/test_storages.py
@@ -49,6 +49,40 @@ def test_json_kwargs(tmpdir):
     db.close()
 
 
+def test_json_sort_keys_default(tmpdir):
+    db_file = tmpdir.join('test.db')
+    db = TinyDB(str(db_file))
+    db.insert({'b': 1, 'a': 2})
+    db.close()
+
+    assert db_file.read() == '{"_default": {"1": {"a": 2, "b": 1}}}'
+
+
+def test_json_sort_keys_disabled(tmpdir):
+    db_file = tmpdir.join('test.db')
+    db = TinyDB(str(db_file), sort_keys=False)
+    db.insert({'b': 1, 'a': 2})
+    db.close()
+
+    assert db_file.read() == '{"_default": {"1": {"b": 1, "a": 2}}}'
+
+
+def test_json_sort_keys_mixed_key_types(tmpdir):
+    db_file = tmpdir.join('test.db')
+    db = TinyDB(str(db_file))
+    db.insert({'other': 1, 200: 'a', 404: 'b'})
+    db.close()
+
+    with TinyDB(str(db_file)) as db:
+        assert db.all() == [{'other': 1, '200': 'a', '404': 'b'}]
+
+    # Explicit sort_keys=True keeps json's strict behavior
+    db = TinyDB(str(tmpdir.join('strict.db')), sort_keys=True)
+    with pytest.raises(TypeError):
+        db.insert({'other': 1, 200: 'a'})
+    db.close()
+
+
