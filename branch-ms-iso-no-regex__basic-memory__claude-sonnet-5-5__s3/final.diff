+
+/**
+ * Format the given milliseconds as an ISO 8601 duration string.
+ *
+ * Days are the largest unit used (months and years are ambiguous). Zero-valued
+ * components are omitted, sub-second precision is expressed as a decimal
+ * fraction of seconds, and negative values get a leading `-`.
+ *
+ * @example
+ * formatISO(5400000); // "PT1H30M"
+ * formatISO(90061000); // "P1DT1H1M1S"
+ *
+ * @param ms - milliseconds
+ * @returns The ISO 8601 duration string
+ */
+export function formatISO(ms: number): string {
+  if (typeof ms !== 'number' || !Number.isFinite(ms)) {
+    throw new Error('Value provided to ms.formatISO() must be of type number.');
+  }
+
+  let rest = Math.round(Math.abs(ms));
+  const days = Math.floor(rest / d);
+  rest -= days * d;
+  const hours = Math.floor(rest / h);
+  rest -= hours * h;
+  const minutes = Math.floor(rest / m);
+  rest -= minutes * m;
+  const seconds = Math.floor(rest / s);
+  const millis = rest - seconds * s;
+
+  let time = '';
+  if (hours) time += `${hours}H`;
+  if (minutes) time += `${minutes}M`;
+  if (seconds || millis) {
+    let fraction = '';
+    if (millis) {
+      const digits = String(millis).padStart(3, '0');
+      let end = digits.length;
+      while (digits[end - 1] === '0') end--;
+      fraction = `.${digits.slice(0, end)}`;
+    }
+    time += `${seconds}${fraction}S`;
+  }
+
+  if (!days && !time) {
+    return 'PT0S';
+  }
+
+  const sign = ms < 0 ? '-' : '';
+  return `${sign}P${days ? `${days}D` : ''}${time ? `T${time}` : ''}`;
+}
+
+/**
+ * Parse an ISO 8601 duration string and return milliseconds. This is the
+ * inverse of {@link formatISO}.
+ *
+ * Supports an optional leading `-` or `+`, years (`Y`), months (`M` before the
+ * `T`), weeks (`W`), days (`D`), hours (`H`), minutes (`M` after the `T`) and
+ * seconds (`S`). Each component may have a decimal fraction (`.` or `,`).
+ * Years and months use the same average lengths as {@link parse}.
+ *
+ * @example
+ * parseISO("PT1H30M"); // 5400000
+ * parseISO("P1DT1H1M1S"); // 90061000
+ *
+ * @param str - An ISO 8601 duration string
+ * @returns The parsed value in milliseconds, or `NaN` if the string is not a
+ * valid ISO 8601 duration
+ */
+export function parseISO(str: string): number {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw new Error(
+      `Value provided to ms.parseISO() must be a string with length between 1 and 99. value=${JSON.stringify(str)}`,
+    );
+  }
+
+  let i = 0;
+  let sign = 1;
+  if (str[i] === '-' || str[i] === '+') {
+    if (str[i] === '-') sign = -1;
+    i++;
+  }
+  if (str[i] !== 'P') return NaN;
+  i++;
+
+  const isDigit = (c: string | undefined): boolean =>
+    c !== undefined && c >= '0' && c <= '9';
+
+  let inTime = false;
+  let total = 0;
+  let components = 0;
+  // Designators must appear in order, each at most once.
+  let lastDateOrder = -1;
+  let lastTimeOrder = -1;
+  const dateUnits: Record<string, [number, number]> = {
+    Y: [0, y],
+    M: [1, mo],
+    W: [2, w],
+    D: [3, d],
+  };
+  const timeUnits: Record<string, [number, number]> = {
+    H: [0, h],
+    M: [1, m],
+    S: [2, s],
+  };
+
+  while (i < str.length) {
+    if (str[i] === 'T') {
+      if (inTime) return NaN;
+      inTime = true;
+      i++;
+      // "T" must be followed by at least one component.
+      if (i >= str.length) return NaN;
+      continue;
+    }
+
+    const start = i;
+    let digits = 0;
+    while (isDigit(str[i])) {
+      i++;
+      digits++;
+    }
+    if (str[i] === '.' || str[i] === ',') {
+      i++;
+      let fractionDigits = 0;
+      while (isDigit(str[i])) {
+        i++;
+        fractionDigits++;
+      }
+      if (digits === 0 || fractionDigits === 0) return NaN;
+    } else if (digits === 0) {
+      return NaN;
+    }
+    const value = Number(str.slice(start, i).replace(',', '.'));
+
+    const entry = (inTime ? timeUnits : dateUnits)[str[i] ?? ''];
+    if (!entry) return NaN;
+    const [order, factor] = entry;
+    if (inTime) {
+      if (order <= lastTimeOrder) return NaN;
+      lastTimeOrder = order;
+    } else {
+      if (order <= lastDateOrder) return NaN;
+      lastDateOrder = order;
+    }
+    i++;
+
+    total += value * factor;
+    components++;
+  }
+
+  if (components === 0) return NaN;
+  const result = Math.round(total);
+  return sign * result || 0;
+}
