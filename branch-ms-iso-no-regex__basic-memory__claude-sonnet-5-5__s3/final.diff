@@ -0,0 +1,114 @@
+import { describe, expect, it } from '@jest/globals';
+import { formatISO, parseISO } from './index';
+
+describe('parseISO(string)', () => {
+  it('should parse hours and minutes', () => {
+    expect(parseISO('PT1H30M')).toBe(5400000);
+  });
+
+  it('should parse days with a time part', () => {
+    expect(parseISO('P1DT1H1M1S')).toBe(90061000);
+  });
+
+  it('should parse zero', () => {
+    expect(parseISO('PT0S')).toBe(0);
+    expect(parseISO('P0D')).toBe(0);
+  });
+
+  it('should parse single components', () => {
+    expect(parseISO('P1D')).toBe(86400000);
+    expect(parseISO('P7D')).toBe(7 * 86400000);
+    expect(parseISO('P400D')).toBe(400 * 86400000);
+    expect(parseISO('PT1H')).toBe(3600000);
+    expect(parseISO('PT1M')).toBe(60000);
+    expect(parseISO('PT1S')).toBe(1000);
+  });
+
+  it('should distinguish months from minutes', () => {
+    expect(parseISO('PT1M')).toBe(60000);
+    expect(parseISO('P1M')).toBe(30.4375 * 86400000);
+  });
+
+  it('should parse weeks and years', () => {
+    expect(parseISO('P1W')).toBe(7 * 86400000);
+    expect(parseISO('P1Y')).toBe(365.25 * 86400000);
+  });
+
+  it('should parse fractional seconds', () => {
+    expect(parseISO('PT0.5S')).toBe(500);
+    expect(parseISO('PT0.001S')).toBe(1);
+    expect(parseISO('PT1.25S')).toBe(1250);
+    expect(parseISO('PT1,5S')).toBe(1500);
+  });
+
+  it('should parse fractions on other units', () => {
+    expect(parseISO('PT1.5H')).toBe(5400000);
+    expect(parseISO('P0.5D')).toBe(43200000);
+  });
+
+  it('should round sub-millisecond precision', () => {
+    expect(parseISO('PT0.0004S')).toBe(0);
+    expect(parseISO('PT1.0006S')).toBe(1001);
+  });
+
+  it('should parse negative and explicitly positive values', () => {
+    expect(parseISO('-PT1H30M')).toBe(-5400000);
+    expect(parseISO('+PT1H30M')).toBe(5400000);
+    expect(Object.is(parseISO('-PT0S'), 0)).toBe(true);
+  });
+
+  it('should return NaN for malformed input', () => {
+    for (const input of [
+      'P',
+      'PT',
+      'P1DT',
+      '1H',
+      'PT1',
+      'PT1X',
+      'P1H',
+      'PT1D',
+      'PT1H1H',
+      'PT30M1H',
+      'P1DT1DT1H',
+      'P1D1Y',
+      'PTT1H',
+      'PT.S',
+      'PT1.S',
+      'PT.5S',
+      'PT-1H',
+      'PT1H ',
+      'pt1h',
+      'P1D2',
+      '--PT1H',
+    ]) {
+      expect([input, parseISO(input)]).toEqual([input, NaN]);
+    }
+  });
+
+  it('should throw for invalid input types', () => {
+    expect(() => parseISO('')).toThrow();
+    expect(() => parseISO(`P${'1'.repeat(100)}`)).toThrow();
+    // @ts-expect-error - testing invalid input
+    expect(() => parseISO(1)).toThrow();
+    // @ts-expect-error - testing invalid input
+    expect(() => parseISO(undefined)).toThrow();
+  });
+
+  it('should round-trip with formatISO', () => {
+    for (const value of [
+      0,
+      1,
+      999,
+      1000,
+      1250,
+      60000,
+      5400000,
+      90061000,
+      400 * 86400000,
+      -5400000,
+      -1,
+    ]) {
+      expect(parseISO(formatISO(value))).toBe(value);
+    }
+  });
+});
