+
+def test_latest_empty_stdin_prints_json_null(capsys):
+    with patch("sys.stdin", io.StringIO("\n")):
+        assert main(["latest"]) == 0
+    assert json.loads(capsys.readouterr().out) is None
+
+
+def test_latest_arguments_take_precedence_over_stdin(capsys):
+    with patch("sys.stdin", io.StringIO("9.9.9\n")):
+        assert main(["latest", "1.0.0"]) == 0
+    assert json.loads(capsys.readouterr().out) == "1.0.0"
