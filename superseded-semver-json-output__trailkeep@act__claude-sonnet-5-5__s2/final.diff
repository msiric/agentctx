+import io
+import json
 from argparse import Namespace
 from contextlib import contextmanager
 from unittest.mock import patch
@@ -155,3 +157,97 @@ def test_should_return_documented_error_code_for_invalid_version(cliargs, capsys
     # docs/pysemver.rst shows ``echo $?`` printing 2 for both commands
     assert main(cliargs) == 2
     assert capsys.readouterr().err.startswith("ERROR")
+
+
+def test_sort_prints_one_version_per_line_oldest_first(capsys):
+    assert main(["sort", "1.10.0", "1.2.0", "1.2.0-rc.1", "0.9.9"]) == 0
+    captured = capsys.readouterr()
+    assert captured.out == "0.9.9\n1.2.0-rc.1\n1.2.0\n1.10.0\n"
+    assert captured.err == ""
+
+
+def test_sort_single_version(capsys):
+    assert main(["sort", "1.2.3"]) == 0
+    assert capsys.readouterr().out == "1.2.3\n"
+
+
+def test_sort_invalid_version_prints_nothing_on_stdout(capsys):
+    assert main(["sort", "1.2.3", "1.5"]) == 2
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert "ERROR" in captured.err
+
+
+def test_sort_reads_stdin_when_no_arguments(capsys):
+    stdin = io.StringIO("1.10.0\n\n  1.2.0  \n1.2.0-rc.1\n\n")
+    with patch("sys.stdin", stdin):
+        assert main(["sort"]) == 0
+    assert capsys.readouterr().out == "1.2.0-rc.1\n1.2.0\n1.10.0\n"
+
+
+def test_sort_stdin_invalid_version_prints_nothing_on_stdout(capsys):
+    with patch("sys.stdin", io.StringIO("1.2.3\nnope\n")):
+        assert main(["sort"]) == 2
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert "ERROR" in captured.err
+
+
+def test_sort_empty_stdin_prints_nothing(capsys):
+    with patch("sys.stdin", io.StringIO("\n\n")):
+        assert main(["sort"]) == 0
+    assert capsys.readouterr().out == ""
+
+
+def test_sort_arguments_take_precedence_over_stdin(capsys):
+    with patch("sys.stdin", io.StringIO("9.9.9\n")):
+        assert main(["sort", "1.0.0"]) == 0
+    assert capsys.readouterr().out == "1.0.0\n"
+
+
+def test_latest_prints_highest_stable_version_as_json(capsys):
+    args = ["latest", "1.2.0", "1.10.0", "2.0.0-rc.1", "1.9.0"]
+    assert main(args) == 0
+    captured = capsys.readouterr()
+    assert captured.out == '"1.10.0"\n'
+    assert captured.err == ""
+
+
+def test_latest_ignores_prereleases_even_if_higher(capsys):
+    assert main(["latest", "1.0.0", "2.0.0-alpha.1"]) == 0
+    assert json.loads(capsys.readouterr().out) == "1.0.0"
+
+
+def test_latest_build_metadata_is_not_a_prerelease(capsys):
+    assert main(["latest", "1.0.0", "1.1.0+build.5"]) == 0
+    assert json.loads(capsys.readouterr().out) == "1.1.0+build.5"
+
+
+def test_latest_without_stable_version_prints_json_null(capsys):
+    assert main(["latest", "1.0.0-rc.1", "0.1.0-beta"]) == 0
+    assert json.loads(capsys.readouterr().out) is None
+
+
+def test_latest_reads_stdin_when_no_arguments(capsys):
+    with patch("sys.stdin", io.StringIO("1.2.0\n\n 1.10.0 \n3.0.0-rc.1\n")):
+        assert main(["latest"]) == 0
+    assert json.loads(capsys.readouterr().out) == "1.10.0"
