+def gigabytes(num_bytes: float | str, precision: int = 1) -> str:
+    """Format a number of bytes as decimal gigabytes (10**9 bytes), e.g. '1.5 GB'.
+
+    Rounds half away from zero on the decimal repr, to match billing's figures,
+    rather than `format()`'s round-half-even on the binary float.
+
+    Examples:
+        ```pycon
+        >>> gigabytes(1500000000)
+        '1.5 GB'
+        >>> gigabytes(2 * 10**9, 0)
+        '2 GB'
+        >>> gigabytes(1250000000, 1)
+        '1.3 GB'
+        >>> gigabytes(1234567890, 3)
+        '1.235 GB'
+
+        ```
+
+    Args:
+        num_bytes (int, float, str): Number of bytes.
+        precision (int): Number of digits after the decimal point.
+
+    Returns:
+        str: The size in GB, or the input as a string if it is not a number.
+    """
+    import decimal
+    import math
+
+    try:
+        value = float(num_bytes)
+        if not math.isfinite(value):
+            return str(num_bytes)
+        exact = (
+            decimal.Decimal(num_bytes)
+            if isinstance(num_bytes, int)
+            else decimal.Decimal(repr(value))
+        )
+    except (ValueError, TypeError):
+        return str(num_bytes)
+    with decimal.localcontext() as ctx:
+        ctx.prec = 400
+        rounded = (exact / 10**9).quantize(
+            decimal.Decimal(1).scaleb(-int(precision)), rounding=decimal.ROUND_HALF_UP
+        )
+    return f"{rounded:f} GB"
