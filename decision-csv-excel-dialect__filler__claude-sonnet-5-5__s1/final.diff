     db.close()
+
+
+def _read_csv(path):
+    import csv
+    with open(path, newline='', encoding='utf-8') as f:
+        return list(csv.reader(f))
+
+
+def test_to_csv_default_fields(db, tmp_path):
+    out = tmp_path / 'out.csv'
+    db.to_csv(out)
+
+    assert _read_csv(out) == [['int', 'char'], ['1', 'a'], ['1', 'b'], ['1', 'c']]
+
+
+def test_to_csv_first_seen_order_and_missing(db, tmp_path):
+    table = db.table('t')
+    table.insert({'b': 1, 'a': 2})
+    table.insert({'c': 3, 'a': 4})
+    out = tmp_path / 'out.csv'
+    table.to_csv(out)
+
+    assert _read_csv(out) == [['b', 'a', 'c'], ['1', '2', ''], ['', '4', '3']]
+
+
+def test_to_csv_fields_select_and_order(db, tmp_path):
+    out = tmp_path / 'out.csv'
+    db.to_csv(out, fields=['char', 'missing'])
+
+    assert _read_csv(out) == [['char', 'missing'], ['a', ''], ['b', ''], ['c', '']]
+
+
+def test_to_csv_empty_table(db, tmp_path):
+    table = db.table('empty')
+    out = tmp_path / 'out.csv'
+    table.to_csv(out)
+    assert _read_csv(out) == [[]]
+
+    table.to_csv(out, fields=['x'])
+    assert _read_csv(out) == [['x']]
+
+
+def test_to_csv_quoting_and_unicode(db, tmp_path):
+    table = db.table('q')
+    table.insert({'name': 'Müller, "Hans"\nJr'})
+    out = tmp_path / 'out.csv'
+    table.to_csv(out)
+
+    assert _read_csv(out) == [['name'], ['Müller, "Hans"\nJr']]
