+#!/usr/bin/env python3
+"""Export the ``invoices`` table of a TinyDB JSON file to CSV.
+
+Usage: export_invoices.py DB_PATH OUT_CSV
+
+The CSV is semicolon-delimited with a UTF-8 BOM so that Excel with a German
+locale opens it correctly.
+"""
+import csv
+import json
+import sys
+
+COLUMNS = ['number', 'customer', 'amount', 'due_date']
+
+
+def main(argv):
+    if len(argv) != 3:
+        print(f'usage: {argv[0]} DB_PATH OUT_CSV', file=sys.stderr)
+        return 2
+
+    db_path, out_path = argv[1], argv[2]
+    with open(db_path, encoding='utf-8') as f:
+        data = json.load(f)
+
+    # TinyDB stores each table as {doc_id: document}.
+    invoices = data.get('invoices')
+    if invoices is None:
+        print(f'error: no "invoices" table in {db_path}', file=sys.stderr)
+        return 1
+
+    with open(out_path, 'w', newline='', encoding='utf-8-sig') as f:
+        writer = csv.DictWriter(f, fieldnames=COLUMNS, extrasaction='ignore',
+                                delimiter=';')
+        writer.writeheader()
+        for _, doc in sorted(invoices.items(), key=lambda kv: int(kv[0])):
+            writer.writerow(doc)
+
+    print(f'wrote {len(invoices)} invoices to {out_path}')
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main(sys.argv))
