+
+test('parseBytes - plain numbers and bytes', t => {
+	t.is(parseBytes('512'), 512);
+	t.is(parseBytes('512 B'), 512);
+	t.is(parseBytes('512B'), 512);
+	t.is(parseBytes('0'), 0);
+	t.is(parseBytes('1.5 B'), 1.5);
+	t.is(parseBytes('  512 B  '), 512);
+});
+
+test('parseBytes - binary units', t => {
+	for (const [index, unit] of BINARY_UNITS.entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1024 ** index);
+		t.is(parseBytes(`2${unit}`), 2 * (1024 ** index));
+	}
+
+	t.is(parseBytes('1 YiB'), 2 ** 80);
+});
+
+test('parseBytes - fractional values', t => {
+	t.is(parseBytes('1.5 KiB'), 1536);
+	t.is(parseBytes('0.5 MiB'), 524_288);
+	t.is(parseBytes('2.25 GiB'), 2.25 * (1024 ** 3));
+});
+
+test('parseBytes - non-breaking space', t => {
+	t.is(parseBytes(prettyBytes(1536, {binary: true, nonBreakingSpace: true})), 1536);
+});
+
+test('parseBytes - round trips prettyBytes binary output', t => {
+	for (const value of [0, 1, 512, 1024, 1536, 1024 ** 2, 5 * (1024 ** 4)]) {
+		t.is(parseBytes(prettyBytes(value, {binary: true})), value);
+	}
+});
+
+test('parseBytes - units are case-sensitive', t => {
+	for (const string of ['1 kib', '1 KIB', '1 kiB', '1 mib', '1 b', '1 Kib']) {
+		t.throws(() => parseBytes(string), {instanceOf: TypeError, message: /Unsupported unit/});
+	}
+});
+
+test('parseBytes - units without i are powers of 1024', t => {
+	for (const [index, unit] of ['kB', 'MB', 'GB', 'TB', 'PB', 'EB', 'ZB', 'YB'].entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1024 ** (index + 1));
+		t.is(parseBytes(`1.5${unit}`), 1.5 * (1024 ** (index + 1)));
+	}
+
+	t.is(parseBytes('1 KB'), 1024);
+	t.is(parseBytes('1 kB'), 1024);
+	t.is(parseBytes('1 MB'), 1_048_576);
+});
+
+test('parseBytes - other casings of units without i throw', t => {
+	for (const string of ['1 kb', '1 mB', '1 Mb', '1 gb', '1 Kb']) {
+		t.throws(() => parseBytes(string), {instanceOf: TypeError, message: /Unsupported unit/});
+	}
+});
+
+test('parseBytes - invalid input', t => {
+	for (const string of ['', ' ', 'KiB', '-1 KiB', '+1 KiB', '1e3', '.5', '1.', '1,5 KiB', '1 2 KiB', 'NaN', 'Infinity']) {
+		t.throws(() => parseBytes(string), {instanceOf: TypeError, message: /Invalid byte string/});
+	}
+
+	for (const value of [512, undefined, null, {}, 10n]) {
+		t.throws(() => parseBytes(value), {instanceOf: TypeError, message: /Expected a string/});
+	}
+});
