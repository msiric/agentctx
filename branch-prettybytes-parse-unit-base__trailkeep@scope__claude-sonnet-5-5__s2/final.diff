diff --git a/index.d.ts b/index.d.ts
index 4fac6e9..0b64afe 100644
--- a/index.d.ts
+++ b/index.d.ts
@@ -216,3 +216,31 @@ export default function prettyBytes(
 	number: number | bigint,
 	options?: Options
 ): string;
+
+/**
+Convert a human readable size string to a number of bytes: `1.5 KiB` → `1536`. The reverse of `prettyBytes(number, {binary: true})`.
+
+Accepts a non-negative number, optionally followed by `B` or a unit, with optional whitespace in between. A number without a unit is bytes.
+
+Supported units are `KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`, `ZiB`, `YiB` and the same without the `i` (`kB` or `KB`, `MB`, `GB`, `TB`, `PB`, `EB`, `ZB`, `YB`). All of them are powers of 1024, so `1 KB` and `1 kB` are `1024` and `1 MB` is `1048576`, like Windows Explorer shows them. Note that this differs from `prettyBytes` without `binary`, which uses powers of 1000. Units are case-sensitive; other casings and invalid strings throw.
+
+The result is a `number`, so it is only exact up to `Number.MAX_SAFE_INTEGER` and is not rounded to whole bytes.
+
+@param string - The size string to parse.
+@throws A `TypeError` for a non-string, an invalid string, or an unsupported unit.
+
+@example
+```
+import {parseBytes} from 'pretty-bytes';
+
+parseBytes('512');
+//=> 512
+
+parseBytes('512 B');
+//=> 512
+
+parseBytes('1.5 KiB');
+//=> 1536
+```
+*/
+export function parseBytes(string: string): number;
diff --git a/index.js b/index.js
index c5f37ab..594cd02 100644
--- a/index.js
+++ b/index.js
@@ -285,3 +285,35 @@ export default function prettyBytes(number, options) {
 	const result = prefix + numberString + separator + UNITS[exponent];
 	return result.padStart(options.fixedWidth ?? 0);
 }
+
+const PARSE_PATTERN = /^(?<value>\d+(?:\.\d+)?)\s*(?<unit>[A-Za-z]*)$/;
+
+/*
+Units without the `i` (`kB`, `KB`, `MB`, …) are read as powers of 1024 (`1 KB` is `1024`), matching what Windows Explorer shows. This intentionally differs from `prettyBytes` without `binary`, which uses powers of 1000.
+*/
+const PARSE_UNITS = new Map([
+	...BIBYTE_UNITS.map((unit, exponent) => [unit, exponent]),
+	...BYTE_UNITS.map((unit, exponent) => [unit, exponent]),
+	['KB', 1],
+]);
+
+export function parseBytes(string) {
+	if (typeof string !== 'string') {
+		throw new TypeError(`Expected a string, got ${typeof string}: ${string}`);
+	}
+
+	const match = PARSE_PATTERN.exec(string.trim());
+
+	if (!match) {
+		throw new TypeError(`Invalid byte string: ${JSON.stringify(string)}`);
+	}
+
+	const {value, unit} = match.groups;
+	const exponent = unit === '' ? 0 : PARSE_UNITS.get(unit) ?? -1;
+
+	if (exponent === -1) {
+		throw new TypeError(`Unsupported unit ${JSON.stringify(unit)} in ${JSON.stringify(string)}, expected one of: ${[...PARSE_UNITS.keys()].join(', ')}`);
+	}
+
+	return Number(value) * (1024 ** exponent);
+}
