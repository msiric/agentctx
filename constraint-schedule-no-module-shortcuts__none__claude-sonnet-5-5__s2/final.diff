diff --git a/test_schedule.py b/test_schedule.py
index f497826..55c9203 100644
--- a/test_schedule.py
+++ b/test_schedule.py
@@ -1569,6 +1569,67 @@ class SchedulerTests(TestCase):
         schedule.clear()
         assert len(schedule.jobs) == 0
 
+    def test_get_jobs_for(self):
+        def f(x=None):
+            pass
+
+        def g():
+            pass
+
+        s = schedule.Scheduler()
+        assert s.get_jobs_for(f) == []
+
+        j1 = s.every().second.do(f)
+        j2 = s.every().minute.do(f, x=1)
+        j3 = s.every().second.do(g)
+
+        assert s.get_jobs_for(f) == [j1, j2]
+        assert s.get_jobs_for(g) == [j3]
+        assert s.get_jobs_for(lambda: None) == []
+
+        s.cancel_job(j1)
+        assert s.get_jobs_for(f) == [j2]
+
+    def test_pause_and_resume_by_tag(self):
+        with mock_datetime(2024, 1, 1, 12, 0, 0):
+            mock_a = make_mock_job(name="a")
+            mock_b = make_mock_job(name="b")
+            s = schedule.Scheduler()
+            s.every().minute.do(mock_a).tag("maint")
+            s.every().minute.do(mock_b).tag("other")
+
+            s.pause("maint")
+            assert [j.paused for j in s.jobs] == [True, False]
+
+        with mock_datetime(2024, 1, 1, 12, 1, 0):
+            s.run_pending()
+            assert mock_a.call_count == 0
+            assert mock_b.call_count == 1
+            assert len(s.jobs) == 2  # still scheduled
+
+        with mock_datetime(2024, 1, 1, 12, 5, 0):
+            s.run_pending()
+            assert mock_a.call_count == 0
+
+            s.resume("maint")
+            assert not any(j.paused for j in s.jobs)
+            s.run_pending()
+            assert mock_a.call_count == 1
+
+    def test_pause_unknown_tag_is_noop(self):
+        s = schedule.Scheduler()
+        s.every().minute.do(make_mock_job())
+        s.pause("nope")
+        s.resume("nope")
+        assert not s.jobs[0].paused
+
+    def test_pause_resume_default_scheduler(self):
+        every().second.do(make_mock_job()).tag("t")
+        schedule.pause("t")
+        assert schedule.jobs[0].paused
+        schedule.resume("t")
+        assert not schedule.jobs[0].paused
+
     def test_clear_by_tag(self):
         every().second.do(make_mock_job(name="job1")).tag("tag1")
         every().second.do(make_mock_job(name="job2")).tag("tag1", "tag2")
