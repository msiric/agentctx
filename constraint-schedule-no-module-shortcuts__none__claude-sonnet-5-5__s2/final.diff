+    def pause(self, tag: Hashable) -> None:
+        """
+        Pause all jobs with a given tag. Paused jobs are skipped by
+        :meth:`run_pending` until resumed. They stay registered and keep
+        their schedule.
+
+        :param tag: An identifier used to identify a subset of jobs to pause
