+    def resume(self, tag: Hashable) -> None:
+        """
+        Resume all paused jobs with a given tag. If a job's scheduled time
+        passed while it was paused, it runs on the next :meth:`run_pending`
+        (once, missed runs are not replayed).
+
+        :param tag: An identifier used to identify a subset of jobs to resume
+        """
+        for job in self.get_jobs(tag):
+            job.paused = False
