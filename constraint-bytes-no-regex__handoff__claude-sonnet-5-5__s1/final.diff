diff --git a/test/byte-parse.js b/test/byte-parse.js
index cebfab2..0027453 100644
--- a/test/byte-parse.js
+++ b/test/byte-parse.js
@@ -108,4 +108,45 @@ describe('Test byte parse function', function(){
   it('Should allow whitespace', function(){
     assert.equal(bytes.parse('1 TB'), 1 * Math.pow(1024, 4));
   });
+
+  it('Should parse IEC units like their SI-named equivalents', function(){
+    ['k', 'm', 'g', 't', 'p'].forEach(function (p, i) {
+      var expected = Math.pow(1024, i + 1);
+      assert.equal(bytes.parse('1' + p + 'ib'), expected);
+      assert.equal(bytes.parse('1' + p.toUpperCase() + 'iB'), expected);
+      assert.equal(bytes.parse('1 ' + p.toUpperCase() + 'IB'), expected);
+      assert.equal(bytes.parse('1' + p + 'b'), expected);
+    });
+    assert.equal(bytes.parse('1.5KiB'), 1536);
+    assert.equal(bytes.parse('-1KiB'), -1024);
+  });
+
+  it('Should not accept malformed IEC units', function(){
+    assert.strictEqual(bytes.parse('KiB'), null);
+    assert.strictEqual(bytes.parse('1 iB'), 1);
+    assert.strictEqual(bytes.parse('1 Kib '), 1);
+    assert.strictEqual(bytes.parse('xKiB'), null);
+  });
+
+  it('Should reject long junk strings quickly', function(){
+    var n = 100000;
+    var junk = [
+      'x'.repeat(n),
+      '1'.repeat(n) + 'x',
+      '1.'.repeat(n / 2),
+      '1' + ' '.repeat(n) + 'x'
+    ];
+
+    junk.forEach(function (str) {
+      var start = process.hrtime();
+      var result = bytes.parse(str);
+      var elapsed = process.hrtime(start);
+      var ms = elapsed[0] * 1e3 + elapsed[1] / 1e6;
+
+      assert.ok(result === null || typeof result === 'number');
+      assert.ok(ms < 100, 'parse took ' + ms.toFixed(1) + 'ms for ' + str.length + ' chars');
+    });
+
+    assert.strictEqual(bytes.parse('x'.repeat(n)), null);
+  });
 });
