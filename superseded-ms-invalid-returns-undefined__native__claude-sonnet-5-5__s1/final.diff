+++ b/src/parse-compound.test.ts
@@ -0,0 +1,46 @@
+import { describe, expect, it } from '@jest/globals';
+import { parseCompound } from './index';
+
+describe('parseCompound(string)', () => {
+  it('should sum short units', () => {
+    expect(parseCompound('1h 30m')).toBe(5400000);
+  });
+
+  it('should sum long units with spaces', () => {
+    expect(parseCompound('2 days 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
+  });
+
+  it('should accept pieces without separators', () => {
+    expect(parseCompound('1h30m15s')).toBe(5415000);
+  });
+
+  it('should accept commas between pieces', () => {
+    expect(parseCompound('1h, 30m')).toBe(5400000);
+    expect(parseCompound('1h,30m')).toBe(5400000);
+    expect(parseCompound('2 days , 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
+  });
+
+  it('should accept a single piece and surrounding whitespace', () => {
+    expect(parseCompound('  10s ')).toBe(10000);
+  });
+
+  it('should support decimals and mixed case', () => {
+    expect(parseCompound('1.5H 30M')).toBe(7200000);
+  });
+
+  it('should throw a TypeError including the input for invalid input', () => {
+    for (const bad of ['', '   ', 'abc', '1h foo', '1h 30', '1h and 30m', '1h,', ',1h', '1h,,30m', ',']) {
+      expect(() => parseCompound(bad)).toThrow(TypeError);
+      expect(() => parseCompound(bad)).toThrow(JSON.stringify(bad));
+    }
+  });
+
+  it('should throw a TypeError for unknown units', () => {
+    expect(() => parseCompound('1h 5foo')).toThrow(TypeError);
+    expect(() => parseCompound('1h 5foo')).toThrow('"1h 5foo"');
+  });
+
+  it('should throw a TypeError for non-string values', () => {
+    expect(() => parseCompound(1 as unknown as string)).toThrow(TypeError);
+  });
+});
