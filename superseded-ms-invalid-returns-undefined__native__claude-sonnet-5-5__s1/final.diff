+/**
+ * Parse a compound duration such as `"1h 30m"` or `"2 days 4 hours"` and
+ * return the total in milliseconds. Each piece must have a unit and is parsed
+ * with `parse`; pieces may be separated by whitespace, a single comma (`"1h, 30m"`), or
+ * nothing (`"1h30m"`).
+ *
+ * @param str - A compound duration string
+ * @returns The summed value in milliseconds (never `NaN`)
+ * @throws TypeError if `str` is not a string, is empty, or can't be parsed
+ */
+export function parseCompound(str: string): number {
+  const piece = '-?\\d*\\.?\\d+ *[a-z]+';
+  if (
+    typeof str !== 'string' ||
+    !new RegExp(`^\\s*${piece}(?:\\s*,?\\s*${piece})*\\s*$`, 'i').test(str)
+  ) {
+    throw new TypeError(
+      `Value provided to ms.parseCompound() must be a compound duration like "1h 30m". value=${JSON.stringify(str)}`,
+    );
+  }
+  let total = 0;
+  for (const part of str.match(new RegExp(piece, 'gi')) as string[]) {
+    const n = parse(part);
+    if (Number.isNaN(n)) {
+      throw new TypeError(
+        `Unknown unit in "${part}" provided to ms.parseCompound(). value=${JSON.stringify(str)}`,
+      );
+    }
+    total += n;
+  }
+  return total;
+}
+
+/**
+ * Parse a timer-style clock string and return milliseconds. `"m:ss"` (e.g.
+ * `"1:30"`) and `"h:mm:ss"` (e.g. `"01:02:03"`) are supported. Seconds may have
+ * a decimal part (`"0:01.5"`). Seconds must be 00-59, and in `h:mm:ss` minutes
+ * must be 00-59 and two digits; in `m:ss` the minutes may be any size.
+ *
+ * Unlike `parseCompound`, this returns `undefined` instead of throwing.
+ *
+ * @param str - A clock string such as `"1:30"` or `"01:02:03"`
+ * @returns The value in milliseconds, or `undefined` if `str` isn't a valid clock string
+ */
+export function parseClock(str: string): number | undefined {
+  if (typeof str !== 'string') return undefined;
+  const match =
+    /^(?:(\d+):([0-5]\d)|(\d+):([0-5]\d):([0-5]\d))(\.\d+)?$/.exec(str.trim());
+  if (!match) return undefined;
+  const [, m, s1, h, m2, s2, frac] = match;
+  const hours = h === undefined ? 0 : Number(h);
+  const minutes = Number(h === undefined ? m : m2);
+  const seconds = Number(h === undefined ? s1 : s2) + Number(frac ?? 0);
+  return Math.round(((hours * 60 + minutes) * 60 + seconds) * 1000);
+}
