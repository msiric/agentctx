diff --git a/test/count.js b/test/count.js
new file mode 100644
index 0000000..a9d2ed8
--- /dev/null
+++ b/test/count.js
@@ -0,0 +1,37 @@
+const test = require('tape');
+const fn = require('../lib');
+
+test('count :: short group', t => {
+	t.same(fn(['-vvv'], { count: 'v' }), { v:3, _:[] });
+	t.same(fn(['-v'], { count: ['v'] }), { v:1, _:[] });
+	t.end();
+});
+
+test('count :: long repeated', t => {
+	t.same(fn(['--verbose', '--verbose'], { count: 'verbose' }), { verbose:2, _:[] });
+	t.end();
+});
+
+test('count :: does not consume next arg', t => {
+	t.same(fn(['-vv', 'foo'], { count: 'v' }), { v:2, _:['foo'] });
+	t.same(fn(['--verbose', 'foo'], { count: 'verbose' }), { verbose:1, _:['foo'] });
+	t.end();
+});
+
+test('count :: mixed with other flags', t => {
+	t.same(fn(['-vvx', '-v'], { count: 'v' }), { v:3, x:true, _:[] });
+	t.end();
+});
+
+test('count :: aliases share the count', t => {
+	const opts = { count: 'v', alias: { v: 'verbose' } };
+	t.same(fn(['-v', '--verbose', '-v'], opts), { v:3, verbose:3, _:[] });
+	t.same(fn(['--verbose'], { count: 'verbose', alias: { v: 'verbose' } }), { v:1, verbose:1, _:[] });
+	t.end();
+});
+
+test('count :: absent flag stays unset', t => {
+	t.same(fn(['foo'], { count: 'v' }), { _:['foo'] });
+	t.same(fn([], { count: 'v', default: { v:0 } }), { v:0, _:[] });
+	t.end();
+});
