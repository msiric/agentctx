+    def test_get_jobs_for(self):
+        def foo(x=None):
+            pass
+
+        def bar():
+            pass
+
+        scheduler = schedule.default_scheduler
+        j1 = every().second.do(foo)
+        j2 = every().minute.do(foo, x=1)
+        j3 = every().hour.do(bar)
+
+        assert scheduler.get_jobs_for(foo) == [j1, j2]
+        assert scheduler.get_jobs_for(bar) == [j3]
+        assert scheduler.get_jobs_for(lambda: None) == []
+
+        scheduler.cancel_job(j1)
+        assert scheduler.get_jobs_for(foo) == [j2]
+        schedule.clear()
+
+    def test_pause_resume_by_tag(self):
+        scheduler = schedule.default_scheduler
+        m1, m2 = make_mock_job(name="a"), make_mock_job(name="b")
+        with mock_datetime(2020, 1, 1, 10, 0, 0):
+            j1 = every().second.do(m1).tag("maint")
+            j2 = every().second.do(m2).tag("other")
+            with mock_datetime(2020, 1, 1, 10, 0, 5):
+                scheduler.pause("maint")
+                assert j1.paused and not j2.paused
+                schedule.run_pending()
+                assert m1.call_count == 0
+                assert m2.call_count == 1
+                assert j1 in scheduler.jobs  # still scheduled
+
+            with mock_datetime(2020, 1, 1, 10, 0, 10):
+                scheduler.resume("maint")
+                assert not j1.paused
+                schedule.run_pending()
+                assert m1.call_count == 1
+                assert m2.call_count == 2
+        schedule.clear()
+
+    def test_pause_unknown_tag_is_noop(self):
+        scheduler = schedule.default_scheduler
+        job = every().second.do(make_mock_job())
+        scheduler.pause("nope")
+        scheduler.resume("nope")
+        assert not job.paused
