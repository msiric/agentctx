+        r(thing.go)
+        self.assertEqual(seen, [1, 2, 3])
+
+    def test_called_on_final_failed_attempt_via_decorator(self) -> None:
+        seen: list[dict[str, typing.Any]] = []
+
+        @retry(
+            stop=tenacity.stop_after_attempt(2),
+            reraise=True,
+            stats_hook=seen.append,
+        )
+        def fails() -> None:
+            raise ValueError
+
+        with self.assertRaises(ValueError):
+            fails()
+        self.assertEqual([s["attempt_number"] for s in seen], [1, 2])
+
