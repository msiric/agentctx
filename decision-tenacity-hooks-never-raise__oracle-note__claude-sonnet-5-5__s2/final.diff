+
+
+_logger = logging.getLogger("tenacity")
+
+
+@contextlib.contextmanager
+def suppress_hook_errors(hook: str) -> typing.Iterator[None]:
+    """
+    Keep a failing logging/metrics call from affecting the retried call.
+
+    Anything the wrapped code raises (``Exception`` only) is logged at debug
+    level and dropped: losing a log line or a metric is better than turning
+    a retryable failure into a hard one.
+    """
+    try:
+        yield
+    except Exception:
+        _logger.debug("Ignoring error raised by %s", hook, exc_info=True)
