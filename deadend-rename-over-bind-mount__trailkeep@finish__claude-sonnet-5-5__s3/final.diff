@@ -285,3 +285,112 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def _journal_bytes(payload: bytes, valid=True) -> bytes:
+    import hashlib
+    digest = hashlib.sha256(payload).hexdigest().encode()
+    if not valid:
+        payload = payload[:len(payload) // 2]
+    return digest + b'\n' + payload
+
+
+def test_json_write_leaves_no_journal(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+    assert os.listdir(str(tmpdir)) == ['db.json']
+
+
+def test_json_write_in_place_keeps_inode(tmpdir):
+    # Must not rely on rename (single-file bind mounts break on that)
+    path = str(tmpdir.join('db.json'))
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+        inode = os.stat(path).st_ino
+        db.insert({'a': 2})
+        assert os.stat(path).st_ino == inode
+
+
+def test_json_recovers_from_crash_during_overwrite(tmpdir):
+    # Database truncated mid-write, complete journal holds the new state
+    path = str(tmpdir.join('db.json'))
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+
+    new = json.dumps({'_default': {'1': {'a': 1}, '2': {'a': 2}}}).encode()
+    with open(path, 'wb') as f:
+        f.write(new[:10])
+    with open(path + '.journal', 'wb') as f:
+        f.write(_journal_bytes(new))
+
+    with TinyDB(path) as db:
+        assert db.all() == [{'a': 1}, {'a': 2}]
+    assert not os.path.exists(path + '.journal')
+
+
+def test_json_incomplete_journal_is_discarded(tmpdir):
+    # Crash while writing the journal: database is still the old state
+    path = str(tmpdir.join('db.json'))
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+
+    new = json.dumps({'_default': {'1': {'a': 1}, '2': {'a': 2}}}).encode()
+    with open(path + '.journal', 'wb') as f:
+        f.write(_journal_bytes(new, valid=False))
+
+    with TinyDB(path) as db:
+        assert db.all() == [{'a': 1}]
+    assert not os.path.exists(path + '.journal')
+
+
+def test_json_crash_at_every_point_of_write(tmpdir, monkeypatch):
+    # Simulate the process dying at each fsync during a write and check that
+    # the database can be reopened with either the old or the new state.
+    path = str(tmpdir.join('db.json'))
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+
+    class Crash(BaseException):
+        pass
+
+    real_fsync = os.fsync
+    for crash_at in range(1, 8):
+        with open(path, 'rb') as f:
+            before = f.read()
+
+        calls = {'n': 0}
+
+        def fsync(fd):
+            calls['n'] += 1
+            if calls['n'] == crash_at:
+                raise Crash
+            real_fsync(fd)
+
+        db = TinyDB(path)
+        monkeypatch.setattr(os, 'fsync', fsync)
+        try:
+            db.insert({'b': crash_at})
+            crashed = False
+        except Crash:
+            crashed = True
+        monkeypatch.setattr(os, 'fsync', real_fsync)
+
+        # Not closing cleanly, as in a kill; reopen from disk
+        with TinyDB(path) as db2:
+            docs = db2.all()
+        assert docs[0] == {'a': 1}
+        assert not os.path.exists(path + '.journal')
+        if not crashed:
+            break
+
+
+def test_json_read_only_write_error_leaves_no_journal(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+
+    with TinyDB(path, access_mode='r') as db:
+        with pytest.raises(IOError):
+            db.insert({'b': 2})
+    assert os.listdir(str(tmpdir)) == ['db.json']
