+    # Crash safety
+    #
+    # The file is rewritten in place (no temp file + rename, as that fails for
+    # bind-mounted single files). To make that safe, the new contents are first
+    # written to a journal file next to the database: a SHA-256 hex digest line
+    # followed by the payload. Only once the journal is fully on disk is the
+    # database file overwritten, and the journal is deleted afterwards.
+    #
+    # On open, a journal with a valid digest is replayed (the crash happened
+    # while overwriting the database, which may be truncated). A journal with an
+    # invalid digest was never completed, so the database itself is untouched
+    # and the journal is just discarded.
+
+    def _write_journal(self, serialized: str) -> None:
+        payload = serialized.encode(self._encoding)
+        digest = hashlib.sha256(payload).hexdigest().encode('ascii')
+
+        with open(self._journal_path, 'wb') as journal:
+            journal.write(digest + b'\n' + payload)
+            journal.flush()
+            os.fsync(journal.fileno())
+
+        self._fsync_dir()
+
+    def _remove_journal(self) -> None:
+        try:
+            os.remove(self._journal_path)
+        except FileNotFoundError:
+            pass
+        self._fsync_dir()
+
+    def _fsync_dir(self) -> None:
+        # Best effort: make the journal's creation/removal durable
+        try:
+            fd = os.open(os.path.dirname(os.path.abspath(self._path)), os.O_RDONLY)
+        except OSError:
+            return
+        try:
+            os.fsync(fd)
+        except OSError:
+            pass
+        finally:
+            os.close(fd)
+
+    def _read_journal(self) -> Optional[str]:
+        try:
+            with open(self._journal_path, 'rb') as journal:
+                raw = journal.read()
+        except FileNotFoundError:
+            return None
+
+        digest, sep, payload = raw.partition(b'\n')
+        if not sep or hashlib.sha256(payload).hexdigest().encode('ascii') != digest:
+            return ''  # incomplete journal
+
+        return payload.decode(self._encoding)
+
+    def _recover(self) -> None:
+        serialized = self._read_journal()
+
+        if serialized:
+            self._overwrite(serialized)
+
+        if serialized is not None:
+            self._remove_journal()
+
+    def _overwrite(self, serialized: str) -> None:
+        self._handle.seek(0)
+        self._handle.write(serialized)
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+        self._handle.truncate()
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+
