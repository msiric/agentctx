+
+/**
+Parse a string with a number of bytes, the reverse of `prettyBytes()`, into a number of bytes.
+
+Supports plain numbers (`'512'`), bytes (`'512 B'`), the binary units `KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`, `ZiB`, and `YiB`, and the same units without the `i` (`kB` or `KB`, `MB`, `GB`, …). Units without the `i` are powers of 1024, so `'1 KB'` is `1024`. The number may be fractional, the space before the unit is optional, and units are case-sensitive.
+
+The result is not rounded, so a fractional value like `'1.5 B'` gives `1.5`.
+
+@throws A `TypeError` if the input is not a string or is not a valid byte string.
+
+@example
+```
+import {parseBytes} from 'pretty-bytes';
+
+parseBytes('512');
+//=> 512
+
+parseBytes('1.5 KiB');
+//=> 1536
+```
+*/
+export function parseBytes(string: string): number;
diff --git a/index.js b/index.js
index c5f37ab..f3ee722 100644
--- a/index.js
+++ b/index.js
@@ -285,3 +285,24 @@ export default function prettyBytes(number, options) {
 	const result = prefix + numberString + separator + UNITS[exponent];
 	return result.padStart(options.fixedWidth ?? 0);
 }
+
+const BYTES_PATTERN = /^(\d+(?:\.\d*)?|\.\d+)\s*(B|[kK]B|[MGTPEZY]B|[KMGTPEZY]iB)?$/;
+
+export function parseBytes(string) {
+	if (typeof string !== 'string') {
+		throw new TypeError(`Expected a string, got \`${typeof string}\``);
+	}
+
+	const match = BYTES_PATTERN.exec(string.trim());
+
+	if (!match) {
+		throw new TypeError(`Invalid byte string: \`${string}\``);
+	}
+
+	const [, value, unit = 'B'] = match;
+
+	// The units without the `i` (`kB`, `KB`, `MB`, ...) are powers of 1024 too, as pasted from Windows Explorer, so `1 KB` is `1024` and not `1000`.
+	const exponent = BIBYTE_UNITS.indexOf(unit.replace(/^k/, 'K').replace(/(?<=^.)B/, 'iB'));
+
+	return Number(value) * (1024 ** exponent);
+}
