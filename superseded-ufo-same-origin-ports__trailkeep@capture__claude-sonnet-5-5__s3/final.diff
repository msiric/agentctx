 /**
@@ -773,3 +780,49 @@ export function withoutHost(input: string) {
   const parsed = parseURL(input);
   return (parsed.pathname || "/") + parsed.search + parsed.hash;
 }
+
+const DEFAULT_PORTS: Record<string, string> = {
+  "http:": "80",
+  "https:": "443",
+  "ws:": "80",
+  "wss:": "443",
+  "ftp:": "21",
+};
+
+function _getOrigin(input: string | undefined): string | undefined {
+  if (!input || typeof input !== "string") {
+    return undefined;
+  }
+  const { protocol, host } = parseURL(input);
+  if (!host) {
+    return undefined;
+  }
+  const match = host.toLowerCase().match(/^(.*?)(?::(\d*))?$/);
+  const hostname = match?.[1];
+  if (!hostname) {
+    return undefined;
+  }
+  let port = match?.[2] || "";
+  if (port === DEFAULT_PORTS[protocol || ""]) {
+    port = "";
+  }
+  return `${protocol || "//"}//${hostname}${port ? ":" + port : ""}`;
+}
+
+/**
+ * Check if two URLs share the same origin (protocol, host and port).
+ * Default ports are normalized (`https://x` equals `https://x:443`).
+ * Relative paths and empty inputs never have an origin and return `false`.
+ *
+ * @example
+ * ```js
+ * isSameOrigin("https://a.com/x", "https://a.com:443/y"); // true
+ * isSameOrigin("https://a.com", "http://a.com"); // false
+ * ```
+ *
+ * @group utils
+ */
+export function isSameOrigin(a?: string, b?: string): boolean {
+  const originA = _getOrigin(a);
+  return originA !== undefined && originA === _getOrigin(b);
+}
