diff --git a/test/same-origin.test.ts b/test/same-origin.test.ts
new file mode 100644
index 0000000..e6e1ab5
--- /dev/null
+++ b/test/same-origin.test.ts
@@ -0,0 +1,95 @@
+import { describe, expect, test } from "vitest";
+import { isSameOrigin } from "../src";
+
+// Each entry: [a, b, expected, note]
+const sameOrigin: [string, string, boolean, string][] = [
+  // Basics
+  ["https://example.com", "https://example.com", true, "identical"],
+  [
+    "https://example.com/a?x=1#h",
+    "https://example.com/b?y=2#g",
+    true,
+    "path, query and hash are ignored",
+  ],
+  ["https://example.com", "https://example.com/", true, "trailing slash"],
+
+  // Case-insensitivity
+  ["https://EXAMPLE.com", "https://example.com", true, "host is case-insensitive"],
+  ["HTTPS://example.com", "https://example.com", true, "protocol is case-insensitive"],
+
+  // Ports
+  ["https://example.com:8080/a", "https://example.com:8080/b", true, "same explicit port"],
+  ["https://example.com:443", "https://example.com:443/x", true, "same explicit default port on both"],
+
+  // Userinfo is not part of the origin
+  ["https://user:pass@example.com/a", "https://example.com/b", true, "auth is ignored"],
+
+  // Protocol-relative URLs: compared by host only
+  ["//example.com/a", "//example.com/b", true, "both protocol-relative"],
+];
+
+const differentOrigin: [string, string, boolean, string][] = [
+  ["http://example.com", "https://example.com", false, "different protocol"],
+  ["https://example.com", "https://example.org", false, "different domain"],
+  ["https://example.com", "https://www.example.com", false, "subdomain differs"],
+  ["https://a.example.com", "https://example.com", false, "subdomain differs (reverse)"],
+  ["https://example.com:8080", "https://example.com:9090", false, "different port"],
+  ["https://example.com:8080", "https://example.com", false, "non-default vs default port"],
+  // Strict port comparison: no default-port normalization
+  ["https://example.com", "https://example.com:443", false, "implicit vs explicit https default port"],
+  ["http://example.com", "http://example.com:80", false, "implicit vs explicit http default port"],
+  ["http://example.com:443", "https://example.com", false, "different protocol and port"],
+  ["https://example.com", "https://example.com.evil.com", false, "host prefix"],
+  [
+    "https://example.com@evil.com",
+    "https://example.com",
+    false,
+    "userinfo trick: real host is evil.com",
+  ],
+  ["https://example.com", "//example.com", false, "explicit protocol vs protocol-relative"],
+];
+
+const noOrigin: [string | undefined, string | undefined, boolean, string][] = [
+  ["/a", "/b", false, "relative paths have no origin"],
+  ["/a", "https://example.com/a", false, "relative vs absolute"],
+  ["https://example.com/a", "/a", false, "absolute vs relative"],
+  ["a/b", "a/b", false, "identical relative paths are still not same-origin"],
+  ["", "", false, "empty strings"],
+  [undefined, undefined, false, "undefined inputs"],
+  ["https://example.com", "", false, "empty second argument"],
+  ["//example.com", "/example.com", false, "protocol-relative vs path"],
+];
+
+describe("isSameOrigin", () => {
+  describe("same origin", () => {
+    for (const [a, b, expected, note] of sameOrigin) {
+      test(`${note}: ${a} ~ ${b}`, () => {
+        expect(isSameOrigin(a, b)).toBe(expected);
+        expect(isSameOrigin(b, a)).toBe(expected); // symmetric
+      });
+    }
+  });
+
+  describe("different origin", () => {
+    for (const [a, b, expected, note] of differentOrigin) {
+      test(`${note}: ${a} !~ ${b}`, () => {
+        expect(isSameOrigin(a, b)).toBe(expected);
+        expect(isSameOrigin(b, a)).toBe(expected); // symmetric
+      });
+    }
+  });
+
+  describe("missing or relative origin", () => {
+    for (const [a, b, expected, note] of noOrigin) {
+      test(`${note}: ${JSON.stringify(a)} vs ${JSON.stringify(b)}`, () => {
+        expect(isSameOrigin(a as any, b as any)).toBe(expected);
+        expect(isSameOrigin(b as any, a as any)).toBe(expected);
+      });
+    }
+  });
+
+  test("does not throw on malformed input", () => {
+    expect(() => isSameOrigin("http://", "http://")).not.toThrow();
+    expect(() => isSameOrigin("https://[::1", "https://[::1")).not.toThrow();
+  });
+});
