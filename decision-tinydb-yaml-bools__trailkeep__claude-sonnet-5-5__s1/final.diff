+def test_yaml_roundtrip(tmpdir):
+    path = str(tmpdir.join('test.yaml'))
+    storage = YAMLStorage(path)
+    assert storage.read() is None
+    storage.write(doc)
+    assert storage.read() == doc
+    storage.close()
+
+
+def test_yaml_shrinking_write(tmpdir):
+    path = str(tmpdir.join('test.yaml'))
+    storage = YAMLStorage(path)
+    storage.write(doc)
+    storage.write({'a': 1})
+    assert storage.read() == {'a': 1}
+    storage.close()
+
+
+def test_yaml_booleans_stay_strings(tmpdir):
+    path = tmpdir.join('test.yaml')
+    path.write(
+        '_default:\n'
+        '  1:\n'
+        '    country: NO\n'
+        '    a: yes\n'
+        '    b: off\n'
+        '    c: on\n'
+        '    d: true\n'
+        '    e: False\n'
+    )
+    storage = YAMLStorage(str(path))
+    row = storage.read()['_default'][1]
+    assert row == {'country': 'NO', 'a': 'yes', 'b': 'off', 'c': 'on',
+                   'd': True, 'e': False}
+    storage.close()
+
+
+def test_yaml_string_bool_roundtrip(tmpdir):
+    path = str(tmpdir.join('test.yaml'))
+    data = {'_default': {'1': {'country': 'NO', 'x': 'yes', 'y': 'true'}}}
+    storage = YAMLStorage(path)
+    storage.write(data)
+    assert storage.read() == data
+    storage.close()
+
+
+def test_yaml_with_tinydb(tmpdir):
+    path = str(tmpdir.join('test.yaml'))
+    with TinyDB(path, storage=YAMLStorage) as db:
+        db.insert({'country': 'NO', 'ok': True})
+        db.insert({'country': 'SE', 'ok': False})
+    with TinyDB(path, storage=YAMLStorage) as db:
+        assert db.get(where('country') == 'NO') == {'country': 'NO', 'ok': True}
+        assert len(db) == 2
+
+
+def test_yaml_readonly_write_fails(tmpdir):
+    path = str(tmpdir.join('test.yaml'))
+    YAMLStorage(path).close()
+    storage = YAMLStorage(path, access_mode='r')
+    with pytest.raises(IOError):
+        storage.write(doc)
+    storage.close()
