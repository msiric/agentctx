+class YAMLStorage(_FileStorage):
+    """
+    Store the data in a YAML file (requires PyYAML).
+
+    Files are read with a safe loader that follows YAML 1.2 booleans: only
+    ``true`` and ``false`` (case variants ``True``/``TRUE``) are booleans, so
+    hand-edited values like ``country: NO`` or ``on``/``off``/``yes`` stay
+    strings.
+    """
+
+    def __init__(self, path: str, create_dirs=False, encoding='utf-8', access_mode='r+', **kwargs):
+        """
+        Create a new instance.
+
+        :param path: Where to store the YAML data.
+        :param kwargs: Extra arguments passed to ``yaml.safe_dump``.
+        """
+
+        try:
+            import yaml
+        except ImportError as e:  # pragma: no cover
+            raise ImportError('YAMLStorage requires PyYAML: pip install pyyaml') from e
+
+        super().__init__(path, create_dirs=create_dirs, encoding=encoding, access_mode=access_mode)
+
+        self._yaml = yaml
+        self._loader = _make_yaml_loader(yaml)
+        self.kwargs = kwargs
+
+    def read(self) -> Optional[dict[str, dict[str, Any]]]:
+        self._handle.seek(0)
+        data = self._yaml.load(self._handle, Loader=self._loader)
+
+        # Empty (or comment-only) file: storage is empty
+        return data or None
+
+    def write(self, data: dict[str, dict[str, Any]]):
+        self._handle.seek(0)
+
+        kwargs = {'default_flow_style': False, 'allow_unicode': True}
+        kwargs.update(self.kwargs)
+        serialized = self._yaml.safe_dump(data, **kwargs)
+
+        try:
+            self._handle.write(serialized)
+        except io.UnsupportedOperation:
+            raise IOError('Cannot write to the database. Access mode is "{0}"'.format(self._mode))
+
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+        self._handle.truncate()
+
+
+def _make_yaml_loader(yaml):
+    """
+    Build a SafeLoader subclass where only ``true``/``false`` are booleans.
+    """
+    import re
+
+    class _Loader(yaml.SafeLoader):
+        pass
+
+    # Copy resolver table (it is shared with the parent class otherwise) and
+    # drop the YAML 1.1 bool resolver
+    resolvers = {}
+    for ch, entries in yaml.SafeLoader.yaml_implicit_resolvers.items():
+        kept = [(tag, rx) for tag, rx in entries if tag != 'tag:yaml.org,2002:bool']
+        if kept:
+            resolvers[ch] = kept
+    _Loader.yaml_implicit_resolvers = resolvers
+
+    _Loader.add_implicit_resolver(
+        'tag:yaml.org,2002:bool',
+        re.compile(r'^(?:true|True|TRUE|false|False|FALSE)$'),
+        list('tTfF'),
+    )
+
+    return _Loader
+
