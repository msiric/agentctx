+/**
+ * Collapse ranges into one range spanning the lowest start to highest end.
+ * @private
+ */
+
+function collapseRanges (ranges) {
+  var start = Infinity
+  var end = -1
+
+  for (var i = 0; i < ranges.length; i++) {
+    if (ranges[i].start < start) start = ranges[i].start
+    if (ranges[i].end > end) end = ranges[i].end
+  }
+
+  var collapsed = [{ start: start, end: end }]
+
+  collapsed.type = ranges.type
+
+  return collapsed
+}
