@@ -292,3 +292,41 @@ test('keep the sub-day parts exact at any magnitude', () => {
 		assert.strictEqual(parsed.hours, Number(bigint.hours), `${milliseconds}ms hours against the bigint path`);
 	}
 });
+
+test('largestUnit', () => {
+	const ms = (26 * 3_600_000) + (5 * 60_000) + 7009;
+	const expectations = {
+		days: [1, 2, 5, 7],
+		hours: [0, 26, 5, 7],
+		minutes: [0, 0, (26 * 60) + 5, 7],
+		seconds: [0, 0, 0, (26 * 3600) + (5 * 60) + 7],
+	};
+
+	for (const [largestUnit, [days, hours, minutes, seconds]] of Object.entries(expectations)) {
+		const expected = {
+			days,
+			hours,
+			minutes,
+			seconds,
+			milliseconds: 9,
+			microseconds: 0,
+			nanoseconds: 0,
+		};
+		assert.deepStrictEqual(parseMilliseconds(ms, {largestUnit}), expected);
+		assert.deepStrictEqual(
+			parseMilliseconds(BigInt(ms), {largestUnit}),
+			Object.fromEntries(Object.entries(expected).map(([unit, value]) => [unit, BigInt(value)])),
+		);
+	}
+
+	assert.deepStrictEqual(parseMilliseconds(ms, {}), parseMilliseconds(ms, {largestUnit: 'days'}));
+	assert.equal(parseMilliseconds(-ms, {largestUnit: 'hours'}).hours, -26);
+	assert.equal(parseMilliseconds(-BigInt(ms), {largestUnit: 'hours'}).hours, -26n);
+});
+
+test('largestUnit rejects invalid values', () => {
+	for (const largestUnit of ['milliseconds', 'weeks', 'Days', '', null, 1, {}]) {
+		assert.throws(() => parseMilliseconds(1000, {largestUnit}), {name: 'TypeError', message: /^parse-ms: /v});
+		assert.throws(() => parseMilliseconds(1000n, {largestUnit}), TypeError);
+	}
+});
