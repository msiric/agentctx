 ```
 
+##### significantDigits
+
+Type: `number`\
+Default: `3`
+
+The number of significant digits to round to.
+
+Only applies when neither [`minimumFractionDigits`](#minimumfractiondigits) nor [`maximumFractionDigits`](#maximumfractiondigits) is set, as those take over the rounding. The integer part is never rounded away, so `123456` bytes with `significantDigits: 2` is still `123 kB`.
+
+Must be an integer between 1 and 100. Throws a `TypeError` for invalid values.
+
+```js
+import prettyBytes from 'pretty-bytes';
+
+prettyBytes(1337, {significantDigits: 2});
+//=> '1.3 kB'
+
+prettyBytes(1337, {significantDigits: 4});
+//=> '1.337 kB'
+```
+
 ##### unit
 
 Type: `string`\
diff --git a/test.js b/test.js
index e0a3dc4..0fd2ceb 100644
--- a/test.js
+++ b/test.js
@@ -1196,3 +1196,39 @@ test('unit must belong to the active unit system', t => {
 		prettyBytes(1337, {unit: 'KiB'});
 	}, {message: 'Expected unit to be one of \'B\', \'kB\', \'MB\', \'GB\', \'TB\', \'PB\', \'EB\', \'ZB\', \'YB\', got string: KiB'});
 });
+
+test('significantDigits', t => {
+	t.is(prettyBytes(1337), '1.34 kB');
+	t.is(prettyBytes(1337, {significantDigits: 3}), '1.34 kB');
+	t.is(prettyBytes(1337, {significantDigits: 1}), '1 kB');
+	t.is(prettyBytes(1337, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 10}), '1.337 kB');
+	t.is(prettyBytes(1337n, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 2, locale: 'de'}), '1,3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 2, bits: true}), '1.3 kbit');
+
+	// The integer part is never rounded away.
+	t.is(prettyBytes(123_456, {significantDigits: 2}), '123 kB');
+
+	// Rounding up onto a unit boundary moves to the next unit.
+	t.is(prettyBytes(999_999, {significantDigits: 1}), '1 MB');
+	t.is(prettyBytes(9999, {significantDigits: 1}), '10 kB');
+
+	// The fraction digit options take over.
+	t.is(prettyBytes(1337, {significantDigits: 5, maximumFractionDigits: 1}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 1, minimumFractionDigits: 2}), '1.337 kB');
+
+	// Works with a forced unit.
+	t.is(prettyBytes(1337, {significantDigits: 2, unit: 'MB'}), '0.0013 MB');
+});
+
+test('significantDigits must be an integer between 1 and 100', t => {
+	for (const significantDigits of [0, 101, 1.5, -1, Number.NaN, '3', null]) {
+		t.throws(() => {
+			prettyBytes(1337, {significantDigits});
+		}, {instanceOf: TypeError});
+	}
+
+	t.is(prettyBytes(1337, {significantDigits: 100}), '1.337 kB');
+});
