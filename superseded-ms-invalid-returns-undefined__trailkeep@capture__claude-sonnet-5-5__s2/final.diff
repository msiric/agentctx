+import { describe, expect, it } from '@jest/globals';
+import { parseCompound } from './index';
+
+describe('parseCompound(string)', () => {
+  it('should parse short units', () => {
+    expect(parseCompound('1h 30m')).toBe(5400000);
+  });
+
+  it('should parse long units with spaces', () => {
+    expect(parseCompound('2 days 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
+  });
+
+  it('should parse a single piece', () => {
+    expect(parseCompound('90s')).toBe(90000);
+  });
+
+  it('should accept commas and "and" separators', () => {
+    expect(parseCompound('1h, 30m')).toBe(5400000);
+    expect(parseCompound('1h and 30m')).toBe(5400000);
+    expect(parseCompound('1 hour, and 30 minutes')).toBe(5400000);
+  });
+
+  it('should be case-insensitive and ignore surrounding whitespace', () => {
+    expect(parseCompound('  1H 30M ')).toBe(5400000);
+  });
+
+  it('should support decimals, negatives and three or more pieces', () => {
+    expect(parseCompound('1.5h 30m')).toBe(7200000);
+    expect(parseCompound('1m -30s')).toBe(30000);
+    expect(parseCompound('1d 1h 1m 1s 1ms')).toBe(90061001);
+  });
+
+  it('should throw a TypeError including the input for invalid strings', () => {
+    for (const bad of ['abc', '1h foo', '1h 30', '1h30', '1h and', '1h 30x']) {
+      expect(() => parseCompound(bad)).toThrow(TypeError);
+      expect(() => parseCompound(bad)).toThrow(JSON.stringify(bad));
+    }
+  });
+
+  it('should throw a TypeError for empty, too long, or non-string values', () => {
+    expect(() => parseCompound('')).toThrow(TypeError);
+    expect(() => parseCompound('')).toThrow('value=""');
+    expect(() => parseCompound('1h '.repeat(40))).toThrow(TypeError);
+    // @ts-expect-error testing runtime behavior
+    expect(() => parseCompound(5)).toThrow(TypeError);
+  });
+});
