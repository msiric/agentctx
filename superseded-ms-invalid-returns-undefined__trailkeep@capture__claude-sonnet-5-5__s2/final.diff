+const COMPOUND_PIECE = String.raw`-?\d*\.?\d+ *[a-z]+`;
+const COMPOUND_SEPARATOR = String.raw`(?:\s*,\s*(?:and\s+)?|\s+and\s+|\s+)`;
+const COMPOUND_REGEX = new RegExp(
+  `^${COMPOUND_PIECE}(?:${COMPOUND_SEPARATOR}${COMPOUND_PIECE})*$`,
+  'i',
+);
+
+/**
+ * Parse a compound duration such as `"1h 30m"` or `"2 days 4 hours"` and
+ * return the total in milliseconds. Pieces may be separated by whitespace,
+ * commas, and/or "and". Each piece is parsed with `parse`.
+ *
+ * @param str - A compound duration string
+ * @returns The total in milliseconds
+ * @throws TypeError if `str` is not a valid compound duration string
+ */
+export function parseCompound(str: string): number {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw new TypeError(
+      `Value provided to ms.parseCompound() must be a string with length between 1 and 99. value=${JSON.stringify(str)}`,
+    );
+  }
+  const input = str.trim();
+  const invalid = () =>
+    new TypeError(
+      `Value provided to ms.parseCompound() is not a valid compound duration. value=${JSON.stringify(str)}`,
+    );
+  if (!COMPOUND_REGEX.test(input)) {
+    throw invalid();
+  }
+  let total = 0;
+  for (const [piece] of input.matchAll(new RegExp(COMPOUND_PIECE, 'gi'))) {
+    const value = parse(piece);
+    if (Number.isNaN(value)) {
+      throw invalid();
+    }
+    total += value;
+  }
+  return total;
+}
+
+const CLOCK_REGEX = /^(?:(\d+):)?(\d+):([0-5]\d)(\.\d+)?$/;
+
+/**
+ * Parse a timer-style string and return milliseconds. `"m:ss"` (e.g. `"1:30"`)
+ * and `"h:mm:ss"` (e.g. `"01:02:03"`) are supported, with optional fractional
+ * seconds (`"1:30.5"`). Seconds must be two digits and below 60; in the
+ * `h:mm:ss` form minutes must also be two digits and below 60.
+ *
+ * Unlike `parseCompound`, this returns `undefined` rather than throwing on
+ * invalid input.
+ *
+ * @param str - A clock-style duration string
+ * @returns The value in milliseconds, or `undefined` if `str` is invalid
+ */
+export function parseClock(str: string): number | undefined {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    return undefined;
+  }
+  const match = CLOCK_REGEX.exec(str.trim());
+  if (!match) {
+    return undefined;
+  }
+  const [, hours, minutes, seconds, fraction] = match;
+  if (hours !== undefined && (minutes.length !== 2 || Number(minutes) > 59)) {
+    return undefined;
+  }
+  return (
+    Number(hours ?? 0) * 3600000 +
+    Number(minutes) * 60000 +
+    Number(seconds + (fraction ?? '')) * 1000
+  );
+}
