@@ -1492,3 +1492,26 @@ test('rejects an invalid `arrayFormatSeparator`', () => {
 
 	assert.deepEqual(structuredClone(queryString.parse('foo=a·b', {arrayFormat: 'separator', arrayFormatSeparator: '·'})), {foo: ['a', 'b']});
 });
+
+test('`json` type decodes the value as JSON', () => {
+	const types = {filter: 'json'};
+	assert.deepEqual(structuredClone(queryString.parse('filter=%7B%22a%22%3A%5B1%2C2%5D%7D', {types})), {filter: {a: [1, 2]}});
+	assert.deepEqual(structuredClone(queryString.parse('filter=true', {types})), {filter: true});
+	assert.deepEqual(structuredClone(queryString.parse('filter=null', {types})), {filter: null});
+	assert.deepEqual(structuredClone(queryString.parse('filter=12', {types})), {filter: 12});
+	assert.deepEqual(structuredClone(queryString.parse('filter=%22x%22', {types})), {filter: 'x'});
+});
+
+test('`json` type leaves invalid JSON as the string', () => {
+	const types = {filter: 'json'};
+	assert.deepEqual(structuredClone(queryString.parse('filter=%7B', {types})), {filter: '{'});
+	assert.deepEqual(structuredClone(queryString.parse('filter=abc', {types})), {filter: 'abc'});
+	assert.deepEqual(structuredClone(queryString.parse('filter=', {types})), {filter: ''});
+	assert.deepEqual(structuredClone(queryString.parse('filter', {types})), {filter: null});
+});
+
+test('`json` type takes precedence over `parseNumbers` and `parseBooleans`, and decodes each repeated item', () => {
+	assert.deepEqual(structuredClone(queryString.parse('filter=1&other=1', {parseNumbers: true, types: {filter: 'json'}})), {filter: 1, other: 1});
+	assert.deepEqual(structuredClone(queryString.parse('filter=true&filter=%7B', {parseBooleans: true, types: {filter: 'json'}})), {filter: [true, '{']});
+	assert.deepEqual(structuredClone(queryString.parse('filter=1,%5B2%5D', {arrayFormat: 'comma', types: {filter: 'json'}})), {filter: [1, [2]]});
