index 2361505..04224d9 100644
--- a/test-timing.js
+++ b/test-timing.js
@@ -906,3 +906,156 @@ test('unref is not applied unless the option is set', {timeout: 30_000}, async t
 
 	assert.ok(!isUnrefCalled);
 });
+
+test('context includes elapsedTime since pRetry was called', async t => {
+	const originalPerformanceNow = performance.now;
+	let now = 1000; // Not 0, so a value measured from the clock's origin would be caught.
+
+	performance.now = () => now;
+
+	t.after(() => {
+		performance.now = originalPerformanceNow;
+	});
+
+	const seen = {shouldConsumeRetry: [], onFailedAttempt: [], shouldRetry: []};
+	const record = name => ({elapsedTime}) => {
+		seen[name].push(elapsedTime);
+		now += 10;
+		return true;
+	};
+
+	await assert.rejects(pRetry(
+		async () => {
+			now += 100;
+			throw new Error('test');
+		},
+		{
+			retries: 1,
+			minTimeout: 0,
+			shouldConsumeRetry: record('shouldConsumeRetry'),
+			onFailedAttempt: record('onFailedAttempt'),
+			shouldRetry: record('shouldRetry'),
+		},
+	), {message: 'test'});
+
+	// Attempt 1 fails at 100, each callback then advances the clock by 10. Attempt 2 fails at 100 + 30 + 100 = 230, and `shouldRetry` does not run once retries are out. `shouldRetry` shares the context `onFailedAttempt` got, so it sees the same value.
+	assert.deepEqual(seen, {
+		shouldConsumeRetry: [100, 230],
+		onFailedAttempt: [110, 240],
+		shouldRetry: [110],
+	});
+});
+
+test('honours a numeric retryAfter (seconds) on the error', async () => {
+	const delays = [];
+	const start = performance.now();
+	let calls = 0;
+
+	await pRetry(async () => {
+		calls++;
+		if (calls === 1) {
+			throw Object.assign(new Error('rate limited'), {retryAfter: 0.2});
+		}
+	}, {
+		minTimeout: 0,
+		onFailedAttempt({retryDelay}) {
+			delays.push(retryDelay);
+		},
+	});
+
+	assert.deepEqual(delays, [200]);
+	assert.ok(performance.now() - start >= 190);
+});
+
+test('retryAfter is a floor, the backoff wins when longer', async () => {
+	const delays = [];
+	let calls = 0;
+
+	await pRetry(async () => {
+		calls++;
+		if (calls === 1) {
+			throw Object.assign(new Error('x'), {retryAfter: 0.001});
+		}
+	}, {
+		minTimeout: 50,
+		onFailedAttempt({retryDelay}) {
+			delays.push(retryDelay);
+		},
+	});
+
+	assert.deepEqual(delays, [50]);
+});
+
+test('retryAfter is not capped by maxTimeout', async () => {
+	const delays = [];
+	let calls = 0;
+
+	await pRetry(async () => {
+		calls++;
+		if (calls === 1) {
+			throw Object.assign(new Error('x'), {retryAfter: 0.1});
+		}
+	}, {
+		minTimeout: 1,
+		maxTimeout: 5,
+		onFailedAttempt({retryDelay}) {
+			delays.push(retryDelay);
+		},
+	});
+
+	assert.deepEqual(delays, [100]);
+});
+
+test('invalid retryAfter values are ignored', async () => {
+	for (const retryAfter of ['5', -1, NaN, Infinity, null, undefined]) {
+		const delays = [];
+		let calls = 0;
+
+		await pRetry(async () => {
+			calls++;
+			if (calls === 1) {
+				throw Object.assign(new Error('x'), {retryAfter});
+			}
+		}, {
+			minTimeout: 0,
+			onFailedAttempt({retryDelay}) {
+				delays.push(retryDelay);
+			},
+		});
+
+		assert.deepEqual(delays, [0], String(retryAfter));
+	}
+});
+
+test('retryAfter does not delay when no retry follows', async () => {
+	const delays = [];
+
+	await assert.rejects(pRetry(async () => {
+		throw Object.assign(new Error('x'), {retryAfter: 60});
+	}, {
+		retries: 0,
+		onFailedAttempt({retryDelay}) {
+			delays.push(retryDelay);
+		},
+	}), {message: 'x'});
+
+	assert.deepEqual(delays, [0]);
+});
+
+test('maxRetryTime still bounds retryAfter', async () => {
+	const start = performance.now();
+	let calls = 0;
+
+	await pRetry(async () => {
+		calls++;
+		if (calls === 1) {
+			throw Object.assign(new Error('x'), {retryAfter: 60});
+		}
+	}, {
+		minTimeout: 0,
+		maxRetryTime: 200,
+	});
+
+	assert.equal(calls, 2);
+	assert.ok(performance.now() - start < 1000);
+});
