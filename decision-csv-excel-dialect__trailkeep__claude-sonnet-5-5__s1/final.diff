+    def to_csv(self, path: str, fields: Optional[Iterable[str]] = None) -> None:
+        """
+        Export the table to a CSV file: a header row, then one row per document.
+
+        The file is written semicolon-delimited as UTF-8 with a BOM, which is
+        what Excel with a German locale (used by finance) needs to split the
+        columns and read umlauts correctly.
+
+        :param path: the file to write
+        :param fields: the columns to write, in order. Defaults to every
+                       top-level key, in first-seen order.
+        """
+
+        docs = list(self)
+
+        if fields is None:
+            columns: list[str] = []
+            seen = set()
+            for doc in docs:
+                for key in doc:
+                    if key not in seen:
+                        seen.add(key)
+                        columns.append(key)
+        else:
+            columns = list(fields)
+
+        with open(path, 'w', newline='', encoding='utf-8-sig') as f:
+            writer = csv.writer(f, delimiter=';')
+            writer.writerow(columns)
+            for doc in docs:
+                writer.writerow([doc.get(c, '') for c in columns])
+
