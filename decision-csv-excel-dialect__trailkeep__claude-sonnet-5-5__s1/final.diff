@@ -197,3 +197,52 @@ def test_persist_empty_does_not_wipe_existing_data(tmpdir):
     assert len(table) == 1
     assert table.all() == [{'a': 1}]
     db.close()
+
+
+def _read_csv(path):
+    import csv
+    with open(path, encoding='utf-8-sig', newline='') as f:
+        return list(csv.reader(f, delimiter=';'))
+
+
+def test_to_csv_default_fields(db, tmp_path):
+    table = db.table('csv')
+    table.insert({'a': 1, 'b': 'x'})
+    table.insert({'b': 'y', 'c': 3})
+    path = tmp_path / 'out.csv'
+
+    table.to_csv(str(path))
+
+    assert _read_csv(path) == [['a', 'b', 'c'], ['1', 'x', ''], ['', 'y', '3']]
+
+
+def test_to_csv_fields_select_and_order(db, tmp_path):
+    table = db.table('csv')
+    table.insert({'a': 1, 'b': 'x', 'c': 3})
+    path = tmp_path / 'out.csv'
+
+    table.to_csv(str(path), fields=['c', 'a', 'missing'])
+
+    assert _read_csv(path) == [['c', 'a', 'missing'], ['3', '1', '']]
+
+
+def test_to_csv_empty_table(db, tmp_path):
+    path = tmp_path / 'out.csv'
+
+    db.table('empty').to_csv(str(path))
+    assert _read_csv(path) == [[]]  # header row only, no columns
+
+    db.table('empty').to_csv(str(path), fields=['a'])
+    assert _read_csv(path) == [['a']]
+
+
+def test_to_csv_excel_format(db, tmp_path):
+    table = db.table('csv')
+    table.insert({'name': 'Müller', 'note': 'a;b'})
+    path = tmp_path / 'out.csv'
+
+    table.to_csv(str(path))
+
+    raw = path.read_bytes()
+    assert raw.startswith(b'\xef\xbb\xbf')
+    assert 'Müller;"a;b"' in raw.decode('utf-8-sig')
