+/**
+ * Parse a compound duration such as `"1h 30m"`, `"1h, 30m"` or `"2 days 4 hours"` and
+ * return the total in milliseconds. Each piece is parsed with `parse`.
+ *
+ * @param str - A compound duration string
+ * @returns The summed value in milliseconds (never `NaN`)
+ * @throws TypeError if `str` is not a string or any piece can't be parsed
+ */
+export function parseCompound(str: string): number {
+  const invalid = () =>
+    new TypeError(
+      `Value provided to ms.parseCompound() must be a valid compound duration such as "1h 30m". value=${JSON.stringify(str)}`,
+    );
+  if (typeof str !== 'string') {
+    throw invalid();
+  }
+  // Split on whitespace and/or a comma that follows a unit and precedes the next number.
+  const pieces = str.trim().split(/(?<=[a-z])(?:\s*,\s*|\s+)(?=-?\.?\d)/i);
+  let total = 0;
+  for (const piece of pieces) {
+    let n: number;
+    try {
+      n = parse(piece);
+    } catch {
+      // parse() throws on empty or overlong pieces
+      throw invalid();
+    }
+    if (Number.isNaN(n)) {
+      throw invalid();
+    }
+    total += n;
+  }
+  return total;
+}
+
+/**
+ * Parse a timer-style string and return milliseconds. `"m:ss"` (e.g. `"1:30"`) and
+ * `"h:mm:ss"` (e.g. `"01:02:03"`) are supported. Seconds must be two digits (00-59);
+ * in `h:mm:ss` minutes must also be two digits (00-59). In `m:ss` the minutes may be
+ * any number of digits (e.g. `"90:00"`).
+ *
+ * @param str - A clock string
+ * @returns The value in milliseconds
+ * @throws TypeError if `str` is not a string or isn't a valid clock value
+ */
+export function parseClock(str: string): number {
+  const invalid = () =>
+    new TypeError(
+      `Value provided to ms.parseClock() must be a clock string such as "1:30" or "01:02:03". value=${JSON.stringify(str)}`,
+    );
+  if (typeof str !== 'string') {
+    throw invalid();
+  }
+  const match =
+    /^(?:(?<h>\d+):(?<m3>[0-5]\d)|(?<m2>\d+)):(?<s>[0-5]\d)$/.exec(str);
+  if (!match || !match.groups) {
+    throw invalid();
+  }
+  const { h, m3, m2, s } = match.groups;
+  const hours = h === undefined ? 0 : Number(h);
+  const minutes = Number(m3 ?? m2);
+  return hours * 3600000 + minutes * 60000 + Number(s) * 1000;
+}
