+import { describe, expect, it } from '@jest/globals';
+import { parseCompound } from './index';
+
+describe('parseCompound(string)', () => {
+  it('should parse short compound durations', () => {
+    expect(parseCompound('1h 30m')).toBe(90 * 60 * 1000);
+  });
+
+  it('should parse long compound durations', () => {
+    expect(parseCompound('2 days 4 hours')).toBe(52 * 60 * 60 * 1000);
+  });
+
+  it('should parse three or more pieces', () => {
+    expect(parseCompound('1d 2h 3m 4s 5ms')).toBe(
+      86400000 + 7200000 + 180000 + 4000 + 5,
+    );
+  });
+
+  it('should accept commas between parts', () => {
+    expect(parseCompound('1h, 30m')).toBe(5400000);
+    expect(parseCompound('1h,30m')).toBe(5400000);
+    expect(parseCompound('2 days , 4 hours, 5s')).toBe(
+      2 * 86400000 + 4 * 3600000 + 5000,
+    );
+  });
+
+  it('should reject stray commas', () => {
+    for (const input of ['1h,', ',1h', '1h,, 30m', '1,h 30m']) {
+      expect(() => parseCompound(input)).toThrow(TypeError);
+    }
+  });
+
+  it('should handle a single piece like parse', () => {
+    expect(parseCompound('5m')).toBe(300000);
+  });
+
+  it('should be case-insensitive and trim whitespace', () => {
+    expect(parseCompound('  1H   30M ')).toBe(5400000);
+  });
+
+  it('should support decimals and negatives', () => {
+    expect(parseCompound('1.5h 30m')).toBe(7200000);
+    expect(parseCompound('1h -30m')).toBe(1800000);
+    expect(parseCompound('1h .5m')).toBe(3630000);
+  });
+
+  it('should throw a TypeError including the input on invalid pieces', () => {
+    for (const input of ['abc', '1h foo', '1h 30x', '1 2']) {
+      expect(() => parseCompound(input)).toThrow(TypeError);
+      expect(() => parseCompound(input)).toThrow(JSON.stringify(input));
+    }
+  });
+
+  it('should throw a TypeError on empty or non-string values', () => {
+    expect(() => parseCompound('')).toThrow(TypeError);
+    expect(() => parseCompound('   ')).toThrow(TypeError);
+    expect(() => parseCompound(1 as unknown as string)).toThrow(TypeError);
+    expect(() => parseCompound(1 as unknown as string)).toThrow('value=1');
+  });
+
+  it('should throw a TypeError on overlong pieces', () => {
+    expect(() => parseCompound(`1h ${'9'.repeat(100)}m`)).toThrow(TypeError);
+  });
+});
