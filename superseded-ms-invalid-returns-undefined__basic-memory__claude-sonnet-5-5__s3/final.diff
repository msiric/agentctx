+import { describe, expect, it } from '@jest/globals';
+import { parseClock } from './index';
+
+describe('parseClock(string)', () => {
+  it('should parse m:ss', () => {
+    expect(parseClock('1:30')).toBe(90000);
+    expect(parseClock('0:00')).toBe(0);
+    expect(parseClock('00:45')).toBe(45000);
+    expect(parseClock('59:59')).toBe(3599000);
+  });
+
+  it('should parse h:mm:ss', () => {
+    expect(parseClock('01:02:03')).toBe(3723000);
+    expect(parseClock('1:00:00')).toBe(3600000);
+    expect(parseClock('100:00:01')).toBe(360001000);
+  });
+
+  it('should allow m:ss minutes of 60 or more', () => {
+    expect(parseClock('90:00')).toBe(5400000);
+  });
+
+  it('should reject out-of-range minutes or seconds', () => {
+    for (const input of ['1:60', '1:75', '1:60:00', '1:00:60']) {
+      expect(() => parseClock(input)).toThrow(TypeError);
+    }
+  });
+
+  it('should reject malformed strings', () => {
+    for (const input of [
+      '',
+      '1',
+      '1:',
+      ':30',
+      '1:3',
+      '1:2:03',
+      '1:02:3',
+      '1:02:03:04',
+      '-1:30',
+      '1:30.5',
+      ' 1:30',
+      '1:30 ',
+      'a:bc',
+      '1h 30m',
+    ]) {
+      expect(() => parseClock(input)).toThrow(TypeError);
+    }
+  });
+
+  it('should throw a TypeError for non-strings', () => {
+    for (const input of [undefined, null, 90, {}, []]) {
+      // @ts-expect-error testing invalid input
+      expect(() => parseClock(input)).toThrow(TypeError);
+    }
+  });
+});
