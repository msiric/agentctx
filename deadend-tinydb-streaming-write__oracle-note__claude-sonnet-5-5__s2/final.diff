+
+
+def test_gzip_json(tmpdir):
+    from tinydb.storages import GzipJSONStorage
+
+    path = str(tmpdir.join('db.json.gz'))
+
+    with TinyDB(path, storage=GzipJSONStorage) as db:
+        db.insert({'int': 1, 'text': 'a' * 1000})
+        db.insert({'int': 2})
+
+    with open(path, 'rb') as f:
+        assert f.read(2) == b'\x1f\x8b'
+
+    with TinyDB(path, storage=GzipJSONStorage) as db:
+        assert len(db) == 2
+        db.remove(where('int') == 1)
+
+    with TinyDB(path, storage=GzipJSONStorage) as db:
+        assert db.all() == [{'int': 2}]
+
+
+def test_gzip_json_invalid_dict_keeps_file(tmpdir):
+    from tinydb.storages import GzipJSONStorage
+
+    path = str(tmpdir.join('db.json.gz'))
+
+    with TinyDB(path, storage=GzipJSONStorage) as db:
+        db.insert({'int': 1})
+        with pytest.raises(TypeError):
+            db.insert({'int': {1, 2}})
+
+    with TinyDB(path, storage=GzipJSONStorage) as db:
+        assert db.all() == [{'int': 1}]
