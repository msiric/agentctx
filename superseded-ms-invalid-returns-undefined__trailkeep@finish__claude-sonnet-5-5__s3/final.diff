+/**
+ * Parse a compound duration such as `"1h 30m"`, `"1h, 30m"` or `"2 days 4 hours"` and
+ * return the total in milliseconds. Each piece is parsed with `parse`.
+ *
+ * @param str - A string made of one or more `<number><unit>` pieces
+ * @returns The summed value in milliseconds
+ * @throws TypeError if `str` is not a string of length 1 to 99, or any part
+ * of it can't be parsed
+ */
+export function parseCompound(str: string): number {
+  if (typeof str !== "string" || str.length === 0 || str.length > 100) {
+    throw new TypeError(
+      `Value provided to ms.parseCompound() must be a string with length between 1 and 99. value=${JSON.stringify(str)}`,
+    );
+  }
+  const invalid = () =>
+    new TypeError(
+      `Unable to parse compound duration in ms.parseCompound(). value=${JSON.stringify(str)}`,
+    );
+  const pieceRe = /-?\d*\.?\d+ *[a-z]*/gi;
+  const pieces = str.match(pieceRe);
+  // Everything outside the pieces must be whitespace, with at most one comma
+  // between two pieces (no leading, trailing, or doubled commas).
+  const gaps = str.split(pieceRe);
+  if (
+    !pieces ||
+    !gaps.every((gap, i) =>
+      i === 0 || i === gaps.length - 1
+        ? /^\s*$/.test(gap)
+        : /^\s*,?\s*$/.test(gap),
+    )
+  ) {
+    throw invalid();
+  }
+  let total = 0;
+  for (const piece of pieces) {
+    const trimmed = piece.trim();
+    // A bare number is only valid when it is the whole input.
+    if (pieces.length > 1 && /^-?\d*\.?\d+$/.test(trimmed)) {
+      throw invalid();
+    }
+    const value = parse(trimmed);
+    if (Number.isNaN(value)) {
+      throw invalid();
+    }
+    total += value;
+  }
+  return total;
+}
+
+/**
+ * Parse a timer-style clock string and return milliseconds. `"m:ss"` (e.g.
+ * `"1:30"`) and `"h:mm:ss"` (e.g. `"01:02:03"`) are supported. The leading
+ * field can have any number of digits; the others must be two digits and
+ * below 60. Seconds may have a fractional part (`"0:01.5"`).
+ *
+ * @param str - A clock string to parse
+ * @returns The value in milliseconds, or `undefined` if the input is not a
+ * valid clock string (this function never throws and never returns `NaN`)
+ */
+export function parseClock(str: string): number | undefined {
+  if (typeof str !== "string" || str.length === 0 || str.length > 100) {
+    return undefined;
+  }
+  const match =
+    /^(?:(?<h>\d+):(?<m2>[0-5]\d)|(?<m>\d+)):(?<s>[0-5]\d(?:\.\d+)?)$/.exec(
+      str,
+    );
+  if (!match?.groups) {
+    return undefined;
+  }
+  const g = match.groups as {
+    h?: string;
+    m2?: string;
+    m?: string;
+    s: string;
+  };
+  const hours = g.h === undefined ? 0 : Number(g.h);
+  const minutes = Number(g.m2 ?? g.m);
+  return hours * h + minutes * m + Number(g.s) * s;
+}
