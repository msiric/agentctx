diff --git a/src/parse-clock.test.ts b/src/parse-clock.test.ts
new file mode 100644
index 0000000..4485e9b
--- /dev/null
+++ b/src/parse-clock.test.ts
@@ -0,0 +1,55 @@
+import { describe, expect, it } from "@jest/globals";
+import { parseClock } from "./index";
+
+describe("parseClock(string)", () => {
+  it("should parse m:ss", () => {
+    expect(parseClock("1:30")).toBe(90_000);
+    expect(parseClock("0:05")).toBe(5_000);
+    expect(parseClock("00:00")).toBe(0);
+  });
+
+  it("should allow minutes beyond 59 in m:ss", () => {
+    expect(parseClock("90:00")).toBe(5_400_000);
+  });
+
+  it("should parse h:mm:ss", () => {
+    expect(parseClock("01:02:03")).toBe(3_723_000);
+    expect(parseClock("1:02:03")).toBe(3_723_000);
+    expect(parseClock("100:00:00")).toBe(360_000_000);
+  });
+
+  it("should parse fractional seconds", () => {
+    expect(parseClock("0:01.5")).toBe(1_500);
+    expect(parseClock("1:00:00.25")).toBe(3_600_250);
+  });
+
+  it("should return undefined (not throw, not NaN) for bad input", () => {
+    for (const bad of [
+      "",
+      "1",
+      "1:",
+      ":30",
+      "1:5",
+      "1:60",
+      "1:02:60",
+      "1:2:03",
+      "1:02:03:04",
+      "-1:30",
+      "1:30 ",
+      " 1:30",
+      "a:bc",
+      "1h",
+      "1:30.",
+      "1:30,5",
+      "1".repeat(101),
+    ]) {
+      expect(parseClock(bad)).toBeUndefined();
+    }
+  });
+
+  it("should return undefined for non-string input", () => {
+    expect(parseClock(undefined as unknown as string)).toBeUndefined();
+    expect(parseClock(90 as unknown as string)).toBeUndefined();
+    expect(parseClock(null as unknown as string)).toBeUndefined();
+  });
+});
diff --git a/src/parse-compound.test.ts b/src/parse-compound.test.ts
new file mode 100644
index 0000000..6a54498
--- /dev/null
+++ b/src/parse-compound.test.ts
@@ -0,0 +1,64 @@
+import { describe, expect, it } from "@jest/globals";
+import { parseCompound } from "./index";
+
+describe("parseCompound(string)", () => {
+  it("should sum short units", () => {
+    expect(parseCompound("1h 30m")).toBe(90 * 60 * 1000);
+  });
+
+  it("should sum long units with spaces", () => {
+    expect(parseCompound("2 days 4 hours")).toBe(52 * 60 * 60 * 1000);
+  });
+
+  it("should accept pieces without separators", () => {
+    expect(parseCompound("1h30m15s")).toBe(5415000);
+  });
+
+  it("should accept commas between pieces", () => {
+    expect(parseCompound("1h, 30m")).toBe(5400000);
+    expect(parseCompound("1h,30m , 15s")).toBe(5415000);
+  });
+
+  it("should accept decimals and mixed case", () => {
+    expect(parseCompound("1.5H 30M")).toBe(2 * 60 * 60 * 1000);
+  });
+
+  it("should accept extra whitespace", () => {
+    expect(parseCompound("  1h   30m ")).toBe(5400000);
+  });
+
+  it("should handle a single piece like parse", () => {
+    expect(parseCompound("2d")).toBe(2 * 24 * 60 * 60 * 1000);
+    expect(parseCompound("100")).toBe(100);
+  });
+
+  it("should throw a TypeError including the input for a bare number among several pieces", () => {
+    expect(() => parseCompound("1h 30")).toThrow(TypeError);
+    expect(() => parseCompound("1 2")).toThrow('"1 2"');
+  });
+
+  it("should throw a TypeError including the input for unparseable input", () => {
+    for (const input of [
+      "abc",
+      "1h foo",
+      "1h and 30m",
+      "1x 2y",
+      ",1h",
+      "1h,",
+      "1h,, 30m",
+      "1,5h",
+    ]) {
+      expect(() => parseCompound(input)).toThrow(TypeError);
+      expect(() => parseCompound(input)).toThrow(JSON.stringify(input));
+    }
+  });
+
+  it("should throw a TypeError on empty, non-string, or overlong input", () => {
+    expect(() => parseCompound("")).toThrow(TypeError);
+    expect(() => parseCompound("")).toThrow('""');
+    expect(() => parseCompound(undefined as unknown as string)).toThrow(
+      TypeError,
+    );
+    expect(() => parseCompound("1h ".repeat(40))).toThrow(TypeError);
+  });
+});
