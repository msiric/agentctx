diff --git a/tests/test_types.py b/tests/test_types.py
index e4c9782..b45e668 100644
--- a/tests/test_types.py
+++ b/tests/test_types.py
@@ -46,3 +46,111 @@ non-empty-tuple = [
 ]
 """
     )
+
+
+def test_none_values_skipped():
+    obj = {
+        "a": None,
+        "b": 1,
+        "table": {"x": None, "y": "z"},
+        "only_none": {"x": None},
+        "inline_aot": [{"p": None, "q": 1}, {"p": None}],
+        "nested": {"sub": {"k": None, "v": 2}},
+    }
+    assert (
+        tomli_w.dumps(obj)
+        == """\
+b = 1
+inline_aot = [
+    { q = 1 },
+    {},
+]
+
+[table]
+y = "z"
+
+[only_none]
+
+[nested.sub]
+v = 2
+"""
+    )
+
+
+def test_none_values_skipped_dump():
+    import io
+
+    f = io.BytesIO()
+    tomli_w.dump({"a": None, "b": 1}, f)
+    assert f.getvalue() == b"b = 1\n"
+
+
+def test_none_skipped_in_inline_table():
+    obj = {"arr": [[{"a": None, "b": 1}]], "t": {"i": [{"a": None, "b": 1}]}}
+    assert "None" not in tomli_w.dumps(obj)
+    assert "{ b = 1 }" in tomli_w.dumps(obj)
+
+
+def test_pathlib_paths():
+    import pathlib
+
+    obj = {
+        "pure": pathlib.PurePosixPath("/usr/local/bin"),
+        "path": pathlib.Path("relative/dir"),
+        "win": pathlib.PureWindowsPath("C:/Users/me"),
+        "list": [pathlib.PurePosixPath("a/b")],
+        "table": {"p": pathlib.PurePosixPath("x")},
+    }
+    assert (
+        tomli_w.dumps(obj)
+        == """\
+pure = "/usr/local/bin"
+path = "relative/dir"
+win = "C:\\\\Users\\\\me"
+list = [
+    "a/b",
+]
+
+[table]
+p = "x"
+"""
+    )
+
+
+def test_none_skipped_in_arrays():
+    obj = {
+        "arr": [1, None, 2],
+        "nested": [[None, 1], [None]],
+        "only_none": [None],
+        "tup": (None, "a"),
+        "aot": [{"a": 1}, None, {"a": 2}],
+        "inline": {"arr": [None, 3]},
+    }
+    assert (
+        tomli_w.dumps(obj)
+        == """\
+arr = [
+    1,
+    2,
+]
+nested = [
+    [
+        1,
+    ],
+    [],
+]
+only_none = []
+tup = [
+    "a",
+]
+aot = [
+    { a = 1 },
+    { a = 2 },
+]
+
+[inline]
+arr = [
+    3,
+]
+"""
+    )
