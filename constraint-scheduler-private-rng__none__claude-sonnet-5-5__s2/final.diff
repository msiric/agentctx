+    def jitter(self, seconds: float):
+        """
+        Delay each computed run time by a random offset between 0 and
+        `seconds` (inclusive), e.g. to avoid many jobs firing in the same
+        second. The offset is re-drawn every time the next run is scheduled
+        and does not accumulate across runs.
+
+        :param seconds: Maximum random delay in seconds (must be >= 0)
+        :return: The invoked job instance
+        """
+        if seconds < 0:
+            raise ScheduleValueError("`seconds` must be >= 0")
+        self.jitter_seconds = seconds
+        return self
+
+    def retry(self, times: int, base_delay: float):
+        """
+        Retry the job if it raises an exception. The n-th retry (counting
+        from 0) happens ``base_delay * 2**n`` seconds after the failure plus
+        a random 0 to ``base_delay`` seconds of jitter. After `times` failed
+        retries the job gives up and returns to its normal schedule.
+
+        Exceptions raised by a job with retries configured are logged and
+        not propagated, including the final failure.
+
+        :param times: Maximum number of retries (must be >= 1)
+        :param base_delay: Delay in seconds before the first retry (must be >= 0)
+        :return: The invoked job instance
+        """
+        if times < 1:
+            raise ScheduleValueError("`times` must be >= 1")
+        if base_delay < 0:
+            raise ScheduleValueError("`base_delay` must be >= 0")
+        self.retry_times = times
+        self.retry_base_delay = base_delay
+        return self
+
