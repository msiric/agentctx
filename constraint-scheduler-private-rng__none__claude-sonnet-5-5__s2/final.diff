+    def test_jitter(self):
+        with mock_datetime(2020, 1, 1, 10, 0, 0):
+            job = make_mock_job()
+            with mock.patch("schedule._jitter_rng.uniform", return_value=7.5) as uni:
+                j = every(10).minutes.jitter(30).do(job)
+                uni.assert_called_once_with(0, 30)
+            assert j.next_run == datetime.datetime(2020, 1, 1, 10, 10, 7, 500000)
+
+    def test_jitter_default_is_none(self):
+        with mock_datetime(2020, 1, 1, 10, 0, 0):
+            j = every(10).minutes.do(make_mock_job())
+            assert j.next_run == datetime.datetime(2020, 1, 1, 10, 10, 0)
+
+    def test_jitter_bounds_and_no_accumulation(self):
+        with mock_datetime(2020, 1, 1, 10, 0, 0):
+            j = every(10).minutes.jitter(5).do(make_mock_job())
+            for _ in range(200):
+                j._schedule_next_run()
+                offset = (j.next_run - datetime.datetime(2020, 1, 1, 10, 10)).total_seconds()
+                assert 0 <= offset <= 5
+
+    def test_jitter_with_at_time(self):
+        with mock_datetime(2020, 1, 1, 10, 0, 0):
+            with mock.patch("schedule._jitter_rng.uniform", return_value=3):
+                j = every().day.at("12:00").jitter(10).do(make_mock_job())
+            assert j.next_run == datetime.datetime(2020, 1, 1, 12, 0, 3)
+
+    def test_retry_backoff_and_give_up(self):
+        calls = []
+
+        def failing():
+            calls.append(1)
+            raise RuntimeError("boom")
+
+        failing.__name__ = "failing"
+        with mock_datetime(2020, 1, 1, 10, 0, 0):
+            now = datetime.datetime(2020, 1, 1, 10, 0, 0)
+            j = every(1).hour.retry(times=3, base_delay=30).do(failing)
+            normal = datetime.datetime(2020, 1, 1, 11, 0, 0)
+            with mock.patch("schedule._retry_rng.uniform", return_value=5):
+                for n, delay in enumerate([35, 65, 125]):
+                    j.next_run = now
+                    schedule.run_pending()
+                    assert len(calls) == n + 1
+                    assert j.next_run == now + datetime.timedelta(seconds=delay)
+                # retries exhausted: back to the normal schedule, no exception
+                j.next_run = now
+                schedule.run_pending()
+                assert len(calls) == 4
+                assert j.retries_done == 0
+                assert j.next_run == normal
+        schedule.clear()
+
+    def test_retry_jitter_bounds(self):
+        def failing():
+            raise RuntimeError
+
+        failing.__name__ = "failing"
+        with mock_datetime(2020, 1, 1, 10, 0, 0):
+            j = every(1).hour.retry(times=1, base_delay=30).do(failing)
+            for _ in range(100):
+                j.retries_done = 0
+                j.next_run = datetime.datetime.now()
+                j.run()
+                off = (j.next_run - datetime.datetime.now()).total_seconds()
+                assert 30 <= off <= 60
+        schedule.clear()
+
+    def test_retry_success_resets_counter(self):
+        outcomes = [RuntimeError("x"), None, RuntimeError("y")]
+
+        def flaky():
+            o = outcomes.pop(0)
+            if o:
+                raise o
+
+        flaky.__name__ = "flaky"
+        with mock_datetime(2020, 1, 1, 10, 0, 0):
+            j = every(1).hour.retry(times=2, base_delay=10).do(flaky)
+            j.run()
+            assert j.retries_done == 1
+            j.run()
+            assert j.retries_done == 0
+            assert j.next_run == datetime.datetime(2020, 1, 1, 11, 0, 0)
+            j.run()
+            assert j.retries_done == 1
+        schedule.clear()
