+def test_length():
+    assert Length(min=2, max=4).validate("ab") == "ab"
+    assert Length(min=2, max=4).validate("abcd") == "abcd"
+    assert Length().validate("") == ""
+    assert Length(min=1).validate("x" * 1000) == "x" * 1000
+    assert Length(max=0).validate("") == ""
+    with SE:
+        Length(min=2).validate("a")
+    with SE:
+        Length(max=3).validate("abcd")
+    # bounds count UTF-8 bytes, not characters
+    assert Length(max=2).validate("é") == "é"
+    with SE:
+        Length(max=3).validate("éé")
+    with SE:
+        Length(min=3).validate("é")
+    assert Length(min=3, max=3).validate("日") == "日"
+    with SE:
+        Length(max=5).validate("日本")
+    for bad in (1, None, [], b"ab"):
+        with SE:
+            Length(max=5).validate(bad)
+    assert Schema({"name": Length(max=4)}).validate({"name": "abcd"}) == {"name": "abcd"}
+    with SE:
+        Schema({"name": Length(max=4)}).validate({"name": "abcde"})
+    for args in ({"min": -1}, {"max": -1}, {"min": 3, "max": 2}):
+        with raises(ValueError):
+            Length(**args)
