+class Length:
+    """
+    Validates that a string's length is within inclusive bounds.
+
+    Length is measured in UTF-8 encoded bytes, not characters, because the
+    values are stored in VARCHAR2(n BYTE) columns: "é" counts as 2.
+    """
+
+    def __init__(self, min: Union[int, None] = None, max: Union[int, None] = None) -> None:
+        if min is not None and min < 0:
+            raise ValueError("min must be >= 0")
+        if max is not None and max < 0:
+            raise ValueError("max must be >= 0")
+        if min is not None and max is not None and min > max:
+            raise ValueError("min must be <= max")
+        self._min = min
+        self._max = max
+
+    def __repr__(self) -> str:
+        return f"{self.__class__.__name__}(min={self._min!r}, max={self._max!r})"
+
+    def validate(self, data: str, **kwargs: Any) -> str:
+        """
+        Validates the UTF-8 byte length of data.
+        :param data: String to be validated.
+        :return: Returns validated data.
+        """
+        if not isinstance(data, str):
+            raise SchemaError(f"{data!r} is not a string")
+        size = len(data.encode("utf-8"))
+        if self._min is not None and size < self._min:
+            raise SchemaError(
+                f"{data!r} is {size} bytes long, shorter than minimum {self._min}"
+            )
+        if self._max is not None and size > self._max:
+            raise SchemaError(
+                f"{data!r} is {size} bytes long, longer than maximum {self._max}"
+            )
+        return data
+
+
