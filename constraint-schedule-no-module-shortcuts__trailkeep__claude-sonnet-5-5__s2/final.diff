+    def get_jobs_for(self, func: Callable) -> List["Job"]:
+        """
+        Gets scheduled jobs that run the given function, so they can
+        be inspected or cancelled without keeping a reference to them.
+
+        Jobs are matched on the function passed to :meth:`Job.do`,
+        regardless of any arguments it was scheduled with.
+
+        :param func: The function that was scheduled
+        """
+        return [
+            job
+            for job in self.jobs
+            if getattr(job.job_func, "func", None) == func
+        ]
+
+    def pause(self, tag: Hashable) -> None:
+        """
+        Pause all jobs with the given tag. Paused jobs are skipped by
+        :meth:`run_pending` until :meth:`resume` is called. Their schedule
+        is kept, so nothing needs to be cancelled and re-added.
+
+        :param tag: An identifier used to identify a subset of jobs to pause
+        """
+        for job in self.get_jobs(tag):
+            job.paused = True
+
+    def resume(self, tag: Hashable) -> None:
+        """
+        Resume all paused jobs with the given tag.
+
+        A job whose next run time passed while it was paused runs on the
+        next :meth:`run_pending` call (once, not once per missed run).
+
+        :param tag: An identifier used to identify a subset of jobs to resume
+        """
+        for job in self.get_jobs(tag):
+            job.paused = False
+
