@@ -1569,6 +1569,60 @@ class SchedulerTests(TestCase):
         schedule.clear()
         assert len(schedule.jobs) == 0
 
+    def test_get_jobs_for(self):
+        s = schedule.Scheduler()
+        job_a = make_mock_job(name="a")
+        job_b = make_mock_job(name="b")
+        s.every().second.do(job_a, 1)
+        s.every().minute.do(job_a, 2)
+        s.every().second.do(job_b)
+
+        assert len(s.get_jobs_for(job_a)) == 2
+        assert len(s.get_jobs_for(job_b)) == 1
+        assert s.get_jobs_for(make_mock_job(name="c")) == []
+
+        # Returned jobs can be cancelled; the list is a copy.
+        for job in s.get_jobs_for(job_a):
+            s.cancel_job(job)
+        assert s.get_jobs_for(job_a) == []
+        assert len(s.jobs) == 1
+
+    def test_get_jobs_for_scheduler_instance(self):
+        s1, s2 = schedule.Scheduler(), schedule.Scheduler()
+        f = make_mock_job()
+        s1.every().second.do(f)
+        assert len(s1.get_jobs_for(f)) == 1
+        assert s2.get_jobs_for(f) == []
+
+    def test_pause_and_resume_by_tag(self):
+        s = schedule.Scheduler()
+        paused_f = make_mock_job(name="paused")
+        other_f = make_mock_job(name="other")
+        s.every().second.do(paused_f).tag("maint")
+        s.every().second.do(other_f).tag("other")
+
+        s.pause("maint")
+        with mock_datetime(2100, 1, 1, 0, 0, 0):
+            s.run_pending()
+        assert paused_f.call_count == 0
+        assert other_f.call_count == 1
+        assert len(s.jobs) == 2  # still registered
+
+        s.resume("maint")
+        with mock_datetime(2100, 1, 1, 0, 0, 0):
+            s.run_pending()
+        assert paused_f.call_count == 1
+
+    def test_pause_unknown_tag_is_noop(self):
+        s = schedule.Scheduler()
+        f = make_mock_job()
+        s.every().second.do(f).tag("a")
+        s.pause("missing")
+        s.resume("missing")
+        with mock_datetime(2100, 1, 1, 0, 0, 0):
+            s.run_pending()
+        assert f.call_count == 1
+
