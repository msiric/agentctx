+
+
+def test_pathlib_paths():
+    from pathlib import Path, PurePosixPath
+
+    assert tomli_w.dumps({"p": PurePosixPath("/a/b")}) == 'p = "/a/b"\n'
+    assert tomli_w.dumps({"p": [Path("a")]}) == 'p = [\n    "a",\n]\n'
+    assert tomli_w.dumps({"t": {"p": Path("x y")}}) == '[t]\np = "x y"\n'
