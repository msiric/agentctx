diff --git a/tests/test_none.py b/tests/test_none.py
new file mode 100644
index 0000000..2a113b4
--- /dev/null
+++ b/tests/test_none.py
@@ -0,0 +1,37 @@
+import tomli_w
+
+
+def test_none_in_table():
+    assert tomli_w.dumps({"a": None, "b": 1}) == 'a = ""\nb = 1\n'
+
+
+def test_none_only():
+    assert tomli_w.dumps({"a": None}) == 'a = ""\n'
+
+
+def test_none_in_nested_table():
+    assert tomli_w.dumps({"t": {"a": None, "b": 1}}) == '[t]\na = ""\nb = 1\n'
+    assert tomli_w.dumps({"t": {"a": None}}) == '[t]\na = ""\n'
+
+
+def test_none_in_inline_table():
+    doc = {"arr": [{"a": None, "b": 1}]}
+    assert tomli_w.dumps(doc) == 'arr = [\n    { a = "", b = 1 },\n]\n'
+
+
+def test_none_in_aot():
+    doc = {"arr": [{"a": None, "b": "x" * 100}]}
+    assert tomli_w.dumps(doc).startswith('[[arr]]\na = ""\nb = ')
+
+
+def test_none_in_array():
+    assert tomli_w.dumps({"a": [1, None, 3]}) == (
+        'a = [\n    1,\n    "",\n    3,\n]\n'
+    )
+    assert tomli_w.dumps({"a": [None]}) == 'a = [\n    "",\n]\n'
+
+
+def test_none_in_nested_array():
+    assert tomli_w.dumps({"a": [[None, 1]]}) == (
+        'a = [\n    [\n        "",\n        1,\n    ],\n]\n'
+    )
