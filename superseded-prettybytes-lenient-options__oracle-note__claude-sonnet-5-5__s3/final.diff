 ```
 
+##### significantDigits
+
+Type: `number`\
+Default: `3`
+
+The number of significant digits to round to. Only applies when neither `minimumFractionDigits` nor `maximumFractionDigits` is set.
+
+Must be an integer between 1 and 100. Any other value is ignored and the default is used. Integer digits are never dropped, so `1337` bytes with `{unit: 'B', significantDigits: 2}` is still `1337 B`.
+
+```js
+import prettyBytes from 'pretty-bytes';
+
+prettyBytes(1337, {significantDigits: 2});
+//=> '1.3 kB'
+
+prettyBytes(1337, {significantDigits: 4});
+//=> '1.337 kB'
+```
+
 ##### space
 
 Type: `boolean`\
diff --git a/test.js b/test.js
index 603f265..e6fb35c 100644
--- a/test.js
+++ b/test.js
@@ -1178,3 +1178,26 @@ test('unit option must belong to the active unit system', t => {
 		t.throws(() => prettyBytes(1337, options), {instanceOf: TypeError});
 	}
 });
+
+test('significantDigits option changes the default rounding', t => {
+	t.is(prettyBytes(1337, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 3}), '1.34 kB');
+	t.is(prettyBytes(1337, {significantDigits: 1}), '1 kB');
+	t.is(prettyBytes(1337n, {significantDigits: 4}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4, locale: 'de'}), '1,337 kB');
+	t.is(prettyBytes(999_999, {significantDigits: 2}), '1 MB');
+	t.is(prettyBytes(123_456, {significantDigits: 1}), '123 kB');
+	t.is(prettyBytes(1337, {unit: 'B', significantDigits: 2}), '1337 B');
+});
+
+test('significantDigits option is ignored when fraction digits are set', t => {
+	t.is(prettyBytes(1337, {significantDigits: 4, maximumFractionDigits: 1}), '1.3 kB');
+	t.is(prettyBytes(1900, {significantDigits: 1, minimumFractionDigits: 3}), '1.900 kB');
+});
+
+test('significantDigits option never throws on a bad value', t => {
+	for (const significantDigits of [0, -1, 101, 1.5, Number.NaN, Infinity, '2', null, {}, true]) {
+		t.is(prettyBytes(1337, {significantDigits}), '1.34 kB');
+	}
+});
