+def _json_key(key: Any) -> str:
+    # The string form json.dumps uses for a dict key
+    if isinstance(key, str):
+        return key
+    if key is True:
+        return 'true'
+    if key is False:
+        return 'false'
+    if key is None:
+        return 'null'
+    return str(key)
+
+
+def _sort_keys(obj: Any) -> Any:
+    # Recursively order dict keys by their JSON string form. Unlike
+    # ``json.dumps(sort_keys=True)`` this copes with mixed key types.
+    if isinstance(obj, dict):
+        return {k: _sort_keys(obj[k]) for k in sorted(obj, key=_json_key)}
+    if isinstance(obj, (list, tuple)):
+        return [_sort_keys(item) for item in obj]
+    return obj
+
+
