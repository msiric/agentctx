diff --git a/test/index.js b/test/index.js
index 37abaa5..85afda9 100644
--- a/test/index.js
+++ b/test/index.js
@@ -328,3 +328,20 @@ test('flag boolean with default string & alias', t => {
 	t.is(typeof baz.two, 'boolean');
 	t.end();
 });
+
+test('opts[--]', t => {
+	t.deepEqual(
+		fn(['a', '--foo', '--', 'b', '--bar', 'c'], { '--': true }),
+		{ _: ['a'], foo: true, '--': ['b', '--bar', 'c'] },
+		'args after -- go to argv[--]'
+	);
+	t.deepEqual(fn(['a', '--foo'], { '--': true }), { _: ['a'], foo: true, '--': [] }, 'empty when no --');
+	t.deepEqual(fn(['a', '--'], { '--': true }), { _: ['a'], '--': [] }, 'trailing -- only');
+	t.deepEqual(fn(['a', '--', 'b'], {}), { _: ['a', 'b'] }, 'unset: goes to _');
+	t.deepEqual(
+		fn(['-x', '1', '--', '-y', '2'], { '--': true, alias: { x: 'ex' } }),
+		{ _: [], x: 1, ex: 1, '--': ['-y', '2'] },
+		'works with alias'
+	);
+	t.end();
+});
