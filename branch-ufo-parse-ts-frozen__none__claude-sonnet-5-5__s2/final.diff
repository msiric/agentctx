+/**
+ * Removes the query section from the URL while preserving the fragment.
+ *
+ * @example
+ *
+ * ```js
+ * withoutQuery("/foo?bar=1#baz"); // "/foo#baz"
+ * ```
+ *
+ * @group utils
+ */
+export function withoutQuery(input: string): string {
+  return stringifyParsedURL({ ...parseURL(input), search: "" });
+}
+
 /**
  * Removes the host from the URL while preserving everything else.
  *
@@ -773,3 +788,39 @@ export function withoutHost(input: string) {
   const parsed = parseURL(input);
   return (parsed.pathname || "/") + parsed.search + parsed.hash;
 }
+
+export interface ParsedDataURL {
+  mimeType: string;
+  base64: boolean;
+  data: string;
+}
+
+/**
+ * Parses a `data:` URL into its mime type, base64 flag and raw data.
+ *
+ * The mime type defaults to `text/plain` when omitted and keeps any parameters
+ * (e.g. `text/plain;charset=utf-8`). The `data` is returned as-is (not decoded).
+ *
+ * @example
+ *
+ * ```js
+ * parseDataURL("data:text/plain;base64,SGVsbG8=");
+ * // { mimeType: "text/plain", base64: true, data: "SGVsbG8=" }
+ * ```
+ *
+ * @group utils
+ */
+export function parseDataURL(input: string): ParsedDataURL {
+  const match = /^data:([^,]*),([\s\S]*)$/i.exec(input.trim());
+  if (!match) {
+    throw new TypeError("Invalid data URL: " + input);
+  }
+  let meta = match[1];
+  let base64 = false;
+  const b64 = /;\s*base64\s*$/i.exec(meta);
+  if (b64) {
+    base64 = true;
+    meta = meta.slice(0, b64.index);
+  }
+  return { mimeType: meta.trim() || "text/plain", base64, data: match[2] };
+}
