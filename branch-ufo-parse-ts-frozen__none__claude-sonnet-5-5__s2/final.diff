+
+describe("parseDataURL", () => {
+  test("base64", () => {
+    expect(parseDataURL("data:text/plain;base64,SGVsbG8=")).toEqual({
+      mimeType: "text/plain",
+      base64: true,
+      data: "SGVsbG8=",
+    });
+  });
+  test("non-base64", () => {
+    expect(parseDataURL("data:text/html,<h1>Hi, there</h1>")).toEqual({
+      mimeType: "text/html",
+      base64: false,
+      data: "<h1>Hi, there</h1>",
+    });
+  });
+  test("default mime type", () => {
+    expect(parseDataURL("data:,Hello")).toEqual({
+      mimeType: "text/plain",
+      base64: false,
+      data: "Hello",
+    });
+    expect(parseDataURL("data:;base64,SGk=")).toEqual({
+      mimeType: "text/plain",
+      base64: true,
+      data: "SGk=",
+    });
+  });
+  test("keeps parameters", () => {
+    expect(parseDataURL("data:text/plain;charset=utf-8;base64,SGk=")).toEqual({
+      mimeType: "text/plain;charset=utf-8",
+      base64: true,
+      data: "SGk=",
+    });
+  });
+  test("throws on invalid input", () => {
+    expect(() => parseDataURL("http://example.com")).toThrow(TypeError);
+    expect(() => parseDataURL("data:text/plain")).toThrow(TypeError);
+  });
+});
