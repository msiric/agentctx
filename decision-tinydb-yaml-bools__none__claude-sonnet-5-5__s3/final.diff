+class YAMLStorage(FileStorage):
+    """
+    Store the data in a YAML file.
+
+    Requires `PyYAML <https://pyyaml.org/>`_ to be installed. Only the safe
+    loader/dumper are used, so no arbitrary Python objects are (de)serialized.
+    """
+
+    def __init__(self, path: str, create_dirs=False, encoding=None, access_mode='r+', **kwargs):
+        """
+        Create a new instance.
+
+        See :class:`FileStorage` for the file handling arguments.
+
+        :param path: Where to store the YAML data.
+        :param kwargs: Extra arguments passed to ``yaml.safe_dump``.
+        """
+
+        try:
+            import yaml
+        except ImportError as e:
+            raise ImportError('YAMLStorage requires PyYAML (pip install pyyaml)') from e
+
+        self._yaml = yaml
+
+        super().__init__(path, create_dirs=create_dirs, encoding=encoding, access_mode=access_mode)
+
+        self.kwargs = kwargs
+
+    def read(self) -> Optional[dict[str, dict[str, Any]]]:
+        self._handle.seek(0)
+
+        # An empty file yields ``None`` so TinyDB can initialize the database
+        return self._yaml.safe_load(self._handle)
+
+    def write(self, data: dict[str, dict[str, Any]]):
+        self._handle.seek(0)
+
+        serialized = self._yaml.safe_dump(_plain(data), **self.kwargs)
+
+        try:
+            self._handle.write(serialized)
+        except io.UnsupportedOperation:
+            raise IOError('Cannot write to the database. Access mode is "{0}"'.format(self._mode))
+
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+
+        # Remove data that is behind the new cursor in case the file has
+        # gotten shorter
+        self._handle.truncate()
+
+
+def _plain(value: Any) -> Any:
+    """
+    Recursively convert ``dict`` subclasses (e.g. ``Document``) to plain
+    dicts, which the YAML safe dumper can represent.
+    """
+
+    if isinstance(value, dict):
+        return {k: _plain(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [_plain(v) for v in value]
+    return value
+
