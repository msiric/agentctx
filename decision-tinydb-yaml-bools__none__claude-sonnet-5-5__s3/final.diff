+def test_yaml_storage(tmpdir):
+    yaml = pytest.importorskip('yaml')
+
+    path = str(tmpdir.join('test.yaml'))
+    storage = YAMLStorage(path)
+    assert storage.read() is None
+
+    storage.write(doc)
+    assert storage.read() == doc
+
+    # Shorter content must not leave leftovers behind
+    storage.write({'a': 1})
+    assert storage.read() == {'a': 1}
+    storage.close()
+
+    with open(path) as f:
+        assert yaml.safe_load(f) == {'a': 1}
+
+
+def test_yaml_storage_with_db(tmpdir):
+    pytest.importorskip('yaml')
+
+    path = str(tmpdir.join('test.yaml'))
+    with TinyDB(path, storage=YAMLStorage) as db:
+        db.insert(doc)
+        db.update({'name': 'foo'})
+        assert db.all() == [{**doc, 'name': 'foo'}]
+        assert db.contains(where('name') == 'foo')
+        assert db.get(doc_id=1) == {**doc, 'name': 'foo'}
+
+    assert '!' not in tmpdir.join('test.yaml').read()
+
+    # Persisted across reopen
+    with TinyDB(path, storage=YAMLStorage) as db:
+        assert len(db) == 1
+        assert db.search(where('int') == 42)
+
+
+def test_yaml_storage_read_only_write(tmpdir):
+    pytest.importorskip('yaml')
+
+    path = str(tmpdir.join('test.yaml'))
+    YAMLStorage(path).close()
+    storage = YAMLStorage(path, access_mode='r')
+    with pytest.raises(IOError):
+        storage.write(doc)
+    storage.close()
