+def test_yaml_storage(tmpdir):
+    pytest.importorskip('yaml')
+
+    path = str(tmpdir.join('test.yaml'))
+    with TinyDB(path, storage=YAMLStorage) as db:
+        db.insert(doc)
+        assert db.all() == [doc]
+        db.update({'name': 'foo'})
+        assert db.contains(where('name') == 'foo')
+
+    assert '!' not in tmpdir.join('test.yaml').read()
+
+    # Persisted data can be read back by a fresh instance
+    with TinyDB(path, storage=YAMLStorage) as db:
+        assert len(db) == 1
+        assert db.get(where('name') == 'foo')['int'] == 42
+
+
+def test_yaml_storage_shrinks_file(tmpdir):
+    pytest.importorskip('yaml')
+
+    path = str(tmpdir.join('test.yaml'))
+    with TinyDB(path, storage=YAMLStorage) as db:
+        db.insert({'text': 'x' * 500})
+        db.truncate()
+
+    with TinyDB(path, storage=YAMLStorage) as db:
+        assert db.all() == []
+
+
+def test_yaml_storage_empty_read(tmpdir):
+    pytest.importorskip('yaml')
+
+    storage = YAMLStorage(str(tmpdir.join('test.yaml')))
+    assert storage.read() is None
+    storage.close()
+
+
+def test_yaml_storage_read_only(tmpdir):
+    pytest.importorskip('yaml')
+
+    path = str(tmpdir.join('test.yaml'))
+    with TinyDB(path, storage=YAMLStorage) as db:
+        db.insert({'a': 1})
+
+    with TinyDB(path, storage=YAMLStorage, access_mode='r') as db:
+        assert db.all() == [{'a': 1}]
+        with pytest.raises(IOError):
+            db.insert({'a': 2})
