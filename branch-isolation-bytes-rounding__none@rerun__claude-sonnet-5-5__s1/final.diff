diff --git a/test/byte-format.js b/test/byte-format.js
index 7e82cee..e627378 100644
--- a/test/byte-format.js
+++ b/test/byte-format.js
@@ -116,4 +116,19 @@ describe('Test byte format function', function(){
     assert.equal(bytes.format(12 * mb, {unit: ''}).toLowerCase(), '12mb');
     assert.equal(bytes.format(12 * mb, {unit: 'bb'}).toLowerCase(), '12mb');
   })
+
+  it('Should not return 1024 in the unit when rounding up', function(){
+    assert.equal(bytes.format(mb - 1), '1MB');
+    assert.equal(bytes.format(-(mb - 1)), '-1MB');
+    assert.equal(bytes.format(gb - 1), '1GB');
+    assert.equal(bytes.format(tb - 1), '1TB');
+    assert.equal(bytes.format(pb - 1), '1PB');
+    assert.equal(bytes.format(mb - 1, {decimalPlaces: 0}), '1MB');
+    assert.equal(bytes.format(mb - 1, {decimalPlaces: 3, fixedDecimals: true}), '1023.999KB');
+    assert.equal(bytes.format(mb - 100), '1023.9KB');
+  });
+
+  it('Should not promote when the unit is explicit', function(){
+    assert.equal(bytes.format(mb - 1, {unit: 'kb'}), '1024kb');
+  });
 });
