+		days: {
+			days: 1, hours: 2, minutes: 3, seconds: 4,
+		},
+		hours: {
+			days: 0, hours: 26, minutes: 3, seconds: 4,
+		},
+		minutes: {
+			days: 0, hours: 0, minutes: 1563, seconds: 4,
+		},
+		seconds: {
+			days: 0, hours: 0, minutes: 0, seconds: 93_784,
+		},
+	};
+
+	for (const [largestUnit, units] of Object.entries(expectations)) {
+		const expected = {
+			...units, milliseconds: 5, microseconds: 0, nanoseconds: 0,
+		};
+		assert.deepStrictEqual(parseMilliseconds(milliseconds, {largestUnit}), expected);
+		assert.deepStrictEqual(
+			parseMilliseconds(BigInt(milliseconds), {largestUnit}),
+			Object.fromEntries(Object.entries(expected).map(([unit, value]) => [unit, BigInt(value)])),
