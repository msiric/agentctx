 ^^^^^^^^^^^^^^^^^^^
 
diff --git a/tests/test_storages.py b/tests/test_storages.py
index 6e433a1..6269a26 100644
--- a/tests/test_storages.py
+++ b/tests/test_storages.py
@@ -285,3 +285,35 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def test_json_sorts_keys_by_default(tmpdir):
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path) as db:
+        db.insert({'b': 1, 'a': 2})
+
+    with open(path) as f:
+        assert f.read() == '{"_default": {"1": {"a": 2, "b": 1}}}'
+
+
+def test_json_sort_keys_can_be_disabled(tmpdir):
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path, sort_keys=False) as db:
+        db.insert({'b': 1, 'a': 2})
+
+    with open(path) as f:
+        assert f.read() == '{"_default": {"1": {"b": 1, "a": 2}}}'
+
+
+def test_json_sort_keys_mixed_key_types(tmpdir):
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path) as db:
+        db.insert({'codes': {500: 'x', 'name': 'y', 200: 'z'}})
+
+    with open(path) as f:
+        assert f.read() == (
+            '{"_default": {"1": {"codes": {"200": "z", "500": "x", "name": "y"}}}}'
+        )
