+def test_yaml_only_true_false_are_booleans(tmpdir):
+    path = tmpdir.join('test.yaml')
+    path.write('a: true\nb: false\nc: NO\nd: yes\ne: off\nf: On\ng: True\nh: n\n')
+    storage = YAMLStorage(str(path))
+    assert storage.read() == {
+        'a': True, 'b': False, 'c': 'NO', 'd': 'yes',
+        'e': 'off', 'f': 'On', 'g': 'True', 'h': 'n',
+    }
+    storage.close()
+
+
+def test_yaml_string_roundtrip(tmpdir):
+    data = {'x': ['NO', 'yes', 'true', 'off', '1', 'null', '']}
+    storage = YAMLStorage(str(tmpdir.join('test.yaml')))
+    storage.write(data)
+    assert storage.read() == data
+    storage.close()
+
+
+def test_yaml_read_only(tmpdir):
+    path = tmpdir.join('test.yaml')
+    path.write('a: 1\n')
+    storage = YAMLStorage(str(path), access_mode='r')
+    assert storage.read() == {'a': 1}
+    with pytest.raises(IOError):
+        storage.write({})
+    storage.close()
+
+
+def test_yaml_with_tinydb(tmpdir):
+    db = TinyDB(str(tmpdir.join('test.yaml')), storage=YAMLStorage)
+    db.insert({'flag': True, 'answer': 'NO'})
+    assert db.all() == [{'flag': True, 'answer': 'NO'}]
+    db.close()
