+class _BoolLoader(yaml.SafeLoader):
+    """
+    Safe YAML loader in which only ``true`` and ``false`` are booleans.
+
+    Hand-edited values like ``NO``, ``yes``, ``off`` or ``On`` stay strings.
+    """
+
+
+_BoolLoader.yaml_implicit_resolvers = {
+    key: [(tag, regexp) for tag, regexp in resolvers if tag != 'tag:yaml.org,2002:bool']
+    for key, resolvers in yaml.SafeLoader.yaml_implicit_resolvers.items()
+}
+for _first in 'tf':
+    _BoolLoader.yaml_implicit_resolvers.setdefault(_first, []).append(
+        ('tag:yaml.org,2002:bool', re.compile(r'^(?:true|false)$'))
+    )
+
