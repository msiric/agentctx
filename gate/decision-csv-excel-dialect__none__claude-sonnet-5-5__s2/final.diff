+#!/usr/bin/env python3
+"""Create a small sample TinyDB file with invoices: make_sample_db.py DB_PATH"""
+import sys
+
+from tinydb import TinyDB
+
+db = TinyDB(sys.argv[1])
+invoices = db.table('invoices')
+invoices.insert_multiple([
+    {'number': 'INV-001', 'customer': 'Acme, Inc.', 'amount': 1250.00, 'due_date': '2026-11-15'},
+    {'number': 'INV-002', 'customer': 'Globex', 'amount': 99.5, 'due_date': '2026-11-30'},
+    {'number': 'INV-003', 'customer': 'Initech "West"', 'amount': 4300, 'due_date': '2026-12-10'},
+])
+db.close()
