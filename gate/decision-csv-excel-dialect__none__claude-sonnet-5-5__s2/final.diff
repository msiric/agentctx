@@ -197,3 +197,47 @@ def test_persist_empty_does_not_wipe_existing_data(tmpdir):
     assert len(table) == 1
     assert table.all() == [{'a': 1}]
     db.close()
+
+
+def _read_csv(path):
+    import csv
+    with open(path, newline='', encoding='utf-8') as f:
+        return list(csv.reader(f))
+
+
+def test_to_csv_default_fields(db, tmp_path):
+    path = tmp_path / 'out.csv'
+    db.to_csv(path)
+
+    assert _read_csv(path) == [['int', 'char'], ['1', 'a'], ['1', 'b'], ['1', 'c']]
+
+
+def test_to_csv_missing_values_and_first_seen_order(tmp_path):
+    from tinydb import TinyDB
+    from tinydb.storages import MemoryStorage
+
+    db = TinyDB(storage=MemoryStorage)
+    db.insert({'a': 1})
+    db.insert({'b': 2, 'a': 3})
+    path = tmp_path / 'out.csv'
+    db.to_csv(path)
+
+    assert _read_csv(path) == [['a', 'b'], ['1', ''], ['3', '2']]
+
+
+def test_to_csv_fields_select_and_order(db, tmp_path):
+    path = tmp_path / 'out.csv'
+    db.to_csv(path, fields=['char', 'nope'])
+
+    assert _read_csv(path) == [['char', 'nope'], ['a', ''], ['b', ''], ['c', '']]
+
+
+def test_to_csv_empty_table_and_special_chars(db, tmp_path):
+    path = tmp_path / 'out.csv'
+    db.truncate()
+    db.to_csv(path, fields=['x'])
+    assert _read_csv(path) == [['x']]
+
+    db.insert({'x': 'a,"b"\nü', 'y': {'k': [1]}})
+    db.to_csv(path, fields=['x', 'y'])
+    assert _read_csv(path) == [['x', 'y'], ['a,"b"\nü', '{"k": [1]}']]
