@@ -0,0 +1,49 @@
+#!/usr/bin/env python3
+"""Export the ``invoices`` table of a TinyDB JSON file to CSV.
+
+Usage: export_invoices.py DB_PATH OUT_CSV
+"""
+import csv
+import json
+import sys
+
+COLUMNS = ['number', 'customer', 'amount', 'due_date']
+
+
+def export_invoices(db_path, out_path):
+    # Read the JSON directly so the database file is never modified.
+    with open(db_path, encoding='utf-8') as f:
+        data = json.load(f)
+
+    if 'invoices' not in data:
+        raise KeyError("no 'invoices' table in %s" % db_path)
+
+    # TinyDB stores a table as {doc_id: document}; sort ids numerically.
+    table = data['invoices']
+    docs = [table[k] for k in sorted(table, key=int)]
+
+    # Excel with a German locale expects ';' as the separator and a UTF-8 BOM
+    # (utf-8-sig) to detect the encoding.
+    with open(out_path, 'w', newline='', encoding='utf-8-sig') as f:
+        writer = csv.DictWriter(f, fieldnames=COLUMNS, extrasaction='ignore',
+                                delimiter=';')
+        writer.writeheader()
+        writer.writerows(docs)
+    return len(docs)
+
+
+def main(argv):
+    if len(argv) != 3:
+        print(__doc__.strip(), file=sys.stderr)
+        return 2
+    try:
+        count = export_invoices(argv[1], argv[2])
+    except (OSError, ValueError, KeyError) as e:
+        print('error: %s' % e, file=sys.stderr)
+        return 1
+    print('Wrote %d invoices to %s' % (count, argv[2]))
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main(sys.argv))
