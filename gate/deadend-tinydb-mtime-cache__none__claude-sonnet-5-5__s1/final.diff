@@ -0,0 +1,85 @@
+"""
+Benchmark TinyDB read performance on a large JSON db file.
+
+Usage: python scripts/bench_read.py [--size-mb 40] [--keep PATH]
+"""
+import argparse
+import cProfile
+import json
+import os
+import pstats
+import random
+import sys
+import tempfile
+import time
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))
+
+from tinydb import TinyDB, where  # noqa: E402
+
+
+def generate(path, size_mb):
+    rng = random.Random(0)
+    docs, size, i = {}, 0, 0
+    target = size_mb * 1024 * 1024
+    while size < target:
+        i += 1
+        doc = {'id': i, 'name': 'user%d' % i, 'group': rng.randrange(100),
+               'score': rng.random(), 'tags': [str(rng.randrange(1000)) for _ in range(5)],
+               'bio': 'x' * rng.randrange(50, 200)}
+        docs[str(i)] = doc
+        size += len(json.dumps(doc)) + 8
+    with open(path, 'w') as f:
+        json.dump({'_default': docs}, f)
+    return len(docs)
+
+
+def timeit(label, fn, n=3):
+    times = []
+    for _ in range(n):
+        t = time.perf_counter()
+        res = fn()
+        times.append(time.perf_counter() - t)
+    print('%-34s min %7.3fs  avg %7.3fs  (%d results)' % (
+        label, min(times), sum(times) / n, len(res)))
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--size-mb', type=float, default=40)
+    ap.add_argument('--keep')
+    ap.add_argument('--profile', action='store_true')
+    a = ap.parse_args()
+
+    path = a.keep or os.path.join(tempfile.mkdtemp(), 'big.json')
+    n = generate(path, a.size_mb)
+    print('db: %d docs, %.1f MB' % (n, os.path.getsize(path) / 1e6))
+
+    db = TinyDB(path)
+    storage = db.storage
+
+    timeit('json.load only (floor)', lambda: [json.load(open(path))] and [], 3)
+    timeit('storage.read()', lambda: storage.read()['_default'], 3)
+    timeit('db.all()', db.all)
+
+    # distinct conditions each time so the query cache can't hit
+    counter = iter(range(10**6))
+    def cold_search():
+        return db.search(where('group') == next(counter) % 100)
+    timeit('db.search (cache miss)', cold_search)
+
+    db.search(where('group') == 5)
+    timeit('db.search (cache hit)', lambda: db.search(where('group') == 5))
+    timeit('db.get(doc_id=1)', lambda: [db.get(doc_id=1)])
+
+    if a.profile:
+        pr = cProfile.Profile()
+        pr.enable()
+        db.search(where('group') == 7777)
+        pr.disable()
+        pstats.Stats(pr).sort_stats('cumulative').print_stats(8)
+    db.close()
+
+
+if __name__ == '__main__':
+    main()
