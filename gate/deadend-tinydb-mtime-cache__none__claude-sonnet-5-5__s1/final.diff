+
+
+def test_json_read_cache_and_external_writes(tmpdir, monkeypatch):
+    import json as json_mod
+    path = str(tmpdir.join('db.json'))
+    db = TinyDB(path)
+    db.insert({'a': 1})
+    db.all()
+
+    parses = []
+    real_load = json_mod.load
+    monkeypatch.setattr(json_mod, 'load', lambda h: parses.append(1) or real_load(h))
+
+    db.all()
+    db.all()
+    assert not parses  # unchanged file is not re-parsed
+
+    other = TinyDB(path)  # simulates the importer process
+    other.insert({'a': 2})
+    other.close()
+
+    assert len(db.all()) == 2
+    assert parses
+    db.close()
