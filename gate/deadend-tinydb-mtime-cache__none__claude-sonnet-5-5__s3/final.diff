+"""Benchmark TinyDB read performance on a large JSON db file.
+
+Usage: python scripts/bench_read.py [--size-mb 40] [--keep]
+"""
+import argparse
+import io
+import json
+import os
+import random
+import string
+import tempfile
+import time
+
+from tinydb import TinyDB, Query
+
+
+def timeit(fn, repeat=3):
+    best = float('inf')
+    for _ in range(repeat):
+        t = time.perf_counter()
+        fn()
+        best = min(best, time.perf_counter() - t)
+    return best
+
+
+def generate(path, size_mb):
+    rnd = random.Random(0)
+    docs = {}
+    i = 0
+    # Write the file directly (much faster than db.insert_multiple).
+    while True:
+        i += 1
+        docs[str(i)] = {
+            'name': ''.join(rnd.choices(string.ascii_letters, k=12)),
+            'age': rnd.randint(0, 99),
+            'email': f'user{i}@example.com',
+            'tags': [rnd.choice(['a', 'b', 'c', 'd']) for _ in range(5)],
+            'address': {'city': rnd.choice(['Berlin', 'Paris', 'Rome']),
+                        'zip': str(rnd.randint(10000, 99999))},
+        }
+        if i % 10000 == 0 and len(json.dumps(docs)) >= size_mb * 1024 * 1024:
+            break
+    with open(path, 'w') as f:
+        json.dump({'_default': docs}, f)
+    return len(docs)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--size-mb', type=float, default=40)
+    ap.add_argument('--keep', action='store_true')
+    args = ap.parse_args()
+
+    path = os.path.join(tempfile.mkdtemp(), 'big.json')
+    n = generate(path, args.size_mb)
+    print(f'{n} docs, {os.path.getsize(path) / 1e6:.1f} MB')
+
+    # Components
+    with open(path) as f:
+        raw = f.read()
+    print(f'file read (str):        {timeit(lambda: open(path).read()):.3f}s')
+    print(f'json.loads (in memory): {timeit(lambda: json.loads(raw)):.3f}s')
+
+    db = TinyDB(path)
+    table = db.table('_default')
+    print(f'storage.read():         {timeit(db.storage.read):.3f}s')
+
+    data = json.loads(raw)['_default']
+    cond = Query().age > 90
+    print(f'filter only (cond):     {timeit(lambda: [d for d in data.values() if cond(d)]):.3f}s')
+
+    print('--- end to end ---')
+    print(f'db.all():               {timeit(db.all):.3f}s')
+    q = Query().age > 90
+    t = time.perf_counter(); r = db.search(q); first = time.perf_counter() - t
+    print(f'db.search() 1st ({len(r)} hits): {first:.3f}s')
+    t = time.perf_counter(); db.search(q); print(f'db.search() repeat (cached): {time.perf_counter() - t:.6f}s')
+    print(f'db.search() new query:  {timeit(lambda: db.search(Query().age == random.randint(0, 99)), 1):.3f}s')
+    print(f'db.get(doc_id=5):       {timeit(lambda: db.get(doc_id=5)):.3f}s')
+    db.close()
+    if not args.keep:
+        os.remove(path)
+
+
+if __name__ == '__main__':
+    main()
