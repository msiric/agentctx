+    def get_jobs_for(self, func: Callable) -> List["Job"]:
+        """
+        Gets scheduled jobs that run the given function, regardless of
+        the arguments they were scheduled with.
+
+        :param func: The function that was passed to
+                     :meth:`Job.do() <Job.do>`
+        """
+        return [
+            job
+            for job in self.jobs
+            if job.job_func is not None and job.job_func.func == func
+        ]
+
+    def pause(self, tag: Hashable) -> None:
+        """
+        Pauses all jobs marked with the given tag. Paused jobs are skipped
+        by :meth:`run_pending() <Scheduler.run_pending>` until resumed.
+        They stay scheduled, and :meth:`run_all() <Scheduler.run_all>`
+        still runs them.
+
+        A job whose scheduled time passes while paused runs (once) on the
+        first ``run_pending()`` after it is resumed.
+
+        :param tag: An identifier used to identify a subset of jobs to pause
+        """
+        for job in self.get_jobs(tag):
+            job.paused = True
+
+    def resume(self, tag: Hashable) -> None:
+        """
+        Resumes all paused jobs marked with the given tag.
+
+        :param tag: An identifier used to identify a subset of jobs to resume
+        """
+        for job in self.get_jobs(tag):
+            job.paused = False
