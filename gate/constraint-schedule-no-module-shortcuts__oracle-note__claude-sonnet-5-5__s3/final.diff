+    def test_get_jobs_for(self):
+        def foo(*args):
+            pass
+
+        def bar():
+            pass
+
+        s = schedule.default_scheduler
+        j1 = every().second.do(foo)
+        j2 = every().minute.do(foo, 1, 2)
+        j3 = every().hour.do(bar)
+        assert s.get_jobs_for(foo) == [j1, j2]
+        assert s.get_jobs_for(bar) == [j3]
+        assert s.get_jobs_for(lambda: None) == []
+        s.cancel_job(j1)
+        assert s.get_jobs_for(foo) == [j2]
+        for job in s.get_jobs_for(foo):
+            s.cancel_job(job)
+        assert s.get_jobs_for(foo) == []
+        assert schedule.default_scheduler.get_jobs_for(bar) == [j3]
+
