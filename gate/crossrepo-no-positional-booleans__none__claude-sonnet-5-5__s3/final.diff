  * @example
  *
  * ```js
@@ -261,15 +263,31 @@ export function withLeadingSlash(input = ""): string {
  *
  * cleanDoubleSlashes("http://example.com/analyze//http://localhost:3000//");
  * // Returns "http://example.com/analyze/http://localhost:3000/"
+ *
+ * cleanDoubleSlashes("/foo//bar?redirect=//baz", true);
+ * // Returns "/foo/bar?redirect=//baz"
  * ```
  *
  * @group utils
  */
-export function cleanDoubleSlashes(input = ""): string {
-  return input
-    .split("://")
-    .map((string_) => string_.replace(/\/{2,}/g, "/"))
-    .join("://");
+export function cleanDoubleSlashes(
+  input = "",
+  respectQueryAndFragment?: boolean,
+): string {
+  let rest = "";
+  if (respectQueryAndFragment) {
+    const index = input.search(/[#?]/);
+    if (index !== -1) {
+      rest = input.slice(index);
+      input = input.slice(0, index);
+    }
+  }
+  return (
+    input
+      .split("://")
+      .map((string_) => string_.replace(/\/{2,}/g, "/"))
+      .join("://") + rest
+  );
 }
 
