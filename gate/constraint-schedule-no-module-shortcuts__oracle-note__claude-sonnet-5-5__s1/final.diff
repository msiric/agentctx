diff --git a/test_schedule.py b/test_schedule.py
index f497826..278611e 100644
--- a/test_schedule.py
+++ b/test_schedule.py
@@ -1569,6 +1569,79 @@ class SchedulerTests(TestCase):
         schedule.clear()
         assert len(schedule.jobs) == 0
 
+    def test_get_jobs_for(self):
+        def foo():
+            pass
+
+        def bar():
+            pass
+
+        class Obj:
+            def method(self):
+                pass
+
+        obj = Obj()
+        sch = schedule.Scheduler()
+        j1 = sch.every().second.do(foo)
+        j2 = sch.every().hour.do(foo)
+        j3 = sch.every().second.do(bar)
+        j4 = sch.every().second.do(obj.method)
+
+        assert sch.get_jobs_for(foo) == [j1, j2]
+        assert sch.get_jobs_for(bar) == [j3]
+        assert sch.get_jobs_for(obj.method) == [j4]
+        assert sch.get_jobs_for(lambda: None) == []
+
+        # arguments don't matter, and cancelling works
+        j5 = sch.every().second.do(bar, 1, x=2)
+        assert sch.get_jobs_for(bar) == [j3, j5]
+        for job in sch.get_jobs_for(bar):
+            sch.cancel_job(job)
+        assert sch.get_jobs_for(bar) == []
+        assert sch.get_jobs_for(foo) == [j1, j2]
+
+    def test_get_jobs_for_scheduler_instance(self):
+        def foo():
+            pass
+
+        s1, s2 = schedule.Scheduler(), schedule.Scheduler()
+        job = s1.every().second.do(foo)
+        assert s1.get_jobs_for(foo) == [job]
+        assert s2.get_jobs_for(foo) == []
+
+    def test_pause_and_resume_by_tag(self):
+        sch = schedule.Scheduler()
+        a, b = make_mock_job(name="a"), make_mock_job(name="b")
+        with mock_datetime(2010, 1, 6, 12, 15, 0):
+            ja = sch.every().second.do(a).tag("maint")
+            jb = sch.every().second.do(b).tag("other")
+            sch.pause("maint")
+        assert ja.paused and not jb.paused
+        assert sch.get_jobs("maint") == [ja]  # still registered
+
+        with mock_datetime(2010, 1, 6, 12, 15, 5):
+            sch.run_pending()
+            assert a.call_count == 0
+            assert b.call_count == 1
+
+            sch.resume("maint")
+            assert not ja.paused
+            sch.run_pending()
+            assert a.call_count == 0  # rescheduled from now, no catch-up burst
+
+        with mock_datetime(2010, 1, 6, 12, 15, 7):
+            sch.run_pending()
+            assert a.call_count == 1
+
+    def test_pause_unknown_tag_and_resume_unpaused(self):
+        sch = schedule.Scheduler()
+        job = sch.every().second.do(make_mock_job()).tag("t")
+        sch.pause("nope")
+        sch.resume("nope")
+        old = job.next_run
+        sch.resume("t")  # not paused: untouched
+        assert job.next_run == old
+
     def test_clear_by_tag(self):
         every().second.do(make_mock_job(name="job1")).tag("tag1")
         every().second.do(make_mock_job(name="job2")).tag("tag1", "tag2")
