+    def get_jobs_for(self, func: Callable) -> List["Job"]:
+        """
+        Gets scheduled jobs that run the given function, regardless of
+        the arguments they were scheduled with.
+
+        :param func: The callable that was passed to :meth:`Job.do`
+        """
+        return [
+            job
+            for job in self.jobs
+            if job.job_func is not None
+            and getattr(job.job_func, "__wrapped__", None) == func
+        ]
+
+    def pause(self, tag: Hashable) -> None:
+        """
+        Pause all jobs marked with the given tag. Paused jobs are skipped
+        by :meth:`run_pending` until :meth:`resume` is called. They stay
+        registered, so they don't need to be cancelled and re-added.
+
+        :param tag: An identifier used to identify a subset of
+                    jobs to pause
+        """
+        logger.debug('Pausing all jobs tagged "%s"', tag)
+        for job in self.get_jobs(tag):
+            job.paused = True
+
+    def resume(self, tag: Hashable) -> None:
+        """
+        Resume all paused jobs marked with the given tag. Runs that were
+        missed while paused are not made up: each resumed job is
+        rescheduled from now.
+
+        :param tag: An identifier used to identify a subset of
+                    jobs to resume
+        """
+        logger.debug('Resuming all jobs tagged "%s"', tag)
+        for job in self.get_jobs(tag):
+            if job.paused:
+                job.paused = False
+                job._schedule_next_run()
+
