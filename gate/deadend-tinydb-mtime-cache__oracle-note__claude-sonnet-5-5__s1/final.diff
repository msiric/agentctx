+"""Benchmark TinyDB read performance on a large JSON db.
+
+Usage: python scripts/bench_read.py [--size-mb 40] [--repeat 3] [--profile]
+"""
+import argparse
+import cProfile
+import json
+import os
+import pstats
+import random
+import string
+import tempfile
+import time
+
+from tinydb import TinyDB, where
+from tinydb.storages import JSONStorage
+
+
+def generate(path, size_mb):
+    rnd = random.Random(0)
+    docs, n = {}, 0
+    target = size_mb * 1024 * 1024
+    approx = 0
+    while approx < target:
+        n += 1
+        doc = {
+            'name': ''.join(rnd.choices(string.ascii_letters, k=12)),
+            'age': rnd.randint(0, 99),
+            'tags': [rnd.choice(['a', 'b', 'c', 'd']) for _ in range(5)],
+            'bio': ''.join(rnd.choices(string.ascii_lowercase + ' ', k=100)),
+        }
+        docs[str(n)] = doc
+        approx += 180
+    with open(path, 'w') as f:
+        json.dump({'_default': docs}, f)
+    return n
+
+
+def timeit(label, fn, repeat):
+    times = []
+    for _ in range(repeat):
+        t = time.perf_counter()
+        result = fn()
+        times.append(time.perf_counter() - t)
+    print(f'{label:<34} min {min(times)*1000:8.1f} ms   '
+          f'avg {sum(times)/len(times)*1000:8.1f} ms   ({len(result)} results)')
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--size-mb', type=int, default=40)
+    ap.add_argument('--repeat', type=int, default=3)
+    ap.add_argument('--profile', action='store_true')
+    args = ap.parse_args()
+
+    with tempfile.TemporaryDirectory() as d:
+        path = os.path.join(d, 'db.json')
+        n = generate(path, args.size_mb)
+        print(f'{n} docs, {os.path.getsize(path)/1e6:.1f} MB')
+
+        with open(path) as f:
+            t = time.perf_counter()
+            json.load(f)
+            print(f'{"raw json.load baseline":<34} {(time.perf_counter()-t)*1000:8.1f} ms')
+
+        db = TinyDB(path, storage=JSONStorage)
+        timeit('db.all()', db.all, args.repeat)
+
+        def search():
+            db.clear_cache()  # defeat query cache: measure real cost
+            return db.search(where('age') == 42)
+        timeit('db.search (cache cleared)', search, args.repeat)
+
+        db.search(where('age') == 7)
+        timeit('db.search (cache hit)', lambda: db.search(where('age') == 7), args.repeat)
+
+        if args.profile:
+            db.clear_cache()
+            pr = cProfile.Profile()
+            pr.enable()
+            db.search(where('age') == 42)
+            pr.disable()
+            pstats.Stats(pr).sort_stats('cumulative').print_stats(8)
+        db.close()
+
+
+if __name__ == '__main__':
+    main()
