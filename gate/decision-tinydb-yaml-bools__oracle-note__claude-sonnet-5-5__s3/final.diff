+class YAMLStorage(_FileStorage):
+    """
+    Store the data in a YAML file.
+
+    Requires PyYAML. Only the lowercase literals ``true`` and ``false`` are
+    loaded as booleans; values such as ``yes``, ``NO``, ``on`` or ``Off`` are
+    loaded as strings.
+    """
+
+    def __init__(self, path: str, create_dirs=False, encoding=None, access_mode='r+', **kwargs):
+        """
+        Create a new instance.
+
+        See :class:`_FileStorage` for the file handling arguments.
+
+        :param path: Where to store the YAML data.
+        :param kwargs: Extra arguments passed to ``yaml.safe_dump``.
+        """
+
+        import yaml  # imported lazily: PyYAML is an optional dependency
+
+        self._yaml = yaml
+        self._loader = _make_yaml_loader(yaml)
+
+        super().__init__(path, create_dirs=create_dirs, encoding=encoding, access_mode=access_mode)
+
+        self.kwargs = kwargs
+
+    def read(self) -> Optional[dict[str, dict[str, Any]]]:
+        self._handle.seek(0, os.SEEK_END)
+        if not self._handle.tell():
+            return None
+
+        self._handle.seek(0)
+
+        # ``self._loader`` is a SafeLoader subclass, so this stays safe
+        return self._yaml.load(self._handle, Loader=self._loader)  # noqa: S506
+
+    def write(self, data: dict[str, dict[str, Any]]):
+        self._handle.seek(0)
+
+        options = {'default_flow_style': False, 'allow_unicode': True}
+        options.update(self.kwargs)
+        serialized = self._yaml.safe_dump(data, **options)
+
+        try:
+            self._handle.write(serialized)
+        except io.UnsupportedOperation:
+            raise IOError('Cannot write to the database. Access mode is "{0}"'.format(self._mode))
+
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+        self._handle.truncate()
+
+
+_YAML_LOADER = None
+
+
+def _make_yaml_loader(yaml):
+    """
+    Build (once) a ``SafeLoader`` subclass in which only ``true``/``false``
+    resolve to booleans.
+    """
+    global _YAML_LOADER
+    if _YAML_LOADER is not None:
+        return _YAML_LOADER
+
+    bool_tag = 'tag:yaml.org,2002:bool'
+
+    class _Loader(yaml.SafeLoader):
+        pass
+
+    # Copy the resolver table so SafeLoader itself is left untouched
+    _Loader.yaml_implicit_resolvers = {
+        first: [(tag, regexp) for tag, regexp in resolvers if tag != bool_tag]
+        for first, resolvers in yaml.SafeLoader.yaml_implicit_resolvers.items()
+    }
+    _Loader.add_implicit_resolver(bool_tag, re.compile(r'^(?:true|false)$'), list('tf'))
+
+    _YAML_LOADER = _Loader
+    return _Loader
+
