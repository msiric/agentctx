+describe('format(number, { compound: true })', () => {
+  it('combines units, largest first', () => {
+    expect(format(5400000, { compound: true })).toBe('1h 30m');
+    expect(format(93784000, { compound: true })).toBe('1d 2h 3m 4s');
+  });
+
+  it('skips zero parts', () => {
+    expect(format(3605000, { compound: true })).toBe('1h 5s');
+    expect(format(86400000, { compound: true })).toBe('1d');
+  });
+
+  it('stops at days', () => {
+    expect(format(40 * 86400000, { compound: true })).toBe('40d');
+  });
+
+  it('drops leftover milliseconds', () => {
+    expect(format(1999, { compound: true })).toBe('1s');
+    expect(format(999, { compound: true })).toBe('0s');
+  });
+
+  it('handles negative values', () => {
+    expect(format(-5400000, { compound: true })).toBe('-1h 30m');
+    expect(format(-500, { compound: true })).toBe('0s');
