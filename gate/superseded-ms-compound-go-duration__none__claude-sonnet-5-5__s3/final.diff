+
+  it('handles zero and unit boundaries', () => {
+    expect(format(0, { compound: true })).toBe('0s');
+    expect(format(1000, { compound: true })).toBe('1s');
+    expect(format(59999, { compound: true })).toBe('59s');
+    expect(format(60000, { compound: true })).toBe('1m');
+    expect(format(3600000, { compound: true })).toBe('1h');
+    expect(format(86399000, { compound: true })).toBe('23h 59m 59s');
+  });
+
+  it('handles fractional milliseconds', () => {
+    expect(format(1500.7, { compound: true })).toBe('1s');
+  });
+
+  it('handles negative values with several parts', () => {
+    expect(format(-93784000, { compound: true })).toBe('-1d 2h 3m 4s');
