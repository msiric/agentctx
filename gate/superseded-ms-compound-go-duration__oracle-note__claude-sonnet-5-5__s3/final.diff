+describe('format(number, { compound: true })', () => {
+  it('should combine units, largest first, without separators', () => {
+    expect(format(5400000, { compound: true })).toBe('1h30m');
+    expect(format(3661000, { compound: true })).toBe('1h1m1s');
+  });
+
+  it('should skip zero parts', () => {
+    expect(format(3600000 + 5000, { compound: true })).toBe('1h5s');
+    expect(format(2 * 3600000, { compound: true })).toBe('2h');
+  });
+
+  it('should drop leftover milliseconds', () => {
+    expect(format(1999, { compound: true })).toBe('1s');
+    expect(format(500, { compound: true })).toBe('0s');
+    expect(format(-500, { compound: true })).toBe('0s');
+  });
+
+  it('should use hours as the largest unit (Go ParseDuration compatible)', () => {
+    expect(format(90061000, { compound: true })).toBe('25h1m1s');
+    expect(format(25 * 3600000 + 30 * 60000, { compound: true })).toBe(
+      '25h30m',
+    );
+    expect(format(400 * 86400000, { compound: true })).toBe('9600h');
+  });
+
+  it('should prefix negative values with -', () => {
+    expect(format(-5400000, { compound: true })).toBe('-1h30m');
+  });
+
+  it('should only emit tokens matching Go duration syntax', () => {
+    for (const v of [0, 999, 61000, 90061000, -90061000, 1e12]) {
+      expect(format(v, { compound: true })).toMatch(/^-?(\d+[hms])+$/);
+    }
+  });
+
+  it('should be ignored when long is set', () => {
+    expect(format(5400000, { compound: true, long: true })).toBe('2 hours');
+  });
+});
