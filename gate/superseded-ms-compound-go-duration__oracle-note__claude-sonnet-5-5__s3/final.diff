+/**
+ * Compound short format for `ms`, e.g. `1h30m`.
+ * Compatible with Go's `time.ParseDuration` (no separators, hours largest).
+ */
+function fmtCompound(ms: number): string {
+  let rest = Math.trunc(Math.abs(ms) / s);
+  const parts: string[] = [];
+  for (const [size, name] of [
+    [h / s, 'h'],
+    [m / s, 'm'],
+    [1, 's'],
+  ] as const) {
+    const count = Math.floor(rest / size);
+    rest -= count * size;
+    if (count > 0) {
+      parts.push(`${count}${name}`);
+    }
+  }
+  if (parts.length === 0) {
+    return '0s';
+  }
+  return (ms < 0 ? '-' : '') + parts.join('');
+}
