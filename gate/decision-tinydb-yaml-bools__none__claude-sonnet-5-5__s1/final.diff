+def test_yaml(tmpdir):
+    path = str(tmpdir.join('test.yaml'))
+    storage = YAMLStorage(path)
+    assert storage.read() is None
+
+    storage.write(doc)
+    assert doc == storage.read()
+
+    # Shrinking the data must not leave trailing garbage behind
+    storage.write({'a': 1})
+    assert storage.read() == {'a': 1}
+    storage.close()
+
+    with open(path) as f:
+        assert f.read() == 'a: 1\n'
+
+
+def test_yaml_kwargs(tmpdir):
+    path = str(tmpdir.join('test.yaml'))
+    storage = YAMLStorage(path, default_flow_style=True)
+    storage.write({'a': [1, 2]})
+    storage.close()
+
+    with open(path) as f:
+        assert f.read().strip() == '{a: [1, 2]}'
+
+
+def test_yaml_create_dirs(tmpdir):
+    path = str(tmpdir.join('sub', 'test.yaml'))
+    with pytest.raises(IOError):
+        YAMLStorage(path)
+
+    YAMLStorage(path, create_dirs=True).close()
+    assert os.path.exists(path)
+
+
+def test_yaml_read_only(tmpdir):
+    path = str(tmpdir.join('test.yaml'))
+    with open(path, 'w') as f:
+        f.write('a: 1\n')
+
+    storage = YAMLStorage(path, access_mode='r')
+    assert storage.read() == {'a': 1}
+    with pytest.raises(IOError):
+        storage.write({'a': 2})
+    storage.close()
+
+
+def test_yaml_rejects_unsafe_tags(tmpdir):
+    import yaml
+
+    path = str(tmpdir.join('test.yaml'))
+    with open(path, 'w') as f:
+        f.write('a: !!python/object/apply:os.getcwd []\n')
+
+    storage = YAMLStorage(path)
+    with pytest.raises(yaml.YAMLError):
+        storage.read()
+    storage.close()
+
+
+def test_yaml_with_tinydb(tmpdir):
+    path = str(tmpdir.join('test.yaml'))
+
+    with TinyDB(path, storage=YAMLStorage) as db:
+        db.insert({'name': 'a', 'n': 1})
+        db.insert_multiple([{'name': 'b', 'n': 2}, {'name': 'c', 'n': 3}])
+        db.update({'n': 20}, where('name') == 'b')
+        db.remove(where('name') == 'c')
+        db.table('other').insert({'x': 1})
+
+    with TinyDB(path, storage=YAMLStorage) as db:
+        assert db.all() == [{'name': 'a', 'n': 1}, {'name': 'b', 'n': 20}]
+        assert db.get(doc_id=2) == {'name': 'b', 'n': 20}
+        assert db.table('other').all() == [{'x': 1}]
