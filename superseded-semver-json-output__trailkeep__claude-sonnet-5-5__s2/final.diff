+import io
 from argparse import Namespace
 from contextlib import contextmanager
 from unittest.mock import patch
@@ -155,3 +156,94 @@ def test_should_return_documented_error_code_for_invalid_version(cliargs, capsys
     # docs/pysemver.rst shows ``echo $?`` printing 2 for both commands
     assert main(cliargs) == 2
     assert capsys.readouterr().err.startswith("ERROR")
+
+
+def test_sort_parses_versions():
+    args = createparser().parse_args(["sort", "1.2.3", "1.0.0"])
+    assert args.versions == ["1.2.3", "1.0.0"]
+
+
+def test_sort_prints_one_version_per_line_oldest_first(capsys):
+    assert main(["sort", "1.10.0", "1.2.0", "1.2.0-rc1", "0.9.0+build"]) == 0
+    out = capsys.readouterr()
+    assert out.out == "0.9.0+build\n1.2.0-rc1\n1.2.0\n1.10.0\n"
+    assert out.err == ""
+
+
+def test_sort_single_version(capsys):
+    assert main(["sort", "1.2.3"]) == 0
+    assert capsys.readouterr().out == "1.2.3\n"
+
+
+def test_sort_invalid_version_prints_nothing_on_stdout(capsys):
+    assert main(["sort", "1.2.3", "1.x"]) == 2
+    out = capsys.readouterr()
+    assert out.out == ""
+    assert "ERROR" in out.err
+
+
+def test_sort_reads_stdin_without_arguments(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO("1.10.0\n\n  \n1.2.0-rc1\n1.2.0\n"))
+    assert main(["sort"]) == 0
+    assert capsys.readouterr().out == "1.2.0-rc1\n1.2.0\n1.10.0\n"
+
+
+def test_sort_ignores_stdin_when_arguments_given(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO("9.9.9\n"))
+    assert main(["sort", "2.0.0", "1.0.0"]) == 0
+    assert capsys.readouterr().out == "1.0.0\n2.0.0\n"
+
+
+def test_sort_invalid_version_on_stdin_is_error(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO("1.2.3\nnope\n"))
+    assert main(["sort"]) == 2
+    out = capsys.readouterr()
+    assert out.out == ""
+    assert "ERROR" in out.err
+
+
+def test_latest_parses_versions():
