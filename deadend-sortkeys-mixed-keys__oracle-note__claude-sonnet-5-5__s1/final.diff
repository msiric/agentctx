+def _json_key(key: Any) -> str:
+    # The string form ``json.dumps`` would produce for a dict key
+    if isinstance(key, str):
+        return key
+    return json.dumps(key) if key is None or isinstance(key, (bool, float)) \
+        else str(key)
+
+
+def _sort_keys_recursive(obj: Any) -> Any:
+    """
+    Return a copy of ``obj`` with all dict keys sorted.
+
+    Unlike ``json.dumps(sort_keys=True)`` this copes with mixed key types
+    (e.g. ``int`` and ``str``) by sorting on the keys' JSON string form.
+    """
+    if isinstance(obj, dict):
+        return {k: _sort_keys_recursive(obj[k])
+                for k in sorted(obj, key=_json_key)}
+    if isinstance(obj, (list, tuple)):
+        return [_sort_keys_recursive(v) for v in obj]
+    return obj
+
+
