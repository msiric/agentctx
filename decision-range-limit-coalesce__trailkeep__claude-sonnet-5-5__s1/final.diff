-  return options && options.combine
-    ? combineRanges(ranges)
-    : ranges
+  if (options && options.combine) {
+    ranges = combineRanges(ranges)
+  }
+
+  if (options && options.limit >= 1 && ranges.length > options.limit) {
+    ranges = coverRanges(ranges)
+  }
+
+  return ranges
+}
+
+/**
+ * Merge all ranges into one range, from the lowest start to the highest end.
+ * @private
+ */
+
+function coverRanges (ranges) {
+  var start = ranges[0].start
+  var end = ranges[0].end
+
+  for (var i = 1; i < ranges.length; i++) {
+    if (ranges[i].start < start) start = ranges[i].start
+    if (ranges[i].end > end) end = ranges[i].end
+  }
+
+  var covering = [{ start: start, end: end }]
+
+  // copy ranges type
+  covering.type = ranges.type
+
+  return covering
 }
 
