+describe('compound edge cases', () => {
+  it('formats zero', () => {
+    expect(format(0, { compound: true })).toBe('0s');
+  });
+  it('formats exact units without trailing parts', () => {
+    expect(format(60000, { compound: true })).toBe('1m');
+    expect(format(86400000, { compound: true })).toBe('1d');
+  });
+  it('truncates negative leftover milliseconds', () => {
+    expect(format(-1999, { compound: true })).toBe('-1s');
+    expect(format(-999, { compound: true })).toBe('0s');
+  });
+  it('is ignored when long is set', () => {
+    expect(format(5400000, { long: true, compound: true })).toBe('2 hours');
+  });
+  it('works through ms()', () => {
+    expect(ms(5400000, { compound: true })).toBe('1h 30m');
+  });
+  it('behaves like the default format when false', () => {
+    expect(format(5400000, { compound: false })).toBe(format(5400000));
+  });
+  it('does not roll days into larger units', () => {
+    expect(format(400 * 86400000, { compound: true })).toBe('400d');
+  });
+  it('rejects non-finite values', () => {
+    expect(() => format(NaN, { compound: true })).toThrow();
+    expect(() => format(Infinity, { compound: true })).toThrow();
+  });
+});
