diff --git a/tests/test_cli.py b/tests/test_cli.py
index f33b534..c9c3910 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -235,3 +235,28 @@ def test_cli_outfile_keeps_file_on_format_error(tmpdir, capsys):
     assert out_file.read() == "select 1"
     _, err = capsys.readouterr()
     assert err.startswith("[ERROR] Failed to format")
+
+
+def test_check_reports_changed_files_and_writes_nothing(tmp_path, capsys):
+    bad = tmp_path / 'bad.sql'
+    good = tmp_path / 'good.sql'
+    bad.write_text('select * from foo')
+    good.write_text('SELECT * FROM foo')
+    rc = sqlparse.cli.main(['--check', '-k', 'upper', str(bad), str(good)])
+    out = capsys.readouterr().out
+    assert rc == 1
+    assert out.splitlines() == [str(bad)]
+    assert bad.read_text() == 'select * from foo'
+
+
+def test_check_clean_exits_zero(tmp_path, capsys):
+    good = tmp_path / 'good.sql'
+    good.write_text('SELECT * FROM foo')
+    assert sqlparse.cli.main(['--check', '-k', 'upper', str(good)]) == 0
+    assert capsys.readouterr().out == ''
+
+
+def test_check_incompatible_with_inplace(tmp_path):
+    f = tmp_path / 'a.sql'
+    f.write_text('select 1')
+    assert sqlparse.cli.main(['--check', '--in-place', str(f)]) == 1
diff --git a/tests/test_keywords.py b/tests/test_keywords.py
index b26e9b4..f2bd37a 100644
--- a/tests/test_keywords.py
+++ b/tests/test_keywords.py
@@ -1,5 +1,6 @@
 import pytest
 
+import sqlparse
 from sqlparse import tokens
 from sqlparse.lexer import Lexer
 
@@ -11,3 +12,11 @@ class TestSQLREGEX:
     def test_float_numbers(self, number):
         ttype = next(tt for action, tt in Lexer.get_default_instance()._SQL_REGEX if action(number))
         assert tokens.Number.Float == ttype
+
+
+@pytest.mark.parametrize('kw', [
+    'exclude', 'match_recognize', 'asof', 'match_condition'])
+def test_snowflake_keywords(kw):
+    flat = list(sqlparse.parse(kw)[0].flatten())
+    assert flat[0].ttype is tokens.Keyword
+    assert sqlparse.format(kw, keyword_case='upper') == kw.upper()
