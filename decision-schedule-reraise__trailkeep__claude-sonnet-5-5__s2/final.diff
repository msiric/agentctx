+    def test_run_pending_failing_jobs(self):
+        calls = []
+
+        def ok():
+            calls.append("ok")
+
+        def bad1():
+            calls.append("bad1")
+            raise ValueError("first")
+
+        def bad2():
+            calls.append("bad2")
+            raise KeyError("second")
+
+        with mock_datetime(2010, 1, 6, 12, 15, 0):
+            schedule.every().second.do(ok)
+            schedule.every().second.do(bad1)
+            schedule.every().second.do(ok)
+            schedule.every().second.do(bad2)
+        with mock_datetime(2010, 1, 6, 12, 15, 5):
+            with self.assertRaises(ValueError):
+                schedule.run_pending()
+        assert sorted(calls) == ["bad1", "bad2", "ok", "ok"]
+
+    def test_run_pending_single_failure(self):
+        ran = []
+        with mock_datetime(2010, 1, 6, 12, 15, 0):
+            schedule.every().second.do(lambda: 1 / 0)
+            schedule.every().second.do(lambda: ran.append(1))
+        with mock_datetime(2010, 1, 6, 12, 15, 5):
+            with self.assertRaises(ZeroDivisionError):
+                schedule.run_pending()
+        assert ran == [1]
