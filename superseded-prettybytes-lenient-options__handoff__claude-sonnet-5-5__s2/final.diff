+##### significantDigits
+
+Type: `number`\
+Default: `3`
+
+The number of significant digits to round to. Must be an integer between 1 and 100; any other value is ignored and the default is used.
+
+Has no effect when `minimumFractionDigits` or `maximumFractionDigits` is set.
+
+```js
+import prettyBytes from 'pretty-bytes';
+
+prettyBytes(1337, {significantDigits: 2});
+//=> '1.3 kB'
+
+prettyBytes(1337, {significantDigits: 4});
+//=> '1.337 kB'
+```
+
 ##### locale
 
 Type: `boolean | string | string[]`\
diff --git a/test.js b/test.js
index 861c45c..b4643c5 100644
--- a/test.js
+++ b/test.js
@@ -1178,3 +1178,23 @@ test('unit outside the active unit system throws', t => {
 	t.throws(() => prettyBytes(1, {unit: 5}), {instanceOf: TypeError});
 	t.throws(() => prettyBytes(1, {unit: null}), {instanceOf: TypeError});
 });
+
+test('significantDigits changes the default rounding', t => {
+	t.is(prettyBytes(1337, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 1}), '1 kB');
+	t.is(prettyBytes(123_456, {significantDigits: 1}), '123 kB');
+	t.is(prettyBytes(999_999, {significantDigits: 2}), '1 MB');
+	t.is(prettyBytes(1337, {significantDigits: 4, locale: 'de'}), '1,337 kB');
+});
+
+test('significantDigits is ignored when fraction digit options are set', t => {
+	t.is(prettyBytes(1337, {significantDigits: 1, maximumFractionDigits: 2}), '1.33 kB');
+	t.is(prettyBytes(1900, {significantDigits: 1, minimumFractionDigits: 3}), '1.900 kB');
+});
+
+test('an invalid significantDigits falls back to the default', t => {
+	for (const value of [0, -1, 1.5, 101, Number.NaN, '2', null, Number.POSITIVE_INFINITY]) {
+		t.is(prettyBytes(1337, {significantDigits: value}), '1.34 kB');
+	}
+});
