            raise

        # Persist the rename itself (not supported on all platforms)
        try:
            dir_fd = os.open(directory, os.O_RDONLY)
        except OSError:
            pass
        else:
            try:
                os.fsync(dir_fd)
            except OSError:
                pass
            finally:
                os.close(dir_fd)

        # The old handle still points at the replaced file, so reopen it
        self._handle.close()
        self._handle = open(target, mode=self._mode, encoding=self._encoding)


