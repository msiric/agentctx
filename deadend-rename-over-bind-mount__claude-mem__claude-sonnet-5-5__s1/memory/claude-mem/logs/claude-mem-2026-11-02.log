            raise IOError('Cannot write to the database. Access mode is "{0}"'.format(self._mode))

        # Crash-safe write: write the new state to a temporary file in the same
        # directory, fsync it and atomically rename it over the database file.
        # At any point a crash leaves either the old or the new file intact.
        # Resolve symlinks so the link itself is preserved.
        target = os.path.realpath(self._path)
        directory = os.path.dirname(target)
        fd, tmp_path = tempfile.mkstemp(dir=directory, prefix='.tmp-', suffix='.json')
