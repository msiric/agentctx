--- a/tests/test_storages.py
+++ b/tests/test_storages.py
@@ -285,3 +285,62 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def test_json_write_is_atomic(tmpdir, monkeypatch):
+    path = str(tmpdir.join('db.json'))
+    storage = JSONStorage(path)
+    storage.write({'_default': {'1': {'a': 1}}})
+
+    # Simulate a crash in the middle of the write: the temp file is partially
+    # written and the process dies before the rename happens.
+    def crash(*args, **kwargs):
+        raise KeyboardInterrupt('simulated kill')
+
+    monkeypatch.setattr(os, 'replace', crash)
+    with pytest.raises(KeyboardInterrupt):
+        storage.write({'_default': {'1': {'a': 2}}})
+    monkeypatch.undo()
+    storage.close()
+
+    # Old state is intact, readable, and no temp files are left behind
+    with open(path) as f:
+        assert json.load(f) == {'_default': {'1': {'a': 1}}}
+    assert os.listdir(str(tmpdir)) == ['db.json']
+
+
+def test_json_write_serialization_error_keeps_data(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+        with pytest.raises(TypeError):
+            db.insert({'b': object()})
+
+    with TinyDB(path) as db:
+        assert db.all() == [{'a': 1}]
+
+
+def test_json_write_then_read_and_reopen(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+        db.insert({'a': 2})
+        assert len(db) == 2
+    with TinyDB(path) as db:
+        assert len(db) == 2
+
+
+@pytest.mark.skipif(os.name == 'nt', reason='symlinks/permissions')
+def test_json_write_preserves_symlink_and_mode(tmpdir):
+    real = tmpdir.join('real.json')
+    link = tmpdir.join('link.json')
+    real.write('')
+    os.chmod(str(real), 0o640)
+    os.symlink(str(real), str(link))
+
+    with TinyDB(str(link)) as db:
+        db.insert({'a': 1})
+
+    assert os.path.islink(str(link))
+    assert os.stat(str(real)).st_mode & 0o777 == 0o640
+    assert json.loads(real.read())['_default']['1'] == {'a': 1}
