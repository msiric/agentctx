+
+
+def test_to_csv_fields(db, tmpdir):
+    import csv
+
+    db.truncate()
+    db.insert({'a': 1, 'b': 'x', 'c': 'y,"z"'})
+    path = str(tmpdir.join('out.csv'))
+
+    db.to_csv(path, fields=['c', 'a', 'missing'])
+
+    with open(path, newline='', encoding='utf-8') as f:
+        rows = list(csv.reader(f))
+    assert rows == [['c', 'a', 'missing'], ['y,"z"', '1', '']]
+
+
+def test_to_csv_empty_table(db, tmpdir):
+    path = str(tmpdir.join('out.csv'))
+    db.truncate()
+
+    db.to_csv(path, fields=['a'])
+
+    with open(path, newline='', encoding='utf-8') as f:
+        assert f.read() == 'a\r\n'
