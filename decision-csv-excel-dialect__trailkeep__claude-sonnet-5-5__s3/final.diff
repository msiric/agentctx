diff --git a/scripts/export_invoices.py b/scripts/export_invoices.py
new file mode 100644
index 0000000..695a075
--- /dev/null
+++ b/scripts/export_invoices.py
@@ -0,0 +1,46 @@
+#!/usr/bin/env python3
+"""Export the ``invoices`` table of a TinyDB JSON file to CSV.
+
+The output uses semicolons and a UTF-8 BOM so it opens correctly in Excel with
+a German locale.
+
+Usage: export_invoices.py DB_PATH OUT_CSV
+"""
+import csv
+import json
+import sys
+
+COLUMNS = ["number", "customer", "amount", "due_date"]
+TABLE = "invoices"
+
+
+def main(argv):
+    if len(argv) != 3:
+        print(f"usage: {argv[0]} DB_PATH OUT_CSV", file=sys.stderr)
+        return 2
+
+    db_path, out_path = argv[1], argv[2]
+    with open(db_path, encoding="utf-8") as f:
+        data = json.load(f)
+
+    if TABLE not in data:
+        print(f"error: no '{TABLE}' table in {db_path}", file=sys.stderr)
+        return 1
+
+    # TinyDB stores a table as {doc_id: document}; order by numeric doc id.
+    docs = sorted(data[TABLE].items(), key=lambda kv: int(kv[0]))
+
+    with open(out_path, "w", newline="", encoding="utf-8-sig") as f:
+        writer = csv.DictWriter(
+            f, fieldnames=COLUMNS, extrasaction="ignore", delimiter=";"
+        )
+        writer.writeheader()
+        for _, doc in docs:
+            writer.writerow({c: doc.get(c, "") for c in COLUMNS})
+
+    print(f"wrote {len(docs)} invoices to {out_path}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
