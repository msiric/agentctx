+def gigabytes(num_bytes: float | str, precision: int = 1) -> str:
+    """Format a number of bytes as decimal gigabytes (10**9 bytes).
+
+    Rounds half up (away from zero) to match billing's invoice generator,
+    rather than Python's default round-half-even.
+
+    Examples:
+        ```pycon
+        >>> gigabytes(1500000000)
+        '1.5 GB'
+        >>> gigabytes(0)
+        '0.0 GB'
+        >>> gigabytes(1250000000, 0)
+        '1 GB'
+        >>> gigabytes(1250000000)
+        '1.3 GB'
+        >>> gigabytes(2 * 10**9, 3)
+        '2.000 GB'
+
+        ```
+
+    Args:
+        num_bytes (int, float, str): Number of bytes.
+        precision (int): Number of decimal places.
+
+    Returns:
+        str: The size in gigabytes, e.g. '1.5 GB'.
+    """
+    import decimal
+
+    if isinstance(num_bytes, float):
+        dec = decimal.Decimal(repr(num_bytes))
+    else:
+        dec = decimal.Decimal(num_bytes)
+    quantum = decimal.Decimal(1).scaleb(-int(precision))
+    gb = (dec / 10**9).quantize(quantum, rounding=decimal.ROUND_HALF_UP)
+    return f"{gb:f} GB"
