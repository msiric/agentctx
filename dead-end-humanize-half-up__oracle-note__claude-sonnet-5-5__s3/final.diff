+def percent(value: NumberOrString, precision: int = 1) -> str:
+    """Format a fraction as a percentage.
+
+    Examples:
+        ```pycon
+        >>> percent(0.125)
+        '12.5%'
+        >>> percent(0.5)
+        '50.0%'
+        >>> percent(1, 0)
+        '100%'
+        >>> percent("0.256", 2)
+        '25.60%'
+        >>> percent(-0.05)
+        '-5.0%'
+        >>> percent(0.0625)
+        '6.3%'
+        >>> percent("foo")
+        'foo'
+        >>> percent(None)
+        'None'
+
+        ```
+
+    Args:
+        value (int, float, str): Fraction to format, where 1 is 100%.
+        precision (int): Number of decimal places.
+
+    Returns:
+        str: The percentage, or the input as a string if it is not a number.
+    """
+    import decimal
+    import math
+
+    try:
+        value = float(value)
+        if not math.isfinite(value):
+            return _format_not_finite(value)
+    except (ValueError, TypeError):
+        return str(value)
+    # Round half away from zero on the decimal repr, so 0.0625 -> "6.3%"
+    # rather than the binary-float result "6.2%".
+    quantum = decimal.Decimal(1).scaleb(-int(precision))
+    pct = (decimal.Decimal(repr(value)) * 100).quantize(
+        quantum, rounding=decimal.ROUND_HALF_UP
+    )
+    return f"{pct:f}%"
+
