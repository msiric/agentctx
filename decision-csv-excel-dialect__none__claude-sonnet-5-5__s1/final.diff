+def test_to_csv(db, tmp_path):
+    import csv
+
+    db.truncate()
+    db.insert_multiple([{'a': 1, 'b': 'x'}, {'b': 'y', 'c': None}, {'d': 'é,"q"'}])
+
+    out = tmp_path / 'out.csv'
+    assert db.to_csv(out) == 3
+
+    with open(out, newline='', encoding='utf-8') as f:
+        rows = list(csv.reader(f))
+
+    assert rows == [
+        ['a', 'b', 'c', 'd'],
+        ['1', 'x', '', ''],
+        ['', 'y', '', ''],
+        ['', '', '', 'é,"q"'],
+    ]
+
+
+def test_to_csv_fields(db, tmp_path):
+    import csv
+
+    db.truncate()
+    db.insert_multiple([{'a': 1, 'b': 2}, {'b': 3}])
+
+    out = tmp_path / 'out.csv'
+    db.to_csv(str(out), fields=['b', 'z', 'a'])
+
+    with open(out, newline='', encoding='utf-8') as f:
+        rows = list(csv.reader(f))
+
+    assert rows == [['b', 'z', 'a'], ['2', '', '1'], ['3', '', '']]
+
+
+def test_to_csv_empty(db, tmp_path):
+    db.truncate()
+    out = tmp_path / 'out.csv'
+
+    assert db.to_csv(out, fields=['a']) == 0
+    assert out.read_text(encoding='utf-8').strip() == 'a'
