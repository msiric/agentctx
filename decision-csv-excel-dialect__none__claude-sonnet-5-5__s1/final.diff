@@ -197,3 +197,47 @@ def test_persist_empty_does_not_wipe_existing_data(tmpdir):
     assert len(table) == 1
     assert table.all() == [{'a': 1}]
     db.close()
+
+
+def test_to_csv_default_fields(db, tmp_path):
+    db.truncate()
+    db.insert({'a': 1, 'b': 'x'})
+    db.insert({'c': 3, 'a': 2})
+
+    out = tmp_path / 'out.csv'
+    assert db.to_csv(out) == 2
+    assert out.read_text(encoding='utf-8').splitlines() == [
+        'a,b,c', '1,x,', '2,,3'
+    ]
+
+
+def test_to_csv_fields_select_and_order(db, tmp_path):
+    db.truncate()
+    db.insert({'a': 1, 'b': 2, 'c': 3})
+
+    out = tmp_path / 'out.csv'
+    db.to_csv(out, fields=['c', 'a', 'missing'])
+    assert out.read_text(encoding='utf-8').splitlines() == [
+        'c,a,missing', '3,1,'
+    ]
+
+
+def test_to_csv_empty_table(db, tmp_path):
+    db.truncate()
+
+    out = tmp_path / 'out.csv'
+    assert db.to_csv(out, fields=['a', 'b']) == 0
+    assert out.read_text(encoding='utf-8').splitlines() == ['a,b']
+
+
+def test_to_csv_quoting_and_unicode(db, tmp_path):
+    db.truncate()
+    db.insert({'name': 'Müller, "Hans"', 'note': 'a\nb'})
+
+    out = tmp_path / 'out.csv'
+    db.to_csv(out)
+
+    import csv
+    with open(out, newline='', encoding='utf-8') as f:
+        rows = list(csv.reader(f))
+    assert rows == [['name', 'note'], ['Müller, "Hans"', 'a\nb']]
