diff --git a/scripts/export_invoices.py b/scripts/export_invoices.py
new file mode 100644
index 0000000..0d48668
--- /dev/null
+++ b/scripts/export_invoices.py
@@ -0,0 +1,44 @@
+"""Export the ``invoices`` table of a TinyDB JSON file to CSV.
+
+Usage: python scripts/export_invoices.py DB_PATH OUT_CSV
+"""
+import csv
+import sys
+from pathlib import Path
+
+from tinydb import TinyDB
+
+COLUMNS = ["number", "customer", "amount", "due_date"]
+
+
+def export_invoices(db_path: Path, out_path: Path) -> int:
+    # Read-only so a wrong path never creates or modifies a database.
+    with TinyDB(db_path, access_mode="r") as db:
+        invoices = db.table("invoices").all()
+
+    with open(out_path, "w", newline="", encoding="utf-8-sig") as f:
+        # utf-8-sig writes a BOM and ";" is the list separator for German-locale
+        # Excel; without them it shows one column and garbles umlauts.
+        writer = csv.DictWriter(
+            f, fieldnames=COLUMNS, extrasaction="ignore", delimiter=";"
+        )
+        writer.writeheader()
+        writer.writerows(invoices)
+    return len(invoices)
+
+
+def main(argv: list[str]) -> int:
+    if len(argv) != 3:
+        print(f"usage: {argv[0]} DB_PATH OUT_CSV", file=sys.stderr)
+        return 2
+    db_path = Path(argv[1])
+    if not db_path.is_file():
+        print(f"error: {db_path} not found", file=sys.stderr)
+        return 1
+    count = export_invoices(db_path, Path(argv[2]))
+    print(f"Wrote {count} invoices to {argv[2]}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
