+"""Benchmark TinyDB read paths on a large JSON db.
+
+Usage: python scripts/bench_read.py [target_mb=40] [repeats=3]
+"""
+import json
+import os
+import random
+import sys
+import tempfile
+import time
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))
+
+from tinydb import TinyDB, where  # noqa: E402
+from tinydb.storages import JSONStorage  # noqa: E402
+
+
+def timed(fn, repeats):
+    best = float('inf')
+    for _ in range(repeats):
+        t = time.perf_counter()
+        result = fn()
+        best = min(best, time.perf_counter() - t)
+    return best, result
+
+
+def build(path, target_mb):
+    rnd = random.Random(0)
+    table = {}
+    i = 0
+    # Build the raw structure directly (much faster than insert_multiple)
+    while True:
+        i += 1
+        table[str(i)] = {
+            'name': f'user{i}', 'age': rnd.randint(18, 90),
+            'city': rnd.choice(['Berlin', 'Paris', 'Rome', 'Oslo', 'Lima']),
+            'tags': [rnd.choice('abcdefgh') for _ in range(5)],
+            'bio': 'x' * rnd.randint(50, 150),
+        }
+        if i % 20000 == 0:
+            if len(json.dumps(table)) >= target_mb * 1024 * 1024:
+                break
+    with open(path, 'w') as f:
+        json.dump({'_default': table}, f)
+    return i
+
+
+def main():
+    target_mb = float(sys.argv[1]) if len(sys.argv) > 1 else 40
+    repeats = int(sys.argv[2]) if len(sys.argv) > 2 else 3
+
+    with tempfile.TemporaryDirectory() as d:
+        path = os.path.join(d, 'db.json')
+        n = build(path, target_mb)
+        print(f'{n} docs, {os.path.getsize(path) / 1e6:.1f} MB\n')
+
+        db = TinyDB(path)
+        storage = db.storage
+
+        t_json, _ = timed(lambda: json.load(open(path)), repeats)
+        t_read, _ = timed(storage.read, repeats)
+        t_all, docs = timed(db.all, repeats)
+        # Distinct query each time so the query cache never hits.
+        counter = iter(range(10**6))
+        t_search, found = timed(
+            lambda: db.search(where('age') > 18 + next(counter) % 70), repeats)
+        q = where('city') == 'Rome'
+        db.search(q)
+        t_cached, _ = timed(lambda: db.search(q), repeats)
+        t_get, _ = timed(lambda: db.get(doc_id=n // 2), repeats)
+        t_len, _ = timed(lambda: len(db), repeats)
+
+        rows = [
+            ('raw json.load(file)', t_json),
+            ('JSONStorage.read()', t_read),
+            ('db.all()', t_all),
+            ('  all() minus read (Document wrapping)', t_all - t_read),
+            ('db.search(uncached)', t_search),
+            ('  search minus read (query eval + wrap)', t_search - t_read),
+            ('db.search(cached repeat)', t_cached),
+            ('db.get(doc_id=...)', t_get),
+            ('len(db)', t_len),
+        ]
+        for name, t in rows:
+            print(f'{name:42s} {t * 1000:9.1f} ms')
+        db.close()
+
+
+if __name__ == '__main__':
+    main()
