+@functools.cache
+def _yaml_support() -> tuple[Any, Any, Any]:
+    """
+    Import PyYAML lazily and build the loader and dumper used by
+    :class:`YAMLStorage`.
+
+    PyYAML is an optional dependency, so it must not be imported when TinyDB
+    itself is imported. The loader and dumper are subclasses so that PyYAML's
+    global state is left untouched.
+
+    :returns: the ``yaml`` module, the loader class and the dumper class
+    """
+
+    try:
+        import yaml
+    except ImportError:
+        raise ImportError(
+            'YAMLStorage requires PyYAML. Install it with `pip install pyyaml`.'
+        ) from None
+
+    bool_tag = 'tag:yaml.org,2002:bool'
+
+    class Loader(yaml.SafeLoader):
+        """
+        A safe loader that only treats ``true`` and ``false`` as booleans.
+
+        PyYAML follows YAML 1.1 where ``yes``, ``no``, ``on``, ``off``, ``y``,
+        ``n`` (in any capitalization) are booleans too. That turns hand-written
+        values like ``country: NO`` into ``False``. Here, they stay strings.
+        """
+
+    # ``yaml_implicit_resolvers`` is shared with ``SafeLoader``: copy it
+    # (including the lists) before changing it
+    Loader.yaml_implicit_resolvers = {
+        first: [(tag, regexp) for tag, regexp in resolvers if tag != bool_tag]
+        for first, resolvers in yaml.SafeLoader.yaml_implicit_resolvers.items()
+    }
+    Loader.add_implicit_resolver(bool_tag, re.compile(r'^(?:true|false)$'), list('tf'))
+
+    class Dumper(yaml.SafeDumper):
+        """
+        A safe dumper that can also represent ``dict`` subclasses like
+        :class:`~tinydb.table.Document`.
+
+        It keeps PyYAML's default resolvers on purpose: strings that look like
+        a YAML 1.1 boolean (``'NO'``, ``'off'``) are written quoted, so the
+        files stay unambiguous for other YAML tools.
+        """
+
+    Dumper.add_multi_representer(dict, lambda dumper, data: dumper.represent_dict(dict(data)))
+
+    return yaml, Loader, Dumper
+
+
+class YAMLStorage(FileStorage):
+    """
+    Store the data in a YAML file.
+
+    Requires `PyYAML <https://pyyaml.org/>`_. Only ``true`` and ``false`` are
+    read as booleans, so hand-edited values such as ``NO`` or ``off`` stay
+    strings. Only plain YAML types are supported (no Python-specific tags).
+
+    **Note:** Comments and formatting in the file are not preserved when the
+    database is written.
+    """
+
+    def __init__(self, path: str, create_dirs=False, encoding='utf-8', access_mode='r+', **kwargs):
+        """
+        Create a new instance.
+
+        See :class:`FileStorage` for the file handling arguments.
+
+        :param kwargs: Passed on to :func:`yaml.dump` on every write. By
+                       default the output is block style, keeps the key order
+                       and does not escape unicode.
+        """
+
+        # Fail early with a helpful message if PyYAML is missing
+        _yaml_support()
+
+        super().__init__(path, create_dirs=create_dirs, encoding=encoding, access_mode=access_mode)
+
+        self.kwargs = kwargs
+
+    def read(self) -> Optional[dict[str, dict[str, Any]]]:
+        yaml, loader, _ = _yaml_support()
+
+        self._handle.seek(0, os.SEEK_END)
+        size = self._handle.tell()
+
+        if not size:
+            return None
+
+        self._handle.seek(0)
+
+        # Syntax errors are raised on purpose: returning ``None`` here would
+        # make TinyDB overwrite a hand-edited file that merely has a typo.
+        # A file that only contains comments loads as ``None`` (empty).
+        data = yaml.load(self._handle, Loader=loader)
+
+        # Hand-written ``1:`` is an integer key in YAML, but TinyDB looks up
+        # documents by string ID (as stored by JSON). Normalize the IDs.
+        if isinstance(data, dict):
+            data = {
+                name: {str(doc_id): doc for doc_id, doc in table.items()}
+                if isinstance(table, dict) else table
+                for name, table in data.items()
+            }
+
+        return data
+
+    def write(self, data: dict[str, dict[str, Any]]):
+        yaml, _, dumper = _yaml_support()
+
+        self._handle.seek(0)
+
+        # TinyDB uses string document IDs. Write them as integers so the file
+        # reads naturally (``1:`` instead of ``'1':``) when edited by hand.
+        data = {
+            name: {
+                int(doc_id) if isinstance(doc_id, str) and str(int(doc_id)) == doc_id else doc_id: doc
+                for doc_id, doc in table.items()
+            } if isinstance(table, dict) else table
+            for name, table in data.items()
+        }
+
+        options: dict[str, Any] = {
+            'default_flow_style': False,
+            'sort_keys': False,
+            'allow_unicode': True,
+        }
+        options.update(self.kwargs)
+        serialized = yaml.dump(data, Dumper=dumper, **options)
+
+        try:
+            self._handle.write(serialized)
+        except io.UnsupportedOperation:
+            raise IOError('Cannot write to the database. Access mode is "{0}"'.format(self._mode))
+
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+        self._handle.truncate()
+
