{
  "description": "trailkeep: inject private repo notes and the active effort file; log decisions at session end",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/trailkeep\" context --for claude",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/trailkeep\" harvest --for claude",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
