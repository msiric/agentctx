@@ -213,6 +214,19 @@ Default: `false`
 
 Randomizes the timeouts by multiplying with a factor between 1 and 2.
 
+##### Retry-After
+
+If the error an attempt throws has a numeric `retryAfter` (in seconds), the wait before the next attempt is at least that long. It can only lengthen the backoff, is not limited by `maxTimeout`, and is still cut short by `maxRetryTime`. Values that are not positive finite numbers are ignored. It is also honoured when `shouldConsumeRetry` returns `false`, although such retries otherwise have no delay.
+
+```js
+class RateLimitError extends Error {
+	constructor(retryAfter) {
+		super('Too many requests');
+		this.retryAfter = retryAfter; // Seconds, e.g. parsed from a `Retry-After` header
+	}
+}
+```
+
 ##### maxRetryTime
 
 Type: `number`\
diff --git a/test-timing.js b/test-timing.js
index 2361505..5150a79 100644
--- a/test-timing.js
+++ b/test-timing.js
@@ -906,3 +906,157 @@ test('unref is not applied unless the option is set', {timeout: 30_000}, async t
 
 	assert.ok(!isUnrefCalled);
 });
+
+test('passes `elapsedTime` to every callback', async t => {
+	const originalPerformanceNow = performance.now;
+	let now = 1000;
+	performance.now = () => now;
+
+	t.after(() => {
+		performance.now = originalPerformanceNow;
+	});
+
+	const seen = [];
+	const record = name => ({attemptNumber, elapsedTime}) => {
+		seen.push([name, attemptNumber, elapsedTime]);
+	};
+
+	await assert.rejects(pRetry(async () => {
+		now += 10;
+		throw new Error('fail');
+	}, {
+		retries: 1,
+		minTimeout: 0,
+		shouldConsumeRetry: record('consume'),
+		onFailedAttempt: record('failed'),
+		shouldRetry(context) {
+			record('retry')(context);
+			return true;
+		},
+	}), {message: 'fail'});
+
+	assert.deepEqual(seen, [
+		['consume', 1, 10],
+		['failed', 1, 10],
+		['retry', 1, 10],
+		['consume', 2, 20],
+		['failed', 2, 20],
+	]);
+});
+
+class RetryAfterError extends Error {
+	constructor(retryAfter) {
+		super('retry after');
+		this.retryAfter = retryAfter;
+	}
+}
+
+const runWithRetryAfter = async (t, retryAfters, options = {}) => {
+	const delays = collapseDelays(t);
+	let attempt = 0;
+
+	const result = await pRetry(async () => {
+		if (attempt < retryAfters.length) {
+			throw new RetryAfterError(retryAfters[attempt++]);
+		}
+
+		return fixture;
+	}, {retries: retryAfters.length, minTimeout: 10, ...options});
+
+	assert.equal(result, fixture);
+	return delays;
+};
+
+test('`retryAfter` (seconds) is honoured when longer than the backoff', async t => {
+	assert.deepEqual(await runWithRetryAfter(t, [2, 0.5]), [2000, 500]);
+});
+
+test('`retryAfter` never shortens the backoff', async t => {
+	assert.deepEqual(await runWithRetryAfter(t, [0.001], {minTimeout: 100}), [100]);
+});
+
+test('`retryAfter` is not capped by `maxTimeout`', async t => {
+	assert.deepEqual(await runWithRetryAfter(t, [5], {maxTimeout: 50}), [5000]);
+});
+
+test('`retryAfter` works with `minTimeout: 0`', async t => {
+	assert.deepEqual(await runWithRetryAfter(t, [1], {minTimeout: 0}), [1000]);
+});
+
+test('invalid `retryAfter` values are ignored', async t => {
+	const values = [-1, 0, NaN, Infinity, '5', null, undefined, {}];
+	assert.deepEqual(await runWithRetryAfter(t, values, {minTimeout: 10, factor: 1}), values.map(() => 10));
+});
+
+test('`retryAfter` is capped at the largest delay `setTimeout` holds', async t => {
+	assert.deepEqual(await runWithRetryAfter(t, [1e12]), [(2 ** 31) - 1]);
+});
+
+test('`retryAfter` is reported as `retryDelay`', async t => {
+	collapseDelays(t);
+	const seen = [];
+	await pRetry(async attemptNumber => {
+		if (attemptNumber === 1) {
+			throw new RetryAfterError(3);
+		}
+	}, {
+		minTimeout: 10,
+		shouldConsumeRetry({retryDelay}) {
+			seen.push(retryDelay);
+		},
+		onFailedAttempt({retryDelay}) {
+			seen.push(retryDelay);
+		},
+		shouldRetry({retryDelay}) {
+			seen.push(retryDelay);
+			return true;
+		},
+	});
+
+	assert.deepEqual(seen, [3000, 3000, 3000]);
+});
+
+test('`retryAfter` is cut short by `maxRetryTime`', async t => {
+	const {delays} = await withFakeTime(t);
+	await pRetry(async attemptNumber => {
+		if (attemptNumber === 1) {
+			throw new RetryAfterError(60);
+		}
+	}, {maxRetryTime: 1000, minTimeout: 10});
+
+	assert.deepEqual(delays, [1000]);
+});
+
+test('`retryAfter` does not apply once retries are exhausted', async t => {
+	const delays = collapseDelays(t);
+
+	await assert.rejects(pRetry(async () => {
+		throw new RetryAfterError(60);
+	}, {retries: 0}), {message: 'retry after'});
+
+	assert.deepEqual(delays, []);
+});
+
+test('`retryAfter` is honoured when the retry is not consumed', async t => {
+	const delays = collapseDelays(t);
+	await pRetry(async attemptNumber => {
+		if (attemptNumber === 1) {
+			throw new RetryAfterError(2);
+		}
+	}, {retries: 1, minTimeout: 10, shouldConsumeRetry: () => false});
+
+	assert.deepEqual(delays, [2000]);
+});
+
+test('`retryAfter` wait can be aborted', async () => {
+	const controller = new AbortController();
+	const promise = pRetry(async () => {
+		throw new RetryAfterError(60);
+	}, {signal: controller.signal, minTimeout: 10});
+
+	setImmediate(() => {
+		controller.abort(new Error('stop'));
+	});
+
+	await assert.rejects(promise, {message: 'stop'});
+});
