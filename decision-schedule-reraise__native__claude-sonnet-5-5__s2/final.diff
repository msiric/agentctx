+    def _run_jobs(self, jobs: List["Job"], delay_seconds: int = 0) -> None:
+        """
+        Run all given jobs, even if some raise. The first exception is
+        re-raised once every job has been run.
+        """
+        first_error: Optional[BaseException] = None
+        for index, job in enumerate(jobs):
+            if index > 0 and delay_seconds:
+                time.sleep(delay_seconds)
+            try:
