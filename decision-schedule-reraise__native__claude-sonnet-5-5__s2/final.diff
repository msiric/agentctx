+        bad = mock.Mock(side_effect=ValueError("first"), __name__="bad")
+        bad2 = mock.Mock(side_effect=KeyError("second"), __name__="bad2")
+        every().minute.do(bad)
+        every().minute.do(bad2)
+        every().minute.do(ok)
+        with self.assertRaises(ValueError):
+            schedule.run_all()
+        assert bad.call_count == bad2.call_count == ok.call_count == 1
