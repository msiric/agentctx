+    def test_run_pending_continues_after_exception(self):
+        ok = make_mock_job()
+        bad = mock.Mock(side_effect=ValueError("boom"), __name__="bad")
+        with mock_datetime(2014, 6, 28, 12, 0, 0):
+            bad_job = every().minute.do(bad)
+            every().minute.do(ok)
+        with mock_datetime(2014, 6, 28, 12, 1, 1):
+            with self.assertRaises(ValueError):
+                schedule.run_pending()
+            assert ok.call_count == 1
+            # failing job was rescheduled, so it is no longer due
