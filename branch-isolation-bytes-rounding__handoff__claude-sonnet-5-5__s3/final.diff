diff --git a/test/byte-format.js b/test/byte-format.js
index 7e82cee..ce26360 100644
--- a/test/byte-format.js
+++ b/test/byte-format.js
@@ -116,4 +116,48 @@ describe('Test byte format function', function(){
     assert.equal(bytes.format(12 * mb, {unit: ''}).toLowerCase(), '12mb');
     assert.equal(bytes.format(12 * mb, {unit: 'bb'}).toLowerCase(), '12mb');
   })
+  describe('rounding option', function(){
+    it('Should keep default rounding behaviour', function(){
+      assert.equal(bytes.format(1048575), '1024KB');
+      assert.equal(bytes.format(1048575, {rounding: 'round'}), '1024KB');
+    });
+
+    it('Should truncate instead of rounding up', function(){
+      assert.equal(bytes.format(1048575, {rounding: 'truncate'}), '1023.99KB');
+      assert.equal(bytes.format(2047, {rounding: 'truncate'}), '1.99KB');
+      assert.equal(bytes.format(1048571, {rounding: 'truncate'}), '1023.99KB');
+    });
+
+    it('Should never produce 1024 in the chosen unit at boundaries', function(){
+      assert.equal(bytes.format(mb * 1024 - 1, {rounding: 'truncate'}), '1023.99MB');
+      assert.equal(bytes.format(gb * 1024 - 1, {rounding: 'truncate'}), '1023.99GB');
+      assert.equal(bytes.format(tb * 1024 - 1, {rounding: 'truncate'}), '1023.99TB');
+    });
+
+    it('Should leave exact boundaries unchanged', function(){
+      assert.equal(bytes.format(kb, {rounding: 'truncate'}), '1KB');
+      assert.equal(bytes.format(mb, {rounding: 'truncate'}), '1MB');
+      assert.equal(bytes.format(1023, {rounding: 'truncate'}), '1023B');
+    });
+
+    it('Should truncate toward zero for negatives', function(){
+      assert.equal(bytes.format(-1048575, {rounding: 'truncate'}), '-1023.99KB');
+      assert.equal(bytes.format(-2047, {rounding: 'truncate'}), '-1.99KB');
+    });
+
+    it('Should support decimalPlaces', function(){
+      assert.equal(bytes.format(1048575, {rounding: 'truncate', decimalPlaces: 0}), '1023KB');
+      assert.equal(bytes.format(1048575, {rounding: 'truncate', decimalPlaces: 3}), '1023.999KB');
+    });
+
+    it('Should support fixedDecimals and thousandsSeparator', function(){
+      assert.equal(bytes.format(2048, {rounding: 'truncate', fixedDecimals: true}), '2.00KB');
+      assert.equal(bytes.format(2047, {rounding: 'truncate', fixedDecimals: true}), '1.99KB');
+      assert.equal(bytes.format(1500 * mb - 1, {rounding: 'truncate', unit: 'MB', thousandsSeparator: ','}), '1,499.99MB');
+    });
+
