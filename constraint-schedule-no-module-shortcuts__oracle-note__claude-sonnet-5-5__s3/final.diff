diff --git a/test_schedule.py b/test_schedule.py
index f497826..81cee95 100644
--- a/test_schedule.py
+++ b/test_schedule.py
@@ -1569,6 +1569,72 @@ class SchedulerTests(TestCase):
         schedule.clear()
         assert len(schedule.jobs) == 0
 
+    def test_get_jobs_for(self):
+        def f():
+            pass
+
+        def g():
+            pass
+
+        class A:
+            def m(self):
+                pass
+
+        a = A()
+        j1 = every().second.do(f)
+        j2 = every().hour.do(f)
+        j3 = every().second.do(g)
+        j4 = every().second.do(a.m)
+
+        assert schedule.default_scheduler.get_jobs_for(f) == [j1, j2]
+        assert schedule.default_scheduler.get_jobs_for(g) == [j3]
+        assert schedule.default_scheduler.get_jobs_for(a.m) == [j4]
+        assert schedule.default_scheduler.get_jobs_for(A().m) == []
+        assert schedule.default_scheduler.get_jobs_for(lambda: None) == []
+
+        for job in schedule.default_scheduler.get_jobs_for(f):
+            schedule.cancel_job(job)
+        assert schedule.default_scheduler.get_jobs_for(f) == []
+        assert len(schedule.get_jobs()) == 2
+        schedule.clear()
+
+    def test_pause_and_resume_by_tag(self):
+        mock_a = make_mock_job(name="a")
+        mock_b = make_mock_job(name="b")
+        mock_c = make_mock_job(name="c")
+        with mock_datetime(2020, 1, 1, 10, 0, 0):
+            every().second.do(mock_a).tag("maint")
+            every().second.do(mock_b).tag("maint", "other")
+            every().second.do(mock_c).tag("keep")
+            schedule.default_scheduler.pause("maint")
+            assert all(j.paused for j in schedule.get_jobs("maint"))
+            assert not any(j.paused for j in schedule.get_jobs("keep"))
+            assert len(schedule.jobs) == 3
+        with mock_datetime(2020, 1, 1, 10, 0, 2):
+            schedule.run_pending()
+            assert mock_a.call_count == 0
+            assert mock_b.call_count == 0
+            assert mock_c.call_count == 1
+            schedule.default_scheduler.resume("maint")
+            schedule.run_pending()
+            assert mock_a.call_count == 1
+            assert mock_b.call_count == 1
+            assert mock_c.call_count == 1
+
+    def test_pause_unknown_tag_is_noop(self):
+        mock_job = make_mock_job()
+        job = every().second.do(mock_job).tag("t")
+        schedule.default_scheduler.pause("missing")
+        schedule.default_scheduler.resume("missing")
+        assert not job.paused
+
+    def test_paused_job_still_runs_with_run_all(self):
+        mock_job = make_mock_job()
+        every().hour.do(mock_job).tag("t")
+        schedule.default_scheduler.pause("t")
+        schedule.run_all()
+        assert mock_job.call_count == 1
+
     def test_clear_by_tag(self):
