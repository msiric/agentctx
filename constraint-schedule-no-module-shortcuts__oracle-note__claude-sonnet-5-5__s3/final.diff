+    def get_jobs_for(self, func: Callable) -> List["Job"]:
+        """
+        Gets scheduled jobs that run the given function, so callers
+        don't need to keep the :class:`Job` objects around.
+
+        Bound methods are matched with ``==`` semantics, so
+        ``obj.method`` finds jobs scheduled with ``obj.method``.
+
+        :param func: The callable that was passed to :meth:`Job.do`
+        """
+        return [
+            job
+            for job in self.jobs
+            if job.job_func is not None and job.job_func.func == func
+        ]
+
+    def pause(self, tag: Hashable) -> None:
+        """
+        Pause all jobs marked with the given tag.
+
+        Paused jobs are skipped by :meth:`run_pending` until they are
+        resumed with :meth:`resume`. They stay registered, keeping their
+        configuration and tags. :meth:`run_all` still runs them.
+
+        :param tag: An identifier used to identify a subset of jobs to pause
+        """
+        logger.debug('Pausing jobs with tag "%s"', tag)
+        for job in self.get_jobs(tag):
+            job.paused = True
+
+    def resume(self, tag: Hashable) -> None:
+        """
+        Resume all paused jobs marked with the given tag.
+
+        A resumed job whose ``next_run`` passed while it was paused runs
+        on the next :meth:`run_pending` call (once, not once per missed run).
+
+        :param tag: An identifier used to identify a subset of jobs to resume
+        """
+        logger.debug('Resuming jobs with tag "%s"', tag)
+        for job in self.get_jobs(tag):
+            job.paused = False
+
