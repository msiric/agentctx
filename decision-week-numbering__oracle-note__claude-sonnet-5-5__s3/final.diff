diff --git a/src/index.js b/src/index.js
index 3ea001b..7798c76 100644
--- a/src/index.js
+++ b/src/index.js
@@ -7,6 +7,17 @@ var MAP = {
 		return d.getMonth() + 1;
 	},
 	DD: 'getDate',
+	DDD: function (d) {
+		// day of year (1-366), from local date fields so DST can't skew it
+		return (Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()) - Date.UTC(d.getFullYear(), 0, 0)) / 864e5;
+	},
+	WW: function (d) {
+		// Excel WEEKNUM(date, 2): weeks start Monday, week 1 contains Jan 1
+		var y = d.getFullYear();
+		var doy = (Date.UTC(y, d.getMonth(), d.getDate()) - Date.UTC(y, 0, 0)) / 864e5;
+		var jan1 = (new Date(Date.UTC(y, 0, 1)).getUTCDay() + 6) % 7; // Mon=0 .. Sun=6
+		return Math.floor((doy - 1 + jan1) / 7) + 1;
+	},
 	HH: 'getHours',
 	mm: 'getMinutes',
 	ss: 'getSeconds',
