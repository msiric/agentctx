@@ -230,6 +230,34 @@ queryString.parse('foo=true', {parseBooleans: true});
 
 Parse the value as a boolean type instead of string type if it's a boolean.
 
+##### ignoreEmpty
+
+Type: `boolean`\
+Default: `false`
+
+```js
+import queryString from 'query-string';
+
+queryString.parse('?q=&page=2&flag', {ignoreEmpty: true});
+//=> {flag: null, page: '2'}
+```
+
+Drop parameters with an empty value. A key without `=` (like `flag`) is not empty and is kept.
+
+##### stripTracking
+
+Type: `boolean`\
+Default: `false`
+
+```js
+import queryString from 'query-string';
+
+queryString.parse('?q=x&utm_source=a&fbclid=1&gclid=2', {stripTracking: true});
+//=> {q: 'x'}
+```
+
+Drop tracking parameters: `utm_*`, `fbclid`, and `gclid`. The names are matched case-insensitively.
+
 ##### types
 
 Type: `object`\
diff --git a/test/parse.js b/test/parse.js
index 00a1abf..779cb18 100644
--- a/test/parse.js
+++ b/test/parse.js
@@ -1492,3 +1492,27 @@ test('rejects an invalid `arrayFormatSeparator`', () => {
 
 	assert.deepEqual(structuredClone(queryString.parse('foo=a·b', {arrayFormat: 'separator', arrayFormatSeparator: '·'})), {foo: ['a', 'b']});
 });
+
+test('`ignoreEmpty` drops parameters with an empty value', () => {
+	assert.deepEqual(structuredClone(queryString.parse('?q=&page=2', {ignoreEmpty: true})), {page: '2'});
+	assert.deepEqual(structuredClone(queryString.parse('?q=&page=2')), {page: '2', q: ''});
+	assert.deepEqual(structuredClone(queryString.parse('?flag&q=', {ignoreEmpty: true})), {flag: null});
+	assert.deepEqual(structuredClone(queryString.parse('?q=&q=1&q=', {ignoreEmpty: true})), {q: '1'});
+	assert.deepEqual(structuredClone(queryString.parse('?q[]=&q[]=1', {ignoreEmpty: true, arrayFormat: 'bracket'})), {q: ['1']});
+	assert.deepEqual(structuredClone(queryString.parse('?q=&a=1,,2', {ignoreEmpty: true, arrayFormat: 'comma'})), {a: ['1', '', '2']});
+	assert.deepEqual(structuredClone(queryString.parse('?q=&', {ignoreEmpty: true})), {});
+});
+
+test('`stripTracking` drops tracking parameters', () => {
+	assert.deepEqual(structuredClone(queryString.parse('?q=x&utm_source=a&utm_medium=b&fbclid=1&gclid=2', {stripTracking: true})), {q: 'x'});
+	assert.deepEqual(structuredClone(queryString.parse('?q=x&utm_source=a&fbclid=1')), {fbclid: '1', q: 'x', utm_source: 'a'}); // eslint-disable-line camelcase
+	assert.deepEqual(structuredClone(queryString.parse('?q=x&UTM_Source=a&FBCLID=1&utm_x', {stripTracking: true})), {q: 'x'});
+	assert.deepEqual(structuredClone(queryString.parse('?fbclid[]=1&fbclid[]=2&q=x', {stripTracking: true, arrayFormat: 'bracket'})), {q: 'x'});
+	assert.deepEqual(structuredClone(queryString.parse('?utm%5Fsource=a&q=x', {stripTracking: true})), {q: 'x'});
+	assert.deepEqual(structuredClone(queryString.parse('?utmx=1&fbclidx=2&xgclid=3&utm=4', {stripTracking: true})), {
+		fbclidx: '2',
+		utm: '4',
+		utmx: '1',
+		xgclid: '3',
+	});
+});
