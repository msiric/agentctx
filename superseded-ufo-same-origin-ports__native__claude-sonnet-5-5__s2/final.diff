+
+/**
+ * Checks whether two URLs share the same origin (protocol, hostname and port).
+ *
+ * Default ports are normalized (`https://a.com` equals `https://a.com:443`).
+ * Relative, protocol-relative, malformed and opaque-origin inputs (e.g. `data:`)
+ * never match.
+ */
+export function isSameOrigin(a: string, b: string): boolean {
+  if (typeof a !== "string" || typeof b !== "string") {
+    return false;
+  }
+  try {
+    const originA = new URL(a).origin;
+    const originB = new URL(b).origin;
+    return originA !== "null" && originA === originB;
+  } catch {
+    return false;
+  }
+}
