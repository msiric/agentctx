diff --git a/test/same-origin.test.ts b/test/same-origin.test.ts
new file mode 100644
index 0000000..4242336
--- /dev/null
+++ b/test/same-origin.test.ts
@@ -0,0 +1,154 @@
+import { describe, expect, test } from "vitest";
+import { isSameOrigin } from "../src";
+
+// Proposed semantics: two URLs are same-origin when protocol, hostname and
+// port all match. Path, query and hash are ignored. Default ports are
+// normalized (":443" on https and ":80" on http equal the portless URL).
+// Inputs without an origin (relative paths) never match.
+
+describe("isSameOrigin", () => {
+  describe("same origin", () => {
+    test.each([
+      ["https://example.com", "https://example.com"],
+      ["https://example.com", "https://example.com/"],
+      ["https://example.com/a", "https://example.com/b"],
+      ["https://example.com/a?x=1#h", "https://example.com/b?y=2#g"],
+      ["https://example.com:8080/a", "https://example.com:8080/b"],
+      ["http://localhost:3000", "http://localhost:3000/foo"],
+    ])("%s ~ %s", (a, b) => {
+      expect(isSameOrigin(a, b)).toBe(true);
+      expect(isSameOrigin(b, a)).toBe(true); // symmetric
+    });
+
+    test("hostname is case-insensitive", () => {
+      expect(isSameOrigin("https://EXAMPLE.com", "https://example.com")).toBe(
+        true,
+      );
+    });
+
+    test("protocol is case-insensitive", () => {
+      expect(isSameOrigin("HTTPS://example.com", "https://example.com")).toBe(
+        true,
+      );
+    });
+
+    test("userinfo is ignored", () => {
+      expect(
+        isSameOrigin("https://user:pass@example.com/a", "https://example.com/b"),
+      ).toBe(true);
+    });
+
+    test("IPv6 hosts", () => {
+      expect(isSameOrigin("http://[::1]:3000/a", "http://[::1]:3000/b")).toBe(
+        true,
+      );
+    });
+  });
+
+  describe("different origin", () => {
+    test.each([
+      ["different protocol", "http://example.com", "https://example.com"],
+      ["different host", "https://example.com", "https://example.org"],
+      ["subdomain", "https://example.com", "https://www.example.com"],
+      [
+        "different port",
+        "https://example.com:8080",
+        "https://example.com:9090",
+      ],
+      [
+        "explicit non-default vs omitted port",
+        "https://example.com:8080",
+        "https://example.com",
+      ],
+      [
+        "default port of other scheme",
+        "http://example.com:443",
+        "https://example.com",
+      ],
+      [
+        "userinfo lookalike host",
+        "https://example.com@evil.com",
+        "https://example.com",
+      ],
+      [
+        "suffix lookalike host",
+        "https://example.com.evil.com",
+        "https://example.com",
+      ],
+    ])("%s", (_name, a, b) => {
+      expect(isSameOrigin(a, b)).toBe(false);
+      expect(isSameOrigin(b, a)).toBe(false);
+    });
+  });
+
+  describe("default port normalization", () => {
+    test.each([
+      ["https://example.com", "https://example.com:443"],
+      ["http://example.com", "http://example.com:80"],
+      ["https://example.com:443/a", "https://example.com/b"],
+      ["ws://example.com:80", "ws://example.com"],
+    ])("%s ~ %s", (a, b) => {
+      expect(isSameOrigin(a, b)).toBe(true);
+      expect(isSameOrigin(b, a)).toBe(true);
+    });
+  });
+
+  describe("relative / origin-less inputs", () => {
+    // OPEN QUESTION: should these be false (no origin to compare), or resolve
+    // against a base? Proposal: false, no base argument.
+    test.each([
+      ["/foo", "/bar"],
+      ["./foo", "./foo"],
+      ["foo", "foo"],
+      ["/foo", "https://example.com/foo"],
+      ["https://example.com/foo", "/foo"],
+      ["", ""],
+      ["", "https://example.com"],
+    ])("%j vs %j is false", (a, b) => {
+      expect(isSameOrigin(a, b)).toBe(false);
+    });
+
+    // OPEN QUESTION: protocol-relative URLs have a host but no scheme.
+    // Proposal: false, since the origin can't be determined without a scheme.
+    test("protocol-relative URLs are false", () => {
+      expect(isSameOrigin("//example.com/a", "//example.com/b")).toBe(false);
+      expect(isSameOrigin("//example.com", "https://example.com")).toBe(false);
+    });
+  });
+
+  describe("opaque / non-hierarchical schemes", () => {
+    // Per WHATWG these have opaque origins ("null"), which never equal anything.
+    test.each([
+      ["data:text/plain,hi", "data:text/plain,hi"],
+      ["javascript:void(0)", "javascript:void(0)"],
+      ["mailto:a@example.com", "mailto:a@example.com"],
+      ["blob:null/uuid", "blob:null/uuid"],
+    ])("%s is never same-origin, even with itself", (a, b) => {
+      expect(isSameOrigin(a, b)).toBe(false);
+    });
+  });
+
+  describe("invalid / nullish input", () => {
+    test("undefined / null / empty are false", () => {
+      expect(isSameOrigin(undefined as any, undefined as any)).toBe(false);
+      expect(isSameOrigin(null as any, "https://example.com")).toBe(false);
+      expect(isSameOrigin("https://example.com", undefined as any)).toBe(false);
+    });
+
+    test("does not throw on malformed URLs", () => {
+      expect(() => isSameOrigin("https://", "https://")).not.toThrow();
+      expect(isSameOrigin("http://exa mple.com", "http://exa mple.com")).toBe(
+        false,
+      );
+    });
+  });
+
+  describe("non-http special schemes", () => {
+    test("ws/wss/ftp compare like http", () => {
+      expect(isSameOrigin("wss://example.com/a", "wss://example.com/b")).toBe(
+        true,
+      );
+      expect(isSameOrigin("ws://example.com", "wss://example.com")).toBe(false);
+    });
+  });
+});
