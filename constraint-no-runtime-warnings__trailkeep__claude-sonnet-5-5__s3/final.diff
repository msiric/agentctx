+    def test_ttl_setter(self):
+        cache = TTLCache[int, int, int](maxsize=3, ttl=2, timer=Timer())
+        cache[1] = 1
+        cache.ttl = 4
+        self.assertEqual(4, cache.ttl)
+        cache[2] = 2
+
+        # existing item keeps its original expiration time
+        cache.timer.tick()
+        cache.timer.tick()
+        self.assertNotIn(1, cache)
+        self.assertIn(2, cache)
+
+        cache.timer.tick()
+        cache.timer.tick()
+        self.assertNotIn(2, cache)
+
+        # decreasing ttl also applies to new items only
+        cache[3] = 3
+        cache.ttl = 1
+        cache[4] = 4
+        cache.timer.tick()
+        self.assertEqual(3, cache[3])
+        self.assertNotIn(4, cache)
+
     def test_ttl_timer(self):
         cache = TTLCache[int, int, int](maxsize=2, ttl=2, timer=Timer())
         self.assertEqual(cache.timer.time, 0)
