@@ -483,3 +483,20 @@ def test_inprocess_jsonl_malformed_headers():
     )
     # output should still be produced (graceful fallback), with raw keys as headers
     assert out.strip() != ""
+
+
+def test_inprocess_wrap_option():
+    """In-process: --wrap wraps text without splitting long words"""
+    import pytest
+
+    text = "id,note\nT-1,hello big world https://example.com/a-very-long-url\n"
+    for flag in ["-w", "--wrap"]:
+        out = run_main_in_process(
+            [flag, "10", "-r", "csv", "-1"], input_text=text
+        )
+        assert "https://example.com/a-very-long-url" in out
+        assert "hello big" in out and "hello big world" not in out
+    for bad in ["0", "-3", "x"]:
+        with pytest.raises(SystemExit) as exc_info:
+            run_main_in_process(["--wrap", bad], input_text="a b\n")
+        assert exc_info.value.code == 2
