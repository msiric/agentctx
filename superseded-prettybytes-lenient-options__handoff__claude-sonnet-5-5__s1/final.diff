+##### significantDigits
+
+Type: `number`\
+Default: `3`
+
+Round to this many significant digits instead of the default 3. Only applies when neither `minimumFractionDigits` nor `maximumFractionDigits` is set.
+
+Must be an integer between 1 and 100. Any other value is ignored and the default of 3 is used.
+
+```js
+import prettyBytes from 'pretty-bytes';
+
+prettyBytes(1337, {significantDigits: 2});
+//=> '1.3 kB'
+
+prettyBytes(1337, {significantDigits: 4});
+//=> '1.337 kB'
+```
+
 ##### space
 
 Type: `boolean`\
diff --git a/test.js b/test.js
index fdbecc3..53229be 100644
--- a/test.js
+++ b/test.js
@@ -1184,3 +1184,18 @@ test('unit outside the active unit system throws', t => {
 		}, {instanceOf: TypeError});
 	}
 });
+
+test('significantDigits', t => {
+	t.is(prettyBytes(1337, {significantDigits: 2}), '1.3 kB');
+	t.is(prettyBytes(1337, {significantDigits: 4}), '1.337 kB');
+	t.is(prettyBytes(1337, {significantDigits: 1}), '1 kB');
+	t.is(prettyBytes(999_999, {significantDigits: 2}), '1 MB');
+	t.is(prettyBytes(123_456, {significantDigits: 1}), '123 kB');
+	t.is(prettyBytes(1337, {significantDigits: 2, maximumFractionDigits: 3}), '1.337 kB');
+});
+
+test('invalid significantDigits is ignored', t => {
+	for (const significantDigits of [0, -1, 1.5, 101, Number.NaN, '4', null, {}]) {
+		t.is(prettyBytes(1337, {significantDigits}), '1.34 kB');
+	}
+});
