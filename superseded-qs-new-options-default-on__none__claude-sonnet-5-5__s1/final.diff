--- a/test/parse.js
+++ b/test/parse.js
@@ -1,3 +1,4 @@
+/* eslint-disable camelcase -- Tracking parameter names are snake_case. */
 /* eslint-disable node-test/no-conditional-assertion -- Many tests here are table-driven, so the assertions sit inside a loop over the cases. The loop always runs, and every case is checked. */
 import test from 'node:test';
 import assert from 'node:assert/strict';
@@ -1492,3 +1493,43 @@ test('rejects an invalid `arrayFormatSeparator`', () => {
 
 	assert.deepEqual(structuredClone(queryString.parse('foo=a·b', {arrayFormat: 'separator', arrayFormatSeparator: '·'})), {foo: ['a', 'b']});
 });
+
+test('`ignoreEmpty` drops parameters with an empty value', () => {
+	assert.deepEqual(structuredClone(queryString.parse('?q=&page=2', {ignoreEmpty: true})), {page: '2'});
+	assert.deepEqual(structuredClone(queryString.parse('?q=&page=2')), {q: '', page: '2'});
+	assert.deepEqual(structuredClone(queryString.parse('?q=&page=2', {ignoreEmpty: false})), {q: '', page: '2'});
+	assert.deepEqual(structuredClone(queryString.parse('?q=', {ignoreEmpty: true})), {});
+});
+
+test('`ignoreEmpty` keeps a key without `=`', () => {
+	assert.deepEqual(structuredClone(queryString.parse('?flag&q=&page=2', {ignoreEmpty: true})), {flag: null, page: '2'});
+});
+
+test('`ignoreEmpty` drops empty array items', () => {
+	assert.deepEqual(structuredClone(queryString.parse('a=&a=1&a=', {ignoreEmpty: true})), {a: '1'});
+	assert.deepEqual(structuredClone(queryString.parse('a[]=&a[]=1', {arrayFormat: 'bracket', ignoreEmpty: true})), {a: ['1']});
+});
+
+test('`stripTracking` drops `utm_*`, `fbclid`, and `gclid`', () => {
+	assert.deepEqual(structuredClone(queryString.parse('?q=shoes&utm_source=news&utm_medium=x&fbclid=a&gclid=b', {stripTracking: true})), {q: 'shoes'});
+	assert.deepEqual(structuredClone(queryString.parse('?q=shoes&utm_source=news&fbclid=a&gclid=b')), {
+		q: 'shoes',
+		utm_source: 'news',
+		fbclid: 'a',
+		gclid: 'b',
+	});
+	assert.deepEqual(structuredClone(queryString.parse('?utm_source=news', {stripTracking: true})), {});
+});
+
+test('`stripTracking` matches the decoded key, case-insensitively, and keeps similar keys', () => {
+	assert.deepEqual(structuredClone(queryString.parse('?UTM_Source=a&utm%5Fmedium=b&FBCLID=c&utm&fbclid2=d&xutm_a=e&q=1', {stripTracking: true})), {
+		utm: null,
+		fbclid2: 'd',
+		xutm_a: 'e',
+		q: '1',
+	});
+});
+
+test('`stripTracking` drops tracking array items and flags', () => {
+	assert.deepEqual(structuredClone(queryString.parse('gclid&utm_x[]=1&utm_x[]=2&a=1', {stripTracking: true, arrayFormat: 'bracket'})), {a: '1'});
+});
