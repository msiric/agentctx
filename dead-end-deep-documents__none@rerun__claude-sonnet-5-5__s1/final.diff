+def drop_keys(doc, names):
+    """Return a copy of ``doc`` with every key in ``names`` removed at any depth.
+
+    Keys are matched exactly, so attribute keys must include their prefix
+    (e.g. ``'@id'``). Dicts nested in lists/tuples are processed too. The
+    input is never mutated; scalars are returned as-is.
+    """
+    if isinstance(names, str):
+        names = (names,)
+    names = frozenset(names)
+
+    def _drop(value):
+        if isinstance(value, dict):
+            result = value.__class__()
+            for k, v in value.items():
+                if k not in names:
+                    result[k] = _drop(v)
+            return result
+        if isinstance(value, (list, tuple)):
+            return [_drop(v) for v in value]
+        return value
+
+    return _drop(doc)
+
+
