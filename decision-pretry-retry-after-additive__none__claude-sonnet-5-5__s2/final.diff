+test('a numeric `retryAfter` on the error is honoured', async t => {
+	const delays = collapseDelays(t);
+	const reported = [];
+
+	await assert.rejects(pRetry(async attemptNumber => {
+		throw Object.assign(new Error('fail'), {retryAfter: attemptNumber === 1 ? 2.5 : 0.01});
+	}, {
+		retries: 2,
+		minTimeout: 100,
+		factor: 1,
+		onFailedAttempt({retryDelay}) {
+			reported.push(retryDelay);
+		},
+	}), {message: 'fail'});
+
+	// The longer of the backoff and `retryAfter` wins, and it is what the callbacks are told.
+	assert.deepEqual(delays, [2500, 100]);
+	assert.deepEqual(reported, [2500, 100, 0]);
+});
+
+test('an invalid `retryAfter` is ignored', async t => {
+	const delays = collapseDelays(t);
+
+	for (const retryAfter of [-5, NaN, Infinity, '5', null, 0]) {
+		delays.length = 0;
+
+		await assert.rejects(pRetry(async () => {
+			throw Object.assign(new Error('fail'), {retryAfter});
+		}, {retries: 1, minTimeout: 100}), {message: 'fail'});
+
+		assert.deepEqual(delays, [100], String(retryAfter));
+	}
+});
+
+test('`retryAfter` is not capped by `maxTimeout`, but is by `maxRetryTime`', async t => {
+	const delays = collapseDelays(t);
+
+	await assert.rejects(pRetry(async () => {
+		throw Object.assign(new Error('fail'), {retryAfter: 10});
+	}, {retries: 1, minTimeout: 100, maxTimeout: 200}), {message: 'fail'});
+
+	assert.deepEqual(delays, [10_000]);
+
+	delays.length = 0;
+
+	await assert.rejects(pRetry(async () => {
+		throw Object.assign(new Error('fail'), {retryAfter: 10});
+	}, {retries: 1, minTimeout: 100, maxRetryTime: 5000}), {message: 'fail'});
+
+	assert.equal(delays.length, 1);
+	assert.ok(delays[0] <= 5000, `delay was ${delays[0]}`);
+});
+
