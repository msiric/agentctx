diff --git a/tests/test_tables.py b/tests/test_tables.py
index a94005e..c101d75 100644
--- a/tests/test_tables.py
+++ b/tests/test_tables.py
@@ -197,3 +197,55 @@ def test_persist_empty_does_not_wipe_existing_data(tmpdir):
     assert len(table) == 1
     assert table.all() == [{'a': 1}]
     db.close()
+
+
+def _read_csv(path, delimiter=';'):
+    import csv
+    with open(path, newline='', encoding='utf-8-sig') as f:
+        return list(csv.reader(f, delimiter=delimiter))
+
+
+def test_to_csv_default_fields(db, tmp_path):
+    db.truncate()
+    db.insert({'a': 1, 'b': 'x'})
+    db.insert({'c': 3, 'a': 2})
+    out = tmp_path / 'out.csv'
+
+    db.to_csv(out)
+
+    assert _read_csv(out) == [['a', 'b', 'c'], ['1', 'x', ''], ['2', '', '3']]
+
+
+def test_to_csv_fields_select_and_order(db, tmp_path):
+    db.truncate()
+    db.insert({'a': 1, 'b': 2, 'c': 3})
+    out = tmp_path / 'out.csv'
+
+    db.to_csv(out, fields=['c', 'a', 'missing'])
+
+    assert _read_csv(out) == [['c', 'a', 'missing'], ['3', '1', '']]
+
+
+def test_to_csv_quoting_encoding_and_options(db, tmp_path):
+    db.truncate()
+    db.insert({'name': 'Müller; "GmbH", Co', 'n': 0})
+    out = tmp_path / 'out.csv'
+
+    db.to_csv(out)
+    assert out.read_bytes().startswith(b'\xef\xbb\xbf')
+    assert _read_csv(out) == [['name', 'n'], ['Müller; "GmbH", Co', '0']]
+
+    db.to_csv(out, delimiter=',', encoding='utf-8')
+    assert not out.read_bytes().startswith(b'\xef\xbb\xbf')
+    assert _read_csv(out, ',') == [['name', 'n'], ['Müller; "GmbH", Co', '0']]
+
+
+def test_to_csv_empty_table(db, tmp_path):
+    db.truncate()
+    out = tmp_path / 'out.csv'
+
+    db.to_csv(out)
+    assert _read_csv(out) == [[]]
+
+    db.to_csv(out, fields=['a'])
+    assert _read_csv(out) == [['a']]
