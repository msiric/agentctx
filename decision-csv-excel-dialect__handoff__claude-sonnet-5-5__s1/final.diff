+    def to_csv(
+        self,
+        path: Union[str, 'PathLike[str]'],
+        fields: Optional[Iterable[str]] = None,
+        *,
+        delimiter: str = ';',
+        encoding: str = 'utf-8-sig',
+    ) -> None:
+        """
+        Export the table to a CSV file: a header row, then one row per
+        document (in document ID order).
+
+        By default the file uses ``;`` as delimiter and a UTF-8 BOM so it
+        opens correctly in German-locale Excel (which is what finance uses).
+        Pass ``delimiter=','`` and ``encoding='utf-8'`` for plain CSV.
+
+        :param path: the file to write
+        :param fields: the top-level keys to export, in column order. Defaults
+                       to all top-level keys in first-seen order.
+        :param delimiter: the column delimiter
+        :param encoding: the file encoding
+        """
+
+        docs = self.all()
+
+        if fields is None:
+            columns: list[str] = []
+            seen = set()
+            for doc in docs:
+                for key in doc:
+                    if key not in seen:
+                        seen.add(key)
+                        columns.append(key)
+        else:
+            columns = list(fields)
+
+        with open(path, 'w', newline='', encoding=encoding) as f:
+            writer = csv.writer(f, delimiter=delimiter)
+            writer.writerow(columns)
+            for doc in docs:
+                writer.writerow([doc.get(c, '') for c in columns])
+
