+import { describe, expect, it } from '@jest/globals';
+import { parseClock } from './index';
+
+describe('parseClock(string)', () => {
+  it('should parse m:ss', () => {
+    expect(parseClock('1:30')).toBe(90000);
+    expect(parseClock('0:05')).toBe(5000);
+    expect(parseClock('00:00')).toBe(0);
+  });
+
+  it('should allow minutes above 59 in m:ss', () => {
+    expect(parseClock('90:30')).toBe(90 * 60000 + 30000);
+  });
+
+  it('should parse h:mm:ss', () => {
+    expect(parseClock('01:02:03')).toBe(3723000);
+    expect(parseClock('1:02:03')).toBe(3723000);
+    expect(parseClock('100:00:00')).toBe(100 * 3600000);
+  });
+
+  it('should parse fractional seconds', () => {
+    expect(parseClock('1:30.5')).toBe(90500);
+    expect(parseClock('0:01:02.250')).toBe(62250);
+  });
+
+  it('should tolerate surrounding whitespace', () => {
+    expect(parseClock(' 1:30 ')).toBe(90000);
+  });
+
+  it('should reject out-of-range fields', () => {
+    for (const bad of ['1:60', '1:75', '1:60:00', '1:00:60', '1:5:00']) {
+      expect(() => parseClock(bad)).toThrow(TypeError);
+    }
+  });
+
+  it('should reject malformed input and include the value in the message', () => {
+    for (const bad of [
+      '90',
+      '1:5',
+      '1:',
+      ':30',
+      '1:30:',
+      '1:2:3:4',
+      '-1:30',
+      '1:30.',
+      '1h',
+      'a:bc',
+      '   ',
+    ]) {
+      expect(() => parseClock(bad)).toThrow(TypeError);
+      expect(() => parseClock(bad)).toThrow(JSON.stringify(bad));
+    }
+  });
+
+  it('should throw a TypeError for empty, non-string, or overly long values', () => {
+    expect(() => parseClock('')).toThrow(TypeError);
+    expect(() => parseClock('')).toThrow('value=""');
+    expect(() => parseClock(5 as unknown as string)).toThrow(TypeError);
+    expect(() => parseClock('1'.repeat(100))).toThrow(TypeError);
+  });
+});
