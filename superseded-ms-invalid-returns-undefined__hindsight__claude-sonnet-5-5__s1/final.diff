+/**
+ * Parse a compound duration such as `"1h 30m"`, `"1h, 30m"` or `"2 days 4 hours"` and
+ * return the total in milliseconds. Each piece is parsed with `parse`.
+ *
+ * @param str - A string made of one or more whitespace- or comma-separated durations
+ * @returns The summed value in milliseconds (never `NaN`)
+ * @throws TypeError if `str` is not a string of length 1-99 or any piece can't
+ * be parsed
+ */
+export function parseCompound(str: string): number {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw new TypeError(
+      `Value provided to ms.parseCompound() must be a string with length between 1 and 99. value=${JSON.stringify(str)}`,
+    );
+  }
+  const input = str.trim();
+  const piece = /\s*(,?)\s*(-?\d*\.?\d+(?:\s*[a-z]+)?)/iy;
+  let total = 0;
+  let count = 0;
+  while (piece.lastIndex < input.length) {
+    const match = piece.exec(input);
+    // A comma is only allowed between parts, not before the first one.
+    const value =
+      match && (count > 0 || !match[1]) ? parse(match[2] as string) : NaN;
+    if (Number.isNaN(value)) {
+      throw invalidCompound(str);
+    }
+    total += value;
+    count++;
+  }
+  if (count === 0) {
+    throw invalidCompound(str);
+  }
+  return total;
+}
+
+function invalidCompound(str: string): TypeError {
+  return new TypeError(
+    `Value provided to ms.parseCompound() is not a valid compound duration. value=${JSON.stringify(str)}`,
+  );
+}
+
+/**
+ * Parse a timer-style clock string and return milliseconds. `"m:ss"` (e.g. `"1:30"`)
+ * and `"h:mm:ss"` (e.g. `"01:02:03"`) are supported. Seconds may have a fractional part
+ * (`"1:30.5"`). The leading field may have any number of digits; the others must be
+ * exactly two digits and below 60.
+ *
+ * @param str - A clock string in `m:ss` or `h:mm:ss` form
+ * @returns The value in milliseconds
+ * @throws TypeError if `str` is not a string of length 1-99 or isn't a valid clock string
+ */
+export function parseClock(str: string): number {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw new TypeError(
+      `Value provided to ms.parseClock() must be a string with length between 1 and 99. value=${JSON.stringify(str)}`,
+    );
+  }
+  const match = /^(?:(\d+):)?(\d+):(\d{2}(?:\.\d+)?)$/.exec(str.trim());
+  if (match) {
+    const hasHours = match[1] !== undefined;
+    const hours = hasHours ? Number(match[1]) : 0;
+    const minutes = Number(match[2]);
+    const seconds = Number(match[3]);
+    // In h:mm:ss the minutes field must be two digits and below 60; in m:ss it is unbounded.
+    const minutesOk =
+      !hasHours || ((match[2] as string).length === 2 && minutes < 60);
+    if (minutesOk && seconds < 60) {
+      return hours * h + minutes * m + seconds * s;
+    }
+  }
+  throw new TypeError(
+    `Value provided to ms.parseClock() is not a valid clock string (expected m:ss or h:mm:ss). value=${JSON.stringify(str)}`,
+  );
+}
