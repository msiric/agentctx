diff --git a/test/index.js b/test/index.js
index 37abaa5..e3a8cf0 100644
--- a/test/index.js
+++ b/test/index.js
@@ -328,3 +328,16 @@ test('flag boolean with default string & alias', t => {
 	t.is(typeof baz.two, 'boolean');
 	t.end();
 });
+
+test('opts["--"]', t => {
+	t.deepEqual(
+		fn(['a', '--x', '1', '--', 'b', '--y', '-z'], { '--': true }),
+		{ _: ['a'], x: 1, '--': ['b', '--y', '-z'] },
+		'args after -- go to argv["--"]'
+	);
+	t.deepEqual(fn(['a', '--x'], { '--': true }), { _: ['a'], x: true, '--': [] }, 'empty when no bare --');
+	t.deepEqual(fn(['a', '--', 'b'], { '--': false }), { _: ['a', 'b'] }, 'falsy keeps default behavior');
+	t.deepEqual(fn(['a', '--', 'b']), { _: ['a', 'b'] }, 'unset keeps default behavior');
+	t.deepEqual(fn(['--', '--', 'b'], { '--': true }), { _: [], '--': ['--', 'b'] }, 'only first -- is consumed');
+	t.end();
+});
