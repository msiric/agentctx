+
+/**
+ * Format the given milliseconds as an ISO 8601 duration string.
+ *
+ * Days are the largest unit used, since months and years are ambiguous.
+ * Sub-second precision is emitted as decimal seconds. Negative values are
+ * prefixed with `-` (a common extension to ISO 8601).
+ *
+ * @example
+ * formatISO(5400000); // "PT1H30M"
+ * formatISO(90061000); // "P1DT1H1M1S"
+ *
+ * @param ms - milliseconds
+ * @returns The ISO 8601 duration string
+ */
+export function formatISO(ms: number): string {
+  if (typeof ms !== 'number' || !Number.isFinite(ms)) {
+    throw new Error('Value provided to ms.formatISO() must be of type number.');
+  }
+
+  let rest = Math.round(Math.abs(ms));
+  const days = Math.floor(rest / d);
+  rest -= days * d;
+  const hours = Math.floor(rest / h);
+  rest -= hours * h;
+  const minutes = Math.floor(rest / m);
+  rest -= minutes * m;
+  const seconds = Math.floor(rest / s);
+  const millis = rest - seconds * s;
+
+  let secStr = '';
+  if (seconds > 0 || millis > 0) {
+    secStr = String(seconds);
+    if (millis > 0) {
+      secStr += `.${String(millis).padStart(3, '0').replace(/0+$/, '')}`;
+    }
+    secStr += 'S';
+  }
+
+  const time =
+    (hours ? `${hours}H` : '') + (minutes ? `${minutes}M` : '') + secStr;
+
+  if (!days && !time) {
+    return 'PT0S';
+  }
+
+  return `${ms < 0 ? '-' : ''}P${days ? `${days}D` : ''}${time ? `T${time}` : ''}`;
+}
+
+function isDigit(c: string | undefined): boolean {
+  return c !== undefined && c >= '0' && c <= '9';
+}
+
+/**
+ * Parse an ISO 8601 duration string and return milliseconds. The inverse of
+ * `formatISO`.
+ *
+ * Supports an optional leading `-`/`+`, the `Y`, `M`, `W`, `D` date designators
+ * and the `H`, `M`, `S` time designators (in that order, each at most once).
+ * Only the last component may be fractional (`.` or `,` separator). Years and
+ * months use the same average lengths as `parse`.
+ *
+ * @example
+ * parseISO('PT1H30M'); // 5400000
+ * parseISO('P1DT1H1M1S'); // 90061000
+ *
+ * @param str - An ISO 8601 duration string
+ * @returns The value in milliseconds, or `NaN` if the string is not a valid
+ * duration
+ */
+export function parseISO(str: string): number {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw new Error(
+      `Value provided to ms.parseISO() must be a string with length between 1 and 99. value=${JSON.stringify(str)}`,
+    );
+  }
+
+  let i = 0;
+  let sign = 1;
+  if (str[i] === '-' || str[i] === '+') {
+    sign = str[i] === '-' ? -1 : 1;
+    i++;
+  }
+  if (str[i] !== 'P') {
+    return NaN;
+  }
+  i++;
+
+  const dateUnits: Record<string, number> = { Y: y, M: mo, W: w, D: d };
+  const timeUnits: Record<string, number> = { H: h, M: m, S: s };
+  const dateOrder = 'YMWD';
+  const timeOrder = 'HMS';
+
+  let inTime = false;
+  let lastIndex = -1;
+  let total = 0;
+  let components = 0;
+  let sawFraction = false;
+
+  while (i < str.length) {
+    if (str[i] === 'T') {
+      if (inTime) return NaN;
+      inTime = true;
+      lastIndex = -1;
+      i++;
+      // 'T' must be followed by at least one component
+      if (i >= str.length) return NaN;
+      continue;
+    }
+
+    // number: digits [ (.|,) digits ]
+    const start = i;
+    while (isDigit(str[i])) i++;
+    if (i === start) return NaN;
+    let isFraction = false;
+    if (str[i] === '.' || str[i] === ',') {
+      i++;
+      const fracStart = i;
+      while (isDigit(str[i])) i++;
+      if (i === fracStart) return NaN;
+      isFraction = true;
+    }
+    const n = parseFloat(str.slice(start, i).replace(',', '.'));
+
+    const designator = str[i];
+    if (designator === undefined || sawFraction) return NaN;
+    const units = inTime ? timeUnits : dateUnits;
+    const order = inTime ? timeOrder : dateOrder;
+    const unitMs = units[designator];
+    const idx = order.indexOf(designator);
+    if (unitMs === undefined || idx <= lastIndex) return NaN;
+    lastIndex = idx;
+    i++;
+
+    total += n * unitMs;
+    components++;
+    sawFraction = isFraction;
+  }
+
+  if (components === 0) return NaN;
+  return sign * total;
+}
