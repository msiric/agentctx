+        (["check", "{}1.2.3"], ""),
+    ],
+)
+def test_v_prefix_accepted(prefix, cli, expected, capsys):
+    cli = [c.format(prefix) for c in cli]
+    assert main(cli) == 0
+    assert capsys.readouterr().out.strip() == expected
+
+
