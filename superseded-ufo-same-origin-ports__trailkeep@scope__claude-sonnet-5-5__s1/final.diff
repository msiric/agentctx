+
+type OriginInfo =
+  | { kind: "invalid" }
+  | { kind: "relative" }
+  | { kind: "protocol-relative"; host: string }
+  | { kind: "absolute"; origin: string };
+
+function _getOriginInfo(input: string): OriginInfo {
+  const value = input.trim();
+  // Backslashes are treated as slashes by URL parsers, which makes the
+  // authority ambiguous (`https://a.com\@b.com`). Refuse them.
+  const authorityEnd = value.search(/[?#]/);
+  const beforeQuery = authorityEnd === -1 ? value : value.slice(0, authorityEnd);
+  if (beforeQuery.includes("\\") && /^([a-z][\w+.-]*:)?[/\\]{2}/i.test(beforeQuery)) {
+    return { kind: "invalid" };
+  }
+  try {
+    if (value.startsWith("//")) {
+      return { kind: "protocol-relative", host: new URL("http:" + value).host };
+    }
+    const url = new URL(value);
+    // Opaque origins (data:, javascript:, mailto:, ...)
+    return url.origin === "null"
+      ? { kind: "invalid" }
+      : { kind: "absolute", origin: url.origin };
+  } catch {
+    return PROTOCOL_REGEX.test(value) || value.startsWith("//")
+      ? { kind: "invalid" }
+      : { kind: "relative" };
+  }
+}
+
+/**
+ * Check if two URLs have the same origin (scheme, host and port).
+ *
+ * Path, query, hash and credentials are ignored. Default ports are
+ * normalized (`https://x` equals `https://x:443`). Relative URLs have no
+ * origin: two relative URLs are considered equal, but a relative URL never
+ * matches an absolute one. Opaque origins (`data:`, `javascript:`, ...) and
+ * malformed input never match.
+ *
+ * @example
+ * ```js
+ * isSameOrigin("https://a.com/x", "https://a.com:443/y"); // true
+ * isSameOrigin("https://a.com", "https://b.com"); // false
+ * ```
+ *
+ * @group utils
+ */
+export function isSameOrigin(a: string, b: string): boolean {
+  const infoA = _getOriginInfo(a);
+  const infoB = _getOriginInfo(b);
+  if (infoA.kind === "invalid" || infoB.kind === "invalid") {
+    return false;
+  }
+  if (infoA.kind !== infoB.kind) {
+    return false;
+  }
+  if (infoA.kind === "absolute") {
+    return infoA.origin === (infoB as typeof infoA).origin;
+  }
+  if (infoA.kind === "protocol-relative") {
+    return infoA.host === (infoB as typeof infoA).host;
+  }
+  return true;
+}
