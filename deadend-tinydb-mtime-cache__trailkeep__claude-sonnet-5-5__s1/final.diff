     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def test_json_read_cache_sees_external_same_size_write(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    with open(path, 'w') as f:
+        f.write('{"_default": {"1": {"a": 1}}}')
+
+    storage = JSONStorage(path)
+    assert storage.read() == {'_default': {'1': {'a': 1}}}
+    assert storage.read() is storage.read()  # unchanged file -> no re-parse
+
+    # Another process rewrites the file with identical size (and possibly
+    # identical mtime on coarse-resolution filesystems)
+    with open(path, 'w') as f:
+        f.write('{"_default": {"1": {"a": 2}}}')
+
+    assert storage.read() == {'_default': {'1': {'a': 2}}}
+    storage.close()
