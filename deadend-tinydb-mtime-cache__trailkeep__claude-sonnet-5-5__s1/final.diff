+"""Benchmark TinyDB read performance on a large JSON db.
+
+Usage: python scripts/bench_read.py [target_mb] [repeats]
+"""
+import cProfile
+import json
+import os
+import pstats
+import random
+import sys
+import tempfile
+import time
+
+from tinydb import TinyDB, where
+
+
+def generate(path, target_mb):
+    rnd = random.Random(0)
+    docs, size, i = {}, 0, 0
+    while size < target_mb * 1024 * 1024:
+        doc = {'id': i, 'name': f'user{i}', 'group': rnd.randrange(100),
+               'tags': [rnd.choice('abcdefgh') for _ in range(5)],
+               'text': ''.join(rnd.choices('abcdefghij ', k=100))}
+        docs[str(i + 1)] = doc
+        size += len(json.dumps(doc)) + 10
+        i += 1
+    with open(path, 'w') as f:
+        json.dump({'_default': docs}, f)
+    return i
+
+
+def timeit(fn, repeats):
+    times = []
+    for _ in range(repeats):
+        t = time.perf_counter()
+        fn()
+        times.append(time.perf_counter() - t)
+    return min(times), sum(times) / len(times)
+
+
+def main():
+    mb = float(sys.argv[1]) if len(sys.argv) > 1 else 40
+    repeats = int(sys.argv[2]) if len(sys.argv) > 2 else 5
+    with tempfile.TemporaryDirectory() as d:
+        path = os.path.join(d, 'db.json')
+        n = generate(path, mb)
+        print(f'{n} docs, {os.path.getsize(path) / 1e6:.1f} MB')
+        db = TinyDB(path)
+
+        def report(label, fn):
+            lo, avg = timeit(fn, repeats)
+            print(f'{label:34s} min {lo*1000:8.1f} ms  avg {avg*1000:8.1f} ms')
+
+        report('json.load of file (floor)',
+               lambda: json.load(open(path)))
+        report('storage.read()', db.storage.read)
+        report('db.all()', db.all)
+        counter = iter(range(10**6))
+        # distinct query each time -> bypasses the query cache
+        report('search (uncached, ~1% match)',
+               lambda: db.search(where('group') == next(counter) % 100))
+        report('search (cached repeat)',
+               lambda: db.search(where('group') == 5))
+        db.search(where('group') == 5)
+        report('search (cached repeat, warm)',
+               lambda: db.search(where('group') == 5))
+
+        print('\nProfile of one uncached search:')
+        pr = cProfile.Profile()
+        pr.enable()
+        db.search(where('name') == 'nobody')
+        pr.disable()
+        pstats.Stats(pr).sort_stats('cumulative').print_stats(8)
+        db.close()
+
+
+if __name__ == '__main__':
+    main()
