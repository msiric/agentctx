+test('onRetry runs only when another attempt follows, after shouldRetry', async () => {
+	const order = [];
+	let calls = 0;
+
+	await assert.rejects(pRetry(async () => {
+		calls++;
+		throw new Error('nope');
+	}, {
+		retries: 2,
+		minTimeout: 0,
+		onFailedAttempt() {
+			order.push('onFailedAttempt');
+		},
+		shouldRetry() {
+			order.push('shouldRetry');
+			return true;
+		},
+		async onRetry({attemptNumber, retriesLeft, error}) {
+			order.push(`onRetry${attemptNumber}`);
+			assert.equal(error.message, 'nope');
+			assert.equal(retriesLeft, 3 - attemptNumber);
+		},
+	}), {message: 'nope'});
+
+	assert.equal(calls, 3);
+	assert.deepEqual(order, [
+		'onFailedAttempt',
+		'shouldRetry',
+		'onRetry1',
+		'onFailedAttempt',
+		'shouldRetry',
+		'onRetry2',
+		'onFailedAttempt',
+	]);
+});
+
+test('onRetry is not called when shouldRetry says no, or for AbortError', async () => {
+	let count = 0;
+	const onRetry = () => {
+		count++;
+	};
+
+	await assert.rejects(pRetry(async () => {
+		throw new Error('a');
+	}, {shouldRetry: () => false, onRetry}), {message: 'a'});
+
+	await assert.rejects(pRetry(async () => {
+		throw new AbortError('b');
+	}, {onRetry}), {message: 'b'});
+
+	assert.equal(count, 0);
+});
+
+test('onRetry is called when shouldConsumeRetry returns false', async () => {
+	let count = 0;
+	let attempts = 0;
+
+	await pRetry(async () => {
+		if (++attempts < 3) {
+			throw new Error('c');
+		}
+	}, {
+		shouldConsumeRetry: () => false,
+		onRetry() {
+			count++;
+		},
+	});
+
+	assert.equal(count, 2);
+});
+
+test('onRetry throwing aborts retries', async () => {
+	const error = new Error('from onRetry');
+	let attempts = 0;
+
+	await assert.rejects(pRetry(async () => {
+		attempts++;
+		throw new Error('x');
+	}, {
+		onRetry() {
+			throw error;
+		},
+	}), rejectsWith(error));
+
+	assert.equal(attempts, 1);
+});
+
+test('onRetry must be a function', async () => {
+	await assert.rejects(pRetry(async () => {}, {onRetry: 1}), {
+		name: 'TypeError',
+		message: 'Expected `onRetry` to be a function.',
+	});
+});
+
+test('initialDelay waits before the first attempt', async () => {
+	const start = performance.now();
+	let firstCall;
+
+	await pRetry(async () => {
+		firstCall ??= performance.now() - start;
+	}, {initialDelay: 50});
+
+	assert.ok(firstCall >= 45, `first attempt came after ${firstCall}ms`);
+});
+
+test('initialDelay defaults to no wait', async () => {
+	const start = performance.now();
+	await pRetry(async () => {});
+	assert.ok(performance.now() - start < 40);
+});
+
+test('initialDelay does not count towards maxRetryTime', async () => {
+	let attempts = 0;
+
+	await pRetry(async () => {
+		if (++attempts < 2) {
+			throw new Error('again');
+		}
+	}, {initialDelay: 60, minTimeout: 0, maxRetryTime: 30});
+
+	assert.equal(attempts, 2);
+});
+
+test('aborting during initialDelay rejects with the reason and never calls input', async () => {
+	const controller = new AbortController();
+	const reason = new Error('stop');
+	let calls = 0;
+
+	setTimeout(() => {
+		controller.abort(reason);
+	}, 10);
+
+	const start = performance.now();
+	await assert.rejects(pRetry(async () => {
+		calls++;
+	}, {initialDelay: 5000, signal: controller.signal}), rejectsWith(reason));
+
+	assert.equal(calls, 0);
+	assert.ok(performance.now() - start < 1000);
+});
+
+test('initialDelay must be a non-negative finite number', async () => {
+	for (const initialDelay of ['1', -1, NaN, Infinity]) {
+		await assert.rejects(pRetry(async () => {}, {initialDelay}), {name: 'TypeError'});
+	}
+});
