+    def test_to_dict_skip_none_default_off(self):
+        prop = self.dict_class({'a': None, 'b': {'c': None}})
+        self.assertEqual(prop.to_dict(), {'a': None, 'b': {'c': None}})
+
+    def test_to_dict_skip_none(self):
+        prop = self.dict_class({
+            'a': None, 'b': 1,
+            'c': {'d': None, 'e': 2, 'f': {'g': None}},
+            'h': [{'i': None, 'j': 3}, None, 4],
+            'k': ({'l': None},),
+        })
+        regular = prop.to_dict(skip_none=True)
+        self.assertEqual(regular, {
+            'b': 1,
+            'c': {'e': 2, 'f': {}},
+            'h': [{'j': 3}, None, 4],
+            'k': ({},),
+        })
+        self.assertIsInstance(regular['k'], tuple)
+
+    def test_to_dict_skip_none_keyword_only(self):
+        with self.assertRaises(TypeError):
+            self.dict_class().to_dict(True)
+
     def test_to_dict_with_tuple(self):
         nested = {'a': ({'a': 0}, {2: 0})}
         prop = self.dict_class(nested)
