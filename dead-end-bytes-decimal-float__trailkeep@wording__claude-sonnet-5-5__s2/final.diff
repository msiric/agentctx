+/**
+ * Multiply a decimal string by 10^exp and floor the result, using exact
+ * string arithmetic to avoid floating point noise (e.g. 2.01 * 1000).
+ *
+ * @param {string} str signed decimal string, e.g. "-2.01"
+ * @param {number} exp
+ *
+ * @returns {number}
+ * @private
+ */
