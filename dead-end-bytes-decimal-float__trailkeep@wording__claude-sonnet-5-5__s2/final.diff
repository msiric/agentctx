diff --git a/test/byte-parse.js b/test/byte-parse.js
index cebfab2..4e734f9 100644
--- a/test/byte-parse.js
+++ b/test/byte-parse.js
@@ -109,3 +109,45 @@ describe('Test byte parse function', function(){
     assert.equal(bytes.parse('1 TB'), 1 * Math.pow(1024, 4));
   });
 });
+
+describe('Test byte parse function with decimal option', function(){
+  it('Should use powers of 1000', function(){
+    assert.strictEqual(bytes.parse('1kB', {decimal: true}), 1000);
+    assert.strictEqual(bytes.parse('1MB', {decimal: true}), 1e6);
+    assert.strictEqual(bytes.parse('1GB', {decimal: true}), 1e9);
+    assert.strictEqual(bytes.parse('1TB', {decimal: true}), 1e12);
+    assert.strictEqual(bytes.parse('1PB', {decimal: true}), 1e15);
+  });
+
+  it('Should be case insensitive and keep bytes as is', function(){
+    assert.strictEqual(bytes.parse('5kb', {decimal: true}), 5000);
+    assert.strictEqual(bytes.parse('5b', {decimal: true}), 5);
+    assert.strictEqual(bytes.parse('5', {decimal: true}), 5);
+    assert.strictEqual(bytes.parse('foobar', {decimal: true}), null);
+  });
+
+  it('Should avoid floating point noise', function(){
+    assert.strictEqual(bytes.parse('2.01kB', {decimal: true}), 2010);
+    assert.strictEqual(bytes.parse('1.001MB', {decimal: true}), 1001000);
+    assert.strictEqual(bytes.parse('9007199.254740993GB', {decimal: true}), 9007199254740993);
+  });
+
+  it('Should floor fractional bytes', function(){
+    assert.strictEqual(bytes.parse('1.0005kB', {decimal: true}), 1000);
+    assert.strictEqual(bytes.parse('0.0009kB', {decimal: true}), 0);
+    assert.strictEqual(bytes.parse('-1.0005kB', {decimal: true}), -1001);
+    assert.strictEqual(bytes.parse('-2kB', {decimal: true}), -2000);
+    assert.strictEqual(bytes.parse('+2kB', {decimal: true}), 2000);
+  });
+
+  it('Should not change behaviour without the option', function(){
+    assert.strictEqual(bytes.parse('1kB'), 1024);
+    assert.strictEqual(bytes.parse('1kB', {}), 1024);
+    assert.strictEqual(bytes.parse('1kB', {decimal: false}), 1024);
+  });
+
+  it('Should forward options from bytes()', function(){
+    assert.strictEqual(bytes('1kB', {decimal: true}), 1000);
+    assert.strictEqual(bytes('1kB'), 1024);
+  });
+});
