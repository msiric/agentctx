+  var negative = str.charAt(0) === '-';
+  var unsigned = str.replace(/^[-+]/, '');
+  var parts = unsigned.split('.');
+  var frac = parts[1] || '';
+
+  while (frac.length < exp) {
+    frac += '0';
+  }
+
+  var whole = parts[0] + frac.slice(0, exp);
+  var rest = frac.slice(exp);
+  var result = Number(whole);
+
