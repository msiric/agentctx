+def test_length():
+    assert Length(min=1, max=3).validate("abc") == "abc"
+    assert Length(min=3, max=3).validate("abc") == "abc"
+    assert Length(min=2).validate("a" * 100) == "a" * 100
+    assert Length(max=2).validate("") == ""
+    assert Length().validate("anything") == "anything"
+    with SE:
+        Length(min=2).validate("a")
+    with SE:
+        Length(max=2).validate("abc")
+    # bytes, not characters: "é" is 2 bytes in UTF-8
+    assert Length(max=2).validate("é") == "é"
+    with SE:
+        Length(max=3).validate("éé")
+    assert Length(min=4).validate("éé") == "éé"
+    assert Length(max=3).validate("日") == "日"  # 3 bytes
+    with SE:
+        Length(max=8).validate("日日日")  # 9 bytes
+    for bad in (1, None, [], b"abc"):
+        with SE:
+            Length(max=5).validate(bad)
+    with raises(ValueError):
+        Length(min=3, max=2)
+    with raises(TypeError):
+        Length(1, 2)
+    assert Schema({"name": Length(max=4)}).validate({"name": "abcd"}) == {"name": "abcd"}
+    with SE:
+        Schema({"name": Length(max=4)}).validate({"name": "abcde"})
+    with SE as ctx:
+        Length(max=1, error="too long: {}").validate("ab")
+    assert "too long: ab" in ctx.value.autos or "too long: ab" in ctx.value.errors
