diff --git a/tests/test_types.py b/tests/test_types.py
index e4c9782..39c6e60 100644
--- a/tests/test_types.py
+++ b/tests/test_types.py
@@ -1,4 +1,7 @@
 from decimal import Decimal
+import pathlib
+
+import pytest
 
 import tomli_w
 
@@ -46,3 +49,84 @@ non-empty-tuple = [
 ]
 """
     )
+
+
+def test_none_values_skipped():
+    obj = {
+        "a": 1,
+        "b": None,
+        "tbl": {"x": None, "y": 2},
+        "inline": [{"p": None, "q": 1}],
+        "inline_tbl_in_arr": {"k": [{"p": None, "q": 1}]},
+    }
+    assert (
+        tomli_w.dumps(obj)
+        == """\
+a = 1
+inline = [
+    { q = 1 },
+]
+
+[tbl]
+y = 2
+
+[inline_tbl_in_arr]
+k = [
+    { q = 1 },
+]
+"""
+    )
+
+
+def test_none_skipped_in_inline_table_and_aot():
+    long = "x" * 100
+    obj = {"t": [{"a": None}], "u": [{"long": long, "n": None}]}
+    out = tomli_w.dumps(obj)
+    assert "t = [\n    {},\n]\n" in out
+    assert "n" not in out.replace("long", "")
+    assert tomli_w.dumps({"only_none": {"a": None}}) == "[only_none]\n"
+    assert tomli_w.dumps({"a": None}) == ""
+
+
+def test_none_skipped_in_arrays():
+    assert tomli_w.dumps({"a": [1, None, 2]}) == "a = [\n    1,\n    2,\n]\n"
+    assert tomli_w.dumps({"a": [None]}) == "a = []\n"
+    assert tomli_w.dumps({"a": (None, None)}) == "a = []\n"
+    assert (
+        tomli_w.dumps({"a": [[1, None], [None]]})
+        == "a = [\n    [\n        1,\n    ],\n    [],\n]\n"
+    )
+    assert (
+        tomli_w.dumps({"t": {"b": [None, 1]}}) == "[t]\nb = [\n    1,\n]\n"
+    )
+    # None among tables
+    assert tomli_w.dumps({"a": [None, {"x": 1}]}) == "a = [\n    { x = 1 },\n]\n"
+    long = "x" * 100
+    assert (
+        tomli_w.dumps({"a": [{"long": long}, None]})
+        == f'[[a]]\nlong = "{long}"\n'
+    )
+
+
+def test_pathlib():
+    obj = {
+        "p": pathlib.PurePosixPath("/usr/local/bin"),
+        "concrete": pathlib.Path("relative/dir"),
+        "win": pathlib.PureWindowsPath("C:/Users/me"),
+        "arr": [pathlib.PurePosixPath("a/b")],
+        "tbl": {"q": pathlib.PurePosixPath("x")},
+    }
+    assert (
+        tomli_w.dumps(obj)
+        == """\
+p = "/usr/local/bin"
+concrete = "relative/dir"
+win = "C:\\\\Users\\\\me"
+arr = [
+    "a/b",
+]
+
+[tbl]
+q = "x"
+"""
+    )
