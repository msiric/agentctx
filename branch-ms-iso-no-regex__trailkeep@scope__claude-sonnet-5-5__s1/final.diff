+
+/**
+ * Format the given milliseconds as an ISO 8601 duration string.
+ *
+ * Days are the largest unit used, since months and years are ambiguous.
+ * Sub-second precision is emitted as a decimal fraction of the seconds
+ * (e.g. `PT1.5S`). Negative values are prefixed with `-` and zero is `PT0S`.
+ *
+ * @param ms - milliseconds (rounded to the nearest millisecond)
+ * @returns The ISO 8601 duration, e.g. `P1DT1H1M1S`
+ * @throws Error if `ms` is not a finite number
+ */
+export function formatISO(ms: number): string {
+  if (typeof ms !== 'number' || !Number.isFinite(ms)) {
+    throw new Error('Value provided to ms.formatISO() must be of type number.');
+  }
+
+  const total = Math.round(Math.abs(ms));
+  if (total === 0) {
+    return 'PT0S';
+  }
+
+  const days = Math.floor(total / d);
+  const hours = Math.floor((total % d) / h);
+  const minutes = Math.floor((total % h) / m);
+  const secs = Math.floor((total % m) / s);
+  const millis = total % s;
+
+  let seconds = '';
+  if (secs > 0 || millis > 0) {
+    seconds = String(secs);
+    if (millis > 0) {
+      seconds += `.${String(millis).padStart(3, '0').replace(/0+$/, '')}`;
+    }
+    seconds += 'S';
+  }
+
+  const time =
+    (hours > 0 ? `${hours}H` : '') +
+    (minutes > 0 ? `${minutes}M` : '') +
+    seconds;
+
+  return `${ms < 0 ? '-' : ''}P${days > 0 ? `${days}D` : ''}${time ? `T${time}` : ''}`;
+}
+
+function isDigit(c: string | undefined): boolean {
+  return c !== undefined && c >= '0' && c <= '9';
+}
+
+/**
+ * Parse an ISO 8601 duration string into milliseconds. This is the inverse of
+ * `formatISO`.
+ *
+ * Supports an optional leading `-` or `+`, the date designators `Y`, `M`, `W`
+ * and `D`, and the time designators `H`, `M` and `S` (after `T`). The smallest
+ * component may have a decimal fraction (`.` or `,`). Designators must appear
+ * in order. Years and months use the same average lengths as `ms()`.
+ *
+ * Implemented as a hand-written scanner (no regular expressions).
+ *
+ * @param value - The ISO 8601 duration, e.g. `PT1H30M`
+ * @returns The duration in milliseconds (rounded to the nearest millisecond)
+ * @throws Error if `value` is not a valid ISO 8601 duration
+ */
+export function parseISO(value: string): number {
+  if (typeof value !== 'string' || value.length === 0 || value.length > 100) {
+    throw new Error(
+      `Value provided to ms.parseISO() must be a non-empty string of at most 100 characters. value=${JSON.stringify(value)}`,
+    );
+  }
+  const fail = (): never => {
+    throw new Error(
+      `Invalid ISO 8601 duration. value=${JSON.stringify(value)}`,
+    );
+  };
+
+  let i = 0;
+  let sign = 1;
+  if (value[i] === '-' || value[i] === '+') {
+    if (value[i] === '-') sign = -1;
+    i++;
+  }
+  if (value[i] !== 'P') return fail();
+  i++;
+
+  const dateUnits: Record<string, [number, number]> = {
+    Y: [y, 0],
+    M: [mo, 1],
+    W: [w, 2],
+    D: [d, 3],
+  };
+  const timeUnits: Record<string, [number, number]> = {
+    H: [h, 0],
+    M: [m, 1],
+    S: [s, 2],
+  };
+
+  let inTime = false;
+  let lastOrder = -1;
+  let components = 0;
+  let timeComponents = 0;
+  let sawFraction = false;
+  let total = 0;
+
+  while (i < value.length) {
+    if (value[i] === 'T') {
+      if (inTime) return fail();
+      inTime = true;
+      lastOrder = -1;
+      i++;
+      continue;
+    }
+
+    // number: digits, optionally followed by '.' or ',' and more digits
+    const start = i;
+    while (isDigit(value[i])) i++;
+    if (i === start) return fail();
+    let numStr = value.slice(start, i);
+    let hasFraction = false;
+    if (value[i] === '.' || value[i] === ',') {
+      i++;
+      const fracStart = i;
+      while (isDigit(value[i])) i++;
+      if (i === fracStart) return fail();
+      numStr += `.${value.slice(fracStart, i)}`;
+      hasFraction = true;
+    }
+
+    const designator = value[i];
+    i++;
+    const entry =
+      designator === undefined
+        ? undefined
+        : Object.hasOwn(inTime ? timeUnits : dateUnits, designator)
+          ? (inTime ? timeUnits : dateUnits)[designator]
+          : undefined;
+    if (!entry) return fail();
+    const [unitMs, order] = entry;
+
+    // enforce ordering, and only the last component may be fractional
+    if (order <= lastOrder || sawFraction) return fail();
+    lastOrder = order;
+    if (hasFraction) sawFraction = true;
+
+    total += Number(numStr) * unitMs;
+    components++;
+    if (inTime) timeComponents++;
+  }
+
+  if (components === 0) return fail();
+  // a trailing 'T' with no time components is invalid
+  if (inTime && timeComponents === 0) return fail();
+
+  return sign * Math.round(total);
+}
