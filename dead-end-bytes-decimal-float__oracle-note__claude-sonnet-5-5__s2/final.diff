+
+/**
+ * Scale a decimal number string by 10^exp exactly (by moving the decimal
+ * point in the string) and floor the result.
+ *
+ * @param {string} sign
+ * @param {string} num
+ * @param {number} exp
+ * @private
+ */
+
+function parseDecimal(sign, num, exp) {
+  var parts = num.split('.');
+  var frac = parts[1] || '';
+  var digits = parts[0] + frac;
+  var shift = exp - frac.length;
+  var intStr;
+  var inexact = false;
+
+  if (shift >= 0) {
+    intStr = digits + new Array(shift + 1).join('0');
+  } else {
+    var cut = digits.length + shift;
+    intStr = cut > 0 ? digits.slice(0, cut) : '0';
+    inexact = /[1-9]/.test(cut > 0 ? digits.slice(cut) : digits);
+  }
+
+  var result = Number(intStr);
+
+  if (sign === '-') {
+    result = -result - (inexact ? 1 : 0);
+  }
+
+  return result || 0;
+}
diff --git a/test/byte-parse.js b/test/byte-parse.js
index cebfab2..58755dc 100644
--- a/test/byte-parse.js
+++ b/test/byte-parse.js
@@ -108,4 +108,46 @@ describe('Test byte parse function', function(){
   it('Should allow whitespace', function(){
     assert.equal(bytes.parse('1 TB'), 1 * Math.pow(1024, 4));
   });
+
+  describe('decimal option', function(){
+    var o = {decimal: true};
+
+    it('Should use powers of 1000', function(){
+      assert.strictEqual(bytes.parse('1kB', o), 1000);
+      assert.strictEqual(bytes.parse('1MB', o), 1e6);
+      assert.strictEqual(bytes.parse('1gb', o), 1e9);
+      assert.strictEqual(bytes.parse('1 TB', o), 1e12);
+      assert.strictEqual(bytes.parse('1pb', o), 1e15);
+      assert.strictEqual(bytes.parse('1b', o), 1);
+    });
+
+    it('Should scale fractions exactly', function(){
+      assert.strictEqual(bytes.parse('2.01 kB', o), 2010);
+      assert.strictEqual(bytes.parse('4.1 MB', o), 4100000);
+      assert.strictEqual(bytes.parse('0.5kb', o), 500);
+    });
+
+    it('Should floor fractional bytes', function(){
+      assert.strictEqual(bytes.parse('1.0005kb', o), 1000);
+      assert.strictEqual(bytes.parse('0.0001kb', o), 0);
+      assert.strictEqual(bytes.parse('-1.0005kb', o), -1001);
+      assert.strictEqual(bytes.parse('-1.5kb', o), -1500);
+    });
+
+    it('Should not change default behaviour', function(){
+      assert.strictEqual(bytes.parse('1kb', {decimal: false}), 1024);
+      assert.strictEqual(bytes.parse('1kb', {}), 1024);
+      assert.strictEqual(bytes.parse('1kb'), 1024);
+    });
+
+    it('Should handle plain numbers and invalid input', function(){
+      assert.strictEqual(bytes.parse('1024', o), 1024);
+      assert.strictEqual(bytes.parse(1024, o), 1024);
+      assert.strictEqual(bytes.parse('foobar', o), null);
+    });
+
+    it('Should work through bytes()', function(){
+      assert.strictEqual(bytes('2kB', o), 2000);
+    });
+  });
 });
