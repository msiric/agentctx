 ]
 """
     )
+
+
+def test_none_values_as_empty_string():
+    assert tomli_w.dumps({"a": None, "b": 1}) == 'a = ""\nb = 1\n'
+    assert tomli_w.dumps({"a": None}) == 'a = ""\n'
+    assert tomli_w.dumps({"t": {"a": None, "b": 1}}) == '[t]\na = ""\nb = 1\n'
+
+
+def test_none_in_aot():
+    out = tomli_w.dumps({"t": [{"a": None, "b": "x" * 100}]})
+    assert "[[t]]" in out and 'a = ""' in out
+
+
+def test_none_in_inline_table():
+    assert (
+        tomli_w.dumps({"t": [{"a": None, "b": 1}]})
+        == 't = [\n    { a = "", b = 1 },\n]\n'
+    )
+    assert tomli_w.dumps({"t": {"a": {"b": None}}}) == '[t.a]\nb = ""\n'
+
+
+def test_none_in_array():
+    assert tomli_w.dumps({"a": [1, None]}) == "a = [\n    1,\n    \"\",\n]\n"
+    assert tomli_w.dumps({"a": [None]}) == 'a = [\n    "",\n]\n'
+    assert tomli_w.dumps({"a": [[None]]}) == 'a = [\n    [\n        "",\n    ],\n]\n'
+    assert tomli_w.dumps({"a": (None, None)}) == 'a = [\n    "",\n    "",\n]\n'
+
+
+def test_none_roundtrip_to_empty_string():
+    import tomllib
+
+    data = {"a": None, "l": [None, 1], "t": {"x": None}}
+    assert tomllib.loads(tomli_w.dumps(data)) == {
+        "a": "",
+        "l": ["", 1],
+        "t": {"x": ""},
+    }
+
+
+def test_none_dump():
+    import io
+
+    buf = io.BytesIO()
+    tomli_w.dump({"a": None, "b": 1}, buf)
+    assert buf.getvalue() == b'a = ""\nb = 1\n'
+
+
+def test_pathlib_paths():
+    import pathlib
+
+    assert tomli_w.dumps({"p": pathlib.PurePosixPath("/a/b")}) == 'p = "/a/b"\n'
+    assert tomli_w.dumps({"p": pathlib.Path("a") / "b"}) == f'p = "{pathlib.Path("a", "b")}"\n'
+    assert (
+        tomli_w.dumps({"p": pathlib.PureWindowsPath("C:/x/y")}) == 'p = "C:\\\\x\\\\y"\n'
+    )
+    assert tomli_w.dumps({"t": {"p": [pathlib.PurePosixPath("a")]}}) == (
+        '[t]\np = [\n    "a",\n]\n'
+    )
