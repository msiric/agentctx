+def gigabytes(num_bytes: float | str, precision: int = 1) -> str:
+    """Format a number of bytes as decimal gigabytes (10**9 bytes), e.g. '1.5 GB'.
+
+    Ties round half up (away from zero), consistent with `percent`.
+
+    Examples:
+        ```pycon
+        >>> gigabytes(1500000000)
+        '1.5 GB'
+        >>> gigabytes(0)
+        '0.0 GB'
+        >>> gigabytes(1234567890, 2)
+        '1.23 GB'
+        >>> gigabytes(1250000000)
+        '1.3 GB'
+        >>> gigabytes(2500000000, 0)
+        '3 GB'
+        >>> gigabytes(-1500000000)
+        '-1.5 GB'
+
+        ```
+
+    Args:
+        num_bytes (int, float, str): Number of bytes.
+        precision (int): Number of decimal places.
+
+    Returns:
+        str: The size in gigabytes, always using the GB unit.
+
+    Raises:
+        ValueError: If `num_bytes` is not a finite number.
+    """
+    from decimal import ROUND_HALF_UP, Decimal
+    from math import isfinite
+
+    value = float(num_bytes)
+    if not isfinite(value):
+        msg = f"num_bytes must be finite, got {num_bytes!r}"
+        raise ValueError(msg)
+    if isinstance(num_bytes, int):
+        exact = Decimal(num_bytes)
+    else:
+        exact = Decimal(repr(value))
+    quantum = Decimal(1).scaleb(-int(precision))
+    rounded = (exact.scaleb(-9)).quantize(quantum, rounding=ROUND_HALF_UP)
+    # Adding zero turns a "-0.0" result into "0.0".
+    return f"{rounded + 0:f} GB"
