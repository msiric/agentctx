     assert humanize.naturalsize(*test_args) == "-" + expected
+
+
+@pytest.mark.parametrize(
+    "test_args, expected",
+    [
+        ([0], "0.0 GB"),
+        ([1500000000], "1.5 GB"),
+        ([10**9], "1.0 GB"),
+        ([1234567890, 2], "1.23 GB"),
+        ([123456789012], "123.5 GB"),
+        # Ties round half up, consistent with humanize.percent.
+        ([1250000000], "1.3 GB"),
+        ([2500000000, 0], "3 GB"),
+        ([1250000000.0], "1.3 GB"),
+        ([499999999, 0], "0 GB"),
+        (["1500000000"], "1.5 GB"),
+        ([1500000000.0], "1.5 GB"),
+        ([-1500000000], "-1.5 GB"),
+        ([-1250000000], "-1.3 GB"),
+        ([-1], "0.0 GB"),
+    ],
+    ids=str,
+)
+def test_gigabytes(test_args: list[int | float | str], expected: str) -> None:
+    assert humanize.gigabytes(*test_args) == expected
+
+
+@pytest.mark.parametrize("value", [float("nan"), float("inf"), float("-inf")])
+def test_gigabytes_not_finite(value: float) -> None:
+    with pytest.raises(ValueError, match="finite"):
+        humanize.gigabytes(value)
