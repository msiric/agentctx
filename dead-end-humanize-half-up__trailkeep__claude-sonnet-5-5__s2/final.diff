+def percent(value: NumberOrString, precision: int = 1) -> str:
+    """Format a fraction as a percentage.
+
+    Examples:
+        ```pycon
+        >>> percent(0.125)
+        '12.5%'
+        >>> percent(0.5)
+        '50.0%'
+        >>> percent(1)
+        '100.0%'
+        >>> percent(0.5, 0)
+        '50%'
+        >>> percent(0.12345, 3)
+        '12.345%'
+        >>> percent(0.0625)
+        '6.3%'
+        >>> percent("0.25")
+        '25.0%'
+        >>> percent("foo")
+        'foo'
+        >>> percent(None)
+        'None'
+
+        ```
+
+    Args:
+        value (int, float, str): Fraction to format, where 1 is 100%.
+        precision (int): Number of decimal places.
+
+    Returns:
+        str: The value as a percentage, or the str output of the value if it could
+            not be converted.
+    """
+    import math
+
+    try:
+        value = float(value)
+        if not math.isfinite(value):
+            return _format_not_finite(value)
+    except (ValueError, TypeError):
+        return str(value)
+    # Round half away from zero on the shortest decimal repr of the input, so
+    # 0.0625 -> 6.3% rather than the 6.2% that float formatting gives.
+    from decimal import ROUND_HALF_UP, Decimal
+
+    percentage = Decimal(repr(value)).scaleb(2)
+    quantum = Decimal(1).scaleb(-int(precision))
+    rounded = percentage.quantize(quantum, rounding=ROUND_HALF_UP)
+    # Adding zero turns a "-0.0" result into "0.0".
+    return f"{rounded + 0:f}%"
+
