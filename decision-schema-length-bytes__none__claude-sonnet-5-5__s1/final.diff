+def test_length():
+    assert Length(min=2, max=4).validate("ab") == "ab"
+    assert Length(min=2, max=4).validate("abcd") == "abcd"
+    with SE:
+        Length(min=2, max=4).validate("a")
+    with SE:
+        Length(min=2, max=4).validate("abcde")
+    assert Length(min=2).validate("x" * 100) == "x" * 100
+    with SE:
+        Length(min=2).validate("a")
+    assert Length(max=2).validate("") == ""
+    with SE:
+        Length(max=2).validate("abc")
+    assert Length().validate("anything") == "anything"
+    assert Length(min=0, max=0).validate("") == ""
+
+    # Non-strings are rejected
+    for bad in (1, None, [], {}, b"ab"):
+        with SE:
+            Length(min=0).validate(bad)
+
+    with raises(ValueError):
+        Length(min=3, max=2)
+
+    # Custom error and use inside a Schema
+    with raises(SchemaError, match="too short: a"):
+        Length(min=2, error="too short: {}").validate("a")
+    assert Schema({"name": Length(min=1, max=3)}).validate({"name": "bob"}) == {
+        "name": "bob"
+    }
