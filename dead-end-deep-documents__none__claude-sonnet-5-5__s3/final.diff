--- a/xmltodict.py
+++ b/xmltodict.py
@@ -655,3 +655,27 @@ if __name__ == '__main__':  # pragma: no cover
             handle_item([], root)
     except KeyboardInterrupt:
         pass
+
+
+def drop_keys(doc, names):
+    """Return a copy of `doc` with every key in `names` removed at any depth.
+
+    Attribute keys are matched literally, so pass '@id' (including the
+    `attr_prefix`) to drop an attribute. Dicts nested inside lists/tuples are
+    processed too. The input is never mutated; containers are rebuilt, while
+    leaf values are shared.
+    """
+    if isinstance(names, (str, bytes)):
+        names = [names]
+    names = frozenset(names)
+
+    def _drop(node):
+        if isinstance(node, dict):
+            return {k: _drop(v) for k, v in node.items() if k not in names}
+        if isinstance(node, list):
+            return [_drop(v) for v in node]
+        if isinstance(node, tuple):
+            return tuple(_drop(v) for v in node)
+        return node
+
+    return _drop(doc)
