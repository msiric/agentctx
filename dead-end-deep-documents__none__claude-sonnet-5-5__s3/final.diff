index 0000000..ea945a9
--- /dev/null
+++ b/tests/test_drop_keys.py
@@ -0,0 +1,51 @@
+import copy
+
+from xmltodict import drop_keys, parse
+
+
+def test_drops_top_level_and_nested():
+    doc = {'a': {'b': '1', 'c': {'b': '2', 'd': '3'}}, 'b': 'x'}
+    assert drop_keys(doc, ['b']) == {'a': {'c': {'d': '3'}}}
+
+
+def test_drops_attribute_keys():
+    doc = parse('<r id="1"><i id="2" n="x">t</i><i id="3"/></r>')
+    assert drop_keys(doc, ['@id']) == {
+        'r': {'i': [{'@n': 'x', '#text': 't'}, {}]}}
+
+
+def test_drops_inside_lists_and_tuples():
+    doc = {'a': [{'x': 1, 'y': 2}, [{'x': 3}], ({'x': 4, 'z': 5},)]}
+    assert drop_keys(doc, {'x'}) == {'a': [{'y': 2}, [{}], ({'z': 5},)]}
+
+
+def test_multiple_names_and_missing_names():
+    doc = {'a': 1, 'b': 2, 'c': 3}
+    assert drop_keys(doc, ['a', 'c', 'nope']) == {'b': 2}
+
+
+def test_empty_names_returns_equal_copy():
+    doc = {'a': {'b': [1, 2]}}
+    result = drop_keys(doc, [])
+    assert result == doc
+    assert result is not doc
+    assert result['a'] is not doc['a']
+    assert result['a']['b'] is not doc['a']['b']
+
+
+def test_string_names_is_single_name():
+    assert drop_keys({'ab': 1, 'a': 2, 'b': 3}, 'ab') == {'a': 2, 'b': 3}
+
+
+def test_does_not_mutate_input():
+    doc = {'a': {'@id': '1', 'b': [{'@id': '2', 'c': 'x'}]}, '@id': '0'}
+    snapshot = copy.deepcopy(doc)
+    result = drop_keys(doc, ['@id', 'c'])
+    assert doc == snapshot
+    assert result == {'a': {'b': [{}]}}
+
+
+def test_non_dict_inputs():
+    assert drop_keys('text', ['a']) == 'text'
+    assert drop_keys(None, ['a']) is None
+    assert drop_keys([{'a': 1, 'b': 2}], ['a']) == [{'b': 2}]
