+"""Benchmark TinyDB read performance on a large JSON db.
+
+Usage: python scripts/bench_read.py [--size-mb 40] [--repeat 3] [--keep]
+"""
+import argparse
+import cProfile
+import json
+import os
+import pstats
+import random
+import sys
+import tempfile
+import time
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))
+
+from tinydb import TinyDB, where  # noqa: E402
+
+
+def generate(path, size_mb):
+    rng = random.Random(0)
+    db = TinyDB(path)
+    target = size_mb * 1024 * 1024
+    batch = []
+    while True:
+        for i in range(2000):
+            batch.append({
+                'name': ''.join(rng.choices('abcdefghij', k=12)),
+                'age': rng.randint(0, 99),
+                'tags': [rng.choice('xyz') for _ in range(5)],
+                'bio': ''.join(rng.choices('abcdefgh ', k=120)),
+            })
+        db.insert_multiple(batch)
+        batch = []
+        if os.path.getsize(path) >= target:
+            break
+    n = len(db)
+    db.close()
+    return n
+
+
+def timed(fn, repeat):
+    best = float('inf')
+    for _ in range(repeat):
+        t = time.perf_counter()
+        fn()
+        best = min(best, time.perf_counter() - t)
+    return best
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--size-mb', type=int, default=40)
+    ap.add_argument('--repeat', type=int, default=3)
+    ap.add_argument('--keep', action='store_true')
+    args = ap.parse_args()
+
+    d = tempfile.mkdtemp(prefix='tinydb-bench-')
+    path = os.path.join(d, 'db.json')
+    print(f'generating ~{args.size_mb}MB db at {path} ...')
+    n = generate(path, args.size_mb)
+    print(f'{n} docs, {os.path.getsize(path) / 1e6:.1f} MB\n')
+
+    db = TinyDB(path)
+    raw = db.storage
+
+    def parse_only():
+        raw.read()
+
+    def read_text():
+        raw._handle.seek(0)
+        raw._handle.read()
+
+    t_text = timed(read_text, args.repeat)
+    t_parse = timed(parse_only, args.repeat)
+    t_all = timed(lambda: db.all(), args.repeat)
+
+    counter = [0]
+
+    def uncached_search():
+        counter[0] += 1  # distinct query each time defeats the query cache
+        db.search(where('age') == (counter[0] % 100))
+
+    t_search = timed(uncached_search, args.repeat)
+    db.search(where('age') == 5)
+    t_cached = timed(lambda: db.search(where('age') == 5), args.repeat)
+
+    print(f'{"file read (text only)":34s}{t_text * 1000:10.1f} ms')
+    print(f'{"storage.read() (read+json parse)":34s}{t_parse * 1000:10.1f} ms')
+    print(f'{"db.all()":34s}{t_all * 1000:10.1f} ms')
+    print(f'{"db.search() uncached":34s}{t_search * 1000:10.1f} ms')
+    print(f'{"db.search() cached":34s}{t_cached * 1000:10.1f} ms')
+    print(f'\nparse share of db.all():    {t_parse / t_all:.0%}')
+    print(f'parse share of search():    {t_parse / t_search:.0%}')
+
+    print('\n--- cProfile: uncached search ---')
+    pr = cProfile.Profile()
+    pr.enable()
+    uncached_search()
+    pr.disable()
+    pstats.Stats(pr).sort_stats('cumulative').print_stats(8)
+
+    db.close()
+    if not args.keep:
+        os.remove(path)
+        os.rmdir(d)
+
+
+if __name__ == '__main__':
+    main()
