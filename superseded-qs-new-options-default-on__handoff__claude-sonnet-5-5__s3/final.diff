@@ -230,6 +230,37 @@ queryString.parse('foo=true', {parseBooleans: true});
 
 Parse the value as a boolean type instead of string type if it's a boolean.
 
+##### ignoreEmpty
+
+Type: `boolean`\
+Default: `false`
+
+```js
+import queryString from 'query-string';
+
+queryString.parse('q=&page=2&flag', {ignoreEmpty: true});
+//=> {flag: null, page: '2'}
+```
+
+Drop parameters with an empty value. A key without `=` (`?flag`) has a `null` value, which is not empty, so it is kept.
+
+##### stripTracking
+
+Type: `boolean`\
+Default: `true`
+
+```js
+import queryString from 'query-string';
+
+queryString.parse('q=a&utm_source=x&fbclid=1');
+//=> {q: 'a'}
+
+queryString.parse('q=a&utm_source=x', {stripTracking: false});
+//=> {q: 'a', utm_source: 'x'}
+```
+
+Drop tracking parameters: `utm_*`, `fbclid`, and `gclid`. The key is matched after decoding, without regard to case. `pick()` and `exclude()` never strip them.
+
 ##### types
 
 Type: `object`\
diff --git a/test/parse.js b/test/parse.js
index 00a1abf..887e70f 100644
--- a/test/parse.js
+++ b/test/parse.js
@@ -1492,3 +1492,41 @@ test('rejects an invalid `arrayFormatSeparator`', () => {
 
 	assert.deepEqual(structuredClone(queryString.parse('foo=a·b', {arrayFormat: 'separator', arrayFormatSeparator: '·'})), {foo: ['a', 'b']});
 });
+
+test('ignoreEmpty drops parameters with an empty value', () => {
+	assert.deepEqual(structuredClone(queryString.parse('?q=&page=2', {ignoreEmpty: true})), {page: '2'});
+	assert.deepEqual(structuredClone(queryString.parse('?q=&page=2')), {page: '2', q: ''});
+	assert.deepEqual(structuredClone(queryString.parse('?flag&q=&page=2', {ignoreEmpty: true})), {flag: null, page: '2'});
+	assert.deepEqual(structuredClone(queryString.parse('?q=', {ignoreEmpty: true})), {});
+	assert.deepEqual(structuredClone(queryString.parse('?a=&a=1&a=', {ignoreEmpty: true})), {a: '1'});
+	assert.deepEqual(structuredClone(queryString.parse('?a[]=&a[]=1', {ignoreEmpty: true, arrayFormat: 'bracket'})), {a: ['1']});
+	assert.deepEqual(structuredClone(queryString.parse('?a=&b=1', {ignoreEmpty: true, arrayFormat: 'comma'})), {b: '1'});
+	assert.deepEqual(structuredClone(queryString.parse('?a=%20&b=', {ignoreEmpty: true})), {a: ' '});
+});
+
+test('ignoreEmpty is opt-in', () => {
+	const expected = {flag: null, page: '2', q: ''};
+	assert.deepEqual(structuredClone(queryString.parse('?q=&page=2&flag')), expected);
+	assert.deepEqual(structuredClone(queryString.parse('?q=&page=2&flag', {ignoreEmpty: false})), expected);
+	assert.deepEqual(structuredClone(queryString.parse('?q=&page=2&flag', {ignoreEmpty: undefined})), expected);
+	assert.deepEqual(structuredClone(queryString.parseUrl('/?q=&page=2&flag').query), expected);
+});
+
+test('stripTracking drops tracking parameters by default', () => {
+	assert.deepEqual(structuredClone(queryString.parse('?q=a&utm_source=x&utm_medium=y&fbclid=1&gclid=2')), {q: 'a'});
+	assert.deepEqual(structuredClone(queryString.parse('?q=a&UTM_Source=x&utm%5Fterm=y&FBCLID=1')), {q: 'a'});
+	assert.deepEqual(structuredClone(queryString.parse('?utm_x&q=a', {stripTracking: true})), {q: 'a'});
+	assert.deepEqual(structuredClone(queryString.parse('?utm_a[]=1&utm_a[]=2&q=a', {arrayFormat: 'bracket'})), {q: 'a'});
+	assert.deepEqual(structuredClone(queryString.parseUrl('/?q=a&gclid=2').query), {q: 'a'});
+});
+
+test('stripTracking keeps lookalike keys and can be turned off', () => {
+	assert.deepEqual(structuredClone(queryString.parse('?utm=1&xutm_a=2&fbclid2=3&gclid_=4')), Object.fromEntries([['fbclid2', '3'], ['gclid_', '4'], ['utm', '1'], ['xutm_a', '2']]));
+	assert.deepEqual(structuredClone(queryString.parse('?q=a&utm_source=x&fbclid=1', {stripTracking: false})), Object.fromEntries([['fbclid', '1'], ['q', 'a'], ['utm_source', 'x']]));
+	assert.deepEqual(structuredClone(queryString.parse('?q=a&utm_source=x&fbclid=1', {stripTracking: undefined, ignoreEmpty: true})), {q: 'a'});
+});
+
+test('pick and exclude keep tracking parameters', () => {
+	assert.equal(queryString.pick('/?a=1&utm_source=x', ['a', 'utm_source']), '/?a=1&utm_source=x');
+	assert.equal(queryString.exclude('/?a=1&utm_source=x', ['a']), '/?utm_source=x');
+});
