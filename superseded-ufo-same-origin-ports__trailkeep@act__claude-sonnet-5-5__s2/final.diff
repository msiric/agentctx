+
+const ORIGIN_PROTOCOLS = new Set(["http:", "https:", "ws:", "wss:", "ftp:"]);
+
+function getOrigin(input: unknown): string | undefined {
+  if (typeof input !== "string") {
+    return undefined;
+  }
+  try {
+    const url = new URL(input);
+    // Only network schemes have a tuple origin (excludes data:, blob:, file:, ...)
+    return ORIGIN_PROTOCOLS.has(url.protocol) ? url.origin : undefined;
+  } catch {
+    return undefined;
+  }
+}
+
+/**
+ * Checks if two URLs share the same origin (scheme, host and port).
+ *
+ * Default ports are normalized (`https://a.com` equals `https://a.com:443`).
+ * Path, query, hash and userinfo are ignored. Relative, protocol-relative and
+ * opaque-origin inputs (`data:`, `blob:`, `file:`, ...) never match.
+ *
+ * @example
+ * ```js
+ * isSameOrigin("https://a.com/x", "https://a.com:443/y")
+ * // Returns true
+ * ```
+ *
+ * @group utils
+ */
+export function isSameOrigin(a: string, b: string): boolean {
+  const originA = getOrigin(a);
+  return originA !== undefined && originA === getOrigin(b);
+}
