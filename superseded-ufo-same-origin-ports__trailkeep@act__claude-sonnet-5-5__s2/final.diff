diff --git a/test/same-origin.test.ts b/test/same-origin.test.ts
new file mode 100644
index 0000000..f1e2422
--- /dev/null
+++ b/test/same-origin.test.ts
@@ -0,0 +1,103 @@
+import { describe, expect, test } from "vitest";
+import { isSameOrigin } from "../src";
+
+// Proposed semantics: two URLs are same-origin when scheme, host and port match.
+// - Path, query, hash and userinfo are ignored
+// - Scheme and host are case-insensitive
+// - Default ports are normalized: `https://a.com` and `https://a.com:443`
+//   are the same origin (CDN rewrites links with an explicit port)
+// - Relative / scheme-less / protocol-relative inputs have no origin => false
+// - Opaque origins (data:, blob:, file:, javascript:, etc.) => false, even if identical
+
+const sameOrigin: [string, string][] = [
+  // Identical
+  ["https://example.com", "https://example.com"],
+  ["https://example.com/", "https://example.com"],
+  // Path, query, hash ignored
+  ["https://example.com/a?x=1#h", "https://example.com/b/c?y=2#g"],
+  // Userinfo ignored
+  ["https://user:pass@example.com/", "https://example.com/"],
+  // Case-insensitive scheme and host
+  ["HTTPS://EXAMPLE.COM/", "https://example.com/"],
+  ["https://Example.Com", "https://eXample.cOm"],
+  // Default-port normalization
+  ["https://example.com", "https://example.com:443"],
+  ["http://example.com", "http://example.com:80"],
+  ["wss://example.com", "wss://example.com:443"],
+  ["ws://example.com", "ws://example.com:80"],
+  // Identical explicit ports
+  ["https://example.com:443/a", "https://example.com:443/b"],
+  // Explicit non-default ports
+  ["http://localhost:3000/a", "http://localhost:3000/b"],
+  // IP hosts
+  ["http://127.0.0.1:8080/a", "http://127.0.0.1:8080/b"],
+  ["http://[::1]:8080/a", "http://[::1]:8080/b"],
+];
+
+const differentOrigin: [string, string][] = [
+  // Scheme
+  ["http://example.com", "https://example.com"],
+  ["ws://example.com", "wss://example.com"],
+  // Host
+  ["https://example.com", "https://example.org"],
+  // Subdomains are distinct origins
+  ["https://example.com", "https://www.example.com"],
+  ["https://a.example.com", "https://b.example.com"],
+  // Host suffix trickery
+  ["https://example.com", "https://example.com.evil.com"],
+  ["https://example.com", "https://evilexample.com"],
+  // Userinfo must not be mistaken for host
+  ["https://example.com", "https://example.com@evil.com"],
+  ["https://example.com@evil.com", "https://example.com"],
+  // Port
+  ["https://example.com:8443", "https://example.com"],
+  ["http://localhost:3000", "http://localhost:3001"],
+  // Default ports are not interchangeable across schemes
+  ["http://example.com:443", "http://example.com"],
+  ["https://example.com:80", "https://example.com"],
+  // IP hosts
+  ["http://127.0.0.1", "http://localhost"],
+];
+
+const noOrigin: [string | undefined, string | undefined][] = [
+  // Relative paths
+  ["/a", "/a"],
+  ["a/b", "a/b"],
+  ["./a", "./a"],
+  ["", ""],
+  // Relative vs absolute
+  ["/a", "https://example.com/a"],
+  ["https://example.com/a", "/a"],
+  // Scheme-less host
+  ["example.com", "example.com"],
+  // Protocol-relative (no scheme to compare)
+  ["//example.com", "//example.com"],
+  ["//example.com", "https://example.com"],
+  // Nullish
+  [undefined, undefined],
+  [undefined, "https://example.com"],
+  ["https://example.com", undefined],
+  // Opaque origins
+  ["data:text/plain,hi", "data:text/plain,hi"],
+  ["blob:https://example.com/uuid", "blob:https://example.com/uuid"],
+  ["file:///a", "file:///a"],
+  ["javascript:void(0)", "javascript:void(0)"],
+  ["mailto:a@example.com", "mailto:a@example.com"],
+];
+
+describe("isSameOrigin", () => {
+  test.each(sameOrigin)("%s === %s", (a, b) => {
+    expect(isSameOrigin(a, b)).toBe(true);
+    expect(isSameOrigin(b, a)).toBe(true);
+  });
+
+  test.each(differentOrigin)("%s !== %s", (a, b) => {
+    expect(isSameOrigin(a, b)).toBe(false);
+    expect(isSameOrigin(b, a)).toBe(false);
+  });
+
+  test.each(noOrigin)("no origin: %s vs %s", (a, b) => {
+    expect(isSameOrigin(a as string, b as string)).toBe(false);
+    expect(isSameOrigin(b as string, a as string)).toBe(false);
+  });
+});
