+import { describe, expect, it } from '@jest/globals';
+import { parseCompound } from './index';
+
+describe('parseCompound(string)', () => {
+  it('should parse "1h 30m"', () => {
+    expect(parseCompound('1h 30m')).toBe(5400000);
+  });
+
+  it('should parse long units with spaces', () => {
+    expect(parseCompound('2 days 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
+  });
+
+  it('should parse pieces without separators', () => {
+    expect(parseCompound('1h30m')).toBe(5400000);
+  });
+
+  it('should parse three or more pieces', () => {
+    expect(parseCompound('1d 2h 3m 4s 5ms')).toBe(
+      86400000 + 2 * 3600000 + 3 * 60000 + 4000 + 5,
+    );
+  });
+
+  it('should be case-insensitive and tolerate extra whitespace', () => {
+    expect(parseCompound('  1H   30 MIN ')).toBe(5400000);
+  });
+
+  it('should accept commas between parts', () => {
+    expect(parseCompound('1h, 30m')).toBe(5400000);
+    expect(parseCompound('1h,30m')).toBe(5400000);
+    expect(parseCompound('2 days , 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
+  });
+
+  it('should support decimals and negatives', () => {
+    expect(parseCompound('1.5h 30m')).toBe(7200000);
+    expect(parseCompound('-1h -30m')).toBe(-5400000);
+  });
+
+  it('should defer to parse for single values', () => {
+    expect(parseCompound('1h')).toBe(3600000);
+    expect(parseCompound('100')).toBe(100);
+  });
+
+  it('should throw a TypeError including the input for invalid durations', () => {
+    for (const bad of ['abc', '1h foo', '1h 30', '1h 30x', ',1h', '1h,', '1h,,30m']) {
+      expect(() => parseCompound(bad)).toThrow(TypeError);
+      expect(() => parseCompound(bad)).toThrow(JSON.stringify(bad));
+    }
+  });
+
+  it('should throw a TypeError for empty, too long, and non-string input', () => {
+    expect(() => parseCompound('')).toThrow(TypeError);
+    expect(() => parseCompound('')).toThrow('value=""');
+    expect(() => parseCompound('1h '.repeat(40))).toThrow(TypeError);
+    // @ts-expect-error - testing runtime behavior
+    expect(() => parseCompound(1)).toThrow(TypeError);
+  });
+});
