+/**
+ * Parse a compound duration such as `"1h 30m"`, `"1h, 30m"` or `"2 days 4 hours"` and
+ * return the total in milliseconds. Each piece is parsed with `parse`.
+ *
+ * Plain single values like `"1h"` or `"100"` are handled by `parse` directly.
+ *
+ * @param str - A compound duration string
+ * @returns The total in milliseconds (never `NaN`)
+ * @throws TypeError if `str` is not a non-empty string of at most 99
+ * characters, or can't be parsed as a duration
+ */
+export function parseCompound(str: string): number {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw new TypeError(
+      `Value provided to ms.parseCompound() must be a string with length between 1 and 99. value=${JSON.stringify(str)}`,
+    );
+  }
+
+  const piece = '-?\\d*\\.?\\d+ *[a-z]+';
+  // Parts may be separated by whitespace and/or a single comma.
+  const compound = new RegExp(
+    `^\\s*${piece}(?:(?:\\s*,\\s*|\\s*)${piece})*\\s*$`,
+    'i',
+  );
+  const total = compound.test(str)
+    ? (str.match(new RegExp(piece, 'gi')) as string[]).reduce(
+        (sum, part) => sum + parse(part),
+        0,
+      )
+    : parse(str);
+
+  if (Number.isNaN(total)) {
+    throw new TypeError(
+      `Value provided to ms.parseCompound() is not a valid duration. value=${JSON.stringify(str)}`,
+    );
+  }
+  return total;
+}
+
+/**
+ * Parse a timer-style clock string and return the total in milliseconds.
+ *
+ * `"m:ss"` (e.g. `"1:30"`) and `"h:mm:ss"` (e.g. `"01:02:03"`) are supported.
+ * Seconds may have a fractional part (`"1:30.5"`). Seconds must be below 60,
+ * and minutes must be below 60 when hours are present. The leading field has
+ * no upper bound.
+ *
+ * @param str - A clock string
+ * @returns The total in milliseconds
+ * @throws TypeError if `str` is not a non-empty string of at most 99
+ * characters, or isn't a valid clock string
+ */
+export function parseClock(str: string): number {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw new TypeError(
+      `Value provided to ms.parseClock() must be a string with length between 1 and 99. value=${JSON.stringify(str)}`,
+    );
+  }
+
+  const match =
+    /^(?:(?<hours>\d+):(?<minutes>[0-5]\d)|(?<minutesOnly>\d+)):(?<seconds>[0-5]\d(?:\.\d+)?)$/.exec(
+      str,
+    );
+
+  if (!match?.groups) {
+    throw new TypeError(
+      `Value provided to ms.parseClock() is not a valid clock duration (expected "m:ss" or "h:mm:ss"). value=${JSON.stringify(str)}`,
+    );
+  }
+
+  const { hours, minutes, minutesOnly, seconds } = match.groups as {
+    hours: string | undefined;
+    minutes: string | undefined;
+    minutesOnly: string | undefined;
+    seconds: string;
+  };
+
+  return (
+    Number(hours ?? 0) * h +
+    Number(minutes ?? minutesOnly) * m +
+    parseFloat(seconds) * s
+  );
+}
+
