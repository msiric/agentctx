 ```
 
+- `'json'`: Decode the value as JSON. A value that is not valid JSON stays a string. An integer beyond `Number.MAX_SAFE_INTEGER`, like a 64-bit ID, is returned as a `bigint` instead of being rounded.
+
+```js
+import queryString from 'query-string';
+
+queryString.parse('filter=%7B%22accountId%22%3A1274593846275813376%2C%22active%22%3Atrue%7D&bad=%7Boops', {
+	types: {
+		filter: 'json',
+		bad: 'json',
+	},
+});
+//=> {bad: '{oops', filter: {accountId: 1274593846275813376n, active: true}}
+```
+
 NOTE: With `arrayFormat: 'none'`, array types (`string[]`, `number[]`) do not turn a single value into an array. The value stays a string, and `parseNumbers` and `parseBooleans` do not apply to it. A repeated key is still an array, and its items are parsed with the element type.
 
 ```js
diff --git a/test/parse.js b/test/parse.js
index 00a1abf..f546537 100644
--- a/test/parse.js
+++ b/test/parse.js
@@ -1492,3 +1492,34 @@ test('rejects an invalid `arrayFormatSeparator`', () => {
 
 	assert.deepEqual(structuredClone(queryString.parse('foo=a·b', {arrayFormat: 'separator', arrayFormatSeparator: '·'})), {foo: ['a', 'b']});
 });
+
+test('`json` type decodes the value', () => {
+	const parse = query => queryString.parse(query, {types: {filter: 'json'}});
+	assert.deepEqual(parse('filter=%7B%22a%22%3A%5B1%2Cnull%5D%7D').filter, {a: [1, null]});
+	assert.equal(parse('filter=true').filter, true);
+	assert.equal(parse('filter=1.5').filter, 1.5);
+	assert.equal(parse('filter=%22x%22').filter, 'x');
+	assert.equal(parse('filter=null').filter, null);
+});
+
+test('`json` type keeps invalid JSON as a string', () => {
+	assert.equal(queryString.parse('filter=%7Boops', {types: {filter: 'json'}}).filter, '{oops');
+	assert.equal(queryString.parse('filter=', {types: {filter: 'json'}}).filter, '');
+	assert.equal(queryString.parse('filter', {types: {filter: 'json'}}).filter, null);
+	assert.equal(queryString.parse('filter=1', {parseNumbers: true, types: {filter: 'json'}}).filter, 1);
+});
+
+test('`json` type keeps integers beyond the safe range exact', () => {
+	const {filter} = queryString.parse('filter=%7B%22accountId%22%3A1274593846275813376%2C%22n%22%3A-9007199254740993%2C%22safe%22%3A42%2C%22f%22%3A1.5%7D', {types: {filter: 'json'}});
+	assert.deepEqual(filter, {
+		accountId: 1_274_593_846_275_813_376n,
+		n: -9_007_199_254_740_993n,
+		safe: 42,
+		f: 1.5,
+	});
+	assert.equal(queryString.parse('filter=9007199254740993', {types: {filter: 'json'}}).filter, 9_007_199_254_740_993n);
+});
+
+test('`json` type applies to each item of a repeated key', () => {
+	assert.deepEqual(structuredClone(queryString.parse('filter=1&filter=%5B2%5D&filter=x', {types: {filter: 'json'}})), {filter: [1, [2], 'x']});
+});
