diff --git a/tests/test_none.py b/tests/test_none.py
new file mode 100644
index 0000000..b7eb311
--- /dev/null
+++ b/tests/test_none.py
@@ -0,0 +1,47 @@
+import io
+
+import tomli_w
+
+
+def test_none_in_tables():
+    obj = {"a": 1, "b": None, "t": {"x": None, "y": 2}, "e": {"z": None}}
+    assert tomli_w.dumps(obj) == (
+        'a = 1\nb = ""\n\n[t]\nx = ""\ny = 2\n\n[e]\nz = ""\n'
+    )
+
+
+def test_none_in_inline_tables():
+    obj = {"i": {"k": None}, "m": [{"x": 1, "y": None}]}
+    assert tomli_w.dumps(obj) == (
+        'm = [\n    { x = 1, y = "" },\n]\n\n[i]\nk = ""\n'
+    )
+
+
+def test_none_in_aot():
+    obj = {"a": [{"x": None, "y": 1}, {"y": None}]}
+    assert tomli_w.dumps(obj) == (
+        'a = [\n    { x = "", y = 1 },\n    { y = "" },\n]\n'
+    )
+
+
+def test_none_in_arrays():
+    assert tomli_w.dumps({"a": [1, None]}) == 'a = [\n    1,\n    "",\n]\n'
+    assert tomli_w.dumps({"a": [[None]]}) == 'a = [\n    [\n        "",\n    ],\n]\n'
+    assert tomli_w.dumps({"a": (None, None)}) == 'a = [\n    "",\n    "",\n]\n'
+
+
+def test_none_dump():
+    buf = io.BytesIO()
+    tomli_w.dump({"a": None, "b": 1}, buf)
+    assert buf.getvalue() == b'a = ""\nb = 1\n'
+
+
+def test_none_round_trip_as_empty_string():
+    import tomllib
+
+    obj = {"a": None, "l": [None, 1], "t": {"k": None}}
+    assert tomllib.loads(tomli_w.dumps(obj)) == {
+        "a": "",
+        "l": ["", 1],
+        "t": {"k": ""},
+    }
