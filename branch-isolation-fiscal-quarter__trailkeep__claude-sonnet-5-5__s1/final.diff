+var MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
+
+var DAYS = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
+
 var MAP = {
 	YYYY: 'getFullYear',
 	YY: 'getYear',
 	MM: function (d) {
 		return d.getMonth() + 1;
 	},
+	MMM: function (d) {
+		return MONTHS[d.getMonth()];
+	},
+	ddd: function (d) {
+		return DAYS[d.getDay()];
+	},
+	Q: function (d) {
+		// Australian financial year: starts 1 July (Jul-Sep = Q1 ... Apr-Jun = Q4)
+		return Math.floor(((d.getMonth() + 6) % 12) / 3) + 1;
+	},
