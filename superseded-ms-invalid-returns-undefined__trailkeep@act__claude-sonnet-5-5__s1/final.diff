+/**
+ * Parse a compound duration such as `"1h 30m"`, `"1h, 30m"` or `"2 days 4 hours"` and
+ * return the total in milliseconds. Each piece is parsed with `parse`.
+ *
+ * @param str - A string of one or more number+unit pieces. When there are
+ * multiple pieces, each one must have a unit.
+ * @returns The total in milliseconds
+ * @throws TypeError if `str` is not a non-empty string or can't be parsed
+ */
+export function parseCompound(str: string): number {
+  const fail = (): never => {
+    throw new TypeError(
+      `Value provided to ms.parseCompound() must be a valid compound duration like "1h 30m". value=${JSON.stringify(str)}`,
+    );
+  };
+  if (typeof str !== 'string' || str.trim().length === 0) {
+    return fail();
+  }
+  const piece = /\s*(-?\d*\.?\d+ *[a-z]*)\s*(,?)\s*/giy;
+  const pieces: string[] = [];
+  let end = 0;
+  while (end < str.length) {
+    piece.lastIndex = end;
+    const match = piece.exec(str);
+    if (!match) {
+      return fail();
+    }
+    pieces.push(match[1] as string);
+    end = piece.lastIndex;
+    // A comma may separate pieces, but must be followed by another piece.
+    if (match[2] && end >= str.length) {
+      return fail();
+    }
+  }
+  if (pieces.length > 1 && pieces.some((p) => !/[a-z]$/i.test(p))) {
+    return fail();
+  }
+  const total = pieces.reduce((sum, p) => sum + parse(p), 0);
+  return Number.isNaN(total) ? fail() : total;
+}
