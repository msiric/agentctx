+/**
+ * Parse a timer-style clock string and return milliseconds. `"m:ss"` (e.g. `"1:30"`)
+ * and `"h:mm:ss"` (e.g. `"01:02:03"`) are supported. Seconds may have a fractional
+ * part (`"1:30.5"`). In `h:mm:ss`, minutes must be two digits and below 60; seconds
+ * must be two digits and below 60.
+ *
+ * @param str - The clock string
+ * @returns The total in milliseconds, or `undefined` if `str` is invalid
+ */
+export function parseClock(str: string): number | undefined {
+  if (typeof str !== 'string') {
+    return undefined;
+  }
+  const match = /^(?:(\d+):(\d{2})|(\d+)):(\d{2}(?:\.\d+)?)$/.exec(str.trim());
+  if (!match) {
+    return undefined;
+  }
+  // Groups 1+2: h:mm:ss, group 3: m:ss (minutes only)
+  const hours = match[3] === undefined ? Number(match[1]) : 0;
+  const minutes = match[3] === undefined ? Number(match[2]) : Number(match[3]);
+  const seconds = Number(match[4]);
+  if (seconds >= 60 || (match[3] === undefined && minutes >= 60)) {
+    return undefined;
+  }
+  const total = ((hours * 60 + minutes) * 60 + seconds) * 1000;
+  return Number.isFinite(total) ? total : undefined;
+}
