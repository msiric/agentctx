+def test_gzip_json(tmpdir):
+    path = str(tmpdir.join('test.db.gz'))
+
+    storage = GzipJSONStorage(path)
+    assert storage.read() is None
+    storage.write(doc)
+    assert doc == storage.read()
+    storage.close()
+
+    # File is really gzip-compressed JSON
+    with open(path, 'rb') as f:
+        assert json.loads(gzip.decompress(f.read())) == doc
+
+    # Shrinking data truncates the file
+    storage = GzipJSONStorage(path)
+    storage.write({'a': 1})
+    storage.close()
+    storage = GzipJSONStorage(path, access_mode='rb')
+    assert storage.read() == {'a': 1}
+    storage.close()
+
+
+def test_gzip_json_tinydb(tmpdir):
+    path = str(tmpdir.join('test.db.gz'))
+
+    with TinyDB(path, storage=GzipJSONStorage) as db:
+        db.insert({'x': 1})
+
+    with TinyDB(path, storage=GzipJSONStorage) as db:
+        assert db.all() == [{'x': 1}]
