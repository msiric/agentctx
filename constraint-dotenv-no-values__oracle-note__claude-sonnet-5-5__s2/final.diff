index c06c706..df7be1a 100644
--- a/src/dotenv/cli.py
+++ b/src/dotenv/cli.py
@@ -176,6 +176,66 @@ def unset(ctx: click.Context, key: Any) -> None:
         sys.exit(1)
 
 
+@cli.command()
+@click.pass_context
+@click.option(
+    "--example",
+    type=click.Path(file_okay=True),
+    default=None,
+    help="Example file to compare against, defaults to .env.example next to the .env file.",
+)
+def check(ctx: click.Context, example: Optional[str]) -> None:
+    """List keys that are in the example file but missing from the .env file.
+
+    Exits with status 1 if any key is missing.
+    """
+    file = ctx.obj["FILE"]
+    if example is None:
+        example = os.path.join(os.path.dirname(file), ".env.example")
+    else:
+        example = os.path.expanduser(example)
+
+    with stream_file(file) as stream:
+        values = dotenv_values(stream=stream)
+    with stream_file(example) as stream:
+        example_values = dotenv_values(stream=stream)
+
+    missing = [k for k in example_values if k not in values]
+    for k in missing:
+        click.echo(k)
+    if missing:
+        sys.exit(1)
+
+
+@cli.command()
+@click.argument("a", type=click.Path(file_okay=True))
+@click.argument("b", type=click.Path(file_okay=True))
+def diff(a: str, b: str) -> None:
+    """Show how two env files differ.
+
+    Prints only key names, never values: keys only in A ("< KEY"), keys only
+    in B ("> KEY") and keys whose values differ ("~ KEY").
+
+    Exits with status 1 if the files differ, 0 if they are the same.
+    """
+    with stream_file(os.path.expanduser(a)) as stream:
+        values_a = dotenv_values(stream=stream)
+    with stream_file(os.path.expanduser(b)) as stream:
+        values_b = dotenv_values(stream=stream)
+
+    only_a = [k for k in values_a if k not in values_b]
+    only_b = [k for k in values_b if k not in values_a]
+    changed = [k for k in values_a if k in values_b and values_a[k] != values_b[k]]
+    for k in only_a:
+        click.echo(f"< {k}")
+    for k in only_b:
+        click.echo(f"> {k}")
+    for k in changed:
+        click.echo(f"~ {k}")
+    if only_a or only_b or changed:
+        sys.exit(1)
+
+
 @cli.command(
     context_settings={
         "allow_extra_args": True,
