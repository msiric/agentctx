+def test_check_reports_missing_keys(cli, dotenv_path):
+    dotenv_path.write_text("A=1\nC=3\n")
+    (dotenv_path.parent / ".env.example").write_text("A=\nB=\nC=\nD=\n")
+
+    result = cli.invoke(dotenv_cli, ["--file", dotenv_path, "check"])
+
+    assert (result.exit_code, result.output) == (1, "B\nD\n")
+
+
+def test_check_all_present(cli, dotenv_path):
+    dotenv_path.write_text("A=1\nB=2\nEXTRA=3\n")
+    (dotenv_path.parent / ".env.example").write_text("A=\nB=\n")
+
+    result = cli.invoke(dotenv_cli, ["--file", dotenv_path, "check"])
+
+    assert (result.exit_code, result.output) == (0, "")
+
+
+def test_check_custom_example(cli, dotenv_path):
+    dotenv_path.write_text("A=1\n")
+    other = dotenv_path.parent / "other.example"
+    other.write_text("A=\nB=\n")
+    (dotenv_path.parent / ".env.example").write_text("Z=\n")
+
+    result = cli.invoke(
+        dotenv_cli, ["--file", dotenv_path, "check", "--example", str(other)]
+    )
+
+    assert (result.exit_code, result.output) == (1, "B\n")
+
+
+def test_check_empty_value_counts_as_present(cli, dotenv_path):
+    dotenv_path.write_text("A=\n")
+    (dotenv_path.parent / ".env.example").write_text("A=x\n")
+
+    result = cli.invoke(dotenv_cli, ["--file", dotenv_path, "check"])
+
+    assert result.exit_code == 0
