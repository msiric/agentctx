+    def get_jobs_for(self, func: Callable) -> List["Job"]:
+        """
+        Gets scheduled jobs whose job function is ``func``, i.e. the
+        function originally passed to :meth:`Job.do`. Bound methods
+        compare equal when they share the same instance and function.
+
+        :param func: The function (or method) to look up jobs for
+        """
+        return [
+            job
+            for job in self.jobs
+            if job.job_func is not None and job.job_func.func == func
+        ]
+
+    def pause(self, tag: Hashable) -> None:
+        """
+        Pause all jobs marked with the given tag. Paused jobs are skipped
+        by :meth:`run_pending` (and ignored by :meth:`get_next_run`) until
+        :meth:`resume` is called. :meth:`run_all` still runs them.
+
+        :param tag: An identifier used to identify a subset of
+                    jobs to pause
+        """
+        logger.debug('Pausing all jobs tagged "%s"', tag)
+        for job in self.get_jobs(tag):
+            job.paused = True
+
+    def resume(self, tag: Hashable) -> None:
+        """
+        Resume all paused jobs marked with the given tag. Runs missed
+        while paused are not made up: each resumed job is rescheduled
+        relative to the current time.
+
+        :param tag: An identifier used to identify a subset of
+                    jobs to resume
+        """
+        logger.debug('Resuming all jobs tagged "%s"', tag)
+        for job in self.get_jobs(tag):
+            if job.paused:
+                job.paused = False
+                job._schedule_next_run()
+
