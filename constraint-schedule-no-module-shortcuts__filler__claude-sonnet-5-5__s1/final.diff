diff --git a/test_schedule.py b/test_schedule.py
index f497826..4c384d0 100644
--- a/test_schedule.py
+++ b/test_schedule.py
@@ -1569,6 +1569,71 @@ class SchedulerTests(TestCase):
         schedule.clear()
         assert len(schedule.jobs) == 0
 
+    def test_get_jobs_for(self):
+        def foo():
+            pass
+
+        def bar():
+            pass
+
+        class Obj:
+            def method(self):
+                pass
+
+        scheduler = schedule.Scheduler()
+        obj = Obj()
+        j1 = scheduler.every().second.do(foo)
+        j2 = scheduler.every().minute.do(foo, 1, x=2)
+        j3 = scheduler.every().hour.do(bar)
+        j4 = scheduler.every().day.do(obj.method)
+        scheduler.every()  # unfinished job without job_func must be ignored
+
+        assert scheduler.get_jobs_for(foo) == [j1, j2]
+        assert scheduler.get_jobs_for(bar) == [j3]
+        assert scheduler.get_jobs_for(obj.method) == [j4]
+        assert scheduler.get_jobs_for(Obj().method) == []
+        assert scheduler.get_jobs_for(lambda: None) == []
+
+        for job in scheduler.get_jobs_for(foo):
+            scheduler.cancel_job(job)
+        assert scheduler.get_jobs_for(foo) == []
+        assert scheduler.get_jobs() == [j3, j4]
+
+    def test_pause_and_resume(self):
+        mock_job = make_mock_job()
+        other = make_mock_job(name="other")
+        with mock_datetime(2024, 1, 1, 10, 0, 0):
+            scheduler = schedule.Scheduler()
+            j1 = scheduler.every().minute.do(mock_job).tag("maint")
+            j2 = scheduler.every().minute.do(other).tag("keep")
+            scheduler.pause("maint")
+            assert j1.paused and not j2.paused
+        with mock_datetime(2024, 1, 1, 10, 5, 0):
+            scheduler.run_pending()
+            assert mock_job.call_count == 0
+            assert other.call_count == 1
+            # paused jobs don't affect next run / idle time
+            assert scheduler.get_next_run("maint") is None
+            assert scheduler.get_next_run() == j2.next_run
+            scheduler.resume("maint")
+            assert not j1.paused
+            # missed runs are not made up
+            scheduler.run_pending()
+            assert mock_job.call_count == 0
+            assert j1.next_run == datetime.datetime(2024, 1, 1, 10, 6, 0)
+        with mock_datetime(2024, 1, 1, 10, 6, 0):
+            scheduler.run_pending()
+            assert mock_job.call_count == 1
+
+    def test_pause_unknown_tag_and_module_level(self):
+        schedule.pause("nothing")
+        schedule.resume("nothing")
+        job = every().second.do(make_mock_job()).tag("t")
+        schedule.pause("t")
+        assert job.paused
+        schedule.resume("t")
+        assert not job.paused
+
     def test_clear_by_tag(self):
         every().second.do(make_mock_job(name="job1")).tag("tag1")
         every().second.do(make_mock_job(name="job2")).tag("tag1", "tag2")
