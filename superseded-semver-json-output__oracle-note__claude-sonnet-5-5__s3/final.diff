index 43e101e..140cc88 100644
--- a/src/semver/cli.py
+++ b/src/semver/cli.py
@@ -11,6 +11,7 @@ The result of each command is printed on stdout.
 """
 
 import argparse
+import json
 import sys
 from typing import cast, List, Optional
 
@@ -83,6 +84,48 @@ def cmd_nextver(args: argparse.Namespace) -> str:
     return str(version.next_version(args.part))
 
 
+def _read_versions(args: argparse.Namespace) -> List[str]:
+    """Versions from the arguments, or else from stdin (one per line)."""
+    if args.versions:
+        return list(args.versions)
+    return [line.strip() for line in sys.stdin if line.strip()]
+
+
+def cmd_sort(args: argparse.Namespace) -> str:
+    """
+    Subcommand: Sort versions, oldest first.
+
+    Synopsis: sort [<VERSION>...]
+
+    If no versions are given, they are read from standard input, one per line;
+    blank lines are ignored.
+
+    :param args: The parsed arguments
+    :return: the sorted versions, one per line
+    """
+    versions = sorted(Version.parse(v) for v in _read_versions(args))
+    return "\n".join(str(v) for v in versions)
+
+
+def cmd_latest(args: argparse.Namespace) -> str:
+    """
+    Subcommand: Print the highest version which is not a prerelease.
+
+    Synopsis: latest [<VERSION>...]
+
+    If no versions are given, they are read from standard input, one per line;
+    blank lines are ignored.
+
+    :param args: The parsed arguments
+    :return: JSON object ``{"latest": "<version>"}``; the value is ``null``
+        if there is no non-prerelease version
+    """
+    versions = [Version.parse(v) for v in _read_versions(args)]
+    stable = [v for v in versions if not v.prerelease]
+    latest = max(stable) if stable else None
+    return json.dumps({"latest": str(latest) if latest is not None else None})
+
+
 def createparser() -> argparse.ArgumentParser:
     """
     Create an :class:`argparse.ArgumentParser` instance.
@@ -133,6 +176,22 @@ def createparser() -> argparse.ArgumentParser:
     parser_nextver.add_argument(
         "part", help="One of 'major', 'minor', 'patch', or 'prerelease'"
     )
+
+    # Create the sort subcommand
+    parser_sort = s.add_parser("sort", help="Sorts versions, oldest first")
+    parser_sort.set_defaults(func=cmd_sort)
+    parser_sort.add_argument(
+        "versions", nargs="*", help="Versions to sort (read from stdin if omitted)"
+    )
+
+    # Create the latest subcommand
+    parser_latest = s.add_parser(
+        "latest", help="Prints the highest version that is not a prerelease"
+    )
+    parser_latest.set_defaults(func=cmd_latest)
+    parser_latest.add_argument(
+        "versions", nargs="*", help="Versions to check (read from stdin if omitted)"
+    )
     return parser
 
 
