@@ -0,0 +1,51 @@
+import copy
+
+from xmltodict import drop_keys, parse
+
+
+def test_removes_keys_at_any_depth():
+    doc = {"a": {"b": "1", "c": {"b": "2", "d": "3"}}}
+    assert drop_keys(doc, ["b"]) == {"a": {"c": {"d": "3"}}}
+
+
+def test_removes_attribute_keys():
+    doc = parse('<a id="1"><b id="2" n="x">t</b></a>')
+    assert drop_keys(doc, ["@id"]) == {"a": {"b": {"@n": "x", "#text": "t"}}}
+
+
+def test_descends_into_lists():
+    doc = {"a": [{"@id": "1", "v": "x"}, {"@id": "2", "v": "y"}, "s"]}
+    assert drop_keys(doc, {"@id"}) == {"a": [{"v": "x"}, {"v": "y"}, "s"]}
+
+
+def test_does_not_mutate_input():
+    doc = {"a": [{"@id": "1", "b": {"@id": "2"}}], "@id": "3"}
+    snapshot = copy.deepcopy(doc)
+    result = drop_keys(doc, ["@id"])
+    assert doc == snapshot
+    assert result == {"a": [{"b": {}}]}
+    assert result is not doc and result["a"] is not doc["a"]
+
+
+def test_result_shares_no_containers_with_input():
+    doc = {"a": {"b": [1, 2]}}
+    result = drop_keys(doc, ["zzz"])
+    assert result == doc
+    result["a"]["b"].append(3)
+    assert doc == {"a": {"b": [1, 2]}}
+
+
+def test_empty_names_and_single_string():
+    doc = {"a": "1", "b": {"a": "2"}}
+    assert drop_keys(doc, []) == doc
+    assert drop_keys(doc, "a") == {"b": {}}  # str is one name, not chars
+
+
+def test_scalars_and_none():
+    assert drop_keys("x", ["a"]) == "x"
+    assert drop_keys(None, ["a"]) is None
+    assert drop_keys({"a": None, "b": None}, ["a"]) == {"b": None}
+
+
+def test_dropping_all_keys_gives_empty_dict():
+    assert drop_keys({"a": "1"}, ["a"]) == {}
