+def drop_keys(doc, names):
+    """Return a copy of ``doc`` with every key in ``names`` removed at any depth.
+
+    Attribute keys (e.g. ``'@id'``) are matched literally, so pass them with
+    their prefix. Dicts and lists are copied recursively; the input is never
+    mutated. A single string is treated as one name. Container types are
+    normalized to ``dict`` and ``list``.
+    """
+    if isinstance(names, str):
+        names = (names,)
+    names = frozenset(names)
+
+    def walk(value):
+        if isinstance(value, dict):
+            return {k: walk(v) for k, v in value.items() if k not in names}
+        if isinstance(value, (list, tuple)):
+            return [walk(v) for v in value]
+        return value
+
+    return walk(doc)
+
+
