         return value
 
 
+def drop_keys(doc, names):
+    """Return a copy of a parsed document with every key in `names` removed.
+
+    Keys are removed at any depth, including attribute keys such as '@id'
+    (pass the key exactly as it appears in the dict). `doc` is never mutated.
+    Dicts are copied as plain dicts and lists/tuples as lists; other values
+    are shared with the input. `names` may be a single string or an iterable
+    of strings.
+
+    The walk is iterative, so very deeply nested documents do not hit the
+    interpreter's recursion limit.
+    """
+    if isinstance(names, str):
+        names = (names,)
+    names = frozenset(names)
+
+    def shell(value):
+        if isinstance(value, dict):
+            return {}
+        if isinstance(value, (list, tuple)):
+            return []
+        return None
+
+    root = shell(doc)
+    if root is None:
+        return doc
+    stack = [(doc, root)]
+    while stack:
+        src, dst = stack.pop()
+        if isinstance(src, dict):
+            for k, v in src.items():
+                if k in names:
+                    continue
+                child = shell(v)
+                dst[k] = v if child is None else child
+                if child is not None:
+                    stack.append((v, child))
+        else:
+            for v in src:
+                child = shell(v)
+                dst.append(v if child is None else child)
+                if child is not None:
+                    stack.append((v, child))
+    return root
+
+
