+    def to_csv(self, path, fields: Optional[Iterable[str]] = None) -> None:
+        """
+        Export the table to a CSV file.
+
+        The first row is a header. Each document becomes one row. Missing
+        values become empty cells; keys not listed in ``fields`` are ignored.
+
+        :param path: the file to write (overwritten if it exists)
+        :param fields: the columns to write, in order. Defaults to every
+                       top-level key in first-seen order.
+        """
+
+        docs = list(self)
+
+        if fields is None:
+            columns: list = []
+            seen = set()
+            for doc in docs:
+                for key in doc:
+                    if key not in seen:
+                        seen.add(key)
+                        columns.append(key)
+        else:
+            columns = list(fields)
+
+        with open(path, 'w', newline='', encoding='utf-8') as f:
+            writer = csv.writer(f)
+            writer.writerow(columns)
+            for doc in docs:
+                writer.writerow([doc.get(c, '') for c in columns])
+
