+def test_to_csv_default_fields(db, tmp_path):
+    import csv
+    table = db.table('csv')
+    table.insert({'a': 1, 'b': 'x,y'})
+    table.insert({'b': 'z', 'c': 'q"t'})
+    path = tmp_path / 'out.csv'
+    table.to_csv(path)
+    with open(path, newline='', encoding='utf-8') as f:
+        rows = list(csv.reader(f))
+    assert rows == [['a', 'b', 'c'], ['1', 'x,y', ''], ['', 'z', 'q"t']]
+
+
+def test_to_csv_fields_select_and_order(db, tmp_path):
+    table = db.table('csv')
+    table.insert({'a': 1, 'b': 2, 'c': 3})
+    path = tmp_path / 'out.csv'
+    table.to_csv(path, fields=['c', 'a', 'missing'])
+    assert path.read_text(encoding='utf-8').splitlines() == ['c,a,missing', '3,1,']
+
+
+def test_to_csv_empty_table(db, tmp_path):
+    path = tmp_path / 'out.csv'
+    db.table('empty').to_csv(path, fields=['a'])
+    assert path.read_text(encoding='utf-8').splitlines() == ['a']
+    db.table('empty').to_csv(path)
+    assert path.read_text(encoding='utf-8').strip() == ''
+
+
+def test_to_csv_unicode(db, tmp_path):
+    table = db.table('csv')
+    table.insert({'name': 'Müller'})
+    path = tmp_path / 'out.csv'
+    table.to_csv(path)
+    assert 'Müller' in path.read_text(encoding='utf-8')
