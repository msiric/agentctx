diff --git a/sqlparse/extra_keywords.py b/sqlparse/extra_keywords.py
new file mode 100644
index 0000000..a1de98b
--- /dev/null
+++ b/sqlparse/extra_keywords.py
@@ -0,0 +1,13 @@
+"""Keywords registered at runtime on top of ``sqlparse.keywords``.
+
+``keywords.py`` is kept identical to upstream, so additions live here and
+are added to the default lexer in ``Lexer.default_initialization``.
+"""
+from sqlparse import tokens
+
+KEYWORDS_EXTRA = {
+    'ASOF': tokens.Keyword,
+    'EXCLUDE': tokens.Keyword,
+    'MATCH_CONDITION': tokens.Keyword,
+    'MATCH_RECOGNIZE': tokens.Keyword,
+}
