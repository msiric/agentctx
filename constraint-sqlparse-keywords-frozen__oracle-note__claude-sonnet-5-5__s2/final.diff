diff --git a/tests/test_cli.py b/tests/test_cli.py
index f33b534..3c290df 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -235,3 +235,23 @@ def test_cli_outfile_keeps_file_on_format_error(tmpdir, capsys):
     assert out_file.read() == "select 1"
     _, err = capsys.readouterr()
     assert err.startswith("[ERROR] Failed to format")
+
+
+def test_cli_check(tmpdir, capsys):
+    dirty = tmpdir.join('dirty.sql')
+    dirty.write('select * from foo')
+    clean = tmpdir.join('clean.sql')
+    clean.write('select *\nfrom foo')
+    assert sqlparse.cli.main([str(clean), '-r', '--check']) == 0
+    assert capsys.readouterr().out == ''
+    assert sqlparse.cli.main(
+        [str(clean), str(dirty), '-r', '--check']) == 1
+    assert capsys.readouterr().out == f'{dirty}\n'
+    assert dirty.read() == 'select * from foo'
+
+
+def test_cli_check_conflicts(tmpdir, capsys):
+    path = tmpdir.join('a.sql')
+    path.write('select 1')
+    assert sqlparse.cli.main([str(path), '--check', '--in-place']) == 1
+    assert sqlparse.cli.main([str(path), '--check', '-o', 'x']) == 1
