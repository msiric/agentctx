@@ -285,3 +285,96 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def test_json_write_crash_keeps_old_state(tmpdir, monkeypatch):
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+
+    # Simulate the process dying right before the new file is swapped in
+    def boom(*args, **kwargs):
+        raise KeyboardInterrupt
+
+    monkeypatch.setattr(os, 'replace', boom)
+
+    db = TinyDB(path)
+    with pytest.raises(KeyboardInterrupt):
+        db.insert({'a': 2})
+    monkeypatch.undo()
+
+    # No temp files left behind, and old state is readable
+    assert os.listdir(str(tmpdir)) == ['db.json']
+    with TinyDB(path) as db2:
+        assert db2.all() == [{'a': 1}]
+
+
+def test_json_write_crash_mid_write(tmpdir, monkeypatch):
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+
+    def boom(fd):
+        raise OSError('killed')
+
+    monkeypatch.setattr(os, 'fsync', boom)
+    db = TinyDB(path)
+    with pytest.raises(OSError):
+        db.insert({'a': 2})
+    monkeypatch.undo()
+
+    with TinyDB(path) as db2:
+        assert db2.all() == [{'a': 1}]
+
+
+def test_json_write_serialization_error_keeps_file(tmpdir):
+    path = str(tmpdir.join('db.json'))
+
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+        with pytest.raises(TypeError):
+            db.insert({'a': object()})
+
+    with TinyDB(path) as db2:
+        assert db2.all() == [{'a': 1}]
+
+
+def test_json_write_hard_kill(tmpdir):
+    # Kill a real process in the middle of a stream of large writes
+    import subprocess
+    import sys
+
+    path = str(tmpdir.join('db.json'))
+    code = (
+        'import sys\n'
+        'from tinydb import TinyDB\n'
+        'db = TinyDB(sys.argv[1])\n'
+        'print("ready", flush=True)\n'
+        'while True:\n'
+        '    db.insert({"x": "y" * 200000})\n'
+    )
+    with TinyDB(path) as db:
+        db.insert({'x': 'seed'})
+
+    proc = subprocess.Popen([sys.executable, '-c', code, path], stdout=subprocess.PIPE)
+    proc.stdout.readline()
+    import time
+    time.sleep(0.5)
+    proc.kill()
+    proc.wait()
+
+    with TinyDB(path) as db:
+        assert len(db.all()) >= 1
+
+
+def test_json_write_preserves_permissions_and_handle(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+        os.chmod(path, 0o600)
+        db.insert({'a': 2})
+        db.insert({'a': 3})
+        assert len(db.all()) == 3
+    assert (os.stat(path).st_mode & 0o777) == 0o600
