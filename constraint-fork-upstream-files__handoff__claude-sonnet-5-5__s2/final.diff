diff --git a/test/dashdash.js b/test/dashdash.js
new file mode 100644
index 0000000..f1177df
--- /dev/null
+++ b/test/dashdash.js
@@ -0,0 +1,39 @@
+const test = require('tape');
+const fn = require('../lib');
+
+test('-- (default): all after -- goes to _', t => {
+	t.same(fn(['a', '--', '-b', 'c']), { _: ['a', '-b', 'c'] });
+	t.end();
+});
+
+test('-- (opts["--"]): all after -- goes to argv["--"]', t => {
+	const argv = fn(['a', '-x', '1', '--', '-b', '--foo', 'c'], { '--': true });
+	t.same(argv, { _: ['a'], x: 1, '--': ['-b', '--foo', 'c'] });
+	t.end();
+});
+
+test('-- (opts["--"]): empty array when no -- present', t => {
+	t.same(fn(['a', '-x'], { '--': true }), { _: ['a'], x: true, '--': [] });
+	t.end();
+});
+
+test('-- (opts["--"]): trailing -- yields empty array', t => {
+	t.same(fn(['a', '--'], { '--': true }), { _: ['a'], '--': [] });
+	t.end();
+});
+
+test('-- (opts["--"]): only the first -- is consumed', t => {
+	t.same(fn(['--', 'a', '--', 'b'], { '--': true }), { _: [], '--': ['a', '--', 'b'] });
+	t.end();
+});
+
+test('-- (opts["--"]): values after -- are not coerced', t => {
+	t.same(fn(['--', '123'], { '--': true }), { _: [], '--': ['123'] });
+	t.end();
+});
+
+test('-- (opts["--"]): works with alias, default and boolean', t => {
+	const argv = fn(['-v', '--', 'x'], { '--': true, boolean: 'v', alias: { v: 'verbose' }, default: { n: 1 } });
+	t.same(argv, { _: [], v: true, verbose: true, n: 1, '--': ['x'] });
+	t.end();
+});
