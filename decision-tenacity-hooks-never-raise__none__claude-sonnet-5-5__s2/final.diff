+def swallow_hook_errors(
+    fn: typing.Callable[["RetryCallState"], None],
+) -> typing.Callable[["RetryCallState"], None]:
+    """Wrap an observability hook (logging, metrics) so it can never break a retry.
+
+    Any ``Exception`` raised by the hook is logged at debug level and dropped.
+    """
+
+    @functools.wraps(fn)
+    def wrapper(retry_state: "RetryCallState") -> None:
+        try:
+            fn(retry_state)
+        except Exception:
+            _logger.debug("Ignoring error raised by %r", fn, exc_info=True)
+
+    return wrapper
+
