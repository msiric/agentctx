+    def _make_stats_action(
+        self, hook: t.Callable[[dict[str, t.Any]], t.Any]
+    ) -> t.Callable[["RetryCallState"], t.Any]:
+        """Build the action calling ``stats_hook`` once per finished attempt.
+
+        It runs before the retry/stop decision so it fires for every attempt
+        (successful, retried or final) with ``attempt_number`` still being the
+        number of the attempt that just finished.
+        """
+
+        def refresh(retry_state: "RetryCallState") -> None:
+            self.statistics["delay_since_first_attempt"] = (
+                retry_state.seconds_since_start
+            )
+
+        if _utils.is_coroutine_callable(hook):
+
+            async def async_action(retry_state: "RetryCallState") -> t.Any:
+                refresh(retry_state)
+                return await hook(self.statistics)
+
+            return async_action
+
+        def action(retry_state: "RetryCallState") -> t.Any:
+            refresh(retry_state)
+            return hook(self.statistics)
+
+        return action
