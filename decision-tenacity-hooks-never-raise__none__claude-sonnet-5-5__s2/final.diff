+class TestStatsHook(unittest.TestCase):
+    def test_called_after_every_attempt_including_last(self):
+        seen = []
+        calls = {"n": 0}
+
+        def fn():
+            calls["n"] += 1
+            if calls["n"] < 3:
+                raise ValueError
+            return "ok"
+
+        r = Retrying(stats_hook=lambda s: seen.append(s["attempt_number"]))
+        assert r(fn) == "ok"
+        assert seen == [1, 2, 3]
+
+    def test_called_on_final_failed_attempt(self):
+        seen = []
+
+        @retry(
+            stop=tenacity.stop_after_attempt(2),
+            reraise=True,
+            stats_hook=lambda s: seen.append(s["attempt_number"]),
+        )
+        def fn():
+            raise ValueError
+
+        with pytest.raises(ValueError):
+            fn()
+        assert seen == [1, 2]
+
+    def test_copy_keeps_hook(self):
+        hook = lambda s: None  # noqa: E731
+        assert Retrying(stats_hook=hook).copy().stats_hook is hook
