diff --git a/test/count.js b/test/count.js
new file mode 100644
index 0000000..fa5c10d
--- /dev/null
+++ b/test/count.js
@@ -0,0 +1,39 @@
+const test = require('tape');
+const fn = require('../lib');
+
+test('count: short flags', t => {
+	t.same(fn(['-vvv'], { count: 'v' }), { v: 3, _: [] });
+	t.same(fn(['-v', '-v'], { count: ['v'] }), { v: 2, _: [] });
+	t.same(fn(['-vx'], { count: 'v' }).v, 1);
+	t.end();
+});
+
+test('count: long flags', t => {
+	t.same(fn(['--verbose', '--verbose'], { count: 'verbose' }), { verbose: 2, _: [] });
+	t.same(fn(['--verbose'], { count: 'verbose' }), { verbose: 1, _: [] });
+	t.end();
+});
+
+test('count: aliases are shared', t => {
+	const opts = { count: 'v', alias: { v: 'verbose' } };
+	t.same(fn(['-vv', '--verbose'], opts), { v: 3, verbose: 3, _: [] });
+	t.same(fn(['-vv'], { count: 'verbose', alias: { v: 'verbose' } }), { v: 2, verbose: 2, _: [] });
+	t.end();
+});
+
+test('count: does not consume next arg', t => {
+	t.same(fn(['-v', 'foo', '-v'], { count: 'v' }), { v: 2, _: ['foo'] });
+	t.end();
+});
+
+test('count: absent, default, negation', t => {
+	t.same(fn(['a'], { count: 'v' }), { _: ['a'] });
+	t.same(fn([], { count: 'v', default: { v: 0 } }), { v: 0, _: [] });
+	t.same(fn(['-v', '--no-v'], { count: 'v' }), { v: 0, _: [] });
+	t.end();
+});
+
+test('count: other flags unaffected', t => {
+	t.same(fn(['-vv', '-a', '-a'], { count: 'v' }), { v: 2, a: [true, true], _: [] });
+	t.end();
+});
