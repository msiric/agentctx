+def test_gzip_json(tmpdir):
+    path = str(tmpdir.join('db.json.gz'))
+
+    db = TinyDB(path, storage=GzipJSONStorage)
+    db.insert_multiple({'int': i, 'text': 'x' * 100} for i in range(100))
+    db.insert({'int': 1000})
+    db.close()
+
+    with open(path, 'rb') as f:
+        assert f.read(2) == b'\x1f\x8b'
+
+    db = TinyDB(path, storage=GzipJSONStorage)
+    assert len(db) == 101
+    db.remove(lambda d: d['int'] < 100)
+    db.close()
+
+    db = TinyDB(path, storage=GzipJSONStorage, access_mode='rb')
+    assert db.all() == [{'int': 1000}]
+    db.close()
