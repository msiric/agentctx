@@ -58,3 +58,58 @@ def replace_nans(cont: dict | list) -> dict | list:
 )
 def test_obj_to_str_mapping(obj, expected_str, multiline_strings):
     assert tomli_w.dumps(obj, multiline_strings=multiline_strings) == expected_str
+
+
+def test_none_values_skipped():
+    assert tomli_w.dumps({"a": 1, "b": None}) == "a = 1\n"
+    assert tomli_w.dumps({"a": None}) == ""
+    assert tomli_w.dumps({"t": {"x": None, "y": 2}}) == "[t]\ny = 2\n"
+    assert tomli_w.dumps({"t": {"x": None}}) == "[t]\n"
+    # inline tables (inside arrays)
+    assert (
+        tomli_w.dumps({"a": [{"x": None, "y": 1}]}) == "a = [\n    { y = 1 },\n]\n"
+    )
+    assert tomli_w.dumps({"a": [{"x": None}]}) == "a = [\n    {},\n]\n"
+    # array of tables
+    long = "z" * 100
+    assert (
+        tomli_w.dumps({"a": [{"x": None, "y": long}]}) == f'[[a]]\ny = "{long}"\n'
+    )
+
+
+def test_none_in_arrays_skipped():
+    assert tomli_w.dumps({"a": [1, None, 2]}) == "a = [\n    1,\n    2,\n]\n"
+    assert tomli_w.dumps({"a": [None]}) == "a = []\n"
+    assert tomli_w.dumps({"a": (None, "x")}) == 'a = [\n    "x",\n]\n'
+    assert tomli_w.dumps({"a": [[None, 1], [None]]}) == (
+        "a = [\n    [\n        1,\n    ],\n    [],\n]\n"
+    )
+    assert tomli_w.dumps({"a": [{"x": 1}, None]}) == "a = [\n    { x = 1 },\n]\n"
+    assert tomli_w.dumps({"t": {"a": [None, 1]}}) == "[t]\na = [\n    1,\n]\n"
+    assert tomli_w.dumps({"a": [{"x": [None, 1]}]}) == "[[a]]\nx = [\n    1,\n]\n"
+
+
+def test_none_values_skipped_dump():
+    import io
+
+    buf = io.BytesIO()
+    tomli_w.dump({"a": None, "b": 1}, buf)
+    assert buf.getvalue() == b"b = 1\n"
+
+
+def test_pathlib_values():
+    import pathlib
+
+    assert tomli_w.dumps({"p": pathlib.PurePosixPath("/a/b")}) == 'p = "/a/b"\n'
+    assert tomli_w.dumps({"t": {"p": pathlib.PurePosixPath("x/y")}}) == (
+        '[t]\np = "x/y"\n'
+    )
+    assert tomli_w.dumps({"a": [pathlib.PurePosixPath("x")]}) == (
+        'a = [\n    "x",\n]\n'
+    )
+    # Windows paths: backslashes are escaped
+    assert tomli_w.dumps({"p": pathlib.PureWindowsPath("C:/a/b")}) == (
+        'p = "C:\\\\a\\\\b"\n'
+    )
+    # concrete paths too
+    assert tomli_w.dumps({"p": pathlib.Path("a")}) == 'p = "a"\n'
