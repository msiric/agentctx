@@ -0,0 +1,59 @@
+import io
+
+from semver.cli import main
+
+
+def test_latest_ignores_prereleases(capsys):
+    assert main(["latest", "1.2.0", "1.10.0", "1.11.0-rc.1", "0.9.9"]) == 0
+    assert capsys.readouterr().out == '"1.10.0"\n'
+
+
+def test_latest_compares_numerically(capsys):
+    assert main(["latest", "1.9.0", "1.10.0"]) == 0
+    assert capsys.readouterr().out == '"1.10.0"\n'
+
+
+def test_latest_single_version(capsys):
+    assert main(["latest", "1.2.3"]) == 0
+    assert capsys.readouterr().out == '"1.2.3"\n'
+
+
+def test_latest_only_prereleases_prints_null(capsys):
+    assert main(["latest", "1.0.0-rc.1", "2.0.0-alpha"]) == 0
+    assert capsys.readouterr().out == "null\n"
+
+
+def test_latest_keeps_build_metadata(capsys):
+    assert main(["latest", "1.0.0", "2.0.0+build.5"]) == 0
+    assert capsys.readouterr().out == '"2.0.0+build.5"\n'
+
+
+def test_latest_invalid_version_prints_nothing_on_stdout(capsys):
+    assert main(["latest", "1.2.3", "1.2"]) == 2
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert captured.err.startswith("ERROR")
+
+
+def test_latest_reads_stdin_without_arguments(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO("1.10.0\n\n  1.2.0 \n2.0.0-rc.1\n"))
+    assert main(["latest"]) == 0
+    assert capsys.readouterr().out == '"1.10.0"\n'
+
+
+def test_latest_empty_stdin_prints_null(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO("\n"))
+    assert main(["latest"]) == 0
+    assert capsys.readouterr().out == "null\n"
+
+
+def test_latest_stdin_invalid_version_is_error(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO("1.2.3\nnope\n"))
+    assert main(["latest"]) == 2
+    assert capsys.readouterr().out == ""
+
+
+def test_latest_arguments_take_precedence_over_stdin(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO("9.9.9\n"))
+    assert main(["latest", "2.0.0", "1.0.0"]) == 0
+    assert capsys.readouterr().out == '"2.0.0"\n'
