+import io
+
+from semver.cli import main
+
+
+def test_sort_prints_oldest_first_one_per_line(capsys):
+    assert main(["sort", "1.10.0", "1.2.0", "1.2.0-rc.1", "0.9.9"]) == 0
+    assert capsys.readouterr().out == "0.9.9\n1.2.0-rc.1\n1.2.0\n1.10.0\n"
+
+
+def test_sort_single_version(capsys):
+    assert main(["sort", "1.2.3"]) == 0
+    assert capsys.readouterr().out == "1.2.3\n"
+
+
+def test_sort_invalid_version_prints_nothing_on_stdout(capsys):
+    assert main(["sort", "1.2.3", "1.2"]) == 2
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert captured.err.startswith("ERROR")
+
+
+def test_sort_reads_stdin_without_arguments(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO("1.10.0\n\n  1.2.0 \n1.2.0-rc.1\n\n"))
+    assert main(["sort"]) == 0
+    assert capsys.readouterr().out == "1.2.0-rc.1\n1.2.0\n1.10.0\n"
+
+
+def test_sort_stdin_invalid_version_is_error(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO("1.2.3\nnope\n"))
+    assert main(["sort"]) == 2
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert captured.err.startswith("ERROR")
+
+
+def test_sort_empty_stdin_prints_nothing(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO("\n\n"))
+    assert main(["sort"]) == 0
+    assert capsys.readouterr().out == ""
+
+
+def test_sort_arguments_take_precedence_over_stdin(capsys, monkeypatch):
+    monkeypatch.setattr("sys.stdin", io.StringIO("9.9.9\n"))
+    assert main(["sort", "2.0.0", "1.0.0"]) == 0
+    assert capsys.readouterr().out == "1.0.0\n2.0.0\n"
