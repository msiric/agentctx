 """
 
 import argparse
+import json
 import sys
 from typing import cast, List, Optional
 
@@ -83,6 +84,50 @@ def cmd_nextver(args: argparse.Namespace) -> str:
     return str(version.next_version(args.part))
 
 
+def cmd_sort(args: argparse.Namespace) -> Optional[str]:
+    """
+    Subcommand: Sort versions, oldest first.
+
+    Synopsis: sort [<VERSION>...]
+
+    If no versions are given, they are read from stdin, one per line
+    (blank lines are ignored).
+
+    :param args: The parsed arguments
+    :return: the sorted versions, one per line
+    """
+    raw = args.versions
+    if not raw:
+        raw = [line.strip() for line in sys.stdin]
+        raw = [line for line in raw if line]
+    if not raw:
+        return None
+    versions = sorted(Version.parse(v) for v in raw)
+    return "\n".join(str(v) for v in versions)
+
+
+def cmd_latest(args: argparse.Namespace) -> str:
+    """
+    Subcommand: Print the highest version that is not a prerelease.
+
+    Synopsis: latest [<VERSION>...]
+
+    If no versions are given, they are read from stdin, one per line
+    (blank lines are ignored).
+
+    :param args: The parsed arguments
+    :return: the highest non-prerelease version as a JSON string,
+        or ``null`` if there is none
+    """
+    raw = args.versions
+    if not raw:
+        raw = [line.strip() for line in sys.stdin]
+        raw = [line for line in raw if line]
+    versions = [Version.parse(v) for v in raw]
+    stable = [v for v in versions if not v.prerelease]
+    return json.dumps(str(max(stable)) if stable else None)
+
+
