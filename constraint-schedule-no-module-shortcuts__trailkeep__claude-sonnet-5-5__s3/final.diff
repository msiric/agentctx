diff --git a/test_schedule.py b/test_schedule.py
index f497826..a786041 100644
--- a/test_schedule.py
+++ b/test_schedule.py
@@ -1569,6 +1569,94 @@ class SchedulerTests(TestCase):
         schedule.clear()
         assert len(schedule.jobs) == 0
 
+    def test_get_jobs_for(self):
+        scheduler = schedule.Scheduler()
+        def job_a():
+            pass
+
+        def job_b():
+            pass
+
+        j1 = scheduler.every().second.do(job_a)
+        j2 = scheduler.every().minute.do(job_a)
+        j3 = scheduler.every().second.do(job_b)
+        assert scheduler.get_jobs_for(job_a) == [j1, j2]
+        assert scheduler.get_jobs_for(job_b) == [j3]
+        assert scheduler.get_jobs_for(lambda: None) == []
+        scheduler.cancel_job(j1)
+        assert scheduler.get_jobs_for(job_a) == [j2]
+
+    def test_get_jobs_for_ignores_args(self):
+        scheduler = schedule.Scheduler()
+        def job(x):
+            pass
+
+        j1 = scheduler.every().second.do(job, 1)
+        j2 = scheduler.every().second.do(job, x=2)
+        assert scheduler.get_jobs_for(job) == [j1, j2]
+
+    def test_get_jobs_for_unscheduled_job(self):
+        scheduler = schedule.Scheduler()
+        def job():
+            pass
+
+        scheduler.every().second  # no .do(), so job_func is None
+        assert scheduler.get_jobs_for(job) == []
+
+    def test_pause_skips_tagged_jobs(self):
+        mock_job = make_mock_job()
+        other_job = make_mock_job(name="other")
+        with mock_datetime(2020, 1, 1, 10, 0, 0):
+            every().minute.do(mock_job).tag("maint")
+            every().minute.do(other_job).tag("other")
+            schedule.pause("maint")
+        with mock_datetime(2020, 1, 1, 10, 1, 0):
+            schedule.run_pending()
+            assert mock_job.call_count == 0
+            assert other_job.call_count == 1
+        with mock_datetime(2020, 1, 1, 10, 5, 0):
+            schedule.run_pending()
+            assert mock_job.call_count == 0
+        assert len(schedule.jobs) == 2
+
+    def test_resume_does_not_run_missed_jobs(self):
+        mock_job = make_mock_job()
+        with mock_datetime(2020, 1, 1, 10, 0, 0):
+            every().minute.do(mock_job).tag("maint")
+            schedule.pause("maint")
+        with mock_datetime(2020, 1, 1, 10, 5, 0):
+            schedule.resume("maint")
+            schedule.run_pending()
+            assert mock_job.call_count == 0
+        with mock_datetime(2020, 1, 1, 10, 6, 0):
+            schedule.run_pending()
+            assert mock_job.call_count == 1
+
+    def test_resume_keeps_schedule_of_not_yet_due_jobs(self):
+        mock_job = make_mock_job()
+        with mock_datetime(2020, 1, 1, 10, 0, 0):
+            job = every().hour.do(mock_job).tag("maint")
+            schedule.pause("maint")
+            expected = job.next_run
+            schedule.resume("maint")
+        assert job.next_run == expected
+
+    def test_pause_unknown_tag_is_noop(self):
+        every().second.do(make_mock_job())
+        schedule.pause("nope")
+        schedule.resume("nope")
+        assert not schedule.jobs[0].paused
+
+    def test_paused_jobs_ignored_by_next_run(self):
+        with mock_datetime(2020, 1, 1, 10, 0, 0):
+            every().minute.do(make_mock_job()).tag("a")
+            every().hour.do(make_mock_job()).tag("b")
+            schedule.pause("a")
+            assert schedule.next_run() == datetime.datetime(2020, 1, 1, 11, 0, 0)
+            schedule.pause("b")
+            assert schedule.next_run() is None
+            assert schedule.idle_seconds() is None
+
     def test_clear_by_tag(self):
