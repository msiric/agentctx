+    def test_to_dict_with_nested_lists(self):
+        prop = self.dict_class(a=[[{'b': 1}], ({'c': 2},)])
+        regular = prop.to_dict()
+        self.assertEqual(regular, {'a': [[{'b': 1}], ({'c': 2},)]})
+        self.assertIs(type(regular['a'][0][0]), dict)
+        self.assertIsInstance(regular['a'][1], tuple)
+        self.assertIs(type(regular['a'][1][0]), dict)
+
+    def test_flatten(self):
+        prop = self.dict_class()
+        prop.db.host = 'x'
+        prop.db.port = 5432
+        prop.debug = True
+        flat = prop.flatten()
+        self.assertEqual(flat, {'db__host': 'x', 'db__port': 5432,
+                                'debug': True})
+        self.assertIs(type(flat), dict)
+
+    def test_flatten_deep_and_lists_are_leaves(self):
+        prop = self.dict_class(a={'b': {'c': [{'d': 1}, 2]}}, t=(1, 2))
+        flat = prop.flatten()
+        self.assertEqual(flat, {'a__b__c': [{'d': 1}, 2], 't': (1, 2)})
+
+    def test_flatten_custom_sep_and_non_string_keys(self):
+        prop = self.dict_class({1: {2: 'x'}})
+        self.assertEqual(prop.flatten(sep='.'), {'1.2': 'x'})
+
+    def test_flatten_empty(self):
+        prop = self.dict_class()
+        prop.a.b = {}
+        self.assertEqual(prop.flatten(), {})
+        self.assertEqual(self.dict_class().flatten(), {})
+
+    def test_flatten_does_not_mutate(self):
+        prop = self.dict_class(a={'b': 1})
+        prop.flatten()
+        self.assertEqual(prop, {'a': {'b': 1}})
+
