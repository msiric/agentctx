+class Length:
+    """
+    Validates that a string's size is within inclusive bounds.
+
+    The size is measured in UTF-8 bytes, not characters, because the values
+    end up in byte-limited storage (e.g. Oracle VARCHAR2(n BYTE)) where
+    accented characters take more than one byte.
+    """
+
+    def __init__(
+        self,
+        min: Union[int, None] = None,
+        max: Union[int, None] = None,
+        error: Union[str, None] = None,
+    ) -> None:
+        for name, bound in (("min", min), ("max", max)):
+            if bound is not None and (
+                not isinstance(bound, int) or isinstance(bound, bool) or bound < 0
+            ):
+                raise TypeError(f"{name} must be a non-negative int, not {bound!r}")
+        if min is not None and max is not None and min > max:
+            raise ValueError(f"min ({min}) must not be greater than max ({max})")
+        self._min: Union[int, None] = min
+        self._max: Union[int, None] = max
+        self._error: Union[str, None] = error
+
+    def __repr__(self) -> str:
+        return f"{self.__class__.__name__}(min={self._min!r}, max={self._max!r})"
+
+    @property
+    def min(self) -> Union[int, None]:
+        return self._min
+
+    @property
+    def max(self) -> Union[int, None]:
+        return self._max
+
+    @staticmethod
+    def _short_repr(data: Any, limit: int = 30) -> str:
+        r = repr(data)
+        return r if len(r) <= limit else r[: limit - 3] + "..."
+
+    def validate(self, data: str, **kwargs: Any) -> str:
+        """
+        Validates the UTF-8 byte length of data.
+        :param data: Data to be validated.
+        :return: Returns validated data.
+        """
+        e = self._error
+
+        if not isinstance(data, str):
+            raise SchemaError(e.format(data) if e else f"{data!r} is not a string")
+
+        size = len(data.encode("utf-8"))
+        too_short = self._min is not None and size < self._min
+        too_long = self._max is not None and size > self._max
+        if too_short or too_long:
+            if self._min is not None and self._max is not None:
+                bounds = f"between {self._min} and {self._max}"
+            elif self._min is not None:
+                bounds = f"at least {self._min}"
+            else:
+                bounds = f"at most {self._max}"
+            raise SchemaError(
+                e.format(data)
+                if e
+                else f"{self._short_repr(data)} is {size} bytes long, "
+                f"expected {bounds} bytes (UTF-8)"
+            )
+        return data
+
+
