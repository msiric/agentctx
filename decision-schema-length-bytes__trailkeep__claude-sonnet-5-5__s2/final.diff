diff --git a/test_schema.py b/test_schema.py
index 4d78456..0db9520 100644
--- a/test_schema.py
+++ b/test_schema.py
@@ -25,6 +25,7 @@ from schema import (
     Optional,
     Or,
     Regex,
+    Length,
     Schema,
     SchemaError,
     SchemaForbiddenKeyError,
@@ -167,6 +168,58 @@ def test_test():
         schema.validate(bad_data)
 
 
+def test_length():
+    assert Length(min=1, max=3).validate("abc") == "abc"
+    assert Length(min=3).validate("abc") == "abc"
+    assert Length(max=3).validate("") == ""
+    assert Length().validate("anything") == "anything"
+    with SE:
+        Length(min=4).validate("abc")
+    with SE:
+        Length(max=2).validate("abc")
+    # UTF-8 bytes, not characters: "é" is 2 bytes
+    assert Length(max=2).validate("é") == "é"
+    with SE:
+        Length(max=1).validate("é")
+    with SE:
+        Length(min=3).validate("é")
+    # non-strings
+    for bad in (1, None, [], {}, b"abc"):
+        with SE:
+            Length(max=10).validate(bad)
+    # invalid construction
+    with raises(ValueError):
+        Length(min=5, max=2)
+    with raises(TypeError):
+        Length(min="1")
+    with raises(TypeError):
+        Length(max=-1)
+    # error message
+    with SE as exc:
+        Length(max=1, error="too long: {!r}").validate("abc")
+    assert "too long: 'abc'" in exc.value.autos
+    with SE as exc:
+        Length(max=5).validate("x" * 100)
+    assert "..." in str(exc.value)
+    assert "x" * 100 not in str(exc.value)
+    # inside a Schema
+    assert Schema({"name": And(str, Length(max=5))}).validate({"name": "José"}) == {
+        "name": "José"
+    }
+    with SE:
+        Schema({"name": Length(max=5)}).validate({"name": "Josée"})
+
+
+def test_length_json_schema():
+    assert Schema(Length(min=1, max=5)).json_schema("id") == {
+        "$schema": "http://json-schema.org/draft-07/schema#",
+        "$id": "id",
+        "type": "string",
+        "maxLength": 5,
+    }
+    assert "maxLength" not in Schema(Length(min=1)).json_schema("id")
+
+
