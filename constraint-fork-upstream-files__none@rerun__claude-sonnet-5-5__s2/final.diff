diff --git a/test/dash.js b/test/dash.js
new file mode 100644
index 0000000..f5be6a6
--- /dev/null
+++ b/test/dash.js
@@ -0,0 +1,35 @@
+const test = require('tape');
+const fn = require('../lib');
+
+test('-- without opts[--]: everything goes to _', t => {
+	t.same(fn(['a', '--', '-b', 'c']), { _: ['a', '-b', 'c'] });
+	t.end();
+});
+
+test('opts[--]: args after -- go to argv[--]', t => {
+	const argv = fn(['--foo', 'bar', 'a', '--', '-x', '--y=1', 'b'], { '--': true });
+	t.same(argv, { foo: 'bar', _: ['a'], '--': ['-x', '--y=1', 'b'] });
+	t.end();
+});
+
+test('opts[--]: argv[--] is empty array when no -- is present', t => {
+	t.same(fn(['a', '-x'], { '--': true }), { x: true, _: ['a'], '--': [] });
+	t.same(fn([], { '--': true }), { _: [], '--': [] });
+	t.end();
+});
+
+test('opts[--]: nothing after --', t => {
+	t.same(fn(['a', '--'], { '--': true }), { _: ['a'], '--': [] });
+	t.end();
+});
+
+test('opts[--]: values after -- are not parsed or coerced', t => {
+	t.same(fn(['--', '1', '--no-x'], { '--': true }), { _: [], '--': ['1', '--no-x'] });
+	t.end();
+});
+
+test('opts[--]: works with alias, boolean, default', t => {
+	const argv = fn(['-v', '--', 'rest'], { '--': true, alias: { v: 'verbose' }, boolean: 'v', default: { n: 1 } });
+	t.same(argv, { v: true, verbose: true, n: 1, _: [], '--': ['rest'] });
+	t.end();
+});
