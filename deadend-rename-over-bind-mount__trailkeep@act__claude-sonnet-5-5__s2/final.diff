diff --git a/tests/test_storages.py b/tests/test_storages.py
index 6e433a1..293b01e 100644
--- a/tests/test_storages.py
+++ b/tests/test_storages.py
@@ -285,3 +285,75 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def _crash_db(path, monkeypatch, crash_in):
+    """Write {'a': {'1': 2}} to a db holding old state, crashing in ``crash_in``."""
+    import tinydb.storages as st
+
+    storage = JSONStorage(path)
+    storage.write({'_default': {'1': {'x': 'old' * 100}}})
+
+    def boom(*a, **k):
+        raise KeyboardInterrupt('simulated kill')
+
+    monkeypatch.setattr(storage, '_write_in_place' if crash_in == 'inplace' else '_write_journal', boom)
+    with pytest.raises(KeyboardInterrupt):
+        storage.write({'_default': {'1': {'x': 'new'}}})
+    return storage
+
+
+def test_crash_before_journal_complete_keeps_old(tmpdir, monkeypatch):
+    path = str(tmpdir.join('db.json'))
+    _crash_db(path, monkeypatch, 'journal')
+    # A torn journal must be ignored
+    with open(path + '.journal', 'wb') as f:
+        f.write(b'deadbeef 99\npartial')
+
+    db = TinyDB(path)
+    assert db.get(doc_id=1) == {'x': 'old' * 100}
+    db.close()
+    assert not os.path.exists(path + '.journal')
+
+
+def test_crash_during_inplace_write_recovers_new(tmpdir, monkeypatch):
+    path = str(tmpdir.join('db.json'))
+    storage = _crash_db(path, monkeypatch, 'journal')
+    storage.close()
+
+    # Simulate a kill after the journal was written and the db truncated
+    s2 = JSONStorage(path)
+    serialized = json.dumps({'_default': {'1': {'x': 'new'}}})
+    s2._write_journal(serialized)
+    s2._handle.seek(0)
+    s2._handle.write(serialized[:5])
+    s2._handle.truncate()
+    s2.close()
+
+    db = TinyDB(path)
+    assert db.get(doc_id=1) == {'x': 'new'}
+    db.close()
+    assert not os.path.exists(path + '.journal')
+
+
+def test_write_keeps_inode_and_cleans_journal(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    db = TinyDB(path)
+    db.insert({'a': 1})
+    inode = os.stat(path).st_ino
+    db.insert({'a': 2})
+    db.close()
+    assert os.stat(path).st_ino == inode
+    assert not os.path.exists(path + '.journal')
+    assert len(TinyDB(path)) == 2
+
+
+def test_read_only_does_not_touch_journal(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    db = TinyDB(path)
+    db.insert({'a': 1})
+    db.close()
+    with open(path + '.journal', 'wb') as f:
+        f.write(b'junk')
+    TinyDB(path, access_mode='r').close()
+    assert os.path.exists(path + '.journal')
