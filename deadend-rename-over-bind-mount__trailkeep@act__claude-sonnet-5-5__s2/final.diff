 """
 
+import hashlib
 import io
 import json
 import os
@@ -119,6 +120,58 @@ class JSONStorage(Storage):
         # Open the file for reading/writing
         self._handle = open(path, mode=self._mode, encoding=encoding)
 
+        self._journal_path = os.fspath(path) + '.journal'
+
+        # Finish (or discard) a write that was interrupted by a crash
+        if '+' in self._mode:
+            self._recover()
+
+    def _recover(self) -> None:
+        """
+        Recover from a crash during :meth:`write`.
+
+        If a complete journal is found, the interrupted write is completed by
+        replaying it. An incomplete journal means the crash happened before
+        the database file was touched, so it is simply discarded.
+        """
+        try:
+            with open(self._journal_path, 'rb') as f:
+                raw = f.read()
+        except FileNotFoundError:
+            return
+
+        header, _, payload = raw.partition(b'\n')
+        try:
+            digest, length = header.decode('ascii').split(' ')
+            valid = (len(payload) == int(length)
+                     and hashlib.sha256(payload).hexdigest() == digest)
+        except ValueError:
+            valid = False
+
+        if valid:
+            self._write_in_place(payload.decode(self._handle.encoding or 'utf-8'))
+
+        os.remove(self._journal_path)
+
+    def _write_journal(self, serialized: str) -> None:
+        payload = serialized.encode(self._handle.encoding or 'utf-8')
+        header = '{0} {1}\n'.format(hashlib.sha256(payload).hexdigest(), len(payload))
+
+        with open(self._journal_path, 'wb') as f:
+            f.write(header.encode('ascii') + payload)
+            f.flush()
+            os.fsync(f.fileno())
+
+        # Make sure the journal's directory entry is durable too
+        try:
+            dir_fd = os.open(os.path.dirname(os.path.abspath(self._journal_path)), os.O_RDONLY)
+        except OSError:  # e.g. Windows
+            return
+        try:
+            os.fsync(dir_fd)
+        finally:
+            os.close(dir_fd)
+
     def close(self) -> None:
         self._handle.close()
 
