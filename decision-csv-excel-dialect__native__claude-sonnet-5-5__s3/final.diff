+def test_to_csv_quoting_and_unicode(db, tmp_path):
+    db.truncate()
+    db.insert({'name': 'Müller, "Hans"', 'note': 'a\nb'})
+    path = tmp_path / 'out.csv'
+    db.to_csv(path)
+
+    import csv
+    with open(path, newline='', encoding='utf-8') as f:
+        rows = list(csv.reader(f))
+    assert rows == [['name', 'note'], ['Müller, "Hans"', 'a\nb']]
+
+
+def test_to_csv_empty_table(db, tmp_path):
+    db.truncate()
+    path = tmp_path / 'out.csv'
+    db.to_csv(path)
+
+    # No documents and no fields: header only, and it is empty
+    assert path.read_text(encoding='utf-8').strip() == ''
+
+    db.to_csv(path, fields=['a', 'b'])
+    assert path.read_text(encoding='utf-8').splitlines() == ['a,b']
