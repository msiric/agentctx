@@ -218,6 +218,32 @@ class AbstractTestsClass(object):
         self.assertIsInstance(regular['a'], tuple)
         self.assertNotIsInstance(regular['a'][0], self.dict_class)
 
+    def test_to_dict_with_nested_lists(self):
+        nested = {'a': [[{'b': 1}], ({'c': 2},)]}
+        prop = self.dict_class(nested)
+        regular = prop.to_dict()
+        self.assertDictEqual(regular, nested)
+        self.assertIs(type(regular['a'][0][0]), dict)
+        self.assertIs(type(regular['a'][1][0]), dict)
+        self.assertIsInstance(regular['a'][1], tuple)
+
+    def test_flatten(self):
+        d = self.dict_class({'db': {'host': 'x', 'port': 1}, 'name': 'n',
+                             'tags': [{'a': 1}, 2], 'pair': (1, 2)})
+        flat = d.flatten()
+        self.assertIs(type(flat), dict)
+        self.assertDictEqual(flat, {
+            'db__host': 'x', 'db__port': 1, 'name': 'n',
+            'tags': [{'a': 1}, 2], 'pair': (1, 2)})
+
+    def test_flatten_deep_and_custom_sep(self):
+        d = self.dict_class({'a': {'b': {'c': 1}}})
+        self.assertDictEqual(d.flatten(), {'a__b__c': 1})
+        self.assertDictEqual(d.flatten(sep='.'), {'a.b.c': 1})
+
+    def test_flatten_empty(self):
+        self.assertDictEqual(self.dict_class().flatten(), {})
+
     def test_update(self):
         old = self.dict_class()
         old.child.a = 'a'
