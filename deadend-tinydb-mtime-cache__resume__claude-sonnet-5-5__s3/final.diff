             return None
-        else:
-            # Return the cursor to the beginning of the file
-            self._handle.seek(0)
 
-            # Load the JSON contents of the file
-            return json.load(self._handle)
+        if self._cached_raw is not None and raw == self._cached_raw:
+            # The file is unchanged since the last parse
+            return self._cached_data
+
+        # Load the JSON contents of the file
+        data = json.loads(raw)
+        self._cached_raw = raw
+        self._cached_data = data
+
+        return data
 
     def write(self, data: dict[str, dict[str, Any]]):
+        # The caller has probably modified the cached object in place, and
+        # the file is about to change, so the cache is no longer valid. This
+        # also covers a failed write below.
+        self.invalidate_cache()
+
         # Move the cursor to the beginning of the file just in case
         self._handle.seek(0)
 
