new file mode 100644
index 0000000..9028cc0
--- /dev/null
+++ b/scripts/bench_read.py
@@ -0,0 +1,112 @@
+"""
+Benchmark TinyDB read performance on a large JSON database.
+
+Usage: PYTHONPATH=. python scripts/bench_read.py [--size-mb 40] [--repeat 3]
+
+Generates a temporary db file, then times db.all(), a cold search, a cached
+search, and breaks down where the time goes (disk read, json parse, query
+evaluation, Document wrapping).
+"""
+import argparse
+import json
+import os
+import random
+import string
+import tempfile
+import time
+
+from tinydb import TinyDB, where
+from tinydb.table import Document
+
+
+def make_doc(i, rng):
+    return {
+        'id': i,
+        'name': ''.join(rng.choices(string.ascii_lowercase, k=12)),
+        'email': f'user{i}@example.com',
+        'age': rng.randint(18, 90),
+        'tags': [rng.choice(['a', 'b', 'c', 'd', 'e']) for _ in range(5)],
+        'address': {'city': rng.choice(['Berlin', 'Paris', 'Rome']),
+                    'zip': str(rng.randint(10000, 99999))},
+        'bio': ''.join(rng.choices(string.ascii_letters + ' ', k=200)),
+    }
+
+
+def generate(path, size_mb):
+    rng = random.Random(0)
+    docs, size, i = {}, 0, 0
+    per_doc = len(json.dumps(make_doc(0, rng))) + 12
+    n = int(size_mb * 1024 * 1024 / per_doc)
+    for i in range(1, n + 1):
+        docs[str(i)] = make_doc(i, rng)
+    with open(path, 'w') as f:
+        json.dump({'_default': docs}, f)
+    return n
+
+
+def best(fn, repeat):
+    times = []
+    for _ in range(repeat):
+        t = time.perf_counter()
+        result = fn()
+        times.append(time.perf_counter() - t)
+    return min(times), result
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--size-mb', type=float, default=40)
+    ap.add_argument('--repeat', type=int, default=3)
+    args = ap.parse_args()
+
+    with tempfile.TemporaryDirectory() as tmp:
+        path = os.path.join(tmp, 'db.json')
+        n = generate(path, args.size_mb)
+        print(f'{n} docs, {os.path.getsize(path) / 1e6:.1f} MB\n')
+
+        db = TinyDB(path)
+        q = where('age') > 80
+
+        def row(label, t):
+            print(f'{label:<40}{t * 1000:>10.1f} ms')
+
+        t, docs = best(db.all, args.repeat)
+        row(f'db.all() ({len(docs)} docs)', t)
+
+        def cold():
+            db.clear_cache()
+            return db.search(q)
+        t, res = best(cold, args.repeat)
+        row(f'search, cold cache ({len(res)} hits)', t)
+
+        db.search(q)
+        t, _ = best(lambda: db.search(q), args.repeat)
+        row('search, cached', t)
+
+        print('\nBreakdown (one full-table read):')
+        storage = db.storage
+
+        def raw_read():
+            with open(path) as f:
+                return f.read()
+        t_io, text = best(raw_read, args.repeat)
+        row('  file read (text decode)', t_io)
+
+        t_parse, data = best(lambda: json.loads(text), args.repeat)
+        row('  json.loads', t_parse)
+
+        t_store, table = best(lambda: storage.read()['_default'], args.repeat)
+        row('  JSONStorage.read() total', t_store)
+
+        t_eval, _ = best(lambda: [d for d in table.values() if q(d)],
+                         args.repeat)
+        row('  query eval on parsed data', t_eval)
+
+        t_wrap, _ = best(lambda: [Document(d, int(k))
+                                  for k, d in table.items()], args.repeat)
+        row('  Document wrapping (all docs)', t_wrap)
+        db.close()
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tests/test_storages.py b/tests/test_storages.py
index 6e433a1..18225cd 100644
--- a/tests/test_storages.py
+++ b/tests/test_storages.py
@@ -285,3 +285,53 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def test_json_read_skips_parse_when_unchanged(tmpdir, monkeypatch):
+    path = str(tmpdir.join('db.json'))
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+
+        calls = []
+        real_loads = json.loads
+        monkeypatch.setattr(
+            json, 'loads', lambda *a, **k: calls.append(1) or real_loads(*a, **k)
+        )
+
+        assert db.all() == [{'a': 1}]
+        assert db.all() == [{'a': 1}]
+        assert len(calls) == 1
+
+
+def test_json_read_sees_external_write_same_size_and_mtime(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+        assert db.all() == [{'a': 1}]
+
+        # Another process rewrites the file with same size and same mtime
+        st = os.stat(path)
+        with open(path, 'r+') as f:
+            content = f.read().replace('"a": 1', '"a": 2')
+            f.seek(0)
+            f.write(content)
+        os.utime(path, ns=(st.st_atime_ns, st.st_mtime_ns))
+        assert os.stat(path).st_size == st.st_size
+
+        assert db.all() == [{'a': 2}]
+
+
+def test_json_cache_not_corrupted_by_failing_updater(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+        db.all()
+
+        def boom(doc):
+            doc['a'] = 99
+            raise RuntimeError
+
+        with pytest.raises(RuntimeError):
+            db.update(boom)
+
+        assert db.all() == [{'a': 1}]
