+        # The raw contents of the file and the data parsed from them, as of
+        # the last read. The file is always re-read, but parsing is skipped
+        # if its contents are unchanged. We deliberately compare contents
+        # rather than mtime/size: those can't be trusted on filesystems such
+        # as NFS (coarse timestamps, attribute caching), where a write within
+        # the same second would go unnoticed.
+        self._cached_raw = None
