+def test_inprocess_jsonl_missing_key_uses_marker():
+    """In-process: a jsonl record lacking a key gets the "." missing marker"""
+    text = '{"id": 1, "name": "Alice"}\n{"id": 2}\n'
+    out = run_main_in_process(["-r", "jsonl", "-f", "tsv"], input_text=text)
