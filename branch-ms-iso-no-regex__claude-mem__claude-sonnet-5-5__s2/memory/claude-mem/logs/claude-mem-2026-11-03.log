[2026-11-03 02:30:13.490] [INFO ] [HOOK  ] → PostToolUse: Bash(cat >> src/index.ts <<'EOF'

function isDigit(c: string): boolean {
  return c >= '0' && c <= '9';
}

function isLetter(c: string): boolean {
  const lower = c.toLowerCase();
  return lower >= 'a' && lower <= 'z';
}

/**
 * Parse a compound duration such as `"1h 30m"` or `"2 days 4 hours"` and
 * return the total in milliseconds. Every component must have a unit, and each
 * component is parsed with the same rules as `parse()`.
 *
 * @param str - A string of one or more `<number><unit>` components
 * @returns The total in milliseconds, or `NaN` if the string can't be parsed
 */
export function parseCompound(str: string): number {
  if (typeof str !== 'string') {
    return NaN;
  }
  const len = str.length;
  let total = 0;
  let count = 0;
  let i = 0;
  while (i < len) {
    while (i < len && str[i] === ' ') {
      i++;
    }
    if (i >= len) {
      break;
    }
    const numStart = i;
    if (str[i] === '-') {
      i++;
    }
    while (i < len && (isDigit(str[i]) || str[i] === '.')) {
      i++;
    }
    const num = str.slice(numStart, i);
    while (i < len && str[i] === ' ') {
      i++;
    }
    const unitStart = i;
    while (i < len && isLetter(str[i])) {
      i++;
    }
    const unit = str.slice(unitStart, i);
    if (unit.length === 0 || unit.length > 12) {
      return NaN;
    }
    const value = parse(num + unit);
    if (Number.isNaN(value)) {
      return NaN;
    }
    total += value;
    count++;
  }
  return count === 0 ? NaN : total;
}
EOF
cat > src/parse-compound.test.ts <<'EOF'
import { describe, expect, it } from '@jest/globals';
import { parseCompound } from './index';

describe('parseCompound(string)', () => {
  it('should sum compact components', () => {
    expect(parseCompound('1h30m')).toBe(5400000);
  });

  it('should sum space separated components', () => {
    expect(parseCompound('1h 30m')).toBe(5400000);
  });

  it('should support long units and spaces between number and unit', () => {
    expect(parseCompound('2 days 4 hours')).toBe(2 * 86400000 + 4 * 3600000);
  });

  it('should support a single component', () => {
    expect(parseCompound('90s')).toBe(90000);
  });

  it('should support decimals, case and surrounding whitespace', () => {
    expect(parseCompound('  1.5H 30M ')).toBe(7200000);
  });

  it('should support negative components', () => {
    expect(parseCompound('1h -30m')).toBe(1800000);
  });

  it('should return NaN for an empty or blank string', () => {
    expect(parseCompound('')).toBeNaN();
    expect(parseCompound('   ')).toBeNaN();
  });

  it('should return NaN for non-strings', () => {
    expect(parseCompound(undefined as unknown as string)).toBeNaN();
    expect(parseCompound(5 as unknown as string)).toBeNaN();
  });

  it('should return NaN when a component has no unit', () => {
    expect(parseCompound('1h 30')).toBeNaN();
    expect(parseCompound('100')).toBeNaN();
  });

  it('should return NaN when a component has no number', () => {
    expect(parseCompound('h')).toBeNaN();
    expect(parseCompound('1h m')).toBeNaN();
  });

  it('should return NaN for unknown units', () => {
    expect(parseCompound('1h 5x')).toBeNaN();
    expect(parseCompound('1 abcdefghijklmnop')).toBeNaN();
  });

  it('should return NaN for malformed numbers', () => {
    expect(parseCompound('1.h')).toBeNaN();
    expect(parseCompound('1h #')).toBeNaN();
  });
});
EOF
