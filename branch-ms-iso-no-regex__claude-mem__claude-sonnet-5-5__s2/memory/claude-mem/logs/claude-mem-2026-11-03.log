const COMPONENT =
  '-?\\d*\\.?\\d+ *(?:milliseconds?|msecs?|ms|seconds?|secs?|s|minutes?|mins?|m|hours?|hrs?|h|days?|d|weeks?|w|months?|mo|years?|yrs?|y)';
const COMPOUND = new RegExp(`^ *${COMPONENT}(?: *${COMPONENT})* *$`, 'i');
const COMPOUND_PART = new RegExp(COMPONENT, 'gi');

/**
 * Parse a compound duration such as `"1h 30m"` or `"2 days 4 hours"` and
 * return the total in milliseconds. Every component must have a unit, and each
 * component is converted with `parse()`.
 *
 * @param str - A string of one or more `<number><unit>` components, at most 100
 * characters long
 * @returns The total in milliseconds, or `NaN` if the string can't be parsed
 */
export function parseCompound(str: string): number {
  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
    return NaN;
  }
  if (!COMPOUND.test(str)) {
    return NaN;
  }
  let total = 0;
  for (const [part] of str.matchAll(COMPOUND_PART)) {
    total += parse(part.replace(/ /g, ''));
  }
  return total;
}
