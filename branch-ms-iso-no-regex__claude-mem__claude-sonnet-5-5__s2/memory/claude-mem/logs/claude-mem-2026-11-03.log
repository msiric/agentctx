/**
 * Parse an ISO 8601 duration string into milliseconds. This is the inverse of
 * `formatISO`.
 *
 * Supports days, hours, minutes and (fractional) seconds, with an optional
 * leading sign. Years, months and weeks are not supported since they are
 * ambiguous, and yield `NaN`, as does any other malformed input.
 *
 * @example
 * parseISO("PT1H30M"); // 5400000
 * parseISO("P1DT1H1M1S"); // 90061000
 *
 * @param str - the ISO 8601 duration string
 * @returns The duration in milliseconds, or `NaN` if the string is not a supported duration
 */
export function parseISO(str: string): number {
  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
    throw new Error(
      `Value provided to ms.parseISO() must be a string with length between 1 and 100. value=${JSON.stringify(str)}`,
    );
  }

  const match =
    /^(?<sign>[-+])?P(?:(?<days>\d+)D)?(?<time>T(?:(?<hours>\d+)H)?(?:(?<minutes>\d+)M)?(?:(?<seconds>\d+(?:\.\d+)?)S)?)?$/.exec(
      str,
    );

  // Reject "P" and "PT" (and "P1DT"), which have no components.
  if (!match?.groups) {
    return NaN;
  }
  const { sign, days, time, hours, minutes, seconds } = match.groups as Record<
    string,
    string | undefined
  >;
  if (days === undefined && hours === undefined && minutes === undefined && seconds === undefined) {
    return NaN;
  }
  if (time === 'T' && hours === undefined && minutes === undefined && seconds === undefined) {
    return NaN;
  }

  const total =
    Number(days ?? 0) * d +
    Number(hours ?? 0) * h +
    Number(minutes ?? 0) * m +
    Number(seconds ?? 0) * s;

  // Round to whole milliseconds to hide floating point error from fractions.
  const result = Math.round(total);
  return sign === '-' ? -result : result;
}
EOF
cat > src/parse-iso.test.ts <<'EOF'
import { describe, expect, it } from '@jest/globals';
import { formatISO, parseISO } from './index';

describe('parseISO(string)', () => {
  it('should parse the documented examples', () => {
    expect(parseISO('PT1H30M')).toBe(5400000);
    expect(parseISO('P1DT1H1M1S')).toBe(90061000);
  });

  it('should parse each unit on its own', () => {
    expect(parseISO('PT1S')).toBe(1000);
    expect(parseISO('PT1M')).toBe(60000);
    expect(parseISO('PT1H')).toBe(3600000);
    expect(parseISO('P1D')).toBe(86400000);
    expect(parseISO('P400D')).toBe(86400000 * 400);
  });

  it('should parse zero', () => {
    expect(parseISO('PT0S')).toBe(0);
    expect(parseISO('P0D')).toBe(0);
  });

  it('should parse fractional seconds', () => {
    expect(parseISO('PT0.5S')).toBe(500);
    expect(parseISO('PT1.001S')).toBe(1001);
    expect(parseISO('PT1M0.01S')).toBe(60010);
  });

  it('should parse signed values', () => {
    expect(parseISO('-PT1H30M')).toBe(-5400000);
    expect(parseISO('+PT1H30M')).toBe(5400000);
  });

  it('should return NaN for unsupported or malformed input', () => {
    for (const input of [
      'P',
      'PT',
      'P1DT',
      'P1Y',
      'P1M',
      'P1W',
      'P1Y2M3DT4H',
      'PT1H30',
      'PT1M1H',
      'P1H',
      '1H30M',
      'pt1h',
      'PT-1H',
      'PT.5S',
      'PT1,5S',
      'PT1H ',
      'abc',
    ]) {
      expect(parseISO(input)).toBeNaN();
    }
  });

  it('should throw on non-string, empty or overlong values', () => {
    expect(() => parseISO('')).toThrow();
    expect(() => parseISO(5400000 as unknown as string)).toThrow();
    expect(() => parseISO(undefined as unknown as string)).toThrow();
    expect(() => parseISO(`PT${'1'.repeat(99)}S`)).toThrow();
  });

  it('should be the inverse of formatISO', () => {
    for (const ms of [0, 1, 500, 1001, 60010, 5400000, 90061000, -5400000, -500]) {
      expect(parseISO(formatISO(ms))).toBe(ms);
    }
  });
});
EOF
