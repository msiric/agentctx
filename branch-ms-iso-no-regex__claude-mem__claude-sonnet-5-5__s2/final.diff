@@ -242,3 +242,114 @@ function plural(
   const isPlural = msAbs >= n * 1.5;
   return `${Math.round(ms / n)} ${name}${isPlural ? 's' : ''}` as StringValue;
 }
+
+/**
+ * Format the given milliseconds as an ISO 8601 duration string.
+ *
+ * Days are the largest unit used, since months and years are ambiguous.
+ * Sub-second precision is emitted as a decimal fraction of the seconds
+ * component. Negative values are prefixed with `-` and zero is `PT0S`.
+ *
+ * @example
+ * formatISO(5400000); // "PT1H30M"
+ * formatISO(90061000); // "P1DT1H1M1S"
+ *
+ * @param ms - milliseconds
+ * @returns The ISO 8601 duration string
+ */
+export function formatISO(ms: number): string {
+  if (typeof ms !== 'number' || !Number.isFinite(ms)) {
+    throw new Error('Value provided to ms.formatISO() must be of type number.');
+  }
+
+  let rest = Math.round(Math.abs(ms));
+  if (rest === 0) {
+    return 'PT0S';
+  }
+
+  const days = Math.floor(rest / d);
+  rest -= days * d;
+  const hours = Math.floor(rest / h);
+  rest -= hours * h;
+  const minutes = Math.floor(rest / m);
+  rest -= minutes * m;
+  const seconds = Math.floor(rest / s);
+  const millis = rest - seconds * s;
+
+  let secStr = '';
+  if (millis > 0) {
+    let frac = String(millis).padStart(3, '0');
+    while (frac.endsWith('0')) {
+      frac = frac.slice(0, -1);
+    }
+    secStr = `${seconds}.${frac}S`;
+  } else if (seconds > 0) {
+    secStr = `${seconds}S`;
+  }
+
+  const time = `${hours ? `${hours}H` : ''}${minutes ? `${minutes}M` : ''}${secStr}`;
+  return `${ms < 0 ? '-' : ''}P${days ? `${days}D` : ''}${time ? `T${time}` : ''}`;
+}
+
+/**
+ * Parse an ISO 8601 duration string into milliseconds. This is the inverse of
+ * `formatISO`.
+ *
+ * Supports days, hours, minutes and (fractional) seconds, with an optional
+ * leading sign. Years, months and weeks are not supported since they are
+ * ambiguous, and yield `NaN`, as does any other malformed input.
+ *
+ * @example
+ * parseISO("PT1H30M"); // 5400000
+ * parseISO("P1DT1H1M1S"); // 90061000
+ *
+ * @param str - the ISO 8601 duration string
+ * @returns The duration in milliseconds, or `NaN` if the string is not a supported duration
+ */
+export function parseISO(str: string): number {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw new Error(
+      `Value provided to ms.parseISO() must be a string with length between 1 and 100. value=${JSON.stringify(str)}`,
+    );
+  }
+
+  const match =
+    /^(?<sign>[-+])?P(?:(?<days>\d+)D)?(?<time>T(?:(?<hours>\d+)H)?(?:(?<minutes>\d+)M)?(?:(?<seconds>\d+(?:\.\d+)?)S)?)?$/.exec(
+      str,
+    );
+
+  // Reject "P" and "PT" (and "P1DT"), which have no components.
+  if (!match?.groups) {
+    return NaN;
+  }
+  const { sign, days, time, hours, minutes, seconds } = match.groups as Record<
+    string,
+    string | undefined
+  >;
+  if (
+    days === undefined &&
+    hours === undefined &&
+    minutes === undefined &&
+    seconds === undefined
+  ) {
+    return NaN;
+  }
+  if (
+    time === 'T' &&
+    hours === undefined &&
+    minutes === undefined &&
+    seconds === undefined
+  ) {
+    return NaN;
+  }
+
+  const total =
+    Number(days ?? 0) * d +
+    Number(hours ?? 0) * h +
+    Number(minutes ?? 0) * m +
+    Number(seconds ?? 0) * s;
+
+  // Round to whole milliseconds to hide floating point error from fractions.
+  const result = Math.round(total);
+  return sign === '-' ? -result : result;
+}
