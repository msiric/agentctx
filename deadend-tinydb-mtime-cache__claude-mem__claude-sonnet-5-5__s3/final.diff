 from typing import Any, Optional
@@ -119,10 +120,57 @@ class JSONStorage(Storage):
         # Open the file for reading/writing
         self._handle = open(path, mode=self._mode, encoding=encoding)
 
+        # Parse cache: (file signature, parsed data). See ``read``.
+        self._cache: Optional[tuple[tuple, Any]] = None
+
+    # A file whose mtime is younger than this (in ns) is never trusted as an
+    # unchanged cache hit: another process may rewrite it within the
+    # filesystem's timestamp granularity, leaving mtime and size identical.
+    _CACHE_SETTLE_NS = 2_000_000_000
+
     def close(self) -> None:
+        self._cache = None
         self._handle.close()
 
+    def invalidate_cache(self) -> None:
+        """
+        Drop the cached parse result so the next read hits the file.
+        """
+
+        self._cache = None
+
+    def _signature(self) -> tuple:
+        st = os.fstat(self._handle.fileno())
+        return st.st_ino, st.st_size, st.st_mtime_ns, st.st_ctime_ns
+
     def read(self) -> Optional[dict[str, dict[str, Any]]]:
+        """
+        Read the file, re-using the previously parsed data if the file is
+        unchanged (inode, size, mtime and ctime), so changes made by other
+        processes are still picked up.
+
+        The returned object is shared with the cache: callers must not
+        mutate it, except to hand it straight back to :meth:`write`.
+        """
+
+        signature = self._signature()
+        cache = self._cache
+        if cache is not None and cache[0] == signature:
+            return cache[1]
+
+        data = self._read_file()
+
+        # Only cache if the file is old enough that a later external write
+        # is guaranteed to change its mtime (avoids the "racy timestamp"
+        # problem). Fresh files are simply re-parsed next time.
+        if data is not None and time.time_ns() - signature[2] > self._CACHE_SETTLE_NS:
+            self._cache = (signature, data)
+        else:
+            self._cache = None
+
+        return data
+
+    def _read_file(self) -> Optional[dict[str, dict[str, Any]]]:
         # Get the file size by moving the cursor to the file end and reading
         # its location
         self._handle.seek(0, os.SEEK_END)
@@ -140,6 +188,10 @@ class JSONStorage(Storage):
             return json.load(self._handle)
 
     def write(self, data: dict[str, dict[str, Any]]):
+        # The caller may have mutated the cached object in place, and the
+        # file is about to change anyway.
+        self._cache = None
+
         # Move the cursor to the beginning of the file just in case
         self._handle.seek(0)
 
