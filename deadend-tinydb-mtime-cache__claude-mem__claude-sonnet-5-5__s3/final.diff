diff --git a/scripts/bench_read.py b/scripts/bench_read.py
new file mode 100644
index 0000000..61e5ab8
--- /dev/null
+++ b/scripts/bench_read.py
@@ -0,0 +1,116 @@
+"""
+Benchmark TinyDB read performance on a large JSON database.
+
+Usage: python scripts/bench_read.py [--mb 40] [--repeat 3] [--keep PATH]
+
+Generates a db of roughly --mb megabytes in a temp dir (or at --keep), then
+times db.all(), a (cache-missing) search, a repeated search, and the raw
+json.load of the same file, so you can see how much of each call is parsing.
+"""
+import argparse
+import json
+import os
+import random
+import statistics
+import string
+import sys
+import tempfile
+import time
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))
+
+from tinydb import TinyDB, where  # noqa: E402
+
+
+def make_doc(i, rng):
+    return {
+        'id': i,
+        'name': ''.join(rng.choices(string.ascii_lowercase, k=12)),
+        'group': rng.randrange(1000),
+        'score': rng.random(),
+        'tags': [rng.choice(['a', 'b', 'c', 'd', 'e']) for _ in range(5)],
+        'text': ''.join(rng.choices(string.ascii_letters + ' ', k=200)),
+    }
+
+
+def generate(path, target_mb):
+    rng = random.Random(0)
+    # Build the dict directly and write once; inserting via TinyDB would be
+    # quadratic-ish since every insert re-reads the file.
+    data, n = {}, 0
+    per_doc = len(json.dumps(make_doc(0, rng)))
+    total = int(target_mb * 1024 * 1024 / per_doc)
+    for n in range(1, total + 1):
+        data[str(n)] = make_doc(n, rng)
+    with open(path, 'w') as f:
+        json.dump({'_default': data}, f)
+    return total
+
+
+def timeit(fn, repeat):
+    times = []
+    for _ in range(repeat):
+        t = time.perf_counter()
+        fn()
+        times.append(time.perf_counter() - t)
+    return statistics.median(times), min(times)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--mb', type=float, default=40)
+    ap.add_argument('--repeat', type=int, default=3)
+    ap.add_argument('--keep', help='write the db here and keep it')
+    args = ap.parse_args()
+
+    tmp = None
+    if args.keep:
+        path = args.keep
+    else:
+        tmp = tempfile.TemporaryDirectory()
+        path = os.path.join(tmp.name, 'big.json')
+
+    t = time.perf_counter()
+    count = generate(path, args.mb)
+    print(f'generated {count} docs, {os.path.getsize(path)/1e6:.1f} MB '
+          f'in {time.perf_counter()-t:.1f}s\n')
+
+    db = TinyDB(path)
+    results = []
+
+    def run(label, fn):
+        med, best = timeit(fn, args.repeat)
+        results.append((label, med))
+        print(f'{label:<42} median {med*1000:9.1f} ms   best {best*1000:9.1f} ms')
+
+    def raw_load():
+        with open(path) as f:
+            json.load(f)
+
+    run('json.load (raw parse, floor)', raw_load)
+    run('JSONStorage.read()', db.storage.read)
+    run('db.all()', db.all)
+
+    counter = iter(range(10**9))
+
+    def uncached_search():
+        # a distinct query each time so the query cache can't help
+        db.search(where('group') == next(counter) % 1000)
+
+    run('db.search() (cache miss)', uncached_search)
+
+    q = where('group') == 7
+    db.search(q)
+    run('db.search() (cache hit, same query)', lambda: db.search(q))
+
+    base = dict(results)['json.load (raw parse, floor)']
+    print(f'\nraw json.load is {base/dict(results)["db.all()"]*100:.0f}% of db.all() '
+          f'and {base/dict(results)["db.search() (cache miss)"]*100:.0f}% of an '
+          f'uncached search.')
+    db.close()
+    if tmp:
+        tmp.cleanup()
+
+
+if __name__ == '__main__':
+    main()
