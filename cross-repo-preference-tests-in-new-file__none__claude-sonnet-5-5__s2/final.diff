 export default function decamelize(string: string, options?: Options): string;
+
+/**
+Decamelize each own enumerable key of a plain object. Shallow: values are left untouched.
+
+@param object - The object whose keys to decamelize.
+@param options - Passed through to `decamelize`.
+
+@example
+```
+import {decamelizeKeys} from 'decamelize';
+
+decamelizeKeys({unicornRainbow: 1, fooBar: {bazQux: 2}}, {separator: '-'});
+//=> {'unicorn-rainbow': 1, 'foo-bar': {bazQux: 2}}
+```
+*/
+export function decamelizeKeys<T extends Record<string, unknown>>(
+	object: T,
+	options?: Options,
+): Record<string, T[keyof T]>;
