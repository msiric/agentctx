+/* eslint-disable camelcase -- Expected keys are snake_case. */
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import {decamelizeKeys} from './index.js';
+
+test('decamelizeKeys', () => {
+	assert.deepEqual(decamelizeKeys({fooBar: 1, bazQux: 2, plain: 3}), {foo_bar: 1, baz_qux: 2, plain: 3});
+	assert.deepEqual(decamelizeKeys({}), {});
+});
+
+test('decamelizeKeys passes options through', () => {
+	assert.deepEqual(decamelizeKeys({fooBar: 1}, {separator: '-'}), {'foo-bar': 1});
+	assert.deepEqual(decamelizeKeys({testGUILabel: 1}, {preserveConsecutiveUppercase: true}), {test_GUI_label: 1});
+});
+
+test('decamelizeKeys is shallow and returns a new object', () => {
+	const nested = {innerKey: 1};
+	const input = {outerKey: nested};
+	const result = decamelizeKeys(input);
+	assert.notEqual(result, input);
+	assert.equal(result.outer_key, nested);
+	assert.deepEqual(input, {outerKey: nested});
+});
+
+test('decamelizeKeys only uses own keys', () => {
+	const input = Object.create({inheritedKey: 1});
+	input.ownKey = 2;
+	assert.deepEqual(decamelizeKeys(input), {own_key: 2});
+});
+
+test('decamelizeKeys keeps a __proto__ key as data', () => {
+	const input = JSON.parse('{"__proto__": {"a": 1}}');
+	const result = decamelizeKeys(input);
+	assert.equal(Object.getPrototypeOf(result), Object.prototype);
+	assert.deepEqual(Object.keys(result), ['__proto__']);
+});
+
+test('decamelizeKeys rejects non-objects', () => {
+	for (const value of [null, undefined, 'str', 1, []]) {
+		assert.throws(() => decamelizeKeys(value), TypeError);
+	}
+});
