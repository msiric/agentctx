@@ -0,0 +1,96 @@
+import { describe, expect, it } from '@jest/globals';
+import { formatISO, parseISO } from './index';
+
+describe('parseISO(string)', () => {
+  it('parses the documented examples', () => {
+    expect(parseISO('PT1H30M')).toBe(5400000);
+    expect(parseISO('P1DT1H1M1S')).toBe(90061000);
+  });
+
+  it('parses single components', () => {
+    expect(parseISO('P1D')).toBe(86400000);
+    expect(parseISO('PT1H')).toBe(3600000);
+    expect(parseISO('PT1M')).toBe(60000);
+    expect(parseISO('PT1S')).toBe(1000);
+    expect(parseISO('P1W')).toBe(604800000);
+    expect(parseISO('P1W2D')).toBe(604800000 + 2 * 86400000);
+    expect(parseISO('PT0S')).toBe(0);
+  });
+
+  it('distinguishes M in the date and time parts', () => {
+    expect(parseISO('PT5M')).toBe(300000);
+    expect(parseISO('P5M')).toBeNaN();
+  });
+
+  it('parses fractions on the last component', () => {
+    expect(parseISO('PT1.5S')).toBe(1500);
+    expect(parseISO('PT0.001S')).toBe(1);
+    expect(parseISO('PT1,5S')).toBe(1500);
+    expect(parseISO('PT1.5H')).toBe(5400000);
+    expect(parseISO('P0.5D')).toBe(43200000);
+    expect(parseISO('PT1.001S')).toBe(1001);
+  });
+
+  it('handles signs', () => {
+    expect(parseISO('-PT1H')).toBe(-3600000);
+    expect(parseISO('+PT1H')).toBe(3600000);
+  });
+
+  it('rejects years and months', () => {
+    expect(parseISO('P1Y')).toBeNaN();
+    expect(parseISO('P1M')).toBeNaN();
+    expect(parseISO('P1Y2M3DT4H')).toBeNaN();
+  });
+
+  it('rejects malformed input', () => {
+    for (const bad of [
+      'P',
+      'PT',
+      'P1DT',
+      '1H',
+      'PT1',
+      'PT1X',
+      'pt1h',
+      'PT1H1H',
+      'PT30M1H',
+      'P1D2W',
+      'PTT1H',
+      'PT1.S',
+      'PT.5S',
+      'PT1.5H30M',
+      'PT1.5.5S',
+      'PT-1H',
+      '--PT1H',
+      'P1D1H',
+      'PT1 H',
+      ' PT1H',
+      'PT1H ',
+      'PTH',
+      'hello',
+    ]) {
+      expect(parseISO(bad)).toBeNaN();
+    }
+  });
+
+  it('throws on non-strings and bad lengths', () => {
+    expect(() => parseISO('')).toThrow();
+    expect(() => parseISO(`PT${'1'.repeat(100)}S`)).toThrow();
+    expect(() => parseISO(undefined as unknown as string)).toThrow();
+    expect(() => parseISO(5 as unknown as string)).toThrow();
+  });
+
+  it('is fast on pathological input', () => {
+    const start = Date.now();
+    parseISO(`P${'1'.repeat(98)}`);
+    parseISO(`PT${'1.'.repeat(48)}`);
+    expect(Date.now() - start).toBeLessThan(100);
+  });
+
+  it('round-trips with formatISO', () => {
+    for (const n of [
+      0, 1, 999, 1000, 1500, 60000, 5400000, 90061001, -5400000,
+    ]) {
+      expect(parseISO(formatISO(n))).toBe(n);
+    }
+  });
+});
