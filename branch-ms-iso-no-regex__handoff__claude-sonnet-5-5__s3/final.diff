+
+/**
+ * Format the given milliseconds as an ISO 8601 duration string.
+ *
+ * Days are the largest unit used, since months and years are ambiguous.
+ * Fractional milliseconds are rounded. Negative values get a leading `-`
+ * (an ISO 8601-2 extension), and zero is `PT0S`.
+ *
+ * @param ms - milliseconds
+ * @returns The ISO 8601 duration, e.g. `PT1H30M` or `P1DT1H1M1S`
+ * @throws Error if `ms` is not a finite number
+ */
+export function formatISO(ms: number): string {
+  if (typeof ms !== 'number' || !Number.isFinite(ms)) {
+    throw new Error('Value provided to ms.formatISO() must be of type number.');
+  }
+
+  let rest = Math.round(Math.abs(ms));
+  const days = Math.floor(rest / d);
+  rest -= days * d;
+  const hours = Math.floor(rest / h);
+  rest -= hours * h;
+  const minutes = Math.floor(rest / m);
+  rest -= minutes * m;
+  const seconds = Math.floor(rest / s);
+  const millis = rest - seconds * s;
+
+  let time = '';
+  if (hours) time += `${hours}H`;
+  if (minutes) time += `${minutes}M`;
+  if (seconds || millis) {
+    const frac = millis
+      ? `.${String(millis).padStart(3, '0').replace(/0+$/, '')}`
+      : '';
+    time += `${seconds}${frac}S`;
+  }
+
+  if (!days && !time) {
+    return 'PT0S';
+  }
+  return `${ms < 0 ? '-' : ''}P${days ? `${days}D` : ''}${time ? `T${time}` : ''}`;
+}
+
+function isDigit(c: string | undefined): boolean {
+  return c !== undefined && c >= '0' && c <= '9';
+}
+
+/**
+ * Parse an ISO 8601 duration string and return milliseconds. The inverse of
+ * `formatISO`.
+ *
+ * Supports weeks, days, hours, minutes and seconds (`PT1H30M`, `P1DT1H`,
+ * `P2W`), an optional leading `-` or `+`, and a decimal fraction (`.` or `,`)
+ * on the last component only (`PT1.5S`). Years and months are rejected as
+ * ambiguous, matching `formatISO`. Designators must be uppercase and in order.
+ * Implemented as a character scanner (no regular expressions).
+ *
+ * @param str - An ISO 8601 duration
+ * @returns The duration in milliseconds, or `NaN` if the string is not a
+ * supported ISO 8601 duration
+ * @throws Error if `str` is not a string with length between 1 and 99
+ */
+export function parseISO(str: string): number {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw new Error(
+      `Value provided to ms.parseISO() must be a string with length between 1 and 99. value=${JSON.stringify(str)}`,
+    );
+  }
+
+  let i = 0;
+  let sign = 1;
+  if (str[i] === '-' || str[i] === '+') {
+    sign = str[i] === '-' ? -1 : 1;
+    i++;
+  }
+  if (str[i] !== 'P') {
+    return NaN;
+  }
+  i++;
+
+  // Designators in the only order they may appear, with their sizes.
+  const dateUnits = ['W', 'D'];
+  const dateSizes = [w, d];
+  const timeUnits = ['H', 'M', 'S'];
+  const timeSizes = [h, m, s];
+
+  let inTime = false;
+  let unitIdx = 0; // next allowed index into the current unit list
+  let components = 0;
+  let sawFraction = false;
+  let total = 0;
+
+  while (i < str.length) {
+    if (str[i] === 'T') {
+      if (inTime) return NaN;
+      inTime = true;
+      unitIdx = 0;
+      i++;
+      // 'T' must be followed by at least one component.
+      if (i >= str.length) return NaN;
+      continue;
+    }
+
+    // A fraction is only allowed on the final component.
+    if (sawFraction) return NaN;
+
+    const start = i;
+    while (isDigit(str[i])) i++;
+    if (i === start) return NaN;
+    if (str[i] === '.' || str[i] === ',') {
+      i++;
+      const fracStart = i;
+      while (isDigit(str[i])) i++;
+      if (i === fracStart) return NaN;
+      sawFraction = true;
+    }
+    const n = Number(str.slice(start, i).replace(',', '.'));
+
+    const units = inTime ? timeUnits : dateUnits;
+    const sizes = inTime ? timeSizes : dateSizes;
+    const found = units.indexOf(str[i] ?? '', unitIdx);
+    if (found === -1) return NaN;
+    unitIdx = found + 1;
+    total += n * (sizes[found] as number);
+    components++;
+    i++;
+  }
+
+  if (components === 0) return NaN;
+  // Round to whole ms, as formatISO does, to absorb float error.
+  return sign * Math.round(total);
+}
