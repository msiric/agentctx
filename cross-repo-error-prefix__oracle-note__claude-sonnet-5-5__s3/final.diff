@@ -292,3 +292,48 @@ test('keep the sub-day parts exact at any magnitude', () => {
 		assert.strictEqual(parsed.hours, Number(bigint.hours), `${milliseconds}ms hours against the bigint path`);
 	}
 });
+
+test('largestUnit', () => {
+	const day = 86_400_000;
+	const input = day + (2 * 3_600_000) + (3 * 60_000) + 4000 + 5;
+
+	assert.deepStrictEqual(parseMilliseconds(input), parseMilliseconds(input, {largestUnit: 'days'}));
+	assert.deepStrictEqual(parseMilliseconds(input, {largestUnit: 'hours'}), {
+		days: 0, hours: 26, minutes: 3, seconds: 4, milliseconds: 5, microseconds: 0, nanoseconds: 0,
+	});
+	assert.deepStrictEqual(parseMilliseconds(input, {largestUnit: 'minutes'}), {
+		days: 0, hours: 0, minutes: 1563, seconds: 4, milliseconds: 5, microseconds: 0, nanoseconds: 0,
+	});
+	assert.deepStrictEqual(parseMilliseconds(input, {largestUnit: 'seconds'}), {
+		days: 0, hours: 0, minutes: 0, seconds: 93_784, milliseconds: 5, microseconds: 0, nanoseconds: 0,
+	});
+	assert.equal(parseMilliseconds(-input, {largestUnit: 'hours'}).hours, -26);
+	assert.deepStrictEqual(parseMilliseconds(1.5, {largestUnit: 'seconds'}), {
+		days: 0, hours: 0, minutes: 0, seconds: 0, milliseconds: 1, microseconds: 500, nanoseconds: 0,
+	});
+});
+
+test('largestUnit - bigint', () => {
+	const input = 86_400_000n + (2n * 3_600_000n) + (3n * 60_000n) + 4000n + 5n;
+
+	assert.deepStrictEqual(parseMilliseconds(input, {largestUnit: 'hours'}), {
+		days: 0n, hours: 26n, minutes: 3n, seconds: 4n, milliseconds: 5n, microseconds: 0n, nanoseconds: 0n,
+	});
+	assert.deepStrictEqual(parseMilliseconds(input, {largestUnit: 'minutes'}), {
+		days: 0n, hours: 0n, minutes: 1563n, seconds: 4n, milliseconds: 5n, microseconds: 0n, nanoseconds: 0n,
+	});
+	assert.deepStrictEqual(parseMilliseconds(input, {largestUnit: 'seconds'}), {
+		days: 0n, hours: 0n, minutes: 0n, seconds: 93_784n, milliseconds: 5n, microseconds: 0n, nanoseconds: 0n,
+	});
+	assert.deepStrictEqual(parseMilliseconds(input, {largestUnit: 'days'}), parseMilliseconds(input));
+});
+
+test('largestUnit - invalid', () => {
+	for (const largestUnit of ['weeks', 'milliseconds', 'Hours', '', null, 1]) {
+		for (const input of [1000, 1000n]) {
+			assert.throws(() => {
+				parseMilliseconds(input, {largestUnit});
+			}, {name: 'TypeError', message: /^parse-ms: /v});
+		}
+	}
+});
