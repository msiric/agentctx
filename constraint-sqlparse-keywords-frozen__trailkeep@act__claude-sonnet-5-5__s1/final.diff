diff --git a/sqlparse/extra_keywords.py b/sqlparse/extra_keywords.py
new file mode 100644
index 0000000..d5c139e
--- /dev/null
+++ b/sqlparse/extra_keywords.py
@@ -0,0 +1,21 @@
+"""Local keyword additions, kept out of keywords.py so that file stays
+identical to upstream. Registered on the default lexer at import time."""
+
+from sqlparse import tokens
+from sqlparse.lexer import Lexer
+
+KEYWORDS_LOCAL_SNOWFLAKE = {
+    'EXCLUDE': tokens.Keyword,
+    'MATCH_RECOGNIZE': tokens.Keyword,
+    'ASOF': tokens.Keyword,
+    'MATCH_CONDITION': tokens.Keyword,
+}
+
+
+def register(lexer=None):
+    """Add the local keywords to ``lexer`` (default: the shared instance)."""
+    (lexer or Lexer.get_default_instance()).add_keywords(
+        KEYWORDS_LOCAL_SNOWFLAKE)
+
+
+register()
diff --git a/tests/test_cli.py b/tests/test_cli.py
index f33b534..c70d774 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -235,3 +235,25 @@ def test_cli_outfile_keeps_file_on_format_error(tmpdir, capsys):
     assert out_file.read() == "select 1"
     _, err = capsys.readouterr()
     assert err.startswith("[ERROR] Failed to format")
+
+
+def test_cli_check(tmpdir, capsys):
+    clean = tmpdir.join('clean.sql')
+    clean.write('select 1\n')
+    dirty = tmpdir.join('dirty.sql')
+    dirty.write('select a,b from t\n')
+    formatted = sqlparse.format('select 1\n', reindent=True)
+    clean.write(formatted)
+    assert sqlparse.cli.main([str(clean), '-r', '--check']) == 0
+    assert capsys.readouterr().out == ''
+    before = dirty.read()
+    assert sqlparse.cli.main([str(clean), str(dirty), '-r', '--check']) == 1
+    assert capsys.readouterr().out == f'{dirty}\n'
+    assert dirty.read() == before
+
+
+def test_cli_check_rejects_inplace_and_outfile(tmpdir, capsys):
+    f = tmpdir.join('a.sql')
+    f.write('select 1')
+    assert sqlparse.cli.main([str(f), '--check', '--in-place']) == 1
+    assert sqlparse.cli.main([str(f), '--check', '-o', str(tmpdir.join('o'))]) == 1
diff --git a/tests/test_extra_keywords.py b/tests/test_extra_keywords.py
new file mode 100644
index 0000000..de77fef
--- /dev/null
+++ b/tests/test_extra_keywords.py
@@ -0,0 +1,10 @@
+import pytest
+
+import sqlparse
+
+
+@pytest.mark.parametrize('kw', [
+    'exclude', 'match_recognize', 'asof', 'match_condition'])
+def test_local_snowflake_keywords_uppercased(kw):
+    assert sqlparse.format(f'select {kw}', keyword_case='upper') == \
+        f'SELECT {kw.upper()}'
