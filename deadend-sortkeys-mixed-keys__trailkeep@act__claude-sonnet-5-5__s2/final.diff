+def _stringify_keys(obj: Any) -> Any:
+    """
+    Recursively convert dict keys to the strings ``json.dumps`` would emit.
+    """
+    if isinstance(obj, dict):
+        return {
+            (k if isinstance(k, str) or not isinstance(k, (int, float, bool, type(None)))
+             else json.dumps(k)): _stringify_keys(v)
+            for k, v in obj.items()
+        }
+    if isinstance(obj, (list, tuple)):
+        return [_stringify_keys(v) for v in obj]
+    return obj
+
