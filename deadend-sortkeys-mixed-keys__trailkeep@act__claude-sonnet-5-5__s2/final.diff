@@ -49,6 +49,39 @@ def test_json_kwargs(tmpdir):
     db.close()
 
 
+def test_json_sort_keys_default(tmpdir):
+    path = str(tmpdir.join('test.db'))
+    storage = JSONStorage(path)
+    storage.write({'b': 1, 'a': {'d': 1, 'c': 2}})
+    storage.close()
+
+    with open(path) as f:
+        assert f.read() == '{"a": {"c": 2, "d": 1}, "b": 1}'
+
+
+def test_json_sort_keys_disabled(tmpdir):
+    path = str(tmpdir.join('test.db'))
+    storage = JSONStorage(path, sort_keys=False)
+    storage.write({'b': 1, 'a': 2})
+    storage.close()
+
+    with open(path) as f:
+        assert f.read() == '{"b": 1, "a": 2}'
+
+
+def test_json_sort_keys_mixed_key_types(tmpdir):
+    path = str(tmpdir.join('test.db'))
+    storage = JSONStorage(path)
+    storage.write({'hits': {200: 1, 'other': 3, None: 4, True: 5}, 'l': [{2: 1, 'a': 2}]})
+    storage.close()
+
+    with open(path) as f:
+        assert json.load(f) == {
+            'hits': {'200': 1, 'other': 3, 'null': 4, 'true': 5},
+            'l': [{'2': 1, 'a': 2}],
+        }
+
