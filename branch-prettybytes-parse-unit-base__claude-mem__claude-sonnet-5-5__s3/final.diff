@@ -216,3 +216,25 @@ export default function prettyBytes(
 	number: number | bigint,
 	options?: Options
 ): string;
+
+/**
+Convert a human readable size string to a number of bytes. The reverse of `prettyBytes()`.
+
+Accepts a plain number (`'512'`), or a number followed by `B`, a binary unit (`KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`, `ZiB`, `YiB`; powers of 1024), or a decimal unit (`kB`, `MB`, `GB`, `TB`, `PB`, `EB`, `ZB`, `YB`; powers of 1000). `KB` is accepted as an alias for `kB` and also means 1000 bytes. Other units are case-sensitive, the number may be fractional, and the unit may be separated from it by whitespace or not at all.
+
+@param string - The size to parse.
+@returns The number of bytes. It is not rounded, so `'1.1 KiB'` gives `1126.4`.
+@throws A `SyntaxError` if the string is not a number with an optional supported unit, and a `TypeError` if it is not a string.
+
+@example
+```
+import {parseBytes} from 'pretty-bytes';
+
+parseBytes('512');
+// 512
+
+parseBytes('1.5 KiB');
+// 1536
+```
+*/
+export function parseBytes(string: string): number;
diff --git a/index.js b/index.js
index c5f37ab..7494871 100644
--- a/index.js
+++ b/index.js
@@ -285,3 +285,34 @@ export default function prettyBytes(number, options) {
 	const result = prefix + numberString + separator + UNITS[exponent];
 	return result.padStart(options.fixedWidth ?? 0);
 }
+
+// Binary units (`KiB`, …) are powers of 1024 and decimal units (`kB`, …) are powers of 1000, exactly as `prettyBytes` writes them. Units are case-sensitive, with the single exception that `KB` is accepted as an alias for `kB` and means 1000 bytes too.
+const PARSE_MULTIPLIERS = new Map([
+	...BIBYTE_UNITS.map((unit, index) => [unit, 1024 ** index]),
+	...BYTE_UNITS.map((unit, index) => [unit, 1000 ** index]),
+	['KB', 1000],
+]);
+
+// An optional sign, a plain decimal number, and an optional unit that may be separated by any whitespace, including the non-breaking space `prettyBytes` can produce.
+const PARSE_PATTERN = /^\s*(?<sign>[+-]?)(?<number>\d+(?:\.\d+)?|\.\d+)(?:\s*(?<unit>[^\s\d.+-]+))?\s*$/;
+
+export function parseBytes(string) {
+	if (typeof string !== 'string') {
+		throw new TypeError(`Expected a string, got \`${typeof string}\``);
+	}
+
+	const {sign, number, unit = 'B'} = PARSE_PATTERN.exec(string)?.groups ?? {};
+
+	if (number === undefined) {
+		throw new SyntaxError(`Cannot parse \`${string}\` as a number of bytes`);
+	}
+
+	const multiplier = PARSE_MULTIPLIERS.get(unit);
+
+	if (multiplier === undefined) {
+		throw new SyntaxError(`Unsupported unit \`${unit}\`, expected one of: ${[...PARSE_MULTIPLIERS.keys()].join(', ')}`);
+	}
+
+	const bytes = Number(number) * multiplier;
+	return sign === '-' ? -bytes : bytes;
+}
