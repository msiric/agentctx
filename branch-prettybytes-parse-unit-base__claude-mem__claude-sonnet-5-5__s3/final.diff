+++ b/test.js
@@ -3,7 +3,7 @@ import {readFileSync} from 'node:fs';
 import process from 'node:process';
 import {promisify} from 'node:util';
 import test from 'ava';
-import prettyBytes from './index.js';
+import prettyBytes, {parseBytes} from './index.js';
 
 const DECIMAL_UNITS = ['B', 'kB', 'MB', 'GB', 'TB', 'PB', 'EB', 'ZB', 'YB'];
 const BINARY_UNITS = ['B', 'KiB', 'MiB', 'GiB', 'TiB', 'PiB', 'EiB', 'ZiB', 'YiB'];
@@ -1147,3 +1147,81 @@ test('the options shape the output as documented', t => {
 		t.is(prettyBytes(value, {signed: true}), prefix + prettyBytes(Math.abs(value)));
 	}
 });
+
+test('parseBytes: plain numbers and bytes', t => {
+	t.is(parseBytes('0'), 0);
+	t.is(parseBytes('512'), 512);
+	t.is(parseBytes('512 B'), 512);
+	t.is(parseBytes('512B'), 512);
+	t.is(parseBytes('  512  B  '), 512);
+	t.is(parseBytes('1.5'), 1.5);
+	t.is(parseBytes('.5 B'), 0.5);
+});
+
+test('parseBytes: binary units', t => {
+	for (const [index, unit] of BINARY_UNITS.entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1024 ** index);
+		t.is(parseBytes(`2${unit}`), 2 * (1024 ** index));
+	}
+
+	t.is(parseBytes('1.5 KiB'), 1536);
+	t.is(parseBytes('0.5 MiB'), 524_288);
+	t.is(parseBytes('1 YiB'), 2 ** 80);
+	t.is(parseBytes('1.1 KiB'), 1126.4);
+});
+
+test('parseBytes: sign and whitespace', t => {
+	t.is(parseBytes('-1.5 KiB'), -1536);
+	t.is(parseBytes('+1 KiB'), 1024);
+	t.is(parseBytes('1 KiB'), 1024);
+	t.is(parseBytes('1\tKiB'), 1024);
+});
+
+test('parseBytes: units are case-sensitive', t => {
+	for (const input of ['1 kib', '1 KIB', '1 kiB', '1 mib', '1 b', '1 Kib', '1 kb', '1 mB']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError});
+	}
+});
+
+test('parseBytes: decimal units', t => {
+	for (const [index, unit] of ['B', 'kB', 'MB', 'GB', 'TB', 'PB', 'EB', 'ZB', 'YB'].entries()) {
+		t.is(parseBytes(`1 ${unit}`), 1000 ** index);
+		t.is(parseBytes(`2${unit}`), 2 * (1000 ** index));
+	}
+
+	t.is(parseBytes('1.5 kB'), 1500);
+	t.is(parseBytes('1.5 KB'), 1500);
+	t.is(parseBytes('-2 MB'), -2_000_000);
+});
+
+test('parseBytes: unsupported units', t => {
+	for (const unit of ['k', 'K', 'Kb', 'kb', 'mB', 'Mb', 'gb', 'KiBit', 'kbit', 'kIB']) {
+		t.throws(() => parseBytes(`1 ${unit}`), {instanceOf: SyntaxError, message: /Unsupported unit/});
+	}
+});
+
+test('parseBytes: invalid input', t => {
+	for (const input of ['', ' ', 'KiB', 'abc', '1..5 KiB', '1.5.5', '1e3', '1,000 B', '--1', '1 2 KiB', '1 KiB B', '5.', 'NaN', 'Infinity']) {
+		t.throws(() => parseBytes(input), {instanceOf: SyntaxError});
+	}
+
+	for (const input of [undefined, null, 5, {}, 10n]) {
+		t.throws(() => parseBytes(input), {instanceOf: TypeError});
+	}
+});
+
+test('parseBytes: reverses prettyBytes with decimal units', t => {
+	for (const value of [0, 1, 999, 1000, 1500, 10 ** 6, 5 * (10 ** 9), 10 ** 15, 10 ** 24]) {
+		t.is(parseBytes(prettyBytes(value)), value);
+		t.is(parseBytes(prettyBytes(value, {nonBreakingSpace: true})), value);
+		t.is(parseBytes(prettyBytes(value, {space: false})), value);
+	}
+});
+
+test('parseBytes: reverses prettyBytes with binary units', t => {
+	for (const value of [0, 1, 512, 1024, 1536, 2 ** 20, 5 * (2 ** 30), 2 ** 50, 2 ** 80]) {
+		t.is(parseBytes(prettyBytes(value, {binary: true})), value);
+		t.is(parseBytes(prettyBytes(value, {binary: true, nonBreakingSpace: true})), value);
+		t.is(parseBytes(prettyBytes(value, {binary: true, space: false})), value);
+	}
+});
