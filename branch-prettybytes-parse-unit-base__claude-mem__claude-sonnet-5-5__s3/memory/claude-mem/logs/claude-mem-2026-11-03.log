// Only the units that `prettyBytes` writes with `binary: true` are understood, and they are case-sensitive just like its output. Decimal units (`kB`, `MB`, …) are intentionally rejected until their meaning is decided.
const PARSE_MULTIPLIERS = new Map(BIBYTE_UNITS.map((unit, index) => [unit, 1024 ** index]));

// An optional sign, a plain decimal number, and an optional unit that may be separated by any whitespace, including the non-breaking space `prettyBytes` can produce.
const PARSE_PATTERN = /^\s*(?<sign>[+-]?)(?<number>\d+(?:\.\d+)?|\.\d+)(?:\s*(?<unit>[^\s\d.+-]+))?\s*$/;

export function parseBytes(string) {
	if (typeof string !== 'string') {
		throw new TypeError(`Expected a string, got \`${typeof string}\``);
	}

	const {sign, number, unit = 'B'} = PARSE_PATTERN.exec(string)?.groups ?? {};

	if (number === undefined) {
		throw new SyntaxError(`Cannot parse \`${string}\` as a number of bytes`);
	}

	const multiplier = PARSE_MULTIPLIERS.get(unit);

	if (multiplier === undefined) {
		throw new SyntaxError(`Unsupported unit \`${unit}\`, expected one of: ${BIBYTE_UNITS.join(', ')}`);
	}

	const bytes = Number(number) * multiplier;
	return sign === '-' ? -bytes : bytes;
}
EOF
cat >> index.d.ts <<'EOF'

/**
Convert a human readable binary size string to a number of bytes. The reverse of `prettyBytes(number, {binary: true})`.

Accepts a plain number (`'512'`), or a number followed by `B` or a binary unit: `KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`, `ZiB`, `YiB`. Units are case-sensitive, the number may be fractional, and the unit may be separated from it by whitespace or not at all. Decimal units like `kB` and `MB` are not supported yet.

@param string - The size to parse.
@returns The number of bytes. It is not rounded, so `'1.1 KiB'` gives `1126.4`.
@throws A `SyntaxError` if the string is not a number with an optional supported unit, and a `TypeError` if it is not a string.

@example
```
import {parseBytes} from 'pretty-bytes';

parseBytes('512');
// 512

parseBytes('1.5 KiB');
// 1536
```
*/
export function parseBytes(string: string): number;
EOF
