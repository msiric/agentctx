+import { describe, expect, test } from "vitest";
+import { isSameOrigin } from "../src";
+
+describe("isSameOrigin", () => {
+  const sameOrigins = [
+    // Identical
+    ["https://example.com", "https://example.com"],
+    // Path, query and hash are ignored
+    ["https://example.com", "https://example.com/"],
+    ["https://example.com/foo", "https://example.com/bar"],
+    ["https://example.com/foo?a=1", "https://example.com/bar?b=2"],
+    ["https://example.com/#a", "https://example.com/#b"],
+    // Auth is not part of the origin
+    ["https://user:pass@example.com/", "https://example.com/"],
+    // Protocol and host are case-insensitive
+    ["HTTPS://EXAMPLE.COM/", "https://example.com/"],
+    // Explicit non-default ports match each other
+    ["http://example.com:8080/a", "http://example.com:8080/b"],
+    // Punycode / unicode hosts
+    ["https://münchen.de/", "https://xn--mnchen-3ya.de/"],
+    // IPv6 and localhost
+    ["http://[::1]:3000/a", "http://[::1]:3000/b"],
+    ["http://localhost:3000/a", "http://localhost:3000/b"],
+  ];
+
+  const differentOrigins = [
+    // Protocol differs
+    ["http://example.com", "https://example.com"],
+    // Host differs
+    ["https://example.com", "https://example.org"],
+    // Subdomains are different origins
+    ["https://example.com", "https://www.example.com"],
+    ["https://a.example.com", "https://b.example.com"],
+    // Port differs
+    ["https://example.com:8443/", "https://example.com/"],
+    ["http://example.com:8080/", "http://example.com/"],
+    // No port normalization: an explicit default port is NOT the same as
+    // an omitted port (strict string comparison of the port)
+    ["https://example.com", "https://example.com:443"],
+    ["https://example.com/", "https://example.com:443/"],
+    ["http://example.com", "http://example.com:80"],
+    ["http://example.com/", "http://example.com:80/"],
+    ["http://example.com:443/", "http://example.com/"],
+    // Look-alike hosts
+    ["https://example.com", "https://example.com.evil.com"],
+    ["https://example.com@evil.com/", "https://example.com/"],
+    ["https://example.com\\@evil.com/", "https://example.com/"],
+  ];
+
+  // Inputs without an origin can never be "same origin"
+  const noOrigin = [
+    ["/foo", "/foo"],
+    ["foo", "foo"],
+    ["./foo", "./foo"],
+    ["", ""],
+    ["https://example.com", "/foo"],
+    ["/foo", "https://example.com"],
+    // Opaque origins
+    ["data:text/plain,a", "data:text/plain,a"],
+    ["javascript:alert(1)", "javascript:alert(1)"],
+    ["blob:https://example.com/uuid", "blob:https://example.com/uuid"],
+  ];
+
+  for (const [a, b] of sameOrigins) {
+    test(`${JSON.stringify(a)} is same origin as ${JSON.stringify(b)}`, () => {
+      expect(isSameOrigin(a, b)).toBe(true);
+      // Symmetric
+      expect(isSameOrigin(b, a)).toBe(true);
+    });
+  }
+
+  for (const [a, b] of differentOrigins) {
+    test(`${JSON.stringify(a)} is not same origin as ${JSON.stringify(b)}`, () => {
+      expect(isSameOrigin(a, b)).toBe(false);
+      expect(isSameOrigin(b, a)).toBe(false);
+    });
+  }
+
+  for (const [a, b] of noOrigin) {
+    test(`${JSON.stringify(a)} / ${JSON.stringify(b)} has no comparable origin`, () => {
+      expect(isSameOrigin(a, b)).toBe(false);
+      expect(isSameOrigin(b, a)).toBe(false);
+    });
+  }
+
+  describe("protocol-relative URLs", () => {
+    // Open question: no protocol, so origin is ambiguous. Proposed: compare
+    // by host only when both sides are protocol-relative, otherwise false.
+    test("two protocol-relative URLs with the same host", () => {
+      expect(isSameOrigin("//example.com/a", "//example.com/b")).toBe(true);
+    });
+    test("two protocol-relative URLs with different hosts", () => {
+      expect(isSameOrigin("//example.com/a", "//example.org/a")).toBe(false);
+    });
+    test("protocol-relative vs absolute", () => {
+      expect(isSameOrigin("//example.com/", "https://example.com/")).toBe(
+        false,
+      );
+    });
+  });
+});
