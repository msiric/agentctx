+const AUTHORITY_BACKSLASH_RE = /^[^?#]*?[/\\]{2}[^/?#]*\\/;
+
+function normalizeOriginHost(host: string): string | undefined {
+  // Port is compared as-is (no default port normalization)
+  const port = host.match(/:(\d*)$/)?.[0] || "";
+  try {
+    return new URL("http://" + host).hostname + port;
+  } catch {
+    return undefined;
+  }
+}
+
+/**
+ * Check if two URLs have the same origin (protocol, host and port).
+ *
+ * Path, query, hash and auth are ignored. Inputs without an origin (relative
+ * paths, `data:`, `blob:`, `javascript:`) are never the same origin. Two
+ * protocol-relative URLs are compared by host only. Ports are compared as-is:
+ * an explicit default port is not equal to an omitted one.
+ *
+ * @example
+ * ```js
+ * isSameOrigin("https://example.com/a", "https://example.com/b?x=1"); // true
+ * isSameOrigin("https://example.com", "https://www.example.com"); // false
+ * ```
+ *
+ * @group utils
+ */
+export function isSameOrigin(a: string, b: string): boolean {
+  // Backslashes in the authority are parsed differently by browsers and
+  // servers (e.g. `https://a.com\\@b.com`), so never treat them as same origin.
+  if (AUTHORITY_BACKSLASH_RE.test(a) || AUTHORITY_BACKSLASH_RE.test(b)) {
+    return false;
+  }
+  const pa = parseURL(a);
+  const pb = parseURL(b);
+  if (!pa.host || !pb.host || pa.protocol !== pb.protocol) {
+    return false;
+  }
+  if (pa.protocol && !/^[a-z][\w+.-]*:$/.test(pa.protocol)) {
+    return false;
+  }
+  const ha = normalizeOriginHost(pa.host);
+  const hb = normalizeOriginHost(pb.host);
+  return ha !== undefined && ha === hb;
+}
+
