-    ? combineRanges(ranges)
-    : ranges
+  if (options && options.combine) {
+    ranges = combineRanges(ranges)
+  }
+
+  var limit = options && options.limit
+
+  if (typeof limit === 'number' && limit >= 1 && ranges.length > limit) {
+    ranges = collapseRanges(ranges)
+  }
+
+  return ranges
+}
+
+/**
+ * Collapse all ranges into a single range spanning the lowest start to the
+ * highest end.
+ * @private
+ */
+
+function collapseRanges (ranges) {
+  var start = Infinity
+  var end = -Infinity
+
+  for (var i = 0; i < ranges.length; i++) {
+    if (ranges[i].start < start) start = ranges[i].start
+    if (ranges[i].end > end) end = ranges[i].end
+  }
+
+  var collapsed = [{ start: start, end: end }]
+
+  // copy ranges type
+  collapsed.type = ranges.type
+
+  return collapsed
 }
 
