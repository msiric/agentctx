+def test_length():
+    assert Length(min=1, max=3).validate("abc") == "abc"
+    assert Length(min=1, max=3).validate("a") == "a"
+    assert Length().validate("") == ""
+    assert Length(min=2).validate("a" * 100) == "a" * 100
+    assert Length(max=2).validate("") == ""
+    with SE:
+        Length(min=2).validate("a")
+    with SE:
+        Length(max=2).validate("abc")
+    with SE:
+        Length(min=1).validate("")
+    with SE:
+        Length(max=3).validate(123)
+    with SE:
+        Length(max=3).validate(b"ab")
+    with raises(ValueError):
+        Length(min=3, max=1)
+    assert Schema({"name": Length(max=5)}).validate({"name": "abc"}) == {"name": "abc"}
+    with SE:
+        Schema({"name": Length(max=2)}).validate({"name": "abc"})
+    with raises(SchemaError) as exc:
+        Length(max=2, error="too long: {}").validate("abc")
+    assert "too long: abc" in str(exc.value)
+
+
+def test_length_counts_utf8_bytes():
+    # "é" is 1 character but 2 UTF-8 bytes
+    assert len("é") == 1
+    assert Length(max=2).validate("é") == "é"
+    with SE:
+        Length(max=1).validate("é")
+    with SE:
+        Length(max=3).validate("éé")
+    assert Length(max=4).validate("éé") == "éé"
+    with SE:
+        Length(min=3).validate("é")
+    # 4-byte character
+    with SE:
+        Length(max=3).validate("\U0001F600")
