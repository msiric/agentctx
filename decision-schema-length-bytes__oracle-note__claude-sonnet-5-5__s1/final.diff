+class Length:
+    """
+    Validates that a string's length lies within inclusive bounds.
+
+    Length is measured in UTF-8 encoded bytes, not characters, because the
+    values are stored in VARCHAR2(n BYTE) columns: an accented name that
+    passes a ``len()`` check can still fail on insert.
+    """
+
+    def __init__(
+        self,
+        min: Union[int, None] = None,
+        max: Union[int, None] = None,
+        error: Union[str, None] = None,
+    ) -> None:
+        if min is not None and max is not None and min > max:
+            raise ValueError(f"min ({min}) must not be greater than max ({max})")
+        self._min = min
+        self._max = max
+        self._error = error
+
+    def __repr__(self) -> str:
+        return f"{self.__class__.__name__}(min={self._min!r}, max={self._max!r})"
+
+    def validate(self, data: str, **kwargs: Any) -> str:
+        """
+        Validates the UTF-8 byte length of data.
+        :param data: String to be validated.
+        :return: Returns validated data.
+        """
+        e = self._error
+        if not isinstance(data, str):
+            raise SchemaError(
+                e.format(data) if e else f"{data!r} should be instance of 'str'"
+            )
+        size = len(data.encode("utf-8"))
+        if (self._min is not None and size < self._min) or (
+            self._max is not None and size > self._max
+        ):
+            if e:
+                raise SchemaError(e.format(data))
+            bounds = []
+            if self._min is not None:
+                bounds.append(f"at least {self._min}")
+            if self._max is not None:
+                bounds.append(f"at most {self._max}")
+            raise SchemaError(
+                f"{data!r} is {size} UTF-8 bytes long, expected {' and '.join(bounds)}"
+            )
+        return data
+
+
