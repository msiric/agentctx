@@ -137,9 +153,21 @@ class JSONStorage(Storage):
             self._handle.seek(0)
 
             # Load the JSON contents of the file
-            return json.load(self._handle)
+            data = json.load(self._handle)
+
+            # Only trust the stat signature if the file was last modified
+            # long enough ago; otherwise a same-size rewrite within the
