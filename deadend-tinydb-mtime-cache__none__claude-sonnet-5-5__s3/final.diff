     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def test_json_read_cache_sees_external_changes(tmpdir):
+    import os
+    path = str(tmpdir.join('cache.json'))
+    with open(path, 'w') as f:
+        json.dump({'_default': {'1': {'a': 1}}}, f)
+    os.utime(path, (1, 1))  # old mtime, so the cache is allowed to kick in
+
+    storage = JSONStorage(path)
+    first = storage.read()
+    assert storage.read() is first  # unchanged file: served from cache
+
+    # Same-size rewrite by "another process" with the mtime restored
+    with open(path, 'w') as f:
+        json.dump({'_default': {'1': {'a': 2}}}, f)
+    os.utime(path, (1, 1))
+    assert storage.read() == {'_default': {'1': {'a': 2}}}
+
+    storage.write({'_default': {}})
+    assert storage.read() == {'_default': {}}
+    storage.close()
