@@ -1597,3 +1597,119 @@ class SchedulerTests(TestCase):
         scheduler.every()
         scheduler.every(10).seconds
         scheduler.run_pending()
+
+
+def ms(*args):
+    return int(datetime.datetime(*args).timestamp() * 1000)
+
+
+class StatusTests(TestCase):
+    def test_status_empty(self):
+        assert schedule.Scheduler().status() == []
+
+    def test_status(self):
+        import json
+
+        def my_job():
+            pass
+
+        def other_job():
+            pass
+
+        scheduler = schedule.Scheduler()
+        with mock_datetime(2020, 1, 1, 10, 0, 0):
+            scheduler.every(5).minutes.do(my_job)
+            scheduler.every().day.at("12:00").do(other_job)
+            before = scheduler.status()
+            assert before == [
+                {
+                    "name": "my_job",
+                    "interval": 5,
+                    "unit": "minutes",
+                    "last_run": None,
+                    "next_run": ms(2020, 1, 1, 10, 5),
+                },
+                {
+                    "name": "other_job",
+                    "interval": 1,
+                    "unit": "days",
+                    "last_run": None,
+                    "next_run": ms(2020, 1, 1, 12, 0),
+                },
+            ]
+        with mock_datetime(2020, 1, 1, 10, 6, 0):
+            scheduler.run_pending()
+            after = scheduler.status()
+        assert after[0]["last_run"] == ms(2020, 1, 1, 10, 6)
+        assert after[0]["next_run"] == ms(2020, 1, 1, 10, 11)
+        assert after[1]["last_run"] is None
+        json.dumps(after)
+        for entry in after:
+            for key in ("last_run", "next_run"):
+                assert entry[key] is None or type(entry[key]) is int
+
+    def test_status_partial_and_args(self):
+        scheduler = schedule.Scheduler()
+
+        def greet(name):
+            pass
+
+        scheduler.every(2).hours.do(greet, "bob")
+        assert scheduler.status()[0]["name"] == "greet"
+
+
+class HeartbeatTests(TestCase):
+    def setUp(self):
+        import tempfile
+
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.path = os.path.join(self.tmp.name, "heartbeat.json")
+
+    def read(self):
+        import json
+
+        with open(self.path) as f:
+            return json.load(f)
+
+    def test_no_heartbeat_by_default(self):
+        scheduler = schedule.Scheduler()
+        scheduler.run_pending()
+        assert not os.path.exists(self.path)
+
+    def test_no_jobs(self):
+        scheduler = schedule.Scheduler(heartbeat_path=self.path)
+        with mock_datetime(2020, 1, 1, 10, 0, 0):
+            scheduler.run_pending()
+        assert self.read() == {"last_pass": ms(2020, 1, 1, 10, 0), "next_run": None}
+
+    def test_written_every_pass_with_next_run(self):
+        scheduler = schedule.Scheduler(heartbeat_path=self.path)
+        with mock_datetime(2020, 1, 1, 10, 0, 0):
+            scheduler.every(5).minutes.do(lambda: None)
+            scheduler.every().day.at("12:00").do(lambda: None)
+            scheduler.run_pending()
+        assert self.read() == {
+            "last_pass": ms(2020, 1, 1, 10, 0),
+            "next_run": ms(2020, 1, 1, 10, 5),
+        }
+        # A pass where nothing is due still updates the heartbeat
+        with mock_datetime(2020, 1, 1, 10, 1, 0):
+            scheduler.run_pending()
+        assert self.read()["last_pass"] == ms(2020, 1, 1, 10, 1)
+        # next_run reflects jobs that just ran
+        with mock_datetime(2020, 1, 1, 10, 6, 0):
+            scheduler.run_pending()
+        assert self.read() == {
+            "last_pass": ms(2020, 1, 1, 10, 6),
+            "next_run": ms(2020, 1, 1, 10, 11),
+        }
+
+    def test_values_are_integers_and_no_temp_file_left(self):
+        scheduler = schedule.Scheduler(heartbeat_path=self.path)
+        scheduler.every().hour.do(lambda: None)
+        scheduler.run_pending()
+        data = self.read()
+        assert type(data["last_pass"]) is int
+        assert type(data["next_run"]) is int
+        assert os.listdir(self.tmp.name) == ["heartbeat.json"]
