+/**
+ * Compound format for `ms`, e.g. `25h30m` (Go `time.ParseDuration` compatible).
+ */
+function fmtCompound(ms: number): StringValue {
+  let remaining = Math.floor(Math.abs(ms) / s);
+  const parts: string[] = [];
+  for (const [size, name] of [
+    [h / s, 'h'],
+    [m / s, 'm'],
+    [1, 's'],
+  ] as const) {
+    const count = Math.floor(remaining / size);
+    remaining -= count * size;
+    if (count > 0) {
+      parts.push(`${count}${name}`);
+    }
+  }
+  if (parts.length === 0) {
+    return '0s';
+  }
+  return `${ms < 0 ? '-' : ''}${parts.join('')}` as StringValue;
+}
