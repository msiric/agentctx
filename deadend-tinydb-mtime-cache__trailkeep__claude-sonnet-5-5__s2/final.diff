+"""Benchmark JSONStorage read performance on a large database file.
+
+Usage: python scripts/bench_read.py [--size-mb 40] [--profile]
+"""
+import argparse
+import cProfile
+import json
+import os
+import pstats
+import sys
+import tempfile
+import time
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))
+
+from tinydb import TinyDB, where  # noqa: E402
+
+
+def generate(path, size_mb):
+    target = size_mb * 1024 * 1024
+    docs, size, i = {}, 0, 0
+    while size < target:
+        i += 1
+        doc = {'name': f'user{i}', 'age': i % 90, 'email': f'user{i}@example.com',
+               'tags': ['a', 'b', 'c'], 'address': {'city': f'city{i % 500}', 'zip': i}}
+        docs[str(i)] = doc
+        size += len(json.dumps(doc)) + 8
+    with open(path, 'w') as f:
+        json.dump({'_default': docs}, f)
+    return len(docs)
+
+
+def timed(label, fn):
+    t = time.perf_counter()
+    result = fn()
+    print(f'{label:<34}{(time.perf_counter() - t) * 1000:9.1f} ms')
+    return result
+
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument('--size-mb', type=int, default=40)
+    p.add_argument('--profile', action='store_true', help='cProfile a cold search')
+    args = p.parse_args()
+
+    with tempfile.TemporaryDirectory() as d:
+        path = os.path.join(d, 'db.json')
+        n = generate(path, args.size_mb)
+        print(f'{n} docs, {os.path.getsize(path) / 1e6:.1f} MB\n')
+
+        with open(path) as f:
+            timed('raw json.load (floor)', lambda: json.load(f))
+
+        with TinyDB(path) as db:
+            timed('storage.read()', db.storage.read)
+            timed('db.all()', db.all)
+            timed('db.all() again', db.all)
+            q = where('age') == 42
+            timed('search (cold, not cached)', lambda: db.search(q))
+            timed('search same query (cached)', lambda: db.search(q))
+            timed('search new query', lambda: db.search(where('age') == 43))
+            timed('db.get(doc_id=1)', lambda: db.get(doc_id=1))
+            timed('len(db)', lambda: len(db))
+
+            if args.profile:
+                pr = cProfile.Profile()
+                pr.runcall(db.search, where('age') == 44)
+                pstats.Stats(pr).sort_stats('cumulative').print_stats(8)
+
+
+if __name__ == '__main__':
+    main()
