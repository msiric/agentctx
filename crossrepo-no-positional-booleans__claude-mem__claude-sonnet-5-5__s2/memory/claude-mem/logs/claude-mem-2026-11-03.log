describe('parse(string, { requireUnit: true })', () => {
  it('should return NaN for strings without a unit', () => {
    expect(parse('30', { requireUnit: true })).toBeNaN();
    expect(parse('-1.5', { requireUnit: true })).toBeNaN();
  });

  it('should still parse strings with a unit', () => {
    expect(parse('30s', { requireUnit: true })).toBe(30000);
    expect(parse('1.5 hours', { requireUnit: true })).toBe(5400000);
    expect(parse('100ms', { requireUnit: true })).toBe(100);
  });

  it('should keep the default behaviour otherwise', () => {
    expect(parse('30')).toBe(30);
    expect(parse('30', {})).toBe(30);
    expect(parse('30', { requireUnit: false })).toBe(30);
  });

  it('should still return NaN for invalid strings and throw for bad input', () => {
    expect(parse('foo', { requireUnit: true })).toBeNaN();
    expect(() => parse('', { requireUnit: true })).toThrow();
  });
});
