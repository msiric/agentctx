+
+/**
+ * Format the given milliseconds as an ISO 8601 duration string.
+ *
+ * Days are the largest unit used, since months and years are ambiguous.
+ * Fractional seconds are included when needed (e.g. `PT0.5S`), zero is
+ * `PT0S`, and negative values get a leading `-` (ISO 8601-2 extension).
+ *
+ * @param ms - milliseconds (rounded to the nearest whole millisecond)
+ * @returns The ISO 8601 duration string
+ */
+export function formatISO(ms: number): string {
+  if (typeof ms !== 'number' || !Number.isFinite(ms)) {
+    throw new Error('Value provided to ms.formatISO() must be of type number.');
+  }
+
+  const total = Math.round(Math.abs(ms));
+  const sign = ms < 0 && total > 0 ? '-' : '';
+
+  const days = Math.floor(total / d);
+  const hours = Math.floor((total % d) / h);
+  const minutes = Math.floor((total % h) / m);
+  const secs = Math.floor((total % m) / s);
+  const millis = total % s;
+
+  let out = `${sign}P`;
+  if (days) {
+    out += `${days}D`;
+  }
+
+  let time = '';
+  if (hours) {
+    time += `${hours}H`;
+  }
+  if (minutes) {
+    time += `${minutes}M`;
+  }
+  if (secs || millis) {
+    const frac = millis
+      ? `.${String(millis).padStart(3, '0').replace(/0+$/, '')}`
+      : '';
+    time += `${secs}${frac}S`;
+  }
+
+  if (time) {
+    return `${out}T${time}`;
+  }
+  return days ? out : `${out}T0S`;
+}
+
+const isDigit = (c: string | undefined): boolean =>
+  c !== undefined && c >= '0' && c <= '9';
+
+/**
+ * Parse an ISO 8601 duration string (the inverse of `formatISO`) and return
+ * milliseconds.
+ *
+ * Supports weeks, days, hours, minutes and seconds (e.g. `P1DT2H`, `PT1H30M`,
+ * `P2W`), a leading `-` or `+`, and a decimal fraction (`.` or `,`) on the
+ * last component (e.g. `PT0.5S`). Years and months are ambiguous in length and
+ * are not supported. Implemented by hand-written scanning, without regular
+ * expressions.
+ *
+ * @param str - An ISO 8601 duration string
+ * @returns The parsed value in milliseconds, or `NaN` if the string can't be
+ * parsed
+ */
+export function parseISO(str: string): number {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw new Error(
+      `Value provided to ms.parseISO() must be a string with length between 1 and 99. value=${JSON.stringify(str)}`,
+    );
+  }
+
+  let i = 0;
+  let sign = 1;
+  if (str[i] === '-' || str[i] === '+') {
+    sign = str[i] === '-' ? -1 : 1;
+    i++;
+  }
+  if (str[i] !== 'P') {
+    return NaN;
+  }
+  i++;
+
+  const dateUnits: Record<string, number> = { W: w, D: d };
+  const timeUnits: Record<string, number> = { H: h, M: m, S: s };
+  // Designators must appear in this order, each at most once.
+  const dateOrder = ['W', 'D'];
+  const timeOrder = ['H', 'M', 'S'];
+
+  let inTime = false;
+  let lastIndex = -1;
+  let components = 0;
+  let total = 0;
+  let sawFraction = false;
+
+  while (i < str.length) {
+    if (str[i] === 'T') {
+      if (inTime) {
+        return NaN;
+      }
+      inTime = true;
+      lastIndex = -1;
+      i++;
+      // 'T' must be followed by at least one component.
+      if (i >= str.length) {
+        return NaN;
+      }
+      continue;
+    }
+
+    // A fraction is only allowed on the last component.
+    if (sawFraction) {
+      return NaN;
+    }
+
+    let whole = 0;
+    let digits = 0;
+    while (isDigit(str[i])) {
+      whole = whole * 10 + (str.charCodeAt(i) - 48);
+      digits++;
+      i++;
+    }
+    if (digits === 0) {
+      return NaN;
+    }
+
+    let fraction = 0;
+    if (str[i] === '.' || str[i] === ',') {
+      i++;
+      let scale = 1;
+      let fracDigits = 0;
+      while (isDigit(str[i])) {
+        scale /= 10;
+        fraction += (str.charCodeAt(i) - 48) * scale;
+        fracDigits++;
+        i++;
+      }
+      if (fracDigits === 0) {
+        return NaN;
+      }
+      sawFraction = true;
+    }
+
+    const designator = str[i];
+    if (designator === undefined) {
+      return NaN;
+    }
+    const unit = (inTime ? timeUnits : dateUnits)[designator];
+    const index = (inTime ? timeOrder : dateOrder).indexOf(designator);
+    if (unit === undefined || index <= lastIndex) {
+      return NaN;
+    }
+    lastIndex = index;
+    i++;
+    components++;
+    total += (whole + fraction) * unit;
+  }
+
+  if (components === 0) {
+    return NaN;
+  }
+
+  const result = sign * Math.round(total);
+  // Avoid returning -0 for inputs like "-PT0S".
+  return result === 0 ? 0 : result;
+}
