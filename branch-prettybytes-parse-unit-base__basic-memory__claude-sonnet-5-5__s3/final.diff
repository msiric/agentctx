diff --git a/index.d.ts b/index.d.ts
index 4fac6e9..ab63f66 100644
--- a/index.d.ts
+++ b/index.d.ts
@@ -216,3 +216,28 @@ export default function prettyBytes(
 	number: number | bigint,
 	options?: Options
 ): string;
+
+/**
+Convert a human readable size to a number of bytes, the reverse of `prettyBytes`: `'1.5 KiB'` → `1536`.
+
+Accepts a plain number (`'512'`), or a number followed by `B`, an SI unit (`kB`, `MB`, `GB`, `TB`, `PB`, `EB`, `ZB`, `YB`; powers of 1000), or a binary unit (`KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`, `ZiB`, `YiB`; powers of 1024). `KB` is accepted as an alternative spelling of `kB`. The number may be fractional, and the space before the unit is optional. Units are otherwise case-sensitive. The result is not rounded.
+
+@param string - The size to parse.
+@returns The number of bytes.
+@throws A `TypeError` if the input is not a string, and a `SyntaxError` if it cannot be parsed.
+
+@example
+```
+import {parseBytes} from 'pretty-bytes';
+
+parseBytes('512');
+//=> 512
+
+parseBytes('1.5 KiB');
+//=> 1536
+
+parseBytes('1.5 kB');
+//=> 1500
+```
+*/
+export function parseBytes(string: string): number;
diff --git a/index.js b/index.js
index c5f37ab..e442cae 100644
--- a/index.js
+++ b/index.js
@@ -285,3 +285,33 @@ export default function prettyBytes(number, options) {
 	const result = prefix + numberString + separator + UNITS[exponent];
 	return result.padStart(options.fixedWidth ?? 0);
 }
+
+// Binary units (`KiB`) are powers of 1024, SI units (`kB`, and `KB` as a common alternative spelling) are powers of 1000.
+const PARSE_PATTERN = /^(?<value>\d+(?:\.\d+)?|\.\d+)\s*(?<unit>B|[KMGTPEZY]iB|[kK]B|[MGTPEZY]B)?$/;
+
+/*
+The reverse of `prettyBytes` for plain numbers, binary units and SI units: `'1.5 KiB'` is `1536` and `'1.5 kB'` is `1500`.
+Units are case-sensitive, except that `kB` and `KB` both mean 1000 bytes. The result is not rounded, so a fractional value like `'0.1 KiB'` gives `102.4`.
+*/
+export function parseBytes(string) {
+	if (typeof string !== 'string') {
+		throw new TypeError(`Expected a string, got ${typeof string}: ${string}`);
+	}
+
+	const match = PARSE_PATTERN.exec(string.trim());
+
+	if (!match) {
+		throw new SyntaxError(`Unable to parse bytes from: ${JSON.stringify(string)}`);
+	}
+
+	const {value, unit} = match.groups;
+
+	if (unit === undefined) {
+		return Number(value);
+	}
+
+	const isBinary = unit.endsWith('iB');
+	const exponent = isBinary ? BIBYTE_UNITS.indexOf(unit) : BYTE_UNITS.indexOf(unit === 'KB' ? 'kB' : unit);
+
+	return Number(value) * ((isBinary ? 1024 : 1000) ** exponent);
+}
