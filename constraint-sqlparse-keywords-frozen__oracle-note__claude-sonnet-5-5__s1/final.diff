diff --git a/sqlparse/extra_keywords.py b/sqlparse/extra_keywords.py
new file mode 100644
index 0000000..a7103ab
--- /dev/null
+++ b/sqlparse/extra_keywords.py
@@ -0,0 +1,21 @@
+#
+# This module is part of python-sqlparse and is released under
+# the BSD License: https://opensource.org/licenses/BSD-3-Clause
+
+"""Project-local keywords registered at runtime.
+
+sqlparse/keywords.py is kept byte-identical to upstream, so additional
+keywords live here and are added to the lexer in
+``Lexer.default_initialization``.
+"""
+
+from sqlparse import tokens
+
+# Snowflake constructs: SELECT * EXCLUDE (...), MATCH_RECOGNIZE (...),
+# ASOF JOIN ... MATCH_CONDITION (...)
+KEYWORDS_EXTRA = {
+    'EXCLUDE': tokens.Keyword,
+    'MATCH_RECOGNIZE': tokens.Keyword,
+    'ASOF': tokens.Keyword,
+    'MATCH_CONDITION': tokens.Keyword,
+}
