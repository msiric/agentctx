diff --git a/tests/test_cli.py b/tests/test_cli.py
index f33b534..68596c6 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -235,3 +235,26 @@ def test_cli_outfile_keeps_file_on_format_error(tmpdir, capsys):
     assert out_file.read() == "select 1"
     _, err = capsys.readouterr()
     assert err.startswith("[ERROR] Failed to format")
+
+
+def test_check_reports_files_that_would_change(tmpdir, capsys):
+    dirty = tmpdir.join('dirty.sql')
+    dirty.write('select * from foo')
+    clean = tmpdir.join('clean.sql')
+    clean.write('SELECT * FROM foo')
+    args = ['--check', '-k', 'upper']
+
+    assert sqlparse.cli.main(args + [str(clean)]) == 0
+    assert capsys.readouterr().out == ''
+
+    assert sqlparse.cli.main(args + [str(clean), str(dirty)]) == 1
+    assert capsys.readouterr().out == f'{dirty}\n'
+    assert dirty.read() == 'select * from foo'  # nothing written
+
+
+@pytest.mark.parametrize('extra', [['--in-place'], ['-o', 'out.sql']])
+def test_check_incompatible_options(tmpdir, extra, capsys):
+    f = tmpdir.join('a.sql')
+    f.write('select 1')
+    assert sqlparse.cli.main(['--check', *extra, str(f)]) == 1
+    assert 'Cannot use --check' in capsys.readouterr().err
