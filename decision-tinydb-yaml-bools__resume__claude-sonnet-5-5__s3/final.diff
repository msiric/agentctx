+# Only these spellings are booleans in YAML files handled by YAMLStorage.
+# PyYAML follows YAML 1.1 and would also turn ``yes``, ``no``, ``on``, ``off``
+# (e.g. ``country: NO``) into booleans.
+_YAML_BOOL_RE = re.compile(r'^(?:true|True|TRUE|false|False|FALSE)$')
+
+
+@cache
+def _yaml_classes():
+    """
+    Build the PyYAML loader and dumper used by :class:`YAMLStorage`.
+
+    This is done lazily so that PyYAML is only needed when a ``YAMLStorage``
+    is actually used. The classes are private subclasses of PyYAML's safe
+    loader/dumper, so the global PyYAML configuration is left untouched.
+    """
+
+    import yaml
+
+    bool_tag = 'tag:yaml.org,2002:bool'
+
+    def restrict_bools(cls):
+        # Drop PyYAML's YAML 1.1 bool resolver from this class (add_*
+        # copies the resolver table first, so the base class isn't affected)
+        # and put in one that only knows true/false.
+        cls.add_implicit_resolver(bool_tag, _YAML_BOOL_RE, list('tTfF'))
+        for first_char, resolvers in cls.yaml_implicit_resolvers.items():
+            cls.yaml_implicit_resolvers[first_char] = [
+                (tag, regexp) for tag, regexp in resolvers
+                if tag != bool_tag or regexp is _YAML_BOOL_RE
+            ]
+        return cls
+
+    base_loader = getattr(yaml, 'CSafeLoader', yaml.SafeLoader)
+    base_dumper = getattr(yaml, 'CSafeDumper', yaml.SafeDumper)
+
+    class Loader(base_loader):  # type: ignore[misc, valid-type]
+        pass
+
+    class Dumper(base_dumper):  # type: ignore[misc, valid-type]
+        def ignore_aliases(self, data):
+            # Never write anchors/aliases (&id001, *id001): they are
+            # unpleasant to edit by hand.
+            return True
+
+    # Documents are dict subclasses, which the safe dumper doesn't accept
+    Dumper.add_multi_representer(dict, yaml.SafeDumper.represent_dict)
+
+    return yaml, restrict_bools(Loader), restrict_bools(Dumper)
+
+
+class YAMLStorage(_FileStorage):
+    """
+    Store the data in a YAML file.
+
+    Requires `PyYAML <https://pyyaml.org/>`_ (``pip install tinydb[yaml]``).
+
+    The file is loaded with a safe loader, so it can't construct arbitrary
+    Python objects. In contrast to plain PyYAML only ``true`` and ``false``
+    (in any of the spellings ``true``, ``True``, ``TRUE``, ...) are
+    booleans. Values like ``NO``, ``off`` or ``yes`` stay strings.
+
+    **Note:** The whole file is rewritten on every write, so comments and
+    formatting added by hand are **not** preserved.
+    """
+
+    def __init__(self, path: str, create_dirs=False, encoding=None, access_mode='r+', **kwargs):
+        """
+        Create a new instance.
+
+        See :class:`_FileStorage` for the file handling arguments.
+
+        :param path: Where to store the YAML data.
+        :param kwargs: Passed on to :func:`yaml.dump` on every write (e.g.
+                       ``indent``). Defaults are ``default_flow_style=False``,
+                       ``sort_keys=False`` and ``allow_unicode=True``.
+        """
+
+        try:
+            self._yaml, self._loader, self._dumper = _yaml_classes()
+        except ImportError as e:
+            raise ImportError(
+                'YAMLStorage requires PyYAML. Install it with '
+                '`pip install tinydb[yaml]`.'
+            ) from e
+
+        super().__init__(path, create_dirs, encoding, access_mode)
+
+        self.kwargs = {
+            'default_flow_style': False,
+            'sort_keys': False,
+            'allow_unicode': True,
+            **kwargs,
+        }
+
+    def read(self) -> Optional[dict[str, dict[str, Any]]]:
+        # An empty file means an uninitialized database
+        self._handle.seek(0, os.SEEK_END)
+        if not self._handle.tell():
+            return None
+
+        self._handle.seek(0)
+
+        # Parse errors are not swallowed: a typo in a hand-edited file must
+        # not look like an empty database (the next write would erase it).
+        try:
+            data = self._yaml.load(self._handle, Loader=self._loader)
+        except self._yaml.YAMLError as e:
+            raise ValueError(
+                'Cannot parse YAML file {0!r}: {1}'.format(self._handle.name, e)
+            ) from e
+
+        if data is None:
+            # Only whitespace or comments
+            return None
+
+        return self._normalize(data)
+
+    def _normalize(self, data: Any) -> dict[str, dict[str, Any]]:
+        """
+        Check the structure of hand-edited data and make table names and
+        document IDs strings (``1:`` is an int in YAML, TinyDB wants ``'1'``).
+        """
+
+        name = self._handle.name
+
+        if not isinstance(data, dict):
+            raise ValueError(
+                'Invalid database in {0!r}: expected a mapping of tables, '
+                'got {1}'.format(name, type(data).__name__)
+            )
+
+        def stringify(mapping: dict, what: str) -> dict[str, Any]:
+            result: dict[str, Any] = {}
+            for key, value in mapping.items():
+                if str(key) in result:
+                    raise ValueError(
+                        'Invalid database in {0!r}: duplicate {1} {2!r}'.format(
+                            name, what, str(key))
+                    )
+                result[str(key)] = value
+            return result
+
+        tables: dict[str, Any] = {}
+        for table_name, table in stringify(data, 'table').items():
+            if table is None:
+                # ``table:`` with nothing below it
+                table = {}
+            if not isinstance(table, dict):
+                raise ValueError(
+                    'Invalid database in {0!r}: table {1!r} must be a mapping '
+                    'of document IDs to documents, got {2}'.format(
+                        name, table_name, type(table).__name__)
+                )
+            tables[table_name] = stringify(table, 'document ID')
+
+        return tables
+
+    def write(self, data: dict[str, dict[str, Any]]):
+        self._handle.seek(0)
+
+        serialized = self._yaml.dump(data, Dumper=self._dumper, **self.kwargs)
+
+        try:
+            self._handle.write(serialized)
+        except io.UnsupportedOperation:
+            raise IOError('Cannot write to the database. Access mode is "{0}"'.format(self._mode))
+
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+
+        self._handle.truncate()
+
+
