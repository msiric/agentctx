+class YAMLStorage(FileStorage):
+    """
+    Store the data in a YAML file.
+
+    Requires PyYAML (``pip install pyyaml``). Data is read with
+    :func:`yaml.safe_load` and written with :func:`yaml.safe_dump`, so only
+    plain YAML types are supported.
+    """
+
+    def __init__(self, path: str, create_dirs=False, encoding=None, access_mode='r+', **kwargs):
+        """
+        Create a new instance.
+
+        See :class:`FileStorage` for the file handling arguments.
+
+        :param path: Where to store the YAML data.
+        :param kwargs: Passed on to :func:`yaml.safe_dump` on every write.
+        """
+
+        try:
+            import yaml  # noqa: F401
+        except ImportError as e:  # pragma: no cover
+            raise ImportError(
+                'YAMLStorage requires PyYAML: pip install pyyaml'
+            ) from e
+
+        super().__init__(path, create_dirs=create_dirs, encoding=encoding,
+                         access_mode=access_mode)
+
+        self.kwargs = kwargs
+
+    def read(self) -> Optional[dict[str, dict[str, Any]]]:
+        import yaml
+
+        self._handle.seek(0)
+        data = yaml.safe_load(self._handle)
+
+        # Empty file (or only comments) -> let TinyDB initialize the database
+        return data or None
+
+    def write(self, data: dict[str, dict[str, Any]]):
+        import yaml
+
+        self._handle.seek(0)
+
+        serialized = yaml.safe_dump(data, **self.kwargs)
+
+        try:
+            self._handle.write(serialized)
+        except io.UnsupportedOperation:
+            raise IOError('Cannot write to the database. Access mode is "{0}"'.format(self._mode))
+
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+
+        self._handle.truncate()
+
+
