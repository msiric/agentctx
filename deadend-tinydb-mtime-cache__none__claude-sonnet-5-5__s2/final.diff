+    def _signature(self) -> Optional[tuple]:
+        """
+        Identify the current file version so that changes made by other
+        processes (in place or via replace-by-rename) are noticed.
+        """
+        try:
+            st = os.stat(self._path)
+        except OSError:
+            return None
+        return st.st_ino, st.st_size, st.st_mtime_ns, st.st_ctime_ns
+
+    def invalidate_cache(self) -> None:
+        """
+        Drop the cached file contents, forcing the next read to re-parse.
+        """
+        self._cache = None
+        self._cache_sig = None
+
     def read(self) -> Optional[dict[str, dict[str, Any]]]:
+        sig = self._signature()
+        if sig is not None and self._cache is not None and sig == self._cache_sig:
+            return self._cache
+
         # Get the file size by moving the cursor to the file end and reading
         # its location
         self._handle.seek(0, os.SEEK_END)
@@ -137,9 +165,20 @@ class JSONStorage(Storage):
             self._handle.seek(0)
 
             # Load the JSON contents of the file
-            return json.load(self._handle)
+            data = json.load(self._handle)
+
+            # Only cache if the file did not change while we were parsing it
+            if sig is not None and self._signature() == sig:
+                self._cache, self._cache_sig = data, sig
+            else:
+                self.invalidate_cache()
+            return data
 
     def write(self, data: dict[str, dict[str, Any]]):
+        # The caller may keep mutating ``data``, so never trust the cache
+        # after a write
+        self.invalidate_cache()
+
         # Move the cursor to the beginning of the file just in case
         self._handle.seek(0)
 
