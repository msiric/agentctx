@@ -0,0 +1,104 @@
+"""
+Benchmark TinyDB read performance on a large JSON db file.
+
+Usage: python scripts/bench_read.py [target_size_mb=40] [repeats=5]
+
+Generates a temporary db of roughly the requested size, then times
+``db.all()``, ``db.search()`` (cold and cache-hit) and breaks the cost down
+into raw file read, ``json.load``, document wrapping and query evaluation.
+"""
+import json
+import os
+import random
+import string
+import sys
+import tempfile
+import time
+from statistics import median
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))
+
+from tinydb import TinyDB, where  # noqa: E402
+from tinydb.table import Document  # noqa: E402
+
+
+def make_doc(i, rng):
+    return {
+        'id': i,
+        'name': ''.join(rng.choices(string.ascii_lowercase, k=12)),
+        'group': rng.randrange(1000),
+        'score': rng.random(),
+        'tags': [rng.choice(['a', 'b', 'c', 'd', 'e']) for _ in range(5)],
+        'text': ''.join(rng.choices(string.ascii_letters + ' ', k=100)),
+    }
+
+
+def generate(path, target_mb):
+    rng = random.Random(0)
+    target = target_mb * 1024 * 1024
+    docs, size, i = {}, 0, 0
+    while size < target:
+        d = make_doc(i, rng)
+        i += 1
+        docs[str(i)] = d
+        size += len(json.dumps(d)) + 10
+    with open(path, 'w') as f:
+        json.dump({'_default': docs}, f)
+    return len(docs)
+
+
+def timeit(fn, repeats):
+    times = []
+    for _ in range(repeats):
+        t = time.perf_counter()
+        fn()
+        times.append(time.perf_counter() - t)
+    return median(times)
+
+
+def main():
+    mb = float(sys.argv[1]) if len(sys.argv) > 1 else 40
+    repeats = int(sys.argv[2]) if len(sys.argv) > 2 else 5
+
+    with tempfile.TemporaryDirectory() as tmp:
+        path = os.path.join(tmp, 'db.json')
+        n = generate(path, mb)
+        print(f'{n} docs, {os.path.getsize(path) / 1e6:.1f} MB, '
+              f'median of {repeats} runs\n')
+
+        db = TinyDB(path)
+        table = db.table('_default')
+        query = where('group') == 42
+
+        def row(label, secs):
+            print(f'{label:<42}{secs * 1000:>9.1f} ms')
+
+        print('End to end')
+        row('db.all()', timeit(db.all, repeats))
+        def cold_search():
+            db.clear_cache()
+            return db.search(query)
+        row('db.search(where("group") == 42) cold', timeit(cold_search, repeats))
+        db.search(query)
+        row('db.search(...) repeated (cache hit)', timeit(lambda: db.search(query), repeats))
+        row('db.get(doc_id=1)', timeit(lambda: db.get(doc_id=1), repeats))
+        row('len(db)', timeit(lambda: len(db), repeats))
+
+        print('\nBreakdown')
+        def raw_read():
+            with open(path) as f:
+                return f.read()
+        text = raw_read()
+        row('read file into str', timeit(raw_read, repeats))
+        row('json.loads (CPU only)', timeit(lambda: json.loads(text), repeats))
+        row('storage.read() (seek + json.load)', timeit(db.storage.read, repeats))
+        data = db.storage.read()['_default']
+        row('wrap docs in Document', timeit(
+            lambda: [Document(d, int(k)) for k, d in data.items()], repeats))
+        row('evaluate query over parsed docs', timeit(
+            lambda: [d for d in data.values() if query(d)], repeats))
+        db.close()
+
+
+if __name__ == '__main__':
+    main()
