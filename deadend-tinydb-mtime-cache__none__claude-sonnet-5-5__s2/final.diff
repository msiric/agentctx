@@ -285,3 +285,26 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def test_json_read_cache_sees_external_writes(tmp_path):
+    import os
+    path = str(tmp_path / 'db.json')
+    with open(path, 'w') as f:
+        f.write('{"_default": {"1": {"a": 1}}}')
+    old = os.stat(path).st_mtime - 100
+    os.utime(path, (old, old))  # old enough to be cached
+
+    storage = JSONStorage(path)
+    first = storage.read()
+    assert storage.read() is first  # served from cache
+
+    # Same-size rewrite by "another process", with a distinct mtime
+    with open(path, 'w') as f:
+        f.write('{"_default": {"1": {"a": 2}}}')
+    os.utime(path, (old + 1, old + 1))
+    assert storage.read() == {'_default': {'1': {'a': 2}}}
+
+    storage.write({'x': {}})
+    assert storage.read() == {'x': {}}
+    storage.close()
