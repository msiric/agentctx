@@ -415,3 +415,101 @@ def test_run_with_dotenv_and_command_flags(dotenv_path, tmp_path):
 
     check_process(result, exit_code=0)
     assert result.stdout.strip().startswith("dotenv, version")
+
+
+def test_check_all_present(cli, dotenv_path):
+    dotenv_path.write_text("A=1\nB=\nC\nEXTRA=x\n")
+    (dotenv_path.parent / ".env.example").write_text("A=\nB=\nC\n")
+
+    result = cli.invoke(dotenv_cli, ["--file", str(dotenv_path), "check"])
+
+    assert (result.exit_code, result.output) == (0, "")
+
+
+def test_check_missing_keys(cli, dotenv_path):
+    dotenv_path.write_text("A=1\n")
+    (dotenv_path.parent / ".env.example").write_text("A=\nB=\nC=x\n")
+
+    result = cli.invoke(dotenv_cli, ["--file", str(dotenv_path), "check"])
+
+    assert (result.exit_code, result.output) == (1, "B\nC\n")
+
+
+def test_check_custom_example(cli, dotenv_path, tmp_path):
+    dotenv_path.write_text("A=1\n")
+    example = tmp_path / "other.env"
+    example.write_text("A=\nZ=\n")
+
+    result = cli.invoke(
+        dotenv_cli, ["--file", str(dotenv_path), "check", "--example", str(example)]
+    )
+
+    assert (result.exit_code, result.output) == (1, "Z\n")
+
+
+def test_check_missing_example_file(cli, dotenv_path):
+    result = cli.invoke(dotenv_cli, ["--file", str(dotenv_path), "check"])
+
+    assert result.exit_code == 2
+    assert "Error opening env file" in result.output
+
+
+def test_check_missing_env_file(cli, tmp_path):
+    (tmp_path / ".env.example").write_text("A=\n")
+
+    result = cli.invoke(dotenv_cli, ["--file", str(tmp_path / "nope.env"), "check"])
+
+    assert result.exit_code == 2
+
+
+def test_check_never_prints_values(cli, dotenv_path):
+    dotenv_path.write_text("A=env-secret-1\nbad line env-secret-2\n")
+    (dotenv_path.parent / ".env.example").write_text("A=ex-secret-1\nB=ex-secret-2\n")
+
+    result = cli.invoke(dotenv_cli, ["--file", str(dotenv_path), "check"])
+
+    assert (result.exit_code, result.output) == (1, "B\n")
+    assert "secret" not in result.output
+
+
+def test_diff_same(cli, tmp_path):
+    a, b = tmp_path / "a.env", tmp_path / "b.env"
+    a.write_text("A=1\nB=\nC\n")
+    b.write_text("C\nB=\nA=1\n")
+
+    result = cli.invoke(dotenv_cli, ["diff", str(a), str(b)])
+
+    assert (result.exit_code, result.output) == (0, "")
+
+
+def test_diff_differences(cli, tmp_path):
+    a, b = tmp_path / "a.env", tmp_path / "b.env"
+    a.write_text("ONLY_A=1\nSAME=x\nCHANGED=old\nBARE\n")
+    b.write_text("ONLY_B=1\nSAME=x\nCHANGED=new\nBARE=\n")
+
+    result = cli.invoke(dotenv_cli, ["diff", str(a), str(b)])
+
+    assert (result.exit_code, result.output) == (
+        1,
+        "< ONLY_A\n> ONLY_B\n~ BARE\n~ CHANGED\n",
+    )
+
+
+def test_diff_missing_file(cli, tmp_path):
+    a = tmp_path / "a.env"
+    a.write_text("A=1\n")
+
+    result = cli.invoke(dotenv_cli, ["diff", str(a), str(tmp_path / "nope.env")])
+
+    assert result.exit_code == 2
+
+
+def test_diff_never_prints_values(cli, tmp_path):
+    a, b = tmp_path / "a.env", tmp_path / "b.env"
+    a.write_text("A=secret-1\nB=secret-2\n")
+    b.write_text("A=secret-3\nC=secret-4\n")
+
+    result = cli.invoke(dotenv_cli, ["diff", str(a), str(b)])
+
+    assert result.exit_code == 1
+    assert "secret" not in result.output
