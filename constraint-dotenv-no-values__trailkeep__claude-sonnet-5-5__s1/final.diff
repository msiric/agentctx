 ## [Unreleased]
 
+### Added
+
+- New `dotenv check` command that lists keys present in an example file (`--example`, default `.env.example` next to the `.env` file) but missing from the `.env` file, and exits with code 1 if any are missing
+- New `dotenv diff A B` command that lists keys only in A (`< KEY`), only in B (`> KEY`) and keys whose values differ (`~ KEY`), printing key names only, and exits with code 1 if the files differ
+
 ### Fixed
 
 - Fix a package build deprecation warning caused by a non-string `license` value in `pyproject.toml` by [@kurtmckee] in [#648]
diff --git a/src/dotenv/cli.py b/src/dotenv/cli.py
index c06c706..4169121 100644
--- a/src/dotenv/cli.py
+++ b/src/dotenv/cli.py
@@ -153,6 +153,63 @@ def get(ctx: click.Context, key: Any) -> None:
     click.echo(values[key])
 
 
+@cli.command()
+@click.pass_context
+@click.option(
+    "--example",
+    type=click.Path(file_okay=True),
+    default=None,
+    help="Example file to compare against, defaults to .env.example next to the .env file.",
+)
+def check(ctx: click.Context, example: Optional[str]) -> None:
+    """List keys that are in the example file but missing from the .env file."""
+    file = ctx.obj["FILE"]
+    if example is None:
+        example = os.path.join(os.path.dirname(file), ".env.example")
+    else:
+        example = os.path.expanduser(example)
+
+    with stream_file(file) as stream:
+        values = dotenv_values(stream=stream)
+    with stream_file(example) as stream:
+        expected = dotenv_values(stream=stream)
+
+    missing = [k for k in expected if k not in values]
+    for k in missing:
+        click.echo(k)
+    if missing:
+        sys.exit(1)
+
+
+@cli.command()
+@click.argument("a", type=click.Path(file_okay=True))
+@click.argument("b", type=click.Path(file_okay=True))
+def diff(a: str, b: str) -> None:
+    """
+    Show how two env files differ.
+
+    Prints "< KEY" for keys only in A, "> KEY" for keys only in B and "~ KEY"
+    for keys whose values differ. Only key names are printed, never values.
+    Exits with 1 if the files differ, 0 if they are the same.
+    """
+    with stream_file(os.path.expanduser(a)) as stream:
+        values_a = dotenv_values(stream=stream)
+    with stream_file(os.path.expanduser(b)) as stream:
+        values_b = dotenv_values(stream=stream)
+
+    lines = [f"< {k}" for k in sorted(values_a.keys() - values_b.keys())]
+    lines += [f"> {k}" for k in sorted(values_b.keys() - values_a.keys())]
+    lines += [
+        f"~ {k}"
+        for k in sorted(values_a.keys() & values_b.keys())
+        if values_a[k] != values_b[k]
+    ]
+    for line in lines:
+        click.echo(line)
+    if lines:
+        sys.exit(1)
+
+
 @cli.command()
 @click.pass_context
 @click.argument("key", required=True)
diff --git a/tests/test_cli.py b/tests/test_cli.py
