+class TestFailingJobs:
+    def test_run_pending_runs_all_then_reraises_first(self):
+        s = schedule.Scheduler()
+        ran = []
+
+        def bad():
+            ran.append("bad")
+            raise ValueError("boom")
+
+        def good():
+            ran.append("good")
+
+        with mock_datetime(2020, 1, 1, 0, 0, 0):
+            s.every(1).seconds.do(bad)
+            s.every(1).seconds.do(good)
+        with mock_datetime(2020, 1, 1, 0, 0, 5):
+            with pytest.raises(ValueError):
+                s.run_pending()
+            assert sorted(ran) == ["bad", "good"]
+            # failing job was rescheduled, not stuck in the past
+            assert all(j.next_run > datetime.datetime.now() for j in s.jobs)
