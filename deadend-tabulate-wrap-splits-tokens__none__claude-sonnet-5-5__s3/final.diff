diff --git a/test/test_cli.py b/test/test_cli.py
index 154f1a2..ce32e4e 100644
--- a/test/test_cli.py
+++ b/test/test_cli.py
@@ -483,3 +483,22 @@ def test_inprocess_jsonl_malformed_headers():
     )
     # output should still be produced (graceful fallback), with raw keys as headers
     assert out.strip() != ""
+
+
+def test_inprocess_wrap_option():
+    """In-process: --wrap wraps long cell text at WIDTH"""
+    out = run_main_in_process(["--wrap=10", "-s", ","], input_text="1,aaa bbb ccc ddd eee\n")
+    lines = out.splitlines()
+    assert any(l.rstrip().endswith("aaa bbb") for l in lines)
+    assert any(l.rstrip().endswith("ccc ddd") for l in lines)
+    assert any(l.rstrip().endswith("eee") for l in lines)
+
+
+def test_inprocess_wrap_invalid():
+    for bad in ["0", "-3", "abc"]:
+        try:
+            run_main_in_process(["--wrap", bad], input_text="a b\n")
+        except SystemExit as e:
+            assert_equal(e.code, 2)
+        else:
+            raise AssertionError("expected SystemExit")
