+/**
+ * Merge all ranges into one, from the lowest start to the highest end.
+ * @private
+ */
+
+function spanRanges (ranges) {
+  var start = Infinity
+  var end = -1
+
+  for (var i = 0; i < ranges.length; i++) {
+    if (ranges[i].start < start) start = ranges[i].start
+    if (ranges[i].end > end) end = ranges[i].end
+  }
+
+  var spanned = [{ start: start, end: end }]
+
+  // copy ranges type
+  spanned.type = ranges.type
+
+  return spanned
+}
