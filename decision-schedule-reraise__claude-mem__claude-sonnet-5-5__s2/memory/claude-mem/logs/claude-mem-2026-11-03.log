class SchedulerErrorHandlingTests(TestCase):
    def setUp(self):
        schedule.clear()

    def tearDown(self):
        schedule.clear()

    def _jobs(self):
        calls = []

        def bad(name):
            calls.append(name)
            raise ValueError(name)

        def good(name):
            calls.append(name)

        every().minute.do(bad, "bad1")
        every().minute.do(good, "good")
        every().minute.do(bad, "bad2")
        return calls

    def test_run_all_isolates_failures_and_reraises_first(self):
        calls = self._jobs()
        with self.assertLogs("schedule", level="ERROR") as logs:
            with self.assertRaises(ValueError) as cm:
                schedule.run_all()
        assert str(cm.exception) == "bad1"
        assert calls == ["bad1", "good", "bad2"]
        assert len(logs.output) == 1

    def test_run_pending_isolates_failures(self):
        calls = self._jobs()
        with mock_datetime(2014, 6, 28, 12, 0, 0):
            for job in schedule.get_jobs():
                job.next_run = datetime.datetime(2014, 6, 28, 11, 0, 0)
            with self.assertLogs("schedule", level="ERROR"):
                with self.assertRaises(ValueError):
                    schedule.run_pending()
        assert sorted(calls) == ["bad1", "bad2", "good"]

    def test_run_all_sleeps_only_between_jobs(self):
        make = make_mock_job
        for _ in range(3):
            every().minute.do(make())
        with mock.patch("schedule.time.sleep") as sleep:
            schedule.run_all(delay_seconds=2)
        assert sleep.call_count == 2
'''
open(p,'w').write(s)
EOF
