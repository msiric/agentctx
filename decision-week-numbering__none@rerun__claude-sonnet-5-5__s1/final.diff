+	t.is(render('{DDD}', new Date(2016, 1, 29)), '060', 'day of year: leap day');
+	t.is(render('{DDD}', new Date(2017, 2, 1)), '060', 'day of year: Mar 1 (common year)');
+	t.is(render('{DDD}', new Date(2017, 2, 12, 23, 59, 59)), '071', 'day of year: unaffected by time of day');
