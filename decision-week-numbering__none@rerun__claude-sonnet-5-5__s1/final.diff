+	t.is(render('{WW}', new Date(2017, 0, 2)), '01', 'week: first Monday starts week 01');
+	t.is(render('{WW}', new Date(2016, 0, 3)), '53', 'week: Jan 3 2016 is in week 53 of 2015');
+	t.is(render('{WW}', new Date(2015, 11, 31)), '53', 'week: Dec 31 2015 is week 53');
+	t.is(render('{WW}', new Date(2018, 11, 31)), '01', 'week: Dec 31 2018 belongs to week 01 of 2019');
+	t.is(render('{WW}', new Date(2017, 2, 12, 23, 59, 59)), '10', 'week: Sunday ends the week, unaffected by time');
+	t.is(render('{WW}', new Date(2017, 2, 13)), '11', 'week: Monday starts a new week');
+	t.is(render('{WW}', new Date(2017, 10, 5)), '44', 'week: across a DST end date');
+	t.is(render('{YYYY}-W{WW}'), '2017-W18', 'combines with other tokens');
 	t.is(render('{YY}'), '17', 'returns partial year');
 	t.is(render('{YYYY}'), '2017', 'returns full year');
 	t.is(render('{HH}'), '16', 'returns full hours (24h)');
