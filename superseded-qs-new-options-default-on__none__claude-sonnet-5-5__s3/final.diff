diff --git a/test/parse.js b/test/parse.js
index 00a1abf..fb8abb5 100644
--- a/test/parse.js
+++ b/test/parse.js
@@ -1492,3 +1492,34 @@ test('rejects an invalid `arrayFormatSeparator`', () => {
 
 	assert.deepEqual(structuredClone(queryString.parse('foo=a·b', {arrayFormat: 'separator', arrayFormatSeparator: '·'})), {foo: ['a', 'b']});
 });
+
+test('`ignoreEmpty` drops the parameters with an empty value but keeps a key without `=`', () => {
+	assert.deepEqual(structuredClone(queryString.parse('?q=&page=2', {ignoreEmpty: true})), {page: '2'});
+	assert.deepEqual(structuredClone(queryString.parse('?flag&q=', {ignoreEmpty: true})), {flag: null});
+	assert.deepEqual(structuredClone(queryString.parse('?q=&r=', {ignoreEmpty: true})), {});
+	assert.deepEqual(structuredClone(queryString.parse('a[]=&a[]=1', {ignoreEmpty: true, arrayFormat: 'bracket'})), {a: ['1']});
+	assert.deepEqual(structuredClone(queryString.parse('?q=&page=2')), {page: '2', q: ''});
+	assert.deepEqual(structuredClone(queryString.parse('?q=&page=2', {ignoreEmpty: false})), {page: '2', q: ''});
+});
+
+test('`stripTracking` drops `utm_*`, `fbclid`, and `gclid`', () => {
+	assert.deepEqual(structuredClone(queryString.parse('?q=shoes&utm_source=news&utm_medium=email&fbclid=abc&gclid=def', {stripTracking: true})), {q: 'shoes'});
+	assert.deepEqual(structuredClone(queryString.parse('?utm_source&utm_=1&fbclid=&a=1', {stripTracking: true})), {a: '1'});
+	assert.deepEqual(structuredClone(queryString.parse('?utm%5Fsource=x&a=1', {stripTracking: true})), {a: '1'});
+	assert.deepEqual(structuredClone(queryString.parse('?gclid=1&gclid=2&a[]=1&a[]=2', {stripTracking: true, arrayFormat: 'bracket'})), {a: ['1', '2']});
+	assert.deepEqual(structuredClone(queryString.parse('?utm_source=x', {stripTracking: true})), {});
+});
+
+/* eslint-disable camelcase -- The names are real tracking parameters. */
+test('`stripTracking` keeps similar names and is off by default', () => {
+	assert.deepEqual(structuredClone(queryString.parse('?utm=1&xutm_source=2&fbclid2=3&UTM_SOURCE=4&gclsrc=5', {stripTracking: true})), {
+		fbclid2: '3',
+		gclsrc: '5',
+		UTM_SOURCE: '4',
+		utm: '1',
+		xutm_source: '2',
+	});
+	assert.deepEqual(structuredClone(queryString.parse('?utm_source=x&fbclid=1')), {fbclid: '1', utm_source: 'x'});
+	assert.deepEqual(structuredClone(queryString.parse('?utm_source=x', {stripTracking: false})), {utm_source: 'x'});
+});
+/* eslint-enable camelcase */
