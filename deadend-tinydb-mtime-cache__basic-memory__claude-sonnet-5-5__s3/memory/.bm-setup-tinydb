ion, not per opinion. Validation is `warn`,\nnever blocking.\n","numLines":44,"startLine":1,"totalLines":44}},"tool_result_meta":[{"id":"toolu_01Q9ggnrX3pmYdUES5CiD4Ap","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
