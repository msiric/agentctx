+"""
+Benchmark TinyDB read performance on a large JSON db file.
+
+Usage: python scripts/bench_read.py [--size-mb 40] [--keep PATH]
+
+Breaks the time down into: raw file read, json parsing, db.all(),
+a cold search (query cache cleared) and a cached search.
+"""
+import argparse
+import json
+import os
+import random
+import string
+import sys
+import tempfile
+import time
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))
+
+from tinydb import TinyDB, where  # noqa: E402
+
+
+def make_doc(i, rng):
+    return {
+        'id': i,
+        'name': ''.join(rng.choices(string.ascii_letters, k=12)),
+        'group': rng.randrange(100),
+        'score': rng.random(),
+        'tags': [rng.choice(['a', 'b', 'c', 'd']) for _ in range(5)],
+        'text': ''.join(rng.choices(string.ascii_lowercase + ' ', k=100)),
+    }
+
+
+def generate(path, size_mb):
+    rng = random.Random(0)
+    docs, n = {}, 0
+    # Estimate bytes per doc from a sample, then build all at once
+    per_doc = len(json.dumps(make_doc(0, rng))) + 12
+    n = int(size_mb * 1024 * 1024 / per_doc)
+    docs = {str(i + 1): make_doc(i, rng) for i in range(n)}
+    with open(path, 'w') as f:
+        json.dump({'_default': docs}, f)
+    return n
+
+
+def timed(label, fn, repeat=3):
+    best = float('inf')
+    for _ in range(repeat):
+        t = time.perf_counter()
+        result = fn()
+        best = min(best, time.perf_counter() - t)
+    print(f'{label:<38}{best * 1000:10.1f} ms')
+    return result
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--size-mb', type=float, default=40)
+    ap.add_argument('--keep', help='write the db here and keep it')
+    args = ap.parse_args()
+
+    tmp = None
+    path = args.keep
+    if not path:
+        tmp = tempfile.TemporaryDirectory()
+        path = os.path.join(tmp.name, 'big.json')
+
+    n = generate(path, args.size_mb)
+    print(f'{n} docs, {os.path.getsize(path) / 1e6:.1f} MB, '
+          f'python {sys.version.split()[0]}\n')
+
+    def read_bytes():
+        with open(path) as f:
+            return f.read()
+
+    text = timed('file read (no parsing)', read_bytes)
+    timed('json.loads of the text', lambda: json.loads(text))
+
+    db = TinyDB(path)
+    table = db.table('_default')
+    timed('storage.read() (read + parse)', db.storage.read)
+    timed('db.all()', db.all)
+    q = where('group') == 7
+    timed('search, cold (cache cleared)',
+          lambda: (table.clear_cache(), table.search(q))[1])
+    timed('search, cached', lambda: table.search(q))
+    timed('len(db)', lambda: len(db))
+    db.close()
+    if tmp:
+        tmp.cleanup()
+
+
+if __name__ == '__main__':
+    main()
