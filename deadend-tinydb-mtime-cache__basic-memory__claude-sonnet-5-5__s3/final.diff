+
+
+def test_json_read_cache(tmpdir):
+    import json as _json
+    import os
+    from tinydb.storages import JSONStorage
+
+    path = str(tmpdir.join('db.json'))
+    with open(path, 'w') as f:
+        f.write('{"_default": {"1": {"a": 1}}}')
+    old = os.stat(path).st_mtime - 10
+    os.utime(path, (old, old))
+
+    storage = JSONStorage(path)
+    first = storage.read()
+    assert storage.read() is first  # unchanged file: no re-parse
+
+    # Another process rewrites the file (same size, mtime preserved is
+    # impossible to detect, but a changed mtime/ctime must be seen)
+    with open(path, 'w') as f:
+        f.write('{"_default": {"1": {"a": 2}}}')
+    assert storage.read() == {'_default': {'1': {'a': 2}}}
+
+    # Recently modified files are not served from the cache
+    assert storage.read() is not storage.read()
+    storage.close()
