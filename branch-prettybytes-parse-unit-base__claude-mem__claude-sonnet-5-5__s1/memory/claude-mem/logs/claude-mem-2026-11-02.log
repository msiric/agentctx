test('parseBytes: units are case-sensitive', t => {
	for (const input of ['1 kib', '1 KIB', '1 Kib', '1 kiB', '1 b', '1 mib', '1 yib']) {
		t.throws(() => parseBytes(input), {instanceOf: TypeError}, input);
	}
});

test('parseBytes: decimal units are not supported yet', t => {
	for (const input of ['1 kB', '1 MB', '1 GB', '1 TB', '1 PB', '1 EB', '1 ZB', '1 YB', '1 K', '1 KB']) {
		t.throws(() => parseBytes(input), {instanceOf: TypeError, message: /Unsupported unit/}, input);
	}
