// An optional sign, a decimal number (`1`, `1.5`, `.5`), and an optional unit that may be separated by whitespace, which includes the non-breaking space `prettyBytes` can emit.
const BYTES_PATTERN = /^([+-]?)(\d+(?:\.\d+)?|\.\d+)\s*(\S*)$/;

export function parseBytes(string) {
	if (typeof string !== 'string') {
		throw new TypeError(`Expected a string, got ${typeof string}: ${string}`);
	}

	const match = BYTES_PATTERN.exec(string.trim());

	if (!match) {
		throw new TypeError(`Unable to parse a byte count from: ${JSON.stringify(string)}`);
	}

	const [, sign, digits, unit = ''] = match;

	// Units are case-sensitive, the same as the `prettyBytes` output. A missing unit means bytes.
	const exponent = unit === '' ? 0 : BIBYTE_UNITS.indexOf(unit);

	if (exponent === -1) {
		throw new TypeError(`Unsupported unit ${JSON.stringify(unit)}, expected one of: ${BIBYTE_UNITS.join(', ')}`);
	}

	// `1024 ** exponent` is a power of two, so it is exact and the product rounds only once.
	const bytes = Number(digits) * (1024 ** exponent);

	return sign === '-' && bytes !== 0 ? -bytes : bytes;
}
EOF
python3 - <<'EOF'
p='index.d.ts'
s=open(p).read()
s+='''
/**
Parse a human readable binary byte string, the reverse of `prettyBytes(number, {binary: true})`: `'1.5 KiB'` → `1536`.

Supports plain numbers (`'512'`), `B`, and the binary units `KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`, `ZiB`, and `YiB`. Fractional values, an optional sign, and no space or any whitespace before the unit are accepted. Units are case-sensitive. Decimal units like `kB` and `MB` are not supported yet and throw.

The result is a `number`, so above `Number.MAX_SAFE_INTEGER` bytes it is not exact. A fractional result is not rounded.

@param string - The string to parse.
@returns The number of bytes.
@throws A `TypeError` if the input is not a string, cannot be parsed, or has an unsupported unit.

@example
```
import {parseBytes} from 'pretty-bytes';

parseBytes('512');
//=> 512

parseBytes('1.5 KiB');
//=> 1536
```
*/
export function parseBytes(string: string): number;
'''
open(p,'w').write(s)
p='index.test-d.ts'
s=open(p).read()
s=s.replace("import prettyBytes from './index.js';","import prettyBytes, {parseBytes} from './index.js';")
s+="\nexpectType<number>(parseBytes('1.5 KiB'));\n"
open(p,'w').write(s)
p='test.js'
s=open(p).read()
s=s.replace("import prettyBytes from './index.js';","import prettyBytes, {parseBytes} from './index.js';",1)
s+='''
test('parseBytes: plain numbers and bytes', t => {
	t.is(parseBytes('0'), 0);
	t.is(parseBytes('512'), 512);
	t.is(parseBytes('512 B'), 512);
	t.is(parseBytes('512B'), 512);
	t.is(parseBytes('0.5'), 0.5);
	t.is(parseBytes('.5 B'), 0.5);
	t.is(parseBytes('  512 B  '), 512);
	t.is(parseBytes('512\\u00A0B'), 512);
});

test('parseBytes: binary units', t => {
	for (const [exponent, unit] of BINARY_UNITS.entries()) {
		t.is(parseBytes(`1 ${unit}`), 1024 ** exponent, unit);
		t.is(parseBytes(`2${unit}`), 2 * (1024 ** exponent), unit);
	}

	t.is(parseBytes('1 YiB'), 2 ** 80);
});

test('parseBytes: fractional values', t => {
	t.is(parseBytes('1.5 KiB'), 1536);
	t.is(parseBytes('0.5 MiB'), 524_288);
	t.is(parseBytes('.25 KiB'), 256);
	t.is(parseBytes('1.5 B'), 1.5);
});

test('parseBytes: signs', t => {
	t.is(parseBytes('+1 KiB'), 1024);
	t.is(parseBytes('-1.5 KiB'), -1536);
	t.is(parseBytes('-0'), 0);
	t.true(Object.is(parseBytes('-0 KiB'), 0));
});

test('parseBytes: reverses prettyBytes in binary mode', t => {
	for (const value of [0, 1, 512, 1024, 1536, 2 ** 20, 5 * (2 ** 30), 2 ** 50]) {
		t.is(parseBytes(prettyBytes(value, {binary: true})), value);
		t.is(parseBytes(prettyBytes(value, {binary: true, space: false})), value);
		t.is(parseBytes(prettyBytes(value, {binary: true, nonBreakingSpace: true})), value);
	}
