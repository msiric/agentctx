index 4fac6e9..d092d18 100644
--- a/index.d.ts
+++ b/index.d.ts
@@ -216,3 +216,27 @@ export default function prettyBytes(
 	number: number | bigint,
 	options?: Options
 ): string;
+
+/**
+Parse a human readable byte string, the reverse of `prettyBytes`: `'1.5 KiB'` → `1536` and `'1.5 kB'` → `1500`.
+
+Supports plain numbers (`'512'`), `B`, the binary units `KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`, `ZiB`, and `YiB` (powers of 1024), and the SI units `kB` (also `KB`), `MB`, `GB`, `TB`, `PB`, `EB`, `ZB`, and `YB` (strict powers of 1000, so `'1 MB'` is exactly `1000000`). Fractional values, an optional sign, and no space or any whitespace before the unit are accepted. Units are case-sensitive.
+
+The result is a `number`, so above `Number.MAX_SAFE_INTEGER` bytes it is not exact. A fractional result is not rounded.
+
+@param string - The string to parse.
+@returns The number of bytes.
+@throws A `TypeError` if the input is not a string, cannot be parsed, or has an unsupported unit.
+
+@example
+```
+import {parseBytes} from 'pretty-bytes';
+
+parseBytes('512');
+//=> 512
+
+parseBytes('1.5 KiB');
+//=> 1536
+```
+*/
+export function parseBytes(string: string): number;
diff --git a/index.js b/index.js
index c5f37ab..03f0c00 100644
--- a/index.js
+++ b/index.js
@@ -285,3 +285,39 @@ export default function prettyBytes(number, options) {
 	const result = prefix + numberString + separator + UNITS[exponent];
 	return result.padStart(options.fixedWidth ?? 0);
 }
+
+// An optional sign, a decimal number (`1`, `1.5`, `.5`), and an optional unit that may be separated by whitespace, which includes the non-breaking space `prettyBytes` can emit.
+const BYTES_PATTERN = /^([+-]?)(\d+(?:\.\d+)?|\.\d+)\s*(\S*)$/;
+
+export function parseBytes(string) {
+	if (typeof string !== 'string') {
+		throw new TypeError(`Expected a string, got ${typeof string}: ${string}`);
+	}
+
+	const match = BYTES_PATTERN.exec(string.trim());
+
+	if (!match) {
+		throw new TypeError(`Unable to parse a byte count from: ${JSON.stringify(string)}`);
+	}
+
+	const [, sign, digits, rawUnit = ''] = match;
+	// `KB` is a common spelling of `kB`, so it means 1000 bytes too.
+	const unit = rawUnit === 'KB' ? 'kB' : rawUnit;
+
+	// Units are case-sensitive, the same as the `prettyBytes` output. A missing unit means bytes.
+	const binaryExponent = BIBYTE_UNITS.indexOf(unit);
+	const decimalExponent = BYTE_UNITS.indexOf(unit);
+	const exponent = unit === '' ? 0 : Math.max(binaryExponent, decimalExponent);
+
+	if (exponent === -1) {
+		throw new TypeError(`Unsupported unit ${JSON.stringify(unit)}, expected one of: ${[...BYTE_UNITS, ...BIBYTE_UNITS.slice(1)].join(', ')}`);
+	}
+
+	// Binary: `1024 ** exponent` is a power of two, so it is exact and the product rounds only once.
+	// Decimal (strict SI): scale in the decimal string, so `1 MB` is exactly 1,000,000 and `1.1 MB` is the nearest number to 1,100,000 rather than the product of two rounded values.
+	const bytes = binaryExponent > 0
+		? Number(digits) * (1024 ** exponent)
+		: Number(`${digits}e${3 * exponent}`);
+
+	return sign === '-' && bytes !== 0 ? -bytes : bytes;
+}
