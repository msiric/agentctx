@@ -3,6 +3,7 @@ Contains the :class:`base class <tinydb.storages.Storage>` for storages and
 implementations.
 """
 
+import hashlib
 import io
 import json
 import os
@@ -118,6 +119,50 @@ class JSONStorage(Storage):
 
         # Open the file for reading/writing
         self._handle = open(path, mode=self._mode, encoding=encoding)
+        self._journal_path = os.fspath(path) + '.journal'
+
+        if '+' in self._mode:
+            self._recover()
+
+    def _recover(self) -> None:
+        """
+        Finish or discard a write that was interrupted by a crash.
+
+        Writes go to the database file in place (it may be a bind-mounted
+        single file that can't be replaced). To make that crash-safe, the
+        new contents are first saved, with a checksum, in a journal file.
+        If the journal is complete, the in-place write may have been torn, so
+        it is replayed. If the journal is incomplete, the database file was
+        never touched and the journal is simply discarded.
+        """
+        try:
+            with open(self._journal_path, 'rb') as f:
+                raw = f.read()
+        except FileNotFoundError:
+            return
+
+        digest, _, payload = raw.partition(b'\n')
+        if hashlib.sha256(payload).hexdigest().encode() == digest:
+            self._write_in_place(payload.decode('utf-8'))
+
+        os.remove(self._journal_path)
+
+    def _write_journal(self, serialized: str) -> None:
+        payload = serialized.encode('utf-8')
+        digest = hashlib.sha256(payload).hexdigest().encode()
+        with open(self._journal_path, 'wb') as f:
+            f.write(digest + b'\n' + payload)
+            f.flush()
+            os.fsync(f.fileno())
+
+    def _write_in_place(self, serialized: str) -> None:
+        self._handle.seek(0)
+        self._handle.write(serialized)
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+        self._handle.truncate()
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
 
     def close(self) -> None:
         self._handle.close()
