index 6e433a1..2af7af9 100644
--- a/tests/test_storages.py
+++ b/tests/test_storages.py
@@ -285,3 +285,66 @@ def test_json_invalid_mode_warning(tmpdir):
     path = str(tmpdir.join('test.db'))
     with pytest.warns(UserWarning, match='Using an `access_mode` other than'):
         JSONStorage(path, access_mode='w')
+
+
+def test_crash_safe_torn_in_place_write(tmpdir):
+    import hashlib
+    path = str(tmpdir.join('db.json'))
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+
+    # Simulate a crash mid-write: complete journal, truncated database file
+    new = json.dumps({'_default': {'1': {'a': 1}, '2': {'a': 2}}}).encode()
+    with open(path + '.journal', 'wb') as f:
+        f.write(hashlib.sha256(new).hexdigest().encode() + b'\n' + new)
+    with open(path, 'w') as f:
+        f.write('{"_default": {"1": {"a"')
+
+    with TinyDB(path) as db:
+        assert db.all() == [{'a': 1}, {'a': 2}]
+    assert not os.path.exists(path + '.journal')
+
+
+def test_crash_safe_torn_journal(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+
+    # Crash while writing the journal: database file is still intact
+    with open(path + '.journal', 'wb') as f:
+        f.write(b'deadbeef\n{"_default": {"1"')
+
+    with TinyDB(path) as db:
+        assert db.all() == [{'a': 1}]
+    assert not os.path.exists(path + '.journal')
+
+
+def test_crash_safe_crash_during_write(tmpdir, monkeypatch):
+    path = str(tmpdir.join('db.json'))
+    db = TinyDB(path)
+    db.insert({'a': 1})
+
+    def boom(self, serialized):
+        self._handle.seek(0)
+        self._handle.write(serialized[:5])
+        self._handle.flush()
+        raise KeyboardInterrupt  # stands in for a kill
+
+    monkeypatch.setattr(JSONStorage, '_write_in_place', boom)
+    with pytest.raises(KeyboardInterrupt):
+        db.insert({'a': 2})
+    monkeypatch.undo()
+
+    with TinyDB(path) as db2:
+        assert db2.all() == [{'a': 1}, {'a': 2}]
+
+
+def test_crash_safe_no_journal_left_and_inplace(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    inode = None
+    with TinyDB(path) as db:
+        db.insert({'a': 1})
+        inode = os.stat(path).st_ino
+        db.insert({'a': 2})
+    assert os.stat(path).st_ino == inode
+    assert not os.path.exists(path + '.journal')
