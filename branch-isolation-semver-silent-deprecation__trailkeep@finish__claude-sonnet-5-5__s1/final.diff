@@ -155,3 +156,29 @@ def test_should_return_documented_error_code_for_invalid_version(cliargs, capsys
     # docs/pysemver.rst shows ``echo $?`` printing 2 for both commands
     assert main(cliargs) == 2
     assert capsys.readouterr().err.startswith("ERROR")
+
+
+@pytest.mark.parametrize("prefix", ["v", "V"])
+@pytest.mark.parametrize(
+    "cli,expected",
+    [
+        (["bump", "major", "{}1.2.3"], "2.0.0"),
+        (["bump", "minor", "{}1.2.3"], "1.3.0"),
+        (["bump", "patch", "{}1.2.3"], "1.2.4"),
+        (["bump", "prerelease", "{}1.2.3-rc1"], "1.2.3-rc1.0"),
+        (["bump", "build", "{}1.2.3+build.1"], "1.2.3+build.2"),
+        (["compare", "{}1.2.3", "{}2.1.3"], "-1"),
+        (["compare", "{}2.1.3", "1.2.3"], "1"),
+        (["nextver", "{}1.2.3", "minor"], "1.3.0"),
+        (["check", "{}1.2.3"], ""),
+    ],
+)
+def test_leading_v_is_accepted(capsys, prefix, cli, expected):
+    cli = [a.format(prefix) for a in cli]
+    assert cli_main(cli) == 0
+    assert capsys.readouterr().out.strip() == expected
+
+
+@pytest.mark.parametrize("bad", ["vv1.2.3", "v", "v-1.2.3", "1.2.3v"])
